{
  "lemma": "niente",
  "min_senses": 21,
  "senses": [
    {
      "pos": "pronome indefinito",
      "definition": "nessuna cosa, nessuno",
      "examples": [
        "Non ho niente da dire.",
        "Niente è più bello della libertà."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "assenza di qualcosa",
      "examples": [
        "La stanza era piena di niente.",
        "Il niente che ci circonda."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "neanche un po', affatto",
      "examples": [
        "Non sono niente stanco.",
        "Niente male, grazie."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "inesistente, nullo",
      "examples": [
        "Il niente risultato dell'esperimento.",
        "Una niente speranza."
      ],
      "nota": "Spesso usato per enfatizzare l'assenza o la nullità di qualcosa."
    }
  ]
}