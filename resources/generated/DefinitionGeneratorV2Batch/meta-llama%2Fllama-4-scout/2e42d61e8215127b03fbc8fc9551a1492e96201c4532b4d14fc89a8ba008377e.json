{
  "lemma": "smettere",
  "min_senses": 6,
  "senses": [
    {
      "pos": "verbo",
      "definition": "interrompere un'azione o un'attività",
      "examples": [
        "Ha smesso di fumare.",
        "Smetti di parlare e ascoltami."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "cessare di fare qualcosa",
      "examples": [
        "Smetti di scherzare e aiutami.",
        "Smetterò di lavorare alle 18."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "lasciare qualcosa, specialmente un'abitudine o un lavoro",
      "examples": [
        "Ho smesso il mio lavoro da impiegato.",
        "Smetterà la sua carriera di musicista."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "ritirarsi, allontanarsi da qualcosa",
      "examples": [
        "Si è smesso dalla vita pubblica.",
        "Smette di frequentare quei posti."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "essere abbandonato, cessare",
      "examples": [
        "La moda è smessa.",
        "Il suo stile è smesso da anni."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "levare, togliere qualcosa indosso",
      "examples": [
        "Smetti il cappello.",
        "Smetterò questa giacca."
      ],
      "nota": "In questo senso, 'smettere' è spesso utilizzato con capi di abbigliamento."
    }
  ]
}