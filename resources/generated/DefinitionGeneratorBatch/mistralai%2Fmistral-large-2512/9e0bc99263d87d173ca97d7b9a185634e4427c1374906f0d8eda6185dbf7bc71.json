  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Periodo storico caratterizzato da eventi, tendenze o caratteristiche particolari che lo distinguono da altri periodi.",
      "examples": [
        "L'epoca rinascimentale ha visto un grande sviluppo artistico e culturale.",
        "Durante l'epoca vittoriana, le convenzioni sociali erano molto rigide."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Momento preciso o fase significativa nella storia o nella vita di qualcuno.",
      "examples": [
        "La scoperta dell'America segnò un'epoca nella storia mondiale.",
        "Quella vittoria rappresentò un'epoca di cambiamento per la squadra."
      ],
      "nota": "Spesso usato in contesti storici o biografici per indicare un punto di svolta."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Periodo di tempo molto lungo, spesso percepito come remoto o lontano nel passato.",
      "examples": [
        "Questi reperti risalgono a un'epoca in cui l'uomo non conosceva ancora la scrittura.",
        "Le mode di quell'epoca sembrano oggi davvero bizzarre."
      ],
      "nota": "Può avere una connotazione di antichità o distanza temporale, anche senza riferimenti storici precisi."
    }
  ]
