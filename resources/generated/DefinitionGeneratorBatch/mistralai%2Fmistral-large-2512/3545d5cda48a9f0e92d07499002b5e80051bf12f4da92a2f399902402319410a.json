  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che è in uso o in vigore nel momento attuale; che segue le tendenze o le pratiche più diffuse.",
      "examples": [
        "Questo dizionario riporta le forme linguistiche più correnti.",
        "È un modello di auto molto corrente tra i giovani."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che si muove o scorre con continuità, detto di liquidi o gas.",
      "examples": [
        "L'acqua corrente è essenziale per la sopravvivenza.",
        "Il fiume ha una forte corrente che rende pericoloso nuotare."
      ],
      "nota": "Spesso usato in contrapposizione a 'stagnante'."
    },
    {
      "pos": "aggettivo",
      "definition": "che è fluido e scorrevole, detto di discorsi o testi.",
      "examples": [
        "Ha una prosa corrente e piacevole da leggere.",
        "Il suo italiano è molto corrente, senza incertezze."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "movimento continuo di una massa d'acqua o di aria in una direzione prevalente.",
      "examples": [
        "La corrente del fiume trascinava via tutto ciò che incontrava.",
        "Attenzione alla corrente marina quando nuoti qui."
      ],
      "nota": "Può essere usato anche in senso figurato per indicare tendenze o movimenti sociali (es. 'una corrente di pensiero')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "flusso di cariche elettriche attraverso un conduttore.",
      "examples": [
        "La corrente elettrica è saltata per un sovraccarico.",
        "Non toccare i fili senza isolamento: c'è corrente!"
      ],
      "nota": "In contesti tecnici, si distingue tra corrente continua e alternata."
    },
    {
      "pos": "sostantivo f.",
      "definition": "gruppo organizzato all'interno di un partito, un'associazione o un movimento, con idee o obiettivi specifici.",
      "examples": [
        "Nel partito si sono formate due correnti contrapposte.",
        "Questa corrente artistica ha influenzato molti pittori moderni."
      ],
      "nota": "Spesso usato in ambito politico, culturale o artistico."
    }
  ]
