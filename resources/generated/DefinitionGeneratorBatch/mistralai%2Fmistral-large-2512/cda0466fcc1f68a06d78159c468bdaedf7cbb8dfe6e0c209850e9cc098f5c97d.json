  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "andare regolarmente in un luogo o partecipare con assiduità a un'attività",
      "examples": [
        "Frequenta quel bar da anni.",
        "Ha deciso di frequentare un corso di cucina."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "avere rapporti abituali con una persona o un gruppo di persone",
      "examples": [
        "Frequenta spesso i suoi colleghi anche fuori dall'ufficio.",
        "Da quando si è trasferito, frequenta solo gente del quartiere."
      ],
      "nota": "Può implicare una connotazione neutra, positiva o negativa a seconda del contesto."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "essere presente con regolarità in un ambiente o contesto sociale",
      "examples": [
        "Frequenta molto nei circoli culturali della città.",
        "Non frequenta più in quel locale da quando hanno cambiato gestione."
      ],
      "nota": "Uso meno comune rispetto alla forma transitiva, spesso con specificazione del luogo o ambiente."
    },
    {
      "pos": "verbo transitivo (uso figurato)",
      "definition": "essere esposto o sottoposto ripetutamente a qualcosa di astratto",
      "examples": [
        "Frequenta spesso pensieri cupi negli ultimi tempi.",
        "Da bambino frequentava il timore di essere abbandonato."
      ],
      "nota": "Uso prevalentemente letterario o formale, riferito a stati d'animo, idee o sensazioni."
    }
