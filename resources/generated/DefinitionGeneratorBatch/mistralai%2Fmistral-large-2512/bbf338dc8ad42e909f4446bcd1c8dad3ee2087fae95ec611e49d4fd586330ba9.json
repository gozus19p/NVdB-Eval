  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dare avvio a un'attività, un processo o un evento.",
      "examples": [
        "Hanno iniziato i lavori di ristrutturazione la scorsa settimana.",
        "Il professore ha iniziato la lezione con una domanda interessante."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Avere inizio; cominciare a esistere o a manifestarsi.",
      "examples": [
        "La partita inizia alle 21:00 in punto.",
        "Con l'autunno iniziano le piogge frequenti."
      ],
      "nota": "Spesso usato con soggetti impersonali o eventi."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Introdurre qualcuno a una nuova attività, conoscenza o esperienza.",
      "examples": [
        "Mio padre mi ha iniziato al gioco degli scacchi quando ero piccolo.",
        "Il corso serve a iniziare i neofiti al mondo della programmazione."
      ],
      "nota": "In questo senso, il complemento oggetto è solitamente una persona."
    },
    {
      "pos": "verbo intransitivo pronominale (iniziarsi)",
      "definition": "Dare inizio a un proprio percorso o attività in modo autonomo.",
      "examples": [
        "Mi sono iniziato alla meditazione seguendo un tutorial online.",
        "Si è iniziato alla cucina vegetariana dopo aver letto quel libro."
      ],
      "nota": "Forma riflessiva con valore ingressivo."
    }
  ]
