  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "ottenere la proprietà di qualcosa in cambio di denaro o altro valore",
      "examples": [
        "Ho acquistato una nuova automobile usata.",
        "Acquistarono la casa dopo lunghe trattative con il venditore."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "guadagnare o ottenere qualcosa in modo non materiale, come qualità, abilità o stima",
      "examples": [
        "Con il tempo, ha acquistato una notevole competenza nel suo campo.",
        "Il film ha acquistato popolarità dopo la vittoria al festival."
      ],
      "nota": "Spesso usato in contesti figurati per indicare un miglioramento o un incremento non tangibile."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "diventare più intenso, evidente o marcato",
      "examples": [
        "La sua voce acquistò sicurezza man mano che parlava.",
        "Con il passare degli anni, il suo carattere ha acquistato dolcezza."
      ],
      "nota": "Usato soprattutto in riferimento a qualità, caratteristiche o stati d'animo."
    }
  ]
