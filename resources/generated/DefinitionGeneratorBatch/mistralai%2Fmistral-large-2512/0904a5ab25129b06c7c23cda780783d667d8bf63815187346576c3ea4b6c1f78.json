  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Dispositivo ottico composto da due lenti montate su una struttura che si appoggia sul naso e sulle orecchie, usato per correggere difetti della vista o proteggere gli occhi.",
      "examples": [
        "Ho dimenticato gli occhiali a casa e non riesco a leggere il menù.",
        "Con questo sole è meglio indossare gli occhiali da sole per proteggere la vista."
      ],
      "nota": "Può essere specificato in base alla funzione: 'occhiali da vista', 'occhiali da sole', 'occhiali da lettura', ecc. Il plurale è obbligatorio anche per riferirsi a un singolo dispositivo."
    },
    {
      "pos": "sostantivo m. pl.",
      "definition": "Struttura metallica o plastica che sostiene le lenti correttive o protettive per gli occhi, priva delle lenti stesse.",
      "examples": [
        "Ho rotto le lenti e ora mi servono solo gli occhiali senza vetri.",
        "Questi occhiali sono leggeri, ma la montatura è troppo fragile."
      ],
      "nota": "In questo senso, si riferisce spesso alla 'montatura' degli occhiali. Il termine è usato anche in contesti metaforici per indicare qualcosa che inquadra o delimita, ma tali usi sono meno comuni."
    }
  ]
