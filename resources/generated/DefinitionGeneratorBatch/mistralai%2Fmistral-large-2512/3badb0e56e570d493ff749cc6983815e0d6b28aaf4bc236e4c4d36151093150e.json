  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "azione di acquistare beni o servizi in cambio di denaro",
      "examples": [
        "Ho fatto la spesa al supermercato stamattina.",
        "La spesa settimanale per la famiglia è aumentata molto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "somma di denaro impiegata per acquistare qualcosa",
      "examples": [
        "La spesa per la riparazione dell'auto è stata elevata.",
        "Abbiamo calcolato tutte le spese del viaggio prima di partire."
      ],
      "nota": "Può riferirsi a un singolo acquisto o a un insieme di costi."
    },
    {
      "pos": "sostantivo f.",
      "definition": "insieme di prodotti alimentari acquistati, specialmente per uso domestico",
      "examples": [
        "Ho lasciato la spesa in macchina, puoi aiutarmi a portarla su?",
        "Mia madre ha dimenticato la spesa sul bancone del negozio."
      ],
      "nota": "In questo senso, si riferisce spesso ai generi alimentari."
    },
    {
      "pos": "sostantivo f. plurale",
      "definition": "uscite economiche necessarie per la gestione di un'attività o di una famiglia",
      "examples": [
        "Le spese mensili per l'ufficio sono troppo alte.",
        "Dobbiamo ridurre le spese per risparmiare qualcosa."
      ],
      "nota": "Usato soprattutto al plurale per indicare costi ricorrenti."
    }
  ]
