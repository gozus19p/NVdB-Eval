  "senses": [
    {
      "pos": "avverbio",
      "definition": "Indica una conseguenza logica o una conclusione derivata da quanto detto in precedenza.",
      "examples": [
        "Hai studiato molto, dunque meriti un buon voto.",
        "Non ha risposto al telefono, dunque probabilmente è occupato."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "Introduce una domanda o un'esortazione, spesso per sollecitare una risposta o un'azione immediata.",
      "examples": [
        "Dunque, che cosa hai deciso di fare?",
        "Dunque, cominciamo la riunione?"
      ],
      "nota": "In questo uso, può assumere una sfumatura pragmatica di richiamo all'attenzione o di invito alla riflessione."
    },
    {
      "pos": "congiunzione",
      "definition": "Collega due proposizioni, indicando una conseguenza o una conclusione logica.",
      "examples": [
        "Non aveva i soldi, dunque non poté comprare il biglietto.",
        "Era tardi, dunque decidemmo di tornare a casa."
      ],
      "nota": "Equivale a 'quindi' o 'perciò' in contesti formali o scritti."
    }
  ]
