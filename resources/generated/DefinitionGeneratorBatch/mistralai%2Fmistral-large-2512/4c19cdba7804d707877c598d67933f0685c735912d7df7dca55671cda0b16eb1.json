  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "apertura o cavità di forma più o meno circolare in una superficie solida o in un oggetto",
      "examples": [
        "Ho trovato un buco nel muro del garage.",
        "Il maglione ha un buco sul gomito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "spazio vuoto o mancanza in una sequenza, una serie o un insieme",
      "examples": [
        "C'è un buco nella mia agenda domani pomeriggio.",
        "Il detective ha trovato un buco nella testimonianza del sospettato."
      ],
      "nota": "Spesso usato in contesti figurati per indicare lacune o omissioni."
    },
    {
      "pos": "sostantivo m.",
      "definition": "luogo piccolo, stretto o poco attraente",
      "examples": [
        "Quel ristorante è un buco, ma si mangia bene.",
        "Abbiamo affittato un buco in centro per risparmiare."
      ],
      "nota": "Uso colloquiale con connotazione negativa o ironica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "periodo di tempo non occupato da impegni o attività",
      "examples": [
        "Ho un buco tra una riunione e l'altra, possiamo vederci?",
        "Durante il buco a scuola, vado in biblioteca."
      ],
      "nota": "Comune in contesti informali per indicare pause o intervalli liberi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "quantità di droga, specialmente eroina, sufficiente per una dose",
      "examples": [
        "Ha comprato un buco da uno spacciatore.",
        "Gli hanno trovato addosso tre buchi di eroina."
      ],
      "nota": "Uso gergale nel linguaggio della tossicodipendenza."
    },
    {
      "pos": "sostantivo m.",
      "definition": "situazione di deficit economico o finanziario",
      "examples": [
        "Il bilancio presenta un buco di mezzo milione di euro.",
        "Hanno dovuto chiedere un prestito per coprire il buco."
      ],
      "nota": "Spesso riferito a bilanci aziendali o pubblici."
    }
