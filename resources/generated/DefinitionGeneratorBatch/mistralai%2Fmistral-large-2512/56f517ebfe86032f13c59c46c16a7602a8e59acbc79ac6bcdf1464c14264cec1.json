  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Separare qualcosa da ciò a cui è attaccato o unito, rimuovendolo o interrompendo il contatto.",
      "examples": [
        "Ho staccato il quadro dal muro per pulire dietro.",
        "Stacca il cavo dalla presa prima di aprire l'apparecchio."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere un collegamento o una connessione, spesso in modo temporaneo.",
      "examples": [
        "Stacca la corrente prima di cambiare la lampadina.",
        "Il tecnico ha staccato la linea telefonica per un guasto."
      ],
      "nota": "Può riferirsi a collegamenti fisici (elettrici, meccanici) o figurati (comunicazioni)."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi o prendere una pausa da un'attività, un luogo o una situazione, spesso per riposare.",
      "examples": [
        "Dopo otto ore di lavoro, finalmente stacco alle sei.",
        "Stacco un attimo per prendere un caffè."
      ],
      "nota": "Comune in contesti lavorativi o di routine quotidiana."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Distinguersi chiaramente da qualcosa o qualcuno per caratteristiche evidenti.",
      "examples": [
        "Il suo talento stacca nettamente quello degli altri concorrenti.",
        "Il colore rosso stacca sullo sfondo bianco."
      ],
      "nota": "Uso figurato, spesso riferito a differenze visive o qualitative."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Emettere un documento o un titolo, come un assegno o un biglietto, compilandolo e consegnandolo.",
      "examples": [
        "La banca ha staccato un assegno per il rimborso.",
        "Hanno staccato i biglietti per il concerto con largo anticipo."
      ],
      "nota": "Comune in ambiti amministrativi o commerciali."
    },
    {
      "pos": "verbo riflessivo (staccarsi)",
      "definition": "Separarsi o allontanarsi da qualcosa a cui si era attaccati o uniti.",
      "examples": [
        "La carta da parati si è staccata in un angolo.",
        "Si è staccato dal gruppo per prendere una strada diversa."
      ],
      "nota": "Può riferirsi a oggetti fisici o a relazioni (es. gruppi, persone)."
    }
  ]
