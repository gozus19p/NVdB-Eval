  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "allungare o tirare qualcosa in modo che risulti più dritto o teso.",
      "examples": [
        "Ho teso la corda tra i due pali per stendere i panni.",
        "Tendi bene il lenzuolo prima di metterlo sul letto."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "essere orientato o diretto verso un punto o una direzione specifica.",
      "examples": [
        "La strada tende verso la montagna.",
        "I suoi interessi tendono sempre più all'arte contemporanea."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "avvicinarsi gradualmente a una condizione o a uno stato.",
      "examples": [
        "Con l'età, i suoi capelli tendono al grigio.",
        "Il tempo tende a peggiorare nel pomeriggio."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "porgere o offrire qualcosa a qualcuno.",
      "examples": [
        "Mi ha teso la mano per salutarmi.",
        "Tese il bicchiere verso di me per farselo riempire."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "avere una propensione o inclinazione naturale verso qualcosa.",
      "examples": [
        "Tende a essere troppo generoso con gli altri.",
        "Questo materiale tende a rompersi se viene piegato."
      ],
      "nota": "Spesso usato con la preposizione 'a' seguita da un verbo all'infinito o da un sostantivo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "preparare un tranello o un inganno nei confronti di qualcuno.",
      "examples": [
        "Gli hanno teso una trappola per coglierlo in fallo.",
        "Non fidarti, potrebbe averti teso un agguato."
      ],
      "nota": "Uso figurato, spesso associato a contesti di inganno o tradimento."
    }
  ]
