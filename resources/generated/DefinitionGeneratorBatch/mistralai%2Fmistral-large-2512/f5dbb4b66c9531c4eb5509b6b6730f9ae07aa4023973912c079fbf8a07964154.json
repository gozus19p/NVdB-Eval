  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "stabilire con precisione un elemento, un dettaglio o una condizione, spesso in modo definitivo o ufficiale",
      "examples": [
        "Hanno fissato la data del matrimonio per il prossimo giugno.",
        "Il governo ha fissato nuovi limiti di velocità sulle autostrade."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "guardare intensamente e a lungo qualcuno o qualcosa, spesso con insistenza",
      "examples": [
        "Mi fissava senza dire una parola, mettendomi a disagio.",
        "Il gatto fissava il topo prima di saltargli addosso."
      ],
      "nota": "Può implicare curiosità, stupore, minaccia o concentrazione, a seconda del contesto."
    },
    {
      "pos": "verbo transitivo",
      "definition": "rendere stabile o immobile qualcosa, impedendone il movimento",
      "examples": [
        "Devi fissare meglio la mensola al muro con dei tasselli.",
        "Ha fissato la tenda con delle mollette per evitare che volasse via."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "prenotare o riservare un posto, un servizio o una prestazione in anticipo",
      "examples": [
        "Ho fissato un tavolo per otto persone al ristorante.",
        "Dobbiamo fissare una visita medica per la prossima settimana."
      ],
      "nota": "Spesso usato in contesti di organizzazione di eventi o appuntamenti."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "concentrarsi mentalmente su un pensiero, un'idea o un'immagine, spesso in modo ossessivo",
      "examples": [
        "Si è fissato con l'idea di dimagrire in una settimana.",
        "Da quando ha visto quel film, si fissa sempre sugli stessi argomenti."
      ],
      "nota": "Può avere una connotazione negativa, indicando un'ossessione o un pensiero ricorrente."
    },
    {
      "pos": "verbo riflessivo (fissarsi)",
      "definition": "ostinarsi in modo eccessivo su un'idea, un comportamento o un obiettivo, spesso ignorando altre possibilità",
      "examples": [
        "Si è fissato con questa dieta e non vuole sentire ragioni.",
        "Non ti fissare su quel dettaglio, è irrilevante."
      ],
      "nota": "Implica una certa rigidità mentale o emotiva."
    }
  ]
