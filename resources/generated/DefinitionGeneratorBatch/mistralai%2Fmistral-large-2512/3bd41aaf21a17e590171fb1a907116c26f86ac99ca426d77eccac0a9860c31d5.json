  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona con cui si condivide un'attività, un'esperienza o una condizione di vita in modo stabile o temporaneo.",
      "examples": [
        "Mio fratello è sempre stato il mio compagno di giochi durante l'infanzia.",
        "Durante il viaggio in treno ho conosciuto un compagno di scompartimento molto simpatico."
      ],
      "nota": "Può riferirsi a relazioni di amicizia, lavoro, studio o convivenza. In contesti politici o sociali, può indicare un membro di un'organizzazione o movimento (es. 'compagno di partito')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona legata sentimentalmente a un'altra in una relazione non coniugale.",
      "examples": [
        "Dopo dieci anni insieme, ha deciso di presentare il suo compagno alla famiglia.",
        "Vive con il suo compagno in un appartamento in centro."
      ],
      "nota": "Usato soprattutto per indicare relazioni omosessuali, ma può estendersi anche a relazioni eterosessuali non formalizzate dal matrimonio."
    },
    {
      "pos": "sostantivo m. (anche f. compagna)",
      "definition": "Termine di cortesia o di appartenenza usato in alcuni contesti politici o sociali per rivolgersi a un membro dello stesso gruppo o ideologia.",
      "examples": [
        "Compagno, mi passi il microfono per favore?",
        "Durante la manifestazione, i compagni hanno distribuito volantini."
      ],
      "nota": "Storicamente associato a movimenti di sinistra o sindacali. Può avere una connotazione ideologica marcata."
    },
    {
      "pos": "aggettivo",
      "definition": "Che accompagna o si presenta insieme a qualcos'altro, spesso in modo complementare o accessorio.",
      "examples": [
        "La febbre è un sintomo compagno dell'influenza.",
        "La solitudine è spesso compagna della vecchiaia."
      ],
      "nota": "Usato prevalentemente in contesti letterari o formali. Può avere una sfumatura poetica o metaforica."
    }
  ]
