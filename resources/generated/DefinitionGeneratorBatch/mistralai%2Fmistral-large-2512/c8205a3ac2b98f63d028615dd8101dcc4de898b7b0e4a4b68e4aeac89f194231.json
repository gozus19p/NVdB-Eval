  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Testo scritto di carattere informativo, espositivo o argomentativo, pubblicato su un giornale, una rivista o un sito web.",
      "examples": [
        "Ho letto un interessante articolo sul cambiamento climatico.",
        "Il giornalista ha scritto un articolo dettagliato sull'accaduto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ogni singolo prodotto in vendita, soprattutto in un negozio o in un catalogo.",
      "examples": [
        "Questo articolo è in offerta speciale questa settimana.",
        "Il commesso mi ha mostrato diversi articoli di cancelleria."
      ],
      "nota": "Spesso usato in contesti commerciali o di inventario."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte di un testo normativo, come una legge o un contratto, che enuncia una disposizione specifica.",
      "examples": [
        "L'articolo 3 della Costituzione italiana sancisce l'uguaglianza dei cittadini.",
        "Dobbiamo rivedere l'articolo 5 del contratto prima di firmare."
      ],
      "nota": "Comunemente abbreviato come 'art.' nei testi giuridici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parola che precede un sostantivo per specificarne il genere, il numero e la determinatezza.",
      "examples": [
        "In italiano, gli articoli determinativi sono 'il', 'lo', 'la', 'i', 'gli', 'le'.",
        "L'uso dell'articolo indeterminativo cambia a seconda del contesto."
      ],
      "nota": "In grammatica, si distingue tra articoli determinativi, indeterminativi e partitivi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Oggetto o elemento di un insieme, spesso elencato separatamente.",
      "examples": [
        "Nella lista della spesa, ogni articolo deve essere spuntato.",
        "Il museo espone articoli di grande valore storico."
      ],
      "nota": "Può riferirsi a elementi materiali o immateriali, a seconda del contesto."
    }
  ]
