  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Piccola sacca cucita o applicata all'interno o all'esterno di un capo di abbigliamento, usata per contenere oggetti di piccole dimensioni.",
      "examples": [
        "Ho messo le chiavi nella tasca dei pantaloni.",
        "La giacca ha quattro tasche esterne e due interne."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Quantità di denaro o risorse economiche di cui una persona dispone.",
      "examples": [
        "Con questa crisi, molti hanno le tasche vuote.",
        "Non posso permettermi quella vacanza, è troppo cara per le mie tasche."
      ],
      "nota": "Uso figurato, spesso in contesti informali o colloquiali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Parte di un oggetto o struttura che forma una cavità o un vano simile a una sacca.",
      "examples": [
        "Il divano ha una tasca laterale per i telecomandi.",
        "Le tasche delle porte dell'auto sono utili per riporre piccoli oggetti."
      ],
      "nota": "Estensione del significato letterale a oggetti non legati all'abbigliamento."
    }
