  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Tessuto muscolare commestibile degli animali, utilizzato come alimento.",
      "examples": [
        "Ho comprato della carne macinata per fare le polpette.",
        "In questo ristorante servono carne di manzo di ottima qualità."
      ],
      "nota": "Può riferirsi anche a parti specifiche dell'animale, come 'carne di maiale' o 'carne di pollo'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Parte muscolare del corpo umano, in contrapposizione a ossa e pelle.",
      "examples": [
        "Dopo l'incidente, aveva la carne viva su tutto il braccio.",
        "La ferita era profonda e arrivava fino alla carne."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio religioso, la natura umana in contrapposizione a quella spirituale.",
      "examples": [
        "La Chiesa insegna che la carne è debole ma lo spirito è forte.",
        "Molti santi hanno cercato di mortificare la carne per elevare l'anima."
      ],
      "nota": "Uso prevalentemente nel contesto cristiano e teologico."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Polpa o parte interna commestibile di alcuni frutti o ortaggi.",
      "examples": [
        "La carne della pesca è dolce e succosa.",
        "Per questa ricetta serve solo la carne del cocco, non l'acqua."
      ],
      "nota": "Si usa soprattutto per frutti con un guscio duro o una buccia spessa."
    },
    {
      "pos": "sostantivo f. (solo singolare)",
      "definition": "Nel linguaggio figurato, l'insieme delle persone considerate come massa o comunità.",
      "examples": [
        "La carne da cannone viene mandata al fronte senza protezione.",
        "In tempo di guerra, la carne fresca scarseggiava nelle città."
      ],
      "nota": "Uso spesso dispregiativo o metaforico, soprattutto in contesti bellici o di sfruttamento."
    }
