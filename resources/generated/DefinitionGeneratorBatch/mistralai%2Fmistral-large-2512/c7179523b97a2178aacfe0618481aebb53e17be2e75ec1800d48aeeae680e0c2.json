  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Insieme delle opere scritte, in prosa o in versi, che hanno valore artistico o culturale, soprattutto nel campo della narrativa, della poesia e del teatro.",
      "examples": [
        "La letteratura italiana del Novecento è ricca di capolavori.",
        "Ha studiato letteratura comparata all'università."
      ],
      "nota": "Può riferirsi sia a un corpus di opere di una determinata lingua, epoca o cultura (es. *letteratura francese*), sia alla disciplina accademica che le studia."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Complesso di testi, documenti o pubblicazioni relativi a un determinato argomento, spesso di carattere tecnico o scientifico.",
      "examples": [
        "Prima di iniziare la ricerca, ho consultato tutta la letteratura disponibile sull'argomento.",
        "La letteratura medica su questa malattia è ancora limitata."
      ],
      "nota": "In questo senso, il termine assume una connotazione più ampia e meno legata al valore artistico, estendendosi a testi di natura informativa o specialistica."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di espressioni stereotipate, retoriche o prive di sincerità, spesso usate in contesti formali o burocratici.",
      "examples": [
        "Il suo discorso era pieno di letteratura e non diceva nulla di concreto.",
        "Basta con la letteratura, vogliamo fatti!"
      ],
      "nota": "In questo uso, il termine assume una connotazione negativa, indicando un linguaggio artificioso o vuoto."
    }
  ]
