  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Allontanarsi rapidamente da un luogo o da una situazione per evitare un pericolo, una minaccia o un disagio.",
      "examples": [
        "Il ladro è fuggito appena ha sentito le sirene della polizia.",
        "Durante il terremoto, tutti sono fuggiti in strada."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Allontanarsi da qualcuno o qualcosa per evitare un contatto o una relazione sgradita.",
      "examples": [
        "Ha deciso di fuggire da quella città piena di brutti ricordi.",
        "Fugge sempre quando si parla di responsabilità."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Evitare intenzionalmente qualcosa o qualcuno che si considera negativo o pericoloso.",
      "examples": [
        "Fugge gli sguardi indiscreti ogni volta che può.",
        "Da anni fugge ogni tipo di conflitto."
      ],
      "nota": "In questo uso, il verbo regge un complemento oggetto diretto."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Detto di tempo, scorrere velocemente senza che ci si renda conto.",
      "examples": [
        "Il tempo fugge quando ci si diverte.",
        "Gli anni sono fuggiti senza che me ne accorgessi."
      ],
      "nota": "Uso figurato, spesso riferito a concetti astratti come il tempo."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Detto di liquidi o gas, fuoriuscire da un contenitore a causa di una perdita o di una rottura.",
      "examples": [
        "Il gas è fuggito dalla bombola danneggiata.",
        "L'acqua fuggiva dal tubo rotto."
      ],
      "nota": "Uso tecnico o quotidiano, spesso riferito a sostanze fluide."
    }
  ]
