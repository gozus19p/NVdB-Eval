  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Porzione di una città delimitata da confini naturali o amministrativi, caratterizzata da una certa omogeneità urbanistica o sociale.",
      "examples": [
        "Il quartiere di Trastevere è famoso per le sue trattorie tipiche.",
        "Hanno deciso di trasferirsi in un quartiere più tranquillo in periferia."
      ],
      "nota": "Può indicare sia una suddivisione ufficiale (es. quartieri di Roma) sia un'area percepita come unitaria dagli abitanti, anche senza confini amministrativi precisi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di edifici o strutture destinati a un uso specifico, spesso militare o residenziale.",
      "examples": [
        "Il quartiere militare ospita le caserme della guarnigione locale.",
        "Nel quartiere universitario ci sono molti appartamenti in affitto per studenti."
      ],
      "nota": "In contesti militari, può riferirsi anche a un periodo di servizio o a una sede operativa (es. 'quartiere generale')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio marinaresco, ciascuna delle quattro parti in cui è idealmente divisa la nave.",
      "examples": [
        "Il nostromo ha ispezionato il quartiere di prua per verificare eventuali danni.",
        "Durante la tempesta, l'equipaggio si è rifugiato nel quartiere di poppa."
      ],
      "nota": "Uso tecnico ristretto al contesto nautico. Non va confuso con gli altri sensi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Atteggiamento di clemenza o pietà mostrato verso un avversario sconfitto.",
      "examples": [
        "Il comandante nemico chiese quartiere per i suoi soldati feriti.",
        "Non ci fu quartiere: la battaglia continuò fino all'ultimo uomo."
      ],
      "nota": "Uso prevalentemente letterario o storico, spesso in espressioni come 'dare quartiere' o 'chiedere quartiere'."
    }
  ]
