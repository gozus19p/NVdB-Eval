  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Animale vertebrato a sangue caldo, con il corpo ricoperto di piume, le zampe anteriori trasformate in ali e il becco corneo, che si riproduce deponendo uova.",
      "examples": [
        "Nel parco ho visto un uccello colorato posato su un ramo.",
        "Gli uccelli migratori volano verso sud in autunno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nell'uso volgare, organo genitale maschile.",
      "examples": [
        "Si è fatto male all'uccello giocando a calcio.",
        "Il bambino ha chiesto cosa fosse quell'uccello disegnato sul muro."
      ],
      "nota": "Uso informale e volgare, spesso evitato in contesti formali o con bambini."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona astuta, furba o difficile da ingannare.",
      "examples": [
        "Non provare a truffarlo, è un vecchio uccello che sa il fatto suo.",
        "Quel commerciante è un uccello: non si fa mai fregare."
      ],
      "nota": "Uso figurato e colloquiale, spesso con connotazione positiva o ironica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In espressioni idiomatiche, indica una situazione o una persona problematica o sfortunata.",
      "examples": [
        "Con quel progetto siamo proprio in un bel uccello.",
        "Dopo l'incidente, si è ritrovato in un uccello di situazione."
      ],
      "nota": "Uso idiomatico, spesso in frasi negative o ironiche. Espressione regionale diffusa soprattutto nel Nord Italia."
    }
  ]
