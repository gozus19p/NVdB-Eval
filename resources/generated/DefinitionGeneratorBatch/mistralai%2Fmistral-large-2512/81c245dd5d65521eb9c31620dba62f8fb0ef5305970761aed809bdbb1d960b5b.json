  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "assenza totale o quasi totale di luce, condizione in cui non è possibile vedere chiaramente",
      "examples": [
        "Dopo il tramonto, il buio avvolse rapidamente la campagna.",
        "Non riusciva a trovare le chiavi nel buio della stanza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "periodo della giornata in cui è notte, privo di luce solare",
      "examples": [
        "Al calare del buio, i lampioni si accesero automaticamente.",
        "Preferisco viaggiare di giorno piuttosto che affrontare il buio."
      ],
      "nota": "Spesso usato in contrapposizione a 'giorno' o 'luce'."
    },
    {
      "pos": "aggettivo",
      "definition": "privo di luce, non illuminato",
      "examples": [
        "La stanza era così buia che non si vedeva nulla.",
        "Dopo la tempesta, il quartiere è rimasto buio per ore."
      ],
      "nota": "Può essere usato anche in senso figurato per indicare mancanza di chiarezza o speranza."
    },
    {
      "pos": "aggettivo",
      "definition": "di colore molto scuro, tendente al nero",
      "examples": [
        "Indossava un vestito buio per la cerimonia.",
        "I suoi capelli erano di un castano così buio da sembrare neri."
      ],
      "nota": "Spesso riferito a tonalità cromatiche."
    },
    {
      "pos": "aggettivo",
      "definition": "che manca di chiarezza, comprensibilità o speranza",
      "examples": [
        "Il futuro gli appariva buio dopo quella delusione.",
        "Le prospettive economiche del paese sono ancora buie."
      ],
      "nota": "Uso figurato, spesso associato a situazioni negative o incerte."
    }
  ]
