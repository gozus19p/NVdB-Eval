  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "esprimere dolore, insoddisfazione o rimpianto per qualcosa o qualcuno, spesso con toni accorati o insistenti",
      "examples": [
        "Ha passato la serata a lamentare la perdita del suo cane.",
        "Non fa che lamentare la mancanza di attenzione da parte dei colleghi."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (lamentarsi)",
      "definition": "manifestare il proprio malcontento, disagio o sofferenza, spesso in modo prolungato e ripetitivo",
      "examples": [
        "Si lamenta sempre del mal di schiena, ma non fa nulla per curarlo.",
        "I bambini si sono lamentati perché volevano un gelato."
      ],
      "nota": "Spesso usato con valore iterativo o enfatico, può implicare una connotazione negativa (es. eccessiva insistenza)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "riportare o segnalare un problema, un danno o un disagio a qualcuno che può intervenire",
      "examples": [
        "Hanno lamentato un guasto all'impianto elettrico al condominio.",
        "Il cliente ha lamentato un difetto nel prodotto acquistato."
      ],
      "nota": "In questo uso, il verbo assume una sfumatura più formale e spesso implica una richiesta di intervento o risarcimento."
    }
  ]
