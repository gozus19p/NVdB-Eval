  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Ampia estensione di terreno ricoperta prevalentemente da alberi ad alto fusto e vegetazione spontanea, spesso non coltivata.",
      "examples": [
        "Abbiamo fatto una passeggiata nel bosco dietro casa.",
        "Il bosco di querce è stato colpito da un incendio la scorsa estate."
      ],
      "nota": "Può indicare sia aree naturali che zone gestite per la produzione di legname. In contesti geografici o amministrativi, può essere sinonimo di 'foresta', sebbene quest'ultima suggerisca spesso una maggiore estensione e densità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme fitto e disordinato di oggetti o elementi che ricordano la densità di una foresta.",
      "examples": [
        "Un bosco di antenne spuntava dai tetti del quartiere.",
        "Dopo l'esplosione, un bosco di schegge si conficcò nel muro."
      ],
      "nota": "Uso figurato, spesso iperbolico, per descrivere una grande quantità di elementi verticali o sporgenti."
    }
  ]
