    {
      "pos": "sostantivo f.",
      "definition": "Provvedimento legale che punisce un reato, stabilito da una sentenza.",
      "examples": [
        "Il giudice ha comminato una pena di cinque anni di reclusione.",
        "La pena per il furto può variare a seconda delle circostanze."
      ],
      "nota": "Può includere sanzioni come il carcere, la multa o i lavori socialmente utili."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Sforzo, fatica o difficoltà nel compiere un'azione.",
      "examples": [
        "Ho fatto una gran pena a convincerlo a venire.",
        "Mi fa pena vedere quanto si impegna senza risultati."
      ],
      "nota": "Spesso usato in espressioni idiomatiche come 'fare pena' o 'valere la pena'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Sentimento di compassione o pietà verso qualcuno in difficoltà.",
      "examples": [
        "Mi fa pena quel bambino abbandonato per strada.",
        "Non provare pena per lui, se l'è cercata."
      ],
      "nota": "Può avere una connotazione negativa se usato in modo ironico o sprezzante."
    },
    {
      "pos": "locuzione avverbiale (valere la pena)",
      "definition": "Meritare lo sforzo o il sacrificio necessario per ottenere qualcosa.",
      "examples": [
        "Vale la pena di visitare quel museo, è davvero interessante.",
        "Non vale la pena arrabbiarsi per così poco."
      ],
