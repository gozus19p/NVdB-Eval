    {
      "pos": "sostantivo m.",
      "definition": "Circostanza o situazione specifica che riguarda una persona o una cosa.",
      "examples": [
        "Ogni caso va valutato singolarmente.",
        "Il medico ha descritto il caso clinico del paziente."
      ],
      "nota": "Spesso usato in contesti giuridici, medici o amministrativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Fatto o avvenimento che può essere oggetto di studio o analisi, spesso come esempio rappresentativo.",
      "examples": [
        "Questo è un caso interessante di studio sociologico.",
        "Il professore ha presentato un caso di successo aziendale."
      ],
      "nota": "Frequente in ambito accademico o scientifico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In grammatica, forma che assume un nome, un pronome o un aggettivo per indicare la sua funzione sintattica nella frase.",
      "examples": [
        "In latino, il caso ablativo indica il complemento di mezzo.",
        "Il caso nominativo è usato per il soggetto della frase."
      ],
      "nota": "Termine tecnico della linguistica."
    },
    {
      "pos": "avverbio",
      "definition": "Per indicare che qualcosa avviene in modo accidentale o senza intenzione.",
      "examples": [
        "Ho caso incontrato il mio vecchio amico in città.",
        "Mi è capitato caso di sentire quella canzone alla radio."
      ],
      "nota": "Uso meno comune e spesso sostituito da 'per caso' o 'casualmente'."
    },
    {
      "pos": "locuzione avverbiale (per caso)",
      "definition": "In modo accidentale o fortuito.",
      "examples": [
        "L'ho trovato per caso mentre cercavo qualcos'altro.",
        "Per caso, hai visto le mie chiavi?"
      ],
      "nota": null
    },
    {
      "pos": "locuzione congiuntiva (nel caso in cui / nel caso che)",
      "definition": "Per introdurre una condizione o un'ipotesi.",
      "examples": [
        "Porta l'ombrello nel caso in cui piova.",
        "Nel caso che tu non possa venire, avvisami."
      ],
