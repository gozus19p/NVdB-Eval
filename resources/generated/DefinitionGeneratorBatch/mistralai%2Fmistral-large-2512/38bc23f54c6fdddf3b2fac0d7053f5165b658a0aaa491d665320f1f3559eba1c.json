  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "emettere suoni molto forti e acuti con la voce, spesso per esprimere dolore, rabbia o paura.",
      "examples": [
        "Il bambino ha urlato quando si è fatto male al ginocchio.",
        "Durante il concerto, i fan urlavano così forte che non si sentiva la musica."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "dire qualcosa a voce molto alta, spesso per farsi sentire o per esprimere un'emozione intensa.",
      "examples": [
        "Ha urlato il mio nome dal balcone per attirare la mia attenzione.",
        "Nel mezzo della discussione, ha urlato una serie di insulti."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "produrre un suono molto forte e acuto, riferito a oggetti o fenomeni naturali.",
      "examples": [
        "Il vento urlava tra gli alberi durante la tempesta.",
        "La sirena dell'ambulanza urlava in lontananza."
      ],
      "nota": "Uso figurato o estensivo, spesso per descrivere suoni che ricordano un grido umano."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "esprimere con forza e insistenza un'opinione o un sentimento, spesso in modo sgradevole o invadente.",
      "examples": [
        "I giornali urlano contro la nuova legge da giorni.",
        "Questo colore urla troppo, non si abbina con il resto dell'arredamento."
      ],
      "nota": "Uso figurato, spesso con connotazione negativa."
    }
  ]
