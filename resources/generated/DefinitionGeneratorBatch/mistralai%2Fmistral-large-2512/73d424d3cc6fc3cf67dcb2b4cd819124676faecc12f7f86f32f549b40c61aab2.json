  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "fare o dire qualcosa con intenzione giocosa, senza serietà, per divertire o provocare ilarità",
      "examples": [
        "Durante la cena, Marco ha iniziato a scherzare sui suoi errori al lavoro.",
        "Non scherzare con queste cose, sono importanti per me."
      ],
      "nota": "Spesso usato in contesti informali o amichevoli. Può assumere una sfumatura negativa se percepito come mancanza di rispetto."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "prendere alla leggera una situazione o un argomento che richiederebbe serietà o attenzione",
      "examples": [
        "Non puoi scherzare con la sicurezza degli altri.",
        "Smettila di scherzare, questa è una questione seria."
      ],
      "nota": "In questo senso, assume spesso una connotazione di rimprovero o avvertimento."
    },
    {
      "pos": "verbo transitivo (scherzare qualcuno)",
      "definition": "prendere in giro qualcuno in modo bonario o giocoso",
      "examples": [
        "Lo scherzavano sempre per il suo accento straniero.",
        "Non volevo offenderti, ti stavo solo scherzando un po'."
      ],
      "nota": "Può essere percepito come fastidioso se eccessivo o rivolto a persone sensibili."
    }
  ]
