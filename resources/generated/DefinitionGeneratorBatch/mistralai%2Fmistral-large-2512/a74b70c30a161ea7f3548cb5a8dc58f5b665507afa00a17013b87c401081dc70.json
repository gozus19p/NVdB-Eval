  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Guidare qualcuno o qualcosa verso una destinazione, accompagnandolo o dirigendolo fisicamente.",
      "examples": [
        "Il pastore conduce le pecore al pascolo ogni mattina.",
        "L'autista ha condotto l'autobus fino al capolinea senza incidenti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dirigere o gestire un'attività, un progetto o un'organizzazione, coordinandone le azioni e le risorse.",
      "examples": [
        "Il direttore conduce l'azienda con grande competenza da oltre dieci anni.",
        "La ricercatrice ha condotto uno studio innovativo sul comportamento dei primati."
      ],
      "nota": "Spesso usato in contesti lavorativi, scientifici o organizzativi."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Portare a un determinato risultato o conseguenza, spesso in modo inevitabile o logico.",
      "examples": [
        "La mancanza di prove ha condotto all'assoluzione dell'imputato.",
        "Le sue scelte sbagliate lo hanno condotto alla rovina."
      ],
      "nota": "Uso figurato, spesso con esiti negativi o neutri."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Giungere a una conclusione o a un punto specifico, soprattutto in espressioni temporali o spaziali.",
      "examples": [
        "La strada conduce direttamente al centro del paese.",
        "Le indagini sono condotte a buon fine dopo mesi di lavoro."
      ],
      "nota": "Frequente in costruzioni con complementi di luogo o di risultato."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Trasmettere o far fluire energia, calore, suoni o segnali attraverso un mezzo.",
      "examples": [
        "Il cavo di rame conduce l'elettricità in modo efficiente.",
        "Questo materiale conduce bene il calore."
      ],
      "nota": "Uso tecnico-scientifico, spesso riferito a proprietà fisiche."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Presentare o moderare un programma televisivo o radiofonico, guidandone lo svolgimento.",
      "examples": [
        "La giornalista conduce il telegiornale delle venti da molti anni.",
        "Stasera condurrà lo spettacolo un comico molto popolare."
      ],
      "nota": "Uso specifico del linguaggio mediatico."
    },
    {
      "pos": "verbo riflessivo (condursi)",
      "definition": "Comportarsi in un determinato modo, soprattutto in riferimento a norme sociali o morali.",
      "examples": [
        "Si è condotto con grande dignità durante il processo.",
        "Non ti sei condotto bene in quella situazione."
      ],
      "nota": "Uso formale o letterario, spesso con connotazione valutativa."
    }
  ]
