  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Tracciare segni grafici su una superficie per rappresentare parole, numeri o simboli, solitamente con uno strumento come una penna o una tastiera.",
      "examples": [
        "Ho scritto una lettera a mia nonna per il suo compleanno.",
        "Scrivi il tuo nome in stampatello sul modulo di iscrizione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Comporre un testo, un'opera letteraria, musicale o di altro genere, attraverso un processo creativo o tecnico.",
      "examples": [
        "Ha scritto un romanzo che è diventato un bestseller.",
        "Mozart scrisse molte sinfonie durante la sua breve vita."
      ],
      "nota": "Può riferirsi sia alla creazione originale che alla stesura di testi già concepiti."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere una determinata capacità o stile nel comporre testi.",
      "examples": [
        "Quell'autore scrive molto bene, i suoi libri sono sempre coinvolgenti.",
        "Non scrive più come una volta, i suoi articoli sono diventati noiosi."
      ],
      "nota": "Spesso usato in contesti valutativi o comparativi."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Comunicare qualcosa a qualcuno tramite un messaggio scritto, come una lettera, un'email o un messaggio istantaneo.",
      "examples": [
        "Ti scriverò appena arrivo a destinazione.",
        "Mi ha scritto che non potrà venire alla festa."
      ],
      "nota": "In questo senso, può essere seguito da un complemento di termine (es. 'scrivere a qualcuno')."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Annotare o registrare informazioni per conservarle o ricordarle.",
      "examples": [
        "Ho scritto tutti gli appuntamenti sull'agenda.",
        "Scrivi il numero di telefono prima che me lo dimentichi."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (scriversi)",
      "definition": "Comunicare reciprocamente tramite messaggi scritti.",
      "examples": [
        "Ci scriviamo ogni giorno da quando si è trasferita all'estero.",
        "Non si scrivono più da anni, nonostante abitino nella stessa città."
      ],
      "nota": "Implica uno scambio reciproco di comunicazioni scritte."
    }
  ]
