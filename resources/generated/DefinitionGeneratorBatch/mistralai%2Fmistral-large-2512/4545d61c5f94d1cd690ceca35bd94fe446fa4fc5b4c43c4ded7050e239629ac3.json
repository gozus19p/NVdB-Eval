  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Convinzione profonda e incrollabile nell'esistenza o nella verità di qualcosa, spesso di natura religiosa o spirituale.",
      "examples": [
        "La sua fede in Dio lo ha sostenuto nei momenti difficili.",
        "Molte persone trovano conforto nella fede durante le crisi personali."
      ],
      "nota": "Può riferirsi anche a credenze non religiose, come la fede nella giustizia o nell'umanità, ma mantiene sempre una connotazione di fiducia assoluta."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Anello nuziale, simbolo di unione matrimoniale.",
      "examples": [
        "Ha perso la fede il giorno del suo matrimonio.",
        "Indossava una fede d'oro sottile al dito anulare."
      ],
      "nota": "In questo senso, è spesso usato al singolare anche se si riferisce a una coppia di anelli."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Documento o attestazione che certifica la veridicità o l'autenticità di qualcosa.",
      "examples": [
        "Il notaio ha rilasciato una fede di nascita per il bambino.",
        "Per iscriversi all'università, serve una fede di stato libero."
      ],
      "nota": "Uso prevalentemente burocratico o formale, spesso in contesti amministrativi o legali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Fiducia in una persona o in un'idea, spesso basata su esperienze positive o convinzioni personali.",
      "examples": [
        "Ho fede nel fatto che ce la farai a superare questo esame.",
        "La squadra ha perso la fede nel proprio allenatore dopo una serie di sconfitte."
      ],
      "nota": "In questo senso, può essere usato in contesti sia positivi che negativi (es. 'perdere la fede')."
    }
  ]
