  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "formulare un'opinione o una valutazione su qualcuno o qualcosa, spesso basandosi su criteri personali o oggettivi",
      "examples": [
        "Il pubblico ha giudicato il film molto interessante.",
        "Non sta a te giudicare le sue scelte di vita."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "emettere una sentenza o una decisione ufficiale in ambito giuridico",
      "examples": [
        "Il tribunale giudicherà il caso la prossima settimana.",
        "Il giudice ha giudicato l'imputato colpevole di furto."
      ],
      "nota": "Usato principalmente in contesti legali e processuali."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "esprimere un'opinione o una valutazione in modo generico, senza specificare l'oggetto",
      "examples": [
        "È meglio non giudicare senza conoscere i fatti.",
        "Spesso giudichiamo troppo in fretta."
      ],
      "nota": "In questo uso, il verbo può essere seguito da preposizioni come 'su' o 'di' per specificare l'ambito della valutazione (es. 'giudicare su una questione')."
    },
    {
      "pos": "verbo transitivo",
      "definition": "considerare qualcuno o qualcosa in un certo modo, attribuendogli una qualità o una caratteristica",
      "examples": [
        "Lo giudicano un ottimo professionista.",
        "Molti giudicano questa legge ingiusta."
      ],
      "nota": "Spesso usato in costruzioni con aggettivi o sostantivi predicativi (es. 'giudicare qualcuno innocente')."
    },
    {
      "pos": "verbo transitivo (uso assoluto)",
      "definition": "valutare o decidere in qualità di arbitro o esperto in una competizione o gara",
      "examples": [
        "Una giuria internazionale giudicherà le opere in concorso.",
        "Gli esperti giudicheranno la qualità dei vini presentati."
      ],
      "nota": "Comune in contesti di concorsi, competizioni artistiche o sportive."
    }
  ]
