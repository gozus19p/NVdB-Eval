  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "emettere un suono o pronunciare un nome per attirare l'attenzione di qualcuno o invitarlo a venire",
      "examples": [
        "Mi ha chiamato dalla finestra per farmi salire.",
        "Chiamò il cameriere con un cenno della mano."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "contattare qualcuno telefonicamente o tramite altri mezzi di comunicazione",
      "examples": [
        "Ti chiamo domani per darti i dettagli.",
        "Mi ha chiamato sul cellulare mentre ero in riunione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "assegnare un nome o un appellativo a una persona, un animale o una cosa",
      "examples": [
        "Hanno chiamato il loro figlio Marco.",
        "Chiamano questo piatto 'risotto alla milanese'."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "convocare qualcuno per un incarico, una funzione o un ruolo specifico",
      "examples": [
        "Lo hanno chiamato a dirigere la nuova filiale.",
        "È stato chiamato a testimoniare in tribunale."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "avere un nome o un appellativo specifico",
      "examples": [
        "Questo fiore si chiama margherita.",
        "Come si chiama quel ristorante in centro?"
      ],
      "nota": "Spesso usato nella forma riflessiva 'chiamarsi'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "considerare o ritenere qualcuno o qualcosa in un certo modo",
      "examples": [
        "Lo chiamano tutti un genio per le sue invenzioni.",
        "Non chiamerei quel film un capolavoro, ma è divertente."
      ],
      "nota": "Spesso usato in contesti valutativi o di giudizio."
    },
    {
      "pos": "verbo impersonale",
      "definition": "essere il momento o la circostanza adatta per fare qualcosa",
      "examples": [
        "Ora non è il momento di chiamare a discutere di queste cose.",
        "Chiamava a gran voce una riforma del sistema."
      ],
      "nota": "Uso meno comune, spesso in contesti formali o enfatici."
    }
  ]
