    },
    {
      "pos": "avverbio",
      "definition": "in presenza di qualcuno, alla sua vista",
      "examples": [
        "Non dire queste cose davanti ai bambini.",
        "Ha confessato tutto davanti al giudice."
      ],
      "nota": "Spesso usato con verbi che implicano interazione o esposizione."
    },
    {
      "pos": "avverbio",
      "definition": "in anticipo rispetto a un evento o una scadenza",
      "examples": [
        "Ho finito il lavoro davanti rispetto alla data prevista.",
        "Siamo arrivati davanti a tutti gli altri."
      ],
      "nota": "Uso meno comune rispetto ai significati spaziali, ma attestato in contesti temporali."
    },
    {
      "pos": "sostantivo m.",
      "definition": "la parte anteriore di qualcosa",
      "examples": [
        "Il davanti della maglietta si è macchiato.",
        "Hanno ridipinto il davanti della casa."
      ],
      "nota": "Usato soprattutto in contesti informali o pratici, spesso in opposizione a 'dietro'."
    },
    {
      "pos": "locuzione preposizionale (davanti a)",
      "definition": "in posizione anteriore rispetto a qualcosa o qualcuno",
      "examples": [
        "Si è fermato davanti alla porta senza entrare.",
        "Davanti al pericolo, è rimasto calmo."
      ],
      "nota": "La locuzione regge un complemento introdotto da 'a'."
    }
