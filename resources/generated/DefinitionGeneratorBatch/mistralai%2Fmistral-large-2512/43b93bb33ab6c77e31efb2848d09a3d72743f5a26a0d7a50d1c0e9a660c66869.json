  "senses": [
    {
      "pos": "avverbio",
      "definition": "in posizione anteriore rispetto a un punto di riferimento spaziale o temporale",
      "examples": [
        "Il supermercato è proprio davanti alla scuola.",
        "Ho parcheggiato la macchina davanti al cancello."
