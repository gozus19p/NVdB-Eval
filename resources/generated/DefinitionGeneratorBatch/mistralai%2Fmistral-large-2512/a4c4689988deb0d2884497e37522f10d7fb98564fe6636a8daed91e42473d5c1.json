  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che offre benessere fisico o praticità d'uso, senza sforzo o disagio.",
      "examples": [
        "Questa poltrona è molto comoda per leggere.",
        "Ho comprato delle scarpe comode per camminare a lungo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si adatta facilmente alle esigenze o ai desideri di qualcuno, spesso evitando impegni o responsabilità.",
      "examples": [
        "È sempre comodo delegare agli altri le decisioni difficili.",
        "Preferisce un lavoro comodo, anche se meno remunerativo."
      ],
      "nota": "Spesso usato con connotazione negativa, implicando pigrizia o mancanza di impegno."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, che agisce con calma e senza fretta, spesso per evitare sforzi o stress.",
      "examples": [
        "È una persona comoda, non si agita mai per nulla.",
        "Sii comodo, non c'è bisogno di correre."
      ],
      "nota": "Può avere una sfumatura leggermente negativa, suggerendo lentezza o mancanza di dinamismo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio o oggetto che offre praticità o benessere fisico.",
      "examples": [
        "Questo divano è un vero comodo per rilassarsi dopo il lavoro.",
        "Ho sistemato un comodo vicino al letto per appoggiare i libri."
      ],
      "nota": "Usato soprattutto in contesti informali o domestici."
    },
    {
      "pos": "avverbio",
      "definition": "In modo che risulti pratico, agevole o senza sforzo.",
      "examples": [
        "Siediti comodo, il film sta per iniziare.",
        "Metti la valigia comodo, così non ingombra."
      ],
      "nota": "Spesso usato in espressioni imperative o suggerimenti."
    }
  ]
