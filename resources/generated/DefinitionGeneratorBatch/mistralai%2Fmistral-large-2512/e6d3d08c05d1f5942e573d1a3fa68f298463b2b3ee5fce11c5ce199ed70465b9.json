  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Allontanamento rapido e improvviso da un luogo, spesso per evitare un pericolo o una situazione spiacevole.",
      "examples": [
        "Dopo l'incidente, la fuga del conducente ha complicato le indagini.",
        "La fuga dei prigionieri è stata scoperta solo all'alba."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Azione di sottrarsi a una responsabilità, un impegno o una situazione difficile.",
      "examples": [
        "La sua fuga dalle responsabilità familiari ha creato tensioni in casa.",
        "Quella decisione è stata solo una fuga dai problemi reali."
      ],
      "nota": "Spesso usato in contesti figurati per indicare evitamento o rinuncia."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Composizione musicale in cui un tema viene ripetuto e sviluppato da più voci in successione.",
      "examples": [
        "Bach è famoso per le sue fughe per organo.",
        "Il pianista ha eseguito una fuga di Mozart con grande maestria."
      ],
      "nota": "Termine tecnico della musica classica."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Serie di elementi architettonici o decorativi disposti in successione continua.",
      "examples": [
        "La fuga di colonne nel chiostro crea un effetto di grande armonia.",
        "Una fuga di archi decorava la facciata del palazzo."
      ],
      "nota": "Uso specifico in ambito architettonico e artistico."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Perdita improvvisa di un fluido o di un gas da un contenitore a causa di una rottura o di un difetto.",
      "examples": [
        "Hanno dovuto evacuare l'edificio per una fuga di gas.",
        "Una fuga d'acqua ha allagato il seminterrato."
      ],
      "nota": "Spesso usato in contesti tecnici o di emergenza."
    }
  ]
