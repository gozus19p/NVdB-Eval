  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte inferiore di un oggetto o struttura che ne sostiene il peso o ne consente la stabilità.",
      "examples": [
        "La base del vaso è troppo stretta e rischia di rovesciarsi.",
        "Hanno costruito una solida base in cemento per il nuovo edificio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Punto di partenza o fondamento su cui si sviluppa un ragionamento, un'attività o un sistema.",
      "examples": [
        "Questa teoria si basa su solide basi scientifiche.",
        "Per imparare una lingua, è importante partire dalle basi grammaticali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Luogo fisico o organizzativo da cui si svolgono operazioni militari, logistiche o di altro tipo.",
      "examples": [
        "La base militare è stata attaccata durante la notte.",
        "Hanno allestito una base operativa per coordinare i soccorsi."
      ],
      "nota": "Spesso usato in contesti militari, sportivi o di emergenza."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Gruppo di persone che sostengono un'organizzazione, un partito o un movimento, spesso contrapposto alla leadership.",
      "examples": [
        "La base del partito ha espresso dissenso verso la nuova linea politica.",
        "Il sindacato ha organizzato un'assemblea per ascoltare le richieste della base."
      ],
      "nota": "Comune in contesti politici o sindacali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In chimica, sostanza che, sciolta in acqua, libera ioni idrossido (OH⁻) e neutralizza gli acidi.",
      "examples": [
        "L'idrossido di sodio è una base forte utilizzata in molti processi industriali.",
        "Per neutralizzare l'acido, è necessario aggiungere una base."
      ],
      "nota": "Uso tecnico diffuso in ambito scientifico e scolastico."
    },
    {
      "pos": "aggettivo",
      "definition": "Che costituisce il fondamento o la parte essenziale di qualcosa.",
      "examples": [
        "Questo corso offre una formazione di base per chi vuole lavorare nel settore.",
        "Le conoscenze di base della matematica sono indispensabili per questo esame."
      ],
      "nota": "Spesso usato in combinazione con sostantivi come 'corso', 'conoscenze', 'competenze'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo fondamentale o essenziale, spesso usato per indicare una condizione minima o di partenza.",
      "examples": [
        "Per partecipare, è base saper nuotare.",
        "Il progetto è base finanziato, ma serviranno altri fondi per completarlo."
      ],
      "nota": "Uso meno comune rispetto alle altre accezioni; spesso sostituibile con 'almeno' o 'fondamentalmente'."
    }
  ]
