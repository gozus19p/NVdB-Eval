  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Essere degno di qualcosa, in base a qualità, azioni o comportamenti.",
      "examples": [
        "Questo studente merita un premio per i suoi risultati.",
        "Non meritava di essere trattato così male dopo tanti anni di lavoro."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un valore o un'importanza tale da giustificare un certo trattamento o considerazione.",
      "examples": [
        "Questo libro merita davvero di essere letto.",
        "La questione merita una riflessione più approfondita."
      ],
      "nota": "Spesso seguito da un verbo all'infinito introdotto da 'di'."
    },
    {
      "pos": "verbo riflessivo (meritarsi)",
      "definition": "Essere degno di qualcosa in seguito a proprie azioni, spesso con una connotazione di giustizia o equità.",
      "examples": [
        "Si è meritata quella promozione dopo anni di impegno.",
        "Non ti meriti tutto questo dopo quello che hai fatto."
      ],
      "nota": "Può avere una sfumatura valutativa, talvolta negativa."
    }
  ]
