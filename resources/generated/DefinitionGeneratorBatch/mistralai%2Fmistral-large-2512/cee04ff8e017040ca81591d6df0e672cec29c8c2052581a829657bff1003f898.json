  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Diventare visibile o percepibile in modo improvviso o inaspettato.",
      "examples": [
        "All'improvviso, un cervo comparve tra gli alberi.",
        "Il suo nome è comparso nella lista dei vincitori."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Presentarsi in un luogo, spesso in risposta a una convocazione o per un obbligo.",
      "examples": [
        "Dovrai comparire in tribunale il mese prossimo.",
        "È comparso davanti al direttore per giustificarsi."
      ],
      "nota": "Spesso usato in contesti formali o legali."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Essere pubblicato o reso pubblico, specialmente in un testo scritto o in un elenco.",
      "examples": [
        "Il suo articolo è comparso sulla prima pagina del giornale.",
        "Il mio nome non compare nell'elenco dei partecipanti."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Apparire in modo fugace o temporaneo, spesso con una connotazione di sorpresa o mistero.",
      "examples": [
        "Un sorriso comparve sul suo volto per un istante.",
        "Un'ombra comparve e subito scomparve dietro l'angolo."
      ],
      "nota": "Può implicare un'apparizione breve o non del tutto chiara."
    }
  ]
