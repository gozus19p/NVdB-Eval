    },
    {
      "pos": "verbo transitivo",
      "definition": "Pronunciare ad alta voce un testo scritto, rendendolo udibile ad altri.",
      "examples": [
        "Mi ha letto una poesia di Montale prima di dormire.",
        "Il professore ha letto ad alta voce le istruzioni per l'esame."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interpretare o attribuire un significato a segni, gesti o situazioni non verbali.",
      "examples": [
        "Ho letto la delusione nei suoi occhi.",
        "Leggo un certo nervosismo nella tua postura."
      ],
      "nota": "Uso figurato, spesso riferito a emozioni o stati d'animo percepibili indirettamente."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Consultare o esaminare un testo, un documento o un supporto informativo per trarne informazioni.",
      "examples": [
        "Ho letto sul giornale che domani ci sarà uno sciopero.",
        "Prima di firmare, leggi bene il contratto."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere scritto o formulato in un certo modo, con riferimento a testi o iscrizioni.",
      "examples": [
        "Sul cartello leggeva: 'Vietato l'accesso'.",
        "Nell'articolo si legge che il governo ha approvato la riforma."
      ],
      "nota": "Soggetto grammaticale è il testo o la parte di testo citata."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di qualcosa che ha poco peso o consistenza, o che è facile da sollevare o trasportare.",
      "examples": [
        "Ho comprato una valigia leggera per il viaggio in aereo.",
        "Preferisco un tessuto leggero per l'estate."
      ],
      "nota": "Può riferirsi anche a cibi o bevande poco calorici o digeribili."
    },
    {
      "pos": "aggettivo",
      "definition": "Di intensità o gravità ridotta, non eccessiva o impegnativa.",
      "examples": [
        "Dopo la corsa ho sentito un leggero dolore al ginocchio.",
        "È stato un temporale leggero, senza danni."
      ],
      "nota": "Spesso usato in contrapposizione a 'forte', 'intenso' o 'grave'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che non richiede grande sforzo mentale o fisico, semplice da eseguire o comprendere.",
      "examples": [
        "Questo esercizio è davvero leggero, lo faccio in cinque minuti.",
        "Mi serve un libro leggero per rilassarmi."
      ],
      "nota": "Può riferirsi anche a lavori, letture o attività ricreative."
    },
    {
      "pos": "aggettivo",
      "definition": "Di comportamento o atteggiamento superficiale, privo di serietà o profondità.",
      "examples": [
        "Ha una personalità troppo leggera per affrontare problemi seri.",
        "Non mi piacciono i film con trame leggere e prevedibili."
      ],
      "nota": "Spesso usato con connotazione negativa, ma può essere neutro in alcuni contesti."
    }
  ]
