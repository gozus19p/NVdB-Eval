  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che appartiene o si riferisce alla fantasia, all'immaginazione, spesso con connotazione di irrealtà o straordinarietà",
      "examples": [
        "Ha scritto un racconto fantastico ambientato in un mondo magico.",
        "Il film mescola elementi storici e fantastici."
      ],
      "nota": "Può riferirsi a generi narrativi (fantasy, fantascienza) o a situazioni irreali. Non va confuso con l'uso colloquiale positivo (vedi senso 2)."
    },
    {
      "pos": "aggettivo",
      "definition": "eccezionalmente bello, piacevole o positivo, usato per esprimere entusiasmo o approvazione",
      "examples": [
        "Abbiamo passato una serata fantastica al concerto.",
        "Il ristorante ha una vista fantastica sul mare."
      ],
      "nota": "Uso colloquiale molto diffuso, spesso iperbolico. Può essere sostituito con 'meraviglioso', 'straordinario' o 'favoloso'."
    },
    {
      "pos": "aggettivo",
      "definition": "che supera i limiti della realtà o della verosimiglianza, spesso con valore negativo",
      "examples": [
        "Le sue pretese sono davvero fantastiche, non possiamo accontentarle.",
        "Ha fatto un piano fantastico che non tiene conto dei vincoli reali."
      ],
      "nota": "In questo senso assume una connotazione negativa, indicando qualcosa di irrealizzabile o eccessivo."
    }
  ]
