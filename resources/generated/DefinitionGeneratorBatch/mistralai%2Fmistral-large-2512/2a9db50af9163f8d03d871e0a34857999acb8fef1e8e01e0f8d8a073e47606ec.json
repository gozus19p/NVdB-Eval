  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona di sesso maschile che detiene autorità o potere su altri, spesso in virtù di una posizione sociale elevata o di proprietà.",
      "examples": [
        "Il signore del castello accolse gli ospiti con grande cortesia.",
        "Quel signore possiede metà delle terre della valle."
      ],
      "nota": "Può indicare anche un titolo nobiliare, come in 'Signore di Milano'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Uomo adulto, usato come forma di cortesia o rispetto nel rivolgersi a qualcuno.",
      "examples": [
        "Mi scusi, signore, sa dirmi che ore sono?",
        "Il signore all'ingresso ha chiesto di lei."
      ],
      "nota": "Spesso usato in contesti formali o nel linguaggio diretto per rivolgersi a estranei."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Titolo onorifico attribuito a Dio o a figure religiose di riferimento.",
      "examples": [
        "Preghiamo il Signore per la pace nel mondo.",
        "Il sacerdote invocò la benedizione del Signore."
      ],
      "nota": "In questo senso, si scrive spesso con la maiuscola ('Signore')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che esercita controllo o dominio su qualcosa o qualcuno, spesso in senso figurato.",
      "examples": [
        "È il signore della sua vita e non si lascia influenzare da nessuno.",
        "Quel cane è il vero signore del parco."
      ],
      "nota": "Può avere una connotazione positiva (padronanza) o negativa (tirannia)."
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione usata per esprimere sorpresa, incredulità o disappunto, spesso in contesti informali.",
      "examples": [
        "Signore, che disastro!",
        "Signore mio, non ci posso credere!"
      ],
      "nota": "Equivalente a 'Dio mio' o 'Mio Dio', ma meno forte dal punto di vista religioso."
    }
  ]
