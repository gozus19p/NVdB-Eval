  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Insieme degli elementi che compongono un oggetto, un edificio o un sistema, organizzati in modo da garantirne la stabilità e la funzionalità.",
      "examples": [
        "La struttura di questo ponte è stata progettata per resistere a forti terremoti.",
        "Hanno rinforzato la struttura portante della casa dopo il cedimento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Modo in cui le parti di un testo, un discorso o un'opera artistica sono organizzate e collegate tra loro.",
      "examples": [
        "La struttura del romanzo è divisa in tre parti principali.",
        "Il professore ha spiegato la struttura del saggio argomentativo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Organizzazione o sistema complesso che coordina attività o risorse per uno scopo specifico.",
      "examples": [
        "La struttura sanitaria della regione è stata riorganizzata per migliorare l'efficienza.",
        "L'azienda ha una struttura gerarchica molto rigida."
      ],
      "nota": "Può riferirsi a enti pubblici, privati o a modelli organizzativi astratti."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Complesso di elementi fisici o concettuali che costituiscono la base di un sistema biologico, chimico o matematico.",
      "examples": [
        "Gli scienziati hanno studiato la struttura molecolare del nuovo composto.",
        "La struttura del DNA è stata scoperta da Watson e Crick."
      ],
      "nota": "Usato soprattutto in contesti scientifici o tecnici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Luogo o edificio adibito a una specifica funzione, spesso pubblico o di servizio.",
      "examples": [
        "Hanno inaugurato una nuova struttura sportiva nel quartiere.",
        "La struttura ospedaliera è dotata delle più moderne attrezzature."
      ],
      "nota": "In questo senso, è spesso usato come sinonimo di 'impianto' o 'centro'."
    }
  ]
