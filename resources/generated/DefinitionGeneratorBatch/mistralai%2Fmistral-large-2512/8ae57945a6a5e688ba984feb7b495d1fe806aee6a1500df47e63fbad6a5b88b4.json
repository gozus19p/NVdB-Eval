  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "sostituire una cosa con un'altra di tipo diverso o modificare lo stato di qualcosa",
      "examples": [
        "Ho cambiato il vecchio divano con uno nuovo.",
        "Devi cambiare la lampadina, non funziona più."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "modificare l'aspetto, la condizione o la situazione di qualcuno o qualcosa",
      "examples": [
        "Il viaggio ha cambiato la sua prospettiva sulla vita.",
        "Questo shampoo cambierà il colore dei tuoi capelli."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "diventare diverso, subire una trasformazione",
      "examples": [
        "Con gli anni, il quartiere è cambiato molto.",
        "Dopo la malattia, è cambiato completamente."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "scambiare denaro di un paese con quello di un altro secondo il tasso di cambio",
      "examples": [
        "Devo cambiare degli euro in dollari per il viaggio.",
        "Hanno cambiato i soldi in una banca del centro."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "sostituire un indumento o un accessorio con un altro",
      "examples": [
        "Ho cambiato la maglietta perché era sporca.",
        "Cambia le lenzuola ogni settimana."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (cambiarsi)",
      "definition": "sostituire i propri indumenti con altri",
      "examples": [
        "Mi cambio prima di uscire.",
        "Si è cambiato in fretta per non perdere il treno."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "modificare la marcia di un veicolo",
      "examples": [
        "Cambia marcia quando sali la salita.",
        "Ho imparato a cambiare le marce senza guardare."
      ],
      "nota": "Usato soprattutto in contesti automobilistici o ciclistici."
    },
    {
      "pos": "verbo transitivo",
      "definition": "sostituire una persona o un animale con un altro in un determinato ruolo o funzione",
      "examples": [
        "Hanno cambiato il portiere all'ultimo minuto.",
        "Cambia il cane con un altro meno aggressivo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "passare da un luogo a un altro, spesso con mezzi di trasporto",
      "examples": [
        "Cambiamo treno a Firenze.",
        "Dobbiamo cambiare autobus per arrivare in centro."
      ],
      "nota": "Usato soprattutto in contesti di viaggio o spostamento."
    }
  ]
