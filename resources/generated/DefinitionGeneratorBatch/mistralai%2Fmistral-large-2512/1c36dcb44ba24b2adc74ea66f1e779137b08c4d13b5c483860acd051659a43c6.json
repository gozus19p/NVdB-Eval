  "senses": [
    {
      "pos": "aggettivo",
      "definition": "relativo agli Stati Uniti d'America o ai suoi abitanti",
      "examples": [
        "Ha studiato la letteratura americana all'università.",
        "Il cinema americano ha influenzato molte culture nel mondo."
      ],
      "nota": "Può riferirsi anche a tutto il continente americano, ma nell'uso contemporaneo prevale il riferimento agli Stati Uniti. In caso di ambiguità, si specifica 'statunitense'."
    },
    {
      "pos": "aggettivo",
      "definition": "tipico o caratteristico degli Stati Uniti d'America",
      "examples": [
        "Mi piace il sogno americano, ma non la sua versione più materialista.",
        "Hanno aperto un ristorante con un menu completamente americano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona originaria o cittadina degli Stati Uniti d'America",
      "examples": [
        "Gli americani sono spesso molto patriottici.",
        "Ha sposato un americano e si è trasferita a New York."
      ],
      "nota": "Al femminile si usa 'americana'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "tipo di caffè lungo, preparato con acqua calda e una dose di espresso",
      "examples": [
        "Al bar ho ordinato un americano con un po' di latte.",
        "Preferisco l'americano al caffè normale perché è meno forte."
      ],
      "nota": "Chiamato così per la sua somiglianza con il caffè filtrato tipico degli Stati Uniti."
    },
    {
      "pos": "sostantivo m.",
      "definition": "gioco di carte simile al bridge, ma con regole semplificate",
      "examples": [
        "Dopo cena abbiamo giocato a americano fino a tardi.",
        "Non conosco bene le regole dell'americano, me le spieghi?"
      ],
      "nota": "Detto anche 'ramino americano' o semplicemente 'ramino'."
    }
  ]
