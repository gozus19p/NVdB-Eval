  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che usa la forza fisica per danneggiare persone o cose, spesso in modo improvviso e incontrollato",
      "examples": [
        "Il padre era un uomo violento e picchiava spesso i figli.",
        "La polizia ha arrestato un gruppo di tifosi violenti dopo gli scontri allo stadio."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che si manifesta con grande intensità e forza, spesso in modo improvviso e distruttivo",
      "examples": [
        "Un temporale violento ha causato danni in tutta la regione.",
        "Ha avuto un attacco di tosse così violento da non riuscire a respirare."
      ],
      "nota": "Può riferirsi a fenomeni naturali, emozioni o reazioni fisiche."
    },
    {
      "pos": "aggettivo",
      "definition": "che esprime o provoca sentimenti di rabbia, odio o aggressività in modo acceso e incontrollato",
      "examples": [
        "Ha reagito con parole violente dopo l'offesa ricevuta.",
        "Il film contiene scene di una violenza verbale molto intensa."
      ],
      "nota": "Si applica spesso a discorsi, reazioni o rappresentazioni."
    },
    {
      "pos": "aggettivo",
      "definition": "che impone la propria volontà sugli altri con prepotenza, senza rispetto per la loro libertà o diritti",
      "examples": [
        "Il regime ha adottato misure violente per reprimere le proteste.",
        "Non sopporto i suoi modi violenti di imporre le sue idee."
      ],
      "nota": "Spesso associato a contesti di potere o autorità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona che usa la forza fisica o psicologica per danneggiare altri o imporre la propria volontà",
      "examples": [
        "Il quartiere è noto per la presenza di violenti che spacciano droga.",
        "La vittima ha denunciato il suo aggressore, un violento già noto alle forze dell'ordine."
      ],
      "nota": "Usato spesso in contesti giuridici o sociali per indicare individui pericolosi."
    }
  ]
