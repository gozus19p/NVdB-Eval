  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Privo di nuvole o perturbazioni atmosferiche; caratterizzato da cielo limpido e tempo stabile.",
      "examples": [
        "Dopo giorni di pioggia, finalmente il cielo è sereno.",
        "Abbiamo scelto una giornata serena per la gita in montagna."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che esprime tranquillità, calma interiore o assenza di preoccupazioni.",
      "examples": [
        "Nonostante le difficoltà, ha mantenuto un atteggiamento sereno.",
        "Dopo la meditazione, si sentiva più sereno e rilassato."
      ],
      "nota": "Spesso usato in contesti emotivi o psicologici per descrivere uno stato d'animo pacifico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione meteorologica caratterizzata da cielo limpido e assenza di perturbazioni.",
      "examples": [
        "Il bollettino meteo prevede sereno su tutta la regione.",
        "Dopo il temporale, è tornato il sereno."
      ],
      "nota": "In meteorologia, può essere usato anche in forma ellittica (es. 'sereno in aumento')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato d'animo di tranquillità e assenza di turbamento.",
      "examples": [
        "La notizia ha portato un po' di sereno nella sua vita.",
        "Dopo anni di conflitti, finalmente regna il sereno in famiglia."
      ],
      "nota": "Spesso usato in espressioni come 'ritrovare il sereno' o 'regnare il sereno'."
    }
  ]
