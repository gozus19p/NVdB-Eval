  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Categoria di persone o cose accomunate da caratteristiche simili.",
      "examples": [
        "Non mi piacciono i film di quel tipo, preferisco la commedia.",
        "Questo è un tipo di pianta molto resistente alla siccità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona considerata in base a caratteristiche fisiche, comportamentali o sociali, spesso con valore neutro o leggermente spregiativo.",
      "examples": [
        "Hai visto quel tipo al bar? Sembrava un po' losco.",
        "È un tipo strano, non parla mai con nessuno."
      ],
      "nota": "Può assumere una connotazione leggermente negativa a seconda del contesto."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Modello o esemplare di un oggetto, spesso usato come riferimento per la produzione o la classificazione.",
      "examples": [
        "Questo è il nuovo tipo di smartphone che uscirà il prossimo mese.",
        "Il museo espone un tipo di automobile d'epoca molto raro."
      ],
      "nota": "Spesso usato in contesti tecnici o commerciali."
    },
    {
      "pos": "avverbio (in funzione di modificatore)",
      "definition": "Usato per indicare un'approssimazione o una quantità non precisa, spesso in combinazione con numeri o aggettivi.",
      "examples": [
        "Ci saranno tipo venti persone alla festa.",
        "Il film dura tipo due ore e mezza."
      ],
      "nota": "Uso colloquiale e informale, diffuso soprattutto nel parlato giovanile."
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Usato per indicare una somiglianza o un'analogia con qualcosa di noto, spesso in espressioni comparative.",
      "examples": [
        "Mi ha fatto un discorso tipo 'dobbiamo risparmiare'.",
        "Vorrei un taglio di capelli tipo quello della tua amica."
      ],
      "nota": "Uso informale, spesso seguito da una citazione o un esempio."
    }
  ]
