  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha la capacità di scorrere e adattarsi alla forma del contenitore, senza avere una forma propria definita.",
      "examples": [
        "L'acqua è uno stato della materia liquido.",
        "Versa il detersivo liquido nel secchio prima di aggiungere l'acqua."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è facilmente convertibile in denaro contante.",
      "examples": [
        "Gli investimenti liquidi permettono di avere accesso rapido ai fondi.",
        "Preferisco avere una parte del mio patrimonio in attività liquide."
      ],
      "nota": "Usato soprattutto in ambito finanziario ed economico."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è chiaro, fluido e privo di ambiguità.",
      "examples": [
        "Il suo discorso era così liquido che tutti hanno capito subito il messaggio.",
        "La spiegazione del professore era liquida e senza incertezze."
      ],
      "nota": "Uso figurato, spesso riferito a discorsi, ragionamenti o stili comunicativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza che scorre e si adatta alla forma del contenitore, caratterizzata da volume definito ma forma variabile.",
      "examples": [
        "Il bicchiere era pieno di un liquido trasparente.",
        "Per preparare la soluzione, mescola i due liquidi in parti uguali."
      ],
      "nota": "In chimica e fisica, si distingue dai solidi e dai gas."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Denaro disponibile in forma immediatamente utilizzabile, come contanti o depositi bancari facilmente accessibili.",
      "examples": [
        "Dopo aver venduto la casa, ha avuto un bel po' di liquido da investire.",
        "In questo momento non ho abbastanza liquido per pagare l'affitto."
      ],
      "nota": "Uso comune in contesti economici e finanziari."
    }
  ]
