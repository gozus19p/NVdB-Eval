  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che include tutti gli elementi o parti che lo costituiscono, senza mancanze.",
      "examples": [
        "Il set di pentole è completo di tutti gli accessori.",
        "Ho letto l'opera completa di Calvino."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha raggiunto il massimo grado di sviluppo o realizzazione.",
      "examples": [
        "È un professionista completo, sa fare tutto.",
        "Questo corso offre una formazione completa."
      ],
      "nota": "Spesso usato in contesti valutativi per indicare eccellenza o versatilità."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di abbigliamento, che comprende giacca, pantaloni o gonna e spesso anche gilet, realizzati con lo stesso tessuto.",
      "examples": [
        "Per il matrimonio indosserò un completo grigio.",
        "Ha comprato un completo nuovo per il colloquio di lavoro."
      ],
      "nota": "In questo senso, si riferisce specificamente a un abito formale da uomo o donna."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di indumenti coordinati, solitamente giacca e pantaloni o gonna, realizzati con lo stesso tessuto.",
      "examples": [
        "Ha indossato un completo elegante per la cerimonia.",
        "Quel negozio vende completi su misura."
      ],
      "nota": "Equivalente a 'abito' in contesti formali."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di luogo o situazione, in cui non c'è più spazio disponibile.",
      "examples": [
        "Il parcheggio è completo, non c'è più posto.",
        "L'albergo era completo e abbiamo dovuto cercare un'altra sistemazione."
      ],
      "nota": "Usato soprattutto in riferimento a posti a sedere, alloggi o spazi limitati."
    }
  ]
