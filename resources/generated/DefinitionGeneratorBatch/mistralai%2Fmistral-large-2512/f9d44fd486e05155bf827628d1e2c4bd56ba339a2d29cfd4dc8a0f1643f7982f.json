  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte terminale del braccio umano, formata dal palmo, dalle dita e dal dorso, usata per afferrare, manipolare oggetti e comunicare gestualmente.",
      "examples": [
        "Si è ferita alla mano con un coltello mentre tagliava le verdure.",
        "Stringimi la mano, così non cadi sul ghiaccio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Modo o stile con cui una persona esegue un'attività, soprattutto artistica o artigianale.",
      "examples": [
        "Questo quadro mostra la mano esperta di un grande pittore.",
        "Il sarto ha una mano leggera nel cucire i tessuti pregiati."
      ],
      "nota": "Spesso usato in contesti che enfatizzano la perizia o lo stile personale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Turno o mossa in un gioco o in un'attività che prevede un ordine di partecipazione.",
      "examples": [
        "Tocca a te, è la tua mano a poker.",
        "Dopo la mano del mazziere, distribuisci le carte agli altri giocatori."
      ],
      "nota": "Usato soprattutto in giochi di carte o situazioni analoghe."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Quantità di qualcosa che può essere tenuta o trasportata con una mano.",
      "examples": [
        "Aggiungi una mano di sale all'impasto per insaporirlo.",
        "Il contadino raccolse una mano di ciliegie mature dall'albero."
      ],
      "nota": "Spesso usato in contesti culinari o agricoli per indicare piccole quantità."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Aiuto o intervento diretto in un'attività, spesso fisico o pratico.",
      "examples": [
        "Mi dai una mano a spostare questo mobile? È troppo pesante.",
        "Senza la mano di un esperto, non riusciremo a riparare la macchina."
      ],
      "nota": "Frequente in espressioni come 'dare una mano' o 'chiedere una mano'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Lato o direzione da cui proviene un'azione o un'influenza.",
      "examples": [
        "La notizia è arrivata dalla mano di un amico fidato.",
        "Il progetto è stato realizzato per mano di un team internazionale."
      ],
      "nota": "Usato in contesti formali o letterari per indicare la provenienza o l'autore di un'azione."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strato di vernice, pittura o altro materiale applicato su una superficie.",
      "examples": [
        "Dopo la prima mano di vernice, il muro sembra già più luminoso.",
        "Applica una mano di primer prima di dipingere la porta."
      ],
      "nota": "Comune in ambito edilizio o artistico per indicare l'applicazione di materiali in strati."
    }
  ]
