  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona investita dell'autorità di emettere sentenze in un tribunale o di valutare controversie legali.",
      "examples": [
        "Il giudice ha dichiarato l'imputato innocente per insufficienza di prove.",
        "Durante il processo, la giudice ha posto domande molto precise ai testimoni."
      ],
      "nota": "Può riferirsi sia a uomini che a donne, con accordo al femminile (es. 'la giudice')."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che ha il compito di valutare competizioni, gare o concorsi, assegnando punteggi o determinando il vincitore.",
      "examples": [
        "Il giudice di gara ha squalificato il concorrente per comportamento antisportivo.",
        "La giuria, composta da tre giudici, ha assegnato il primo premio al giovane pianista."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio religioso, figura divina che valuta le azioni umane, spesso associata a un giudizio finale.",
      "examples": [
        "Nella tradizione cristiana, Dio è visto come il giudice supremo delle anime.",
        "Il predicatore parlava del giorno in cui ognuno sarà davanti al giudice eterno."
      ],
      "nota": "Uso prevalentemente figurato e legato a contesti religiosi o morali."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che esprime un'opinione autorevole o una valutazione su un determinato argomento.",
      "examples": [
        "Secondo il giudice della critica letteraria, il romanzo è un capolavoro.",
        "Mio padre è sempre stato un severo giudice delle mie scelte di vita."
      ],
      "nota": "Uso esteso in contesti non giuridici, spesso con valore figurato."
    }
  ]
