  "senses": [
    {
      "pos": "avverbio",
      "definition": "Indica negazione attenuata o enfatica, spesso usata per correggere un'affermazione precedente o per esprimere incredulità.",
      "examples": [
        "Non è mica facile risolvere questo problema.",
        "Hai mica visto le mie chiavi?"
      ],
      "nota": "Spesso usato in frasi negative o interrogative per rafforzare il senso di negazione o per chiedere conferma in modo informale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Minerale costituito da silicato di alluminio e potassio, spesso in forma di lamelle brillanti.",
      "examples": [
        "Il granito contiene spesso cristalli di mica.",
        "La mica viene utilizzata come isolante elettrico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f. (uso regionale o colloquiale)",
      "definition": "Piccola quantità di cibo, spesso riferito a un pezzo di pane o dolce.",
      "examples": [
        "Vuoi una mica di torta?",
        "Mi sono mangiato solo una mica di pane."
      ],
      "nota": "Uso diffuso soprattutto in alcune regioni italiane, come il Veneto o la Lombardia."
    }
  ]
