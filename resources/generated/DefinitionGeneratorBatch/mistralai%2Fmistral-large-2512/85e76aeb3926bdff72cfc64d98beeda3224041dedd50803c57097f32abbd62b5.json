    {
      "pos": "aggettivo",
      "definition": "Che non manca di alcuna parte o componente; completo in tutte le sue parti.",
      "examples": [
        "Ho letto il libro intero in una sola notte.",
        "La torta è rimasta intera nonostante il trasloco."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non è stato diviso, tagliato o frammentato.",
      "examples": [
        "Preferisco comprare il formaggio in pezzi interi piuttosto che già affettato.",
        "Ha mangiato una mela intera senza dividerla con nessuno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda la totalità di qualcosa, senza eccezioni.",
      "examples": [
        "L'intera popolazione del paese ha partecipato alla festa.",
        "Ha dedicato l'intera giornata allo studio."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "In matematica, relativo a un numero non frazionario, positivo o negativo, compreso lo zero.",
      "examples": [
        "Il numero 5 è un numero intero.",
        "Nella divisione tra interi, il risultato può non essere un intero."
      ],
      "nota": "Uso specifico del linguaggio matematico, diffuso anche in contesti didattici e divulgativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Un numero non frazionario, positivo o negativo, compreso lo zero.",
      "examples": [
        "Gli interi sono un sottoinsieme dei numeri razionali.",
        "Per risolvere questo problema, devi considerare solo gli interi."
      ],
      "nota": "Termine tecnico della matematica, usato anche in ambiti educativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "L'insieme completo di qualcosa, considerato nella sua totalità.",
      "examples": [
        "Ha speso l'intero del suo stipendio in un solo weekend.",
        "L'intero della collezione sarà esposto al museo."
      ],
      "nota": "Uso meno comune rispetto all'aggettivo, spesso in contesti formali o specifici."
    }
