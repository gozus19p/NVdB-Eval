  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta caratteristiche non identiche a quelle di un altro elemento o gruppo di riferimento.",
      "examples": [
        "Questi due modelli di telefono hanno funzionalità diverse.",
        "Le opinioni sul film sono state molto diverse tra loro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si distingue per qualità, aspetto o natura rispetto a ciò che è considerato normale o atteso.",
      "examples": [
        "Ha un modo diverso di affrontare i problemi.",
        "In questo ristorante si mangia un cibo diverso dal solito."
      ],
      "nota": "Può implicare una connotazione positiva o neutra, a seconda del contesto."
    },
    {
      "pos": "aggettivo",
      "definition": "In quantità non specificata ma non trascurabile.",
      "examples": [
        "Ci sono diverse persone in attesa fuori dal negozio.",
        "Ho letto diversi libri sull'argomento prima di scrivere la tesi."
      ],
      "nota": "In questo senso, è spesso usato come sinonimo di 'parecchi' o 'molti'."
    },
    {
      "pos": "pronome indefinito (plurale)",
      "definition": "Un numero non precisato di persone o cose.",
      "examples": [
        "Diversi hanno già espresso il loro parere sulla questione.",
        "Tra i partecipanti, diversi non erano d'accordo con la proposta."
      ],
      "nota": "Usato solo al plurale e in riferimento a persone o cose numerabili."
    }
  ]
