  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Attitudine di una persona o di un sistema a svolgere un compito o una funzione in modo efficace e competente.",
      "examples": [
        "Ha dimostrato grande capacità nel risolvere problemi complessi.",
        "Il corso mira a sviluppare le capacità comunicative degli studenti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Volume o spazio interno di un contenitore, misurabile in unità di misura come litri o metri cubi.",
      "examples": [
        "La capacità del serbatoio dell'auto è di 50 litri.",
        "Questo frigorifero ha una capacità di 300 litri."
      ],
      "nota": "In questo senso, il termine è spesso usato in contesti tecnici o commerciali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Possibilità legale o morale di compiere un'azione o di godere di un diritto.",
      "examples": [
        "La capacità giuridica si acquisisce con la maggiore età.",
        "Non aveva la capacità di intendere e di volere al momento del fatto."
      ],
      "nota": "Usato prevalentemente in ambito giuridico o formale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Misura della quantità di informazione che un sistema può elaborare o trasmettere, spesso espressa in bit o byte.",
      "examples": [
        "La capacità di memoria di questo computer è di 500 GB.",
        "La fibra ottica aumenta la capacità di trasmissione dati."
      ],
      "nota": "Termine tecnico usato in informatica e telecomunicazioni."
    }
  ]
