  "senses": [
    {
      "pos": "aggettivo",
      "definition": "relativo ai meccanismi o alle macchine, o che funziona tramite essi",
      "examples": [
        "Il guasto è di natura meccanica, non elettrica.",
        "La riparazione richiede competenze meccaniche avanzate."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che avviene o viene eseguito senza coinvolgimento della volontà o della riflessione, in modo automatico",
      "examples": [
        "Dopo anni di pratica, i suoi movimenti erano diventati meccanici.",
        "Rispose in modo meccanico, senza pensare davvero alle parole."
      ],
      "nota": "Spesso usato in contrapposizione a 'consapevole' o 'intenzionale'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona specializzata nella riparazione e manutenzione di macchine, veicoli o impianti meccanici",
      "examples": [
        "Ho portato la macchina dal meccanico perché faceva uno strano rumore.",
        "Il meccanico ha sostituito la cinghia di distribuzione in meno di un'ora."
      ],
      "nota": "In contesti informali, può riferirsi anche a chi lavora in ambito industriale o di manutenzione in generale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "complesso di parti mobili che compongono un dispositivo o una macchina, considerato nel suo funzionamento",
      "examples": [
        "Il meccanico dell'orologio si è rotto e va sostituito.",
        "Hanno smontato il motore per controllare il meccanico interno."
      ],
      "nota": "In questo senso, è spesso usato al singolare e può essere preceduto da articoli o aggettivi possessivi."
    }
  ]
