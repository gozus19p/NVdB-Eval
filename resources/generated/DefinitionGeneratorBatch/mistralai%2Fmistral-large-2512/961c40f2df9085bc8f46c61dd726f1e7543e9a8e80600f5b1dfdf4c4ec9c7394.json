  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Capacità fisica di compiere un lavoro o di resistere a uno sforzo, determinata dalla potenza muscolare o dall'energia disponibile.",
      "examples": [
        "Dopo l'infortunio, ha perso molta forza nelle gambe.",
        "Per sollevare quel peso serve una forza notevole."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Vigore o intensità di un fenomeno naturale, di un'azione o di un evento.",
      "examples": [
        "Il vento soffiava con una forza tale da sradicare gli alberi.",
        "La forza dell'esplosione ha distrutto tutti i vetri del palazzo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Potere o autorità esercitati da un individuo, un gruppo o un'istituzione per imporre la propria volontà o mantenere l'ordine.",
      "examples": [
        "La polizia ha usato la forza per disperdere i manifestanti.",
        "Il governo ha perso la forza di imporre le proprie decisioni."
      ],
      "nota": "Spesso usato in contesti politici, giuridici o sociali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Gruppo organizzato di persone, specialmente in ambito militare, lavorativo o sportivo, che agisce in modo coordinato.",
      "examples": [
        "Una forza speciale è stata inviata per liberare gli ostaggi.",
        "La forza lavoro dell'azienda è stata ridotta del 20%."
      ],
      "nota": "Può riferirsi anche a squadre sportive (es. *forza calcistica*)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Energia morale o determinazione interiore che permette di affrontare difficoltà o superare ostacoli.",
      "examples": [
        "Nonostante la malattia, ha trovato la forza di andare avanti.",
        "Serve molta forza d'animo per perdonare un torto così grande."
      ],
      "nota": "Spesso usato in espressioni come *forza d'animo* o *forza interiore*."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In fisica, grandezza vettoriale che misura l'interazione tra corpi, capace di modificarne lo stato di moto o di quiete.",
      "examples": [
        "La forza di gravità attira i corpi verso il centro della Terra.",
        "Per calcolare la forza risultante, bisogna considerare tutte le componenti."
      ],
      "nota": "Termine tecnico usato in ambito scientifico e ingegneristico."
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione usata per incitare, sostenere o esprimere incoraggiamento.",
      "examples": [
        "Forza, ce la puoi fare!",
        "Forza Italia! Gridava la folla allo stadio."
      ],
      "nota": "Spesso usata in contesti sportivi o di supporto emotivo."
    },
    {
      "pos": "avverbio (in funzione di locuzione avverbiale: *a forza di*)",
      "definition": "Indica il mezzo o la ripetizione continua di un'azione che porta a un determinato risultato.",
      "examples": [
        "A forza di insistere, alla fine ha ottenuto quello che voleva.",
        "Si è rovinato la salute a forza di lavorare troppo."
      ],
      "nota": "La locuzione introduce una causa o un'azione reiterata."
    },
    {
      "pos": "verbo transitivo (forma impersonale: *forzare*)",
      "definition": "Costringere qualcuno a fare qualcosa contro la propria volontà o superare un ostacolo con uno sforzo eccessivo.",
      "examples": [
        "Non forzare la porta, si potrebbe rompere.",
        "Hanno forzato i dipendenti a lavorare durante lo sciopero."
      ],
      "nota": "Il lemma *forza* non è un verbo, ma il participio passato di *forzare* può comparire in forme composte (es. *ha forzato*). Questa voce si riferisce al concetto espresso dal verbo correlato."
    }
  ]
