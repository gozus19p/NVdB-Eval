  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ridurre qualcosa in condizioni tali da non poter più essere utilizzato o riconosciuto, danneggiandolo irreparabilmente.",
      "examples": [
        "Il terremoto ha distrutto interi paesi.",
        "Hanno distrutto il vecchio edificio per costruire un centro commerciale."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Annientare o eliminare completamente qualcosa in modo definitivo, spesso in contesti astratti o figurati.",
      "examples": [
        "La guerra ha distrutto ogni speranza di pace.",
        "Quella delusione lo ha distrutto emotivamente."
      ],
      "nota": "Può riferirsi a entità concrete o astratte, come emozioni, progetti o relazioni."
    },
    {
      "pos": "verbo riflessivo (distruggersi)",
      "definition": "Rovinarsi o danneggiarsi gravemente, fisicamente o psicologicamente, per cause esterne o per propria responsabilità.",
      "examples": [
        "Si è distrutto con l'alcol e le droghe.",
        "Dopo anni di stress, si è distrutto la salute."
      ],
      "nota": "Spesso usato in contesti di autodistruzione o deterioramento progressivo."
    }
  ]
