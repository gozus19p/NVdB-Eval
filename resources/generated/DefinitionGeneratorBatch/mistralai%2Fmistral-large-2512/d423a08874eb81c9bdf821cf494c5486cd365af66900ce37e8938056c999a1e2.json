  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "impedire a qualcuno o qualcosa di muoversi, funzionare o procedere",
      "examples": [
        "La polizia ha bloccato la strada per un incidente.",
        "Il malfunzionamento ha bloccato la produzione per ore."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "fermare o interrompere un processo, un'attività o un'azione in corso",
      "examples": [
        "Hanno bloccato i lavori per mancanza di fondi.",
        "Il giudice ha bloccato la vendita della casa."
      ],
      "nota": "Può riferirsi a procedure amministrative, legali o tecniche."
    },
    {
      "pos": "verbo transitivo",
      "definition": "rendere inaccessibile o inutilizzabile un conto, un servizio o una risorsa",
      "examples": [
        "La banca ha bloccato il conto per attività sospette.",
        "Hanno bloccato l'accesso al sito per manutenzione."
      ],
      "nota": "Spesso usato in contesti finanziari o informatici."
    },
    {
      "pos": "verbo intransitivo pronominale (bloccarsi)",
      "definition": "restare improvvisamente fermo o incapace di funzionare",
      "examples": [
        "Il motore si è bloccato all'improvviso.",
        "Mi sono bloccato durante il discorso per l'emozione."
      ],
      "nota": "Può riferirsi a oggetti meccanici o a persone in situazioni di stress o difficoltà."
    },
    {
      "pos": "verbo transitivo",
      "definition": "trattenere qualcuno contro la sua volontà, impedendogli di allontanarsi",
      "examples": [
        "I rapinatori hanno bloccato gli ostaggi nella stanza.",
        "Il vigile ha bloccato il ladro prima che scappasse."
      ],
      "nota": "Uso comune in contesti di sicurezza o emergenza."
    },
    {
      "pos": "verbo transitivo",
      "definition": "fissare saldamente qualcosa in una posizione per evitare movimenti",
      "examples": [
        "Blocca la ruota con un sasso per evitare che rotoli.",
        "Ho bloccato la porta con una sedia per sicurezza."
      ],
      "nota": null
    }
  ]
