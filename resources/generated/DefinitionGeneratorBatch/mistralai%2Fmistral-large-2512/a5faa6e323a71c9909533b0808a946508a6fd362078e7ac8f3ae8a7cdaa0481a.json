  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dichiarare qualcosa con sicurezza e convinzione, spesso per sostenere una propria posizione o idea.",
      "examples": [
        "Ha affermato di non aver mai visto quel documento.",
        "Il presidente ha affermato che la situazione economica migliorerà presto."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (affermarsi)",
      "definition": "Raggiungere successo o riconoscimento in un determinato ambito, spesso dopo sforzi o competizione.",
      "examples": [
        "Dopo anni di gavetta, si è finalmente affermato come uno dei migliori chef della città.",
        "Questo stile musicale si è affermato tra i giovani negli ultimi anni."
      ],
      "nota": "Spesso usato in contesti professionali, artistici o sociali per indicare il consolidamento di una posizione o di una tendenza."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Confermare o validare qualcosa attraverso prove o testimonianze.",
      "examples": [
        "Le analisi hanno affermato la presenza di sostanze nocive nell'acqua.",
        "La sentenza ha affermato la colpevolezza dell'imputato."
      ],
      "nota": "Usato soprattutto in contesti giuridici, scientifici o formali."
    }
  ]
