  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Allontanarsi rapidamente da un luogo per sfuggire a una situazione pericolosa, sgradevole o indesiderata.",
      "examples": [
        "È scappato di casa dopo una lite con i genitori.",
        "Il ladro è scappato prima che arrivasse la polizia."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Uscire inavvertitamente o senza controllo, spesso riferito a liquidi, gas o suoni.",
      "examples": [
        "Il gas è scappato dalla bombola e ha riempito la stanza.",
        "Mi è scappato un urlo quando ho visto il ragno."
      ],
      "nota": "Spesso usato in contesti informali o colloquiali."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Andarsene in fretta per evitare un impegno o una situazione noiosa.",
      "examples": [
        "Ho scappato dalla riunione perché era troppo lunga.",
        "Scappiamo prima che ci chiedano di aiutare a pulire."
      ],
      "nota": "Uso comune in contesti informali, spesso con sfumatura scherzosa."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Detto di tempo, trascorrere velocemente.",
      "examples": [
        "Il weekend è scappato in un attimo.",
        "Non mi sono accorto di come sia scappata l'estate."
      ],
      "nota": "Uso figurato, spesso con connotazione di rammarico per la rapidità del passaggio."
    },
    {
      "pos": "verbo impersonale (ausiliare essere)",
      "definition": "Essere necessario o opportuno andarsene in fretta.",
      "examples": [
        "Scappa, altrimenti facciamo tardi!",
        "Mi è scappato di dover prendere il treno."
      ],
      "nota": "Uso colloquiale, spesso con valore esortativo o di constatazione improvvisa."
    },
    {
      "pos": "verbo transitivo (ausiliare avere)",
      "definition": "Rivelare involontariamente un'informazione segreta o riservata.",
      "examples": [
        "Mi è scappato il nome del vincitore prima dell'annuncio ufficiale.",
        "Ha scappato la verità durante la discussione."
      ],
      "nota": "Uso figurato, spesso riferito a parole o notizie."
    }
