  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Titolo nobiliare di rango più elevato, inferiore solo a quello di re o imperatore.",
      "examples": [
        "Il principe Carlo è diventato re dopo la morte della regina Elisabetta.",
        "Al matrimonio della principessa hanno partecipato molti principi europei."
      ],
      "nota": "Può riferirsi anche al figlio di un re o di una regina, indipendentemente dal titolo effettivo. In alcuni contesti storici, indica il sovrano di un principato (es. il Principe di Monaco)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che eccelle in un determinato campo per abilità, qualità o influenza.",
      "examples": [
        "Mozart è considerato il principe dei compositori.",
        "In quel settore, lui è il principe indiscusso dell'innovazione."
      ],
      "nota": "Uso figurato, spesso enfatico o elogiativo. Può essere usato anche in senso ironico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio filosofico o politico, persona o entità che detiene il potere supremo in uno Stato o in una comunità.",
      "examples": [
        "Nel 'Principe' di Machiavelli, si analizzano le strategie del governante ideale.",
        "Secondo Hobbes, lo Stato è il principe che garantisce l'ordine sociale."
      ],
      "nota": "Uso prevalentemente storico o teorico, derivato dall'opera di Machiavelli. In contesti moderni, può riferirsi a figure di autorità non necessariamente nobiliari."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Primo o più importante elemento di una serie o categoria.",
      "examples": [
        "Il principio di Archimede è fondamentale nello studio della fisica.",
        "Tra i diritti umani, la libertà è considerata il principe."
      ],
      "nota": "Uso figurato, spesso in contesti astratti o teorici. Non va confuso con il termine 'principio' (regola o fondamento)."
    }
  ]
