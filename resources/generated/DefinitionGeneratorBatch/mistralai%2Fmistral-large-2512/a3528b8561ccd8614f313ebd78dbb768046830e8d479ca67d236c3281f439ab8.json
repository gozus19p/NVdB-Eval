  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "eliminare errori o imprecisioni da un testo, un lavoro o una prestazione, indicando le modifiche necessarie",
      "examples": [
        "Il professore ha corretto i compiti degli studenti in una notte.",
        "Prima di inviare la relazione, ho chiesto a un collega di correggerla."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "modificare un comportamento o un atteggiamento ritenuto sbagliato o inadeguato, spesso con intento educativo o disciplinare",
      "examples": [
        "I genitori devono correggere i figli quando dicono bugie.",
        "Il capo ha corretto il tiro dopo aver ricevuto le critiche del team."
      ],
      "nota": "Può implicare un giudizio morale o sociale, a seconda del contesto."
    },
    {
      "pos": "verbo transitivo",
      "definition": "aggiustare o regolare uno strumento o un dispositivo per migliorarne il funzionamento o la precisione",
      "examples": [
        "Il tecnico ha corretto l'allineamento della stampante.",
        "Ho dovuto correggere la mira per colpire il bersaglio."
      ],
      "nota": "Spesso usato in contesti tecnici o sportivi."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "intervenire su qualcosa per migliorarlo o adattarlo a uno standard",
      "examples": [
        "Dopo il feedback, ho corretto sulla presentazione.",
        "Il software corregge automaticamente sugli errori di battitura."
      ],
      "nota": "Uso meno comune rispetto alla forma transitiva, spesso in contesti tecnologici o di revisione."
    },
    {
      "pos": "verbo riflessivo (correggersi)",
      "definition": "riconoscere e modificare un proprio errore o comportamento sbagliato",
      "examples": [
        "Mi sono corretto subito dopo aver detto quella frase infelice.",
        "Si è corretto prima di inviare il modulo, evitando così problemi."
      ],
      "nota": "Implica un atto di autoconsapevolezza e volontà di miglioramento."
    }
  ]
