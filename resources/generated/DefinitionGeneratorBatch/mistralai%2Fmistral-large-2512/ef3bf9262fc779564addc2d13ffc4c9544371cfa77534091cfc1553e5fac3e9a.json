  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che avviene o si manifesta in modo inatteso e senza preavviso",
      "examples": [
        "La sua partenza è stata improvvisa e nessuno ha fatto in tempo a salutarlo.",
        "Un temporale improvviso ha rovinato la gita al mare."
      ],
      "nota": "Può riferirsi a eventi, azioni o cambiamenti che non sono stati previsti o preparati. Spesso usato in contesti negativi o di sorpresa."
    },
    {
      "pos": "aggettivo",
      "definition": "che agisce o decide senza riflettere o pianificare",
      "examples": [
        "È una persona molto improvvisa nelle sue decisioni, a volte senza pensare alle conseguenze.",
        "La sua reazione improvvisa ha sorpreso tutti."
      ],
      "nota": "Può avere una connotazione negativa, implicando mancanza di ponderazione o impulsività."
    },
    {
      "pos": "sostantivo m.",
      "definition": "evento o situazione che si verifica all'improvviso",
      "examples": [
        "L'improvviso del terremoto ha causato panico tra la popolazione.",
        "Non mi aspettavo un improvviso del genere durante la riunione."
      ],
      "nota": "Uso meno comune rispetto all'aggettivo, spesso in contesti formali o letterari. Può essere sostituito da 'imprevisto' o 'sorpresa' nella lingua parlata."
    }
  ]
