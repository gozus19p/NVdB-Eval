  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona originaria della Cina o che ha la cittadinanza cinese.",
      "examples": [
        "Mio marito è cinese e parla mandarino fluentemente.",
        "Al mercato ho conosciuto una cinese che vende spezie rare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lingua ufficiale della Repubblica Popolare Cinese, appartenente alla famiglia sino-tibetana.",
      "examples": [
        "Sto studiando il cinese da due anni, ma è ancora molto difficile.",
        "Il cinese mandarino è la variante più parlata al mondo."
      ],
      "nota": "Può riferirsi anche ad altre lingue e dialetti parlati in Cina, ma nell'uso comune indica principalmente il mandarino standard."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo o appartenente alla Cina, ai suoi abitanti o alla sua cultura.",
      "examples": [
        "Ho comprato un servizio di piatti cinesi molto bello.",
        "La medicina cinese tradizionale usa erbe e agopuntura."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di qualcosa di difficile da comprendere o da decifrare, spesso in modo ironico o scherzoso.",
      "examples": [
        "Questo manuale di istruzioni è scritto in cinese, non ci capisco niente!",
        "Il professore ha spiegato la teoria in modo così complicato che sembrava cinese."
      ],
      "nota": "Uso figurato e colloquiale, spesso riferito a testi, discorsi o situazioni incomprensibili."
    }
  ]
