  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Oggetto o sostanza ottenuti attraverso un processo di lavorazione o trasformazione.",
      "examples": [
        "Questo supermercato offre una vasta gamma di prodotti biologici.",
        "Il prodotto finito sarà consegnato entro la fine del mese."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Risultato di un'operazione matematica, in particolare della moltiplicazione.",
      "examples": [
        "Il prodotto di 5 per 3 è 15.",
        "Per risolvere l'equazione, devi calcolare il prodotto dei due fattori."
      ],
      "nota": "Uso specifico del linguaggio matematico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che deriva o scaturisce da un'attività, un processo o una situazione.",
      "examples": [
        "L'inquinamento è un prodotto dell'industrializzazione selvaggia.",
        "La sua fama è il prodotto di anni di duro lavoro."
      ],
      "nota": "Spesso usato in contesti figurati o astratti."
    },
    {
      "pos": "participio passato del verbo produrre (aggettivo)",
      "definition": "Che è stato realizzato, creato o generato.",
      "examples": [
        "Il film è stato prodotto da una casa cinematografica indipendente.",
        "Questi beni sono prodotti interamente in Italia."
      ],
      "nota": "Può essere usato anche come aggettivo in alcuni contesti."
    }
