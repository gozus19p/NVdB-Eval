  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Apparecchio elettronico che riceve e riproduce segnali sonori trasmessi via onde elettromagnetiche.",
      "examples": [
        "Ho comprato una radio nuova per la cucina.",
        "Durante il viaggio ascoltiamo sempre la radio in macchina."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Tecnica di trasmissione e ricezione di segnali sonori via onde elettromagnetiche, o l'insieme delle trasmissioni così diffuse.",
      "examples": [
        "Lavora alla radio come speaker da dieci anni.",
        "La notizia è stata data in diretta dalla radio nazionale."
      ],
      "nota": "Può riferirsi sia all'attività di broadcasting che all'istituzione che la gestisce."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Onda elettromagnetica utilizzata per la trasmissione di segnali a distanza, in particolare per comunicazioni wireless.",
      "examples": [
        "Il segnale radio si è interrotto durante la chiamata.",
        "I radioamatori comunicano tra loro usando le onde radio."
      ],
      "nota": "Uso tecnico diffuso anche in contesti non specialistici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Osso lungo e sottile dell'avambraccio, situato sul lato del pollice.",
      "examples": [
        "Si è fratturata il radio cadendo dalle scale.",
        "Il medico ha controllato la lastra del radio per verificare la guarigione."
      ],
      "nota": "In anatomia, spesso usato in contrapposizione all'ulna."
    }
  ]
