  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "gettare via qualcosa con un movimento rapido o deciso",
      "examples": [
        "Ho buttato i vecchi giornali nella spazzatura.",
        "Butta quel bicchiere rotto prima che qualcuno si faccia male."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "emettere o produrre qualcosa in modo improvviso o abbondante",
      "examples": [
        "Il camino butta molto fumo quando si accende.",
        "Questo albero butta tantissimi frutti ogni estate."
      ],
      "nota": "Spesso usato per liquidi, gas, odori o elementi naturali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "sprecare o perdere qualcosa, soprattutto tempo, denaro o opportunità",
      "examples": [
        "Non voglio buttare i miei soldi in cose inutili.",
        "Hai buttato via un'occasione d'oro per quel lavoro."
      ],
      "nota": "Uso figurato con connotazione negativa."
    },
    {
      "pos": "verbo transitivo",
      "definition": "scrivere o annotare qualcosa in modo rapido e senza cura",
      "examples": [
        "Ho buttato giù due righe per ricordarmi l'appuntamento.",
        "Butta su un foglio le idee che ti vengono in mente."
      ],
      "nota": "Spesso usato in contesti informali o creativi."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "crescere o svilupparsi in modo rigoglioso o abbondante",
      "examples": [
        "Quest'anno le piante buttano bene grazie alla pioggia.",
        "Il basilico in giardino butta che è una meraviglia."
      ],
      "nota": "Riferito soprattutto a piante o vegetazione."
    },
    {
      "pos": "verbo riflessivo (buttarsi)",
      "definition": "lanciarsi o gettarsi con decisione in una direzione o situazione",
      "examples": [
        "Si è buttato in acqua senza pensarci due volte.",
        "Dopo la laurea, si è buttato nel mondo del lavoro."
      ],
      "nota": "Può avere sia significato letterale che figurato."
    },
    {
      "pos": "verbo riflessivo (buttarsi)",
      "definition": "dedicarsi con impegno e passione a un'attività o progetto",
      "examples": [
        "Si è buttato anima e corpo in quel nuovo progetto.",
        "Dopo il divorzio, si è buttato sullo sport per distrarsi."
      ],
      "nota": "Uso figurato con connotazione positiva."
    },
    {
      "pos": "verbo pronominale (buttarsi via)",
      "definition": "sprecare le proprie capacità o opportunità in modo irresponsabile",
      "examples": [
        "Con quel comportamento, si sta buttando via.",
        "Non voglio buttare via la mia vita in questo modo."
      ],
      "nota": "Uso figurato con connotazione fortemente negativa."
    },
    {
      "pos": "verbo transitivo",
      "definition": "emettere o diffondere calore, luce o energia",
      "examples": [
        "Questo termosifone butta molto calore.",
        "La stufa butta un bel tepore nella stanza."
      ],
      "nota": "Spesso riferito a fonti di calore o luce."
    },
    {
      "pos": "verbo transitivo",
      "definition": "chiudere o interrompere bruscamente una conversazione o un'attività",
      "examples": [
        "Ha buttato giù il telefono senza salutare.",
        "Butta giù quel lavoro e vieni a cena."
      ],
      "nota": "Uso colloquiale, spesso con connotazione di fretta o irritazione."
    }
  ]
