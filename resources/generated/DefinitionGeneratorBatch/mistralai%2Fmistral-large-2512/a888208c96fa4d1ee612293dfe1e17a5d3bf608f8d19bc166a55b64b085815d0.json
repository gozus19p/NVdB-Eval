  "senses": [
    {
      "pos": "avverbio",
      "definition": "In modo meno buono o soddisfacente rispetto a un termine di paragone esplicito o implicito.",
      "examples": [
        "Dopo la cura, sta peggio di prima.",
        "Ho studiato poco e ho fatto peggio dell'ultima volta."
      ],
      "nota": "Può essere usato in comparazioni esplicite (con 'di' o 'che') o implicite. Spesso contrapposto a 'meglio'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo più grave, intenso o negativo rispetto a una situazione precedente o attesa.",
      "examples": [
        "La situazione economica è peggiorata e ora va ancora peggio.",
        "Se continui così, andrà sempre peggio."
      ],
      "nota": "Usato per indicare un peggioramento progressivo o una condizione negativa più marcata."
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Di qualità, condizione o stato inferiore rispetto a un termine di paragone o a uno standard.",
      "examples": [
        "Questo vino è peggio dell'altro che abbiamo assaggiato.",
        "La versione nuova del software è peggio della vecchia."
      ],
      "nota": "Usato in funzione predicativa o attributiva, spesso in comparazioni. Non varia per genere o numero."
    },
    {
      "pos": "sostantivo m. (solo singolare)",
      "definition": "Ciò che è meno buono, soddisfacente o desiderabile rispetto a un'alternativa.",
      "examples": [
        "Tra i due mali, scelgo il peggio.",
        "Non sempre il peggio è inevitabile."
      ],
      "nota": "Usato per indicare la condizione o l'opzione meno favorevole. Spesso in espressioni come 'il peggio' o 'al peggio'."
    },
    {
      "pos": "esclamazione",
      "definition": "Usato per esprimere disappunto, rassegnazione o ironia di fronte a una situazione negativa.",
      "examples": [
        "Peggio! Ora si è anche messo a piovere.",
        "Peggio per te se non hai seguito il mio consiglio."
      ],
      "nota": "Spesso usato in frasi ellittiche o come inciso per sottolineare una conseguenza negativa."
    }
  ]
