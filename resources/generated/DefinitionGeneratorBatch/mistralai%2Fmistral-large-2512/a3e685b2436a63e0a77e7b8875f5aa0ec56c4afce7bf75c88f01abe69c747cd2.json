  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Risultato concreto che si intende raggiungere attraverso un'azione o un progetto.",
      "examples": [
        "Il nostro obiettivo per quest'anno è aumentare le vendite del 20%.",
        "L'obiettivo della missione era recuperare i documenti segreti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lente o sistema di lenti di uno strumento ottico che raccoglie la luce e forma l'immagine.",
      "examples": [
        "Ho pulito l'obiettivo della macchina fotografica prima di scattare le foto.",
        "Questo telescopio ha un obiettivo di grande diametro per osservare le stelle."
      ],
      "nota": "In contesti tecnici o fotografici."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si basa su fatti reali e non su opinioni personali o interpretazioni soggettive.",
      "examples": [
        "Il giornalista ha presentato una descrizione obiettiva dei fatti.",
        "Per valutare correttamente la situazione, dobbiamo mantenere un punto di vista obiettivo."
      ],
      "nota": "Spesso contrapposto a 'soggettivo'."
    }
  ]
