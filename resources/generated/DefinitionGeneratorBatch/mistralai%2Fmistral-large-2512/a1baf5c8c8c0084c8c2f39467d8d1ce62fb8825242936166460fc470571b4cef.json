  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre suoni o musica mediante uno strumento musicale o un dispositivo sonoro.",
      "examples": [
        "Ha imparato a suonare il pianoforte da bambino.",
        "La sveglia suona ogni mattina alle sette."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un brano musicale con uno strumento o con la voce.",
      "examples": [
        "Il violinista ha suonato un concerto di Vivaldi.",
        "Hanno suonato una canzone popolare durante la festa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Emetttere un suono caratteristico, spesso per segnalare qualcosa.",
      "examples": [
        "Il telefono ha suonato per tutta la sera.",
        "La campana suona a mezzogiorno per annunciare la pausa pranzo."
      ],
      "nota": "Può riferirsi a oggetti che emettono suoni meccanici o elettronici."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Colpire qualcuno o qualcosa in modo da produrre un rumore secco o violento.",
      "examples": [
        "Gli ha suonato un pugno in faccia durante la rissa.",
        "Ha suonato la porta sbattendola con forza."
      ],
      "nota": "Uso colloquiale, spesso con connotazione negativa o violenta."
    },
    {
      "pos": "verbo intransitivo (impersonale)",
      "definition": "Essere percepito in un certo modo, specialmente in riferimento a parole o azioni che hanno un effetto particolare.",
      "examples": [
        "Quella frase mi è suonata come una minaccia.",
        "Il suo discorso suona falso alle mie orecchie."
      ],
      "nota": "Uso figurato, spesso legato alla percezione soggettiva di un messaggio."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Raggiungere un certo momento o età, spesso con riferimento a ore o età significative.",
      "examples": [
        "Suonano le dieci, è ora di andare a letto.",
        "Ha appena suonato i quaranta anni."
      ],
      "nota": "Uso comune in espressioni temporali, spesso con riferimento a ore o compleanni."
    }
  ]
