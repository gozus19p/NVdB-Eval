  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Promettere solennemente qualcosa, spesso invocando una divinità o un valore sacro come garante della sincerità.",
      "examples": [
        "Ha giurato fedeltà alla bandiera durante la cerimonia.",
        "Giuro di dire la verità, tutta la verità, nient'altro che la verità."
      ],
      "nota": "Spesso usato in contesti formali o legali, come nei tribunali o nelle cerimonie ufficiali."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Affermare con assoluta certezza e convinzione qualcosa, anche senza un riferimento esplicito a una promessa solenne.",
      "examples": [
        "Giuro che non l'ho mai visto prima d'ora!",
        "Mi ha giurato che sarebbe tornato presto."
      ],
      "nota": "Può esprimere enfasi o insistenza sulla veridicità di un'affermazione, anche in contesti informali."
    },
    {
      "pos": "verbo transitivo (uso figurato)",
      "definition": "Esprimere con forza un sentimento o una convinzione, spesso in modo iperbolico.",
      "examples": [
        "Giuro che questa è la migliore pizza che abbia mai mangiato!",
        "Mi ha giurato odio eterno dopo quel litigio."
      ],
      "nota": "In questo uso, il verbo assume una connotazione enfatica e non implica necessariamente una promessa formale."
    },
    {
      "pos": "verbo riflessivo (giurarsi)",
      "definition": "Fare una promessa solenne a sé stessi o reciprocamente con qualcun altro.",
      "examples": [
        "Si è giurato di non fumare mai più.",
        "Si giurarono amore eterno davanti a tutti gli amici."
      ],
      "nota": "Può indicare un impegno personale o un patto reciproco tra due o più persone."
    }
  ]
