  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Parte superiore del corpo umano o animale dove si trovano cervello, occhi, bocca e altri organi sensoriali.",
      "examples": [
        "Mi fa male il capo da stamattina.",
        "Il gatto si leccava il capo con cura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Estremità iniziale o superiore di un oggetto allungato.",
      "examples": [
        "Ho messo un cappuccio al capo del bastone per non rovinarlo.",
        "Il capo del tavolo era occupato dal padrone di casa."
      ],
      "nota": "Può riferirsi anche a parti di indumenti (es. 'capo di una sciarpa')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che dirige un gruppo, un'organizzazione o un'attività lavorativa.",
      "examples": [
        "Il capo dell'ufficio ha convocato una riunione urgente.",
        "Mio padre è stato capo reparto per vent'anni."
      ],
      "nota": "In contesti informali, può essere usato anche in senso ironico o affettivo (es. 'Sei il capo di casa!')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Unità territoriale o amministrativa di una regione o nazione, spesso con riferimento a isole o territori estesi.",
      "examples": [
        "La Sicilia è il più grande capo d'Italia.",
        "Abbiamo visitato il capo Nord durante il nostro viaggio in Norvegia."
      ],
      "nota": "In geografia, si usa anche per indicare promontori (es. 'capo Horn')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Singolo elemento di un insieme, specialmente in riferimento a bestiame o capi di abbigliamento.",
      "examples": [
        "Il gregge contava oltre duecento capi di pecore.",
        "Ho comprato tre capi nuovi per l'inverno."
      ],
      "nota": "Nel caso dell'abbigliamento, è spesso usato al plurale (es. 'capi firmati')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Punto di partenza o origine di qualcosa, spesso in espressioni fisse.",
      "examples": [
        "Siamo tornati al capo del discorso dopo una lunga digressione.",
        "Alla fine, tutto è partito da un capo di accusa infondato."
      ],
      "nota": "Frequente in locuzioni come 'da capo' (di nuovo) o 'capo d'imputazione' (nel linguaggio giuridico)."
    },
    {
      "pos": "aggettivo (invariabile)",
      "definition": "Che si trova in posizione di comando o superiorità rispetto ad altri.",
      "examples": [
        "Il tecnico capo ha risolto il problema in pochi minuti.",
        "La squadra capo ha coordinato l'intera operazione."
      ],
      "nota": "Usato in combinazione con sostantivi per indicare ruoli gerarchici (es. 'ingegnere capo', 'cuoco capo')."
    }
  ]
