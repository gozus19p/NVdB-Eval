  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Mezzo di trasporto su rotaia composto da una locomotiva e una serie di vagoni, utilizzato per il trasporto di passeggeri o merci su lunghe distanze.",
      "examples": [
        "Ho preso il treno delle 15:30 per Milano.",
        "Il treno merci trasporta container dal porto alla fabbrica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Serie ordinata di elementi che si susseguono con regolarità, spesso in modo meccanico o ripetitivo.",
      "examples": [
        "Un treno di onde ha investito la costa durante la tempesta.",
        "L'azienda ha avviato un treno di riforme per migliorare la produttività."
      ],
      "nota": "In questa accezione, il termine è spesso usato in contesti figurati o tecnici (es. treno di impulsi in elettronica)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di attrezzi o strumenti utilizzati per un'attività specifica, spesso sportiva o artigianale.",
      "examples": [
        "Ha comprato un treno di sci nuovo per la stagione invernale.",
        "Il falegname ha preparato il treno di pialle per levigare il legno."
      ],
      "nota": "In questa accezione, il termine è tipico di ambiti tecnici o specialistici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio giornalistico o politico, situazione in cui una serie di eventi o decisioni si susseguono rapidamente, spesso con effetti negativi.",
      "examples": [
        "Dopo lo scandalo, è partito un treno di dimissioni tra i dirigenti.",
        "Il governo ha varato un treno di misure per contrastare l'inflazione."
      ],
      "nota": "Uso prevalentemente figurato, spesso con connotazione negativa o di urgenza."
    }
  ]
