  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Bevanda alcolica ottenuta dalla fermentazione del mosto d'uva, spesso consumata durante i pasti o in occasioni sociali.",
      "examples": [
        "Ho comprato una bottiglia di vino rosso per la cena di stasera.",
        "In Toscana producono alcuni dei migliori vini italiani."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Quantità di tale bevanda contenuta in un bicchiere o in un altro recipiente.",
      "examples": [
        "Mi versò un vino e brindammo al successo dell'impresa.",
        "Dopo due vini, cominciava a sentirsi un po' alticcio."
      ],
      "nota": "In questo senso, il termine è spesso usato al singolare per indicare una porzione specifica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Colore rosso scuro simile a quello di alcuni tipi di questa bevanda.",
      "examples": [
        "La giacca che indossava era di un bel vino intenso.",
        "Sulle sue guance comparve un rossore vino dopo la corsa."
      ],
      "nota": "Uso prevalentemente aggettivale, anche se il termine rimane invariato (es. 'abito vino')."
    }
  ]
