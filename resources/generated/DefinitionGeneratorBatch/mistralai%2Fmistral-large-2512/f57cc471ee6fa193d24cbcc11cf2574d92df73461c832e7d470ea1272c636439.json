  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "mantenere qualcosa in buono stato o nelle condizioni originarie, evitandone il deterioramento o la perdita",
      "examples": [
        "Bisogna conservare gli alimenti in frigorifero per evitare che si guastino.",
        "Ha conservato tutte le lettere d'amore ricevute durante la giovinezza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "mantenere intatto nel tempo un sentimento, un ricordo, un'abitudine o una qualità",
      "examples": [
        "Anche dopo tanti anni, conserva ancora un grande affetto per la sua città natale.",
        "Nonostante le difficoltà, è riuscito a conservare la calma."
      ],
      "nota": "Spesso usato in contesti figurati per indicare la persistenza di elementi non materiali."
    },
    {
      "pos": "verbo riflessivo (conservarsi)",
      "definition": "rimanere in buone condizioni fisiche o di salute nel tempo",
      "examples": [
        "Mia nonna si è conservata molto bene nonostante l'età.",
        "Per conservarsi in forma, fa attività fisica tutti i giorni."
      ],
      "nota": "Usato soprattutto in riferimento a persone o al loro aspetto fisico."
    }
