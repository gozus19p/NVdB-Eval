  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Metallo di colore grigio-argenteo, duro e resistente, usato in molte leghe e applicazioni industriali.",
      "examples": [
        "Il cancello è stato realizzato in ferro battuto.",
        "Questa pentola è fatta di ferro e trattiene bene il calore."
      ],
      "nota": "Spesso usato in leghe come l'acciaio. In contesti storici o letterari, può riferirsi a strumenti o armi antiche (es. 'ferro da guerra')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Oggetto o strumento realizzato con questo metallo, specialmente se usato per scopi pratici o lavorativi.",
      "examples": [
        "Il fabbro ha forgiato un ferro per marchiare il bestiame.",
        "Ho bisogno di un ferro da stiro per togliere le pieghe dalla camicia."
      ],
      "nota": "In espressioni come 'ferro da stiro' o 'ferro di cavallo', il termine assume significati specifici legati alla funzione dell'oggetto."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento chirurgico o medico utilizzato per interventi o trattamenti.",
      "examples": [
        "Il dentista ha usato un ferro per rimuovere il tartaro.",
        "Nel Medioevo, i ferri erano usati anche per cauterizzare le ferite."
      ],
      "nota": "Uso prevalentemente storico o tecnico, ma ancora attestato in ambito medico."
    },
    {
      "pos": "sostantivo m. plurale (ferri)",
      "definition": "Catene o manette utilizzate per imprigionare qualcuno.",
      "examples": [
        "Il prigioniero fu messo ai ferri dopo il tentativo di fuga.",
        "Nei romanzi storici, i condannati venivano spesso incatenati con i ferri."
      ],
      "nota": "Uso prevalentemente figurato o letterario, ma ancora presente in contesti giuridici o storici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio sportivo, attrezzo utilizzato nel golf per colpire la palla.",
      "examples": [
        "Ha usato un ferro 7 per avvicinarsi alla buca.",
        "I ferri da golf hanno numeri diversi a seconda della distanza che si vuole coprire."
      ],
      "nota": "Termine tecnico specifico del golf, ma diffuso anche in contesti amatoriali."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio marinaresco, ancora di una nave.",
      "examples": [
        "La nave ha gettato il ferro nel porto per ormeggiarsi.",
        "Dopo la tempesta, il capitano ordinò di salpare il ferro."
      ],
      "nota": "Uso tecnico, ma ancora presente in contesti nautici e letterari."
    },
    {
      "pos": "sostantivo m. singolare",
      "definition": "Condizione di privazione della libertà o di costrizione fisica o morale.",
      "examples": [
        "Dopo anni di ferro, finalmente ha ritrovato la libertà.",
        "La dittatura ha tenuto il paese sotto un regime di ferro."
      ],
      "nota": "Uso figurato, spesso in espressioni come 'regime di ferro' o 'disciplina di ferro'."
    },
    {
      "pos": "sostantivo m. singolare",
      "definition": "Nel linguaggio giornalistico o politico, riferimento a misure o provvedimenti molto rigidi o severi.",
      "examples": [
        "Il governo ha annunciato una stretta di ferro contro l'evasione fiscale.",
        "La nuova legge prevede controlli di ferro alle frontiere."
      ],
      "nota": "Uso figurato, spesso associato a termini come 'controllo', 'disciplina' o 'sicurezza'."
    }
  ]
