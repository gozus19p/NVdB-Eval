  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Liquido trasparente, inodore e insapore, composto da idrogeno e ossigeno, essenziale per la vita sulla Terra.",
      "examples": [
        "Ho bevuto un bicchiere d'acqua fresca.",
        "L'acqua del mare è salata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Massa di questo liquido che si estende su una superficie, come mari, fiumi o laghi.",
      "examples": [
        "Abbiamo fatto il bagno nelle acque del lago.",
        "Le acque del fiume sono inquinate."
      ],
      "nota": "Spesso usato al plurale per indicare grandi distese o corpi idrici specifici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Pioggia o precipitazione atmosferica.",
      "examples": [
        "Porta l'ombrello, sta per arrivare l'acqua.",
        "Dopo giorni di sole, finalmente è caduta un po' d'acqua."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Liquido secreto dalle ghiandole sudoripare del corpo umano.",
      "examples": [
        "Dopo la corsa, ero zuppo d'acqua.",
        "Mi è venuta l'acqua in bocca pensando al limone."
      ],
      "nota": "In alcuni contesti, può riferirsi anche alla saliva (es. 'mi è venuta l'acqua alla bocca')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Soluzione liquida utilizzata in vari contesti, come cosmetici, medicinali o prodotti per la pulizia.",
      "examples": [
        "Questa crema contiene acqua termale.",
        "Sciogli la medicina nell'acqua."
      ],
      "nota": "Può indicare anche la componente liquida di un prodotto (es. 'acqua di colonia')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso figurato, elemento che simboleggia purezza, fluidità o instabilità.",
      "examples": [
        "Le sue promesse sono solo acqua passata.",
        "Quella relazione è finita in un mare d'acqua."
      ],
      "nota": "Spesso usato in espressioni idiomatiche (es. 'acqua in bocca', 'fare acqua da tutte le parti')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio marinaresco, profondità del mare in un determinato punto.",
      "examples": [
        "La nave ha toccato il fondo perché c'era poca acqua.",
        "Il capitano ha controllato la carta delle acque."
      ],
      "nota": "Uso tecnico diffuso in contesti nautici."
    }
  ]
