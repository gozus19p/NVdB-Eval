  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo ai cittadini e alla loro organizzazione sociale, politica e giuridica.",
      "examples": [
        "La Costituzione italiana tutela i diritti civili di tutti i cittadini.",
        "Il codice civile regola i rapporti tra privati."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda la vita quotidiana e le relazioni tra persone, in contrapposizione a militare o religioso.",
      "examples": [
        "Indossava abiti civili per non attirare l'attenzione.",
        "Dopo il congedo, è tornato alla vita civile."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si comporta con educazione, rispetto e cortesia.",
      "examples": [
        "È stato molto civile nel rispondere alle critiche.",
        "Nonostante la discussione accesa, ha mantenuto un tono civile."
      ],
      "nota": "Spesso usato in contrapposizione a comportamenti rozzi o aggressivi."
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda cause o procedimenti giudiziari non penali.",
      "examples": [
        "Ha intentato una causa civile per il risarcimento dei danni.",
        "Il giudice ha emesso una sentenza nel processo civile."
      ],
      "nota": "In ambito giuridico, si distingue dal diritto penale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "L'insieme dei cittadini di uno Stato, considerati come comunità organizzata.",
      "examples": [
        "Il governo deve agire nell'interesse del civile.",
        "La guerra ha causato enormi sofferenze tra il civile."
      ],
      "nota": "Spesso usato in contrapposizione a 'militare' o 'clero'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Comportamento educato e rispettoso delle norme sociali.",
      "examples": [
        "Mancare di rispetto è una mancanza di civile.",
        "Il civile impone di salutare quando si entra in una stanza."
      ],
      "nota": "Usato in espressioni come 'senso del civile' o 'rispetto del civile'."
    }
  ]
