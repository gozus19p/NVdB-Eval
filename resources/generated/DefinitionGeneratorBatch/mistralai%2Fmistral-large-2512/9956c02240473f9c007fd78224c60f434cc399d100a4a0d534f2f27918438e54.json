  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Essere presente o elencato in un elenco, una lista o una documentazione ufficiale.",
      "examples": [
        "Il suo nome figura nell'elenco dei partecipanti al convegno.",
        "Questo prodotto non figura più nel catalogo dell'azienda."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Apparire o risultare in un determinato modo, spesso in modo evidente o rilevante.",
      "examples": [
        "Nella foto figurava con un abito elegante.",
        "Tra i vincitori figurano anche alcuni studenti della nostra scuola."
      ],
      "nota": "Spesso usato in contesti in cui si sottolinea la presenza o l'inclusione in un gruppo o una situazione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rappresentare o simboleggiare qualcosa attraverso immagini, simboli o allegorie.",
      "examples": [
        "Il leone figura spesso come simbolo di coraggio.",
        "Nel dipinto, la donna figura la giustizia con una bilancia in mano."
      ],
      "nota": "Uso prevalentemente letterario o artistico."
    },
    {
      "pos": "verbo riflessivo (figurarsi)",
      "definition": "Immaginare o concepire mentalmente una situazione, spesso con valore esortativo o ironico.",
      "examples": [
        "Figurati che sorpresa quando ho visto il regalo!",
        "Figurati se accetto una proposta del genere!"
      ],
      "nota": "Spesso usato in frasi esclamative per esprimere stupore, incredulità o per invitare qualcuno a immaginare una situazione."
    }
  ]
