  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere sporcizia, polvere o impurità da una superficie, un oggetto o un ambiente.",
      "examples": [
        "Ho pulito il pavimento dopo la festa.",
        "Pulisce sempre le verdure prima di cucinarle."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rendere qualcosa libero da elementi indesiderati o superflui, spesso in senso figurato.",
      "examples": [
        "Ha pulito il testo da tutte le ripetizioni inutili.",
        "Il governo promette di pulire la città dalla criminalità."
      ],
      "nota": "Può avere una connotazione metaforica, riferendosi a eliminazione di elementi astratti (errori, problemi, ecc.)."
    },
    {
      "pos": "verbo riflessivo (pulirsi)",
      "definition": "Rimuovere sporcizia dal proprio corpo o da una parte di esso.",
      "examples": [
        "Si pulisce le mani con il sapone dopo aver lavorato in giardino.",
        "Dopo la corsa, si è pulito il sudore dalla fronte."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Diventare libero da sporcizia o impurità, spesso riferito a condizioni atmosferiche o ambientali.",
      "examples": [
        "Dopo la pioggia, il cielo si è pulito rapidamente.",
        "L'aria si è pulita dopo il temporale."
      ],
      "nota": "Usato soprattutto in contesti meteorologici o ambientali."
    }
  ]
