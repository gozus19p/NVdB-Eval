  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha scarsa altezza o estensione verticale rispetto a una misura considerata normale o media.",
      "examples": [
        "Quella stanza è troppo bassa per appendere un lampadario.",
        "Il soffitto della cantina è molto basso, devi stare attento a non sbattere la testa."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si trova a un livello inferiore rispetto a un punto di riferimento.",
      "examples": [
        "Il piano basso dell'edificio è stato allagato dalla pioggia.",
        "Preferisco sedermi nei posti bassi del teatro per vedere meglio."
      ],
      "nota": "Spesso usato in contrapposizione a 'alto' per indicare una posizione spaziale."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha un volume o un'intensità sonora ridotta.",
      "examples": [
        "Parla a voce bassa, non voglio che ci sentano.",
        "Ho abbassato il volume della radio perché era troppo alto."
      ],
      "nota": "Può riferirsi anche a suoni o rumori in generale."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha un valore, una quantità o un livello inferiore alla media o a un termine di paragone.",
      "examples": [
        "Il prezzo di quel prodotto è rimasto basso nonostante l'inflazione.",
        "Le temperature sono state insolitamente basse per questo periodo dell'anno."
      ],
      "nota": "Usato in contesti economici, meteorologici, statistici, ecc."
    },
    {
      "pos": "aggettivo",
      "definition": "Che manca di qualità morali o intellettuali elevate; volgare o meschino.",
      "examples": [
        "È stato un gesto davvero basso da parte sua.",
        "Non mi aspettavo un comportamento così basso da un professionista come lui."
      ],
      "nota": "Uso figurato con connotazione negativa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte inferiore di qualcosa, in contrapposizione alla parte superiore.",
      "examples": [
        "Il basso della maglietta è tutto sporco di fango.",
        "Ho dipinto il basso del muro di blu e il resto di bianco."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento musicale a corde o a fiato che produce suoni gravi.",
      "examples": [
        "Suona il basso in una band rock.",
        "Il basso elettrico è fondamentale per il ritmo della canzone."
      ],
      "nota": "Può riferirsi anche al musicista che suona tale strumento."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Voce maschile che canta nella tessitura più grave.",
      "examples": [
        "Il basso ha intonato un'aria celebre dell'opera.",
        "Nel coro c'è bisogno di un basso per completare le armonie."
      ],
      "nota": "In ambito musicale, si riferisce anche alla parte vocale o strumentale più grave."
    },
    {
      "pos": "avverbio",
      "definition": "A un livello inferiore rispetto a un punto di riferimento; verso il basso.",
      "examples": [
        "Guarda basso se vuoi trovare le chiavi che hai perso.",
        "L'aereo volava troppo basso e ha sfiorato gli alberi."
      ],
      "nota": "Spesso usato in combinazione con verbi di movimento o posizione."
    },
    {
      "pos": "avverbio",
      "definition": "Con un volume o un'intensità sonora ridotta.",
      "examples": [
        "Parla più basso, non voglio svegliare il bambino.",
        "Ho sentito un rumore basso provenire dalla cantina."
      ],
      "nota": null
    }
  ]
}