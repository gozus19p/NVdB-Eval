  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha una dimensione maggiore rispetto alla norma o a ciò che è considerato stretto o ristretto in larghezza.",
      "examples": [
        "La strada è troppo larga per essere chiusa al traffico.",
        "Ha comprato un maglione largo per stare più comodo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che offre spazio sufficiente o abbondante; ampio.",
      "examples": [
        "Questa stanza è abbastanza larga per ospitare tutti gli invitati.",
        "Preferisco i pantaloni larghi quando fa caldo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non è aderente o stretto; comodo.",
      "examples": [
        "Dopo pranzo mi metto sempre una camicia larga.",
        "Le scarpe nuove mi stanno un po' larghe."
      ],
      "nota": "Spesso usato per indumenti o calzature."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si estende in modo esteso o generoso; abbondante.",
      "examples": [
        "Ha una cultura molto larga in materia di arte.",
        "Il direttore ha una visione larga delle regole."
      ],
      "nota": "Usato in contesti figurati per indicare apertura mentale o generosità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio aperto e ampio, spesso in contesti urbani.",
      "examples": [
        "Ci incontriamo al largo davanti al municipio.",
        "Il corteo si è fermato nel largo principale della città."
      ],
      "nota": "In alcune città italiane, indica una piazza o uno slargo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Zona di mare lontano dalla costa.",
      "examples": [
        "La barca si è diretta verso il largo per evitare la tempesta.",
        "Da qui si vede solo il largo, non la riva."
      ],
      "nota": "Spesso usato in espressioni come 'al largo' o 'in alto mare'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo ampio o abbondante; con generosità.",
      "examples": [
        "Ha distribuito i regali largo a tutti i presenti.",
        "Se hai bisogno di aiuto, chiedi pure largo."
      ],
      "nota": "Usato soprattutto in contesti informali o regionali."
    },
    {
      "pos": "avverbio",
      "definition": "Con un ritmo musicale più lento e ampio rispetto al tempo indicato.",
      "examples": [
        "Il direttore ha chiesto di suonare il pezzo largo.",
        "Questo passaggio va eseguito largo e con espressione."
      ],
      "nota": "Termine tecnico usato in musica."
    }
  ]
