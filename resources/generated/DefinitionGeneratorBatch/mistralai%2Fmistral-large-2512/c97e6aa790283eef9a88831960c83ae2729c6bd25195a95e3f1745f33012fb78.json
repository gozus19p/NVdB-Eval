  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona che insegna in una scuola primaria o che ha competenze specifiche in un'arte, una disciplina o un mestiere e le trasmette ad altri.",
      "examples": [
        "Il maestro di scuola ha spiegato la matematica con grande chiarezza.",
        "Mio nonno era un maestro falegname e mi ha insegnato tutti i segreti del mestiere."
      ],
      "nota": "Può riferirsi sia a insegnanti della scuola primaria sia a esperti in un campo specifico che fungono da guide o mentori."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che ha raggiunto un livello di eccellenza in un'arte, una disciplina o un'attività, spesso riconosciuta come modello o punto di riferimento.",
      "examples": [
        "Leonardo da Vinci è considerato un maestro dell'arte rinascimentale.",
        "Questo chef è un vero maestro nella preparazione dei risotti."
      ],
      "nota": "In questo senso, il termine assume una connotazione di ammirazione e rispetto per le capacità superiori."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Direttore di un'orchestra o di un coro.",
      "examples": [
        "Il maestro d'orchestra ha diretto la sinfonia con grande passione.",
        "Durante il concerto, il maestro ha salutato il pubblico con un inchino."
      ],
      "nota": "In ambito musicale, il termine è spesso abbreviato in 'M°' (es. M° Abbado)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Vento che soffia da nord-ovest, tipico del Mediterraneo.",
      "examples": [
        "Il maestro ha portato un po' di fresco dopo giorni di caldo afoso.",
        "I pescatori sanno che il maestro può rendere il mare molto mosso."
      ],
      "nota": "In meteorologia, è anche chiamato 'maestrale'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è principale, fondamentale o di grande importanza in un determinato contesto.",
      "examples": [
        "La strada maestra del paese è sempre trafficata durante l'estate.",
        "Per risolvere il problema, dobbiamo seguire la via maestra della diplomazia."
      ],
      "nota": "Spesso usato in espressioni fisse come 'strada maestra' o 'via maestra'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è abile, esperto o particolarmente bravo in qualcosa.",
      "examples": [
        "È un artigiano maestro nel lavorare il vetro soffiato.",
        "Con quel colpo, ha dimostrato di essere un giocatore maestro."
      ],
      "nota": "In questo uso, l'aggettivo è spesso anteposto al sostantivo (es. 'maestro artigiano')."
    }
  ]
}