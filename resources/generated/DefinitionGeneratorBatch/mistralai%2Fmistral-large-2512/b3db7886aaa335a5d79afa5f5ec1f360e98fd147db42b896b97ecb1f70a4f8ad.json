  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "porre qualcosa in modo che sia sostenuto da una superficie o da un supporto, senza che cada",
      "examples": [
        "Appoggia il bicchiere sul tavolo prima che cada.",
        "Ho appoggiato la scala al muro per salire sul tetto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "sostenere o favorire una persona, un'idea o un'iniziativa, spesso in modo esplicito o pubblico",
      "examples": [
        "Il sindaco ha appoggiato la proposta di legge per la tutela ambientale.",
        "Molti elettori appoggiano quel candidato per le sue idee innovative."
      ],
      "nota": "Spesso usato in contesti politici, sociali o lavorativi."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "essere collocato o poggiato su una superficie o un supporto",
      "examples": [
        "La borsa appoggia sul pavimento vicino all'ingresso.",
        "Il quadro appoggia contro la parete, ma non è ancora appeso."
      ],
      "nota": "Può implicare una posizione temporanea o non stabile."
    },
    {
      "pos": "verbo riflessivo (appoggiarsi)",
      "definition": "sostenersi o poggiarsi a qualcosa o qualcuno per mantenere l'equilibrio o trovare conforto",
      "examples": [
        "Si è appoggiato al muro per non cadere dalla stanchezza.",
        "Durante la conferenza, si è appoggiato al leggio per parlare con più sicurezza."
      ],
      "nota": "Può avere anche un senso figurato, come nel caso di 'appoggiarsi a un'idea' per indicare fiducia o dipendenza."
    },
    {
      "pos": "verbo riflessivo (appoggiarsi)",
      "definition": "fare affidamento su qualcuno o qualcosa per ottenere aiuto o supporto",
      "examples": [
        "In questo progetto, ci appoggiamo alla collaborazione di esperti esterni.",
        "Non potendo risolvere il problema da solo, si è appoggiato ai consigli del suo mentore."
      ],
      "nota": "Uso figurato, spesso riferito a supporto morale, economico o professionale."
    }
  ]
}