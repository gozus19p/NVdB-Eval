        "Ha comprato un tavolo mobile per poterlo spostare quando serve.",
        "Il telefono mobile è diventato uno strumento indispensabile nella vita quotidiana."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che cambia frequentemente o non è fisso nel tempo.",
      "examples": [
        "Il prezzo del carburante è molto mobile in questo periodo.",
        "Ha un umore mobile, difficile da prevedere."
      ],
      "nota": "Spesso usato in contesti relativi a variazioni di stato o condizione."
    },
    {
      "pos": "sostantivo m.",
      "definition": "oggetto di arredamento destinato a contenere oggetti o a sostenere attività domestiche.",
      "examples": [
        "Ha comprato un nuovo mobile per la sala da pranzo.",
        "Quel negozio vende mobili di design moderno."
      ],
      "nota": "In questa accezione, il plurale 'mobili' è più comune del singolare."
    },
    {
      "pos": "sostantivo m.",
      "definition": "corpo celeste che si muove nello spazio, in particolare riferito ai pianeti.",
      "examples": [
        "Gli antichi astronomi studiavano il moto dei mobili celesti.",
        "Il sistema solare è composto da una stella e diversi mobili."
      ],
      "nota": "Uso tecnico e meno comune nell'italiano contemporaneo, prevalentemente in ambito astronomico."
    }
