    },
    {
      "pos": "verbo transitivo",
      "definition": "assumere aria contenente una sostanza o un odore specifico",
      "examples": [
        "In montagna si respira aria pulita.",
        "Appena entrato, ho respirato un profumo di pane appena sfornato."
      ],
      "nota": "Spesso usato in contesti figurati per indicare la percezione di un'atmosfera o clima particolare."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "trovare sollievo o pausa in una situazione difficile o stressante",
      "examples": [
