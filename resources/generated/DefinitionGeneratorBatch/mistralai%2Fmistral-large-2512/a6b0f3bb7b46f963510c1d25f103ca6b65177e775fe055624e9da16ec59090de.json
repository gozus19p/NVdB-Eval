  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che è stato prodotto o realizzato da poco tempo e non è ancora stato usato o consumato",
      "examples": [
        "Ho comprato una macchina nuova di zecca.",
        "Questo libro è nuovo, non l'ha ancora letto nessuno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che si differenzia da ciò che esisteva prima, introducendo cambiamenti o innovazioni",
      "examples": [
        "Il governo ha annunciato una nuova politica economica.",
        "Abbiamo adottato un nuovo metodo di lavoro più efficiente."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che si verifica o si manifesta nuovamente dopo un periodo di assenza o interruzione",
      "examples": [
        "Dopo la pausa estiva, è tornato al lavoro con nuovo entusiasmo.",
        "La squadra ha mostrato una nuova determinazione in questa partita."
      ],
      "nota": "Spesso usato in combinazione con sostantivi astratti per indicare un rinnovato vigore o atteggiamento."
    },
    {
      "pos": "aggettivo",
      "definition": "che non è ancora noto o familiare a qualcuno",
      "examples": [
        "Questo posto mi è nuovo, non ci sono mai stato prima.",
        "Il concetto di intelligenza artificiale è ancora nuovo per molti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "ciò che è recente o innovativo, spesso in contrapposizione a ciò che è vecchio o tradizionale",
      "examples": [
        "Il nuovo spesso spaventa chi è abituato alle vecchie abitudini.",
        "In questa mostra si celebra il nuovo nell'arte contemporanea."
      ],
      "nota": "Usato soprattutto in contesti filosofici, artistici o culturali."
    }
  ]
