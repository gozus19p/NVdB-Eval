  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Animale vertebrato acquatico, dotato di branchie per respirare e pinne per nuotare, che vive in acque dolci o salate.",
      "examples": [
        "Ho visto un banco di pesci colorati nell'acquario.",
        "Il pesce spada è un predatore molto veloce."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Carne commestibile di questo animale, utilizzata come alimento.",
      "examples": [
        "A cena ho mangiato del pesce al forno con le patate.",
        "Il pesce azzurro è ricco di omega-3."
      ],
      "nota": "In questa accezione, il termine è spesso usato al singolare collettivo (es. 'mi piace il pesce')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona ingenua o facilmente raggirabile.",
      "examples": [
        "Non fare il pesce, quella truffa è evidente!",
        "Si è comportato da pesce e ha creduto a tutte le loro bugie."
      ],
      "nota": "Uso figurato e colloquiale, spesso con connotazione negativa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Costellazione zodiacale raffigurante un animale acquatico, associata al periodo tra febbraio e marzo.",
      "examples": [
        "Sono del segno dei Pesci, quindi molto intuitivo.",
        "La costellazione dei Pesci è visibile in autunno."
      ],
      "nota": "In questa accezione, il termine è sempre usato al plurale ('Pesci')."
    }
  ]
