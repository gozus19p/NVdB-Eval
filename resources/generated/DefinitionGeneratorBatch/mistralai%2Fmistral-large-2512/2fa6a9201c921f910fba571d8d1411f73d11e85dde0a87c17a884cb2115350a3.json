  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Alimento base ottenuto impastando farina con acqua e lievito, poi cotto al forno, generalmente di forma allungata o rotonda.",
      "examples": [
        "Ho comprato una pagnotta di pane fresco questa mattina.",
        "Per cena prepariamo bruschette con pane tostato e aglio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostentamento o mezzo di sussistenza, spesso usato in senso figurato.",
      "examples": [
        "Il lavoro è il pane quotidiano per molte famiglie.",
        "Quell'attività gli ha dato il pane per anni."
      ],
      "nota": "In questa accezione, il termine assume spesso una connotazione metaforica legata alla sopravvivenza o al guadagno."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Blocco compatto di una sostanza solida, spesso modellato in forme geometriche regolari.",
      "examples": [
        "Ho comprato un pane di burro per la torta.",
        "Il pane di zucchero era usato in passato per conservare lo zucchero."
      ],
      "nota": "Usato per indicare sostanze diverse dal cibo tradizionale, come burro, sapone o metalli lavorati."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Denaro o guadagno, specialmente in contesti informali o gergali.",
      "examples": [
        "Con quel lavoro finalmente ha portato a casa un po' di pane.",
        "Senza un contratto fisso, è difficile guadagnarsi il pane."
      ],
      "nota": "Accezione colloquiale, spesso usata in espressioni come 'guadagnarsi il pane'."
    }
