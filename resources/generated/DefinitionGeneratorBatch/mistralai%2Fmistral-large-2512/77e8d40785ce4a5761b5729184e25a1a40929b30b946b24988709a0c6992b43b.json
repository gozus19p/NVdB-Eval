  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Miscuglio di gas e particelle solide prodotto dalla combustione di materiali organici, visibile come nuvola grigia o nera.",
      "examples": [
        "Il camino emetteva un denso fumo nero.",
        "Dopo l'incendio, l'aria era piena di fumo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza che si inala o si aspira, derivata dalla combustione del tabacco o di altre erbe, spesso per abitudine o piacere.",
      "examples": [
        "Ha smesso di comprare pacchetti di sigarette per ridurre il fumo.",
        "Il divieto di fumo nei locali pubblici è entrato in vigore anni fa."
      ],
      "nota": "Spesso usato in riferimento al consumo di sigarette, sigari o pipe."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che appare reale o concreto ma in realtà non ha consistenza o valore.",
      "examples": [
        "Le sue promesse si sono rivelate solo fumo.",
        "Quella società è fallita: era tutta fumo e niente arrosto."
      ],
      "nota": "Uso figurato per indicare qualcosa di illusorio o privo di sostanza."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Effetto visivo o sensazione di calore che sembra salire dall'asfalto o da superfici molto calde, dovuto alla rifrazione della luce.",
      "examples": [
        "Sull'autostrada, in estate, si vede il fumo sull'asfalto.",
        "Il fumo che sale dal deserto crea miraggi."
      ],
      "nota": "Comunemente associato a fenomeni ottici in condizioni di caldo intenso."
    }
  ]
