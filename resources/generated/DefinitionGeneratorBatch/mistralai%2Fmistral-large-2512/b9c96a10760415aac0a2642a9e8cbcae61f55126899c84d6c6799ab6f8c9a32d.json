    },
    {
      "pos": "sostantivo f.",
      "definition": "Sistema di produzione, distribuzione e consumo di beni e servizi all'interno di una comunità, di un paese o a livello globale.",
      "examples": [
        "L'economia italiana dipende in gran parte dalle esportazioni.",
        "La crisi ha colpito duramente l'economia locale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Risparmio o uso oculato di risorse, tempo o denaro.",
      "examples": [
        "Per fare economia, abbiamo deciso di non accendere il riscaldamento.",
        "Questa macchina offre una buona economia di carburante."
      ],
      "nota": "Spesso usato in contesti pratici o quotidiani per indicare un utilizzo parsimonioso delle risorse."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Struttura o organizzazione che regola la gestione delle risorse in un ambito specifico.",
      "examples": [
        "L'economia domestica richiede una buona pianificazione.",
        "L'economia dell'attenzione è un concetto chiave nel marketing digitale."
      ],
      "nota": "Può riferirsi a contesti più ristretti, come la gestione familiare o settoriale."
    }
