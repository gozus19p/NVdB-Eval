    {
      "pos": "verbo transitivo",
      "definition": "continuare a svolgere o a portare avanti qualcosa di specifico.",
      "examples": [
        "Nonostante le difficoltà, ha proseguito il suo progetto di ricerca.",
        "Il professore ha proseguito la lezione dopo aver risposto alle domande."
      ],
      "nota": "In questa accezione, il verbo regge un complemento oggetto diretto."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "estendersi o svilupparsi nel tempo o nello spazio senza soluzione di continuità.",
      "examples": [
        "La strada prosegue per altri dieci chilometri prima di arrivare al paese.",
        "La tradizione prosegue da generazioni in questa famiglia."
      ],
      "nota": "Spesso usato in contesti spaziali o temporali."
    }
