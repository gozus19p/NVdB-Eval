  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che ha una temperatura notevolmente inferiore a quella del corpo umano, tale da provocare una sensazione di disagio o da richiedere protezione",
      "examples": [
        "L'acqua del lago è troppo fredda per fare il bagno.",
        "Indossa una giacca, fuori fa freddo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "privo di calore umano, affetto o partecipazione emotiva",
      "examples": [
        "Il suo sguardo era freddo e distaccato.",
        "Ha ricevuto una risposta fredda e formale."
      ],
      "nota": "Spesso usato in contrapposizione a 'caldo' per indicare mancanza di empatia o entusiasmo."
    },
    {
      "pos": "aggettivo",
      "definition": "che denota mancanza di entusiasmo, scarsa partecipazione o poca vivacità",
      "examples": [
        "L'accoglienza del pubblico è stata piuttosto fredda.",
        "Il suo discorso è stato freddo e poco coinvolgente."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che si mantiene lucido e controllato in situazioni di stress o pericolo",
      "examples": [
        "Ha mantenuto la mente fredda durante l'emergenza.",
        "È riuscito a prendere una decisione fredda e razionale."
      ],
      "nota": "Usato spesso in contesti che richiedono autocontrollo o prontezza di riflessi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "bassa temperatura, specialmente quella che provoca disagio o richiede protezione",
      "examples": [
        "Con questo freddo è meglio restare a casa.",
        "Il freddo dell'inverno mi fa venire i brividi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "mancanza di calore umano, affetto o partecipazione emotiva",
      "examples": [
        "Tra loro c'è sempre stato un certo freddo.",
        "Il freddo della sua reazione mi ha sorpreso."
      ],
      "nota": "Può riferirsi a relazioni interpersonali o a contesti sociali."
    },
    {
      "pos": "avverbio",
      "definition": "in modo improvviso e senza preavviso, spesso con riferimento a un'azione violenta o inaspettata",
      "examples": [
        "Mi ha colpito freddo, senza darmi il tempo di reagire.",
        "Ha lasciato il lavoro freddo, senza preavviso."
      ],
      "nota": "Usato principalmente in espressioni colloquiali o gergali."
    }
  ]
