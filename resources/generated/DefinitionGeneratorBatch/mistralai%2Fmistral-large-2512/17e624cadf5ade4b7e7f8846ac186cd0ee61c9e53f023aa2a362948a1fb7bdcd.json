  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare: avere)",
      "definition": "Compiere un'attività lavorativa o professionale, spesso con riferimento a un ambito specifico come la medicina o l'economia.",
      "examples": [
        "Il chirurgo ha operato per sei ore senza sosta.",
        "L'azienda opera nel settore delle energie rinnovabili da oltre vent'anni."
      ],
      "nota": "In ambito medico, si usa spesso in riferimento a interventi chirurgici. In ambito economico, indica l'attività di un'impresa o di un'organizzazione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un intervento chirurgico su qualcuno o qualcosa.",
      "examples": [
        "Il medico ha operato il paziente di appendicite.",
        "Hanno operato il cane per rimuovere un tumore."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare: avere)",
      "definition": "Produrre un effetto o un risultato, agire in modo da influenzare una situazione.",
      "examples": [
        "La nuova legge opera in favore delle famiglie a basso reddito.",
        "Il farmaco ha iniziato a operare dopo mezz'ora."
      ],
      "nota": "Spesso usato in contesti figurati per indicare un'influenza o un'azione indiretta."
    },
    {
      "pos": "verbo riflessivo (operarsi)",
      "definition": "Verificarsi, accadere, con riferimento a cambiamenti o trasformazioni.",
      "examples": [
        "Negli ultimi anni si è operato un cambiamento significativo nei costumi sociali.",
        "Nel settore tecnologico si operano continue innovazioni."
      ],
      "nota": "Uso prevalentemente formale o scritto, spesso in contesti che descrivono processi o evoluzioni."
    }
  ]
