  },
  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere o avere)",
      "definition": "proseguire in un'azione o in uno stato senza interruzione o dopo una pausa",
      "examples": [
        "Dopo la pausa caffè, abbiamo continuato a lavorare fino a tardi.",
        "La pioggia è continuata per tutta la notte senza sosta."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "portare avanti un'attività, un discorso o un percorso già iniziato",
      "examples": [
        "Nonostante le difficoltà, ha continuato il suo progetto di ricerca.",
        "Dopo l'interruzione, il professore ha continuato la lezione."
      ],
      "nota": "Può reggere un complemento oggetto diretto o una proposizione implicita (es. 'continuare a fare qualcosa')."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "estendersi nello spazio o nel tempo senza soluzione di continuità",
      "examples": [
        "La strada continua per altri dieci chilometri prima di arrivare al paese.",
        "La tradizione continua ancora oggi in molte famiglie."
      ],
      "nota": "Spesso usato per descrivere fenomeni fisici, geografici o culturali."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "insistere in un comportamento o in un atteggiamento, spesso con connotazione negativa",
      "examples": [
        "Se continui così, finirai per rovinare tutto.",
        "Ha continuato a lamentarsi per tutta la serata."
      ],
      "nota": "Può implicare una valutazione negativa dell'azione prolungata."
    }
  ]
}