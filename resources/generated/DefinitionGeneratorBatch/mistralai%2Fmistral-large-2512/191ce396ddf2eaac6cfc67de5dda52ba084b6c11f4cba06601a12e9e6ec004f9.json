  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Parte di un organismo vivente che svolge una funzione specifica e vitale.",
      "examples": [
        "Il cuore è un organo fondamentale per la circolazione del sangue.",
        "Durante l'esame, il medico ha controllato lo stato degli organi interni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Struttura o apparato di un ente, istituzione o organizzazione che svolge funzioni specifiche.",
      "examples": [
        "Il consiglio di amministrazione è l'organo decisionale dell'azienda.",
        "La Corte costituzionale è un organo di garanzia dello Stato."
      ],
      "nota": "Spesso usato in contesti giuridici, amministrativi o politici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento musicale a canne azionato da una tastiera, tipicamente usato nelle chiese.",
      "examples": [
        "Il musicista ha suonato un pezzo di Bach all'organo della cattedrale.",
        "Durante la cerimonia, l'organo ha accompagnato il coro."
      ],
      "nota": "Può riferirsi anche a strumenti simili, come l'organo Hammond."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Pubblicazione periodica ufficiale di un ente o associazione, spesso con funzione informativa o divulgativa.",
      "examples": [
        "L'organo ufficiale del partito ha pubblicato un comunicato stampa.",
        "Il bollettino è l'organo di informazione dell'associazione."
      ],
      "nota": "Uso meno comune nel linguaggio quotidiano, più frequente in contesti formali o giornalistici."
    }
  ]
