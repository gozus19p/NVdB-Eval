  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuna delle piccole strutture dure e calcificate situate nella bocca, utilizzate per masticare il cibo e, negli esseri umani, anche per articolare alcuni suoni.",
      "examples": [
        "Mi fa male un dente del giudizio, devo andare dal dentista.",
        "Per mantenere i denti sani, è importante lavareli dopo ogni pasto."
      ],
      "nota": "Nei mammiferi, i denti sono differenziati in incisivi, canini, premolari e molari, ognuno con funzioni specifiche nella masticazione."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte sporgente e appuntita di un oggetto, simile per forma a un dente umano.",
      "examples": [
        "Il pettine ha alcuni denti rotti, devo comprarne uno nuovo.",
        "La sega ha i denti molto affilati, bisogna maneggiarla con cura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione di dolore acuto e localizzato, spesso associata a problemi dentali o a stimoli freddi.",
      "examples": [
        "Ho un dente che mi dà fastidio quando bevo qualcosa di freddo.",
        "Dopo la cura canalare, il dente non mi fa più male."
      ],
      "nota": "In questo senso, il termine è spesso usato al singolare e può essere accompagnato da aggettivi come 'fisso' o 'pulsante' per descrivere la natura del dolore."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuna delle parti sporgenti e regolari di un ingranaggio o di una ruota dentata.",
      "examples": [
        "L'orologio non funziona perché manca un dente alla ruota dentata.",
        "Il meccanismo si è inceppato perché un dente dell'ingranaggio si è spezzato."
      ],
      "nota": "In meccanica, i denti degli ingranaggi sono progettati per incastrarsi perfettamente tra loro e trasmettere il movimento."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio figurato, elemento che sporge o che interrompe una superficie regolare.",
      "examples": [
        "Le montagne si stagliavano all'orizzonte con i loro denti aguzzi.",
        "La costa frastagliata presentava denti rocciosi che si protendevano nel mare."
      ],
      "nota": "In questo senso, il termine è spesso usato in descrizioni paesaggistiche o poetiche."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio culinario, grado di cottura della pasta che la rende soda al morso.",
      "examples": [
        "Mi piace la pasta al dente, non troppo cotta.",
        "Per ottenere un risotto al dente, bisogna controllare bene i tempi di cottura."
      ],
      "nota": "L'espressione 'al dente' è comunemente usata per indicare una cottura che lascia il cibo leggermente resistente alla masticazione."
    }
  ]
