  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Unire in matrimonio due persone secondo le norme civili o religiose.",
      "examples": [
        "Hanno deciso di sposarsi in chiesa il prossimo autunno.",
        "Il sindaco li ha sposati con una cerimonia civile semplice e veloce."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Assumere come proprio un principio, un'idea o una causa, aderendovi con convinzione.",
      "examples": [
        "Dopo anni di dubbi, ha finalmente sposato la causa ambientalista.",
        "Il nuovo direttore ha sposato l'idea di una maggiore flessibilità oraria per i dipendenti."
      ],
      "nota": "Uso figurato, spesso con soggetti umani e oggetti astratti."
    },
    {
      "pos": "verbo riflessivo (sposarsi)",
      "definition": "Celebrare il proprio matrimonio con qualcuno.",
      "examples": [
        "Si sono sposati dopo soli sei mesi di fidanzamento.",
        "Vorrebbero sposarsi all'estero, magari su una spiaggia tropicale."
      ],
      "nota": "Implica reciprocità tra i soggetti coinvolti."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Celebrare un matrimonio, riferito a una delle due persone coinvolte.",
      "examples": [
        "Si è sposata con un collega di lavoro.",
        "Dopo tanti anni da single, ha deciso di sposare."
      ],
      "nota": "Uso meno comune rispetto alla forma riflessiva, spesso con specificazione del partner tramite preposizione 'con'."
    }
  ]
