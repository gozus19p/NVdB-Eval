  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Rappresentazione pubblica di un'opera teatrale, musicale, cinematografica o di altro genere, destinata a un pubblico.",
      "examples": [
        "Abbiamo prenotato i biglietti per lo spettacolo di stasera al teatro comunale.",
        "Il festival offre una varietà di spettacoli, dalle commedie ai concerti di musica classica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Evento o situazione che attira l'attenzione per la sua eccezionalità, bellezza o stranezza.",
      "examples": [
        "Lo spettacolo delle luci al tramonto sul mare era mozzafiato.",
        "La finale di calcio è stata uno spettacolo di emozioni e colpi di scena."
      ],
      "nota": "Può avere una connotazione positiva o negativa a seconda del contesto."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Comportamento o situazione che suscita imbarazzo, disapprovazione o derisione per la sua mancanza di decoro o dignità.",
      "examples": [
        "Ha fatto uno spettacolo davanti a tutti, urlando e piangendo senza motivo.",
        "Non voglio essere parte di questo spettacolo, è umiliante per tutti."
      ],
      "nota": "Spesso usato in contesti informali con una sfumatura negativa."
    }
  ]
