  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che viene immediatamente dopo il primo in una successione ordinata",
      "examples": [
        "È arrivato secondo alla gara di nuoto.",
        "Questo è il secondo capitolo del libro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che ha importanza o valore inferiore rispetto a un altro",
      "examples": [
        "Le sue esigenze sono considerate di secondo piano rispetto al progetto principale.",
        "Ha comprato un prodotto di seconda scelta."
      ],
      "nota": "Spesso usato in espressioni come 'di secondo piano' o 'seconda scelta'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "unità di misura del tempo equivalente a sessanta secondi o a un sessantesimo di minuto",
      "examples": [
        "Aspetta un secondo, arrivo subito!",
        "Il record mondiale è stato battuto per pochi decimi di secondo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "chi sostiene o assiste un altro in un duello, una sfida o una competizione",
      "examples": [
        "Durante il duello, il suo secondo gli ha passato la spada.",
        "Nel pugilato, il secondo dà consigli tra un round e l'altro."
      ],
      "nota": "Uso meno comune nell'italiano contemporaneo, limitato a contesti storici o sportivi specifici."
    },
    {
      "pos": "preposizione",
      "definition": "in conformità a, in base a",
      "examples": [
        "Secondo le previsioni, domani pioverà.",
        "Secondo me, dovresti riposarti di più."
      ],
      "nota": "Può introdurre un'opinione personale o un riferimento a una fonte esterna."
    },
    {
      "pos": "avverbio",
      "definition": "in secondo luogo, come secondo punto",
      "examples": [
        "Prima di tutto, dobbiamo organizzarci; secondo, dobbiamo trovare i fondi.",
        "Secondo, vorrei sottolineare l'importanza della collaborazione."
      ],
      "nota": "Usato principalmente in elenchi o discorsi strutturati."
    }
