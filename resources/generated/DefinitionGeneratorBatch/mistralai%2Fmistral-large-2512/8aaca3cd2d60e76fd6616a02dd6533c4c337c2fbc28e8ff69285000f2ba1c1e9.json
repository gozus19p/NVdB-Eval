  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "muoversi o essere trasportato verso il luogo in cui si trova o si immagina chi parla o chi ascolta",
      "examples": [
        "Sono venuto a piedi fino a qui.",
        "Quando vieni a trovarmi?"
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "raggiungere un luogo per partecipare a un evento o svolgere un'attività",
      "examples": [
        "Vengo alla festa domani sera.",
        "Non verrò alla riunione perché sono malato."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "avere origine o provenire da un luogo, una situazione o una causa",
      "examples": [
        "Questo vino viene dalla Toscana.",
        "Da dove viene questo rumore?"
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "manifestarsi o presentarsi in un determinato modo o momento",
      "examples": [
        "Mi è venuta un'idea geniale!",
        "Gli è venuta la febbre dopo la pioggia."
      ],
      "nota": "Spesso usato per indicare l'insorgere improvviso di stati fisici o mentali."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "risultare in un certo modo dopo un processo o un'azione",
      "examples": [
        "La torta è venuta bene.",
        "Il disegno non mi è venuto come volevo."
      ],
      "nota": "Usato spesso per esprimere il risultato di un'attività manuale o creativa."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "essere disponibile o offerto a un certo prezzo",
      "examples": [
        "Questo vestito viene a cento euro.",
        "Quanto viene l'abbonamento mensile?"
      ],
      "nota": "Usato soprattutto in contesti commerciali per indicare il costo."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "essere pronunciato o espresso in un determinato modo",
      "examples": [
        "Come ti viene in mente una cosa del genere?",
        "Non mi viene la parola giusta."
      ],
      "nota": "Spesso usato in frasi interrogative o negative per esprimere difficoltà o sorpresa."
    },
    {
      "pos": "verbo intransitivo pronominale (venirsene)",
      "definition": "andarsene o allontanarsi con una certa enfasi o decisione",
      "examples": [
        "Dopo la discussione, se n'è venuto via senza salutare.",
        "Me ne vengo subito, aspettami fuori."
      ],
      "nota": "Forma pronominale enfatica, spesso usata per sottolineare un'azione decisa o improvvisa."
    },
    {
      "pos": "verbo servile (venire a + infinito)",
      "definition": "indicare un'azione che si verifica in modo graduale o come conseguenza",
      "examples": [
        "Sono venuto a sapere che ti sei trasferito.",
        "Verrò a trovarti appena posso."
      ],
      "nota": "Spesso usato con verbi di percezione o conoscenza (es. sapere, vedere)."
    }
  ]
