  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Azione o effetto del prendere o dell'afferrare qualcosa con le mani o con uno strumento.",
      "examples": [
        "La presa della tazza era scivolosa a causa dell'acqua.",
        "Con una presa salda, riuscì a sollevare il sacco pesante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Punto o dispositivo in cui si può collegare un apparecchio elettrico alla rete di alimentazione.",
      "examples": [
        "Ho inserito la spina nella presa per accendere la lampada.",
        "In questa stanza manca una presa per il computer."
      ],
      "nota": "Spesso usato in contesti domestici o tecnici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Quantità di una sostanza che si assume in una volta, specialmente in riferimento a farmaci o droghe.",
      "examples": [
        "Il medico ha prescritto una presa di antibiotico ogni otto ore.",
        "Una presa eccessiva di caffeina può causare insonnia."
      ],
      "nota": "Può riferirsi anche a dosi di altre sostanze, come integratori."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Azione di conquistare o occupare un luogo, spesso in contesti militari o sportivi.",
      "examples": [
        "La presa della città avvenne dopo un lungo assedio.",
        "Il wrestler eseguì una presa perfetta per vincere il match."
      ],
      "nota": "In ambito sportivo, si riferisce anche a mosse specifiche (es. lotta, arrampicata)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Capacità di un materiale o di una superficie di aderire o fare attrito.",
      "examples": [
        "Queste gomme hanno una buona presa sull'asfalto bagnato.",
        "La presa del cemento fresco è ottima per le costruzioni."
      ],
      "nota": "Usato anche in senso figurato per indicare efficacia o influenza (es. 'avere presa su qualcuno')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio cinematografico o teatrale, ripresa di una scena o di un'inquadratura.",
      "examples": [
        "Il regista ha deciso di rifare la presa perché l'attore ha sbagliato la battuta.",
        "Questa scena è stata girata in una sola presa."
      ],
      "nota": "In ambito tecnico, può riferirsi anche a registrazioni audio o video."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel pugilato, modo di colpire l'avversario con un pugno.",
      "examples": [
        "Il campione ha vinto con una presa potente al mento.",
        "Ha schivato la presa dell'avversario con un movimento rapido."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso figurato, capacità di influenzare o convincere qualcuno.",
      "examples": [
        "Le sue parole hanno avuto una forte presa sul pubblico.",
        "Questo slogan ha molta presa sui giovani."
      ],
      "nota": "Deriva dal senso di 'aderenza' o 'efficacia' (vedi senso 5)."
    }
  ]
