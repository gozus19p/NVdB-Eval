  "senses": [
    {
      "pos": "aggettivo",
      "definition": "di colore simile a quello del limone o dell'oro, tra il verde e l'arancione nello spettro visibile",
      "examples": [
        "Ha comprato una maglietta gialla per la festa.",
        "Il semaforo è diventato giallo, quindi ho frenato."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "relativo a un genere narrativo che tratta di crimini, indagini e misteri, spesso con elementi di suspense",
      "examples": [
        "Mi piace leggere romanzi gialli prima di dormire.",
        "Hanno trasmesso un film giallo in televisione ieri sera."
      ],
      "nota": "Deriva dal colore delle copertine della collana *I Libri Gialli* della casa editrice Mondadori, che pubblicava questo genere di racconti."
    },
    {
      "pos": "aggettivo",
      "definition": "che ha un aspetto malato o pallido, spesso per stanchezza o malessere",
      "examples": [
        "Dopo la nottata in bianco, aveva la faccia gialla.",
        "Il bambino sembrava un po' giallo, così lo abbiamo portato dal medico."
      ],
      "nota": "Può indicare anche ittero, una condizione medica che colora la pelle di una tonalità giallastra."
    },
    {
      "pos": "sostantivo m.",
      "definition": "il colore simile a quello del limone o dell'oro",
      "examples": [
        "Il giallo è il mio colore preferito per le pareti della cucina.",
        "Nel disegno ha usato una tonalità di giallo molto vivace."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "genere narrativo che tratta di crimini, indagini e misteri, spesso con elementi di suspense",
      "examples": [
        "Ho appena finito un giallo ambientato a Venezia.",
        "I gialli di Agatha Christie sono sempre molto avvincenti."
      ],
      "nota": "Può riferirsi sia a romanzi che a film o serie televisive di questo genere."
    },
    {
      "pos": "sostantivo m.",
      "definition": "segnale luminoso di un semaforo che indica cautela, tra il verde e il rosso",
      "examples": [
        "Quando scatta il giallo, bisogna rallentare.",
        "Ha bruciato il giallo ed è stato multato."
      ],
      "nota": "In contesti stradali, indica la fase di transizione tra il via libera e lo stop."
    },
    {
      "pos": "sostantivo m.",
      "definition": "uovo di gallina, con riferimento specifico al tuorlo",
      "examples": [
        "Per questa ricetta serve solo il giallo dell'uovo.",
        "Ha separato il bianco dal giallo con cura."
      ],
      "nota": "In cucina, si usa spesso per distinguere il tuorlo dall'albume."
    }
  ]
