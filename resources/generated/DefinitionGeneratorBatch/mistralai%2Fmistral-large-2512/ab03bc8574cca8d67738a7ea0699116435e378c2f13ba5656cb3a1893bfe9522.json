  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova nella posizione più lontana rispetto a un punto di riferimento centrale o iniziale.",
      "examples": [
        "Il villaggio si trova all'estremo nord del paese.",
        "Ha tagliato i capelli fino all'estremo limite della nuca."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che rappresenta il grado massimo di una qualità, spesso con connotazione negativa o eccessiva.",
      "examples": [
        "Ha preso una decisione estrema per risolvere il problema.",
        "Le condizioni di vita in quella zona sono estreme."
      ],
      "nota": "Può implicare un giudizio di eccesso o pericolosità, a seconda del contesto."
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda le posizioni o le idee più radicali in un ambito politico, sociale o culturale.",
      "examples": [
        "Il gruppo sostiene idee estreme che non trovano consenso.",
        "Durante la manifestazione sono emersi slogan estremi."
      ],
      "nota": "Spesso usato in contesti politici o ideologici per indicare posizioni non moderate."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte più lontana o terminale di qualcosa.",
      "examples": [
        "L'estremo del tavolo era scheggiato.",
        "Si è aggrappato all'estremo della corda per non cadere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Misura o azione portata al limite massimo, spesso come ultima risorsa.",
      "examples": [
        "Hanno dovuto ricorrere agli estremi per salvare l'azienda.",
        "Non vorrei arrivare a questi estremi, ma non ho scelta."
      ],
      "nota": "Spesso usato in espressioni come *arrivare agli estremi* o *spingersi agli estremi*."
    }
  ]
}