  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "collocare un oggetto in un luogo o in una posizione specifica",
      "examples": [
        "Ho messo le chiavi sul tavolo prima di uscire.",
        "Metti il libro nello scaffale in alto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "indossare un capo di abbigliamento o un accessorio",
      "examples": [
        "Metto sempre la sciarpa quando esco d'inverno.",
        "Ha messo gli occhiali da sole perché c'era troppo sole."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "far assumere una condizione o uno stato a qualcuno o qualcosa",
      "examples": [
        "La notizia lo ha messo in agitazione.",
        "Mettere in ordine la stanza richiede tempo."
      ],
      "nota": "Spesso seguito da un sostantivo o da una locuzione preposizionale (es. 'mettere in dubbio', 'mettere in pratica')."
    },
    {
      "pos": "verbo transitivo",
      "definition": "aggiungere un ingrediente o un elemento a qualcosa",
      "examples": [
        "Metti un po' di sale nell'acqua della pasta.",
        "Ho messo troppo zucchero nel caffè."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "far funzionare o attivare un dispositivo o un meccanismo",
      "examples": [
        "Metti la lavatrice, per favore.",
        "Ha messo la radio per ascoltare le notizie."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "causare o provocare una reazione o un effetto",
      "examples": [
        "Quella battuta ha messo tutti a disagio.",
        "Mettere paura a qualcuno non è mai una buona idea."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (mettersi)",
      "definition": "iniziare a fare qualcosa o assumere una posizione o un atteggiamento",
      "examples": [
        "Si è messo a studiare per l'esame.",
        "Mettiti seduto, così parliamo meglio."
      ],
      "nota": "Spesso seguito da 'a' + infinito (es. 'mettersi a piangere')."
    },
    {
      "pos": "verbo riflessivo (mettersi)",
      "definition": "indossare un capo di abbigliamento su di sé",
      "examples": [
        "Si è messo il cappotto perché faceva freddo.",
        "Mettiti la giacca, fuori piove."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (mettersi)",
      "definition": "iniziare a verificarsi o manifestarsi (detto di condizioni atmosferiche o situazioni)",
      "examples": [
        "Si è messo a piovere all'improvviso.",
        "Si è messo male, dobbiamo intervenire."
      ],
      "nota": "Usato spesso con riferimento a fenomeni atmosferici o situazioni negative."
    },
    {
      "pos": "verbo transitivo",
      "definition": "supporre o ipotizzare qualcosa",
      "examples": [
        "Mettiamo che tu abbia ragione, cosa cambierebbe?",
        "Mettiamo il caso che non venga, come facciamo?"
      ],
      "nota": "Usato in frasi ipotetiche o per introdurre un'ipotesi."
    },
    {
      "pos": "verbo transitivo",
      "definition": "investire denaro o risorse in un'attività o un progetto",
      "examples": [
