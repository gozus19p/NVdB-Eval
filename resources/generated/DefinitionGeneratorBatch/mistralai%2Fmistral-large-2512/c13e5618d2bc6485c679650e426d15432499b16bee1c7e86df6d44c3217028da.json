  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Essere umano considerato singolarmente, in quanto distinto dagli altri per caratteristiche personali o sociali.",
      "examples": [
        "Ogni individuo ha diritto alla libertà di espressione.",
        "Gli individui più vulnerabili devono essere protetti."
      ],
      "nota": "Può avere una connotazione neutra o leggermente negativa a seconda del contesto, specialmente quando usato in opposizione a 'collettività' o 'gruppo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Esemplare singolo di una specie animale o vegetale, distinto dagli altri della stessa specie.",
      "examples": [
        "Hanno avvistato un individuo di lupo nel parco nazionale.",
        "Questo individuo di quercia è particolarmente antico."
      ],
      "nota": "Usato soprattutto in contesti scientifici o naturalistici."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è unico e distinto da ogni altro, non confondibile con altri.",
      "examples": [
        "Ha un modo di vestire molto individuo.",
        "La sua calligrafia è così individuo che la riconosci subito."
      ],
      "nota": "Uso raro e prevalentemente letterario o formale. Più comune nella forma 'individuale'."
    }
  ]
