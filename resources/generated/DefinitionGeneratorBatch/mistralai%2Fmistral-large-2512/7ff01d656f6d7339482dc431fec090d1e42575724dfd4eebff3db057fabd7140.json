  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Cedere un bene o un servizio a qualcuno in cambio di denaro.",
      "examples": [
        "Ho venduto la mia vecchia macchina per comprare una moto.",
        "Quel negozio vende solo prodotti biologici."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Promuovere o pubblicizzare qualcosa con insistenza, spesso in modo eccessivo o inopportuno.",
      "examples": [
        "Non mi piace come quel politico vende le sue idee durante i dibattiti.",
        "Il presentatore ha venduto benissimo lo spettacolo, ma poi è stato deludente."
      ],
      "nota": "Uso figurato, spesso con connotazione negativa o ironica."
    },
    {
      "pos": "verbo riflessivo (vendersi)",
      "definition": "Compromettere i propri principi o la propria dignità per ottenere un vantaggio personale.",
      "examples": [
        "Si è venduto per un posto di lavoro, tradendo i suoi amici.",
        "Non pensavo che si sarebbe venduto così facilmente per dei soldi."
      ],
      "nota": "Uso figurato con forte connotazione negativa."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Essere acquistato o richiesto dal pubblico, riferito a prodotti o servizi.",
      "examples": [
        "Quel libro vende molto bene nelle librerie online.",
        "I biglietti per il concerto sono venduti in poche ore."
      ],
      "nota": "Spesso usato in forma impersonale o con soggetto inanimato."
    }
  ]
