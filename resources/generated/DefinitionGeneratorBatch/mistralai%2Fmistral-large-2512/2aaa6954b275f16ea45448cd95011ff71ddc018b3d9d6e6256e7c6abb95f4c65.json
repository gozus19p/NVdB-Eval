      "examples": [
        "Ha i capelli biondi.",
        "Questo problema ha una soluzione semplice."
      ],
      "nota": "Spesso usato con nomi astratti o parti del corpo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "sentire o provare un'emozione, una sensazione o un bisogno",
      "examples": [
