  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che è considerato perfetto nella virtù religiosa e degno di venerazione per la Chiesa cattolica.",
      "examples": [
        "San Francesco è un santo molto amato in Italia.",
        "La chiesa celebra la festa dei santi Pietro e Paolo il 29 giugno."
      ],
      "nota": "Si usa spesso come prefisso nei nomi propri di persone canonizzate (es. Sant'Antonio)."
    },
    {
      "pos": "aggettivo",
      "definition": "Che mostra una pazienza o una bontà eccezionali, spesso in modo ironico o esagerato.",
      "examples": [
        "Mia nonna è una santa a sopportare tutti i nostri capricci.",
        "Sei un santo a lavorare con questo capo così esigente."
      ],
      "nota": "Uso figurato e colloquiale, spesso con valore iperbolico."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è dedicato a una figura religiosa venerata dalla Chiesa.",
      "examples": [
        "Abbiamo visitato la basilica di Santo Stefano a Budapest.",
        "Il giorno di Santo Stefano è festivo in Italia."
      ],
      "nota": "Si riferisce a luoghi, giorni o festività legati a un santo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona canonizzata dalla Chiesa cattolica per la sua vita esemplare e le sue virtù.",
      "examples": [
        "Santa Teresa d'Avila è una delle sante più conosciute.",
        "Molti fedeli pregano i santi per ottenere grazie."
      ],
      "nota": "Può essere usato anche al femminile (santa)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di eccezionale bontà o pazienza, spesso in senso ironico.",
      "examples": [
        "Con tutti i problemi che ha, è un santo a non perdere la calma.",
        "Non so come faccia, sembra un santo!"
      ],
      "nota": "Uso figurato e colloquiale, spesso con valore iperbolico."
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione di stupore, irritazione o incredulità.",
      "examples": [
        "Santo cielo, che disastro!",
        "Santo Dio, non ci posso credere!"
      ],
      "nota": "Uso informale e spesso enfatico, talvolta considerato blasfemo in contesti religiosi."
    }
  ]
