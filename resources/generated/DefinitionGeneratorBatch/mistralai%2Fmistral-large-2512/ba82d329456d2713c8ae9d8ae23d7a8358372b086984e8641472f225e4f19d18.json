  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Mano chiusa con le dita ripiegate sul palmo, usata per colpire o come gesto simbolico.",
      "examples": [
        "Gli ha dato un pugno in faccia durante la lite.",
        "Stringeva i pugni dalla rabbia mentre ascoltava le accuse."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Quantità di qualcosa che può essere contenuta in una mano chiusa.",
      "examples": [
        "Aggiungi un pugno di sale all'acqua della pasta.",
        "Ha raccolto un pugno di more nel bosco."
      ],
      "nota": "Spesso usato in contesti informali o culinari per indicare una piccola quantità non misurata."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Gruppo ristretto di persone unite da un legame o da un obiettivo comune.",
      "examples": [
        "Un pugno di ribelli ha occupato il municipio.",
        "Solo un pugno di volontari ha risposto all'appello."
      ],
      "nota": "Uso figurato, spesso con connotazione di determinazione o resistenza."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Colpo inferto con la mano chiusa.",
      "examples": [
        "Ha ricevuto un pugno nello stomaco e si è piegato in due.",
        "Il pugile ha sferrato un pugno potente al suo avversario."
      ],
      "nota": "In questo senso, può essere usato anche in contesti sportivi come la boxe."
    }
  ]
