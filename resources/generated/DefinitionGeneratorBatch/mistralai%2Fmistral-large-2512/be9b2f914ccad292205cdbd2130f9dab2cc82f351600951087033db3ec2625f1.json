  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di tempo che corrisponde a circa 365 giorni, suddiviso in dodici mesi, usato come unità di misura del tempo nel calendario gregoriano.",
      "examples": [
        "Quest'anno ho deciso di imparare una nuova lingua.",
        "L'anno scorso abbiamo trascorso le vacanze in montagna."
      ],
      "nota": "Può essere usato in combinazione con numerali o aggettivi per indicare età (es. 'un bambino di cinque anni') o periodi specifici (es. 'l'anno 2020')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di dodici mesi consecutivi, non necessariamente coincidente con l'anno solare, usato per riferirsi a cicli amministrativi, scolastici o fiscali.",
      "examples": [
        "L'anno accademico inizia a ottobre e termina a giugno.",
        "Il bilancio dell'azienda viene chiuso ogni anno fiscale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di tempo caratterizzato da eventi o condizioni particolari, spesso usato in contesti storici, sociali o personali.",
      "examples": [
        "Il 2020 è stato un anno difficile a causa della pandemia.",
        "Gli anni '60 sono ricordati per la rivoluzione culturale."
      ],
      "nota": "In questo senso, può essere usato al plurale per indicare un'epoca o una fase della vita (es. 'gli anni della giovinezza')."
    }
  ]
