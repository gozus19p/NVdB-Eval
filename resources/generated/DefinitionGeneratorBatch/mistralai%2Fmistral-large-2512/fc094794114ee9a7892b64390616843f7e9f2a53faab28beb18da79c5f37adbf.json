  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "parte del corpo umano o animale che unisce la testa al tronco",
      "examples": [
        "Si è messo una sciarpa intorno al collo per il freddo.",
        "Il cane ha un collare rosso intorno al collo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "parte ristretta di un oggetto, generalmente allungato, che ne collega due sezioni più ampie",
      "examples": [
        "La bottiglia ha un collo stretto che rende difficile versare il liquido.",
        "Il collo della chitarra è danneggiato e va riparato."
      ],
      "nota": "Può riferirsi anche a parti di indumenti (es. collo della camicia)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "tratto di terra stretto che collega due aree più ampie, come una penisola o un istmo",
      "examples": [
        "Il collo di bottiglia della penisola è stato fortificato nel Medioevo.",
        "La strada passa attraverso un collo di terra tra due laghi."
      ],
      "nota": "Uso prevalentemente geografico o figurato (es. collo di bottiglia in logistica)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "quantità di merce trasportata in una sola volta, specialmente in ambito commerciale o logistico",
      "examples": [
        "Il corriere ha consegnato tre colli al magazzino.",
        "Ogni collo deve essere etichettato con il codice di spedizione."
      ],
      "nota": "Termine tecnico diffuso in ambito trasporti e spedizioni."
    }
  ]
