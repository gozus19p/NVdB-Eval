  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Partecipare a uno scontro armato o a una battaglia.",
      "examples": [
        "I soldati hanno combattuto valorosamente per difendere la città.",
        "Durante la Seconda Guerra Mondiale, molti partigiani hanno combattuto contro il nazifascismo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Impegnarsi attivamente per contrastare un fenomeno negativo o un problema.",
      "examples": [
        "Il governo sta combattendo contro l'evasione fiscale con nuove leggi.",
        "Molte associazioni combattono per i diritti delle minoranze."
      ],
      "nota": "Spesso usato con preposizioni come 'contro' o 'per' per specificare l'obiettivo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Affrontare un avversario in uno scontro fisico o sportivo.",
      "examples": [
        "Il campione ha combattuto il suo rivale per il titolo mondiale.",
        "I due pugili si sono combattuti per dodici round senza sosta."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Sforzarsi di superare una difficoltà o una condizione avversa.",
      "examples": [
        "Ha combattuto a lungo contro la malattia prima di guarire.",
        "Ogni giorno combatto con il traffico per arrivare in orario al lavoro."
      ],
      "nota": "Può implicare uno sforzo prolungato e faticoso."
    },
    {
      "pos": "verbo riflessivo (combattere + si)",
      "definition": "Scontrarsi reciprocamente in una lotta o in un conflitto.",
      "examples": [
        "I due eserciti si sono combattuti per mesi senza vincitori.",
        "I fratelli si sono combattuti per l'eredità del padre."
      ],
      "nota": "Indica un'azione reciproca tra due o più soggetti."
    }
  ]
