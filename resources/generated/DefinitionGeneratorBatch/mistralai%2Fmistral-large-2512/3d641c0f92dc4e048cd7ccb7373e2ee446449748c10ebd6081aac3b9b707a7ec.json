  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Far cambiare posizione o luogo a qualcosa o qualcuno, spostandolo da un punto a un altro.",
      "examples": [
        "Ho dovuto muovere il tavolo per pulire sotto.",
        "Il vento muoveva le foglie secche sul marciapiede."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Cambiare posizione o luogo, spostarsi da un punto a un altro.",
      "examples": [
        "Non riesco a muovere il braccio dopo la caduta.",
        "Il treno si è mosso con dieci minuti di ritardo."
      ],
      "nota": "Può riferirsi a persone, animali o oggetti in grado di spostarsi autonomamente o per azione esterna."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Provocare un'emozione, un sentimento o una reazione in qualcuno.",
      "examples": [
        "Le sue parole mi hanno mosso a compassione.",
        "Quel film mi ha mosso una profonda riflessione."
      ],
      "nota": "Uso figurato, spesso associato a emozioni intense o reazioni interiori."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avviare o promuovere un'azione, un'iniziativa o un processo.",
      "examples": [
        "Il governo ha mosso una nuova riforma per contrastare la disoccupazione.",
        "L'azienda ha mosso i primi passi verso la sostenibilità ambientale."
      ],
      "nota": "Spesso usato in contesti formali o istituzionali."
    },
    {
      "pos": "verbo riflessivo (muoversi)",
      "definition": "Agire con prontezza o intraprendenza, spesso in risposta a una situazione.",
      "examples": [
        "Dobbiamo muoverci subito se vogliamo arrivare in tempo.",
        "Si è mosso con rapidità per risolvere il problema."
      ],
      "nota": "Può implicare un senso di urgenza o efficienza."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Procedere o avanzare in una direzione, spesso in contesti militari o strategici.",
      "examples": [
        "L'esercito ha mosso verso la città nemica all'alba.",
        "Il pedone può muovere solo in avanti di una casella."
      ],
      "nota": "Uso comune in ambiti come gli scacchi o la tattica militare."
    }
  ]
