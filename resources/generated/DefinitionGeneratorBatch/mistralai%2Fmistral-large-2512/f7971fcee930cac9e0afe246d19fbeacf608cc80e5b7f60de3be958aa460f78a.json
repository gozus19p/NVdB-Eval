  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "spostarsi da un luogo a un altro, generalmente per un periodo limitato e con un mezzo di trasporto",
      "examples": [
        "Ho viaggiato in treno per raggiungere Milano.",
        "Durante le vacanze estive, abbiamo viaggiato in tutta Europa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "muoversi o essere trasportato da un luogo a un altro, riferito a oggetti o merci",
      "examples": [
        "Questo pacco ha viaggiato per tre giorni prima di arrivare a destinazione.",
        "Le informazioni viaggiano velocemente grazie a internet."
      ],
      "nota": "Spesso usato in contesti figurati per indicare la rapidità o la modalità di diffusione di notizie, dati o oggetti."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "procedere o muoversi con una certa velocità o modalità, riferito a veicoli o mezzi di trasporto",
      "examples": [
        "Questa macchina viaggia a 200 chilometri all'ora.",
        "Il treno viaggia in orario oggi."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "vivere esperienze intense o variegate, spesso in senso figurato",
      "examples": [
        "Con quel lavoro, la sua mente viaggia tra idee sempre nuove.",
        "Dopo quella notizia, i miei pensieri hanno iniziato a viaggiare senza sosta."
      ],
      "nota": "Uso figurato per indicare un'attività mentale o emotiva particolarmente dinamica."
    }
  ]
