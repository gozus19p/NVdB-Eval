  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Commettere un errore, agire in modo non corretto o non conforme alle aspettative.",
      "examples": [
        "Ho sbagliato a fidarmi di lui, mi ha deluso.",
        "Se non studi, sbagli a pensare di passare l'esame."
