    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un'azione in modo errato o non conforme a ciò che è richiesto.",
      "examples": [
        "Ha sbagliato la ricetta e il dolce è venuto male.",
        "Sbagli sempre la pronuncia di questa parola."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Allontanarsi dalla direzione o dal percorso corretto.",
      "examples": [
        "Abbiamo sbagliato strada e ci siamo persi.",
        "Se giri a destra, sbagli: devi andare dritto."
      ],
      "nota": "Spesso usato in contesti di orientamento spaziale."
    },
    {
      "pos": "verbo riflessivo (sbagliarsi)",
      "definition": "Avere un'opinione o una percezione errata su qualcosa o qualcuno.",
      "examples": [
        "Mi sono sbagliato sul suo conto, in realtà è una persona gentile.",
        "Se pensi che sia facile, ti sbagli di grosso."
      ],
      "nota": "Può implicare un giudizio errato o una valutazione non accurata."
