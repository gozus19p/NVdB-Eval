  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuna delle righe di cui è composto un testo poetico, caratterizzata da un determinato numero di sillabe e da un particolare ritmo.",
      "examples": [
        "Ha scritto una poesia di venti versi.",
        "Il primo verso del sonetto è il più famoso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Direzione o orientamento nello spazio, indicante il punto o la zona in cui ci si muove o si guarda.",
      "examples": [
        "Il vento soffia verso est.",
        "Camminava verso la stazione senza guardarsi indietro."
      ],
      "nota": "Può essere usato anche in senso figurato, ad esempio: 'Si sta muovendo verso una soluzione del problema'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Modo o maniera in cui qualcosa viene fatto o si manifesta.",
      "examples": [
        "Non mi piace il verso in cui parla di questa situazione.",
        "Ha trovato un nuovo verso per esprimere la sua creatività."
      ],
      "nota": "Spesso usato in espressioni come 'in un certo verso' o 'in qualche verso'."
    },
    {
      "pos": "preposizione",
      "definition": "Indica la direzione o l'approssimazione temporale o spaziale verso un punto o un momento.",
      "examples": [
        "Partiamo verso le otto.",
        "Si è diretto verso il parco."
      ],
      "nota": "Può essere usata anche in senso figurato, ad esempio: 'Sta andando verso la pensione'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Suono caratteristico emesso da un animale, in particolare dagli uccelli.",
      "examples": [
        "Il verso del gufo è inconfondibile.",
        "Ogni uccello ha il suo verso particolare."
      ],
      "nota": null
    }
