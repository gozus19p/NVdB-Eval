  "senses": [
    {
      "pos": "aggettivo",
      "definition": "di colore simile a quello del sangue o dei papaveri, tra i colori fondamentali dello spettro visibile",
      "examples": [
        "Ha comprato una macchina rossa.",
        "Le foglie degli aceri diventano rosse in autunno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "relativo a ideologie o movimenti politici di sinistra, in particolare comunisti o socialisti",
      "examples": [
        "Durante la Guerra Fredda, molti artisti erano di idee rosse.",
        "Il partito rosso ha ottenuto molti voti alle ultime elezioni."
      ],
      "nota": "Spesso usato in contrapposizione a 'nero' (fascista) o 'bianco' (moderato/conservatore)."
    },
    {
      "pos": "aggettivo",
      "definition": "che presenta un arrossamento della pelle, spesso a causa di imbarazzo, rabbia o sforzo fisico",
      "examples": [
        "Dopo la corsa, aveva il viso rosso per lo sforzo.",
        "Si è fatto rosso dalla vergogna quando l'hanno chiamato sul palco."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "relativo al vino rosso, ottenuto dalla fermentazione delle bucce dell'uva nera",
      "examples": [
        "Preferisco il risotto al vino rosso piuttosto che a quello bianco.",
        "Ha ordinato una bottiglia di rosso corposo."
      ],
      "nota": "In contesti enogastronomici, spesso usato come ellissi per 'vino rosso'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "il colore simile a quello del sangue o dei papaveri",
      "examples": [
        "Il rosso è il colore dominante nella bandiera cinese.",
        "Ha scelto il rosso per dipingere la porta d'ingresso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "vino ottenuto dalla fermentazione delle bucce dell'uva nera",
      "examples": [
        "Al ristorante abbiamo ordinato un rosso della Toscana.",
        "Questo formaggio si abbina bene con un rosso strutturato."
      ],
      "nota": "In contesti informali, spesso usato senza articolo ('bere rosso')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "sostenitore o membro di movimenti politici di sinistra, in particolare comunisti o socialisti",
      "examples": [
        "I rossi hanno organizzato una manifestazione in piazza.",
        "Durante gli anni Settanta, i rossi erano molto attivi nelle università."
      ],
      "nota": "Può avere connotazione spregiativa a seconda del contesto."
    },
    {
      "pos": "sostantivo m.",
      "definition": "segnale luminoso che indica l'obbligo di fermarsi nei semafori stradali",
      "examples": [
        "Il semaforo è passato dal verde al rosso in un attimo.",
        "Non puoi attraversare con il rosso, è pericoloso."
      ],
      "nota": "In senso figurato, può indicare un divieto o un pericolo ('essere al rosso')."
    }
  ]
