      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale cardinale",
      "definition": "Indica una quantità pari a sei unità.",
      "examples": [
        "Ci sono sei persone in attesa.",
        "Il film dura sei ore."
      ],
      "nota": "Può essere usato sia in funzione attributiva che predicativa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nella numerazione delle ore, indica le sei del mattino o le sei di sera.",
      "examples": [
        "Ci vediamo alle sei davanti al cinema.",
        "Sono le sei e mezza, è ora di alzarsi."
      ],
      "nota": "Spesso usato in espressioni temporali senza articolo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Voto scolastico corrispondente a un giudizio di sufficienza minima, in una scala da uno a dieci.",
      "examples": [
        "Ho preso un sei in matematica.",
        "Mi accontento di un sei, basta che sia promosso."
      ],
      "nota": "In alcuni contesti può indicare un risultato appena sufficiente o mediocre."
    },
    {
      "pos": "pronome personale di seconda persona singolare",
      "definition": "Forma atona del pronome personale soggetto 'tu', usata in alcune varietà regionali o in registri informali.",
      "examples": [
        "Sei stanco? Ti vedo un po' giù.",
        "Dove sei stato tutto il giorno?"
      ],
      "nota": "In italiano standard, la forma tonica 'tu' è più comune come soggetto. 'Sei' in questa accezione è spesso usato in domande dirette o in contesti colloquiali."
    },
    {
      "pos": "verbo (intransitivo, seconda persona singolare dell'indicativo presente di 'essere')",
      "definition": "Indica l'esistenza, la condizione o la qualità di qualcuno o qualcosa in riferimento alla seconda persona singolare.",
      "examples": [
        "Sei sempre così puntuale!",
        "Non sei tu il responsabile di questo progetto?"
      ],
      "nota": "Può essere usato sia in frasi affermative che interrogative o negative."
