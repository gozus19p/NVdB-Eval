  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "dedicarsi a un'attività ludica o ricreativa, spesso seguendo regole prestabilite, per divertimento o svago",
      "examples": [
        "I bambini giocano in giardino con la palla.",
        "Durante la pausa pranzo, alcuni colleghi giocano a carte in sala mensa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "partecipare a un gioco o a una competizione sportiva, spesso in modo agonistico",
      "examples": [
        "La squadra gioca in trasferta questo weekend.",
        "Non so se giocare a tennis con lui: è molto più bravo di me."
      ],
      "nota": "Può implicare un contesto competitivo o professionale, diversamente dal primo senso."
    },
    {
      "pos": "verbo transitivo",
      "definition": "utilizzare un oggetto o uno strumento in un'attività ludica o sportiva",
      "examples": [
        "Gioca la carta vincente al momento giusto.",
        "Ha giocato il jolly per risolvere la situazione."
      ],
      "nota": "Spesso usato in contesti metaforici o riferito a elementi di giochi (carte, pedine, ecc.)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "scommettere denaro o altri beni in un gioco d'azzardo o in una situazione rischiosa",
      "examples": [
        "Ha giocato tutti i suoi risparmi al casinò e li ha persi.",
        "Non giocarti la reputazione per una sciocchezza del genere."
      ],
      "nota": "Può avere una connotazione negativa, legata al rischio o alla perdita."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "agire con leggerezza o senza la dovuta serietà, spesso sottovalutando le conseguenze",
      "examples": [
        "Non puoi giocare con i sentimenti delle persone.",
        "Stai giocando con il fuoco se continui a provocarlo."
      ],
      "nota": "Uso figurato, spesso con implicazioni negative o di avvertimento."
    },
    {
      "pos": "verbo riflessivo (giocarsi)",
      "definition": "mettere a rischio qualcosa di importante, spesso in modo consapevole",
      "examples": [
        "Si è giocato la carriera per un errore stupido.",
        "Non voglio giocarmi l'amicizia per una discussione futile."
      ],
      "nota": "Implica una scelta rischiosa con possibili conseguenze negative."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "funzionare o muoversi in modo non stabile o impreciso, detto di meccanismi o parti mobili",
      "examples": [
        "La maniglia della porta gioca un po': bisogna stringere le viti.",
        "Il pedale del freno gioca troppo, meglio farlo controllare."
      ],
      "nota": "Uso tecnico o descrittivo, riferito a oggetti meccanici."
    }
  ]
