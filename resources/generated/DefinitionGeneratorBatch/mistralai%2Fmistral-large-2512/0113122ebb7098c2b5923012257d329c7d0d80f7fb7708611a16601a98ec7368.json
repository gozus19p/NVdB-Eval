  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "prendere qualcosa a qualcuno senza il suo consenso, spesso di nascosto o con l'inganno",
      "examples": [
        "Qualcuno mi ha fregato il portafoglio sul tram.",
        "Ha fregato la bicicletta al vicino per andare in centro."
      ],
      "nota": "Può implicare un'azione subdola o non autorizzata, ma non necessariamente violenta. Sinonimo più neutro: 'rubare'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "ingannare qualcuno per ottenere un vantaggio personale",
      "examples": [
        "Mi ha fregato con quella falsa promessa di lavoro.",
        "Non farti fregare dalle apparenze, è una persona inaffidabile."
      ],
      "nota": "Spesso usato in contesti informali per indicare un raggiro o una truffa."
    },
    {
      "pos": "verbo transitivo",
      "definition": "danneggiare o rovinare qualcosa, spesso in modo accidentale",
      "examples": [
        "Ho fregato la macchina contro il muro mentre parcheggiavo.",
        "Se continui a usarlo così, lo freghi in poco tempo."
      ],
      "nota": "Uso comune in contesti informali, spesso riferito a oggetti meccanici o elettronici."
    },
    {
      "pos": "verbo intransitivo pronominale (fregarsene)",
      "definition": "mostrare indifferenza o disinteresse verso qualcosa o qualcuno",
      "examples": [
        "Mi sono stancato di chiedere, ormai me ne frego.",
        "Se ne frega altamente di quello che pensano gli altri."
      ],
      "nota": "Espressione colloquiale e spesso volgare, usata per enfatizzare il disinteresse. La forma base 'fregare' non ha questo significato senza il pronome riflessivo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "strofinare con forza una superficie, spesso per pulirla o levigarla",
      "examples": [
        "Devi fregare bene il pavimento per togliere quelle macchie.",
        "Ha fregato la pentola con la spugna per mezz'ora."
      ],
      "nota": "Uso meno comune rispetto agli altri sensi, ma ancora attestato in contesti domestici o artigianali."
    }
  ]
