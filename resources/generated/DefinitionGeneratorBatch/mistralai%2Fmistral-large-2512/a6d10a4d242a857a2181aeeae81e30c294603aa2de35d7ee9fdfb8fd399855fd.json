  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Valore ottenuto sommando più quantità e dividendo il risultato per il numero delle quantità stesse.",
      "examples": [
        "La media dei voti di questo esame è stata piuttosto alta.",
        "Per calcolare la media delle temperature, somma tutti i valori e dividi per sette."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. (solo sing.)",
      "definition": "Insieme dei mezzi di comunicazione di massa, come televisione, radio, giornali e internet.",
      "examples": [
        "Il caso ha avuto grande risonanza sui media nazionali.",
        "Oggi i social network sono diventati una parte fondamentale dei media."
      ],
      "nota": "Spesso usato al plurale in inglese ('mass media'), ma in italiano è invariabile e si usa al singolare."
    },
    {
      "pos": "aggettivo (invariabile)",
      "definition": "Che rappresenta un valore intermedio tra due estremi o che si colloca in una posizione centrale.",
      "examples": [
        "Ha scelto una taglia media per la maglietta.",
        "Il film è adatto a un pubblico di età media."
      ],
      "nota": "Può riferirsi a dimensioni, quantità, qualità o altre caratteristiche misurabili."
    }
  ]
