    {
      "pos": "sostantivo m.",
      "definition": "Linea retta che parte dal centro di un cerchio o di una sfera e arriva fino alla circonferenza o alla superficie.",
      "examples": [
        "Il raggio della ruota della bicicletta si è piegato dopo la caduta.",
        "Per calcolare l'area del cerchio, devi conoscere la lunghezza del raggio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Fascio di luce o di radiazioni che si propaga in linea retta da una sorgente.",
      "examples": [
        "Un raggio di sole filtrava attraverso le tende della camera.",
        "Il raggio laser è stato utilizzato per misurare la distanza tra i due edifici."
      ],
      "nota": "Può riferirsi anche a radiazioni non visibili, come i raggi X o i raggi ultravioletti."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Distanza massima entro cui si estende l'influenza o l'azione di qualcosa.",
      "examples": [
        "La protezione della polizia si estendeva per un raggio di cinque chilometri intorno allo stadio.",
        "Il segnale del Wi-Fi ha un raggio limitato, non arriva fino al giardino."
      ],
      "nota": "Uso figurato, spesso legato a concetti di portata o copertura."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuno dei segmenti ossei che formano lo scheletro delle dita della mano o del piede.",
      "examples": [
        "Si è fratturato un raggio della mano cadendo sul ghiaccio.",
        "Il medico ha controllato i raggi del piede per escludere fratture."
      ],
      "nota": "Termine tecnico usato in anatomia, meno comune nell'uso quotidiano."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuna delle aste metalliche che collegano il mozzo alla circonferenza di una ruota, specialmente di biciclette o motocicli.",
      "examples": [
        "Uno dei raggi della mia bici si è spezzato durante la salita.",
        "Ha sostituito tutti i raggi della ruota per renderla più resistente."
      ],
      "nota": null
    }
