  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova in posizione contraria rispetto a un punto di riferimento spaziale, temporale o concettuale.",
      "examples": [
        "La casa si trova sul lato opposto della strada.",
        "Le due squadre hanno giocato in orari opposti della giornata."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che presenta caratteristiche, idee o valori in netto contrasto con altri.",
      "examples": [
        "Hanno opinioni opposte su questo argomento.",
        "I due fratelli hanno personalità completamente opposte."
      ],
      "nota": "Spesso usato per indicare divergenze ideologiche, morali o di comportamento."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che è completamente diverso o in contraddizione rispetto a qualcos'altro.",
      "examples": [
        "Il suo comportamento è l'opposto di quello che ci si aspetterebbe da una persona educata.",
        "In matematica, il concetto di caldo e freddo rappresenta due opposti."
      ],
      "nota": "Può riferirsi a concetti astratti (es. bene e male) o a entità concrete (es. poli di una calamita)."
    }
  ]
