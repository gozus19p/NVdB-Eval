  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Proprietà percettiva degli oggetti determinata dalla luce che riflettono o emettono, percepita attraverso la vista.",
      "examples": [
        "Il colore del cielo al tramonto è uno spettacolo meraviglioso.",
        "Questo vestito è disponibile in diversi colori: rosso, blu e verde."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza utilizzata per tingere superfici, tessuti o altri materiali.",
      "examples": [
        "Ho comprato un barattolo di colore per dipingere la stanza.",
        "Questo tessuto non assorbe bene il colore, è meglio sceglierne un altro."
      ],
      "nota": "Spesso usato al plurale ('colori') per indicare l'insieme delle sostanze coloranti."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Aspetto o tonalità particolare che caratterizza qualcosa in senso figurato, come un'opinione, un racconto o un evento.",
      "examples": [
        "Il suo discorso ha dato un colore politico alla discussione.",
        "Il film aggiunge un colore romantico alla storia vera su cui è basato."
      ],
      "nota": "In questo senso, assume una connotazione metaforica legata a sfumature o caratteristiche distintive."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio giornalistico o politico, elemento di vivacità o interesse in un evento o una situazione.",
      "examples": [
        "La presenza di quel personaggio ha dato colore alla serata.",
        "Il cronista ha descritto l'evento con molto colore, rendendolo più avvincente."
      ],
      "nota": "Spesso usato in espressioni come 'dare colore' o 'pieno di colore'."
    },
    {
      "pos": "sostantivo m. pl. (colori)",
      "definition": "Simboli o insegne che rappresentano un gruppo, una squadra o un'istituzione, spesso associati a bandiere o stemmi.",
      "examples": [
        "Gli atleti hanno sfilato portando i colori della loro nazione.",
        "La squadra scenderà in campo con i colori sociali: bianco e azzurro."
      ],
      "nota": "In questo senso, il termine è spesso usato al plurale e può riferirsi anche a divise sportive o militari."
    }
  ]
