  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di qualità eccellente, superiore alla media o al livello considerato buono.",
      "examples": [
        "Questo ristorante offre un servizio ottimo.",
        "Ha ottenuto un risultato ottimo all'esame di maturità."
      ],
      "nota": "Può riferirsi a oggetti, prestazioni, condizioni o persone. Spesso usato in contesti formali o valutativi."
    },
    {
      "pos": "aggettivo",
      "definition": "Molto adatto o ideale per uno scopo specifico.",
      "examples": [
        "Questa giornata è ottima per una gita al mare.",
        "Il suo temperamento calmo è ottimo per questo tipo di lavoro."
      ],
      "nota": "In questo senso, l'aggettivo valuta l'idoneità rispetto a un contesto o una situazione."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il livello più alto di qualità o prestazione in una scala di valutazione.",
      "examples": [
        "Il professore ha dato un ottimo al suo compito.",
        "Nella pagella, ha preso due ottimi e tre distinti."
      ],
      "nota": "Usato soprattutto in ambito scolastico per indicare il voto massimo (spesso corrispondente a 10/10)."
    }
  ]
