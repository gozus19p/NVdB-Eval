  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Unità di misura del tempo corrispondente a sessanta minuti, equivalente a un ventiquattresimo di giorno solare.",
      "examples": [
        "Il treno partirà tra due ore.",
        "Ho impiegato un'ora per finire il compito."
      ],
      "nota": "Può indicare anche un momento specifico della giornata, spesso accompagnato da un numero o un'indicazione temporale (es. 'alle tre')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Momento attuale o periodo di tempo presente.",
      "examples": [
        "Da un'ora a questa parte non ho più notizie di lui.",
        "Non è più il momento di rimandare, è l'ora di agire."
      ],
      "nota": "Spesso usato in espressioni idiomatiche come 'a quest'ora' (in questo momento) o 'fino a tarda ora' (fino a tardi)."
    },
    {
      "pos": "avverbio",
      "definition": "Indica il momento presente o un tempo molto vicino al presente.",
      "examples": [
        "Ora capisco cosa intendevi.",
        "Non ho più voglia di aspettare, me ne vado ora."
      ],
      "nota": "Può essere usato in contrapposizione a 'prima' o 'dopo' per indicare una successione temporale."
    },
    {
      "pos": "congiunzione (temporale)",
      "definition": "Introduce una proposizione temporale che indica un'azione successiva a un'altra, spesso con valore di immediatezza.",
      "examples": [
        "Appena avrò finito di mangiare, ora ti raggiungo.",
        "Ho sistemato tutto, ora possiamo uscire."
      ],
      "nota": "Equivale a 'adesso che' o 'non appena'. Spesso usato in contesti informali o colloquiali."
    }
  ]
