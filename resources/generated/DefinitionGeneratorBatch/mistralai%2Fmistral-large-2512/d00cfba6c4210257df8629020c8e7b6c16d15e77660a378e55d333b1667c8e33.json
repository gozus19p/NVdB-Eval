  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Atto formale con cui si comunica ufficialmente qualcosa a un'autorità o al pubblico.",
      "examples": [
        "Ha presentato una dichiarazione dei redditi al fisco.",
        "La dichiarazione di guerra fu trasmessa via radio."
      ],
      "nota": "Spesso usato in contesti giuridici, fiscali o diplomatici. Può riferirsi anche a documenti scritti o comunicazioni orali ufficiali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Affermazione esplicita di un'opinione, un'intenzione o un sentimento.",
      "examples": [
        "Durante l'intervista, ha fatto una dichiarazione d'amore in diretta.",
        "La sua dichiarazione di innocenza non ha convinto la giuria."
      ],
      "nota": "Può avere valenza emotiva o persuasiva, a differenza del primo senso che è più neutro e formale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Documento che attesta formalmente un fatto, una qualità o una condizione.",
      "examples": [
        "Per il visto serve una dichiarazione di ospitalità.",
        "La dichiarazione di conformità è obbligatoria per vendere il prodotto."
      ],
      "nota": "Frequente in ambiti amministrativi, burocratici o commerciali. Spesso accompagnato da firme o timbri di validazione."
    }
  ]
