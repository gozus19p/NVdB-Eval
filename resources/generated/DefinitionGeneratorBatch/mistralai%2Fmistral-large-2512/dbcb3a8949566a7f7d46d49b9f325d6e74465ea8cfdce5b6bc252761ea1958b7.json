  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo alla città di Roma o ai suoi abitanti.",
      "examples": [
        "Il traffico romano è caotico soprattutto nelle ore di punta.",
        "La cucina romana è famosa per piatti come la carbonara e l'amatriciana."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo all'antica Roma o al suo impero.",
      "examples": [
        "Il Colosseo è uno dei monumenti più celebri dell'architettura romana.",
        "La letteratura romana ha influenzato profondamente la cultura occidentale."
      ],
      "nota": "Spesso usato in contesti storici, artistici o archeologici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona originaria o residente della città di Roma.",
      "examples": [
        "I romani sono noti per il loro accento marcato.",
        "Un romano doc sa dove trovare la migliore pizza al taglio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Cittadino dell'antica Roma o appartenente al suo impero.",
      "examples": [
        "I romani conquistarono gran parte dell'Europa conosciuta.",
        "Gli storici studiano le abitudini dei romani per comprendere la loro società."
      ],
      "nota": "Usato prevalentemente in contesti storici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Variante del gioco della morra, diffusa soprattutto nel Lazio.",
      "examples": [
        "Dopo cena, giocavano a romano nel cortile del paese.",
        "Il romano è un gioco che richiede riflessi pronti e fortuna."
      ],
      "nota": "Gioco tradizionale, noto anche come 'morra romana'."
    }
  ]
