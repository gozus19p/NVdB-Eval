  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Pianeta del sistema solare abitato dagli esseri umani, terzo in ordine di distanza dal Sole.",
      "examples": [
        "La Terra impiega un anno per compiere un giro completo intorno al Sole.",
        "Gli astronauti hanno fotografato la Terra dallo spazio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Superficie solida del pianeta, in contrapposizione al mare o all'aria.",
      "examples": [
        "Dopo ore di volo, l'aereo finalmente toccò terra.",
        "Il gatto saltò giù dal tavolo e atterrò sulla terra."
      ],
      "nota": "Spesso usato in espressioni come 'toccare terra' o 'perdere terra sotto i piedi'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Materiale friabile di cui è composto il suolo, utilizzato per coltivazioni o come base per costruzioni.",
      "examples": [
        "Il contadino lavorava la terra con l'aratro.",
        "Hanno portato della terra per riempire le buche nel giardino."
      ],
      "nota": "Può indicare anche il suolo coltivabile o il terreno agricolo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Luogo di origine o patria di una persona.",
      "examples": [
        "Dopo anni all'estero, sentiva la mancanza della sua terra.",
        "È tornato nella sua terra natale per le vacanze estive."
      ],
      "nota": "Spesso usato in senso affettivo o identitario."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Superficie non coperta da acqua, in contrapposizione al mare o a un corso d'acqua.",
      "examples": [
        "La barca si avvicinò alla terra e i passeggeri sbarcarono.",
        "Dalla nave si vedeva già la terra in lontananza."
      ],
      "nota": "In contesti nautici, può indicare la costa o la riva."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ambiente naturale non urbanizzato, spesso contrapposto alla città.",
      "examples": [
        "Dopo una settimana in città, aveva bisogno di stare un po' in mezzo alla terra.",
        "La terra offre paesaggi incontaminati e aria pulita."
      ],
      "nota": "Può assumere una connotazione romantica o idealizzata."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Coprire o riempire con materiale solido, come sabbia o terra, per livellare o nascondere qualcosa.",
      "examples": [
        "Hanno terrato il fosso per costruire una strada.",
        "Il giardiniere terrò le radici delle piante con nuova terra."
      ],
      "nota": "Meno comune rispetto a 'interrare' o 'ricoprire', ma attestato in contesti tecnici o regionali."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Tornare o arrivare sulla superficie solida dopo essere stati in volo o in acqua.",
      "examples": [
        "L'aereo è finalmente terrato dopo un volo turbolento.",
        "Il paracadutista è terrato in un campo di grano."
      ],
      "nota": "Usato soprattutto in contesti aeronautici o sportivi."
    }
  ]
