  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "esercitare una forza su qualcosa o qualcuno per spostarlo verso di sé o nella direzione del movimento",
      "examples": [
        "Ho tirato la corda per aprire la tenda.",
        "Il bambino tira il grembiule della mamma per attirare la sua attenzione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "lanciare o scagliare un oggetto con forza",
      "examples": [
        "Ha tirato la palla contro il muro per sfogarsi.",
        "Durante la partita, Marco ha tirato il pallone in porta."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "produrre o emettere qualcosa con forza o in modo continuo",
      "examples": [
        "Il camino tira bene e riscalda tutta la stanza.",
        "La macchina tira fuori un fumo nero quando accelera."
      ],
      "nota": "Spesso usato in contesti legati a ventilazione, emissioni o funzionamento di macchinari."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "muoversi o procedere in una direzione, spesso con riferimento a veicoli o condizioni atmosferiche",
      "examples": [
        "Il treno tira dritto senza fermarsi in questa stazione.",
        "Oggi tira un vento fortissimo, meglio non uscire in barca."
      ],
      "nota": "Può riferirsi anche a correnti d'aria o condizioni meteorologiche."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "essere in una condizione di difficoltà economica o di scarsità",
      "examples": [
        "Da quando ha perso il lavoro, tira avanti con pochi soldi.",
        "In questo periodo tiriamo la cinghia per risparmiare."
      ],
      "nota": "Uso figurato, spesso accompagnato da espressioni come 'tirare avanti' o 'tirare la cinghia'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "avere un effetto stimolante o eccitante, spesso riferito a sostanze",
      "examples": [
        "Questo caffè tira davvero, mi ha svegliato subito.",
        "Dopo quella sigaretta, mi sento più tirato."
      ],
      "nota": "Uso colloquiale, spesso riferito a caffeina, nicotina o altre sostanze stimolanti."
    },
    {
      "pos": "verbo transitivo",
      "definition": "disegnare o tracciare linee o segni su una superficie",
      "examples": [
        "Ha tirato una riga sotto la parola per evidenziarla.",
        "Il geometra ha tirato le linee del progetto sulla carta millimetrata."
      ],
      "nota": "Spesso usato in contesti di disegno tecnico o artistico."
    },
    {
      "pos": "verbo transitivo",
      "definition": "stampare o produrre copie di un testo o immagine",
      "examples": [
        "La tipografia ha tirato mille copie del libro.",
        "Hanno tirato un'edizione limitata di questa litografia."
      ],
      "nota": "Uso specifico nel linguaggio della stampa e dell'editoria."
    },
    {
      "pos": "verbo riflessivo (tirarsi)",
      "definition": "spostarsi o allontanarsi da un luogo o situazione",
      "examples": [
        "Dopo la discussione, si è tirato indietro senza dire una parola.",
        "Mi tiro da parte per lasciar passare la processione."
      ],
      "nota": "Spesso usato in contesti di movimento fisico o metaforico (es. ritirarsi da un impegno)."
    },
    {
      "pos": "verbo impersonale",
      "definition": "essere favorevole o propizio, spesso riferito a condizioni atmosferiche o situazioni",
      "examples": [
        "Oggi tira proprio una bella giornata, andiamo al mare!",
        "Non tira per niente, meglio rimandare la gita."
      ],
      "nota": "Uso colloquiale, spesso riferito al tempo atmosferico o a circostanze generali."
    }
  ]
