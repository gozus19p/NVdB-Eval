  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Stanza di un'abitazione destinata alla permanenza e al ricevimento delle persone.",
      "examples": [
        "Abbiamo arredato il soggiorno con un divano nuovo e una libreria.",
        "Passiamo la maggior parte del tempo in soggiorno a guardare la televisione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Permanenza temporanea in un luogo diverso da quello di residenza abituale.",
      "examples": [
        "Durante le vacanze estive abbiamo fatto un soggiorno di due settimane in montagna.",
        "Il soggiorno all'estero gli ha permesso di migliorare la conoscenza della lingua."
      ],
      "nota": "Può riferirsi sia a periodi brevi (es. vacanze) che prolungati (es. studio o lavoro temporaneo)."
    },
    {
      "pos": "verbo intransitivo (ausiliare: essere)",
      "definition": "Rimanere temporaneamente in un luogo diverso da quello di residenza abituale.",
      "examples": [
        "Abbiamo soggiornato in un hotel a cinque stelle durante il nostro viaggio a Parigi.",
        "Durante l'estate, molti turisti soggiornano nelle località balneari."
      ],
      "nota": "Spesso usato per indicare una permanenza con finalità turistiche, di studio o lavoro."
    }
