  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona che appartiene a uno Stato o a una città, con diritti e doveri stabiliti dalla legge.",
      "examples": [
        "Ogni cittadino ha il diritto di votare alle elezioni.",
        "I cittadini stranieri devono richiedere il permesso di soggiorno."
      ],
      "nota": "Può riferirsi anche a chi risiede stabilmente in una città, indipendentemente dalla cittadinanza legale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che vive in una città, contrapposta a chi vive in campagna.",
      "examples": [
        "I cittadini si lamentano del traffico nelle ore di punta.",
        "Molti cittadini preferiscono spostarsi in bicicletta per evitare code."
      ],
      "nota": "In questo senso, può includere anche residenti non cittadini in senso giuridico."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a una città o ai suoi abitanti.",
      "examples": [
        "Le amministrazioni cittadine hanno organizzato una festa per il patrono.",
        "Il trasporto cittadino è migliorato con l'introduzione delle nuove linee metro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene o è proprio di chi vive in città, in contrapposizione a ciò che è rurale.",
      "examples": [
        "Ha uno stile di vita molto cittadino, ama i ristoranti e i teatri.",
        "Il mercato cittadino offre prodotti più vari rispetto a quello del paese."
      ],
      "nota": null
    }
  ]
