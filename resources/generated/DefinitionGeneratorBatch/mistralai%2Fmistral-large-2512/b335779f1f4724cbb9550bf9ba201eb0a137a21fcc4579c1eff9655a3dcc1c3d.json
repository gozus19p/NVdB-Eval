  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "aumentare di dimensioni, svilupparsi in modo naturale, riferito a esseri viventi o organismi",
      "examples": [
        "Il bambino è cresciuto molto quest'anno.",
        "Le piante crescono più velocemente con la giusta quantità di luce."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "aumentare di quantità, intensità o importanza",
      "examples": [
        "Il prezzo della benzina è cresciuto notevolmente negli ultimi mesi.",
        "La sua popolarità è cresciuta dopo l'uscita del nuovo album."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "far aumentare le dimensioni, la quantità o l'importanza di qualcosa o qualcuno",
      "examples": [
        "Questo concime aiuta a crescere le piante più forti.",
        "L'azienda vuole crescere il proprio fatturato del 10% quest'anno."
      ],
      "nota": "Spesso usato in contesti educativi, agricoli o economici."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "maturare, svilupparsi dal punto di vista psicologico o intellettuale",
      "examples": [
        "È cresciuto molto da quando ha iniziato l'università.",
        "Crescere in una famiglia numerosa ti insegna a condividere."
      ],
      "nota": "Può riferirsi anche a esperienze che contribuiscono allo sviluppo personale."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "aumentare di livello o grado, specialmente in contesti lavorativi o sportivi",
      "examples": [
        "Dopo anni di gavetta, è finalmente cresciuto di ruolo in azienda.",
        "La squadra è cresciuta in classifica dopo la vittoria contro i campioni in carica."
      ],
      "nota": null
