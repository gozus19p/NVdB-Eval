  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Essere spirituale, considerato messaggero di Dio nella tradizione cristiana, spesso rappresentato con ali e aureola.",
      "examples": [
        "Nella Bibbia, gli angeli annunciano la nascita di Gesù ai pastori.",
        "Il bambino disegnava un angelo con le ali dorate."
      ],
      "nota": "In contesti religiosi, gli angeli sono spesso associati a funzioni di protezione o guida divina. Può riferirsi anche a figure di altre tradizioni spirituali con caratteristiche simili."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di eccezionale bontà, purezza o bellezza, spesso usata in senso affettuoso o iperbolico.",
      "examples": [
        "Mia nonna è un angelo: aiuta sempre tutti senza chiedere nulla in cambio.",
        "Hai preparato la cena? Sei un angelo!"
      ],
      "nota": "Usato comunemente in espressioni come 'angelo custode' per indicare una persona che offre protezione o supporto costante."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che svolge un ruolo di assistenza o protezione in modo discreto e efficace.",
      "examples": [
        "Il portiere del palazzo è un vero angelo: risolve ogni problema prima ancora che ce ne accorgiamo.",
        "Durante il viaggio, quella guida turistica è stata il nostro angelo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In espressioni idiomatiche, indica una persona che sembra perfetta o irreprensibile, spesso con sfumatura ironica.",
      "examples": [
        "Non è mica un angelo, ha i suoi difetti come tutti.",
        "Pensi che sia un angelo? Aspetta di conoscerlo meglio!"
      ],
      "nota": "Spesso usato in frasi negative per smorzare l'idealizzazione di qualcuno."
    }
  ]
