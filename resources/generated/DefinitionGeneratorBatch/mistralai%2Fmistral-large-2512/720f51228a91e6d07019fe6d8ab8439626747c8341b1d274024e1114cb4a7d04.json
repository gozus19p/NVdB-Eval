  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Incontro sportivo tra due squadre o giocatori, regolato da norme specifiche e finalizzato a determinare un vincitore.",
      "examples": [
        "La partita di calcio è finita due a uno per la squadra ospite.",
        "Domani sera giocheremo una partita a tennis al circolo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Quantità di merce o prodotti raggruppati insieme per la vendita, la spedizione o l'uso.",
      "examples": [
        "Abbiamo ricevuto una partita di scarpe nuove in negozio.",
        "Il magazzino ha esaurito l'ultima partita di magliette estive."
      ],
      "nota": "Spesso usato in contesti commerciali o logistici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di movimenti o registrazioni contabili relative a una transazione finanziaria o commerciale.",
      "examples": [
        "Ho chiuso la partita con il fornitore pagando l'ultima fattura.",
        "Il commercialista ha verificato tutte le partite del bilancio annuale."
      ],
      "nota": "Termine usato soprattutto in ambito amministrativo e contabile."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio comune, situazione o questione che implica una scelta, un'opportunità o una sfida.",
      "examples": [
        "Questa promozione è una partita importante per la mia carriera.",
        "Non voglio giocare questa partita, preferisco tirarmi indietro."
      ],
      "nota": "Uso figurato, spesso in espressioni come 'giocare una partita' o 'essere in partita'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel gioco degli scacchi, sequenza di mosse che costituisce una fase della sfida.",
      "examples": [
        "Ha sacrificato un alfiere per vincere la partita in poche mosse.",
        "La partita è finita in parità dopo cinque ore di gioco."
      ],
      "nota": "Termine specifico del lessico scacchistico, ma diffuso anche in altri giochi da tavolo."
    }
  ]
