  "senses": [
    {
      "pos": "sostantivo m. invar.",
      "definition": "Il numero naturale che segue il tre e precede il cinque, rappresentato dal simbolo 4 o IV in numerazione romana.",
      "examples": [
        "Il quattro è un numero pari.",
        "Sul dado, il quattro ha quattro puntini."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale cardinale invar.",
      "definition": "In quantità pari a tre più uno; usato per indicare una quantità precisa di elementi.",
      "examples": [
        "Ho comprato quattro mele al mercato.",
        "La stanza ha quattro finestre."
      ],
      "nota": "Può essere usato anche in funzione pronominale (es. 'Ne ho presi quattro')."
    },
    {
      "pos": "sostantivo m. invar.",
      "definition": "Cifra o simbolo che rappresenta il numero quattro.",
      "examples": [
        "Scrivi un quattro sul foglio.",
        "Il numero di telefono inizia con un quattro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invar.",
      "definition": "Nel sistema scolastico italiano, voto sufficiente, corrispondente a sei decimi.",
      "examples": [
        "Ho preso un quattro nel compito di matematica.",
        "Mi accontenterei anche di un quattro, purché sia sufficiente."
      ],
      "nota": "In contesti informali, può indicare un risultato appena sufficiente o mediocre."
    },
    {
      "pos": "sostantivo m. invar.",
      "definition": "Nel gioco delle carte, carta che vale quattro punti o che reca quattro simboli dello stesso seme.",
      "examples": [
        "Ho pescato un quattro di cuori.",
        "Il quattro di picche è una carta bassa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invar.",
      "definition": "Nel calcio, modulo tattico che prevede quattro difensori, quattro centrocampisti e due attaccanti.",
      "examples": [
        "L'allenatore ha optato per il quattro-quattro-due.",
        "Con il quattro in difesa, la squadra è più equilibrata."
      ],
      "nota": "Spesso abbreviato in 'quattro' nel linguaggio calcistico."
    },
    {
      "pos": "avverbio",
      "definition": "In modo approssimativo, indicando una quantità o un tempo non preciso ma vicino a quattro.",
      "examples": [
        "Ci vediamo tra quattro passi.",
        "Arriverò tra quattro e quattr'otto."
      ],
      "nota": "Usato in espressioni idiomatiche o colloquiali per indicare brevità o immediatezza."
    }
