  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "emettere suoni e movimenti facciali involontari come reazione a qualcosa di divertente o piacevole",
      "examples": [
        "Quando ha raccontato quella barzelletta, tutti hanno iniziato a ridere.",
        "Il bambino rideva felice mentre giocava con il cane."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "manifestare gioia o soddisfazione in modo evidente, anche senza emettere suoni",
      "examples": [
        "Dopo aver vinto la partita, rideva sotto i baffi.",
        "Rideva di gusto per la bella notizia."
      ],
      "nota": "Può indicare anche un'espressione facciale di contentezza, non necessariamente accompagnata da risate."
    },
    {
      "pos": "verbo transitivo",
      "definition": "deridere qualcuno o qualcosa, spesso in modo sprezzante",
      "examples": [
        "Non è bello ridere i difetti degli altri.",
        "Lo hanno riso per il suo accento straniero."
      ],
      "nota": "Uso meno comune rispetto alla forma riflessiva o pronominale ('ridere di')."
    },
    {
      "pos": "verbo pronominale (ridersi)",
      "definition": "prendere in giro qualcuno o qualcosa, spesso in modo scherzoso o ironico",
      "examples": [
        "Si ridevano delle sue battute anche quando non erano divertenti.",
        "Non ti ridere di me, non è carino."
      ],
      "nota": "Spesso usato con la preposizione 'di' per indicare l'oggetto della derisione."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "essere favorevole o propizio, detto di circostanze o situazioni",
      "examples": [
        "La fortuna gli ha riso fin dal primo giorno.",
        "Finalmente la sorte ha cominciato a ridere anche a lui."
      ],
      "nota": "Uso figurato, spesso in contesti legati alla fortuna o al destino."
    }
  ]
