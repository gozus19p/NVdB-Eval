  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di particelle solide molto fini, spesso invisibili singolarmente, che si depositano sulle superfici o restano sospese nell'aria.",
      "examples": [
        "Dopo aver spolverato i mobili, ho trovato uno strato di polvere sul pavimento.",
        "La polvere si accumula facilmente sugli scaffali alti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Sostanza solida ridotta in particelle minutissime, spesso usata in ambito farmaceutico, cosmetico o alimentare.",
      "examples": [
        "Ho comprato una polvere per preparare una torta al cioccolato.",
        "Il medico mi ha prescritto una polvere da sciogliere in acqua per il mal di gola."
      ],
      "nota": "In questo senso, spesso accompagnato da specificazioni (es. *polvere di caffè*, *polvere detergente*)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Residuo solido che rimane dopo la combustione di qualcosa, spesso associato a cenere o detriti.",
      "examples": [
        "Dopo l'incendio, della casa rimaneva solo la polvere.",
        "Le ceneri e la polvere coprivano il luogo dell'esplosione."
      ],
      "nota": "Uso spesso figurato o letterario, soprattutto in contesti di distruzione o decadimento."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Termine gergale per indicare cocaina o altre sostanze stupefacenti in forma di polvere.",
      "examples": [
        "La polizia ha sequestrato diversi chili di polvere durante il blitz.",
        "Non toccare quella roba, è polvere pura."
      ],
      "nota": "Uso colloquiale e informale, spesso in contesti legati alla criminalità o allo spaccio."
    },
    {
      "pos": "sostantivo f. (solo singolare)",
      "definition": "Condizione di abbandono o trascuratezza, spesso usata in espressioni idiomatiche.",
      "examples": [
        "Questo progetto è finito in polvere dopo che il finanziamento è stato tagliato.",
        "Tutti i suoi sogni si sono ridotti in polvere."
      ],
      "nota": "Uso figurato, spesso in espressioni come *ridursi in polvere* o *andare in polvere*."
    }
  ]
