  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "segmento di una linea, di un percorso o di una superficie che si distingue per una caratteristica specifica",
      "examples": [
        "Abbiamo percorso un tratto di strada in salita prima di arrivare al rifugio.",
        "Il fiume scorre per un lungo tratto tra le montagne."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "caratteristica distintiva di una persona o di una cosa, spesso riferita all'aspetto fisico o al comportamento",
      "examples": [
        "Ha un tratto gentile che lo rende simpatico a tutti.",
        "I tratti del suo viso ricordano quelli della madre."
      ],
      "nota": "Può riferirsi anche a caratteristiche non fisiche, come tratti del carattere."
    },
    {
      "pos": "sostantivo m.",
      "definition": "breve periodo di tempo",
      "examples": [
        "Dopo un tratto di silenzio, ha ripreso a parlare.",
        "Rimarrò qui solo per un tratto, poi dovrò andare."
      ],
      "nota": "Spesso usato in contesti informali o colloquiali."
    },
    {
      "pos": "sostantivo m.",
      "definition": "parte di un testo scritto o di un discorso",
      "examples": [
        "Ho letto un tratto interessante di quel libro.",
        "In quel tratto del discorso, l'oratore ha toccato temi importanti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "azione di tirare o trascinare qualcosa con forza",
      "examples": [
        "Con un tratto deciso, ha aperto la porta.",
        "Il cavallo ha dato un forte tratto alla carrozza."
      ],
      "nota": "Uso meno comune, spesso in contesti letterari o descrittivi."
    },
    {
      "pos": "verbo transitivo (participio passato di 'trarre')",
      "definition": "portato via, condotto o estratto da un luogo o una situazione",
      "examples": [
        "È stato tratto in salvo dai vigili del fuoco.",
        "Dalla vicenda sono stati tratti importanti insegnamenti."
      ],
      "nota": "Spesso usato in forme composte o participiali (es. 'tratto in inganno')."
    },
    {
      "pos": "verbo intransitivo (participio passato di 'trarre')",
      "definition": "derivato o originato da qualcosa",
      "examples": [
        "Questo vino è tratto da uve selezionate.",
        "Il film è tratto da un romanzo di successo."
      ],
      "nota": "Usato soprattutto in contesti che indicano origine o derivazione."
    }
  ]
