  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Principio o insieme di norme che stabiliscono un comportamento o un procedimento da seguire in un determinato ambito.",
      "examples": [
        "Le regole del calcio sono cambiate negli ultimi anni.",
        "È importante rispettare le regole della buona educazione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strumento usato per tracciare linee dritte o misurare angoli.",
      "examples": [
        "Ho usato la regola per disegnare una linea perfettamente dritta.",
        "Il falegname controlla l'angolo con una regola di metallo."
      ],
      "nota": "In questo senso, è spesso usato al singolare e può essere accompagnato da specificazioni (es. 'regola di legno', 'regola graduata')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Condizione abituale o situazione che si ripete con frequenza.",
      "examples": [
        "La puntualità non è la sua regola, arriva sempre in ritardo.",
        "In questa città, la pioggia è la regola piuttosto che l'eccezione."
      ],
      "nota": "Spesso usato in espressioni come 'di regola' o 'per regola'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dirigere o controllare il funzionamento o il comportamento di qualcosa o qualcuno secondo determinati criteri.",
      "examples": [
        "Il governo regola il traffico con nuove norme.",
        "Questo termostato regola la temperatura della stanza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Adattare o modificare qualcosa in modo che risponda a esigenze specifiche.",
      "examples": [
        "Devi regolare il sedile dell'auto per guidare comodamente.",
        "Ho regolato l'orologio perché era indietro di cinque minuti."
      ],
      "nota": "Spesso usato in contesti tecnici o meccanici."
    },
    {
      "pos": "verbo riflessivo (regolarsi)",
      "definition": "Comportarsi o agire in modo adeguato alle circostanze.",
      "examples": [
        "Devi regolarti con le spese, altrimenti finirai i soldi prima della fine del mese.",
        "Mi regolo sempre in base alle esigenze degli altri."
      ],
      "nota": "Può implicare un senso di moderazione o prudenza."
    }
  ]
