  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Atto di aiuto o sostegno rivolto a qualcuno, spesso disinteressato o motivato da benevolenza.",
      "examples": [
        "Mi ha fatto un grande favore prestandomi la macchina per il weekend.",
        "Chiedere un favore a un amico è normale, ma non bisogna abusarne."
      ],
      "nota": "Può implicare una relazione di reciprocità, anche se non sempre esplicita. Spesso usato in contesti informali o amicali."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione di preferenza o vantaggio accordato a qualcuno, spesso in modo ingiustificato o parziale.",
      "examples": [
        "Il direttore ha ottenuto quel posto per puro favore, non per merito.",
        "Non è giusto che alcuni studenti ricevano favori dagli insegnanti."
      ],
      "nota": "In questo senso, assume spesso una connotazione negativa, implicando ingiustizia o nepotismo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Espressione usata per chiedere gentilmente qualcosa a qualcuno, spesso in formule di cortesia.",
      "examples": [
        "Per favore, potresti passarmi il sale?",
        "Mi scusi, per favore, sa dirmi che ore sono?"
      ],
      "nota": "In questa accezione, è quasi sempre accompagnato dalla preposizione 'per' e usato in frasi interrogative o imperative."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Circostanza o situazione che risulta vantaggiosa o propizia per qualcuno.",
      "examples": [
        "Il vento a favore ha permesso alla barca di arrivare prima del previsto.",
        "Avere un amico in quella ditta è stato un vero favore per la mia carriera."
      ],
      "nota": "Spesso usato in espressioni come 'a favore di' o 'in favore di' per indicare un vantaggio o un sostegno."
    }
  ]
