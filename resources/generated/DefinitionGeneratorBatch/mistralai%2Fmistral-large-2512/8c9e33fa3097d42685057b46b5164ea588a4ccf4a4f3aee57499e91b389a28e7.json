      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che è pronto ad aiutare o a collaborare con generosità e senza riserve",
      "examples": [
        "È sempre disponibile ad ascoltare i problemi dei suoi amici.",
        "Il professore è molto disponibile con gli studenti che hanno difficoltà."
      ],
      "nota": "Spesso usato per descrivere un atteggiamento positivo nei confronti degli altri, sia in contesti formali che informali."
    },
    {
      "pos": "aggettivo",
      "definition": "che non è impegnato in un'attività e può quindi dedicarsi ad altro",
      "examples": [
        "Sono disponibile per una riunione domani pomeriggio.",
        "Se sei disponibile, possiamo vederci per un caffè."
      ],
      "nota": "Può riferirsi sia a persone che a risorse temporali."
    }
