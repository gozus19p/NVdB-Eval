  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "ritenere vero o probabile qualcosa, spesso senza prove certe o basandosi su convinzioni personali",
      "examples": [
        "Credo che domani pioverà, ho visto le previsioni del tempo.",
        "Non crede alle promesse del politico, ha già cambiato idea troppe volte."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "avere fiducia in qualcuno o qualcosa, considerandolo affidabile o degno di stima",
      "examples": [
        "Credo in te, so che ce la farai.",
        "Molte persone credono ancora nei valori della famiglia tradizionale."
      ],
      "nota": "Spesso usato con la preposizione 'in' per indicare fiducia in entità astratte o persone."
    },
    {
      "pos": "verbo intransitivo (ausiliare 'avere')",
      "definition": "essere convinto dell'esistenza di una divinità o di principi religiosi",
      "examples": [
        "Da quando è successo l'incidente, ha smesso di credere.",
        "Credere non significa solo seguire dei dogmi, ma anche vivere secondo certi principi."
      ],
      "nota": "In questo senso, il verbo è spesso usato in contesti religiosi o spirituali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "ritenere qualcuno colpevole o responsabile di qualcosa, spesso senza prove definitive",
      "examples": [
        "Lo credono l'autore del furto, ma non ci sono prove.",
        "Non posso crederti capace di una cosa del genere!"
      ],
      "nota": "Può implicare un giudizio negativo o una supposizione non confermata."
    },
    {
      "pos": "verbo transitivo (con valore modale)",
      "definition": "pensare o supporre qualcosa, spesso in modo incerto o ipotetico",
      "examples": [
        "Credo di aver lasciato le chiavi sul tavolo.",
        "Credo che partirò domani, ma non ne sono sicuro."
      ],
      "nota": "In questo uso, il verbo introduce un'opinione o una supposizione non certa."
    },
    {
      "pos": "verbo riflessivo (credersi)",
      "definition": "considerarsi in un certo modo, spesso con una connotazione di eccessiva autostima o illusione",
      "examples": [
        "Si crede un genio, ma in realtà non sa fare quasi nulla.",
        "Non ti credere migliore degli altri solo perché hai studiato di più."
      ],
      "nota": "Spesso usato per esprimere un giudizio critico sull'autopercezione di qualcuno."
    }
  ]
