  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione di irritazione o disagio fisico, spesso lieve ma persistente.",
      "examples": [
        "Mi dà fastidio il colletto della camicia quando è troppo stretto.",
        "Il rumore del trapano dal piano di sopra mi provoca un gran fastidio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione di irritazione o insofferenza psicologica causata da persone, situazioni o comportamenti.",
      "examples": [
        "Il suo continuo lamentarsi è un vero fastidio per tutti.",
        "Non voglio darti fastidio con le mie richieste, ma avrei bisogno di un favore."
      ],
      "nota": "Può essere usato anche in contesti formali per esprimere cortese disagio (es. 'Scusi il fastidio')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Disturbo o problema di lieve entità, spesso temporaneo.",
      "examples": [
        "Ho un piccolo fastidio alla schiena dopo la partita di ieri.",
        "Il fastidio alla gola è passato dopo aver preso una caramella balsamica."
      ],
      "nota": "In ambito medico, può indicare un sintomo non grave ma ricorrente."
    }
  ]
