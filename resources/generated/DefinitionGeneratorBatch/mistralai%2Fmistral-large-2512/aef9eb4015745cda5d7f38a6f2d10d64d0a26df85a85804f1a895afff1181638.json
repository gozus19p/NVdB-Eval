  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che manca di bontà o moralità, incline a compiere azioni dannose o malvagie",
      "examples": [
        "Quel ragazzo è stato punito per il suo comportamento cattivo.",
        "Non bisogna giudicare le persone solo perché hanno una cattiva reputazione."
      ],
      "nota": "Può riferirsi sia a persone che a azioni o intenzioni. Spesso usato in contrapposizione a 'buono'."
    },
    {
      "pos": "aggettivo",
      "definition": "di scarsa qualità, non adeguato o insoddisfacente",
      "examples": [
        "Il cibo in quel ristorante era davvero cattivo.",
        "Ho avuto una cattiva impressione della riunione di ieri."
      ],
      "nota": "In questo senso, può essere sinonimo di 'scadente' o 'mediocre'."
    },
    {
      "pos": "aggettivo",
      "definition": "che provoca disagio, dolore o malessere fisico",
      "examples": [
        "Dopo aver mangiato troppo, ho avuto un cattivo sapore in bocca.",
        "Mi fa male la testa, oggi ho un cattivo umore."
      ],
      "nota": "Spesso usato per descrivere sensazioni fisiche o stati d'animo negativi."
    },
    {
      "pos": "aggettivo",
      "definition": "che non funziona correttamente o non è adatto allo scopo",
      "examples": [
        "Questo coltello è cattivo, non taglia bene.",
        "Il tempo è stato cattivo per tutta la settimana, non siamo potuti uscire."
      ],
      "nota": "Può riferirsi a oggetti, condizioni atmosferiche o situazioni."
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona che compie azioni malvagie o dannose",
      "examples": [
        "Nel film, il cattivo viene sconfitto alla fine.",
        "Non voglio essere considerato un cattivo, ma a volte è difficile fare la cosa giusta."
      ],
      "nota": "Usato soprattutto in contesti narrativi (film, libri, favole) per indicare l'antagonista."
    }
  ]
