  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "trovarsi casualmente o intenzionalmente in presenza di qualcuno o qualcosa",
      "examples": [
        "Ho incontrato Marco al supermercato ieri.",
        "Durante la passeggiata, abbiamo incontrato un gruppo di escursionisti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "avere un colloquio o un confronto con qualcuno, spesso per discutere questioni specifiche",
      "examples": [
        "Il presidente incontrerà i sindacati domani per discutere delle nuove riforme.",
        "Ho incontrato il mio avvocato per parlare del caso."
      ],
      "nota": "Spesso usato in contesti formali o professionali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "trovare o imbattersi in una situazione, un problema o una difficoltà",
      "examples": [
        "Durante il viaggio, abbiamo incontrato molte difficoltà.",
        "Il progetto ha incontrato l'opposizione di diversi stakeholder."
      ],
      "nota": "Può essere usato in senso figurato per indicare ostacoli o resistenze."
    },
    {
      "pos": "verbo intransitivo pronominale (incontrarsi)",
      "definition": "trovarsi reciprocamente in un luogo, spesso per un appuntamento o una riunione",
      "examples": [
        "Ci siamo incontrati al bar per un caffè.",
        "I due leader si incontreranno a Bruxelles la prossima settimana."
      ],
      "nota": "La forma pronominale implica reciprocità."
    },
    {
      "pos": "verbo transitivo",
      "definition": "essere accolto o ricevuto in un certo modo da qualcuno",
      "examples": [
        "La sua proposta ha incontrato il favore del pubblico.",
        "Il nuovo film ha incontrato critiche positive dalla stampa."
      ],
      "nota": "Spesso usato per descrivere reazioni o giudizi su idee, opere o iniziative."
    }
  ]
