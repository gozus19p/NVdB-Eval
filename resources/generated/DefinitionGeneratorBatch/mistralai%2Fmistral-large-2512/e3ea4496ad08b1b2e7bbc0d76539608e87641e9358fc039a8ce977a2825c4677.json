  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che ha un prezzo elevato o superiore alle aspettative",
      "examples": [
        "Questo ristorante è troppo caro per le mie tasche.",
        "I biglietti per il concerto sono diventati cari all'ultimo minuto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che è oggetto di affetto o stima profonda",
      "examples": [
        "Mio caro amico, come stai dopo tutti questi anni?",
        "È stata una cara amica per tutta la vita."
      ],
      "nota": "Spesso usato in formule di cortesia o in contesti affettivi, anche in apertura di lettere o messaggi."
    },
    {
      "pos": "aggettivo",
      "definition": "che comporta sacrificio, fatica o conseguenze negative",
      "examples": [
        "La vittoria è stata cara, abbiamo perso due giocatori per infortunio.",
        "Ha pagato caro il suo errore con una lunga sospensione."
      ],
      "nota": "Usato in contesti figurati per indicare un costo non economico, ma emotivo, fisico o morale."
    },
    {
      "pos": "avverbio",
      "definition": "a un prezzo elevato",
      "examples": [
        "Ho comprato questa giacca caro, ma ne vale la pena.",
        "Vendono le case caro in questa zona."
      ],
      "nota": "Forma invariabile, spesso usata in contesti informali o colloquiali. Equivale a 'a caro prezzo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona amata o verso cui si prova affetto",
      "examples": [
        "Ciao caro, come stai oggi?",
        "I miei cari mi hanno fatto una sorpresa per il compleanno."
      ],
      "nota": "Usato soprattutto al vocativo o in riferimento a persone care, spesso in contesti familiari o affettivi."
    }
  ]
