  "senses": [
    {
      "pos": "aggettivo",
      "definition": "relativo alla gestione della cosa pubblica e alle decisioni che riguardano la collettività",
      "examples": [
        "La riforma ha suscitato un acceso dibattito politico.",
        "Il partito ha presentato il suo programma politico per le prossime elezioni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che riguarda i rapporti tra Stati o enti sovranazionali",
      "examples": [
        "L’accordo politico tra i due paesi ha migliorato le relazioni diplomatiche.",
        "La crisi politica internazionale ha richiesto un intervento delle Nazioni Unite."
      ],
      "nota": "Spesso usato in contesti di diplomazia o relazioni internazionali."
    },
    {
      "pos": "aggettivo",
      "definition": "che si comporta con prudenza e diplomazia, evitando posizioni nette o conflittuali",
      "examples": [
        "Ha adottato un approccio politico per evitare di scontentare entrambe le parti.",
        "La sua risposta è stata molto politica, senza sbilanciarsi troppo."
      ],
      "nota": "Uso figurato, spesso con connotazione positiva o neutra."
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona che svolge attività di governo o rappresentanza istituzionale, spesso come membro di un partito",
      "examples": [
        "Il politico ha annunciato le sue dimissioni dopo lo scandalo.",
        "Molti politici partecipano ai talk show per discutere di attualità."
      ],
      "nota": "Può avere una connotazione neutra, positiva o negativa a seconda del contesto."
    },
    {
      "pos": "sostantivo m.",
      "definition": "attività o professione legata alla gestione della cosa pubblica e alla partecipazione alla vita istituzionale",
      "examples": [
        "Si è dedicato alla politica fin da giovane, entrando nel consiglio comunale.",
        "La politica richiede competenze di mediazione e strategia."
      ],
      "nota": "In questo senso, il termine può essere usato anche al femminile (es. 'la politica')."
    }
  ]
