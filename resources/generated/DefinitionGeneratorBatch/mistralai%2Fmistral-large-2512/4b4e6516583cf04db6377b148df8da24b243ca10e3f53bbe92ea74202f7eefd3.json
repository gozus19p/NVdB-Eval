  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che contiene una quantità elevata di lipidi o tessuto adiposo, spesso in eccesso rispetto alla norma.",
      "examples": [
        "Questo formaggio è molto grasso, meglio non esagerare.",
        "Dopo le feste, ha deciso di evitare cibi troppo grassi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha un aspetto untuoso o viscoso al tatto.",
      "examples": [
        "Le mani erano sporche di una sostanza grassa.",
        "La pelle del viso le sembrava grassa dopo la crema."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che produce un guadagno elevato o vantaggioso dal punto di vista economico.",
      "examples": [
        "Ha trovato un lavoro grasso in una multinazionale.",
        "Quell'affare si è rivelato più grasso del previsto."
      ],
      "nota": "Uso figurato, spesso colloquiale."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha una consistenza morbida e ricca, tipica di alcuni alimenti.",
      "examples": [
        "Preferisco la pasta al dente, non troppo grassa.",
        "Il risotto era cremoso e grasso al punto giusto."
      ],
      "nota": "Riferito soprattutto a cibi o preparazioni culinarie."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza lipidica di origine animale o vegetale, solida o semisolida a temperatura ambiente.",
      "examples": [
        "Per cucinare, usa il grasso di maiale invece dell'olio.",
        "Il grasso della carne si è sciolto durante la cottura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Eccesso di tessuto adiposo nel corpo di una persona o di un animale.",
      "examples": [
        "Fa fatica a muoversi a causa del grasso accumulato.",
        "Il veterinario ha detto che il cane ha troppo grasso."
      ],
      "nota": "Spesso usato in contesti medici o di benessere."
    },
    {
      "pos": "avverbio",
      "definition": "In modo abbondante o generoso, soprattutto in riferimento a guadagni o benefici.",
      "examples": [
        "Con quel contratto, ha guadagnato grasso.",
        "Hanno pagato grasso per quel servizio."
      ],
      "nota": "Uso colloquiale e spesso ironico."
    }
  ]
