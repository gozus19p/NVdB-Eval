  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "parte di un oggetto o di un insieme che si è staccata o che può essere considerata separatamente",
      "examples": [
        "Ho trovato un pezzo di vetro sul pavimento.",
        "Mi manca un pezzo per completare il puzzle."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "oggetto o manufatto considerato nella sua interezza, spesso con riferimento a opere artistiche o artigianali",
      "examples": [
        "Questo vaso è un pezzo unico di artigianato locale.",
        "Il museo ha acquisito un nuovo pezzo per la sua collezione."
      ],
      "nota": "Spesso usato in contesti artistici, musicali o di antiquariato."
    },
    {
      "pos": "sostantivo m.",
      "definition": "porzione di cibo solido tagliata o spezzata da un alimento più grande",
      "examples": [
        "Vuoi un pezzo di torta?",
        "Ho mangiato solo un pezzo di pane a colazione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "unità di misura non standard per indicare una quantità approssimativa di tempo",
      "examples": [
        "Aspetta un pezzo, arrivo subito!",
        "Non lo vedo da un pezzo."
      ],
      "nota": "Uso colloquiale e informale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "componimento musicale o teatrale",
      "examples": [
        "Hanno suonato un pezzo di Mozart al concerto.",
        "Questo è il mio pezzo preferito dello spettacolo."
      ],
      "nota": "Comune in ambito musicale e teatrale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "articolo scritto pubblicato su un giornale o una rivista",
      "examples": [
        "Ho letto un pezzo interessante sul cambiamento climatico.",
        "Il giornalista ha scritto un pezzo sulla politica locale."
      ],
      "nota": "Uso giornalistico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "arma da fuoco portatile, specialmente un fucile o una pistola",
      "examples": [
        "Il cacciatore imbracciò il suo pezzo prima di uscire.",
        "La polizia ha trovato un pezzo nascosto nel bagagliaio."
      ],
      "nota": "Uso gergale e informale, spesso in contesti legati alla criminalità o alla caccia."
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona considerata come un elemento di un gruppo, spesso con connotazione negativa o spersonalizzante",
      "examples": [
        "Quel tipo è un pezzo di merda.",
        "Non voglio avere a che fare con certi pezzi di gente."
      ],
      "nota": "Uso volgare e dispregiativo."
    }
