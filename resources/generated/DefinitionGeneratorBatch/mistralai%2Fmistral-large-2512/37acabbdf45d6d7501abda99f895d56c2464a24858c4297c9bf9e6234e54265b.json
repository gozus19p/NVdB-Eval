  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare: avere)",
      "definition": "cessare un'attività, un comportamento o un'azione in corso",
      "examples": [
        "Ha smesso di fumare dopo dieci anni.",
        "Smettila di fare rumore, sto lavorando!"
      ],
      "nota": "Spesso seguito dalla preposizione 'di' e un verbo all'infinito per specificare l'azione interrotta."
    },
    {
      "pos": "verbo transitivo",
      "definition": "interrompere l'uso o la produzione di qualcosa",
      "examples": [
        "Hanno smesso la produzione di quel modello per mancanza di domanda.",
        "Smettila quel gioco, è pericoloso."
      ],
      "nota": "Uso meno comune rispetto alla forma intransitiva; spesso riferito a oggetti o attività concrete."
    },
    {
      "pos": "verbo intransitivo (ausiliare: essere)",
      "definition": "terminare naturalmente, detto di fenomeni atmosferici o stati temporanei",
      "examples": [
        "La pioggia è finalmente smessa dopo ore.",
        "Il vento è smesso all'improvviso."
      ],
      "nota": "Uso prevalentemente letterario o regionale; nell'italiano standard si preferisce 'cessare' o 'finire'."
    }
  ]
