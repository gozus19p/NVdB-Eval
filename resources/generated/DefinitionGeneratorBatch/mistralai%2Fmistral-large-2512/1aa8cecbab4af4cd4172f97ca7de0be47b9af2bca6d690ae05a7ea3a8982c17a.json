  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "dividere un oggetto solido o un materiale in parti più piccole o in pezzi mediante l'uso di uno strumento affilato",
      "examples": [
        "Ho tagliato la mela a metà con un coltello affilato.",
        "Devi tagliare il legno per costruire la mensola."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "interrompere o interrompere il flusso di qualcosa, come un liquido, un gas o un servizio",
      "examples": [
        "Hanno tagliato l'acqua per lavori sulla rete idrica.",
        "Il governo ha deciso di tagliare i fondi per quel progetto."
      ],
      "nota": "Può riferirsi anche a riduzioni di budget, personale o risorse."
    },
    {
      "pos": "verbo transitivo",
      "definition": "accorciare o modificare la lunghezza di qualcosa, come capelli o tessuti, mediante l'uso di forbici o altri strumenti",
      "examples": [
        "Mi sono fatta tagliare i capelli dal parrucchiere.",
        "Devi tagliare questo vestito perché è troppo lungo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "escludere o omettere intenzionalmente una parte di un testo, un discorso o un'opera",
      "examples": [
        "Il regista ha deciso di tagliare alcune scene dal film per ridurne la durata.",
        "Hanno tagliato il finale del libro nell'edizione tascabile."
      ],
      "nota": "Spesso usato in ambito editoriale o cinematografico."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "prendere una scorciatoia o un percorso più breve per raggiungere una destinazione",
      "examples": [
        "Abbiamo tagliato per il parco per arrivare prima.",
        "Se tagli per i vicoli, risparmi dieci minuti di cammino."
      ],
      "nota": "Può essere usato anche in senso figurato per indicare soluzioni rapide."
    },
    {
      "pos": "verbo transitivo",
      "definition": "interrompere bruscamente una conversazione, una relazione o un'attività",
      "examples": [
        "Ha tagliato la telefonata senza salutare.",
        "Dopo quella discussione, hanno tagliato ogni rapporto."
      ],
      "nota": "Spesso implica una rottura netta e improvvisa."
    },
    {
      "pos": "verbo transitivo",
      "definition": "ridurre la quantità o l'intensità di qualcosa, come un suono o una luce",
      "examples": [
        "Taglia il volume della musica, è troppo alto.",
        "Devi tagliare la luminosità dello schermo per risparmiare batteria."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (tagliarsi)",
      "definition": "procurarsi una ferita accidentale con un oggetto affilato",
      "examples": [
        "Mi sono tagliato mentre affettavo il pane.",
        "Stai attento a non tagliarti con quel vetro rotto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "superare qualcuno o qualcosa con un movimento rapido e deciso, come in una gara o in un contesto competitivo",
      "examples": [
        "Il ciclista ha tagliato il traguardo per primo.",
        "Ha tagliato la linea di difesa e ha segnato un gol."
      ],
      "nota": "Usato soprattutto in ambito sportivo."
    }
  ]
}