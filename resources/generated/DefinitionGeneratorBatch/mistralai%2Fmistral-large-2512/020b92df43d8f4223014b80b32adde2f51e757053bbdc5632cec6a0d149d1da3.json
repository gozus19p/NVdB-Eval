  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Evento singolo che fa parte di una serie o di una successione più ampia, spesso con un inizio e una fine ben definiti.",
      "examples": [
        "L'ultimo episodio della serie tv è stato trasmesso ieri sera.",
        "Quell'incidente è stato solo un episodio isolato nella sua carriera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sezione autonoma di un'opera narrativa, teatrale o cinematografica che contribuisce allo sviluppo della trama complessiva.",
      "examples": [
        "Nel terzo episodio del film, il protagonista scopre la verità.",
        "Ogni episodio della saga ha un proprio titolo e una trama indipendente."
      ],
      "nota": "Spesso usato in riferimento a prodotti seriali come serie televisive, romanzi a puntate o podcast."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Fatto o avvenimento di breve durata, spesso marginale o secondario rispetto a un contesto più ampio.",
      "examples": [
        "Durante il viaggio ci sono stati alcuni episodi di pioggia intensa.",
        "Ricorda ancora quell'episodio imbarazzante della sua infanzia."
      ],
      "nota": "Può avere una connotazione neutra, positiva o negativa a seconda del contesto."
    }
  ]
