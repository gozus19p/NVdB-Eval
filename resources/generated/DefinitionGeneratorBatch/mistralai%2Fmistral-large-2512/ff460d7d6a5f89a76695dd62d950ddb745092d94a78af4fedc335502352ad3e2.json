  "senses": [
    {
      "pos": "aggettivo",
      "definition": "relativo alla storia come disciplina o come insieme di eventi passati",
      "examples": [
        "Questo documento ha un grande valore storico.",
        "Il professore ha tenuto una lezione su un periodo storico poco conosciuto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che ha un'importanza rilevante e duratura nel tempo, spesso destinato a essere ricordato",
      "examples": [
        "La caduta del Muro di Berlino è stato un evento storico.",
        "Hanno firmato un accordo storico per la pace nella regione."
      ],
      "nota": "Spesso usato in contesti enfatici per sottolineare l'eccezionalità di un evento o di una decisione."
    },
    {
      "pos": "aggettivo",
      "definition": "che si basa su fatti realmente accaduti, non inventati",
      "examples": [
        "Il film racconta una storia storica ambientata durante la Seconda Guerra Mondiale.",
        "Il romanzo mescola elementi storici e fantasia."
      ],
      "nota": "Può essere usato in contrapposizione a 'fantastico' o 'immaginario'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "studioso che si occupa di storia come disciplina",
      "examples": [
        "Lo storico ha pubblicato un nuovo saggio sulla Rivoluzione Francese.",
        "Gli storici dibattono ancora sulle cause della caduta dell'Impero Romano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "persona che ha vissuto o assistito a eventi di particolare rilevanza e ne conserva memoria",
      "examples": [
        "Gli storici della Resistenza hanno raccontato le loro esperienze ai giovani.",
        "Intervistare uno storico di quegli anni è stato molto emozionante."
      ],
      "nota": "In questo senso, può essere usato anche al femminile ('storica')."
    }
  ]
