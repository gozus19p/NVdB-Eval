  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Numero naturale che segue il novantanove e precede il centouno, rappresentato dal simbolo 100 in cifre arabe e da C in numeri romani.",
      "examples": [
        "Il libro ha esattamente cento pagine.",
        "Per il compleanno ho ricevuto cento euro in regalo."
      ],
      "nota": "Può essere usato come aggettivo numerale cardinale (es. 'cento persone') o come sostantivo (es. 'un cento perfetto')."
    },
    {
      "pos": "aggettivo numerale cardinale",
      "definition": "Indica una quantità pari a dieci decine.",
      "examples": [
        "Ho invitato cento amici alla festa.",
        "Il biglietto della lotteria costa cento euro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Percentuale, parte di un intero diviso in cento parti uguali.",
      "examples": [
        "Il cento per cento degli studenti ha superato l'esame.",
        "Solo il dieci per cento dei partecipanti ha vinto un premio."
      ],
      "nota": "Spesso usato nella forma abbreviata 'per cento' o con il simbolo '%'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Voto massimo in un sistema di valutazione scolastica o accademica, spesso usato in modo figurato per indicare eccellenza.",
      "examples": [
        "Ha preso cento all'esame di matematica.",
        "Il suo discorso è stato un cento pieno."
      ],
      "nota": "In alcuni contesti, può indicare il massimo punteggio raggiungibile (es. nei giochi o nelle competizioni)."
    },
    {
      "pos": "aggettivo (invariabile)",
      "definition": "Usato in espressioni idiomatiche per indicare una quantità molto grande o indeterminata.",
      "examples": [
        "Ho cento cose da fare oggi.",
        "Mi ha raccontato cento bugie."
      ],
      "nota": "In questo uso, non indica una quantità precisa ma enfatizza la molteplicità o l'intensità."
    }
  ]
