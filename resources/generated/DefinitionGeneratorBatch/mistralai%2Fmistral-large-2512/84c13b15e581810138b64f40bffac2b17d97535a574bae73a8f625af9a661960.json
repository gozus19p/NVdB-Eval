  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Evento in cui due o più persone si trovano nello stesso luogo per parlare, collaborare o scambiarsi informazioni.",
      "examples": [
        "Ho un incontro di lavoro domani mattina alle nove.",
        "L'incontro tra i due capi di stato è stato molto produttivo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Partita o competizione sportiva tra due squadre o atleti.",
      "examples": [
        "L'incontro di calcio è stato sospeso per la pioggia.",
        "Il pugile ha vinto l'incontro per KO al secondo round."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Momento in cui due cose o persone si trovano casualmente nello stesso posto.",
      "examples": [
        "L'incontro con il mio vecchio amico è stato del tutto inaspettato.",
        "Durante il viaggio ho avuto un incontro ravvicinato con un cervo."
      ],
      "nota": "Può riferirsi anche a situazioni non pianificate, a differenza del primo senso."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Relazione amorosa o affettiva tra due persone, spesso occasionale.",
      "examples": [
        "Hanno avuto un incontro fugace durante le vacanze estive.",
        "Il film racconta la storia di un incontro che cambia la vita dei protagonisti."
      ],
      "nota": "Spesso usato in contesti romantici o sentimentali."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Trovarsi nello stesso luogo o nello stesso momento con qualcuno o qualcosa.",
      "examples": [
        "Ci siamo incontrati per caso al supermercato.",
        "Le due strade si incontrano alla rotonda."
      ],
      "nota": "Può essere usato anche in senso figurato, ad esempio per idee o opinioni che convergono."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Affrontare qualcuno o qualcosa in una competizione o confronto.",
      "examples": [
        "La squadra incontrerà i campioni in carica sabato prossimo.",
        "Durante il dibattito ha incontrato molte obiezioni."
      ],
      "nota": "Spesso usato in contesti sportivi o dialettici."
    },
    {
      "pos": "verbo riflessivo (incontrarsi)",
      "definition": "Trovarsi reciprocamente nello stesso luogo o momento.",
      "examples": [
        "Ci incontriamo ogni giovedì per giocare a tennis.",
        "Le loro vite si sono incontrate in modo inaspettato."
      ],
      "nota": "Implica una reciprocità nell'azione."
    }
  ]
