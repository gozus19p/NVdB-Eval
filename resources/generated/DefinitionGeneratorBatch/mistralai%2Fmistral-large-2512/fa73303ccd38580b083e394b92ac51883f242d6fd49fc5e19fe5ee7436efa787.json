  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Oggetto sferico usato in vari giochi e sport, generalmente di materiale elastico come gomma, cuoio o plastica.",
      "examples": [
        "I bambini giocavano a calcio con una palla di plastica nel parco.",
        "Ho bucato la palla da basket e devo comprarne una nuova."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Proiettile sferico di metallo usato in armi da fuoco antiche o in contesti specifici come la caccia.",
      "examples": [
        "Il museo esponeva un'antica pistola a palla.",
        "Nelle ricostruzioni storiche si usano ancora palle di piombo."
      ],
      "nota": "Uso prevalentemente storico o tecnico; nell'italiano contemporaneo comune si preferisce 'proiettile' o 'pallottola'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Quantità di materiale morbido o informe avvolto in modo da assumere una forma tondeggiante.",
      "examples": [
        "La nonna preparava delle palle di neve per il presepe.",
        "Ho fatto una palla di carta per buttarla nel cestino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio colloquiale, persona goffa o impacciata, spesso con riferimento a movimenti maldestri.",
      "examples": [
        "Non chiedere a Marco di passare la palla, è una palla in campo!",
        "Mi sento una palla quando ballo in pubblico."
      ],
      "nota": "Uso figurato e informale, spesso con connotazione scherzosa o affettuosa."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel gergo giovanile, bugia o frottola.",
      "examples": [
        "Non ti credo, mi stai raccontando una palla!",
        "Ha inventato una palla per non venire alla festa."
      ],
      "nota": "Uso gergale e informale, diffuso soprattutto tra i giovani."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio medico, massa tondeggiante di tessuto o materiale patologico.",
      "examples": [
        "Il medico ha rilevato una palla nel tessuto mammario durante la visita.",
        "La radiografia ha mostrato una palla di grasso nel braccio."
      ],
      "nota": "Uso tecnico, spesso sostituito da termini più specifici come 'nodulo' o 'tumefazione'."
    },
    {
      "pos": "sostantivo f. pl.",
      "definition": "Nel linguaggio colloquiale, testicoli.",
      "examples": [
        "Dopo il calcio negli stinchi, sentiva un dolore alle palle.",
        "Non stare lì con le mani nelle palle, aiutami!"
      ],
      "nota": "Uso volgare e informale, spesso in contesti di forte espressività."
    }
