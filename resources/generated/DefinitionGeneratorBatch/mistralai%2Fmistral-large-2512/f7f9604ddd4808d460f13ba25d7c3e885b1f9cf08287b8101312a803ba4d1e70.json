  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Condizione di stabilità fisica in cui le forze agenti su un corpo si annullano reciprocamente, impedendone il movimento.",
      "examples": [
        "Il funambolo ha perso l'equilibrio e è caduto dalla fune.",
        "Per mantenere l'equilibrio su una gamba sola, devi contrarre i muscoli addominali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato di armonia o proporzione tra elementi diversi, che evita eccessi o squilibri.",
      "examples": [
        "Un'alimentazione sana richiede un equilibrio tra proteine, carboidrati e grassi.",
        "Il governo cerca di trovare un equilibrio tra crescita economica e tutela dell'ambiente."
      ],
      "nota": "Spesso usato in contesti figurati per indicare una situazione ideale di bilanciamento tra opposti (es. lavoro/vita privata, libertà/sicurezza)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Capacità di controllare le proprie emozioni e reazioni, mantenendo calma e razionalità.",
      "examples": [
        "Nonostante la provocazione, ha risposto con grande equilibrio.",
        "In situazioni di crisi, è fondamentale mantenere l'equilibrio mentale."
      ],
      "nota": "Frequente in espressioni come *perdere l'equilibrio* (emotivo) o *ritrovare l'equilibrio* (psicologico)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Distribuzione uniforme del peso o delle parti di un oggetto, che ne garantisce la stabilità.",
      "examples": [
        "Il tavolo traballa perché non ha un buon equilibrio delle gambe.",
        "L'architetto ha progettato la struttura per assicurare l'equilibrio delle forze."
      ],
      "nota": "Usato anche in ambiti tecnici come l'ingegneria o il design."
    }
  ]
