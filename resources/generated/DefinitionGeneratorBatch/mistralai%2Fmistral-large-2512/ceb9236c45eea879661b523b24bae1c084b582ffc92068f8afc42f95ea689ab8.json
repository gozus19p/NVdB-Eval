  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Struttura curva che collega due punti, spesso utilizzata in architettura per sostenere pesi o come elemento decorativo.",
      "examples": [
        "L'arco della chiesa romanica è stato restaurato con cura.",
        "Il ponte è sorretto da una serie di archi in pietra."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Arma costituita da un'asta flessibile e una corda tesa, usata per scagliare frecce.",
      "examples": [
        "Il cacciatore tese l'arco e mirò alla preda.",
        "Nell'antichità, l'arco era una delle armi più diffuse."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Segmento di curva compreso tra due punti di una circonferenza o di un'altra linea curva.",
      "examples": [
        "L'arco di cerchio disegnato sulla lavagna era perfetto.",
        "Il grafico mostra un arco ascendente nei dati di vendita."
      ],
      "nota": "In geometria, può riferirsi anche a porzioni di altre curve, come parabole o ellissi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di tempo delimitato da due eventi o momenti specifici.",
      "examples": [
        "Nell'arco di una settimana, il progetto fu completato.",
        "L'arco della sua carriera copre oltre trent'anni di attività."
      ],
      "nota": "Spesso usato in contesti temporali per indicare una durata o un intervallo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento musicale a corde sfregato con un archetto, come il violino o il violoncello.",
      "examples": [
        "Il violinista ha rotto l'arco durante il concerto.",
        "Per suonare il contrabbasso serve un arco più lungo."
      ],
      "nota": "In questo senso, si riferisce specificamente all'archetto usato per suonare strumenti a corda."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte del piede compresa tra il tallone e l'attaccatura delle dita.",
      "examples": [
        "Dopo la corsa, sentiva un dolore all'arco del piede.",
        "Le scarpe ortopediche sostengono l'arco plantare."
      ],
      "nota": "In anatomia, è noto anche come *arco plantare*."
    }
  ]
