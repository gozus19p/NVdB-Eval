  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "chiedere informazioni o spiegazioni a qualcuno, spesso in modo formale o per ottenere una risposta precisa",
      "examples": [
        "Mi ha domandato l'ora prima di uscire.",
        "Il professore ha domandato agli studenti se avessero capito la lezione."
      ],
      "nota": "Spesso usato in contesti formali o educativi, può essere sostituito da 'chiedere' in registri più informali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "richiedere qualcosa a qualcuno, spesso con una connotazione di necessità o diritto",
      "examples": [
        "Ha domandato un prestito in banca per comprare la casa.",
        "Il lavoratore ha domandato un aumento di stipendio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "rivolgersi a qualcuno per ottenere una risposta o un'informazione, senza specificare l'oggetto della richiesta",
      "examples": [
        "Se non sai la risposta, domandalo a lui.",
        "Non esitare a domandare se hai bisogno di aiuto."
      ],
      "nota": "In questo uso, il verbo può essere seguito da una proposizione interrogativa indiretta (es. 'Mi ha domandato dove fossi')."
    },
    {
      "pos": "verbo riflessivo (domandarsi)",
      "definition": "porsi una domanda, riflettere su qualcosa senza rivolgersi a un interlocutore esterno",
      "examples": [
        "Mi domando come farò a finire tutto questo lavoro in tempo.",
        "Si domandava se avesse preso la decisione giusta."
      ],
      "nota": "Spesso usato per esprimere dubbi o incertezze personali."
    }
  ]
