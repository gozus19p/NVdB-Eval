    {
      "pos": "aggettivo",
      "definition": "Di colore simile a quello della neve o del latte, privo di tonalità scure o cromatiche.",
      "examples": [
        "Ha comprato una camicia bianca per il matrimonio.",
        "La parete della cucina è stata dipinta di bianco."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, riferito al colore della pelle chiara, tipico delle popolazioni europee o di altre aree geografiche.",
      "examples": [
        "Il protagonista del film è un uomo bianco di mezza età.",
        "La comunità bianca del quartiere ha organizzato una festa di beneficenza."
      ],
      "nota": "Può assumere connotazioni sociali o culturali a seconda del contesto."
    },
    {
      "pos": "aggettivo",
      "definition": "Che non contiene nulla di scritto o stampato; vuoto.",
      "examples": [
        "Mi ha consegnato un foglio bianco senza alcuna spiegazione.",
        "La pagina del diario era rimasta bianca per giorni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di vino, prodotto con uve a bacca chiara e dal colore giallo paglierino o dorato.",
      "examples": [
        "Preferisco il vino bianco al rosso durante l'estate.",
        "Abbiamo ordinato una bottiglia di bianco frizzante."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che manca di dettagli, precisione o contenuto; vago o generico.",
      "examples": [
        "La sua risposta è stata piuttosto bianca, non ha chiarito nulla.",
        "Il discorso del politico è stato un po' troppo bianco per i miei gusti."
      ],
      "nota": "Spesso usato in contesti figurati per indicare mancanza di sostanza."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di elettrodomestici o dispositivi, appartenenti alla categoria dei grandi apparecchi per la casa, come frigoriferi o lavatrici.",
      "examples": [
        "Il negozio offre sconti su tutta la linea di elettrodomestici bianchi.",
        "Abbiamo rinnovato la cucina con nuovi elettrodomestici bianchi."
      ],
      "nota": "Il termine deriva dal colore tradizionale di questi apparecchi, anche se oggi sono disponibili in varie tonalità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il colore simile a quello della neve o del latte, privo di tonalità scure o cromatiche.",
      "examples": [
        "Il bianco è il colore dominante nella sua ultima collezione di moda.",
        "Per dipingere il cielo ha usato una sfumatura di bianco e azzurro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte chiara dell'uovo, separata dal tuorlo.",
      "examples": [
        "Per questa ricetta serve solo il bianco dell'uovo.",
        "Monta i bianchi a neve con un pizzico di sale."
      ],
      "nota": "In cucina, viene spesso utilizzato per preparazioni che richiedono leggerezza o montatura."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio vuoto o non compilato in un documento o modulo.",
      "examples": [
        "Lascia in bianco la parte relativa al codice fiscale se non lo conosci.",
        "Ha consegnato il compito con molti bianchi perché non sapeva le risposte."
