  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "giungere al completamento o alla conclusione di un processo, un'attività o un periodo di tempo",
      "examples": [
        "La riunione è terminata alle sei.",
        "Il film termina con un colpo di scena inaspettato."
