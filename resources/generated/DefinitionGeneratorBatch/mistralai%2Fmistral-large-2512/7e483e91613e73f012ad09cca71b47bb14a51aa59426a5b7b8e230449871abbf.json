    {
      "pos": "verbo transitivo",
      "definition": "portare a compimento un'attività, un lavoro o un progetto",
      "examples": [
        "Ha terminato il rapporto di lavoro dopo dieci anni.",
        "Dobbiamo terminare questo progetto entro la fine del mese."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale (terminarsi)",
      "definition": "concludersi in un certo modo o con determinate caratteristiche",
      "examples": [
        "La strada si termina in una piazza.",
        "Il discorso si è terminato con un applauso."
      ],
      "nota": "Spesso usato per descrivere lo sviluppo naturale o la conclusione di qualcosa, soprattutto in contesti spaziali o temporali."
    }
