  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha una temperatura elevata, superiore a quella considerata normale o confortevole per il corpo umano.",
      "examples": [
        "Dopo la corsa, la maglietta era bagnata e calda.",
        "In estate, l'asfalto diventa così caldo che scotta i piedi nudi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che provoca una sensazione di benessere fisico legata a una temperatura gradevole, né troppo alta né troppo bassa.",
      "examples": [
        "Dopo il freddo della montagna, il tepore del camino era caldo e accogliente.",
        "Si è avvolto nella coperta calda e si è addormentato subito."
      ],
      "nota": "Spesso usato in contrapposizione a 'freddo' per indicare comfort termico."
    },
    {
      "pos": "aggettivo",
      "definition": "Che esprime affetto, entusiasmo o partecipazione emotiva intensa.",
      "examples": [
        "Ha ricevuto un abbraccio caldo dai suoi amici dopo la vittoria.",
        "Il pubblico ha tributato un applauso caldo all'attore al termine dello spettacolo."
      ],
      "nota": "Uso figurato, spesso riferito a manifestazioni di affetto o approvazione."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha colori intensi e vivaci, tipicamente associati a sensazioni di calore.",
      "examples": [
        "Ha scelto una tonalità calda di rosso per dipingere il tramonto.",
        "I colori caldi della tavolozza davano un senso di energia al quadro."
      ],
      "nota": "Uso specifico nel linguaggio artistico e della moda."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione di temperatura elevata, superiore a quella considerata normale o confortevole.",
      "examples": [
        "Con questo caldo, è meglio rimanere all'ombra e bere molta acqua.",
        "Il caldo afoso di agosto rende difficile dormire la notte."
      ],
      "nota": "Spesso usato in espressioni come 'fare caldo' o 'soffrire il caldo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione di benessere fisico o emotivo legata a una situazione piacevole o accogliente.",
      "examples": [
        "Dopo anni di lontananza, il caldo della famiglia lo ha fatto sentire a casa.",
        "La stanza era piena del caldo delle risate e delle chiacchiere tra amici."
      ],
      "nota": "Uso figurato, spesso associato a sentimenti di affetto o intimità."
    },
    {
      "pos": "avverbio",
      "definition": "In modo affettuoso, entusiasta o con partecipazione emotiva intensa.",
      "examples": [
        "Mi ha salutato caldo, come se non ci vedessimo da anni.",
        "Il sindaco ha ringraziato caldo i volontari per il loro impegno."
      ],
      "nota": "Uso invariabile, spesso in combinazione con verbi come 'salutare', 'ringraziare', 'accogliere'."
    }
  ]
