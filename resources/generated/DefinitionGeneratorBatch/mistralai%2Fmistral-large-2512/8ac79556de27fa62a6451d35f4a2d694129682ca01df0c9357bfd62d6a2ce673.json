  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Capacità di determinare consapevolmente le proprie azioni e decisioni, spesso superando ostacoli o resistenze interne ed esterne.",
      "examples": [
        "Ha dimostrato una grande volontà nel superare la malattia.",
        "Per imparare una lingua straniera serve costanza e volontà."
      ],
      "nota": "Spesso usato in contesti che implicano sforzo, perseveranza o autodisciplina. Può essere associato a sinonimi come 'determinazione' o 'fermezza'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Desiderio o intenzione espressa da una persona riguardo a qualcosa che la riguarda direttamente.",
      "examples": [
        "Rispetterò la tua volontà e non insisterò oltre.",
        "Ha lasciato scritto nel testamento di rispettare le sue ultime volontà."
      ],
      "nota": "In questo senso, spesso usato in contesti formali o legali, come testamenti o decisioni personali importanti."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Disposizione interiore favorevole o propensione verso qualcosa o qualcuno.",
      "examples": [
        "Ha una volontà di ferro quando si tratta di aiutare gli altri.",
        "La sua buona volontà è evidente, anche se a volte sbaglia."
      ],
      "nota": "Può indicare un atteggiamento positivo o una predisposizione benevola, spesso in contrasto con azioni concrete."
    },
    {
      "pos": "sostantivo f. (plurale)",
      "definition": "Desideri o preferenze collettive espresse da un gruppo o da una comunità.",
      "examples": [
        "Le volontà del popolo sono state finalmente ascoltate.",
        "Il governo deve tener conto delle volontà dei cittadini."
      ],
      "nota": "Usato soprattutto al plurale in contesti politici o sociali per indicare le aspirazioni di una collettività."
    }
  ]
