  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "La parte opposta alla sinistra, in riferimento a un punto di osservazione o a un orientamento spaziale.",
      "examples": [
        "Tieni la destra mentre guidi.",
        "Il negozio si trova alla tua destra, subito dopo il semaforo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel linguaggio politico, l'insieme delle forze, dei partiti o delle ideologie che si collocano in una posizione conservatrice, liberista o reazionaria, in contrapposizione alla sinistra.",
      "examples": [
        "La destra ha vinto le elezioni con una maggioranza risicata.",
        "Alcuni esponenti della destra hanno criticato duramente la nuova legge."
      ],
      "nota": "In questo senso, il termine può essere usato anche come aggettivo (es. 'governo di destra')."
    },
    {
      "pos": "aggettivo (invariabile)",
      "definition": "Che si trova o si muove verso la parte opposta alla sinistra, rispetto a un punto di riferimento.",
      "examples": [
        "Prendi la prima strada a destra dopo il ponte.",
        "Il braccio destro del presidente è stato coinvolto in uno scandalo."
      ],
      "nota": "Può essere usato anche in senso figurato per indicare qualcosa o qualcuno di fidato o di primaria importanza (es. 'il mio braccio destro')."
    },
    {
      "pos": "aggettivo (invariabile)",
      "definition": "Relativo o appartenente alla destra politica.",
      "examples": [
        "Il partito ha adottato una linea politica di destra.",
        "Le politiche di destra sono state criticate per la loro rigidità."
      ],
      "nota": null
    }
  ]
