  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Intervallo di tempo compreso tra l'alba e il tramonto, durante il quale c'è luce naturale.",
      "examples": [
        "Oggi il giorno è stato particolarmente lungo a causa del lavoro.",
        "Durante il giorno preferisco stare all'aperto piuttosto che al chiuso."
      ],
      "nota": "Può essere contrapposto a 'notte' per indicare la parte luminosa della giornata."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Unità di tempo della durata di 24 ore, che inizia e finisce a mezzanotte.",
      "examples": [
        "Mancano tre giorni alla partenza per le vacanze.",
        "Ho impiegato cinque giorni per finire il progetto."
      ],
      "nota": "Spesso usato per contare il tempo in modo sequenziale (es. 'giorno 1', 'giorno 2')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di tempo caratterizzato da particolari condizioni o eventi.",
      "examples": [
        "Quello fu il giorno più felice della mia vita.",
        "Ricordo ancora il giorno in cui ho conosciuto mia moglie."
      ],
      "nota": "Può assumere un valore affettivo o simbolico, riferendosi a momenti significativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Momento o epoca attuale, in contrapposizione al passato o al futuro.",
      "examples": [
        "Oggi il giorno la tecnologia ci permette di fare cose impensabili.",
        "Nei giorni nostri, la comunicazione è diventata istantanea."
      ],
      "nota": "Spesso usato in espressioni come 'al giorno d'oggi' o 'nei giorni nostri'."
    }
