    },
    {
      "pos": "verbo transitivo",
      "definition": "Accogliere o adottare un'idea, una causa, una fede o uno stile di vita.",
      "examples": [
        "Ha abbracciato la filosofia buddista dopo un lungo viaggio in Asia.",
        "Molti giovani abbracciano oggi uno stile di vita più sostenibile."
      ],
      "nota": "Spesso usato in contesti figurati per indicare l'adesione convinta a qualcosa di astratto."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Comprendere o includere un insieme di elementi o concetti.",
      "examples": [
        "Questo corso abbraccia argomenti che vanno dalla storia all'economia.",
        "La nuova legge abbraccia diverse categorie di lavoratori."
      ],
      "nota": "Usato in contesti formali o tecnici per indicare l'estensione di un ambito."
    },
    {
      "pos": "verbo intransitivo pronominale (abbracciarsi)",
      "definition": "Cingersi reciprocamente con le braccia in segno di affetto o saluto.",
      "examples": [
        "Si abbracciarono commossi al termine della cerimonia.",
        "Gli amici si abbracciarono prima di separarsi."
      ],
      "nota": null
