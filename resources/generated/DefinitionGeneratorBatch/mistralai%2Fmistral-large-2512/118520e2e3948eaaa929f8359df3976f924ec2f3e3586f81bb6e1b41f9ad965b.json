  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Cingere qualcuno con le braccia in segno di affetto, saluto o conforto.",
      "examples": [
        "Abbracciò il figlio prima di partire per il viaggio.",
        "Si abbracciarono a lungo dopo tanti anni di lontananza."
      ],
