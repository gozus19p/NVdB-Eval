  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre con la voce suoni melodici e ritmati, spesso seguendo una melodia o un testo musicale.",
      "examples": [
        "Durante la festa, tutti hanno iniziato a cantare insieme.",
        "Le cicale cantano forte nelle giornate estive."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un brano musicale con la voce.",
      "examples": [
        "Ha cantato una canzone d'amore al suo matrimonio.",
        "Il coro canterà tre brani durante la cerimonia."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (figurato)",
      "definition": "Rivelare informazioni segrete o compromettenti, spesso sotto pressione.",
      "examples": [
        "Dopo l'interrogatorio, il sospettato ha iniziato a cantare.",
        "Se continui a minacciarlo, finirà per cantare tutto."
      ],
      "nota": "Uso colloquiale, spesso associato a contesti di indagini o confessioni forzate."
    },
    {
      "pos": "verbo intransitivo (estensione)",
      "definition": "Produrre suoni melodiosi, riferito ad animali o oggetti.",
      "examples": [
        "Gli uccelli cantano all'alba.",
        "Il bollitore canta quando l'acqua è pronta."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo (regionale o gergale)",
      "definition": "Denunciare qualcuno alle autorità, spesso in contesti criminali.",
      "examples": [
        "Se scoprono che li hai cantati, sarai nei guai.",
        "Ha cantato i suoi complici per ottenere uno sconto di pena."
      ],
      "nota": "Uso gergale, diffuso in contesti informali o criminali."
    }
  ]
