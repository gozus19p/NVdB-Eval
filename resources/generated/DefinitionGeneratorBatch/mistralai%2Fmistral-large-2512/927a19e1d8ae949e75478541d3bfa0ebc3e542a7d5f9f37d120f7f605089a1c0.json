  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "muoversi di un liquido o di un fluido in modo continuo e uniforme lungo un percorso o una superficie",
      "examples": [
        "L'acqua scorreva lentamente nel ruscello.",
        "Dopo la pioggia, l'acqua scorreva lungo i marciapiedi."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "passare in modo continuo e regolare, detto di tempo o di eventi",
      "examples": [
        "Gli anni sono scorsi senza che me ne accorgessi.",
        "La riunione è scorsa senza intoppi."
      ],
      "nota": "Spesso usato in contesti temporali o per descrivere lo svolgimento di attività."
    },
    {
      "pos": "verbo transitivo",
      "definition": "leggere o esaminare rapidamente un testo senza soffermarsi sui dettagli",
      "examples": [
        "Ho scorso velocemente il giornale prima di uscire.",
        "Scorse l'elenco dei nomi per trovare il suo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "muoversi rapidamente lungo una superficie o un percorso, detto di oggetti o persone",
      "examples": [
        "Il treno scorreva veloce sui binari.",
        "Le auto scorrono fluide sull'autostrada."
      ],
      "nota": "Può riferirsi anche a movimenti rapidi e continui di persone o veicoli."
    },
    {
      "pos": "verbo transitivo",
      "definition": "far muovere un oggetto lungo una superficie o un percorso con un movimento continuo",
      "examples": [
        "Scorse le dita sulla tastiera del pianoforte.",
        "Scorse la mano sul legno per controllare che fosse liscio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "detto di un corso d'acqua, fluire con una certa velocità o in una certa direzione",
      "examples": [
        "Il fiume scorre verso il mare.",
        "Dopo la diga, l'acqua scorre con più forza."
      ],
      "nota": "Spesso usato in contesti geografici o idrologici."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere) (figurato)",
      "definition": "procedere senza intoppi o difficoltà, detto di attività o situazioni",
      "examples": [
        "La serata è scorsa piacevolmente tra amici.",
        "Il progetto è scorso senza problemi."
      ],
      "nota": "Uso figurato per indicare lo svolgimento fluido di eventi o attività."
    }
  ]
