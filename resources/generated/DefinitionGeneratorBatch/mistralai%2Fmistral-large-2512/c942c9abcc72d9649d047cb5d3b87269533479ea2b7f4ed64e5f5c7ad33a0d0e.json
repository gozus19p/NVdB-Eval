  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Prova o serie di prove volte a verificare le conoscenze, le competenze o le condizioni di qualcuno in un determinato ambito.",
      "examples": [
        "Domani ho l'esame di matematica, spero di passarlo.",
        "Per ottenere la patente devi superare un esame teorico e uno pratico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Valutazione accurata e sistematica di una situazione, di un oggetto o di una persona per trarne conclusioni o decisioni.",
      "examples": [
        "Il medico ha prescritto un esame del sangue per capire la causa della stanchezza.",
        "Prima di acquistare la casa, abbiamo fatto un esame approfondito delle condizioni strutturali."
      ],
      "nota": "Spesso usato in contesti medici, tecnici o legali."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Analisi critica o riflessione su un argomento, un testo o un'esperienza.",
      "examples": [
        "Nel suo saggio, l'autore fa un esame dettagliato delle cause della crisi economica.",
        "Dopo l'incidente, ho fatto un esame di coscienza per capire dove ho sbagliato."
      ],
      "nota": "Può riferirsi anche a una riflessione interiore, come in 'esame di coscienza'."
    }
  ]
