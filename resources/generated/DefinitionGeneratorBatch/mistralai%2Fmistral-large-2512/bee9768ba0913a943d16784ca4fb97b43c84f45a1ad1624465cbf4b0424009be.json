  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "giungere al termine di un processo, di un periodo di tempo o di un'attività",
      "examples": [
        "La lezione finisce alle tre.",
        "Il film è finito con un colpo di scena."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "esaurirsi, terminare in un certo modo o luogo",
      "examples": [
        "La strada finisce in una piazza.",
        "Il suo discorso è finito con una battuta."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo (ausiliare avere)",
      "definition": "portare a compimento un'attività o un'azione",
      "examples": [
        "Ho finito i compiti prima di cena.",
        "Devi finire quel progetto entro domani."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "morire, spesso usato in contesti informali o eufemistici",
      "examples": [
        "Il nonno è finito serenamente nel sonno.",
        "Dopo l'incidente, si temeva che non ce l'avrebbe fatta, ma per fortuna è sopravvissuto."
      ],
      "nota": "Uso prevalentemente colloquiale o eufemistico."
    },
    {
      "pos": "verbo intransitivo pronominale (finirsi, ausiliare essere)",
      "definition": "consumarsi completamente, esaurirsi",
      "examples": [
        "Le scorte di cibo si sono finite in pochi giorni.",
        "I soldi si sono finiti prima della fine del mese."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "raggiungere un certo stato o condizione come risultato finale",
      "examples": [
        "Dopo tanti sforzi, è finito in prigione.",
        "Il progetto è finito male per mancanza di fondi."
      ],
      "nota": "Spesso usato per esprimere un esito negativo o non desiderato."
    },
    {
      "pos": "verbo transitivo (ausiliare avere)",
      "definition": "consumare completamente qualcosa, spesso cibo o bevande",
      "examples": [
        "Ho finito la bottiglia di vino durante la cena.",
        "Finisci la minestra, altrimenti non ti alzi da tavola."
      ],
      "nota": "Comune in contesti informali, soprattutto riferito a cibi o bevande."
    }
  ]
