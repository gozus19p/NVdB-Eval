  "senses": [
    {
      "pos": "sostantivo m. inv.",
      "definition": "Il numero naturale che segue il quarantanove e precede il cinquantuno, rappresentato nella numerazione araba con 50 e in quella romana con L.",
      "examples": [
        "Il biglietto della lotteria con il cinquanta ha vinto il primo premio.",
        "Ho comprato un mazzo di cinquanta carte da gioco."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale cardinale inv.",
      "definition": "Che indica una quantità pari a cinque decine.",
      "examples": [
        "Ho invitato cinquanta persone alla festa di compleanno.",
        "Il libro ha cinquanta pagine e molte illustrazioni."
      ],
      "nota": "Può essere usato anche in senso approssimativo per indicare una quantità grande ma non precisata, soprattutto in contesti informali (es. 'Ho aspettato cinquanta minuti')."
    },
    {
      "pos": "sostantivo m. inv.",
      "definition": "Anno che fa parte del decennio compreso tra il cinquantesimo e il cinquantanovesimo di un secolo.",
      "examples": [
        "Mio nonno è nato nel cinquanta e ha vissuto tutti i cambiamenti del dopoguerra.",
        "Il cinquanta è stato un anno di grandi trasformazioni sociali."
      ],
      "nota": "Spesso usato in riferimento al Novecento, soprattutto nella locuzione 'gli anni Cinquanta'."
    },
    {
      "pos": "sostantivo m. inv.",
      "definition": "Taglio di banconota o moneta del valore corrispondente al numero indicato.",
      "examples": [
        "Ho pagato con un cinquanta perché non avevo spiccioli.",
        "Mi ha restituito il prestito con due cinquanta."
      ],
      "nota": "In Italia, si riferisce comunemente alla banconota da 50 euro o, in contesti storici, a quella da 50.000 lire."
    }
  ]
