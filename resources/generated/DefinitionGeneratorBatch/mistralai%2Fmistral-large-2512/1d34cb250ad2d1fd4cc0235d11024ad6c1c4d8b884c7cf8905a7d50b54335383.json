  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova a breve distanza nello spazio o nel tempo rispetto a un punto di riferimento.",
      "examples": [
        "La farmacia è vicina a casa mia.",
        "L'estate è vicina, si sente già il caldo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha una relazione di parentela o affinità stretta con qualcuno.",
      "examples": [
        "È un mio parente vicino, un cugino di primo grado.",
        "Non sapevo che fossero così vicini di sangue."
      ],
      "nota": "Usato soprattutto in contesti familiari o genealogici."
    },
    {
      "pos": "aggettivo",
      "definition": "Che condivide idee, opinioni o caratteristiche simili a quelle di un altro.",
      "examples": [
        "Le loro posizioni politiche sono molto vicine.",
        "Questo vino è vicino al gusto che cercavo."
      ],
      "nota": "Spesso usato in contesti astratti o comparativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che abita o lavora nelle immediate prossimità di un altro.",
      "examples": [
        "Il mio vicino di casa ha un cane molto rumoroso.",
        "Durante il viaggio, ho chiacchierato con il vicino di posto."
      ],
      "nota": "Può riferirsi anche a chi occupa una posizione adiacente in contesti come mezzi di trasporto o aule."
    },
    {
      "pos": "avverbio",
      "definition": "A breve distanza nello spazio o nel tempo.",
      "examples": [
        "Abito vicino, possiamo andarci a piedi.",
        "Il concerto inizierà vicino alle nove."
      ],
      "nota": "Spesso usato in combinazione con preposizioni come 'a' o 'da'."
    }
  ]
