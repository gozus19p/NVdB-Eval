      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Allontanare qualcuno o qualcosa con forza o in modo brusco, spesso per liberarsene.",
      "examples": [
        "Ho dovuto cacciare il gatto dal divano perché continuava a graffiarlo.",
        "Il proprietario ha cacciato gli inquilini morosi senza preavviso."
      ],
      "nota": "Può avere una connotazione negativa, implicando mancanza di rispetto o violenza."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inserire o spingere qualcosa in un luogo stretto o con forza.",
      "examples": [
        "Ha cacciato le mani in tasca per scaldarle.",
        "Caccia il libro nello zaino, dobbiamo andare!"
      ],
      "nota": "Spesso usato in contesti informali o colloquiali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Emettere un suono forte e improvviso, spesso riferito a strumenti musicali o animali.",
      "examples": [
        "Il trombettista ha cacciato una nota stonata durante il concerto.",
        "L'asino ha cacciato un raglio che si è sentito fino in paese."
      ],
      "nota": "Uso meno comune, tipico di registri informali o regionali."
    },
    {
      "pos": "verbo riflessivo (cacciarsi)",
      "definition": "Mettersi in una situazione difficile o scomoda, spesso per propria responsabilità.",
      "examples": [
        "Si è cacciato nei guai dopo aver mentito al suo capo.",
        "Non ti cacciare in una situazione da cui non puoi uscire."
      ],
      "nota": "Frequentemente usato in espressioni come 'cacciarsi nei guai'."
