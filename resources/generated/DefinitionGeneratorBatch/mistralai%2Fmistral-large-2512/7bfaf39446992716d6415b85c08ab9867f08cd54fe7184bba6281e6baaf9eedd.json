  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Veicolo più pesante dell'aria, dotato di ali e motori, capace di volare trasportando persone o merci.",
      "examples": [
        "L'aereo per New York decollerà con un'ora di ritardo.",
        "Hanno noleggiato un aereo privato per raggiungere la località di vacanza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Linea o servizio di trasporto che utilizza velivoli per collegare località distanti.",
      "examples": [
        "Preferisco viaggiare in aereo piuttosto che in treno per risparmiare tempo.",
        "La compagnia aerea ha cancellato tutti i voli a causa dello sciopero dei piloti."
      ],
      "nota": "In questo senso, spesso usato al plurale o in locuzioni come 'compagnia aerea'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si trova o avviene nell'aria o nello spazio sopra la superficie terrestre.",
      "examples": [
        "Il ponte aereo ha permesso di rifornire la zona colpita dall'alluvione.",
        "La corrente aerea ha spinto il palloncino fino al parco vicino."
      ],
      "nota": "Può essere usato anche in senso figurato, come in 'minaccia aerea'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda il trasporto o il traffico effettuato tramite velivoli.",
      "examples": [
        "Il terminal aereo è stato ampliato per accogliere più passeggeri.",
        "Il governo ha stanziato fondi per lo sviluppo del trasporto aereo regionale."
      ],
      "nota": null
    }
  ]
