  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Individuo di sesso femminile appartenente a una specie animale, compresa quella umana.",
      "examples": [
        "Nel branco di leoni, le femmine sono le principali cacciatrici.",
        "Hanno avuto una bambina, è una femmina bellissima."
      ],
      "nota": "Può riferirsi sia a esseri umani che ad animali, ma nel caso umano è spesso sostituito da termini più specifici come 'donna' o 'bambina' per evitare connotazioni spregiative o troppo generiche."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In botanica, pianta o fiore che produce frutti o semi.",
      "examples": [
        "Per ottenere i kiwi, è necessario piantare sia il maschio che la femmina.",
        "Questo albero di nocciolo è una femmina e produce molte nocciole ogni anno."
      ],
      "nota": "Termine tecnico usato in agricoltura e botanica, spesso in contrapposizione a 'maschio' per piante dioiche."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Componente o elemento di un oggetto o meccanismo progettato per accogliere o incastrarsi con una parte corrispondente di forma complementare.",
      "examples": [
        "Questa vite non entra perché hai preso la femmina invece del maschio.",
        "La presa elettrica di tipo F ha due fori femmina e un contatto di terra."
      ],
      "nota": "Uso tecnico comune in meccanica, elettronica e idraulica, spesso in contrapposizione a 'maschio'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene o è relativo al sesso femminile.",
      "examples": [
        "Il gatto femmina che abbiamo adottato è molto affettuoso.",
        "Questo fiore è femmina, non produrrà polline."
      ],
      "nota": "Può essere usato sia per esseri viventi che per oggetti con caratteristiche di genere attribuite (es. connettori, piante)."
    }
  ]
