  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che si trova a una grande distanza nello spazio o nel tempo rispetto a un punto di riferimento.",
      "examples": [
        "La montagna più lontana si vede appena all'orizzonte.",
        "Il suo compleanno è ancora lontano, mancano tre mesi."
      ],
      "nota": "Può riferirsi sia a distanze fisiche che temporali. Spesso usato in contrapposizione a 'vicino'."
    },
    {
      "pos": "aggettivo",
      "definition": "che ha scarsa somiglianza o relazione con qualcosa o qualcuno.",
      "examples": [
        "Questa teoria è molto lontana dalla realtà dei fatti.",
        "Il suo modo di pensare è lontano dal mio."
      ],
      "nota": "Uso figurato per indicare divergenza concettuale o ideologica."
    },
    {
      "pos": "avverbio",
      "definition": "a una grande distanza nello spazio o nel tempo.",
      "examples": [
        "Abita lontano dal centro città.",
        "Quel ricordo è ormai lontano nel tempo."
      ],
      "nota": "Può essere usato con verbi di movimento o stato per indicare distanza."
    },
    {
      "pos": "avverbio",
      "definition": "in modo non attinente o poco pertinente a un determinato contesto.",
      "examples": [
        "Hai parlato lontano dall'argomento della discussione.",
        "Le sue osservazioni sono andate lontano dalla questione principale."
      ],
      "nota": "Uso figurato per indicare mancanza di pertinenza."
    }
  ]
