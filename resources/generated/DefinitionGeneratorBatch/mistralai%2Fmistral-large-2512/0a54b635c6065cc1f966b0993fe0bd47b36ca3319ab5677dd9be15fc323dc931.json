  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Miscuglio gassoso che costituisce l'atmosfera terrestre, indispensabile per la respirazione degli esseri viventi.",
      "examples": [
        "L'aria di montagna è più pulita di quella di città.",
        "Dopo la pioggia, si respira un'aria fresca e profumata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Spazio atmosferico sopra la superficie terrestre, in cui si muovono gli uccelli e gli aerei.",
      "examples": [
        "L'aereo decollò e scomparve tra le nuvole nell'aria.",
        "Gli uccelli volavano leggeri nell'aria primaverile."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Aspetto esteriore o atteggiamento di una persona, spesso con riferimento a impressioni o sensazioni che suscita.",
      "examples": [
        "Quel ragazzo ha un'aria da intellettuale, anche se non lo è.",
        "Non mi piace l'aria che tira in ufficio ultimamente."
      ],
      "nota": "Spesso usato in espressioni come 'dare aria' (mostrare un certo atteggiamento) o 'avere un'aria' (sembrare in un certo modo)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Melodia o motivo musicale, spesso di breve durata e di carattere espressivo.",
      "examples": [
        "Il tenore eseguì un'aria celebre dell'opera verdiana.",
        "Quell'aria mi è rimasta in testa per tutto il giorno."
      ],
      "nota": "Termine usato soprattutto in ambito musicale, in particolare nell'opera lirica."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Corrente d'aria, spesso percepita come leggera brezza.",
      "examples": [
        "Chiudi la finestra, c'è un'aria che mi fa venire mal di testa.",
        "Una leggera aria marina rinfrescava la serata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Atmosfera o clima che si percepisce in un ambiente, spesso in senso figurato.",
      "examples": [
        "C'era un'aria di festa durante la cerimonia di laurea.",
        "In quella casa si respirava un'aria di tristezza."
      ],
      "nota": "Può riferirsi a situazioni sociali, emotive o psicologiche."
    }
  ]
