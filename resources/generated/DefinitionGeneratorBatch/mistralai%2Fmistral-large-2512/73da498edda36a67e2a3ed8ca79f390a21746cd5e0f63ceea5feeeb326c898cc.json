  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che manca di bellezza o armonia estetica, sgradevole alla vista.",
      "examples": [
        "Quel quadro è davvero brutto, non mi piace per niente.",
        "Ha comprato un vestito brutto, con colori troppo accesi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di cattiva qualità o scadente in termini di funzionalità o risultato.",
      "examples": [
        "Ho fatto un brutto lavoro e devo rifarlo.",
        "È stato un brutto film, noioso e poco originale."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che suscita disagio, paura o preoccupazione per la sua gravità o pericolosità.",
      "examples": [
        "Si è trovato in una brutta situazione economica.",
        "Hanno avuto un brutto incidente stradale."
      ],
      "nota": "Spesso usato in contesti che implicano rischio, pericolo o conseguenze negative."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si comporta in modo moralmente riprovevole o sleale.",
      "examples": [
        "È stato un brutto gesto tradire la sua fiducia.",
        "Non mi aspettavo un comportamento così brutto da parte sua."
      ],
      "nota": "Usato per descrivere azioni o atteggiamenti negativi dal punto di vista etico."
    },
    {
      "pos": "aggettivo",
      "definition": "Che indica condizioni atmosferiche avverse o spiacevoli.",
      "examples": [
        "Domani è prevista una brutta giornata di pioggia.",
        "Con questo brutto tempo non ho voglia di uscire."
      ],
      "nota": "Comune in espressioni relative al meteo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che è sgradevole o negativo, spesso in contrapposizione a ciò che è bello o positivo.",
      "examples": [
        "Nel film c'è una lotta tra il bello e il brutto.",
        "Non bisogna fermarsi alle apparenze, il brutto può nascondere qualcosa di buono."
      ],
      "nota": "Usato in contesti filosofici, artistici o metaforici per indicare il lato negativo o sgradevole della realtà."
    },
    {
      "pos": "avverbio",
      "definition": "In modo sgradevole o spiacevole, spesso usato in espressioni idiomatiche.",
      "examples": [
        "Mi ha trattato proprio brutto, senza alcun rispetto.",
        "Ha combinato tutto brutto, rovinando la festa."
      ],
      "nota": "Forma colloquiale e informale, spesso usata in frasi esclamative o per enfatizzare una valutazione negativa."
    }
  ]
