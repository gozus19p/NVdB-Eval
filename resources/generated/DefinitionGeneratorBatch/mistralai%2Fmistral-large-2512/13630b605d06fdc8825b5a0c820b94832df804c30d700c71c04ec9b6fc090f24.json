  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che dimostra abilità, competenza o capacità in un determinato ambito.",
      "examples": [
        "È un cuoco molto bravo, i suoi piatti sono sempre deliziosi.",
        "Mio figlio è bravo a scuola, prende sempre voti alti."
      ],
      "nota": "Può riferirsi a persone, animali o, per estensione, a oggetti o strumenti che funzionano particolarmente bene. Spesso usato in contesti informali."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si comporta in modo corretto, educato o rispettoso delle regole.",
      "examples": [
        "I bambini sono stati bravi durante tutta la cerimonia.",
        "Se sei bravo, ti porto al parco domani."
      ],
      "nota": "Frequente nell'uso con i bambini, ma applicabile anche ad adulti in contesti di comportamento sociale."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha coraggio o determinazione, spesso in situazioni difficili o pericolose.",
      "examples": [
        "È stato molto bravo a difendere le sue idee durante la riunione.",
        "I pompieri sono stati bravi a domare l'incendio in poco tempo."
      ],
      "nota": "In questo senso, può sovrapporsi parzialmente al concetto di 'coraggioso', ma con una sfumatura di abilità o efficacia nell'agire."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona abile o esperta in un determinato mestiere o attività, spesso usato in ambito artistico o artigianale.",
      "examples": [
        "Quel liutaio è un vero bravo, i suoi strumenti sono ricercatissimi.",
        "Nella bottega lavorano solo bravi del settore."
      ],
      "nota": "Uso meno comune rispetto all'aggettivo, spesso connotato positivamente in contesti professionali o artigianali."
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione usata per esprimere approvazione, ammirazione o incitamento.",
      "examples": [
        "Bravo! Hai risolto il problema in modo brillante.",
        "Bravo, continua così, stai facendo un ottimo lavoro."
      ],
      "nota": "Spesso usato in contesti performativi (teatro, concerti, competizioni) o per lodare qualcuno. Al plurale diventa 'bravi' o 'brave' a seconda del genere del referente."
    }
  ]
