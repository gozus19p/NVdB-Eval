  },
  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che è subordinato a qualcosa o qualcuno, o che non può esistere o funzionare autonomamente",
      "examples": [
        "Il suo umore è dipendente dalle condizioni meteorologiche.",
        "Questo progetto è dipendente dall'approvazione del consiglio di amministrazione."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che ha una relazione di causa-effetto con un fattore esterno, spesso usato in contesti medici o psicologici",
      "examples": [
        "È dipendente dall'alcol da diversi anni.",
        "Molti giovani sono dipendenti dai social media."
      ],
      "nota": "Spesso usato per indicare una condizione di dipendenza patologica, come nel caso di sostanze o comportamenti."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "persona che lavora alle dipendenze di un datore di lavoro, con un contratto di lavoro subordinato",
      "examples": [
        "I dipendenti dell'azienda hanno ricevuto un aumento di stipendio.",
        "Ha presentato le dimissioni dopo vent'anni come dipendente pubblico."
      ],
      "nota": "Può riferirsi sia a lavoratori del settore privato che pubblico."
    }
  ]
