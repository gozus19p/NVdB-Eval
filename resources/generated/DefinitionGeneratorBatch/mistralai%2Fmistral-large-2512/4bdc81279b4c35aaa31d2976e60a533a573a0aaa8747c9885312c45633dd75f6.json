  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "riprendere possesso di qualcosa che era stato perso, smarrito o sottratto",
      "examples": [
        "La polizia è riuscita a recuperare i gioielli rubati.",
        "Ho recuperato il libro che avevo prestato a Marco mesi fa."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "ripristinare o migliorare una condizione fisica, mentale o materiale precedentemente compromessa",
      "examples": [
        "Dopo l'infortunio, ha dovuto recuperare la forza muscolare con la fisioterapia.",
        "L'azienda sta cercando di recuperare i profitti persi durante la crisi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "riutilizzare materiali o risorse per ridurne lo spreco",
      "examples": [
        "È importante recuperare la plastica per proteggere l'ambiente.",
        "Il comune ha avviato una campagna per recuperare i rifiuti elettronici."
      ],
      "nota": "Spesso usato in contesti ecologici o di sostenibilità."
    },
    {
      "pos": "verbo transitivo",
      "definition": "riacquistare tempo o opportunità perduti, spesso in ambito scolastico o lavorativo",
      "examples": [
        "Devo recuperare le lezioni che ho saltato la scorsa settimana.",
        "Ha recuperato il ritardo nel progetto lavorando fino a tardi."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "riprendersi da una condizione negativa, come una malattia o uno stato di affaticamento",
      "examples": [
        "Dopo la febbre, ci è voluto un po' per recuperare completamente.",
        "È riuscito a recuperare dopo il lungo periodo di stress."
      ],
      "nota": "Spesso usato in contesti di salute o benessere."
    },
    {
      "pos": "verbo transitivo",
      "definition": "salvare qualcuno o qualcosa da una situazione di pericolo o difficoltà",
      "examples": [
        "I vigili del fuoco hanno recuperato gli escursionisti bloccati sulla montagna.",
        "Hanno recuperato il cane che era caduto nel fiume."
      ],
      "nota": "Frequente in contesti di soccorso o emergenza."
    }
  ]
