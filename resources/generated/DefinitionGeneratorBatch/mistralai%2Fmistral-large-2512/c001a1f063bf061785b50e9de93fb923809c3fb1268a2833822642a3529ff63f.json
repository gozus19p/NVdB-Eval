  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Stella attorno alla quale orbitano la Terra e altri pianeti del sistema solare, fonte principale di luce e calore per il nostro pianeta.",
      "examples": [
        "Il sole sorge a est e tramonta a ovest.",
        "In estate il sole picchia forte e bisogna proteggersi con la crema solare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Luce o calore prodotti dalla stella del sistema solare, percepiti sulla Terra.",
      "examples": [
        "Dopo giorni di pioggia, finalmente oggi c'è il sole.",
        "Mi piace stendermi al sole per abbronzarmi."
      ],
      "nota": "Spesso usato in espressioni come 'prendere il sole' (esporsi alla luce solare per abbronzarsi) o 'bagno di sole' (esposizione prolungata al sole)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione meteorologica caratterizzata da cielo sereno e assenza di nuvole.",
      "examples": [
        "Domani è previsto sole su tutta la regione.",
        "Con questo sole, è perfetto per una gita al mare."
      ],
      "nota": "In contesti meteorologici, può essere usato in contrasto con 'pioggia', 'nuvoloso' o 'nebbia'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Simbolo di vitalità, gioia o positività, spesso usato in senso figurato.",
      "examples": [
        "Dopo tanti problemi, finalmente è tornato il sole nella sua vita.",
        "La sua risata è come un raggio di sole in una giornata grigia."
      ],
      "nota": "In questa accezione, è spesso associato a metafore legate alla felicità o al miglioramento delle condizioni personali."
    }
  ]
