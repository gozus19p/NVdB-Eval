  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Consegnare una somma di denaro o un bene equivalente come corrispettivo per un servizio, un prodotto o un debito.",
      "examples": [
        "Ho pagato il conto al ristorante prima di uscire.",
        "Devi pagare l'affitto entro la fine del mese."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Scontare una pena o subire le conseguenze negative di un'azione.",
      "examples": [
        "Ha pagato caro il suo errore con anni di prigione.",
        "Se continui così, pagherai per la tua arroganza."
      ],
      "nota": "Uso figurato, spesso associato a conseguenze negative o punizioni."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Essere conveniente o vantaggioso dal punto di vista economico o pratico.",
      "examples": [
        "Non mi paga lavorare così tante ore per così pochi soldi.",
        "Conviene comprare all'ingrosso: paga di più."
      ],
      "nota": "Spesso usato in espressioni come 'non mi paga' o 'paga di più'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Offrire o concedere qualcosa come segno di riconoscimento o gratitudine.",
      "examples": [
        "Voglio pagarti una cena per ringraziarti dell'aiuto.",
        "Ha pagato un brindisi a tutti i presenti per festeggiare."
      ],
      "nota": "Uso esteso a contesti non strettamente economici, spesso con valore simbolico."
    },
    {
      "pos": "verbo riflessivo (pagarsi)",
      "definition": "Procurarsi autonomamente i mezzi necessari per sostenere una spesa o un'attività.",
      "examples": [
        "Si paga gli studi lavorando part-time.",
        "Con quel lavoro riesce a pagarsi le vacanze ogni anno."
      ],
      "nota": null
    }
  ]
