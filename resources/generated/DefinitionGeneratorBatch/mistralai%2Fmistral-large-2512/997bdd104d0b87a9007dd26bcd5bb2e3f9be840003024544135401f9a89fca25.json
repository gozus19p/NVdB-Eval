  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Spostamento di persone o cose da un luogo a un altro mediante mezzi appositi.",
      "examples": [
        "Il trasporto delle merci avviene principalmente su gomma.",
        "Il costo del trasporto è incluso nel prezzo finale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Mezzo o sistema utilizzato per spostare persone o cose.",
      "examples": [
        "I trasporti pubblici sono in sciopero oggi.",
        "Abbiamo noleggiato un furgone per il trasporto dei mobili."
      ],
      "nota": "Spesso usato al plurale per indicare l'insieme dei mezzi di locomozione (es. *trasporti urbani*)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato emotivo intenso, spesso di entusiasmo o commozione.",
      "examples": [
        "Ascoltare quella musica mi ha riempito di trasporto.",
        "Parlava con un trasporto che ha convinto tutti."
      ],
      "nota": "Uso prevalentemente letterario o formale; sinonimo di *slancio affettivo*."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In diritto, trasferimento di un diritto o di un obbligo da una persona a un'altra.",
      "examples": [
        "Il trasporto del credito deve essere annotato nel registro.",
        "Ha effettuato il trasporto della proprietà a nome del figlio."
      ],
      "nota": "Termine tecnico-giuridico; si usa anche in contesti amministrativi (es. *trasporto di titoli*)."
    }
  ]
