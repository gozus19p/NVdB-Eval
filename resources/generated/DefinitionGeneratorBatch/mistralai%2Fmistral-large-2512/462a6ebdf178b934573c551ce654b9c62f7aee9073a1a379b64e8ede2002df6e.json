  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Provare paura o apprensione per qualcosa o qualcuno che si considera pericoloso, minaccioso o dannoso.",
      "examples": [
        "Teme il buio da quando era bambino.",
        "Molti temono le conseguenze di questa decisione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Preoccuparsi per un evento negativo che potrebbe verificarsi.",
      "examples": [
        "Temo che non arriveremo in tempo per il treno.",
        "Temeva che la sua squadra perdesse la partita."
      ],
      "nota": "Spesso seguito da una proposizione subordinata introdotta da 'che'."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Avere timore o rispetto reverenziale nei confronti di qualcosa o qualcuno.",
      "examples": [
        "Teme per la propria incolumità dopo l'incidente.",
        "Temiamo per la salute di nostro padre."
      ],
      "nota": "In questo uso, spesso seguito dalla preposizione 'per' per indicare l'oggetto della preoccupazione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ritenere probabile o possibile un evento negativo, senza necessariamente provare paura.",
      "examples": [
        "Temo che pioverà domani, meglio portare l'ombrello.",
        "Temevo che avresti reagito così."
      ],
      "nota": "In questo caso, il verbo esprime una previsione negativa, spesso con una sfumatura di rammarico."
    }
  ]
