  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Gruppo organizzato di persone che si uniscono per perseguire uno scopo comune, spesso di natura sociale, culturale, sportiva o politica.",
      "examples": [
        "Ha fondato un'associazione per la tutela dell'ambiente.",
        "L'associazione culturale organizza incontri letterari ogni mese."
      ],
      "nota": "Può riferirsi sia a entità formali (con statuto e riconoscimento legale) sia a gruppi informali. Spesso usato come sinonimo di 'circolo' o 'sodalizio'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Relazione tra elementi o concetti che si presentano insieme o vengono collegati mentalmente.",
      "examples": [
        "C'è una forte associazione tra fumo e malattie polmonari.",
        "Il bambino ha fatto un'associazione tra il suono della campanella e la fine della lezione."
      ],
      "nota": "In psicologia e linguistica, indica il legame mentale tra idee o stimoli. In statistica, può denotare una correlazione tra variabili."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Azione o risultato del mettere insieme o del collegare elementi diversi.",
      "examples": [
        "L'associazione di questi due farmaci può avere effetti collaterali.",
        "La ricetta prevede un'associazione insolita di sapori."
      ],
      "nota": "Usato soprattutto in contesti tecnici o specialistici (es. medicina, cucina, chimica)."
    }
  ]
