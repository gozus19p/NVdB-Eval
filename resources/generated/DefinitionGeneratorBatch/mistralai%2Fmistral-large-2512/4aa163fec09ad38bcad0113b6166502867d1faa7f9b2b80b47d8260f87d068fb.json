  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Affermare consapevolmente il falso con l'intenzione di ingannare qualcuno.",
      "examples": [
        "Ha mentito sulla sua età per ottenere lo sconto.",
        "Non mentirmi, so che non eri a casa ieri sera."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Nascondere la verità o omettere dettagli rilevanti per trarre in inganno, senza necessariamente dire il falso esplicitamente.",
      "examples": [
        "Ha mentito per omissioni, non mi ha detto che aveva già venduto la macchina.",
        "Non è che abbia mentito, ma non mi ha raccontato tutta la storia."
      ],
      "nota": "Spesso usato in contesti in cui l'inganno avviene attraverso silenzi o reticenze piuttosto che affermazioni false."
    },
    {
      "pos": "verbo intransitivo (uso figurato)",
      "definition": "Non corrispondere alla realtà o tradire le aspettative, detto di cose o situazioni.",
      "examples": [
        "I dati del rapporto mentono: la situazione è molto peggiore di quanto sembri.",
        "Questo sorriso forzato mente, si vede che è infelice."
      ],
      "nota": "Uso esteso a oggetti inanimati o concetti astratti, spesso con connotazione negativa."
    }
  ]
