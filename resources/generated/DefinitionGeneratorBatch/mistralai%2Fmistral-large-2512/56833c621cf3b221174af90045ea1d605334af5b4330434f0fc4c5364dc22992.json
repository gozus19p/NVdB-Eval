  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Piccolo mammifero domestico carnivoro, comunemente tenuto come animale da compagnia per la sua capacità di cacciare topi e altri piccoli animali.",
      "examples": [
        "Il gatto si è acciambellato sul divano e fa le fusa.",
        "Ho adottato un gatto randagio che girovagava nel cortile."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento meccanico utilizzato per sollevare veicoli, soprattutto automobili, durante operazioni di riparazione o cambio gomme.",
      "examples": [
        "Prima di cambiare la ruota, assicurati che il gatto sia ben posizionato sotto la macchina.",
        "Il meccanico ha usato il gatto per sollevare l'auto e controllare la sospensione."
      ],
      "nota": "In questo senso, il termine è spesso usato al maschile anche se talvolta viene percepito come invariabile o femminile in alcuni contesti regionali."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona astuta, furba o che agisce con scaltrezza, spesso per ottenere un vantaggio personale.",
      "examples": [
        "Non fidarti di lui, è un vero gatto e ti fregherà alla prima occasione.",
        "Quel politico è un gatto: riesce sempre a cavarsela senza conseguenze."
      ],
      "nota": "Uso figurato, spesso con connotazione negativa o ironica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Pezzo di stoffa o altro materiale usato per pulire o asciugare superfici, spesso in cucina.",
      "examples": [
        "Prendi il gatto e pulisci il tavolo, per favore.",
        "Ho usato il gatto per asciugare il pavimento dopo aver lavato."
      ],
      "nota": "Uso regionale, diffuso soprattutto nel Nord Italia. In altre zone d'Italia, il termine può essere sconosciuto o sostituito da 'straccio'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Tipo di pesce marino appartenente alla famiglia degli Scorpenidi, noto per le sue spine velenose.",
      "examples": [
        "Ho pescato un gatto mentre ero in barca, ma l'ho ributtato in mare perché è pericoloso.",
        "Il gatto è un pesce che si mimetizza bene tra le rocce."
      ],
      "nota": "Nome comune di *Scorpaena scrofa*, noto anche come 'scorfano rosso'."
    }
  ]
