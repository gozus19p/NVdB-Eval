  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Rivestimento esterno del corpo umano e di molti animali, costituito da epidermide, derma e ipoderma, che protegge gli organi interni e regola la temperatura.",
      "examples": [
        "Dopo la scottatura, la pelle le si è spellata.",
        "Usa una crema idratante per mantenere la pelle elastica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Pellicola sottile che si forma sulla superficie di alcuni liquidi, come il latte o il brodo, quando si raffreddano o vengono cotti a lungo.",
      "examples": [
        "Sulla minestra si era formata una pelle spessa.",
        "Rimuovi la pelle dal latte prima di berlo."
      ],
      "nota": "In questo senso, il termine è spesso usato in contesti culinari."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Involucro esterno di alcuni frutti o ortaggi, come mele, patate o agrumi, che può essere commestibile o meno.",
      "examples": [
        "Non mangiare la pelle delle arance se non è biologica.",
        "La pelle delle patate diventa croccante se cotta al forno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Materiale ottenuto dalla lavorazione della pelle animale, usato per produrre abbigliamento, accessori o rivestimenti.",
      "examples": [
        "Ha comprato una giacca di pelle nera.",
        "Questa borsa è fatta di vera pelle."
      ],
      "nota": "In questo senso, il termine è spesso associato a prodotti di pelletteria."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Condizione di estrema vicinanza o contatto fisico tra persone o cose.",
      "examples": [
        "Eravamo in pelle in quel vagone della metropolitana.",
        "Le case del centro storico sono costruite in pelle l'una all'altra."
      ],
      "nota": "Uso figurato e colloquiale, spesso con valore iperbolico."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Aspetto esteriore o apparenza di una persona, spesso usato per indicare una condizione di salute o stato d'animo.",
      "examples": [
        "Dopo la malattia, aveva la pelle giallastra.",
        "Non mi piace la pelle che hai oggi, sembri stanco."
      ],
      "nota": "Uso figurato, spesso in espressioni idiomatiche come 'salvare la pelle' (scampare un pericolo)."
    }
  ]
