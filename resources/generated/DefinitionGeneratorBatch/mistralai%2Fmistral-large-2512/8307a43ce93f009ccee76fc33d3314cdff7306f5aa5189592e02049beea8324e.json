  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Sensazione fisica di bisogno di cibo, spesso accompagnata da debolezza o disagio.",
      "examples": [
        "Dopo aver saltato il pranzo, mi è venuta una fame tremenda.",
        "I bambini che soffrono la fame nei paesi poveri hanno bisogno di aiuto immediato."
