  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non contiene nulla al suo interno o sulla sua superficie.",
      "examples": [
        "Ho trovato il frigorifero vuoto quando sono tornato a casa.",
        "La bottiglia è vuota, dobbiamo comprarne un'altra."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di significato, contenuto o interesse.",
      "examples": [
        "Quel discorso era completamente vuoto, non ha detto niente di nuovo.",
        "Mi sento vuoto dopo aver finito quel libro così noioso."
      ],
      "nota": "Usato spesso in senso figurato per indicare mancanza di sostanza o emozioni."
    },
    {
      "pos": "aggettivo",
      "definition": "Non occupato da persone o cose.",
      "examples": [
        "La sala era vuota mezz'ora prima dell'inizio del concerto.",
        "Ho trovato un posto vuoto sull'autobus e mi sono seduto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio privo di materia o di oggetti.",
      "examples": [
        "Il vuoto sotto il ponte mi ha fatto venire le vertigini.",
        "Non lasciare vuoti tra le parole quando scrivi a mano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione di mancanza o assenza di qualcosa di importante.",
      "examples": [
        "Dopo la sua partenza, ho sentito un grande vuoto dentro di me.",
        "Il vuoto lasciato dalla perdita di un caro è difficile da colmare."
      ],
      "nota": "Spesso usato in contesti emotivi o psicologici."
    }
  ]
