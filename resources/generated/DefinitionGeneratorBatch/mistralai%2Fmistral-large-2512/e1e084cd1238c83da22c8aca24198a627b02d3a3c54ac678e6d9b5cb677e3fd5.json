  "senses": [
    {
      "pos": "preposizione",
      "definition": "Indica un intervallo di tempo nel quale si svolge un'azione o si verifica un evento.",
      "examples": [
        "Ho letto un libro durante il viaggio in treno.",
        "Durante la riunione, sono state prese decisioni importanti."
      ],
      "nota": "Può essere sostituita da 'nel corso di' o 'mentre' in molti contesti, ma 'durante' enfatizza la durata dell'intervallo temporale."
    },
    {
      "pos": "avverbio (in locuzioni)",
      "definition": "In combinazione con sostantivi o aggettivi, forma espressioni che indicano un periodo di tempo specifico.",
      "examples": [
        "L'ufficio resterà chiuso durante feriale.",
        "Durante l'estate, le temperature possono superare i 35 gradi."
      ],
      "nota": "Spesso usato in locuzioni fisse come 'durante il giorno', 'durante la notte', 'durante l'anno'."
