  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Unità di tempo della durata di ventiquattro ore, corrispondente a una rotazione completa della Terra attorno al proprio asse.",
      "examples": [
        "Il viaggio dura tre giorni e due notti.",
        "Ogni giorno mi sveglio alle sette."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di luce naturale compreso tra l'alba e il tramonto, in opposizione alla notte.",
      "examples": [
        "D'estate il giorno dura molto più a lungo della notte.",
        "Preferisco lavorare di giorno piuttosto che di sera."
      ],
      "nota": "In questo senso si contrappone esplicitamente a 'notte'; si usa spesso nelle locuzioni 'di giorno', 'in pieno giorno'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Data specifica del calendario o momento preciso nella vita di qualcuno, connotato da un evento particolare.",
      "examples": [
        "Quel giorno non lo dimenticherò mai.",
        "Il giorno del matrimonio era finalmente arrivato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo storico, epoca o fase della vita, spesso usato al plurale per indicare un'era o un tempo della propria esistenza.",
      "examples": [
        "Ai miei giorni le cose andavano diversamente.",
        "Quelli erano i giorni più felici della sua giovinezza."
      ],
      "nota": "Frequente al plurale con valore temporale esteso; la locuzione 'ai giorni nostri' significa 'nell'epoca contemporanea'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Luce diffusa o chiarore sufficiente a vedere, indipendentemente dall'ora precisa.",
      "examples": [
        "Aspetta che faccia giorno prima di partire.",
        "Si mise in cammino appena spuntò il giorno."
      ],
      "nota": "In questo senso 'giorno' è vicino a 'alba' o 'luce del mattino'; si usa in locuzioni come 'fare giorno', 'spuntare il giorno'."
    }
  ]
