  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Parte superiore del corpo umano e animale che contiene il cervello e ospita gli organi di senso principali.",
      "examples": [
        "Ha annuito con un cenno del capo.",
        "Il bambino scosse il capo in segno di diniego."
      ],
      "nota": "In molti contesti è intercambiabile con 'testa', ma 'capo' risulta più formale o letterario."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che ha autorità, responsabilità direttiva o di comando su un gruppo, un'organizzazione o un'attività.",
      "examples": [
        "Il capo dell'azienda ha convocato una riunione d'emergenza.",
        "Devi parlare direttamente con il tuo capo prima di prendere una decisione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Estremità o parte terminale di un oggetto, un percorso o uno spazio.",
      "examples": [
        "Raggiunsero il capo del sentiero dopo ore di cammino.",
        "Tieni il capo del filo mentre annodo l'altro."
      ],
      "nota": "Si usa in espressioni come 'da un capo all'altro' per indicare l'intera estensione di qualcosa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Promontorio o punta di terra che si protende nel mare.",
      "examples": [
        "La nave doppiò il Capo di Buona Speranza dopo settimane di navigazione.",
        "Dal faro si vedeva chiaramente il profilo del capo."
      ],
      "nota": "In geografia, spesso scritto con la maiuscola quando fa parte di un toponimo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Singolo articolo di abbigliamento considerato come unità.",
      "examples": [
        "Ha acquistato tre capi di abbigliamento in saldo.",
        "Quel capo griffato costa quanto metà del mio stipendio."
      ],
      "nota": "Frequente nel linguaggio della moda e del commercio tessile."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Punto o argomento specifico nell'ambito di un documento, un discorso o un ragionamento.",
      "examples": [
        "Il contratto prevede, al terzo capo, le condizioni di recesso.",
        "Vorrei tornare su questo capo della discussione per chiarire alcuni dubbi."
      ],
      "nota": "Tipico del linguaggio giuridico, burocratico e accademico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Singolo animale di bestiame, considerato come unità di conteggio.",
      "examples": [
        "L'allevamento conta oltre duecento capi di bestiame.",
        "Hanno perso diversi capi durante la siccità estiva."
      ],
      "nota": "Uso specifico del linguaggio zootecnico e agricolo."
    }
  ]
