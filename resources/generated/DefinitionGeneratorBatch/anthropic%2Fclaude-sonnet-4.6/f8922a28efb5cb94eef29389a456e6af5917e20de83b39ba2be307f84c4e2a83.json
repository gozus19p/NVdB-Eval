  "senses": [
    {
      "pos": "aggettivo numerale cardinale invariabile",
      "definition": "Numero intero corrispondente a cinque più uno; indica una quantità pari a 6.",
      "examples": [
        "Ho comprato sei mele al mercato.",
        "La riunione durerà sei ore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Il numero 6, inteso come cifra, simbolo o valore numerico; in ambito scolastico italiano, indica il voto minimo sufficiente nella scala da uno a dieci.",
      "examples": [
        "Ha preso un sei in matematica: è appena sufficiente.",
        "Scrivi un sei all'inizio della sequenza numerica."
      ],
      "nota": "Nell'uso scolastico italiano il sei rappresenta la soglia della sufficienza, per cui è spesso connotato come risultato mediocre pur essendo formalmente positivo."
    },
    {
      "pos": "verbo, seconda persona singolare, indicativo presente di 'essere'",
      "definition": "Forma della copula o del verbo esistenziale riferita al soggetto 'tu': indica identità, stato, qualità, provenienza o esistenza di chi si sta interpellando.",
      "examples": [
        "Sei davvero stanco dopo quella lunga giornata.",
        "Sei sicuro di voler partire domani?"
      ],
      "nota": "Forma del verbo 'essere' alla seconda persona singolare del presente indicativo. Non va confusa con l'omografo numerale."
    }
  ]
