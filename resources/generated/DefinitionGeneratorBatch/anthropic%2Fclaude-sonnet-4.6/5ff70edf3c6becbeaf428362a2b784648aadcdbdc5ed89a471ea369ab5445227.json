  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Svolgere un'attività ludica per divertimento o svago, spesso seguendo regole stabilite.",
      "examples": [
        "I bambini giocano in cortile tutto il pomeriggio.",
        "Anche da adulto ama giocare con i Lego."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Partecipare a una competizione sportiva o a una partita, confrontandosi con avversari.",
      "examples": [
        "La Juventus gioca in trasferta domenica prossima.",
        "Ha giocato per dieci anni in Serie A prima di ritirarsi."
      ],
      "nota": "In questo senso è frequente la costruzione 'giocare contro qualcuno' o 'giocare in/a [posizione o disciplina sportiva]'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Disputare una partita o un incontro sportivo.",
      "examples": [
        "Domani giochiamo un match decisivo per la classifica.",
        "La squadra ha giocato una partita eccellente."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Puntare denaro o altro in giochi d'azzardo o scommesse nella speranza di vincere.",
      "examples": [
        "Ha perso tutti i risparmi giocando al casinò.",
        "Gioca al lotto ogni settimana senza mai vincere nulla."
      ],
      "nota": "In questo senso si costruisce spesso con 'a' + gioco (giocare a poker, al lotto) oppure con 'su' + oggetto della scommessa."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rischiare o impegnare qualcosa di valore in una situazione incerta.",
      "examples": [
        "Si è giocato la carriera pur di difendere i suoi principi.",
        "Ha giocato tutta la sua reputazione su quella decisione."
      ],
      "nota": "Uso figurato; implica che la posta in gioco sia importante e l'esito incerto."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un ruolo o un'influenza rilevante in una situazione; essere un fattore determinante.",
      "examples": [
        "In questa vicenda gioca un ruolo fondamentale la fiducia reciproca.",
        "L'esperienza ha giocato a suo favore durante il colloquio."
      ],
      "nota": "Tipicamente in costruzioni come 'giocare a favore/sfavore di' o 'giocare un ruolo'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trattare qualcosa o qualcuno con leggerezza, senza serietà; non prendere sul serio.",
      "examples": [
        "Non stai giocando con la mia pazienza, vero?",
        "Smettila di giocare con i sentimenti degli altri."
      ],
      "nota": "Costruzione tipica: 'giocare con qualcuno/qualcosa'. Ha spesso connotazione negativa."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi o agire con abilità e creatività all'interno di un sistema di possibilità; fare uso espressivo di qualcosa.",
      "examples": [
        "Il fotografo gioca con luci e ombre per creare atmosfera.",
        "La scrittrice gioca con le parole in modo originale e raffinato."
      ],
      "nota": "Costruzione tipica: 'giocare con' + elemento espressivo o materiale. Indica padronanza e sperimentazione creativa."
    }
  ]
