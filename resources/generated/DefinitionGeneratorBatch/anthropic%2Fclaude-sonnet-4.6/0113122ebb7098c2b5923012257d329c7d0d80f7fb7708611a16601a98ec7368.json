  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Strofinare ripetutamente una superficie contro un'altra con movimento avanti e indietro, allo scopo di pulire, lucidare o produrre attrito.",
      "examples": [
        "Devi fregare bene il pavimento con la spazzola per togliere lo sporco.",
        "Si fregò le mani per scaldarle dal freddo."
      ],
      "nota": "È il senso originario e più concreto del verbo; si usa anche riflessivo (fregarsi le mani, gli occhi)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ingannare qualcuno a proprio vantaggio, approfittandosi della sua buona fede o ingenuità.",
      "examples": [
        "Il meccanico mi ha fregato facendomi pagare una riparazione inutile.",
        "Attento, in quel mercato ti fregano facilmente se non conosci i prezzi."
      ],
      "nota": "Uso colloquiale e informale, molto diffuso nell'italiano parlato."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sottrarre qualcosa illecitamente, rubare.",
      "examples": [
        "Qualcuno mi ha fregato il portafoglio in autobus.",
        "Gli hanno fregato la bici davanti alla scuola."
      ],
      "nota": "Uso gergale-colloquiale, sinonimo informale di 'rubare'."
    },
    {
      "pos": "verbo intransitivo / impersonale",
      "definition": "Importare, interessare; usato quasi esclusivamente in costruzioni negative per esprimere totale indifferenza verso qualcosa o qualcuno.",
      "examples": [
        "Non me ne frega niente di quello che pensano gli altri.",
        "A lui non frega nulla delle conseguenze."
      ],
      "nota": "Quasi sempre usato alla forma negativa (non fregare) e in costruzioni con pronome dativo (me ne frega, gli frega). Equivale a 'importare' o 'interessare' in registro informale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Superare o sconfiggere qualcuno, avere la meglio su di lui in una competizione o situazione avversa.",
      "examples": [
        "Questa volta ti ho fregato io a scacchi!",
        "Alla fine l'ha fregata la stanchezza e ha dovuto ritirarsi dalla gara."
      ],
      "nota": "Uso colloquiale; può riferirsi sia a competizioni dirette sia a fattori esterni che hanno la meglio su qualcuno."
    }
  ]
