  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non manca di nessuna parte, che è completo nella sua totalità senza che nulla sia stato tolto o sottratto.",
      "examples": [
        "Ha mangiato un'intera torta senza lasciarne neanche una fetta.",
        "Ho trascorso l'intera giornata a lavorare senza una pausa."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non ha subito danni, rotture o alterazioni; rimasto integro.",
      "examples": [
        "Dopo la caduta, il vaso era ancora intero per miracolo.",
        "Solo pochi edifici sono rimasti interi dopo il terremoto."
      ],
      "nota": "Questo senso si avvicina a 'integro' e 'illeso', riferito all'integrità fisica di oggetti o strutture."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito al latte, che conserva tutto il proprio contenuto di grassi naturali, non scremato.",
      "examples": [
        "Preferisco il latte intero al latte scremato perché è più saporito.",
        "La ricetta prevede l'uso di latte intero per ottenere una crema più densa."
      ],
      "nota": "Uso specifico nel linguaggio alimentare, contrapposto a 'scremato' o 'parzialmente scremato'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In matematica, numero appartenente all'insieme dei numeri interi, cioè i numeri naturali, i loro opposti negativi e lo zero.",
      "examples": [
        "Il risultato della divisione non è un intero, ma un numero decimale.",
        "Nell'esercizio si chiede di trovare tutti gli interi compresi tra -5 e 5."
      ],
      "nota": "Abbreviazione di 'numero intero'. L'insieme degli interi è indicato con il simbolo ℤ."
    },
    {
      "pos": "avverbio",
      "definition": "Per intero: nella sua totalità, completamente, senza omissioni.",
      "examples": [
        "Ha restituito il debito per intero entro la scadenza.",
        "Il testo deve essere letto per intero prima di esprimere un giudizio."
      ],
      "nota": "Usato quasi esclusivamente nella locuzione avverbiale 'per intero'."
    }
  ]
