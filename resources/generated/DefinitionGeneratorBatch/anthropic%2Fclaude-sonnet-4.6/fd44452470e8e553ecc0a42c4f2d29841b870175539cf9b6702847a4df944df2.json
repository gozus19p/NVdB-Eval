  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Tessuto biologico che riveste esternamente il corpo degli esseri umani e degli animali, con funzione protettiva e sensoriale.",
      "examples": [
        "Dopo una settimana al mare aveva la pelle abbronzata e leggermente scottata.",
        "Il medico esaminò attentamente la pelle del paziente alla ricerca di eruzioni cutanee."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Materiale ricavato dalla concia del rivestimento corporeo di animali, usato per produrre indumenti, accessori e manufatti.",
      "examples": [
        "La borsa era realizzata in pelle di vitello di altissima qualità.",
        "Indossava un giubbotto di pelle nera che gli donava un'aria ribelle."
      ],
      "nota": "In questo senso è spesso usato in opposizione a 'pelle sintetica' o 'ecopelle'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strato sottile superficiale che si forma su certi liquidi o alimenti, come il latte riscaldato o la frutta.",
      "examples": [
        "Sul latte caldo si era formata una pelle che non riusciva a togliere.",
        "Sbucciando il pomodoro si elimina la pelle esterna prima di cucinarlo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f. (figurato)",
      "definition": "La vita di una persona, intesa come bene prezioso da difendere o rischiare.",
      "examples": [
        "In quella missione rischiarono tutti la pelle.",
        "Non vale la pena rimetterci la pelle per così poco."
      ],
      "nota": "Usato prevalentemente in locuzioni come 'rischiare la pelle', 'salvare la pelle', 'rimetterci la pelle'."
    },
    {
      "pos": "sostantivo f. (figurato)",
      "definition": "La persona stessa, con riferimento alla propria identità fisica o emotiva, spesso in contesti di identificazione intensa o disagio.",
      "examples": [
        "Non mi sento a mio agio in questa pelle, vorrei essere altrove.",
        "Era così entusiasta del personaggio da vivere nella sua pelle anche fuori dal set."
      ],
      "nota": "Ricorre in locuzioni come 'stare bene/male nella propria pelle', 'sentirsi a proprio agio nella propria pelle'."
    },
    {
      "pos": "sostantivo f. (figurato, colloquiale)",
      "definition": "Persona, individuo, con sfumatura di scarsa considerazione o trattamento riduttivo.",
      "examples": [
        "Non si fida di nessuna pelle in questo palazzo.",
        "Era una pelle dura, difficile da convincere."
      ],
      "nota": "Uso colloquiale e spesso connotato negativamente."
    }
  ]
