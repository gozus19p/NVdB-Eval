  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che appartiene a uno Stato o a una comunità politica, con i relativi diritti e doveri civili e giuridici.",
      "examples": [
        "Ogni cittadino ha il diritto di voto a partire dai diciotto anni.",
        "I cittadini europei possono circolare liberamente all'interno dell'Unione."
      ],
      "nota": "Si distingue da 'straniero' o 'apolide'; implica un rapporto giuridico formale con uno Stato. Al femminile: 'la cittadina'."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Abitante di una città, in contrapposizione a chi vive in campagna o in zone rurali.",
      "examples": [
        "I cittadini soffrono maggiormente dello smog rispetto a chi vive in campagna.",
        "Da vero cittadino, non sa nemmeno come si munge una mucca."
      ],
      "nota": "In questo senso si contrappone a 'contadino', 'rurale' o 'provinciale'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene o si riferisce alla città, alla sua struttura urbana o alla vita che vi si svolge.",
      "examples": [
        "Il traffico cittadino è diventato insostenibile nelle ore di punta.",
        "Le amministrazioni locali cercano di migliorare i servizi cittadini."
      ],
      "nota": "Usato prevalentemente in funzione attributiva o predicativa; sinonimo parziale di 'urbano'."
    }
  ]
