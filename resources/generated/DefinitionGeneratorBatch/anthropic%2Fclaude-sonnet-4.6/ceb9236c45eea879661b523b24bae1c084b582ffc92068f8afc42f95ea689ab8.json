  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Struttura architettonica curva che sovrasta un'apertura o collega due supporti, distribuendo il peso verso i lati.",
      "examples": [
        "L'arco a tutto sesto è tipico dell'architettura romanica.",
        "Sotto l'arco del portone si riparavano i passanti dalla pioggia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento per scagliare frecce, composto da un'asta flessibile tenuta in tensione da una corda.",
      "examples": [
        "Il cacciatore tese l'arco e mirò con precisione al bersaglio.",
        "Nell'antichità l'arco era l'arma a distanza più diffusa tra i guerrieri."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Bacchetta con crini di crine animale tesa, usata per far vibrare le corde di strumenti musicali come il violino o il violoncello.",
      "examples": [
        "Il violinista scorreva l'arco sulle corde con grande delicatezza.",
        "Deve risinamare l'arco prima del concerto."
      ],
      "nota": "In ambito musicale si distingue anche il colpo d'arco come tecnica esecutiva."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Porzione di curva o di circonferenza compresa tra due punti.",
      "examples": [
        "L'arco di cerchio misura sessanta gradi.",
        "Il satellite percorre un arco di traiettoria prima di rientrare nell'atmosfera."
      ],
      "nota": "Uso proprio della geometria e della matematica, ma diffuso anche nel linguaggio comune."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Intervallo di tempo o spazio entro cui si sviluppa qualcosa.",
      "examples": [
        "Nell'arco di una settimana la situazione è cambiata radicalmente.",
        "La sua carriera si è svolta nell'arco di trent'anni."
      ],
      "nota": "Uso figurato molto comune, tipicamente nella locuzione 'nell'arco di'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Formazione naturale a forma di volta, prodotta dall'erosione di rocce o da altri fenomeni geologici.",
      "examples": [
        "L'arco naturale di roccia è diventato una meta turistica molto visitata.",
        "Le onde del mare hanno scavato nel tempo un arco nella scogliera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Fenomeno meteorologico o ottico con forma curva e colorata visibile nel cielo, detto comunemente arcobaleno.",
      "examples": [
        "Dopo il temporale è apparso un bellissimo arco nel cielo.",
        "I bambini indicavano l'arco colorato che si stagliava all'orizzonte."
      ],
      "nota": "In questo senso è usato come forma abbreviata e popolare di 'arcobaleno', meno frequente della forma estesa."
    }
  ]
