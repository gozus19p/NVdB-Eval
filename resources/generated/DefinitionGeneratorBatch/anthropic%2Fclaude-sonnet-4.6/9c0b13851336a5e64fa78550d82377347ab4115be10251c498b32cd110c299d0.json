  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non manca di nessuna parte o elemento rispetto a un insieme atteso o previsto; interamente presente nella sua totalità.",
      "examples": [
        "Ha consegnato una documentazione completa, senza lacune.",
        "L'opera completa di Leopardi è stata pubblicata in un unico volume."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Portato a termine, concluso in ogni suo aspetto; che non richiede ulteriori aggiunte o integrazioni.",
      "examples": [
        "Il restauro dell'edificio è ormai completo.",
        "La sua guarigione non è ancora completa, ma i progressi sono evidenti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di luogo o contenitore, che non ha spazio disponibile; occupato in ogni posto.",
      "examples": [
        "Il treno era completo e non siamo riusciti a salire.",
        "L'albergo risulta completo per tutto il weekend di Pasqua."
      ],
      "nota": "In questo senso è frequente l'uso predicativo e si avvicina a 'al completo'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che possiede tutte le qualità o capacità richieste in un determinato ambito; dotato di piena competenza o polivalenza.",
      "examples": [
        "È un calciatore completo: sa difendere, costruire e segnare.",
        "Cercano un professionista completo, in grado di gestire sia la parte tecnica sia quella commerciale."
      ],
      "nota": "Uso valutativo, tipico in ambiti sportivi e professionali."
    },
    {
      "pos": "aggettivo",
      "definition": "Usato con valore intensivo per rafforzare un sostantivo di significato negativo o valutativo, equivalente a 'totale', 'assoluto'.",
      "examples": [
        "È stato un fallimento completo, non è andata bene nulla.",
        "Quella riunione è stata un disastro completo."
      ],
      "nota": "In questo uso il termine segue il sostantivo e ha funzione enfatica."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Insieme coordinato di capi di abbigliamento, tipicamente giacca e pantalone (o gonna) dello stesso tessuto e colore, indossati insieme.",
      "examples": [
        "Per il colloquio ha indossato un completo grigio antracite.",
        "Ha acquistato un completo elegante per il matrimonio della sorella."
      ],
      "nota": "Nel linguaggio della moda, 'completo' può includere anche il gilè, dando luogo al cosiddetto 'completo a tre pezzi'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Pasto che comprende più portate o componenti, generalmente primo, secondo e contorno, oppure insieme di elementi che formano un tutto unitario in un menù o un'offerta commerciale.",
      "examples": [
        "Al bar hanno ordinato un toast completo con succo e caffè.",
        "Il ristorante propone un menù completo a prezzo fisso."
      ],
      "nota": "Tipico del linguaggio della ristorazione informale."
    }
  ]
