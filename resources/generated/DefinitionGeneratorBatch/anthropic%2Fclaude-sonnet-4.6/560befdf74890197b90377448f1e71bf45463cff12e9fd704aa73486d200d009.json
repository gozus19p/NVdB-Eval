    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di cittadinanza o nazionalità italiana.",
      "examples": [
        "Molti italiani emigrarono in America nel corso del Novecento.",
        "Da quando vive a Londra, frequenta principalmente altri italiani."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lingua romanza parlata in Italia e in alcune comunità nel mondo, derivata dal latino volgare e basata sul fiorentino letterario.",
      "examples": [
        "Sta seguendo un corso di italiano per stranieri.",
        "L'italiano è la lingua ufficiale della Repubblica Italiana e uno dei idiomi ufficiali della Svizzera."
      ],
      "nota": "Usato in modo assoluto, senza articolo o con articolo determinativo, per riferirsi alla lingua: 'parla italiano', 'studia l'italiano'."
    }
