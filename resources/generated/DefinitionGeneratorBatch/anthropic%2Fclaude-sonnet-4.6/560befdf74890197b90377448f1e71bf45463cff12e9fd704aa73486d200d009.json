    {
      "pos": "aggettivo",
      "definition": "Che appartiene all'Italia, che è proprio della sua cultura, storia, tradizione o produzione.",
      "examples": [
        "La cucina italiana è apprezzata in tutto il mondo.",
        "Il design italiano ha conquistato i mercati internazionali."
      ],
