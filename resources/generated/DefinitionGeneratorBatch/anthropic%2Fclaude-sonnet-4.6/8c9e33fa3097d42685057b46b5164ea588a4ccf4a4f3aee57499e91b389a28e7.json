  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che è libero da impegni e può essere utilizzato, consultato o raggiunto in un determinato momento.",
      "examples": [
        "Il medico è disponibile solo il martedì pomeriggio.",
        "Sei disponibile per una riunione domani mattina?"
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di cosa, che esiste in quantità sufficiente o che può essere ottenuto, acquistato o usato senza ostacoli.",
      "examples": [
        "I biglietti sono ancora disponibili sul sito ufficiale.",
        "Non ci sono camere disponibili per questo weekend."
      ],
      "nota": "Frequente in contesti commerciali, informatici e burocratici."
    },
    {
      "pos": "aggettivo",
      "definition": "Che mostra apertura e volontà di aiutare gli altri, di collaborare o di accettare richieste.",
      "examples": [
        "È una persona molto disponibile: aiuta sempre i colleghi in difficoltà.",
        "Il responsabile si è mostrato disponibile ad ascoltare le nostre proposte."
      ],
      "nota": "Uso valutativo con connotazione positiva; si riferisce a una qualità caratteriale o comportamentale della persona."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di risorsa finanziaria o materiale, che può essere liberamente impiegata o spesa.",
      "examples": [
        "Il capitale disponibile per il progetto ammonta a cinquantamila euro.",
        "Abbiamo poche risorse disponibili da destinare alla ricerca."
      ],
      "nota": "Tipico del linguaggio economico, finanziario e amministrativo."
    }
  ]
