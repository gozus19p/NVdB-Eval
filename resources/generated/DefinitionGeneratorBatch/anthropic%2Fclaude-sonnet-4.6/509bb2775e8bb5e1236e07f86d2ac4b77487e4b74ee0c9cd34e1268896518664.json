  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo alla Cina, al suo territorio, alla sua cultura, alla sua popolazione o alle sue produzioni.",
      "examples": [
        "La cucina cinese è famosa in tutto il mondo per l'uso di spezie e salse fermentate.",
        "Il governo cinese ha annunciato nuove misure economiche per stimolare la crescita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona originaria della Cina o di nazionalità cinese.",
      "examples": [
        "Molti cinesi si sono stabiliti in Italia negli ultimi decenni aprendo attività commerciali.",
        "Ho conosciuto una cinese all'università che mi ha insegnato qualche parola di mandarino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lingua o gruppo di lingue sino-tibetane parlate in Cina, nella sua varietà standard nota come mandarino (putonghua) o in altre varietà regionali.",
      "examples": [
        "Sta studiando il cinese da tre anni e riesce già a sostenere conversazioni di base.",
        "Il cinese mandarino è la lingua più parlata al mondo per numero di madrelingua."
      ],
      "nota": "Il termine può riferirsi genericamente al cinese mandarino standard oppure, in senso più ampio, all'insieme delle varietà linguistiche sinitiche (cantonese, wu, min, ecc.)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato e colloquiale, qualcosa di incomprensibile, oscuro o difficilissimo da capire.",
      "examples": [
        "Questo contratto è scritto in cinese: non ci capisco assolutamente niente.",
        "Per me la fisica quantistica è cinese puro."
      ],
      "nota": "Uso figurato e informale, parallelo all'espressione italiana 'è arabo' o all'inglese 'it's Greek to me'. Non ha connotazione dispregiativa verso la lingua o la cultura cinese, ma sfrutta la percezione di complessità del sistema di scrittura."
    }
  ]
