  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Movimento del corpo, in particolare di mani, braccia o volto, compiuto per comunicare un'emozione, un'intenzione o un significato, spesso in accompagnamento o in sostituzione della parola.",
      "examples": [
        "Alzò la mano in un gesto di saluto verso i colleghi.",
        "Con un gesto della testa indicò la direzione da prendere.",
        "Il bambino esprimeva la sua gioia con gesti vivaci e disinvolti."
      ],
      "nota": "Può essere volontario e codificato culturalmente (come il pollice su/giù) oppure spontaneo ed emotivo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Azione concreta, spesso di breve durata, considerata nella sua valenza simbolica o morale, come manifestazione di un sentimento, di una volontà o di un valore.",
      "examples": [
        "Pagare il conto a sorpresa è stato un gesto di grande generosità.",
        "Con quel gesto coraggioso si guadagnò il rispetto di tutti.",
        "Bastava un piccolo gesto di affetto per farla sentire meglio."
      ],
      "nota": "In questo senso 'gesto' si avvicina a 'atto' o 'azione', ma conserva una connotazione valutativa o simbolica che l'azione non sempre ha."
    }
  ]
