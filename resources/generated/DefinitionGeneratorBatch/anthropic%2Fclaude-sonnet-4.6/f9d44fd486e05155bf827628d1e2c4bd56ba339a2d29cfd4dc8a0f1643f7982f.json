  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte terminale dell'arto superiore dell'essere umano, composta dal palmo e dalle dita, usata per afferrare, toccare e compiere azioni.",
      "examples": [
        "Si è tagliata la mano mentre affettava il pane.",
        "Tese la mano per salutare il nuovo collega."
      ],
      "nota": "Il plurale irregolare è 'le mani' (femminile), nonostante il singolare termini in -o."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strato di vernice, intonaco o altro materiale applicato in un'unica passata su una superficie.",
      "examples": [
        "Il pittore ha dato una seconda mano di vernice alla porta.",
        "Bisogna applicare almeno due mani di primer prima del colore definitivo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel gioco delle carte, l'insieme delle carte distribuite a ciascun giocatore in un turno, o il turno di gioco stesso.",
      "examples": [
        "Ho vinto tre mani di fila a briscola.",
        "Con questa mano è impossibile bluffare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Intervento, contributo o aiuto di una persona in un'attività o in un'opera.",
      "examples": [
        "In questo affresco si riconosce chiaramente la mano del Caravaggio.",
        "Si vede la mano esperta di un grande chef in ogni piatto."
      ],
      "nota": "Usato spesso in contesti artistici o artigianali per indicare lo stile riconoscibile di un autore."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Potere, controllo o autorità su qualcuno o qualcosa.",
      "examples": [
        "L'azienda è finita nelle mani di un fondo straniero.",
        "Tenne in mano la situazione con grande calma."
      ],
      "nota": "Ricorre frequentemente in locuzioni come 'in mano a', 'nelle mani di', 'avere in mano'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Direzione di marcia o di percorrenza in riferimento alla carreggiata stradale.",
      "examples": [
        "Stava guidando contromano sul viale principale.",
        "In Italia si guida sulla mano destra."
      ],
      "nota": "Usato prevalentemente nelle locuzioni 'mano destra/sinistra' e 'contromano' in contesti di circolazione stradale."
    }
  ]
