  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che appartiene o si riferisce alla fantasia, all'immaginazione o al mondo irreale; che non ha riscontro nella realtà.",
      "examples": [
        "I romanzi di Calvino sono ricchi di elementi fantastici.",
        "Il racconto descrive un universo fantastico popolato di creature immaginarie."
      ],
      "nota": "In ambito letterario e cinematografico, 'fantastico' designa un genere specifico che mescola reale e soprannaturale, distinto da 'fantasy' (epico-avventuroso) e 'fantascienza' (scientifico-speculativo)."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è frutto della fantasia individuale, privo di fondamento reale; immaginario o illusorio.",
      "examples": [
        "I suoi timori erano del tutto fantastici, non c'era alcun pericolo reale.",
        "Smettila di inseguire progetti fantastici e pensa a qualcosa di concreto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Straordinario, eccezionale, meraviglioso; usato per esprimere forte approvazione o ammirazione.",
      "examples": [
        "Hai fatto un lavoro fantastico, sono davvero impressionato.",
        "Abbiamo trascorso una serata fantastica in quel ristorante."
      ],
      "nota": "Uso valutativo di registro colloquiale, molto frequente nell'italiano contemporaneo. Sinonimo di 'meraviglioso', 'straordinario', 'eccezionale'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che appartiene alla dimensione dell'immaginazione, dell'irreale o del soprannaturale, inteso come categoria estetica o mentale.",
      "examples": [
        "Nel suo cinema il confine tra il reale e il fantastico è sempre sfumato.",
        "La letteratura del fantastico affascina i lettori di ogni età."
      ],
      "nota": "Usato prevalentemente in contesti critici, letterari o cinematografici per indicare il genere o la categoria del soprannaturale immaginario."
    }
  ]
}