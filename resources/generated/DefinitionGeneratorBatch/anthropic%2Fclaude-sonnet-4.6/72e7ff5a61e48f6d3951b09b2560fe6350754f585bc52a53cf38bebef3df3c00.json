  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Liquido incolore, inodore e insapore, composto di idrogeno e ossigeno (H₂O), presente in natura in fiumi, laghi, mari e precipitazioni atmosferiche, essenziale per la vita.",
      "examples": [
        "Bevi almeno due litri di acqua al giorno per mantenerti idratato.",
        "L'acqua del lago era così limpida che si vedevano i sassi sul fondo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Specchio o distesa d'acqua naturale, come mare, lago o fiume, considerato come spazio da attraversare o su cui navigare.",
      "examples": [
        "La barca scivolava silenziosa sull'acqua del canale.",
        "Hanno nuotato a lungo prima di raggiungere l'altra sponda: c'era molta acqua da attraversare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Pioggia o precipitazione atmosferica.",
      "examples": [
        "Guarda che acqua sta cadendo, meglio restare in casa.",
        "Dopo settimane di siccità, finalmente è arrivata un po' di acqua."
      ],
      "nota": "In questo senso è frequente nell'uso colloquiale e nei bollettini meteorologici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Soluzione acquosa aromatizzata o profumata usata in cosmesi o igiene personale.",
      "examples": [
        "Si spruzzò dell'acqua di Colonia sul collo prima di uscire.",
        "L'acqua di rose è ottima come tonico naturale per la pelle."
      ],
      "nota": "Ricorre sempre in espressioni quali 'acqua di Colonia', 'acqua di rose', 'acqua ossigenata', ecc."
    },
    {
      "pos": "sostantivo f. (figurato)",
      "definition": "Elemento usato metaforicamente per indicare qualcosa di inafferrabile, che scorre via, che non lascia traccia o che è inutile trattenere.",
      "examples": [
        "Tutto quello che ha detto è passato come acqua: nessuno l'ha ascoltato davvero.",
        "È acqua passata, non vale la pena tornarci sopra."
      ],
      "nota": "Molto frequente in locuzioni idiomatiche come 'acqua passata', 'è acqua fresca', 'portare acqua al mare'."
    },
    {
      "pos": "sostantivo f. (figurato)",
      "definition": "In contesti valutativi, cosa priva di sostanza, di valore o di efficacia.",
      "examples": [
        "Quel discorso era tutto acqua: non ha detto niente di concreto.",
        "Le sue promesse sono acqua, non ci credo più."
      ],
      "nota": "Spesso usato con valore spregiativo per sottolineare la vacuità di discorsi, idee o promesse."
    }
  ]
