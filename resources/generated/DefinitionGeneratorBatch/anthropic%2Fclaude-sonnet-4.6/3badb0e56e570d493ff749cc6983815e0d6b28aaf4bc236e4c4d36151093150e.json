  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Somma di denaro impiegata per acquistare qualcosa o per far fronte a un costo; esborso economico.",
      "examples": [
        "La ristrutturazione della casa ha comportato una spesa enorme.",
        "Dobbiamo ridurre le spese mensili se vogliamo risparmiare."
      ],
      "nota": "Spesso usato al plurale per indicare l'insieme dei costi sostenuti in un periodo o in un ambito specifico (spese condominiali, spese di viaggio)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Acquisto di generi alimentari e di prima necessità, tipicamente effettuato al supermercato o al mercato; per estensione, la merce stessa acquistata.",
      "examples": [
        "Ogni sabato mattina vado a fare la spesa al mercato rionale.",
        "Ho lasciato le borse della spesa in macchina e devo andare a prenderle."
      ],
      "nota": "In questa accezione il termine è quasi sempre accompagnato dal verbo 'fare' (fare la spesa) e si riferisce specificamente all'approvvigionamento domestico quotidiano."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nell'espressione 'a proprie spese' o 'a spese di qualcuno', indica che il costo o il danno ricade su una determinata persona; in senso figurato, a svantaggio o detrimento di qualcuno.",
      "examples": [
        "Ha imparato la lezione a proprie spese, dopo aver perso tutti i risparmi.",
        "Faceva sempre battute a spese degli altri, senza rendersi conto di quanto fosse offensivo."
      ],
      "nota": "L'uso figurato 'a spese di qualcuno' indica che qualcuno subisce un danno, una perdita o una beffa per vantaggio altrui."
    }
  ]
