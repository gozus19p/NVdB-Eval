  "senses": [
    {
      "pos": "verbo transitivo / intransitivo",
      "definition": "Rivolgere a qualcuno una richiesta di informazione o chiarimento su qualcosa.",
      "examples": [
        "Gli ho domandato a che ora partiva il treno, ma non sapeva rispondermi.",
        "La bambina domandò alla maestra perché il cielo fosse blu."
      ],
      "nota": "Si costruisce con complemento oggetto diretto ('domandare qualcosa') o con una proposizione interrogativa indiretta ('domandare se/come/perché…'); può reggere anche il complemento di persona con 'a' ('domandare a qualcuno')."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Chiedere di ricevere qualcosa, avanzare una richiesta o un'esigenza nei confronti di qualcuno.",
      "examples": [
        "Ha domandato un aumento al suo capo dopo tre anni senza scatti di stipendio.",
        "I manifestanti domandavano giustizia per le vittime dell'incidente."
      ],
      "nota": "In questo senso si avvicina a 'richiedere' o 'pretendere'; si distingue dal senso interrogativo perché l'oggetto non è un'informazione ma un bene, un'azione o un diritto."
    },
    {
      "pos": "verbo riflessivo (domandarsi)",
      "definition": "Porsi interiormente una domanda, interrogarsi su qualcosa senza necessariamente rivolgersi a un interlocutore esterno.",
      "examples": [
        "Mi sono domandato più volte se quella scelta fosse stata giusta.",
        "Si domanda ancora come abbia fatto a non accorgersi di nulla."
      ],
      "nota": "L'uso riflessivo esprime un processo mentale interno; corrisponde spesso a 'chiedersi'."
    }
  ]
