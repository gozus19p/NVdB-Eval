  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "L'insieme degli eventi, delle esperienze e dei periodi di tempo trascorsi rispetto al momento presente, considerati come già avvenuti e non modificabili.",
      "examples": [
        "Non puoi cambiare il passato, puoi solo imparare da esso.",
        "Nel passato la vita era molto più semplice di oggi."
      ],
      "nota": "Contrapposto a 'presente' e 'futuro'. In senso storico indica epoche precedenti all'attualità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "L'insieme delle vicende personali, della storia individuale o collettiva di qualcuno o qualcosa in un tempo anteriore.",
      "examples": [
        "Ha un passato difficile che preferisce non raccontare.",
        "L'azienda ha un passato glorioso fatto di successi e innovazioni."
      ],
      "nota": "Spesso usato con valore valutativo (passato oscuro, passato illustre), riferito a persone o istituzioni."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Preparazione alimentare ottenuta cuocendo e setacciando o frullando verdure o legumi fino a ottenere una crema omogenea.",
      "examples": [
        "A pranzo ho preparato un passato di verdure caldo e profumato.",
        "Il passato di piselli è perfetto come primo piatto leggero."
      ],
      "nota": "Tipica preparazione della cucina italiana, distinta dalla vellutata per la consistenza e il metodo di preparazione."
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene a un momento o a un periodo di tempo anteriore a quello attuale; che non esiste o non accade più nel presente.",
      "examples": [
        "Negli anni passati la situazione era molto diversa.",
        "Le settimane passate sono state particolarmente intense."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di alimento o bevanda, che ha superato il periodo ottimale di consumo, risultando alterato o deteriorato.",
      "examples": [
        "Il latte è passato, meglio buttarlo via.",
        "Questo vino sa di passato, non è buono da bere."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, che ha superato una certa età o uno stadio di piena vitalità; avanzato negli anni o sfiorito.",
      "examples": [
        "È una donna passata, ma conserva ancora molta eleganza.",
        "A cinquant'anni passati ha deciso di cambiare vita."
      ],
      "nota": "Nell'espressione 'X anni passati' indica un'età superata; da solo può avere una connotazione lievemente negativa."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di colore o tessuto, che ha perso vivacità o intensità a causa dell'uso o dell'esposizione prolungata alla luce.",
      "examples": [
        "Le tende sono un po' passate, bisognerebbe cambiarle.",
        "Indossava una giacca di un blu passato che le stava benissimo."
      ],
      "nota": null
    },
    {
      "pos": "verbo (participio passato di 'passare')",
      "definition": "Forma nominale del verbo 'passare', usata nelle costruzioni di tempi composti e nella formazione del passivo.",
      "examples": [
        "È passato molto tempo da quando ci siamo visti l'ultima volta.",
        "La proposta è stata passata all'esame della commissione."
      ],
      "nota": "Come participio passato entra nelle costruzioni con gli ausiliari 'essere' e 'avere'."
    }
  ]
