  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Corrispondere una somma di denaro in cambio di un bene, un servizio o come adempimento di un debito.",
      "examples": [
        "Ho pagato il meccanico per la riparazione dell'auto.",
        "Devi pagare il conto entro fine mese."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sostenere la spesa di qualcosa per sé o per altri, sborsando il relativo importo.",
      "examples": [
        "Ti pago io la cena, non preoccuparti.",
        "Ha pagato il biglietto del treno a tutta la famiglia."
      ],
      "nota": "Si distingue dal senso precedente perché l'oggetto diretto è la cosa acquistata, non il destinatario del pagamento."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Versare la retribuzione dovuta a qualcuno in cambio di un lavoro svolto.",
      "examples": [
        "L'azienda paga i dipendenti il 27 di ogni mese.",
        "Il cliente non ha ancora pagato il consulente per il progetto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo/intransitivo",
      "definition": "Subire le conseguenze negative di un errore, una colpa o una scelta, a volte senza averle direttamente causate.",
      "examples": [
        "Ha pagato cara la sua ingenuità.",
        "Alla fine pagano sempre gli innocenti."
      ],
      "nota": "Uso figurato. Spesso accompagnato dall'avverbio 'caro' o da un complemento che indica il prezzo metaforico."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Risultare conveniente o vantaggioso, dare un ritorno positivo.",
      "examples": [
        "Investire nella formazione paga sempre nel lungo periodo.",
        "La sua strategia ha pagato: ora è il capo dell'azienda."
      ],
      "nota": "Uso figurato. Equivale a 'essere redditizio' o 'dare frutti'."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Procurarsi qualcosa a proprie spese o come soddisfazione personale, spesso con valore intensivo.",
      "examples": [
        "Si è pagato le vacanze con i risparmi di un anno.",
        "Almeno pagatevi un caffè dopo tutto questo lavoro."
      ],
      "nota": "Il riflessivo aggiunge un'accezione di beneficio diretto per il soggetto."
    }
  ]
