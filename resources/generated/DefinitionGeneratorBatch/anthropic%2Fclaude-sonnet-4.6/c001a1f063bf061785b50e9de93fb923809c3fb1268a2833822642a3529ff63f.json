  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "La stella attorno alla quale orbita la Terra, principale fonte di luce e calore per il pianeta.",
      "examples": [
        "Il sole tramonta all'orizzonte tingendo il cielo di rosso.",
        "D'estate il sole sorge molto presto e tramonta tardi."
      ],
      "nota": "Scritto con l'iniziale maiuscola (Sole) quando utilizzato in contesto astronomico per indicare la stella del sistema solare."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La luce e il calore emessi da tale stella, percepiti sulla superficie terrestre.",
      "examples": [
        "Oggi c'è un sole bellissimo, usciamo a fare una passeggiata.",
        "Mi sono seduta sul balcone a prendere il sole per un'ora."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona o cosa che rappresenta una fonte di gioia, di calore affettivo o di luce nella vita di qualcuno.",
      "examples": [
        "Quel bambino è il sole della mia vita.",
        "Lei è entrata nella stanza ed era come se fosse apparso il sole."
      ],
      "nota": "Uso figurato con forte connotazione affettiva e iperbolica."
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Unico nel suo genere, senza altri della stessa categoria; non accompagnato da nessuno.",
      "examples": [
        "È rimasto il solo superstite dell'incidente.",
        "Vivo da sola da anni e mi trovo benissimo."
      ],
      "nota": "In questa accezione il lemma è propriamente 'solo/sola', forma aggettivale che può essere usata anche come avverbio e pronome. Il singolo lemma 'sole' come aggettivo è la forma del maschile plurale ('i soli candidati rimasti') o può occorrere in espressioni fisse."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Quinta nota della scala musicale diatonica, corrispondente alla nota Sol nella solmisazione tradizionale.",
      "examples": [
        "La canzone inizia con un lungo sole tenuto dal soprano.",
        "Nel solfeggio si impara a riconoscere il sole prima del la."
      ],
      "nota": "Termine usato nel linguaggio della solmisazione (do, re, mi, fa, sol, la, si); 'sole' è la denominazione estesa di 'sol'."
    }
  ]
