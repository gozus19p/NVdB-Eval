  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Animale vertebrato a sangue caldo, con corpo ricoperto di piume, arti anteriori trasformati in ali e becco corneo, generalmente capace di volare.",
      "examples": [
        "Un uccello si è posato sul davanzale della finestra e ha cominciato a cantare.",
        "Gli uccelli migratori percorrono migliaia di chilometri ogni anno per raggiungere climi più caldi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Organo genitale maschile esterno; pene. Uso volgare e informale.",
      "examples": [
        "Il comico ha fatto una battuta volgare sull'uccello che ha fatto ridere tutta la platea.",
        "Certi graffiti nei bagni pubblici raffigurano un uccello stilizzato."
      ],
      "nota": "Uso eufemistico-volgare molto diffuso nel parlato colloquiale e nell'umorismo popolare. Equivalente a termini come 'cazzo' o 'pisello', ma con registro leggermente meno marcato."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona sciocca, ingenua o di scarsa intelligenza. Uso figurato e spregiativo.",
      "examples": [
        "Non fare l'uccello: ti hanno fregato in modo palese e tu non te n'eri neanche accorto.",
        "Quell'uccello ha firmato il contratto senza nemmeno leggerlo."
      ],
      "nota": "Usato prevalentemente nell'espressione 'fare l'uccello' o come epiteto. Meno comune rispetto agli altri sensi; tende a comparire in contesti colloquiali o dialettalmente influenzati."
    }
  ]
