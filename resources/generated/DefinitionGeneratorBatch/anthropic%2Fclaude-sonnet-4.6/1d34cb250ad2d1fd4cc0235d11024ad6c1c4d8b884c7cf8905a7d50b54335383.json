  },
  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova a breve distanza nello spazio rispetto a un punto di riferimento.",
      "examples": [
        "Il supermercato è molto vicino a casa mia, ci vogliono cinque minuti a piedi.",
        "Siediti vicino alla finestra per avere più luce."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si colloca a breve distanza nel tempo, imminente o prossimo.",
      "examples": [
        "Le vacanze estive sono ormai vicine e non vedo l'ora di partire.",
        "Con l'esame così vicino, non riesco a rilassarmi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha affinità, somiglianza o consonanza con qualcuno o qualcosa sul piano delle idee, dei valori o dei sentimenti.",
      "examples": [
        "Mi sento molto vicina alle posizioni di quel partito sul tema ambientale.",
        "In questo momento difficile, tengo a farti sapere che ti sono vicino."
      ],
      "nota": "In contesti emotivi o solidaristici assume una valenza affettiva e di supporto morale."
    },
    {
      "pos": "avverbio",
      "definition": "A breve distanza, in prossimità di un luogo o di una persona.",
      "examples": [
        "Non stare troppo vicino allo schermo, fa male agli occhi.",
        "Abita qui vicino, puoi andare a trovarlo a piedi."
      ],
      "nota": null
    },
    {
      "pos": "preposizione",
      "definition": "In prossimità di, accanto a; introduce un complemento di luogo indicando adiacenza o prossimità.",
      "examples": [
        "Si è seduto vicino a me durante la cerimonia.",
        "Hanno costruito una nuova scuola vicino al parco comunale."
      ],
      "nota": "Usato come preposizione impropria, regge il complemento con la preposizione 'a': 'vicino a'."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che abita in un luogo adiacente o prossimo al proprio, tipicamente nello stesso edificio o nella stessa zona.",
      "examples": [
        "I miei vicini di casa fanno spesso feste rumorose il sabato sera.",
        "Ho chiesto alla vicina di annaffiare le piante mentre sono in vacanza."
      ],
      "nota": "Spesso usato nella forma 'vicino di casa' per specificare la relazione abitativa."
    }
  ]
