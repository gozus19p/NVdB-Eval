  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Collocare nuovamente qualcosa nel posto in cui si trovava prima o in un luogo determinato.",
      "examples": [
        "Dopo averlo letto, rimise il libro sullo scaffale.",
        "Rimetti il latte in frigo prima che si scaldi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Indossare di nuovo un indumento o un accessorio.",
      "examples": [
        "Non riusciva a rimettere le scarpe dopo la lunga camminata, i piedi erano troppo gonfi.",
        "Ha rimesso il cappotto perché fuori si era alzato il vento."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Restituire qualcosa a qualcuno; riconsegnare.",
      "examples": [
        "Il testimone ha rimesso i documenti al giudice.",
        "Ti rimetto la chiave di casa ora che ho finito."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Affidare o demandare una questione, una decisione o una responsabilità a qualcuno o a qualcosa.",
      "examples": [
        "Rimetto la scelta finale a te, non voglio influenzarti.",
        "La controversia è stata rimessa all'arbitrato internazionale."
      ],
      "nota": "Frequente nel linguaggio giuridico e burocratico nel senso di 'deferire'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Condonare o perdonare una colpa, un debito o un'offesa.",
      "examples": [
        "Il creditore gli ha rimesso il debito per motivi umanitari.",
        "Nel Padre Nostro si chiede di rimettere i peccati."
      ],
      "nota": "Uso prevalente in contesti religiosi o formali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Perdere denaro o altro valore in seguito a una transazione, a un'attività o a una situazione sfavorevole.",
      "examples": [
        "Con quell'affare ho rimesso cinquemila euro.",
        "Alla fine ci ha rimesso sia il tempo che la pazienza."
      ],
      "nota": "In questo senso si usa spesso con complemento diretto come 'rimetterci', nella forma pronominale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inviare o spedire qualcosa o qualcuno.",
      "examples": [
        "Gli hanno rimesso la convocazione per posta raccomandata.",
        "Il medico di base lo ha rimesso dallo specialista."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Provocare il vomito; mandare fuori dallo stomaco il contenuto ingerito.",
      "examples": [
        "Il bambino ha rimesso tutto il pranzo.",
        "Dopo il lungo viaggio in barca ha rimesso per il mal di mare."
      ],
      "nota": "Equivalente colloquiale di 'vomitare'."
    },
    {
      "pos": "verbo riflessivo (rimettersi)",
      "definition": "Tornare a uno stato di salute normale dopo una malattia o un malessere.",
      "examples": [
        "Si è rimessa bene dopo l'operazione.",
        "Ci ha messo qualche settimana, ma alla fine si è rimesso dall'influenza."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (rimettersi)",
      "definition": "Iniziare nuovamente a svolgere un'attività o a trovarsi in una determinata condizione.",
      "examples": [
        "Si è rimesso a studiare il piano dopo anni di pausa.",
        "Appena smise di piovere, ci siamo rimessi in cammino."
      ],
      "nota": "Si costruisce con la preposizione 'a' seguita dall'infinito."
    },
    {
      "pos": "verbo riflessivo (rimettersi)",
      "definition": "Affidarsi completamente al giudizio, alla volontà o alla decisione di qualcuno.",
      "examples": [
        "Mi rimetto completamente al tuo parere.",
        "Si è rimessa alla decisione del tribunale senza opporre resistenza."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (rimettersi)",
      "definition": "Tornare a instaurare un rapporto sentimentale con qualcuno dopo una separazione.",
      "examples": [
        "Si sono rimessi insieme dopo sei mesi di lontananza.",
        "Non riesce a capacitarsi del fatto che si sia rimessa con lui."
      ],
      "nota": "Uso colloquiale tipico del parlato contemporaneo."
    }
  ]
