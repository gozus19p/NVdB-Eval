  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha il colore del sangue o del fuoco, corrispondente alla lunghezza d'onda più lunga dello spettro visibile.",
      "examples": [
        "Ha comprato una macchina rossa fiammante.",
        "Le foglie in autunno diventano rosse e gialle."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di capelli, di colore che va dall'arancio acceso al castano ramato.",
      "examples": [
        "Mia sorella è rossa di capelli e ha la pelle chiarissima.",
        "Il personaggio aveva una lunga chioma rossa che la rendeva inconfondibile."
      ],
      "nota": "In questo uso si riferisce esclusivamente al colore dei capelli umani e si distingue dalla tinta generica rossa."
    },
    {
      "pos": "aggettivo",
      "definition": "Che presenta arrossamento della pelle per infiammazione, imbarazzo, sforzo fisico o esposizione al caldo.",
      "examples": [
        "Aveva gli occhi rossi dopo aver pianto tutta la notte.",
        "Tornò dalla corsa con il viso rosso per la fatica."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di orientamento politico di sinistra o comunista; relativo a movimenti, partiti o idee socialiste e comuniste.",
      "examples": [
        "Negli anni Settanta quella zona era considerata una città rossa.",
        "Il sindacato rosso organizzò uno sciopero generale."
      ],
      "nota": "Uso figurato con connotazione politica, storicamente legato al simbolo del comunismo internazionale. Può avere valenza positiva o negativa a seconda del contesto e dell'interlocutore."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il colore caratterizzato dalla lunghezza d'onda più lunga dello spettro visibile, simile a quello del sangue o del fuoco.",
      "examples": [
        "Il rosso è il colore della passione per eccellenza.",
        "Dipinse il tramonto con varie sfumature di rosso e arancio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Vino prodotto da uve a bacca nera, caratterizzato da una colorazione che va dal rubino al granato.",
      "examples": [
        "Con la bistecca preferisco un buon rosso toscano.",
        "Il cameriere ci ha consigliato un rosso corposo della casa."
      ],
      "nota": "Forma abbreviata di 'vino rosso', ampiamente diffusa nell'uso parlato e nella ristorazione."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Segnale luminoso di colore rosso nel semaforo, che impone l'obbligo di fermarsi.",
      "examples": [
        "Ha bruciato un rosso in pieno centro ed è stato multato.",
        "Aspetta, c'è ancora il rosso."
      ],
      "nota": "Forma ellittica di 'semaforo rosso' o 'luce rossa', di uso corrente nel parlato."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che ha capelli di colore rosso o ramato.",
      "examples": [
        "Da bambino lo prendevano in giro perché era un rosso.",
        "Quella rossa in fondo alla sala è mia cugina."
      ],
      "nota": "Uso colloquiale e talvolta informale; al femminile 'rossa'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione di deficit finanziario, situazione in cui le uscite superano le entrate.",
      "examples": [
        "L'azienda è andata in rosso per il terzo anno consecutivo.",
        "Con tutte queste spese siamo finiti in rosso sul conto corrente."
      ],
      "nota": "Usato quasi esclusivamente nella locuzione 'in rosso', per analogia con la tradizionale prassi contabile di segnare i debiti in rosso."
    }
  ]
