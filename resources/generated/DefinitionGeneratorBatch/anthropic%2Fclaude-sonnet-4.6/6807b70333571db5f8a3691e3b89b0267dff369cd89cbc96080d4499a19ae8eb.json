  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Elemento sottile e flessibile di materiale filato (cotone, lana, seta, nylon o simili), usato per cucire, tessere o legare.",
      "examples": [
        "Ha infilato il filo nell'ago per ricucire il bottone della camicia.",
        "Il sarto scelse un filo di seta per rifinire l'abito da sera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Conduttore elettrico rivestito di isolante, usato per trasmettere corrente o segnali.",
      "examples": [
        "Il tecnico ha collegato i fili del circuito con molta precisione.",
        "Attenzione: c'è un filo scoperto dietro alla presa della corrente."
      ],
      "nota": "In contesti tecnologici si distingue da 'cavo', che indica un insieme di più fili racchiusi in una guaina."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Elemento metallico molto sottile e allungato, ricavato da metalli duttili come ferro, rame o acciaio.",
      "examples": [
        "Ha usato del filo di ferro per fissare i rami della pianta al sostegno.",
        "La recinzione era fatta di filo spinato arrugginito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte tagliente di una lama, di un coltello o di uno strumento da taglio.",
      "examples": [
        "Il filo di questo coltello è ancora affilato dopo anni di uso.",
        "Bisogna fare attenzione al filo della lama quando si affila la roncola."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sottile quantità continua di un liquido o di un materiale che scorre o cade in modo tenue.",
      "examples": [
        "Aggiungi un filo d'olio extravergine sulla bruschetta prima di servire.",
        "Dal rubinetto usciva appena un filo d'acqua."
      ],
      "nota": "Ricorrente nelle locuzioni culinarie 'un filo d'olio', 'un filo d'aceto'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sequenza logica o narrativa che collega eventi, idee o argomenti, garantendo coerenza e continuità.",
      "examples": [
        "Ho perso il filo del discorso dopo tutte quelle interruzioni.",
        "Il romanzo mantiene un filo conduttore chiaro dall'inizio alla fine."
      ],
      "nota": "Uso figurato; frequente nella locuzione 'filo conduttore' e nell'espressione 'perdere il filo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Quantità minima o debole presenza di qualcosa di immateriale, come voce, luce, speranza.",
      "examples": [
        "Rispose con un filo di voce, esausta dopo l'operazione.",
        "Restava ancora un filo di speranza che tornasse a casa sano e salvo."
      ],
      "nota": "Uso figurato con valore attenuativo; si costruisce tipicamente con 'un filo di + sostantivo astratto'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Direzione delle fibre in un tessuto o nel legno, determinante per il taglio o la lavorazione.",
      "examples": [
        "Taglia il tessuto nel verso del filo per evitare che si sfrangi.",
        "Il falegname ha lavorato il legno seguendo il filo della venatura."
      ],
      "nota": null
    }
  ]
