  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di particelle solide e gassose prodotte dalla combustione incompleta di una sostanza, visibile come nube scura o grigia che si disperde nell'aria.",
      "examples": [
        "Il fumo del camino si alzava lento nel cielo invernale.",
        "L'incendio ha riempito l'appartamento di fumo denso e acre."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Atto e abitudine di aspirare e rilasciare il vapore prodotto dalla combustione di tabacco o altre sostanze, tramite sigarette, sigari o pipe.",
      "examples": [
        "Il fumo fa molto male alla salute dei polmoni.",
        "Ha smesso con il fumo dopo vent'anni di sigarette."
      ],
      "nota": "In questo senso è frequentemente usato in contesti di salute pubblica e campagne preventive."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Vapore acqueo o esalazione gassosa visibile che si sprigiona da liquidi caldi, sostanze chimiche o terreni umidi, simile per aspetto al fumo di combustione.",
      "examples": [
        "Il fumo della pentola in ebollizione appannava i vetri della cucina.",
        "Dalla bocca degli speleologi usciva il fumo del respiro nell'aria gelida della grotta."
      ],
      "nota": "In senso stretto non si tratta di prodotto di combustione, ma l'uso del termine è corrente e consolidato."
    },
    {
      "pos": "sostantivo m. (figurato)",
      "definition": "Cosa priva di sostanza reale, apparenza ingannevole o vanteria senza fondamento.",
      "examples": [
        "Le sue promesse erano solo fumo: non ha mai mantenuto nulla.",
        "Quella proposta di lavoro si è rivelata tutto fumo e niente arrosto."
      ],
      "nota": "Usato spesso nella locuzione 'fumo negli occhi' (ingannare, abbindolare) e nel proverbio 'molto fumo e poco arrosto'."
    },
    {
      "pos": "sostantivo m. (colloquiale)",
      "definition": "Sostanza stupefacente da fumare, in particolare hashish o marijuana.",
      "examples": [
        "La polizia ha trovato del fumo nascosto nello zaino.",
        "In certi ambienti giovanili il fumo circola con facilità."
      ],
      "nota": "Uso gergale e colloquiale, largamente diffuso nell'italiano informale contemporaneo."
    }
  ]
