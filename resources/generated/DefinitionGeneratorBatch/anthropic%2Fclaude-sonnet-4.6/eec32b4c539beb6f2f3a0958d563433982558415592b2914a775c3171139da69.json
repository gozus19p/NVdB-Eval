  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova nello stato della materia caratterizzato da volume proprio definito ma forma variabile, capace di scorrere e adattarsi al contenitore.",
      "examples": [
        "L'azoto liquido viene usato per conservare campioni biologici a bassissima temperatura.",
        "A temperatura ambiente il mercurio è l'unico metallo liquido."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di suono o voce, chiaro, fluente e melodioso, privo di asperità.",
      "examples": [
        "La cantante aveva una voce liquida che scorreva senza sforzo tra le note.",
        "Il violino emetteva un suono liquido e cristallino nella sala vuota."
      ],
      "nota": "Uso figurato per analogia con la fluidità del liquido."
    },
    {
      "pos": "aggettivo",
      "definition": "In ambito economico-finanziario, riferito a patrimonio, denaro o bene immediatamente disponibile o convertibile in contante senza perdita di valore rilevante.",
      "examples": [
        "L'azienda non ha abbastanza risorse liquide per far fronte ai debiti a breve termine.",
        "Preferisco tenere una parte del patrimonio in forma liquida per eventuali emergenze."
      ],
      "nota": "Contrapposto a 'illiquido'; in questo senso si usa spesso anche la forma sostantivata 'liquidità'."
    },
    {
      "pos": "aggettivo",
      "definition": "In fonetica, riferito a consonanti (tipicamente /l/ e /r/) caratterizzate da un flusso d'aria relativamente libero e da una sonorità simile alle vocali.",
      "examples": [
        "Le consonanti liquide come la 'l' e la 'r' sono presenti in quasi tutte le lingue del mondo.",
        "I bambini tendono ad acquisire le consonanti liquide più tardi rispetto alle occlusive."
      ],
      "nota": "Termine tecnico della fonologia, ma d'uso corrente nei manuali di linguistica e nella didattica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza che si trova nello stato liquido, in grado di scorrere e di assumere la forma del recipiente che la contiene.",
      "examples": [
        "Bevi molti liquidi durante la giornata, soprattutto in estate.",
        "Il medico ha raccomandato di evitare liquidi freddi dopo l'intervento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Somma di denaro contante o facilmente realizzabile, disponibile immediatamente.",
      "examples": [
        "Non ho liquido con me, posso pagare con il bancomat?",
        "L'imprenditore cercava liquidità fresca per finanziare il nuovo progetto."
      ],
      "nota": "Uso colloquiale e finanziario; spesso intercambiabile con 'contante' nel parlato quotidiano."
    }
  ]
