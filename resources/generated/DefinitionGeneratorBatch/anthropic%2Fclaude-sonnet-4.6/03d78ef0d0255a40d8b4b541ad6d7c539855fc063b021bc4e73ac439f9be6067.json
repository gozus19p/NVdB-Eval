  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Transazione o attività commerciale finalizzata al guadagno o a un vantaggio economico.",
      "examples": [
        "Hanno concluso un affare vantaggioso con una società straniera.",
        "Il mercato immobiliare offre buoni affari in questo periodo."
      ],
      "nota": "Spesso usato al plurale ('affari') per indicare l'insieme delle attività economiche e commerciali di una persona o azienda."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Acquisto conveniente, cosa ottenuta a un prezzo favorevole rispetto al suo valore reale.",
      "examples": [
        "Ho trovato questo divano a metà prezzo: che affare!",
        "Al mercatino delle pulci si possono fare ottimi affari."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Faccenda, questione o situazione che richiede attenzione o che coinvolge qualcuno.",
      "examples": [
        "Questa è una faccenda complicata, un affare da risolvere con calma.",
        "Non immischiarti in affari che non ti riguardano."
      ],
      "nota": "In questo senso è frequente l'espressione 'fatti i fatti tuoi' in alternativa a 'non è un affare tuo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Cosa, oggetto o elemento di cui non si vuole o non si riesce a specificare la natura, usato in modo generico o elusivo.",
      "examples": [
        "Cos'è quell'affare strano sul tavolo?",
        "Dammi quell'affare lì, quello per aprire le bottiglie."
      ],
      "nota": "Uso colloquiale, talvolta con connotazione leggermente spregiativa o di indifferenza verso l'oggetto in questione."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Vicenda o episodio di rilievo, spesso con implicazioni pubbliche, politiche o giudiziarie.",
      "examples": [
        "L'affare Dreyfus sconvolse la Francia di fine Ottocento.",
        "I giornali continuano a parlare dell'affare legato ai fondi neri."
      ],
      "nota": "In questo senso si avvicina al francesismo 'affaire', ed è spesso usato con un nome proprio per indicare uno scandalo o un caso celebre."
    }
  ]
