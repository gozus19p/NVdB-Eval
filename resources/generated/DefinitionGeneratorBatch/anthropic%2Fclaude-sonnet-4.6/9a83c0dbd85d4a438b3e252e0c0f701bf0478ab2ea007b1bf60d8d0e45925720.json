  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere qualcosa in cambio di denaro o di altra forma di pagamento; comprare.",
      "examples": [
        "Ho acquistato un nuovo computer online a un ottimo prezzo.",
        "La famiglia ha acquistato una casa in periferia dopo anni di affitto."
      ],
      "nota": "È il termine più formale e neutro rispetto a 'comprare', frequente in contesti commerciali, legali e scritti."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere, guadagnare o raggiungere qualcosa di non materiale attraverso uno sforzo, un'esperienza o il trascorrere del tempo.",
      "examples": [
        "Con gli anni ha acquistato una grande esperienza nel settore.",
        "Il progetto ha acquistato credibilità grazie ai risultati ottenuti."
      ],
      "nota": "In questo senso figurato il complemento oggetto è tipicamente un'entità astratta come fiducia, fama, esperienza, importanza."
    },
    {
      "pos": "verbo intransitivo / riflessivo (acquistarsi)",
      "definition": "Migliorare nel proprio aspetto, nel proprio valore o nell'impressione che si produce sugli altri.",
      "examples": [
        "Con quel taglio di capelli ha acquistato molto.",
        "Il dipinto si acquista guardandolo da lontano."
      ],
      "nota": "In questo uso il verbo è spesso intransitivo assoluto o riflessivo e si accompagna talvolta all'avverbio 'molto'."
    }
  ]
