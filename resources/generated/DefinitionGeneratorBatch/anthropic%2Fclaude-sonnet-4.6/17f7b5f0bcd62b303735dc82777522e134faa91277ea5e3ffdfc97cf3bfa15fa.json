  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte inferiore di un oggetto o struttura su cui essa poggia e che la sostiene.",
      "examples": [
        "La base della colonna è decorata con motivi floreali.",
        "Il vaso ha una base larga che lo rende stabile."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme degli iscritti o sostenitori ordinari di un'organizzazione, partito o associazione, distinti dai dirigenti.",
      "examples": [
        "La base del partito ha protestato contro la decisione dei vertici.",
        "Il sindacato deve ascoltare la propria base prima di prendere decisioni importanti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Struttura militare o logistica attrezzata e permanente da cui si operano missioni o si coordinano attività.",
      "examples": [
        "I soldati sono rientrati alla base dopo la missione.",
        "La base aerea è situata a pochi chilometri dalla città."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Elemento fondamentale su cui si costruisce o si fonda qualcosa di astratto, come un ragionamento, una teoria o un progetto.",
      "examples": [
        "La fiducia reciproca è la base di ogni buon rapporto.",
        "Questo studio pone le basi per ulteriori ricerche nel settore."
      ],
      "nota": "In questo senso compare spesso al plurale: 'porre le basi', 'gettare le basi'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In matematica, lato o faccia di una figura geometrica su cui si calcola l'altezza; oppure, in un sistema di numerazione, il numero di cifre distinte utilizzate.",
      "examples": [
        "Per calcolare l'area del triangolo, moltiplica la base per l'altezza e dividi per due.",
        "Il sistema binario usa la base due."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In chimica, sostanza capace di accettare protoni o di cedere ioni idrossido in soluzione, opposta a un acido.",
      "examples": [
        "Il bicarbonato di sodio è una base debole.",
        "Le basi hanno generalmente un pH superiore a sette."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ingrediente o componente principale di un preparato cosmetico, alimentare o farmaceutico su cui si aggiungono altri elementi.",
      "examples": [
        "Questa crema ha una base idratante arricchita con vitamina E.",
        "Usa una base neutra per diluire il colorante alimentare."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che costituisce il punto di partenza, l'elemento fondamentale o il livello minimo di riferimento.",
      "examples": [
        "Il salario base previsto dal contratto è di 1.200 euro mensili.",
        "Il modello base dell'auto non include i cerchi in lega."
      ],
      "nota": "Usato in posizione postnominale e con valore attributivo; non si flette al plurale quando è invariabile in funzione di modificatore nominale (es. 'prezzi base', 'modelli base')."
    },
    {
      "pos": "preposizione (locuzione: in base a)",
      "definition": "Secondo, conformemente a, tenendo conto di.",
      "examples": [
        "In base ai risultati ottenuti, decideremo il passo successivo.",
        "Il rimborso viene calcolato in base alle spese effettivamente sostenute."
      ],
      "nota": "La locuzione prepositiva 'in base a' è molto frequente nell'italiano burocratico e giornalistico."
    }
  ]
