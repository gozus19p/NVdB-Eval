  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha un'altezza ridotta rispetto alla norma o a un punto di riferimento; che si trova a poca distanza dal suolo o da un livello di riferimento.",
      "examples": [
        "Il soffitto di quella stanza è troppo basso per appendere un lampadario grande.",
        "Volavano basso, rasente i tetti delle case."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a suoni o voci, che ha una frequenza grave, profonda.",
      "examples": [
        "Aveva una voce bassa e roca che incuteva rispetto.",
        "Il contrabbasso produce note molto basse."
      ],
      "nota": "Si contrappone ad 'alto' o 'acuto' in ambito musicale e fonetico."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di quantità, valore o intensità, che si colloca a un livello inferiore rispetto alla media o a un punto di riferimento.",
      "examples": [
        "I prezzi sono bassi in questo periodo di saldi.",
        "Il tasso di disoccupazione è ai minimi storici, ancora più basso del previsto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di qualità morale o comportamento, che denota meschinità, volgarità o disonestà.",
      "examples": [
        "È stato un gesto basso e ignobile tradire così la sua fiducia.",
        "Non abbassarti a certi metodi bassi pur di vincere."
      ],
      "nota": "Uso figurato con connotazione fortemente negativa sul piano etico."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a posizione sociale o estrazione, che appartiene agli strati meno privilegiati della società.",
      "examples": [
        "Proveniva da una famiglia di bassa estrazione sociale.",
        "Nel Medioevo, il popolo basso aveva pochissimi diritti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di testa o sguardo, rivolto verso il basso in segno di vergogna, timidezza o umiliazione.",
      "examples": [
        "Se ne andò a testa bassa dopo la sconfitta.",
        "Rispose con gli occhi bassi, senza guardarlo in faccia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La parte inferiore di qualcosa; la zona o il punto più vicino al suolo o al fondo.",
      "examples": [
        "Scrivi il tuo nome in basso a destra nel foglio.",
        "Il basso della parete era umido e scrostato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In musica, la voce o lo strumento che produce i suoni più gravi all'interno di un ensemble o di una composizione.",
      "examples": [
        "Il basso del gruppo rock aveva uno stile inconfondibile.",
        "Nel quartetto d'archi, il violoncello svolge spesso il ruolo del basso."
      ],
      "nota": "Può riferirsi sia alla voce umana (basso baritono, basso profondo) sia allo strumento (basso elettrico, contrabbasso)."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Cantante di sesso maschile con la tessitura vocale più grave.",
      "examples": [
        "Quel basso ha interpretato magistralmente il ruolo di Mefistofele.",
        "Cercavano un basso per completare il coro della cattedrale."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "A un livello di altezza ridotto; verso il basso o a poca distanza dal suolo.",
      "examples": [
        "L'aereo stava volando basso a causa della fitta nebbia.",
        "Parla più basso, qui c'è gente che dorme."
      ],
      "nota": "In questo uso avverbiale può modificare verbi di moto, posizione o di produzione sonora."
    }
  ]
}