  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha il colore della neve o del latte, corrispondente alla riflessione di tutte le componenti della luce visibile.",
      "examples": [
        "Indossava una camicia bianca inamidata alla perfezione.",
        "Le cime delle montagne erano bianche di neve."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di capelli o barba, privo di pigmentazione, di colore molto chiaro tendente al bianco per effetto dell'età o di altri fattori.",
      "examples": [
        "Mio nonno ha i capelli completamente bianchi da anni.",
        "A quarant'anni aveva già la barba quasi bianca."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, appartenente al gruppo etnico di pelle chiara, di origine europea.",
      "examples": [
        "La popolazione del quartiere è prevalentemente bianca.",
        "Il film affronta i rapporti tra comunità nere e bianche negli Stati Uniti."
      ],
      "nota": "Uso descrittivo in contesti sociali, demografici e storici. Può avere connotazioni ideologiche in certi contesti."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di vino, ottenuto da uve a bacca bianca o vinificato senza macerazione con le bucce, di colore giallo paglierino o dorato.",
      "examples": [
        "Preferisco il vino bianco con il pesce.",
        "Hanno aperto una bottiglia di bianco fresco per l'aperitivo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di scrittura, stampa o segni grafici; non compilato.",
      "examples": [
        "Ha consegnato il foglio bianco senza rispondere a nessuna domanda.",
        "Lascia la casella bianca se non vuoi esprimere una preferenza."
      ],
      "nota": "In ambito elettorale, 'voto in bianco' indica una scheda non contrassegnata, distinta dalla scheda nulla."
    },
    {
      "pos": "aggettivo",
      "definition": "Figurato. Privo di contenuto, vuoto, privo di significato o di pensieri.",
      "examples": [
        "Dopo lo choc ha avuto dei momenti di mente bianca, incapace di ragionare.",
        "Entrando in scena ebbe un attimo di panico: la memoria era completamente bianca."
      ],
      "nota": "Usato frequentemente nell'espressione 'andare in bianco' nel senso di dimenticare tutto, avere un vuoto di memoria."
    },
    {
      "pos": "aggettivo",
      "definition": "Figurato. Detto di notte, trascorsa senza dormire.",
      "examples": [
        "Ha passato una notte bianca a studiare per l'esame.",
        "Dopo tante notti bianche in ospedale era esausto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Figurato. Detto di periodo o settimana, privo di attività sessuale o di relazioni sentimentali con esito negativo.",
      "examples": [
        "È tornato dal viaggio e ha detto che è andata in bianco.",
        "Dopo mesi in bianco ha finalmente conosciuto qualcuno di interessante."
      ],
      "nota": "Uso colloquiale, quasi sempre nella costruzione 'andare in bianco'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il colore corrispondente alla riflessione totale della luce, opposto al nero.",
      "examples": [
        "Il bianco è il colore della pace in molte culture occidentali.",
        "Quella stanza dipinta di bianco sembra molto più grande."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio vuoto, non scritto o non stampato, all'interno di un testo o documento.",
      "examples": [
        "Compila i bianchi del modulo con i tuoi dati personali.",
        "Lasciare un bianco tra un paragrafo e l'altro migliora la leggibilità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di etnia a pelle chiara, di origine europea.",
      "examples": [
        "La storia del Sudafrica è segnata dalle tensioni tra bianchi e neri.",
        "Era uno dei pochi bianchi nel quartiere."
      ],
      "nota": "Uso descrittivo in contesti storici e sociologici."
    },
    {
      "pos": "sostantivo m.",
