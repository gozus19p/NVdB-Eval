  "senses": [
    {
      "pos": "avverbio",
      "definition": "Nella parte anteriore, nel lato che precede o si trova di fronte rispetto a un punto di riferimento.",
      "examples": [
        "Siediti davanti, così vedi meglio il palco.",
        "Il negozio ha una bella vetrina davanti."
      ],
      "nota": "Si oppone a 'dietro'. Può riferirsi a posizione nello spazio o in una sequenza."
    },
    {
      "pos": "preposizione",
      "definition": "Di fronte a qualcosa o qualcuno, in posizione anteriore rispetto a un elemento esplicitamente indicato.",
      "examples": [
        "Ti aspetto davanti alla stazione alle otto.",
        "Si fermò davanti allo specchio per sistemarsi i capelli."
      ],
      "nota": "Usato con valore prepositivo nella costruzione 'davanti a + sintagma nominale'."
    },
    {
      "pos": "preposizione (figurato)",
      "definition": "In presenza di qualcuno, di fronte a una situazione, un'autorità o una responsabilità.",
      "examples": [
        "Davanti al giudice non disse una parola.",
        "Davanti a una scelta così difficile, non sapeva cosa fare."
      ],
      "nota": "Uso figurato che indica confronto, responsabilità o contesto valutativo, non una posizione fisica."
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Che si trova nella parte anteriore di qualcosa; relativo alla faccia o al lato frontale.",
      "examples": [
        "I sedili davanti dell'auto sono più comodi.",
        "Le zampe davanti del cane erano ferite."
      ],
      "nota": "Uso postpositivo e invariabile; tipico del parlato informale come alternativa a 'anteriore'."
    }
  ]
