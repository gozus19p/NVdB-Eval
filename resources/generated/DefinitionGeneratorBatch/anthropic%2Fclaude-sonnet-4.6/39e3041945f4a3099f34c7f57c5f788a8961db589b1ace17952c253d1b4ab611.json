  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Trasferire qualcosa dalla propria disponibilità a quella di un'altra persona, consegnandolo fisicamente.",
      "examples": [
        "Dammi la penna, per favore.",
        "Ha dato il pacco al corriere prima di uscire."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Concedere, accordare qualcosa di non materiale come un permesso, un'opportunità o un diritto.",
      "examples": [
        "Il professore ci ha dato la possibilità di rifare il compito.",
        "Ti do il permesso di uscire prima."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Produrre o causare un effetto, una sensazione o uno stato in qualcuno.",
      "examples": [
        "Questo rumore mi dà fastidio.",
        "La notizia ci ha dato una grande gioia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Assegnare un giudizio, un voto, una valutazione a qualcuno o qualcosa.",
      "examples": [
        "Il giudice ha dato dieci anni di reclusione all'imputato.",
        "La commissione gli ha dato trenta con lode."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Attribuire a qualcuno un'età, una qualità o una caratteristica in base a una stima soggettiva.",
      "examples": [
        "Non gli darei più di quarant'anni.",
        "Le danno sempre dell'esagerata, ma stavolta aveva ragione."
      ],
      "nota": "In questo senso il verbo introduce spesso un complemento di specificazione introdotto da 'di' quando si attribuisce una qualità negativa: 'darle dell'esagerata'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Organizzare o tenere un evento sociale come una festa, un ricevimento o uno spettacolo.",
      "examples": [
        "Stasera danno un concerto in piazza.",
        "Hanno dato una grande festa per il loro anniversario."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Proiettare o trasmettere un film, uno spettacolo o un programma televisivo.",
      "examples": [
        "Al cinema sotto casa danno un film di Sorrentino.",
        "Stasera in televisione danno la partita in chiaro."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere orientato o affacciato verso una direzione o uno spazio.",
      "examples": [
        "La finestra del salotto dà sul cortile interno.",
        "Il balcone dà direttamente sul mare."
      ],
      "nota": "Regge la preposizione 'su' o 'in'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Tendere verso un determinato colore o sfumatura cromatica.",
      "examples": [
        "Questo verde dà un po' al blu.",
        "Il suo cappotto dà sul marrone."
      ],
      "nota": "Regge la preposizione 'sul' o 'al'."
    },
