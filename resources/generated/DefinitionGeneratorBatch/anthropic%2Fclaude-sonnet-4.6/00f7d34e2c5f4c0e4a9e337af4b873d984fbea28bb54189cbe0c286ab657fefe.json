  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Titolo nobiliare di rango elevato, spettante a chi appartiene alla famiglia reale o a chi detiene per nascita o concessione sovrana un titolo ereditario superiore al duca.",
      "examples": [
        "Il principe Carlo ha partecipato alla cerimonia ufficiale.",
        "Nella storia d'Europa molti principi governavano territori autonomi."
      ],
      "nota": "Può indicare anche il sovrano di uno Stato di dimensioni ridotte detto principato, come nel caso del principe di Monaco."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Figura maschile protagonista delle fiabe, tradizionalmente rappresentata come giovane valoroso destinato a salvare o sposare la principessa.",
      "examples": [
        "La bambina sognava di essere salvata da un principe.",
        "Nella favola il principe trasforma il ranocchio con un bacio."
      ],
      "nota": "In questo senso ricorre spesso nella locuzione 'principe azzurro', usata anche figuratamente per indicare un partner ideale e romantico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Chi occupa una posizione di assoluta eccellenza o preminenza in un campo, considerato il massimo rappresentante di una categoria o disciplina.",
      "examples": [
        "Dante è universalmente riconosciuto come il principe dei poeti italiani.",
        "Viene considerato il principe degli avvocati penalisti del suo tempo."
      ],
      "nota": "Uso figurato con valore superlativo; segue tipicamente la struttura 'principe dei/delle + sostantivo plurale'."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di ciò che è principale, fondamentale o più importante rispetto ad altri elementi dello stesso tipo; usato in posizione prenominale.",
      "examples": [
        "Questo è il problema principe che dobbiamo affrontare.",
        "La questione principe del dibattito riguarda la sostenibilità ambientale."
      ],
      "nota": "In funzione aggettivale è invariabile e si usa prevalentemente in contesti formali o giornalistici, sempre anteposto al sostantivo."
    }
  ]
