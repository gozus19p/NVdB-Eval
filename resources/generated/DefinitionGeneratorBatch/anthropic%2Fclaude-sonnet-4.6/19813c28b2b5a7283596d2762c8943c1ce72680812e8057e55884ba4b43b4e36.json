  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che va oltre la norma o la routine ordinaria; non previsto o non regolare nel funzionamento consueto.",
      "examples": [
        "Il consiglio di amministrazione ha convocato una seduta straordinaria per affrontare la crisi.",
        "Il treno straordinario è stato aggiunto per far fronte all'afflusso di turisti."
      ],
      "nota": "Si contrappone direttamente a 'ordinario'. Frequente in contesti burocratici e amministrativi: assemblea straordinaria, sessione straordinaria, manutenzione straordinaria."
    },
    {
      "pos": "aggettivo",
      "definition": "Che supera di gran lunga il livello comune per qualità, intensità o eccellenza; fuori dal comune in senso positivo.",
      "examples": [
        "Ha dato una performance straordinaria che ha conquistato tutto il pubblico.",
        "È un uomo di straordinaria intelligenza, capace di risolvere problemi complessi in pochi minuti."
      ],
      "nota": "In questo senso ha valore valutativo positivo e si avvicina a sinonimi come 'eccezionale', 'eccellente', 'magnifico'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lavoro svolto al di fuori dell'orario contrattuale previsto, generalmente retribuito con una maggiorazione.",
      "examples": [
        "Questo mese ho fatto molti straordinari e la busta paga è più alta del solito.",
        "L'azienda non vuole pagare gli straordinari ai dipendenti che rimangono oltre l'orario."
      ],
      "nota": "Usato quasi sempre al plurale ('gli straordinari') nel senso di ore di lavoro aggiuntivo retribuito. Al singolare è meno comune ma possibile: 'il compenso per lo straordinario'."
    }
  ]
