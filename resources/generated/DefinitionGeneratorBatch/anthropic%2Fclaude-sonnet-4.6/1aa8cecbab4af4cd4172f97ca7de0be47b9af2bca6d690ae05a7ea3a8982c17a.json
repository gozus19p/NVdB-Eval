  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dividere o separare un materiale in due o più parti mediante uno strumento affilato o un mezzo meccanico.",
      "examples": [
        "Taglia il pane a fette prima di portarlo in tavola.",
        "Il chirurgo ha dovuto tagliare il tessuto per accedere all'organo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ridurre la lunghezza, la dimensione o la quantità di qualcosa attraverso il taglio, come capelli, unghie, erba o simili.",
      "examples": [
        "Mi sono tagliata i capelli dal parrucchiere ieri.",
        "Devi tagliare l'erba del giardino, è cresciuta troppo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ferire involontariamente una parte del corpo con un oggetto tagliente.",
      "examples": [
        "Mi sono tagliato un dito mentre affettavo il prosciutto.",
        "Attento al vetro rotto, potresti tagliarti."
      ],
      "nota": "Spesso usato in forma riflessiva (tagliarsi)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eliminare o sopprimere una parte di un testo, un discorso, un film o altro contenuto.",
      "examples": [
        "Il regista ha deciso di tagliare l'ultima scena del film.",
        "L'editore mi ha chiesto di tagliare almeno tremila parole dall'articolo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ridurre fondi, risorse, spese o personale in ambito economico o organizzativo.",
      "examples": [
        "L'azienda ha tagliato i costi di produzione del venti per cento.",
        "Il governo ha annunciato che taglierà i fondi alla ricerca pubblica."
      ],
      "nota": "Uso figurato diffuso in contesti economici, politici e aziendali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Attraversare in diagonale o in modo trasversale uno spazio, un percorso o una linea.",
      "examples": [
        "La strada taglia la pianura da nord a sud.",
        "Abbiamo tagliato i campi per arrivare prima al paese."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Mescolare una sostanza con un'altra per diluirla o adulterarla, riducendone la concentrazione o la purezza.",
      "examples": [
        "Quel vino è stato tagliato con acqua.",
        "Gli investigatori hanno scoperto che la droga era stata tagliata con sostanze pericolose."
      ],
      "nota": "Usato sia in ambito enologico che, con connotazione negativa, per sostanze stupefacenti."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nel gioco delle carte, dividere il mazzo prima della distribuzione.",
      "examples": [
        "Prima di distribuire le carte, il giocatore alla sinistra del mazziere deve tagliare.",
        "Taglia il mazzo e poi vediamo chi inizia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere bruscamente un rapporto, un contatto o una comunicazione con qualcuno.",
      "examples": [
        "Dopo la lite ha tagliato tutti i ponti con la famiglia.",
        "L'ha tagliato fuori dalla sua vita senza dargli spiegazioni."
      ],
      "nota": "Uso figurato; spesso in costruzioni come 'tagliare i ponti' o 'tagliare fuori'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Prendere una scorciatoia o deviare da un percorso per abbreviare il tragitto.",
      "examples": [
        "Se tagli per il vicolo arrivi prima alla stazione.",
        "Abbiamo tagliato per i campi e abbiamo guadagnato mezz'ora."
      ],
      "nota": "Costruzione intransitiva con complemento introdotto da 'per'."
    }
  ]
}