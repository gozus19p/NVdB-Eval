  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Flusso continuo di un fluido, come acqua o aria, che si sposta in una direzione determinata.",
      "examples": [
        "La corrente del fiume era così forte che rendeva impossibile nuotare controcorrente.",
        "Una corrente d'aria fredda entrava dalla finestra aperta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Flusso di cariche elettriche attraverso un conduttore, misurato in ampere.",
      "examples": [
        "Non toccare il filo scoperto: c'è corrente!",
        "Il cortocircuito ha interrotto la corrente in tutto il palazzo."
      ],
      "nota": "In contesto domestico, 'corrente' può riferirsi genericamente all'energia elettrica erogata dalla rete."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Tendenza, movimento o orientamento culturale, politico, artistico o ideologico condiviso da un gruppo.",
      "examples": [
        "Il cubismo fu una delle correnti artistiche più rivoluzionarie del Novecento.",
        "All'interno del partito si scontravano due correnti con visioni molto diverse."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene al momento presente, al periodo in corso; che è in uso abituale e comune.",
      "examples": [
        "Il mese corrente ha visto un aumento significativo delle temperature.",
        "Nel linguaggio corrente, il termine ha assunto un significato diverso da quello originario."
      ],
      "nota": "Nella locuzione 'conto corrente' indica un tipo di conto bancario operativo ad uso quotidiano."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di qualcuno che è al corrente di qualcosa, cioè informato e aggiornato riguardo a una situazione o notizia.",
      "examples": [
        "Non ero corrente degli ultimi sviluppi della vicenda.",
        "Tienimi corrente su come si evolve la situazione."
      ],
      "nota": "In questo senso è quasi sempre usato nella costruzione 'essere/tenere/tenersi corrente (di)'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo fluente e senza esitazioni, riferito alla capacità di parlare o leggere una lingua.",
      "examples": [
        "Parla corrente il francese dopo aver vissuto due anni a Parigi.",
        "Legge corrente anche testi molto complessi."
      ],
      "nota": "Uso prevalentemente informale e regionale; più comune la forma avverbiale 'correntemente'."
    }
  ]
}