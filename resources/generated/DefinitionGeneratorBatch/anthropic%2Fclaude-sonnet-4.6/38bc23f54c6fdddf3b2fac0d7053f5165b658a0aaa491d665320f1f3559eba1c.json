  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Emettere grida acute e forti, alzando molto la voce per dolore, paura, rabbia o grande agitazione.",
      "examples": [
        "Il bambino ha cominciato a urlare appena ha visto il cane avvicinarsi.",
        "Urlava dal dolore mentre aspettava i soccorsi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dire qualcosa ad altissima voce, gridando con forza.",
      "examples": [
        "Gli urlò in faccia tutte le sue frustrazioni accumulate negli anni.",
        "La folla urlava il nome del cantante a squarciagola."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre un suono forte, acuto e prolungato, detto di animali o fenomeni naturali.",
      "examples": [
        "I lupi urlavano nella notte fredda.",
        "Il vento urlava tra i rami degli alberi durante la tempesta."
      ],
      "nota": "Estensione del senso primario a soggetti non umani; il soggetto animale prototipico è il lupo o il cane."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Stridere visivamente in modo fastidioso, detto di colori o elementi grafici che non si armonizzano tra loro.",
      "examples": [
        "Quel rosso acceso urla con il verde del divano.",
        "I due motivi geometrici urlano e rendono il design caotico."
      ],
      "nota": "Uso figurato per indicare un contrasto estetico stridente; comune nel linguaggio della moda, del design e dell'arredamento."
    }
  ]
