  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Norma o principio che prescrive un comportamento, stabilisce un obbligo o definisce il corretto svolgimento di un'attività.",
      "examples": [
        "È vietato fumare in ufficio: questa è una regola che tutti devono rispettare.",
        "Le regole del gioco vanno spiegate ai bambini prima di iniziare la partita."
      ],
      "nota": "Può riferirsi a norme giuridiche, sociali, sportive, grammaticali o di qualsiasi altro ambito normativo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Principio generale ricavato dall'osservazione di un fenomeno, che ne descrive il funzionamento costante o tendenziale.",
      "examples": [
        "In italiano esiste la regola per cui i sostantivi maschili in -o formano il plurale in -i.",
        "La regola dell'offerta e della domanda governa i mercati liberi."
      ],
      "nota": "In questo senso la regola è descrittiva (descrive come qualcosa funziona) più che prescrittiva."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ordine, misura e metodo nel fare qualcosa; modo corretto e disciplinato di procedere.",
      "examples": [
        "Vive con regola: si alza ogni mattina alla stessa ora e non salta mai i pasti.",
        "Bisogna fare le cose con regola, senza fretta né disordine."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di norme che disciplinano la vita di una comunità religiosa.",
      "examples": [
        "I monaci benedettini seguono la regola di san Benedetto.",
        "Ogni ordine monastico si distingue per la propria regola."
      ],
      "nota": "Uso prevalentemente religioso, riferito agli ordini monastici e religiosi."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strumento lungo e sottile, di legno o metallo, usato per tracciare linee rette o misurare distanze.",
      "examples": [
        "Traccia la linea con la regola per assicurarti che sia perfettamente dritta.",
        "Ho bisogno di una regola da trenta centimetri per questo disegno tecnico."
      ],
      "nota": "In questo senso è sinonimo di 'righello'. L'uso è più comune in contesti tecnici e scolastici."
    }
  ]
