    },
    {
      "pos": "sostantivo m.",
      "definition": "Evento improvviso e traumatico di natura fisica o emotiva che provoca uno shock o un danno grave.",
      "examples": [
        "La notizia della sua morte è stata un colpo durissimo per tutta la famiglia.",
        "Perdere quel contratto è stato un brutto colpo per l'azienda."
      ],
      "nota": "Uso figurato, frequente in contesti emotivi o economici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Attacco improvviso di una malattia o di un malore acuto.",
      "examples": [
        "Il nonno ha avuto un colpo apoplettico e lo hanno ricoverato d'urgenza.",
        "Con questo caldo rischi di prenderti un colpo."
      ],
      "nota": "Spesso usato in locuzioni come 'colpo apoplettico', 'colpo di calore', 'colpo di sole'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Gesto o movimento rapido e preciso compiuto con uno strumento o una parte del corpo in ambito espressivo o artigianale.",
      "examples": [
        "Con pochi colpi di pennello terminò il ritratto.",
        "Sistemò la situazione con un colpo di telefono."
