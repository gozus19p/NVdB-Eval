  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Guardare intensamente e a lungo qualcosa o qualcuno senza distogliere lo sguardo.",
      "examples": [
        "Il bambino fissava la vetrina del negozio di giocattoli senza smettere.",
        "Lei lo fissò negli occhi per qualche secondo prima di rispondere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rendere stabile o immobile qualcosa, applicandola o ancorandola saldamente a una superficie o struttura.",
      "examples": [
        "Ha fissato il quadro al muro con due chiodi.",
        "Bisogna fissare la corda al palo prima di procedere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Stabilire in modo definitivo una data, un orario, un prezzo o un accordo.",
      "examples": [
        "Hanno fissato la riunione per giovedì prossimo alle dieci.",
        "Il contratto fissa le condizioni di pagamento entro trenta giorni."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Prenotare o riservare in anticipo un posto, una camera, un appuntamento.",
      "examples": [
        "Ho fissato un tavolo al ristorante per sabato sera.",
        "Ti conviene fissare l'appuntamento dal medico con qualche giorno di anticipo."
      ],
      "nota": "In questo senso è sinonimo di 'prenotare' e 'riservare', con uso prevalente nel parlato quotidiano."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Imprimere stabilmente nella memoria o nella mente un concetto, un ricordo o un'immagine.",
      "examples": [
        "Cercava di fissare nella memoria ogni dettaglio di quel momento.",
        "Ripetere ad alta voce aiuta a fissare le informazioni."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Concentrarsi in modo ossessivo o insistente su qualcosa o qualcuno, sviluppando un'idea fissa.",
      "examples": [
        "Si è fissato con l'idea di cambiare lavoro e non parla d'altro.",
        "Non fissarti su quel dettaglio, non è così importante."
      ],
      "nota": "In questo senso ha una connotazione negativa, indicando un'attenzione eccessiva e irrazionale; è sinonimo colloquiale di 'ossessionarsi'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "In fotografia e in chimica, trattare un materiale sensibile con sostanze apposite per rendere permanente un'immagine o un preparato.",
      "examples": [
        "Il fotografo ha fissato il negativo in camera oscura.",
        "Per fissare il preparato sul vetrino è necessario usare un apposito reagente."
      ],
      "nota": "Uso tecnico-specialistico diffuso in ambito fotografico e chimico."
    }
  ]
