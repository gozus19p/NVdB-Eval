  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Situazione in cui due o più persone si trovano nello stesso luogo, casualmente o per accordo, entrando in contatto diretto.",
      "examples": [
        "È stato un incontro casuale: non ci vedevamo da anni.",
        "L'incontro con il vecchio amico mi ha fatto molto piacere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Riunione o appuntamento organizzato tra persone per discutere, negoziare o svolgere un'attività comune.",
      "examples": [
        "Il ministro ha partecipato a un incontro con i rappresentanti sindacali.",
        "L'incontro di lavoro è fissato per le dieci di domani mattina."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Competizione sportiva tra due atleti o squadre avversarie.",
      "examples": [
        "L'incontro di pugilato si è concluso al quinto round.",
        "La squadra ha vinto l'incontro di calcio per tre a uno."
      ],
      "nota": "Particolarmente frequente negli sport da combattimento e nel calcio."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Esperienza, anche interiore o culturale, che determina un cambiamento significativo nella vita di qualcuno.",
      "examples": [
        "Il suo incontro con la filosofia orientale ha trasformato il suo modo di vedere il mondo.",
        "Quell'incontro con la morte lo aveva reso un uomo diverso."
      ],
      "nota": "Uso figurato, con valore trasformativo o esistenziale."
    },
    {
      "pos": "preposizione / locuzione preposizionale",
      "definition": "Usato nella locuzione 'incontro a', indica direzione verso qualcosa o qualcuno, oppure disposizione favorevole.",
      "examples": [
        "Andò incontro agli ospiti per accoglierli sulla soglia.",
        "L'azienda è venuta incontro alle richieste dei lavoratori."
      ],
      "nota": "Ricorre principalmente nelle locuzioni 'andare incontro a' (muoversi verso / affrontare qualcosa) e 'venire incontro a' (agevolare, soddisfare esigenze altrui)."
    },
    {
      "pos": "avverbio",
      "definition": "In direzione di chi si avvicina; verso la persona o la cosa che viene.",
      "examples": [
        "Appena lo vide, gli corse incontro esultante.",
        "Il cane le venne incontro scodinzolando."
      ],
      "nota": "In questa funzione avverbiale si accompagna quasi sempre a verbi di moto come 'andare', 'venire', 'correre'."
    }
  ]
