  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Accompagnare o portare qualcuno o qualcosa da un luogo a un altro, guidandone il movimento.",
      "examples": [
        "L'infermiera ha condotto il paziente in sala operatoria.",
        "Il cane da pastore conduce il gregge verso il pascolo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Guidare un veicolo o un mezzo di trasporto.",
      "examples": [
        "Conduce un camion da oltre vent'anni senza mai avere un incidente.",
        "È necessaria la patente speciale per condurre un autobus di linea."
      ],
      "nota": "Uso formale o tecnico; nel parlato comune è più frequente 'guidare'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dirigere o gestire un'attività, un'impresa o un'istituzione.",
      "examples": [
        "Conduce l'azienda di famiglia con grande competenza.",
        "Per anni ha condotto le trattative diplomatiche tra i due paesi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Presentare e moderare una trasmissione televisiva, radiofonica o un evento pubblico.",
      "examples": [
        "Conduce il telegiornale della sera da quasi dieci anni.",
        "Una famosa giornalista condurrà la cerimonia di premiazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Svolgere o portare avanti un'indagine, una ricerca o un'operazione in modo sistematico.",
      "examples": [
        "Gli inquirenti stanno conducendo indagini approfondite sull'accaduto.",
        "Il team di ricerca conduce esperimenti sul campo da tre anni."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Portare o sboccare in un determinato luogo, detto di una strada, un percorso o un passaggio.",
      "examples": [
        "Questa strada conduce direttamente al centro storico.",
        "Tutti i sentieri del bosco conducono alla stessa radura."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (figurato)",
      "definition": "Portare a un risultato, a una situazione o a una conseguenza, detto di azioni o circostanze.",
      "examples": [
        "Un'alimentazione scorretta può condurre a gravi problemi di salute.",
        "Non sapeva che quella scelta lo avrebbe condotto alla rovina."
      ],
      "nota": "In questo uso figurato il verbo è spesso seguito dalla preposizione 'a'."
    },
    {
      "pos": "verbo riflessivo (condursi)",
      "definition": "Comportarsi o agire in un determinato modo, specialmente in senso morale o sociale.",
      "examples": [
        "Si è sempre condotto con onestà e rispetto verso gli altri.",
        "Bisogna sapersi condurre con professionalità in qualsiasi ambiente di lavoro."
      ],
      "nota": "Uso formale o letterario; nel parlato comune è sostituito da 'comportarsi'."
    }
  ]
}