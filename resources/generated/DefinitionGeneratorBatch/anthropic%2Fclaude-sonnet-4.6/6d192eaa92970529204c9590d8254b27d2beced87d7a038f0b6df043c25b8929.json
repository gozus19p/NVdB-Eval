  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Esercitare una forza su qualcosa o qualcuno per avvicinarlo a sé o spostarlo nella direzione del soggetto.",
      "examples": [
        "Tira la corda verso di te per aprire il cancello.",
        "Il bambino tirava la mamma per la manica per attirare la sua attenzione."
      ],
      "nota": "Contrario di 'spingere'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Scagliare o lanciare un oggetto con forza in una direzione.",
      "examples": [
        "Ha tirato una pietra contro la finestra.",
        "I ragazzi tiravano palline di neve nel cortile."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Tracciare una linea o un segno su una superficie.",
      "examples": [
        "Tira una riga sotto le parole più importanti.",
        "Il geometra ha tirato una linea di demarcazione sul terreno."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Stendere o allungare un materiale applicando tensione, come pasta, metallo o altro.",
      "examples": [
        "La nonna tirava la sfoglia con il mattarello.",
        "In fonderia tirano il metallo in fili sottilissimi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Estrarre qualcosa da un contenitore, da un luogo o da una posizione chiusa.",
      "examples": [
        "Ha tirato fuori il portafoglio dalla tasca.",
        "Tirò la spada dal fodero con un gesto deciso."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sparare con un'arma da fuoco o scoccare un proiettile.",
      "examples": [
        "Il cecchino tirò un colpo preciso.",
        "Durante l'addestramento imparano a tirare al bersaglio."
      ],
      "nota": "In questo senso è frequente anche la costruzione intransitiva 'tirare su un bersaglio'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Detto del vento, soffiare con una certa intensità.",
      "examples": [
        "Oggi tira un vento gelido da nord.",
        "In montagna tirava forte e faceva difficoltà a camminare."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a un camino, canna fumaria o simili, aspirare aria e favorire la combustione.",
      "examples": [
        "Il camino tira bene da quando è stato pulito.",
        "Se la canna fumaria non tira, la stufa fa fumo in casa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere molto richiesto o riscuotere successo sul mercato o tra il pubblico.",
      "examples": [
        "In questo periodo i romanzi gialli tirano moltissimo.",
        "Quel tipo di prodotto non tira più come una volta."
      ],
      "nota": "Uso colloquiale e figurato."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a un indumento o a un tessuto, risultare troppo stretto o aderente, causando tensione.",
      "examples": [
        "Questa giacca tira un po' sulle spalle, forse è troppo piccola.",
        "I pantaloni tirano in vita dopo le feste."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Spostarsi o sottrarsi rispetto a una posizione o a una situazione, allontanandosi.",
      "examples": [
        "Si è tirato indietro all'ultimo momento, lasciando tutti senza risposta.",
        "Quando ci sono le responsabilità si tira sempre fuori."
      ],
      "nota": "Nelle locuzioni 'tirarsi indietro' o 'tirarsi fuori' assume il significato figurato di sottrarsi a un impegno o a una responsabilità."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Fare in modo che qualcuno o qualcosa sia coinvolto o trascinato in una situazione.",
      "examples": [
        "Non tirarmi in mezzo alle vostre discussioni.",
        "Ha tirato tutti dentro a un affare rischioso."
      ],
      "nota": "Uso figurato, spesso con valore negativo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nel calcio e in altri sport, effettuare un calcio o un tiro verso la porta o verso un obiettivo.",
      "examples": [
        "L'attaccante ha tirato in porta da fuori area.",
        "Ha tirato il rigore e ha segnato."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Condurre o tendere verso una determinata direzione o meta, in senso fisico o figurato.",
      "examples": [
        "Quella strada tira verso il centro del paese.",
        "La sua inclinazione naturale tirava verso la musica."
      ],
      "nota": null
    }
  ]
