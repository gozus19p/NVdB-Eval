  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di parole o locuzioni che formano un'unità lessicale o fraseologica con un significato specifico.",
      "examples": [
        "«Prendere in giro» è un'espressione idiomatica molto comune in italiano.",
        "Ha usato un'espressione tecnica che pochi nel pubblico riuscivano a capire."
      ],
      "nota": "In linguistica si distingue tra espressione idiomatica (il cui significato non è composizionale) ed espressione libera."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Atto del comunicare pensieri, sentimenti o idee attraverso il linguaggio, la scrittura, il corpo o l'arte.",
      "examples": [
        "La danza è per lei la forma di espressione più spontanea e autentica.",
        "La libertà di espressione è un diritto fondamentale garantito dalla Costituzione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Manifestazione visibile di uno stato d'animo o di un'emozione sul volto di una persona.",
      "examples": [
        "Aveva un'espressione stanca e preoccupata quando è entrato in ufficio.",
        "Dal suo viso leggeva un'espressione di sorpresa mista a soddisfazione."
      ],
      "nota": "In questo senso è sinonimo parziale di 'mimica facciale' o 'aria del viso'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In matematica, combinazione di simboli, numeri e operatori che rappresenta una quantità o una relazione formale.",
      "examples": [
        "Semplifica l'espressione algebrica prima di procedere con il calcolo.",
        "L'espressione (a+b)² si espande in a²+2ab+b²."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Qualità interpretativa e intensità emotiva con cui un brano musicale o una performance artistica viene eseguita.",
      "examples": [
        "Il maestro chiese agli allievi di suonare con più espressione e meno meccanicità.",
        "La cantante ha dato una prova di grande espressione nel secondo atto dell'opera."
      ],
      "nota": "Usato frequentemente in ambito musicale e teatrale per indicare la capacità di trasmettere emozioni attraverso l'interpretazione."
    }
  ]
