  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Inseguire e catturare o uccidere animali selvatici a scopo alimentare, sportivo o di controllo della fauna.",
      "examples": [
        "Ogni autunno mio zio va a cacciare cinghiali in Maremma.",
        "I falconieri cacciano la selvaggina usando rapaci addestrati."
      ],
      "nota": "Può essere usato anche in forma assoluta (intransitivo): 'andare a cacciare'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Allontanare qualcuno o qualcosa con forza o in modo brusco da un luogo o da una situazione.",
      "examples": [
        "Il proprietario ha cacciato fuori i clienti molesti prima della chiusura.",
        "L'hanno cacciata dall'ufficio senza nemmeno darle il tempo di raccogliere le sue cose."
      ],
      "nota": "Sinonimo di 'buttare fuori', 'scacciare'; implica un atto di espulsione coatta."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Introdurre o infilare qualcosa in un posto, spesso con forza o in modo rapido.",
      "examples": [
        "Ha cacciato le chiavi in tasca e se n'è andato di corsa.",
        "Cerca di cacciarti quell'idea in testa una volta per tutte."
      ],
      "nota": "Uso colloquiale, frequente con i pronomi riflessivi (cacciarsi) o con complementi di luogo."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Finire o trovarsi in una situazione difficile o scomoda, spesso per propria imprudenza.",
      "examples": [
        "Come ti sei cacciato in un guaio simile?",
        "Si è cacciata nei pasticci cercando di fare tutto da sola."
      ],
      "nota": "Costruzione tipicamente colloquiale; quasi sempre seguita da espressioni che indicano situazioni negative ('cacciarsi nei guai', 'cacciarsi in un casino')."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Nascondersi o intrufolarsi in un luogo, spostandosi in modo da essere difficilmente trovabile.",
      "examples": [
        "Dove si sarà cacciato il gatto? Non lo trovo da stamattina.",
        "I bambini si erano cacciati sotto il letto per non farsi vedere."
      ],
      "nota": "Uso colloquiale; indica spesso uno spostamento involontario o furtivo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Emettere o tirare fuori qualcosa, in particolare un suono o una somma di denaro.",
      "examples": [
        "Ha cacciato un urlo che si è sentito in tutto il palazzo.",
        "Alla fine ha dovuto cacciar fuori i soldi per pagare il danno."
      ],
      "nota": "Uso idiomatico e colloquiale; 'cacciare fuori i soldi' equivale a 'sborsare', spesso con riluttanza."
    }
  ]
