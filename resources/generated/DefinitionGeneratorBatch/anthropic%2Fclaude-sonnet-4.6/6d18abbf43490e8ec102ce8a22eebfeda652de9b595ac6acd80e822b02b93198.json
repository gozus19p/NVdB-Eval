  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che la Chiesa cattolica ha formalmente riconosciuto come degna di venerazione per la santità della propria vita e per la vicinanza a Dio, iscrivendola nell'albo ufficiale dei santi.",
      "examples": [
        "San Francesco d'Assisi è uno dei santi più amati della tradizione cristiana.",
        "La cattedrale è dedicata alla santa patrona della città."
      ],
      "nota": "Al femminile: santa. La forma tronca 'san' si usa davanti a nomi maschili che iniziano per consonante (san Pietro, san Marco), mentre 'santo' si mantiene davanti a s impura, z, x (santo Stefano). Abbreviazioni: S., SS. (plurale)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di grande bontà, pazienza e generosità, che sopporta senza lamentarsi situazioni difficili o il comportamento altrui.",
      "examples": [
        "Mia madre è una santa: ha sopportato tutto senza mai dire una parola.",
        "Ci vuole la pazienza di un santo per lavorare con lui."
      ],
      "nota": "Uso figurato e iperbolico, spesso in espressioni come 'avere la pazienza di un santo' o 'essere un santo'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che possiede o manifesta perfezione morale e spirituale, privo di colpa o peccato secondo i principi religiosi.",
      "examples": [
        "Conduceva una vita santa, dedita alla preghiera e alle opere di carità.",
        "Nella tradizione cristiana, Maria è considerata la donna più santa tra tutte."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene alla sfera del sacro o è consacrato al culto religioso; che ha carattere di sacralità.",
      "examples": [
        "La Settimana Santa precede la Pasqua.",
        "Il Venerdì Santo è giorno di digiuno e astinenza per i cattolici."
      ],
      "nota": "In questo senso precede sempre il sostantivo e si riferisce a luoghi, tempi, oggetti o testi sacri (Terra Santa, Spirito Santo, Sacra Scrittura)."
    },
    {
      "pos": "aggettivo",
      "definition": "Usato in senso enfatico o intensificativo per sottolineare il valore positivo di qualcosa o per esprimere sollievo, approvazione o esasperazione.",
      "examples": [
        "Finalmente un santo giorno di riposo dopo settimane di lavoro intenso.",
        "Non riesce a stare zitto un santo momento."
      ],
      "nota": "Uso colloquiale e intensificativo, spesso in contesti esclamativi o in costruzioni negative. Precede sempre il sostantivo."
    }
  ]
