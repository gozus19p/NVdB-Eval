  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di dimensioni notevoli, con volume o massa superiore alla norma.",
      "examples": [
        "Ha comprato un grosso televisore per il salotto.",
        "Nel giardino cresceva un grosso albero di quercia."
      ],
      "nota": "Contrario di 'piccolo'. Si distingue da 'grande' per l'enfasi sulla corpulenza o spessore piuttosto che sull'estensione."
    },
    {
      "pos": "aggettivo",
      "definition": "Di peso corporeo elevato, sovrabbondante rispetto alla corporatura media.",
      "examples": [
        "Da quando ha smesso di fare sport è diventato molto grosso.",
        "Il cane è grosso ma buonissimo di carattere."
      ],
      "nota": "Riferito a persone o animali; può avere connotazione neutra o leggermente spregiativa a seconda del contesto."
    },
    {
      "pos": "aggettivo",
      "definition": "Di importanza, entità o gravità rilevante; significativo o serio.",
      "examples": [
        "Abbiamo un grosso problema da risolvere entro domani.",
        "È un grosso errore ignorare questi segnali d'allarme."
      ],
      "nota": "Uso figurato molto comune nell'italiano contemporaneo."
    },
    {
      "pos": "aggettivo",
      "definition": "Di calibro o spessore marcato, detto di fili, corde, tessuti o simili.",
      "examples": [
        "Usa del filo grosso per cucire quella stoffa pesante.",
        "La corda grossa reggeva tutto il peso del carico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di mare o vento, particolarmente agitato o intenso.",
      "examples": [
        "Il mare era grosso e le barche rimasero in porto.",
        "Con questo vento grosso è meglio non uscire in barca."
      ],
      "nota": "Uso tecnico-marinaresco diventato di uso comune."
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di raffinatezza o sottigliezza; rozzo, approssimativo.",
      "examples": [
        "Ha un carattere grosso, dice sempre quello che pensa senza tatto.",
        "È una barzelletta grossa, non adatta a tutti."
      ],
      "nota": "In questa accezione si avvicina a 'volgare' o 'grezzo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte principale o più consistente di qualcosa.",
      "examples": [
        "Il grosso del lavoro è già stato fatto.",
        "Il grosso delle truppe era già partito all'alba."
      ],
      "nota": "Quasi sempre preceduto dall'articolo determinativo 'il'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Antica moneta d'argento di valore elevato in uso nel Medioevo europeo.",
      "examples": [
        "Nel documento medievale si parlava di pagamenti in grossi veneziani.",
        "Il grosso tornese era una delle monete più diffuse nel XIII secolo."
      ],
      "nota": "Accezione storico-numismatica, ancora attestata in contesti specialistici e scolastici."
    }
  ]
