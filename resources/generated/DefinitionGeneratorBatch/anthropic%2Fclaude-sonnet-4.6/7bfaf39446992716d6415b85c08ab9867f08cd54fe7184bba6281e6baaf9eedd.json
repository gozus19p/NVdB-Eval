  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Veicolo a motore più pesante dell'aria, dotato di ali fisse, capace di volare trasportando persone o merci.",
      "examples": [
        "Ho preso l'aereo da Milano a Roma in meno di un'ora.",
        "L'aereo è atterrato con mezz'ora di ritardo a causa del maltempo."
      ],
      "nota": "Forma abbreviata di 'aeroplano'. Nell'uso corrente ha sostituito quasi completamente il termine esteso."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si trova, si svolge o si muove nell'aria o attraverso l'aria; relativo all'aviazione.",
      "examples": [
        "Il traffico aereo è in continuo aumento sulle rotte europee.",
        "Le forze aeree della coalizione hanno condotto diversi raid nella notte."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è privo di consistenza materiale, sottile e impalpabile come l'aria; leggero, etéreo.",
      "examples": [
        "La ballerina si muoveva con una grazia aerea, quasi sospesa sul palcoscenico.",
        "Le stoffe di quel sarto hanno una leggerezza aerea che le rende uniche."
      ],
      "nota": "Uso prevalentemente figurato e letterario, con connotazione estetica positiva."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di struttura o impianto che corre in quota, sospeso sopra il suolo.",
      "examples": [
        "La linea tranviaria aerea attraversa il centro storico della città.",
        "I cavi aerei del teleferico erano visibili da lontano contro il cielo sereno."
      ],
      "nota": "In questo senso si contrappone a 'sotterraneo' o 'interrato'."
    }
  ]
