  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che corrisponde alla metà esatta di qualcosa; pari alla metà di una quantità o unità considerata intera.",
      "examples": [
        "Ho bevuto mezzo bicchiere di vino.",
        "Aspetta mezzo minuto, arrivo subito."
      ],
      "nota": "Precede il sostantivo senza articolo proprio; si distingue da 'metà' che è sostantivo."
    },
    {
      "pos": "aggettivo",
      "definition": "Non del tutto, parzialmente; in modo incompleto o approssimativo.",
      "examples": [
        "Era mezzo addormentato quando è arrivata la chiamata.",
        "La stanza era mezza vuota all'inizio del concerto."
      ],
      "nota": "Uso prevalentemente predicativo o preverbale con valore di avverbio attenuativo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La metà esatta di un'unità, di una quantità o di un insieme.",
      "examples": [
        "Dammi un mezzo di pizza, ho poca fame.",
        "Il mezzo della strada era occupato da un cantiere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento, risorsa o modalità utilizzata per raggiungere uno scopo o compiere un'azione.",
      "examples": [
        "Il dialogo è il mezzo migliore per risolvere i conflitti.",
        "Ha usato ogni mezzo a sua disposizione per ottenere il lavoro."
      ],
      "nota": "Spesso usato al plurale: 'mezzi'. Si contrappone al concetto di 'fine': 'il fine giustifica i mezzi'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Veicolo o sistema di trasporto utilizzato per spostarsi da un luogo a un altro.",
      "examples": [
        "Prendo i mezzi pubblici ogni mattina per andare in ufficio.",
        "Qual è il mezzo più veloce per arrivare in centro?"
      ],
      "nota": "Frequentemente usato al plurale nella locuzione 'mezzi pubblici' per indicare bus, tram, metro ecc."
    },
    {
      "pos": "sostantivo m. (plurale)",
      "definition": "Risorse economiche e materiali di cui una persona o un'organizzazione dispone.",
      "examples": [
        "Non ha i mezzi per permettersi quell'appartamento.",
        "L'associazione opera con mezzi limitati ma ottiene grandi risultati."
      ],
      "nota": "In questo senso è quasi sempre usato al plurale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Elemento fisico o ambiente che consente la propagazione di un fenomeno, come suono, luce o onde.",
      "examples": [
        "Il suono si propaga attraverso un mezzo materiale.",
        "Il vuoto non è un mezzo adatto alla trasmissione delle onde sonore."
      ],
      "nota": "Uso prevalentemente tecnico-scientifico, ma sufficientemente diffuso nell'italiano contemporaneo."
    },
    {
      "pos": "avverbio",
      "definition": "In parte, non completamente; a metà.",
      "examples": [
        "Questo lavoro è fatto mezzo bene e mezzo male.",
        "Era mezzo convinta di accettare la proposta."
      ],
      "nota": "Spesso è difficile distinguere l'uso avverbiale da quello aggettivale predicativo; in contesti verbali si comporta da avverbio."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il punto centrale o la parte intermedia di qualcosa nello spazio o nel tempo.",
      "examples": [
        "Si è fermato nel mezzo del cortile senza dire nulla.",
        "Nel mezzo della discussione è arrivata una notizia inaspettata."
      ],
      "nota": "Ricorre frequentemente nelle locuzioni 'in mezzo a', 'nel mezzo di'."
    }
  ]
}