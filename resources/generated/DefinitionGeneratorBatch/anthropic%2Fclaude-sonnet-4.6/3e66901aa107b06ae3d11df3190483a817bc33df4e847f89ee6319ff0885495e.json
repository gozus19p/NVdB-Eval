    },
    {
      "pos": "verbo transitivo",
      "definition": "Corrompere una persona offrendole denaro o altri vantaggi affinché agisca in modo disonesto o favorevole ai propri interessi.",
      "examples": [
        "L'imprenditore aveva comprato diversi funzionari comunali per ottenere l'appalto.",
        "Nessuno riesce a comprare la sua coscienza, è un uomo integerrimo."
      ],
      "nota": "Uso figurato con connotazione negativa; implica un atto illecito o moralmente riprovevole."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Guadagnarsi qualcosa attraverso sacrificio, sforzo o un prezzo non materiale.",
      "examples": [
        "Si è comprato la fiducia del capo con anni di dedizione assoluta.",
        "Quella vittoria l'hanno comprata a caro prezzo, con mesi di allenamenti estenuanti."
      ],
      "nota": "Uso figurato, generalmente in costruzioni con complemento di prezzo metaforico come 'a caro prezzo', 'con il sudore della fronte'."
    }
