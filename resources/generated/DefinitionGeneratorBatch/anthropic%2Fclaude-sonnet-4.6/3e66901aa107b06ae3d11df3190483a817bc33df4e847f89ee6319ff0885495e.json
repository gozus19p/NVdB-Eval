  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere qualcosa in cambio di denaro, acquisire la proprietà di un bene o servizio mediante pagamento.",
      "examples": [
        "Ho comprato una nuova giacca al mercato.",
        "Dobbiamo comprare il pane prima che chiuda il forno."
      ],
