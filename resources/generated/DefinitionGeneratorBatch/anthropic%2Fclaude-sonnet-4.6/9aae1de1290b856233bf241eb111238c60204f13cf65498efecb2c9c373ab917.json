  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si presenta o si trova con scarsa frequenza; poco comune, non abbondante.",
      "examples": [
        "Il leopardo delle nevi è un animale raro, avvistato pochissime volte in natura.",
        "In questa regione le piogge sono rare durante l'estate."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che possiede qualità eccezionali o superiori alla norma; fuori del comune per valore o pregio.",
      "examples": [
        "È una persona di rara intelligenza, capace di risolvere problemi complessi in pochi minuti.",
        "Il musicista ha dimostrato un talento raro fin dalla più tenera età."
      ],
      "nota": "In questo uso il termine ha valore valutativo positivo e si applica prevalentemente a qualità astratte o capacità umane."
    },
    {
      "pos": "aggettivo",
      "definition": "Di sostanza o materiale: poco denso, non compatto; con le parti distanziate tra loro.",
      "examples": [
        "A quell'altitudine l'aria è rara e respirare diventa faticoso.",
        "La vegetazione si faceva sempre più rara man mano che ci avvicinavamo alla vetta."
      ],
      "nota": "Questo senso fisico è tipico di contesti scientifici o descrittivi riferiti ad aria, gas, atmosfera o distribuzioni spaziali."
    },
    {
      "pos": "avverbio",
      "definition": "Con scarsa frequenza; non spesso. Forma avverbiale usata in espressioni fisse.",
      "examples": [
        "Di rado si vedono ancora certi mestieri artigianali.",
        "Capita raramente, ma di raro succede qualcosa di davvero inaspettato."
      ],
      "nota": "Come avverbio autonomo è desueto; l'uso corrente preferisce 'raramente' o la locuzione 'di rado'."
    }
  ]
