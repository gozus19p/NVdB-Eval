  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Organismo vegetale, dotato in genere di radici, fusto e foglie, capace di compiere fotosintesi.",
      "examples": [
        "Ha curato con attenzione ogni pianta del suo giardino.",
        "Alcune piante tropicali non sopravvivono al freddo invernale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Rappresentazione grafica in scala di un edificio, di un territorio o di uno spazio, vista dall'alto, che ne mostra la disposizione planimetrica.",
      "examples": [
        "L'architetto ci ha mostrato la pianta dell'appartamento prima di iniziare i lavori.",
        "Sulla pianta della città sono indicati tutti i monumenti principali."
      ],
      "nota": "Da distinguere da 'prospetto' (vista frontale) e 'sezione' (vista in taglio verticale)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "La superficie inferiore del piede umano, che viene a contatto con il suolo.",
      "examples": [
        "Aveva la pianta del piede dolorante dopo ore di camminata.",
        "Il podologo ha esaminato la pianta del suo piede e ha prescritto un plantare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nella locuzione 'di sana pianta', indica qualcosa di completamente nuovo, costruito o ricominciato dall'inizio senza basarsi su nulla di preesistente.",
      "examples": [
        "Dopo l'incendio hanno dovuto ricostruire la casa di sana pianta.",
        "Ha inventato quella storia di sana pianta per non farsi sgridare."
      ],
      "nota": "Usato quasi esclusivamente nella locuzione fissa 'di sana pianta'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Documento ufficiale o registro in cui è elencato il personale in servizio in un ente, un'istituzione o un'azienda pubblica.",
      "examples": [
        "Il nuovo assunto è stato inserito in pianta stabile nell'organico dell'università.",
        "Molti lavoratori precari aspirano a entrare in pianta stabile nell'amministrazione pubblica."
      ],
      "nota": "Ricorre prevalentemente nella locuzione 'in pianta stabile', riferita a un inserimento definitivo e regolare in un organico."
    }
  ]
