  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Azione o processo di spostare persone o merci da un luogo a un altro mediante veicoli o altri mezzi.",
      "examples": [
        "Il trasporto delle merci via mare è più economico di quello aereo.",
        "I lavori in corso hanno causato gravi disagi al trasporto pubblico urbano."
      ],
      "nota": "In questa accezione si usa spesso in sintagmi come 'trasporto pubblico', 'trasporto merci', 'trasporto su rotaia', 'mezzo di trasporto'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme dei servizi, dei mezzi e delle infrastrutture organizzati per il movimento di persone o cose su un determinato territorio.",
      "examples": [
        "Il ministero dei trasporti ha annunciato nuovi investimenti per le ferrovie.",
        "La città ha potenziato il sistema di trasporto per ridurre il traffico privato."
      ],
      "nota": "In questo senso è frequente il plurale 'trasporti', spesso in contesti istituzionali e amministrativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Veicolo o convoglio concreto utilizzato per trasferire qualcosa o qualcuno in una specifica occasione.",
      "examples": [
        "Il trasporto con i feriti è arrivato all'ospedale in pochi minuti.",
        "Hanno organizzato un trasporto speciale per i pezzi di macchinario di grandi dimensioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Intenso slancio emotivo o passionale che spinge ad agire con entusiasmo e ardore; stato di coinvolgimento affettivo profondo.",
      "examples": [
        "Parlava della sua musica con un trasporto che commuoveva tutti i presenti.",
        "Si dedicò a quel progetto con trasporto, dimenticando ogni altra preoccupazione."
      ],
      "nota": "Uso figurato. Si contrappone alla freddezza o all'indifferenza; spesso accompagnato da aggettivi come 'vero', 'grande', 'sincero'."
    }
  ]
