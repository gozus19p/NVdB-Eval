  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere sporcizia, polvere o impurità da una superficie o da un oggetto, rendendolo netto e igienico.",
      "examples": [
        "Devo pulire il pavimento prima che arrivino gli ospiti.",
        "Ha pulito i vetri con un panno umido e ora si vede benissimo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Preparare un alimento eliminando le parti non commestibili, come bucce, interiora o lische.",
      "examples": [
        "Il pescivendolo ha pulito i calamari in pochi minuti.",
        "Prima di cuocere le verdure ricordati di pulirle e lavarle accuratamente."
      ],
      "nota": "Frequente in contesti culinari; equivale a 'mondare' per la verdura e 'eviscerare' per il pesce, ma è di registro più comune."
    },
    {
      "pos": "verbo transitivo",
      "definition": "In senso figurato, svuotare completamente qualcuno di denaro o beni, lasciandolo senza risorse.",
      "examples": [
        "Quella serata al casinò lo ha pulito: è tornato a casa senza un centesimo.",
        "I ladri hanno pulito l'appartamento mentre la famiglia era in vacanza."
      ],
      "nota": "Uso colloquiale e figurato; può riferirsi sia a furto sia a perdita al gioco o in affari."
    },
    {
      "pos": "verbo transitivo",
      "definition": "In senso figurato, eliminare elementi indesiderati, dannosi o corrotti da un contesto organizzativo, sociale o informatico.",
      "examples": [
        "Il nuovo direttore ha promesso di pulire l'azienda dalle irregolarità contabili.",
        "Il programma antivirus ha pulito il sistema da tutti i file infetti."
      ],
      "nota": "Comune nel linguaggio informatico (pulire il disco, pulire il registro) e in quello politico-giornalistico."
    },
    {
      "pos": "verbo riflessivo (pulirsi)",
      "definition": "Rimuovere sporcizia dal proprio corpo o da una parte di esso.",
      "examples": [
        "Si è pulita le mani con un fazzoletto dopo aver mangiato la pizza.",
        "Il bambino si è pulito la bocca con il tovagliolo."
      ],
      "nota": null
    }
  ]
