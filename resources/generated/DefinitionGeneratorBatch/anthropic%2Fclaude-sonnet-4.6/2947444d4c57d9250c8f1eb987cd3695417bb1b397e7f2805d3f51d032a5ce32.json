  "senses": [
    {
      "pos": "avverbio",
      "definition": "Particella negativa usata per rispondere negativamente a una domanda, rifiutare una proposta o contraddire un'affermazione.",
      "examples": [
        "Sei stanco? No, sto benissimo.",
        "Vuoi venire alla festa? No, grazie, ho altri impegni.",
        "Lui dice che era lì, ma io dico di no."
      ],
      "nota": "Si contrappone a 'sì'. Può essere rafforzato con espressioni come 'no di certo', 'assolutamente no', 'no davvero'."
    },
    {
      "pos": "avverbio (tag question)",
      "definition": "Usato in coda a una frase affermativa per chiedere conferma o coinvolgere l'interlocutore, equivalente a 'vero?', 'non è così?'.",
      "examples": [
        "Ci vediamo domani, no?",
        "È una bella idea, no?",
        "Hai già mangiato, no?"
      ],
      "nota": "In questa funzione ha valore interrogativo-confermativo, simile all'italiano 'vero?' o all'inglese 'right?'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Risposta negativa, diniego, rifiuto espresso con parole o gesti.",
      "examples": [
        "La sua risposta è stata un no secco.",
        "Non accetto un no come risposta.",
        "Dopo tanti no, finalmente ha ricevuto un sì."
      ],
      "nota": "Invariabile al plurale: 'i no', 'tanti no'. Può essere qualificato da aggettivi: 'no definitivo', 'no categorico'."
    },
    {
      "pos": "avverbio (correlativo)",
      "definition": "Usato nella struttura 'o... o no', 'sia... che no', 'che... o no' per indicare l'alternativa tra l'affermazione e la sua negazione.",
      "examples": [
        "Che tu voglia o no, le cose stanno così.",
        "Venga o no, la riunione si terrà lo stesso.",
        "Sia d'accordo che no, dovrà attenersi alle regole."
      ],
      "nota": null
    }
  ]
