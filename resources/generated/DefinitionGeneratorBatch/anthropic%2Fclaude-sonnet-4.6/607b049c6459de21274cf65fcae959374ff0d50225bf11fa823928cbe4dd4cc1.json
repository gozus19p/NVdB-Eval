  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova dentro qualcosa, nella parte più ritirata o centrale rispetto all'esterno.",
      "examples": [
        "La corte interna del palazzo è accessibile solo agli abitanti.",
        "Le pareti interne dell'edificio sono state ridipinte di bianco."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda la vita, l'organizzazione o le questioni proprie di un gruppo, un'istituzione o uno Stato, senza coinvolgimento esterno.",
      "examples": [
        "Il partito ha risolto le controversie interne senza ricorrere alla stampa.",
        "Il ministero degli affari interni si occupa della sicurezza pubblica nazionale."
      ],
      "nota": "In ambito politico e istituzionale si contrappone a 'estero' o 'internazionale'."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di studente o medico che svolge la propria attività all'interno di un istituto, ospedale o università, spesso in qualità di tirocinante residente.",
      "examples": [
        "Da studente interno alla clinica, ha acquisito molta esperienza pratica.",
        "I medici interni lavorano a stretto contatto con i primari del reparto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte che sta dentro uno spazio, un oggetto o un luogo, contrapposta alla superficie o all'esterno.",
      "examples": [
        "L'interno della casa era arredato in stile minimalista.",
        "All'interno del cofano si nascondeva un guasto al motore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Numero che identifica un appartamento o un ufficio nell'ambito di uno stabile, indicato accanto al numero civico.",
      "examples": [
        "Abito in via Roma 12, interno 5.",
        "Suona al citofono dell'interno 3 per trovare il signor Bianchi."
      ],
      "nota": "Usato comunemente negli indirizzi italiani dopo il numero civico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Scena cinematografica o teatrale girata o ambientata al chiuso, in uno spazio chiuso come uno studio o un appartamento.",
      "examples": [
        "Il film alterna interni molto claustrofobici a paesaggi aperti.",
        "La maggior parte degli interni è stata girata negli studi di Cinecittà."
      ],
      "nota": "Termine tecnico del linguaggio cinematografico e teatrale, contrapposto a 'esterno'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il territorio di uno Stato considerato nella sua dimensione nazionale, in contrapposizione all'estero.",
      "examples": [
        "Le politiche per l'interno devono tener conto dei bisogni delle comunità locali.",
        "Il ministro dell'interno ha convocato una riunione straordinaria."
      ],
      "nota": "In questa accezione è spesso usato nella locuzione 'ministero dell'interno' o 'ministro dell'interno'."
    },
    {
      "pos": "avverbio",
      "definition": "Nella parte interna, dentro.",
      "examples": [
        "Guardò interno per capire cosa stesse succedendo.",
        "Il meccanismo funziona tutto interno, senza parti visibili all'esterno."
      ],
      "nota": "Uso avverbiale meno frequente rispetto all'aggettivo e al sostantivo; spesso sostituito da 'all'interno' o 'dentro'."
    }
  ]
}