  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non corrisponde alla realtà o alla verità; contrario di vero.",
      "examples": [
        "Le informazioni diffuse dal comunicato si sono rivelate false.",
        "Ha dato un falso indirizzo alla polizia."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che imita o riproduce qualcosa di autentico con l'intento di ingannare; contraffatto, non genuino.",
      "examples": [
        "Gli agenti hanno sequestrato una partita di borse false.",
        "Il quadro era un falso: non era mai stato dipinto dal maestro."
      ],
      "nota": "Distinguibile dal senso logico-epistemico: qui l'accento è sulla contraffazione materiale o artefatta, non sulla non-corrispondenza con la realtà."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, che non è sincera nei comportamenti o nelle intenzioni; ipocrita, doppio.",
      "examples": [
        "Non mi fiderei di lui: è una persona falsa che sorride in faccia e poi ti pugnala alle spalle.",
        "Si è rivelata falsa nel momento in cui ne avevo più bisogno."
      ],
      "nota": "Uso valutativo riferito al carattere umano, con forte connotazione negativa."
    },
    {
      "pos": "aggettivo",
      "definition": "Che produce un'impressione errata o ingannevole senza necessariamente implicare intento doloso; apparente, illusorio.",
      "examples": [
        "Ha dato un falso senso di sicurezza ai passeggeri.",
        "Quella luce crea un falso effetto di profondità nella stanza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Documento, oggetto o opera contraffatti, presentati fraudolentemente come autentici.",
      "examples": [
        "Il perito ha confermato che il testamento era un falso.",
        "Il museo aveva esposto per anni un falso senza saperlo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In ambito giuridico, reato consistente nella contraffazione o alterazione di documenti, atti o monete.",
      "examples": [
        "È stato condannato per falso in atto pubblico.",
        "Il notaio è accusato di falso e truffa."
      ],
      "nota": "Spesso ricorre in formule tecniche come 'falso in atto pubblico', 'falso ideologico', 'falso materiale'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo non corrispondente alla verità o alla realtà; erroneamente, mentirosamente.",
      "examples": [
        "Ha giurato il falso davanti al tribunale.",
        "Testimoniare il falso è un reato grave."
      ],
      "nota": "Ricorre prevalentemente nelle locuzioni 'giurare il falso' e 'testimoniare il falso'."
    }
  ]
