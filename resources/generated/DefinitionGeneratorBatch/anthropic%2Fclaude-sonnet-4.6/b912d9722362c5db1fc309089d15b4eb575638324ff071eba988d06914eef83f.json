  "senses": [
    {
      "pos": "aggettivo numerale cardinale invariabile",
      "definition": "Che indica la quantità corrispondente a dieci volte dieci (100).",
      "examples": [
        "Ho comprato cento rose per il suo compleanno.",
        "Il villaggio dista cento chilometri dalla città."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale cardinale invariabile (uso iperbolico)",
      "definition": "Indica una quantità molto grande e indefinita, usato per enfatizzare una molteplicità.",
      "examples": [
        "Te l'ho detto cento volte di non farlo!",
        "Ho cento cose da fare oggi e non so da dove cominciare."
      ],
      "nota": "Uso figurato e iperbólico, frequente nel parlato."
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Il numero cento in quanto tale, o un insieme di cento unità.",
      "examples": [
        "Cinquanta più cinquanta fa cento.",
        "Ha superato il cento in velocità sull'autostrada."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Il voto massimo conseguibile in un esame universitario o nella maturità, pari a cento trentesimi o cento centesimi.",
      "examples": [
        "Ha preso cento con lode alla laurea triennale.",
        "Speravo di prendere cento all'esame di matematica, ma mi sono fermato a novantotto."
      ],
      "nota": "In contesto scolastico e universitario italiano, 'cento' indica il punteggio massimo; 'cento e lode' è il massimo con distinzione."
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Banconota o moneta del valore di cento unità monetarie.",
      "examples": [
        "Ha pagato con un cento e ha aspettato il resto.",
        "Non ho spiccioli, ho solo un cento."
      ],
      "nota": "Uso colloquiale per indicare una banconota da cento euro o altra valuta."
    }
  ]
