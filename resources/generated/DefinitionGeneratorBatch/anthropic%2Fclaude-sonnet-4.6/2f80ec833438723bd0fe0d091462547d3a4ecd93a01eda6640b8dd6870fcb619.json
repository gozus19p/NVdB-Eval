  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Individuo di sesso biologico femminile, con riferimento agli esseri umani, in contrapposizione al maschio.",
      "examples": [
        "L'ecografia ha rivelato che il bambino è una femmina.",
        "In quella famiglia ci sono tre femmine e un maschio."
      ],
      "nota": "In contesti informali o familiari è sinonimo di 'bambina' o 'ragazza di sesso femminile'. In alcuni contesti può avere connotazione neutra o, al contrario, riduttiva a seconda del tono."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Animale di sesso femminile, in grado di produrre cellule uovo e, nelle specie vivipare, di portare la prole.",
      "examples": [
        "La femmina del leone non ha la criniera.",
        "Abbiamo tenuto solo le femmine del coniglio per la riproduzione."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Che appartiene al sesso femminile; usato in posizione attributiva dopo il sostantivo.",
      "examples": [
        "Cercano un gatto femmina da adottare.",
        "Hanno assunto solo personale femmina per quel reparto."
      ],
      "nota": "Usato prevalentemente in contesti informali o tecnico-biologici, come attributo postnominale. Nell'uso riferito a persone può risultare marcato stilisticamente."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Elemento meccanico o elettrico dotato di cavità o alloggiamento destinato a ricevere un elemento complementare detto 'maschio'.",
      "examples": [
        "Devo comprare un adattatore con la parte femmina per collegare i due cavi.",
        "Il connettore femmina è quello che si trova sul retro del dispositivo."
      ],
      "nota": "Uso tecnico diffuso in elettronica, meccanica e idraulica, spesso in locuzioni come 'presa femmina', 'connettore femmina'."
    }
  ]
