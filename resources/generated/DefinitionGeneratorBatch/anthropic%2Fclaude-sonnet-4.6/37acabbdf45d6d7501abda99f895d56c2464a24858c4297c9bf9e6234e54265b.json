  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere o abbandonare un'attività, un'abitudine o un comportamento che si stava svolgendo o che si svolgeva regolarmente.",
      "examples": [
        "Ha smesso di fumare dopo vent'anni.",
        "Smetti di fare rumore, per favore.",
        "Ha smesso il lavoro in fabbrica per dedicarsi alla famiglia."
      ],
      "nota": "Si costruisce frequentemente con la preposizione 'di' seguita da un infinito: smettere di + infinito. Può reggere anche un oggetto diretto nominale (smettere un'abitudine, smettere un lavoro)."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Cessare, finire di accadere; riferito a fenomeni atmosferici o situazioni che si concludono da soli.",
      "examples": [
        "Quando smette di piovere, usciamo a fare una passeggiata.",
        "Il vento non smette mai in questo periodo dell'anno."
      ],
      "nota": "In questo uso intransitivo il soggetto è spesso un fenomeno naturale o una situazione impersonale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Togliersi di dosso un indumento o un accessorio che si stava indossando.",
      "examples": [
        "Ha smesso il cappotto appena entrato in casa.",
        "Smetti quella giacca, fa troppo caldo qui dentro."
      ],
      "nota": "Accezione meno frequente nell'italiano contemporaneo, più comune nei registri formali o letterari; spesso sostituita da 'togliersi'."
    }
  ]
}