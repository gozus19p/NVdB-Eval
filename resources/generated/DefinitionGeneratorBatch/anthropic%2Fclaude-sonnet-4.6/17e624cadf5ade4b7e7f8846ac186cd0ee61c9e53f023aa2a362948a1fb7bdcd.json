  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Agire, svolgere un'attività concreta o astratta in un determinato ambito o contesto.",
      "examples": [
        "L'agenzia opera nel settore della comunicazione da oltre vent'anni.",
        "I volontari operano quotidianamente nelle zone più disagiate della città."
      ],
      "nota": "Spesso seguito da un complemento introdotto da 'in', 'nel', 'su' che specifica il campo d'azione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un intervento chirurgico su un paziente.",
      "examples": [
        "I medici hanno deciso di operare il paziente d'urgenza.",
        "Il chirurgo l'ha operata ieri mattina per un'appendicite."
      ],
      "nota": "In questo senso può essere usato anche nella forma riflessiva 'operarsi', con il significato di sottoporsi a un intervento chirurgico."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Realizzare o compiere qualcosa di concreto, produrre un effetto o un cambiamento.",
      "examples": [
        "Il nuovo direttore ha operato una profonda trasformazione nell'azienda.",
        "La terapia ha operato un netto miglioramento delle condizioni del paziente."
      ],
      "nota": "Si costruisce frequentemente con sostantivi astratti come 'cambiamento', 'trasformazione', 'distinzione', 'scelta'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre un effetto, esercitare un'influenza o una funzione, detto di forze, meccanismi o fenomeni.",
      "examples": [
        "In questo contesto operano forze economiche difficili da controllare.",
        "Il farmaco opera agendo direttamente sul sistema nervoso centrale."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Sottoporsi a un intervento chirurgico.",
      "examples": [
        "Si è operata alla schiena e ora sta recuperando lentamente.",
        "Il medico gli ha consigliato di operarsi prima possibile."
      ],
      "nota": "Forma riflessiva del senso chirurgico del verbo."
    }
  ]
