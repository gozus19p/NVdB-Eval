  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Estensione di terreno coperta da alberi e arbusti spontanei o coltivati, di dimensioni generalmente inferiori a quelle di una foresta.",
      "examples": [
        "I bambini giocavano ai margini del bosco senza allontanarsi troppo.",
        "Dopo la tempesta, molti alberi del bosco erano stati abbattuti dal vento."
      ],
      "nota": "Si distingue tipicamente da 'foresta' per le dimensioni ridotte e da 'selva' per l'assenza di connotazioni letterarie o arcaiche. Il termine è neutro sul piano connotativo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato, insieme folto e intricato di elementi che evoca l'idea di densità e difficoltà di orientamento.",
      "examples": [
        "Si era perso in un bosco di scartoffie burocratiche.",
        "Il romanzo è un bosco di rimandi simbolici difficile da attraversare."
      ],
      "nota": "Uso metaforico che trasferisce le caratteristiche di densità e disorientamento tipiche del bosco a contesti astratti."
    }
  ]
