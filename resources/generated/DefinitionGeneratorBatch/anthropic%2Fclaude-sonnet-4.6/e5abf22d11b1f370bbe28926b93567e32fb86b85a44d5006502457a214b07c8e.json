  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Bevanda alcolica ottenuta dalla fermentazione del succo d'uva, prodotta in numerose varietà distinte per colore, aroma e gradazione.",
      "examples": [
        "A cena abbiamo aperto una bottiglia di vino rosso toscano.",
        "Il sommelier ha consigliato un vino bianco secco da abbinare al pesce."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso esteso, bevanda alcolica fermentata ottenuta da frutti o altri vegetali diversi dall'uva, spesso specificata con un complemento.",
      "examples": [
        "Ci ha offerto un vino di mele fatto in casa.",
        "In alcune regioni nordiche è diffuso il vino di ribes."
      ],
      "nota": "Questo uso richiede sempre un complemento specificatore (es. 'di mele', 'di riso') per distinguerlo dal senso prototipico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato, simbolo di convivialità, piacere della tavola o eccesso nel bere.",
      "examples": [
        "Il vino è stato da sempre al centro della cultura mediterranea.",
        "Era un uomo che non sapeva resistere al vino e alle cattive compagnie."
      ],
      "nota": "In questo uso figurato il termine evoca spesso valori culturali, rituali o vizi legati al consumo di alcolici."
    }
  ]
