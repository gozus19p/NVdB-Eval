  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha una dimensione orizzontale (larghezza) notevole rispetto alla lunghezza o rispetto alla norma di riferimento.",
      "examples": [
        "Il corridoio è troppo largo per essere arredato con un solo mobile.",
        "Indossa una camicia larga sulle spalle che non gli sta bene."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di un indumento, più ampio del necessario rispetto alla corporatura di chi lo porta.",
      "examples": [
        "Questi pantaloni mi sono diventati larghi dopo che ho perso peso.",
        "Compra la taglia sotto, questa giacca ti è troppo larga."
      ],
      "nota": "Senso distinto da quello dimensionale assoluto: qui la misura è relativa al corpo del portatore."
    },
    {
      "pos": "aggettivo",
      "definition": "Generoso, prodigo nel dare o nel concedere; non meschino.",
      "examples": [
        "È sempre stato largo con i figli, non ha mai negato loro nulla.",
        "Il proprietario si è mostrato largo nei confronti degli affittuari in difficoltà."
      ],
      "nota": "Uso figurato; contrario di 'taccagno' o 'avaro'."
    },
    {
      "pos": "aggettivo",
      "definition": "Ampio, esteso in senso non fisico; detto di concetti, interpretazioni o margini.",
      "examples": [
        "Ha dato una lettura larga del testo normativo, includendo casi non previsti.",
        "Il progetto ha ottenuto un largo consenso tra i partecipanti."
      ],
      "nota": "Si usa in espressioni come 'in senso largo', contrapposto a 'in senso stretto'."
    },
    {
      "pos": "avverbio",
      "definition": "A distanza, in modo da lasciare spazio; discosto.",
      "examples": [
        "Tieniti largo dai guai e non avrai problemi.",
        "La barca passò largo rispetto agli scogli per evitare il rischio."
      ],
      "nota": "Frequente nell'espressione 'tenersi largo' o 'stare largo da qualcosa/qualcuno'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio aperto e solitamente alberato o pavimentato in un centro urbano, più piccolo di una piazza.",
      "examples": [
        "Ci siamo dati appuntamento al Largo Argentina, vicino alle rovine romane.",
        "Il mercatino si tiene ogni sabato nel largo davanti alla chiesa."
      ],
      "nota": "Termine urbanistico usato nella toponomastica italiana; spesso compare nei nomi di luoghi come 'Largo Chigi', 'Largo di Torre Argentina'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte del mare aperta e lontana dalla costa.",
      "examples": [
        "La nave si allontanò verso il largo in pochi minuti.",
        "Al largo si vedevano le luci di una petroliera."
      ],
      "nota": "Usato prevalentemente nella locuzione 'al largo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nella musica, indicazione di tempo che prescrive un'esecuzione molto lenta e solenne.",
      "examples": [
        "Il brano si apre con un largo di grande intensità espressiva.",
        "Il direttore ha interpretato il largo iniziale con tempi molto dilatati."
      ],
      "nota": "Termine tecnico musicale, ma ampiamente noto nell'italiano corrente, anche per opere celebri come il 'Largo' di Haendel."
    }
  ]
