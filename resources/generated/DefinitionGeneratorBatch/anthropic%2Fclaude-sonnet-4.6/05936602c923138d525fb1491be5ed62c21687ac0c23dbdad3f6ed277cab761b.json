  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Stagione dell'anno compresa tra il solstizio di giugno e l'equinozio di settembre, caratterizzata da temperature elevate e giornate lunghe nell'emisfero boreale.",
      "examples": [
        "Quest'estate abbiamo trascorso due settimane al mare in Sardegna.",
        "Le estati di una volta sembravano più calde e spensierate.",
        "In estate le città si svuotano e molti negozi chiudono per ferie."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Periodo di vacanza estiva, evocato come momento di libertà, svago e leggerezza, indipendentemente dal riferimento calendariale preciso.",
      "examples": [
        "Quella fu l'estate più bella della mia vita: avevo vent'anni e nessun pensiero.",
        "Non vedo l'ora che arrivi l'estate per staccare dalla routine."
      ],
      "nota": "In questo uso il termine assume una connotazione affettiva e rievocativa, spesso associato alla giovinezza o a esperienze memorabili. Ricorre frequentemente in titoli di canzoni, film e romanzi."
    }
