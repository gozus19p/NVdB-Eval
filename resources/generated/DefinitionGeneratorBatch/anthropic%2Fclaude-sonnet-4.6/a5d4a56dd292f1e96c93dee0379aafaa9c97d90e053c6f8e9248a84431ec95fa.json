  "senses": [
    {
      "pos": "aggettivo numerale cardinale, invariabile",
      "definition": "Che indica la quantità corrispondente a cinque volte dieci (50).",
      "examples": [
        "Ho comprato cinquanta biglietti per la lotteria.",
        "La distanza tra le due città è di circa cinquanta chilometri."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m., invariabile",
      "definition": "Il numero cinquanta come entità astratta o come cifra; il simbolo che lo rappresenta.",
      "examples": [
        "Il cinquanta è il doppio del venticinque.",
        "Ha scritto un cinquanta enorme sul cartellone."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m., invariabile",
      "definition": "L'età di cinquant'anni di una persona, o il periodo della vita corrispondente a tale fascia d'età.",
      "examples": [
        "Ha passato la cinquanta ma è ancora in ottima forma.",
        "Molte persone intorno alla cinquanta decidono di cambiare lavoro."
      ],
      "nota": "Usato spesso ellitticamente in espressioni come 'avere passato la cinquanta' o 'essere sulla cinquanta'."
    },
    {
      "pos": "sostantivo m., invariabile",
      "definition": "Gli anni compresi tra il 1950 e il 1959 (i 'cinquanta' del Novecento), con riferimento a un decennio specifico.",
      "examples": [
        "Nei cinquanta il boom economico cambiò profondamente la società italiana.",
        "Quel film è ambientato negli anni cinquanta."
      ],
      "nota": "Usato quasi sempre al plurale e preceduto dall'articolo determinativo o dalla preposizione 'negli anni'."
    }
  ]
