  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Mano chiusa con le dita ripiegate verso il palmo, usata come postura della mano o come strumento di colpo.",
      "examples": [
        "Batté il pugno sul tavolo per richiamare l'attenzione.",
        "Alzò il pugno in segno di protesta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Colpo inferto con la mano chiusa.",
      "examples": [
        "Il pugile lo stese con un pugno preciso alla mascella.",
        "Ha ricevuto un pugno nello stomaco durante la rissa."
      ],
      "nota": "In questo senso si distingue da 'schiaffo', che indica invece un colpo dato con la mano aperta."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Piccola quantità di qualcosa che può essere contenuta nel cavo della mano chiusa; manciata.",
      "examples": [
        "Aggiungi un pugno di sale all'acqua prima di far bollire la pasta.",
        "Portò con sé solo un pugno di terra del suo paese natale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Piccolo numero di persone o cose, gruppo ristretto.",
      "examples": [
        "Un pugno di soldati difese il villaggio per giorni.",
        "Solo un pugno di spettatori era presente alla prima dello spettacolo."
      ],
      "nota": "Uso figurato derivato dall'accezione di 'piccola quantità'; ha spesso connotazione di esiguità rispetto alle circostanze."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Carattere grafico personale, scrittura manuale riconoscibile di un individuo.",
      "examples": [
        "Riconobbi subito il suo pugno inconfondibile sulla busta.",
        "La lettera era scritta di suo pugno, senza l'aiuto di nessuno."
      ],
      "nota": "Ricorre frequentemente nella locuzione 'di proprio pugno' o 'di suo pugno', a indicare che qualcosa è stato scritto personalmente dall'autore."
    }
  ]
