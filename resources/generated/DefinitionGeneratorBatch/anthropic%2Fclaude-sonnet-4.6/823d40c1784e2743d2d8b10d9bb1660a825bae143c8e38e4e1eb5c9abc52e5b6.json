  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Potere legittimo di comandare, decidere o imporre obbedienza, riconosciuto a una persona o a un'istituzione in virtù di un ruolo ufficiale o di una norma sociale.",
      "examples": [
        "Il direttore esercita la sua autorità su tutto il personale dell'ufficio.",
        "In quella famiglia il padre aveva un'autorità indiscussa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Organo, ente o persona investita di poteri pubblici o di funzioni di controllo e regolamentazione in un determinato settore.",
      "examples": [
        "L'Autorità garante della concorrenza ha aperto un'indagine sull'azienda.",
        "Le autorità locali hanno disposto l'evacuazione dell'edificio."
      ],
      "nota": "Usato spesso al plurale ('le autorità') per indicare collettivamente le forze dell'ordine o gli organi dello Stato."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ascendente morale, prestigio intellettuale o riconoscimento sociale che conferisce a qualcuno il peso di influenzare opinioni e comportamenti altrui, indipendentemente da un ruolo formale.",
      "examples": [
        "Le sue parole hanno grande autorità nel campo della filosofia contemporanea.",
        "Parla con tale autorità che tutti lo ascoltano in silenzio."
      ],
      "nota": "In questo senso si distingue dall'accezione istituzionale: l'autorità è guadagnata sul campo, non delegata formalmente."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Persona o fonte considerata autorevole e citata come riferimento affidabile in un determinato ambito del sapere o della cultura.",
      "examples": [
        "Chomsky è un'autorità indiscussa nel campo della linguistica generativa.",
        "Per questa questione legale dovresti consultare una vera autorità in materia."
      ],
      "nota": null
    }
  ]
