  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Compiere un atto illecito, riprovevole o moralmente sbagliato; essere autore di una colpa, un reato o un errore.",
      "examples": [
        "Ha commesso un grave errore di valutazione che ha compromesso l'intero progetto.",
        "Il tribunale ha stabilito che l'imputato aveva commesso il reato in concorso con altri."
      ],
      "nota": "È il senso più frequente nell'italiano contemporaneo. Si costruisce tipicamente con oggetti come 'errore', 'reato', 'crimine', 'peccato', 'illecito', 'omicidio'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Affidare un incarico o un compito a qualcuno; dare mandato di eseguire qualcosa.",
      "examples": [
        "Il direttore ha commesso a lui la stesura del rapporto finale.",
        "Mi fu commessa la gestione dell'intero archivio storico."
      ],
      "nota": "Uso più formale e letterario, meno frequente nel parlato contemporaneo. Sinonimo di 'affidare', 'incaricare'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Unire o collegare insieme parti o elementi in modo che combacino o si incastrino.",
      "examples": [
        "Il falegname ha commesso le tavole con precisione millimetrica.",
        "Bisogna commettere i pezzi del pavimento in legno seguendo la venatura naturale."
      ],
      "nota": "Uso tecnico-artigianale, prevalente in ambito edilizio, falegnameria e arti applicate. Sinonimo di 'connettere', 'giuntare'."
    }
  ]
