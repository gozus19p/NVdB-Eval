  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Adesione interiore a verità o principi religiosi non dimostrabili razionalmente, propria di chi crede in una divinità o in una dottrina spirituale.",
      "examples": [
        "La fede lo ha sorretto nei momenti più difficili della malattia.",
        "Molte persone trovano nella fede un senso profondo per la propria esistenza."
      ],
      "nota": "In contesto cristiano indica specificamente la virtù teologale che dispone l'uomo a credere in Dio e alle verità rivelate."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di credenze e pratiche religiose che costituiscono una religione o una confessione.",
      "examples": [
        "Le persone di fede diversa convivono pacificamente in quel quartiere.",
        "Il dialogo tra le fedi è fondamentale per la pace sociale."
      ],
      "nota": "In questo senso è spesso usato al plurale o con aggettivi qualificativi come 'cattolica', 'islamica', ecc."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Fiducia incondizionata in qualcuno o qualcosa, convinzione profonda nella validità o nell'affidabilità di una persona, un'istituzione o un'idea.",
      "examples": [
        "Ho piena fede nelle capacità di questo medico.",
        "La fede nel progresso scientifico caratterizza la cultura moderna."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Lealtà, rispetto degli impegni presi; onestà e coerenza nel mantenere la parola data.",
      "examples": [
        "Ha sempre mantenuto fede alle promesse fatte ai suoi elettori.",
        "Tradire la fede di chi ti ha aiutato è un gesto ignobile."
      ],
      "nota": "Ricorre spesso nelle locuzioni 'in buona fede' (con onestà, senza intenzioni fraudolente) e 'in mala fede' (con intenzione di ingannare)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Documento ufficiale che attesta o certifica un fatto, uno stato o una qualità di una persona.",
      "examples": [
        "Per iscriversi al corso è richiesta la fede di battesimo.",
        "Ha presentato all'anagrafe la fede di nascita del bambino."
      ],
      "nota": "Usato soprattutto in ambito burocratico e amministrativo; tipiche espressioni sono 'fede di nascita', 'fede di battesimo', 'fede di stato civile'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Anello nuziale, simbolo del vincolo matrimoniale.",
      "examples": [
        "Durante la cerimonia si sono scambiati le fedi nuziali.",
        "Portava ancora la fede al dito nonostante il divorzio."
      ],
      "nota": "In questa accezione è spesso accompagnato dall'aggettivo 'nuziale'."
    }
  ]
