  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Avere al proprio interno qualcosa, racchiudere fisicamente una sostanza, un oggetto o un insieme di elementi.",
      "examples": [
        "La bottiglia contiene mezzo litro d'acqua.",
        "Questa scatola contiene tutti i documenti importanti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Includere al proprio interno un'informazione, un argomento o un elemento non fisico, come in un testo o documento.",
      "examples": [
        "Il rapporto contiene dati molto interessanti sulla situazione economica.",
        "Il contratto contiene una clausola rescissoria."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere una capienza sufficiente ad accogliere una certa quantità di persone o cose.",
      "examples": [
        "Lo stadio contiene fino a ottantamila spettatori.",
        "La sala riunioni contiene al massimo trenta persone."
      ],
      "nota": "Si differenzia dal primo senso per l'enfasi sulla capacità massima piuttosto che sul contenuto attuale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Tenere entro certi limiti un fenomeno, un processo o una grandezza, impedendone l'espansione o l'eccesso.",
      "examples": [
        "Il governo ha adottato misure per contenere l'inflazione.",
        "I vigili del fuoco sono riusciti a contenere l'incendio prima che si propagasse."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (contenersi)",
      "definition": "Controllare le proprie emozioni, impulsi o reazioni, evitando di manifestarli in modo eccessivo.",
      "examples": [
        "A fatica si contenne dal rispondere in modo aggressivo.",
        "Doveva contenersi per non scoppiare a ridere durante la cerimonia."
      ],
      "nota": "Il riflessivo ha valore specificamente emotivo-comportamentale, distinto dall'uso transitivo del verbo."
    }
  ]
