  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Goccia di liquido salino secreto dalle ghiandole lacrimali dell'occhio, prodotta in risposta a stimoli emotivi, fisici o irritanti.",
      "examples": [
        "Le lacrime le scorrevano sul viso mentre ascoltava la notizia.",
        "Il bambino scoppiò a piangere e le lacrime gli bagnarono le guance."
      ],
      "nota": "Al plurale 'lacrime' indica spesso l'atto del pianto nella sua totalità: 'scoppiare in lacrime', 'essere in lacrime'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Piccola quantità di liquido, specie di bevanda alcolica, versata in un recipiente; una minima dose.",
      "examples": [
        "Aggiungi solo una lacrima di vino nella salsa per insaporirla.",
        "Mi ha versato una lacrima di grappa nel caffè."
      ],
      "nota": "Uso figurato per analogia con la forma e la piccola quantità della goccia lacrimale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Piccola goccia solidificata di una sostanza, in particolare di resina o di cera colata.",
      "examples": [
        "Sulla corteccia del pino si vedevano lacrime di resina indurita.",
        "La candela aveva lasciato alcune lacrime di cera sul candelabro."
      ],
      "nota": "Senso proprio di ambito naturalistico o artigianale, per analogia morfologica con la goccia."
    }
  ]
