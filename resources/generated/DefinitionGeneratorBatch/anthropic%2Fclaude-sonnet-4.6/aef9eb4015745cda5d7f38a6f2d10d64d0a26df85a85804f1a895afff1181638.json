  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha un carattere moralmente riprovevole, incline a fare del male agli altri o a comportarsi in modo crudele e malvagio.",
      "examples": [
        "Il villain della storia è un uomo cattivo, senza alcun rimorso per le sue azioni.",
        "Non è una persona cattiva, ma a volte agisce in modo egoista."
      ],
      "nota": "Contrario di 'buono'. In contesti informali può indicare semplicemente qualcuno che si comporta male in una situazione specifica, senza implicare una caratterizzazione morale permanente."
    },
    {
      "pos": "aggettivo",
      "definition": "Di scarsa qualità, non adeguato agli standard attesi; difettoso o insufficiente.",
      "examples": [
        "Ho mangiato un pasto cattivo in quel ristorante e mi sono pentito di esserci andato.",
        "La ricezione del segnale è cattiva in questa zona di montagna."
      ],
      "nota": "In questo senso è sinonimo di 'brutto', 'scadente', 'pessimo'."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a condizioni atmosferiche avverse, tempo inclemente o perturbato.",
      "examples": [
        "Con questo cattivo tempo è meglio restare a casa.",
        "Le previsioni annunciano giorni di cattivo tempo per tutta la settimana."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che provoca disagio fisico o olfattivo; sgradevole ai sensi.",
      "examples": [
        "C'è un cattivo odore che proviene dal piano di sotto.",
        "Aveva un cattivo sapore in bocca dopo aver preso la medicina."
      ],
      "nota": "Ricorre spesso nelle locuzioni 'cattivo odore' e 'cattivo sapore'."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di bambino o animale, che non si comporta in modo obbediente o disciplinato; discolo.",
      "examples": [
        "Il bambino è stato cattivo tutto il giorno e ha fatto i capricci.",
        "Il cane è stato cattivo e ha distrutto i cuscini del divano."
      ],
      "nota": "In questo uso, 'cattivo' non implica malvagità morale profonda, ma semplice disobbedienza o irrequietezza, tipicamente in riferimento a bambini o animali domestici."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Personaggio o individuo che incarna il ruolo dell'antagonista malvagio, contrapposto all'eroe o al protagonista positivo.",
      "examples": [
        "In quel film il cattivo viene sconfitto nell'ultimo atto.",
        "Da bambino volevo sempre fare il cattivo nelle recite scolastiche."
      ],
      "nota": "Usato frequentemente nel linguaggio dei generi narrativi (cinema, fumetti, letteratura) come equivalente dell'inglese 'villain'."
    }
  ]
