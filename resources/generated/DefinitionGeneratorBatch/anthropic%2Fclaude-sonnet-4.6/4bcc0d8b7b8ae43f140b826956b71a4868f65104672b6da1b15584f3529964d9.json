  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Striscia sottile e allungata di luce che si propaga da una sorgente luminosa.",
      "examples": [
        "Un raggio di sole filtrava attraverso le persiane chiuse.",
        "I raggi del tramonto tingevano il cielo di rosso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato, piccola quantità o manifestazione di qualcosa di positivo come speranza, gioia o serenità.",
      "examples": [
        "In quel momento buio, la sua telefonata fu un raggio di speranza.",
        "Un raggio di luce squarciò la sua tristezza quando ricevette la notizia."
      ],
      "nota": "Uso figurato derivato dal senso fisico di luce; ricorre frequentemente in collocazioni come 'raggio di speranza', 'raggio di sole' (riferito a persona)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Segmento che congiunge il centro di un cerchio o di una sfera con un punto qualsiasi della sua circonferenza o superficie.",
      "examples": [
        "Il raggio di questo cerchio misura cinque centimetri.",
        "Per calcolare l'area del cerchio bisogna conoscere il raggio."
      ],
      "nota": "Termine geometrico fondamentale; il raggio è pari alla metà del diametro."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Distanza massima entro cui si estende un'area circolare di influenza, azione o portata.",
      "examples": [
        "L'esplosione ha danneggiato edifici in un raggio di duecento metri.",
        "Il negozio attira clienti in un raggio di trenta chilometri."
      ],
      "nota": "Derivato per estensione dal senso geometrico; comune in espressioni come 'nel raggio di' + misura di distanza."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuno dei segmenti metallici o raggiati che collegano il mozzo al cerchione di una ruota di bicicletta, motocicletta o veicolo simile.",
      "examples": [
        "Ha rotto un raggio della ruota posteriore della bicicletta.",
        "Bisogna tendere i raggi in modo uniforme per mantenere la ruota in asse."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Onda elettromagnetica di alta energia, come i raggi X o i raggi gamma, usata in ambito medico o scientifico.",
      "examples": [
        "Il medico ha ordinato una lastra ai raggi X per escludere fratture.",
        "I raggi UV del sole possono danneggiare la pelle se ci si espone senza protezione."
      ],
      "nota": "In questo senso si usa quasi sempre al plurale e in combinazione con un'altra specificazione (raggi X, raggi UV, raggi gamma, ecc.)."
    }
  ]
