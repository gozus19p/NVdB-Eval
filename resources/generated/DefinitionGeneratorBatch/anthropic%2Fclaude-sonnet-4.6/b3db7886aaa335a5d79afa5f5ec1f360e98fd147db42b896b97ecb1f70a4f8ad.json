  },
  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Mettere qualcosa a contatto con una superficie o un oggetto che faccia da sostegno.",
      "examples": [
        "Ha appoggiato la borsa sul tavolo prima di sedersi.",
        "Appoggia la scala al muro con attenzione."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Fare leva o prendere sostegno fisico su qualcosa o qualcuno per non cadere o per riposarsi.",
      "examples": [
        "Si è appoggiata al corrimano per salire le scale.",
        "Il vecchio si appoggiava al bastone mentre camminava."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sostenere una persona, un'idea, un progetto o un'iniziativa, esprimendo favore o fornendo aiuto concreto.",
      "examples": [
        "Il partito ha deciso di appoggiare la candidatura della sindaca uscente.",
        "Tutti i colleghi hanno appoggiato la sua proposta in riunione."
      ],
      "nota": "Sinonimo parziale di 'sostenere', 'supportare', 'favorire'. Si usa sia in contesti politici sia in situazioni quotidiane."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Fare affidamento su qualcuno o qualcosa per ricevere aiuto, consiglio o supporto morale.",
      "examples": [
        "Nei momenti difficili si appoggia sempre ai suoi amici più cari.",
        "L'azienda si appoggia a consulenti esterni per le questioni legali."
      ],
      "nota": "Uso figurato derivato dal senso fisico di cercare sostegno."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Toccare o gravare su una superficie, detto di oggetti o strutture che poggiano su un punto di contatto.",
      "examples": [
        "La trave appoggia su due pilastri in cemento.",
        "Il piedino della sedia appoggia in modo instabile sul pavimento."
      ],
      "nota": "In questo uso il verbo è spesso intercambiabile con 'poggiare'."
    }
  ]
}