  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Proprietà visiva degli oggetti determinata dalla lunghezza d'onda della luce riflessa o emessa, percepita dall'occhio umano come sensazione cromatica (rosso, blu, verde, ecc.).",
      "examples": [
        "Il cielo al tramonto assume colori che vanno dall'arancione al viola.",
        "Qual è il tuo colore preferito?"
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza pigmentante utilizzata per tingere, dipingere o colorare superfici, tessuti o altri materiali.",
      "examples": [
        "Il pittore ha mescolato i colori sulla tavolozza prima di iniziare il quadro.",
        "Hai comprato i colori acrilici per il laboratorio di arte?"
      ],
      "nota": "In questo senso è spesso usato al plurale per indicare un set di matite, pastelli, tempere o simili."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Tinta o nuance cromatica della carnagione di una persona, in particolare come indice di salute o stato fisico.",
      "examples": [
        "Dopo una settimana al mare ha acquistato un bel colore.",
        "Il medico notò che il paziente aveva un brutto colore in viso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme dei simboli cromatici distintivi di una squadra sportiva, di un partito, di una nazione o di un'istituzione.",
      "examples": [
        "I giocatori difenderanno i colori della loro nazionale con orgoglio.",
        "Ha militato per dieci anni nei colori della Juventus."
      ],
      "nota": "Quasi esclusivamente usato al plurale in questo senso."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Vivacità, varietà e ricchezza espressiva di un testo, di un racconto o di una rappresentazione artistica.",
      "examples": [
        "Il romanzo è pieno di colore grazie alle descrizioni dettagliate dei luoghi esotici.",
        "La sua scrittura ha un colore tutto particolare, difficile da imitare."
      ],
      "nota": "Uso figurato; indica qualità evocativa e capacità di creare immagini vivide."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Orientamento politico o ideologico di una persona, un governo o un'istituzione.",
      "examples": [
        "Non importa di che colore sia il governo, le riforme devono essere fatte.",
        "La giunta comunale ha un colore di centrosinistra."
      ],
      "nota": "Uso figurato di ambito politico-giornalistico."
    }
  ]
