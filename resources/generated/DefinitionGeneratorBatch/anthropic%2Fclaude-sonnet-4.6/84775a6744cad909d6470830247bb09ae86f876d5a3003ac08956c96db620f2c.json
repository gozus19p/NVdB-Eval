  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Calzatura che riveste e protegge il piede, solitamente in cuoio, tessuto o materiale sintetico, con suola rigida o semirigida.",
      "examples": [
        "Ha comprato un paio di scarpe eleganti per il matrimonio.",
        "Mi fanno male i piedi, queste scarpe sono troppo strette."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In edilizia e architettura, elemento strutturale inclinato o allargato alla base di un muro, pilastro o bastione, destinato a distribuire il peso e a consolidare la fondazione.",
      "examples": [
        "Le mura medievali presentano una scarpa pronunciata alla base per garantire maggiore stabilità.",
        "L'architetto ha progettato una scarpa in cemento armato per rinforzare il pilastro."
      ],
      "nota": "Termine tecnico diffuso nell'ambito dell'ingegneria civile e del restauro architettonico."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso figurato, persona considerata incapace, inetta o priva di abilità in un determinato campo.",
      "examples": [
        "Non metterlo in porta, è una scarpa: non para mai niente.",
        "Come autista è proprio una scarpa, ogni volta rischia di fare un incidente."
      ],
      "nota": "Uso colloquiale e informale, spesso con tono scherzoso o derisorio."
    }
  ]
