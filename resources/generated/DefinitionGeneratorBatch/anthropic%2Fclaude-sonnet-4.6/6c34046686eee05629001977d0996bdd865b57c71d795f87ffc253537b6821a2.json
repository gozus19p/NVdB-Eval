  },
  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Portare avanti un'azione o un'attività già iniziata senza interromperla o riprenderla dopo una pausa.",
      "examples": [
        "Dopo la pausa pranzo, ha continuato a lavorare fino a sera.",
        "Il professore continuò la lezione dal punto in cui si era fermato."
      ],
      "nota": "Si costruisce frequentemente con l'infinito introdotto da 'a': continuare a fare qualcosa."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Procedere senza cessare, protrarsi nel tempo o nello spazio.",
      "examples": [
        "La pioggia ha continuato per tutta la notte.",
        "La strada continua fino al confine regionale."
      ],
      "nota": "Usato anche per estensioni spaziali: un percorso, una linea, una serie che non si interrompe."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Riprendere qualcosa che era stato interrotto, portandolo avanti verso il completamento.",
      "examples": [
        "Ha continuato il romanzo che aveva abbandonato anni fa.",
        "Dobbiamo continuare il discorso che avevamo iniziato ieri."
      ],
      "nota": "Si distingue dal senso di 'proseguire senza interruzione' per il fatto che implica una ripresa dopo un'interruzione."
    },
    {
      "pos": "verbo riflessivo (continuarsi)",
      "definition": "Prolungarsi, estendersi in maniera ininterrotta, detto di una sequenza, tradizione o fenomeno.",
      "examples": [
        "La tradizione si continua di generazione in generazione.",
        "La catena montuosa si continua oltre il confine."
      ],
      "nota": "Uso meno comune rispetto alle forme attive; in contesti letterari o formali."
    }
  ]
}