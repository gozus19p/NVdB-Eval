  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che è composto di due elementi uguali o che ha dimensione, quantità o intensità pari a due volte quella normale.",
      "examples": [
        "Ha ordinato un doppio espresso per restare sveglio.",
        "La porta blindata ha una serratura doppia per maggiore sicurezza."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che nasconde una seconda natura, intenzione o significato diverso da quello apparente; falso, insincero.",
      "examples": [
        "Non mi fido di lui: è una persona doppia che dice una cosa e ne pensa un'altra.",
        "Quel sorriso doppio non mi convince affatto."
      ],
      "nota": "Esprime una connotazione negativa relativa alla mancanza di sincerità; spesso usato nella locuzione 'gioco doppio'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Quantità o misura pari a due volte quella di riferimento.",
      "examples": [
        "Se prima guadagnavi mille euro, adesso guadagni il doppio.",
        "Ci vuole il doppio del tempo per completare questo lavoro rispetto a quanto previsto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nella pratica sportiva, specialmente nel tennis e nel ping-pong, gara o partita disputata tra due coppie di giocatori.",
      "examples": [
        "Si sono qualificati per la finale del doppio maschile al torneo di Wimbledon.",
        "Preferisce giocare il doppio misto piuttosto che il singolare."
      ],
      "nota": "Si contrappone a 'singolo' o 'singolare'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona o cosa che assomiglia moltissimo a un'altra, quasi identica nell'aspetto.",
      "examples": [
        "Quel ragazzo è il tuo doppio: sembrate gemelli.",
        "Nel film usano un doppio per le scene più pericolose al posto dell'attore protagonista."
      ],
      "nota": "In ambito cinematografico il termine 'controfigura' è più specifico per le scene d'azione, mentre 'sosia' è preferito per l'uso comune."
    },
    {
      "pos": "avverbio",
      "definition": "In misura o quantità pari a due volte tanto; due volte di più.",
      "examples": [
        "Da quando ha cambiato lavoro, guadagna doppio.",
        "Devi impegnarti doppio se vuoi recuperare il tempo perso."
      ],
      "nota": "Uso avverbiale informale, frequente nel parlato."
    }
  ]
