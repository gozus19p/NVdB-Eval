  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che appartiene alla storia o riguarda eventi, periodi e figure del passato documentati e studiati dalla disciplina storiografica.",
      "examples": [
        "Il centro storico di Roma attrae milioni di turisti ogni anno.",
        "Le fonti storiche del Medioevo sono spesso lacunose e difficili da interpretare."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha effettivamente avuto luogo o che è realmente esistito, in opposizione a leggendario o mitico.",
      "examples": [
        "Non è chiaro se certi personaggi dell'antichità siano storici o mitologici.",
        "Gli studiosi dibattono sull'esistenza storica di alcuni re dell'antico Egitto."
      ],
      "nota": "Si contrappone spesso a 'leggendario', 'mitico' o 'immaginario'."
    },
    {
      "pos": "aggettivo",
      "definition": "Di evento, momento o risultato memorabile, destinato a restare nella memoria collettiva per la sua eccezionale importanza.",
      "examples": [
        "La vittoria della nazionale è stata un momento storico per tutto il paese.",
        "Quella sentenza rappresenta una decisione storica per il diritto italiano."
      ],
      "nota": "Uso con valore valutativo ed enfatico, molto frequente nel linguaggio giornalistico e sportivo."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, partito, gruppo o istituzione che esiste da lungo tempo e ha radici consolidate in un determinato contesto.",
      "examples": [
        "Il partito storico della sinistra italiana ha subito una profonda trasformazione.",
        "È uno dei soci storici del club, iscritto fin dalla fondazione."
      ],
      "nota": "In questo senso si avvicina a 'storico' come sinonimo di 'di lunga data' o 'tradizionale'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Studioso che si occupa professionalmente di ricerca, analisi e narrazione di eventi del passato.",
      "examples": [
        "Lo storico ha presentato nuove prove che ribaltano la versione ufficiale degli eventi.",
        "Gli storici del Novecento si confrontano spesso su come interpretare i totalitarismi europei."
      ],
      "nota": "Il femminile è 'storica'."
    }
  ]
