  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Evento o circostanza che si verifica indipendentemente da una pianificazione o da una causa riconoscibile; coincidenza fortuita.",
      "examples": [
        "È stato un puro caso che ci siamo incontrati proprio quel giorno.",
        "Non credo al caso: tutto succede per una ragione."
      ],
      "nota": "Spesso nella locuzione 'per caso' (= in modo non intenzionale) e 'a caso' (= senza criterio)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Situazione, vicenda o fatto concreto che si presenta all'attenzione, spesso come oggetto di analisi, discussione o intervento.",
      "examples": [
        "Il medico ha illustrato un caso clinico molto raro durante la conferenza.",
        "La polizia sta indagando su un caso di truffa informatica."
      ],
      "nota": "In questo senso è frequente nei linguaggi specialistici (medicina, diritto, giornalismo)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Eventualità ipotetica o condizione considerata in astratto, spesso introdotta da 'nel caso in cui', 'in caso di' e simili.",
      "examples": [
        "Nel caso in cui non riuscissi a venire, avvisami in anticipo.",
        "In caso di emergenza, seguire le istruzioni affisse alle pareti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona o situazione che suscita attenzione pubblica, scandalo o dibattito, spesso di natura mediatica o giudiziaria.",
      "examples": [
        "Il caso Moro ha segnato profondamente la storia italiana.",
        "Quella vicenda è diventata un caso nazionale, discusso da tutti i giornali."
      ],
      "nota": "In questo uso il termine ha spesso valore valutativo e può implicare eccezionalità o gravità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In grammatica, categoria morfologica che indica la funzione sintattica di un nome o pronome all'interno della frase.",
      "examples": [
        "Il latino distingue sei casi: nominativo, genitivo, dativo, accusativo, vocativo e ablativo.",
        "In russo i casi grammaticali sono fondamentali per comprendere la struttura della frase."
      ],
      "nota": "Uso tecnico-grammaticale, diffuso nell'insegnamento delle lingue classiche e della linguistica."
    }
