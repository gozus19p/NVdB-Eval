  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Prima parte della giornata, che va dall'alba a mezzogiorno, caratterizzata dall'inizio delle attività quotidiane.",
      "examples": [
        "Mi sveglio ogni mattino alle sei per andare in ufficio.",
        "Il mercato si tiene solo al mattino, dalle otto alle tredici."
      ],
      "nota": "Sostanzialmente sinonimo di 'mattina', con cui è intercambiabile nella maggior parte dei contesti; 'mattino' è leggermente più formale e ricorre spesso in espressioni fisse come 'di buon mattino', 'sul far del mattino'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato, fase iniziale e promettente di un'esperienza, di un'epoca o della vita di una persona.",
      "examples": [
        "Siamo ancora al mattino di questa rivoluzione tecnologica.",
        "Quei anni erano il mattino della sua carriera artistica."
      ],
      "nota": "Uso metaforico che richiama l'idea di inizio, freschezza e potenzialità, in contrasto con termini come 'tramonto' o 'sera', usati per indicare la fase finale o il declino."
    }
  ]
