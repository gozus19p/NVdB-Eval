  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che richiede impegno, abilità o sforzo notevole per essere compreso, realizzato o superato; non facile.",
      "examples": [
        "Questo esercizio di matematica è davvero difficile: ci ho lavorato un'ora senza risolverlo.",
        "La scalata a quella vetta è considerata tra le più difficili delle Alpi."
      ],
      "nota": "Contrario di 'facile'. Può riferirsi a compiti intellettuali, fisici o pratici."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, che ha un carattere complicato, esigente o poco accomodante, con cui è arduo avere rapporti sereni.",
      "examples": [
        "È un capo difficile: non è mai soddisfatto del lavoro dei suoi collaboratori.",
        "Da adolescente ero piuttosto difficile e litigavo spesso con i miei genitori."
      ],
      "nota": "Usato in riferimento a persone, assume una connotazione valutativa negativa sul piano relazionale."
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato da condizioni avverse, critiche o problematiche; non favorevole.",
      "examples": [
        "Stiamo attraversando un periodo difficile dal punto di vista economico.",
        "La situazione politica nel paese rimane difficile nonostante i negoziati."
      ],
      "nota": "Si usa per descrivere circostanze, situazioni o periodi storici o personali segnati da ostacoli o sofferenze."
    },
    {
      "pos": "aggettivo",
      "definition": "Poco probabile; che ha scarse possibilità di verificarsi.",
      "examples": [
        "È difficile che riesca a finire il lavoro entro stasera.",
        "Mi sembra difficile che cambino idea dopo tutto quello che è successo."
      ],
      "nota": "In questa accezione è spesso usato in costruzioni impersonali del tipo 'è difficile che + congiuntivo' o 'è difficile + infinito'."
    },
    {
      "pos": "avverbio",
      "definition": "Con difficoltà; in modo non agevole. Usato per modificare un verbo.",
      "examples": [
        "Difficile che si trovino biglietti a quest'ora.",
        "Queste scarpe difficile che le indossi ancora."
      ],
      "nota": "Uso avverbiale colloquiale, diffuso soprattutto nel parlato, spesso in frasi ellittiche o in costruzioni con 'che'."
    }
  ]
