  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Affermare consapevolmente il falso con l'intenzione di ingannare qualcuno.",
      "examples": [
        "Ha mentito sapendo di essere scoperto.",
        "Non mentire mai ai tuoi genitori, anche quando hai paura delle conseguenze."
      ],
      "nota": "Si costruisce spesso con la preposizione 'a' per indicare il destinatore dell'inganno: mentire a qualcuno. Distinto da 'sbagliare', che implica assenza di intenzionalità."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Dare un'impressione falsa o ingannevole, detto di cose o situazioni non personali.",
      "examples": [
        "Le statistiche a volte mentono se non si conosce il contesto.",
        "Lo specchio non mente: quei chili in più si vedono tutti."
      ],
      "nota": "Uso figurato riferito a oggetti, dati o apparenze che non corrispondono alla realtà effettiva. Il soggetto non è un agente animato."
    }
  ]
