  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Apertura, cavità o perforazione in una superficie o in un corpo solido, naturale o prodotta artificialmente.",
      "examples": [
        "Ha fatto un buco nel muro per passare i cavi dell'impianto elettrico.",
        "La giacca aveva un buco sul gomito dal tanto usarla."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio vuoto, lacuna o mancanza all'interno di qualcosa di continuo o strutturato, come un programma, un calendario o una sequenza.",
      "examples": [
        "Ho un buco di due ore tra una lezione e l'altra, ne approfitto per studiare.",
        "C'è un buco nel palinsesto televisivo del pomeriggio."
      ],
      "nota": "Uso frequente in contesti organizzativi e temporali per indicare un intervallo libero o non occupato."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Deficit finanziario o ammanco contabile, ovvero una somma mancante rispetto al previsto.",
      "examples": [
        "La gestione fallimentare ha lasciato un buco di milioni di euro nei conti dell'azienda.",
        "Il governo deve trovare risorse per coprire il buco nel bilancio pubblico."
      ],
      "nota": "Uso figurato di ambito economico-finanziario, molto comune nel linguaggio giornalistico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Luogo piccolo, angusto, squallido o di scarso valore, spesso riferito a un'abitazione o a un locale.",
      "examples": [
        "Non puoi chiamare appartamento quel buco in cui abita: è poco più di un ripostiglio.",
        "Abbiamo trovato un buco di bar in periferia, ma il caffè era ottimo."
      ],
      "nota": "Uso connotato negativamente; può assumere sfumatura affettuosa o ironica in certi contesti."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio della tossicodipendenza, iniezione endovenosa di droga.",
      "examples": [
        "Si era ridotto a farsi un buco al giorno pur di non sentire i sintomi dell'astinenza.",
        "I segni sul braccio tradivano anni di buchi."
      ],
      "nota": "Termine gergale, tipico del lessico della tossicodipendenza."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel giornalismo, mancanza di una notizia o di un contenuto che avrebbe dovuto essere pubblicato, lasciando uno spazio vuoto nella testata.",
      "examples": [
        "La redazione è in crisi: tre articoli sono saltati e ora c'è un buco in prima pagina.",
        "Il cronista non riuscì a consegnare il pezzo in tempo e lasciò un buco nell'edizione serale."
      ],
      "nota": "Uso tecnico del linguaggio giornalistico ed editoriale."
    }
  ]
