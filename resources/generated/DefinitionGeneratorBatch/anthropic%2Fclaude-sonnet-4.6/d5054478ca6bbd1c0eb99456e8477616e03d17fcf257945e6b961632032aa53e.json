  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Atto o pratica di servirsi di qualcosa per uno scopo determinato; impiego concreto di un oggetto, strumento o risorsa.",
      "examples": [
        "L'uso eccessivo dello smartphone può causare problemi alla vista.",
        "Il medico ha raccomandato l'uso di questo farmaco solo in caso di necessità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Facoltà o diritto di utilizzare qualcosa, spesso in contrapposizione alla proprietà.",
      "examples": [
        "Il contratto prevede l'uso esclusivo del parcheggio per i residenti.",
        "Gli è stato concesso l'uso dell'appartamento per sei mesi."
      ],
      "nota": "In ambito giuridico, designa un diritto reale limitato di godimento su un bene altrui."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Abitudine o pratica consolidata nel tempo all'interno di una comunità o cultura; consuetudine.",
      "examples": [
        "È uso della famiglia riunirsi a cena ogni domenica.",
        "Secondo gli usi locali, si offre il caffè agli ospiti appena arrivati."
      ],
      "nota": "Spesso usato al plurale (usi) per indicare l'insieme delle tradizioni e consuetudini di un popolo o gruppo: 'usi e costumi'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Modo in cui una parola, un'espressione o una struttura linguistica è effettivamente impiegata dai parlanti in un determinato contesto.",
      "examples": [
        "Il dizionario registra gli usi più recenti della lingua italiana.",
        "Quell'espressione ha un uso prevalentemente colloquiale."
      ],
      "nota": "Accezione tipica della linguistica e della lessicografia."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Deterioramento o consumo progressivo di qualcosa derivante dall'impiego continuato nel tempo.",
      "examples": [
        "Le scarpe si sono rovinate per il lungo uso.",
        "Questa giacca, nonostante gli anni di uso, è ancora in ottimo stato."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha già servito, che non è nuovo; logorato o consumato dall'impiego precedente.",
      "examples": [
        "Ho comprato un paio di sci usati a un prezzo conveniente.",
        "Preferisce acquistare libri usati per risparmiare."
      ],
      "nota": "In questa accezione il termine è participio passato del verbo 'usare', ma funziona stabilmente come aggettivo attributivo e predicativo."
    }
  ]
