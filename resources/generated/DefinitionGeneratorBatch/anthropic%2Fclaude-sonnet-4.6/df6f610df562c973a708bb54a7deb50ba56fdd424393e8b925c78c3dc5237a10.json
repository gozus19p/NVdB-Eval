  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Suddivisione amministrativa o informale di una città, caratterizzata da una propria identità sociale, geografica o urbanistica.",
      "examples": [
        "Il quartiere Prati è uno dei più eleganti di Roma.",
        "Sono cresciuto in un quartiere periferico della città, lontano dal centro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Zona residenziale o area urbana delimitata, considerata in quanto ambiente di vita quotidiana dei suoi abitanti.",
      "examples": [
        "Nel nostro quartiere ci sono due scuole elementari e un mercato rionale.",
        "La gente del quartiere si è riunita per protestare contro la chiusura della biblioteca."
      ],
      "nota": "Questo senso enfatizza la dimensione comunitaria e sociale rispetto alla suddivisione amministrativa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Alloggio o insieme di stanze destinate a un determinato uso o a una determinata persona, specialmente in contesti militari o di servizio.",
      "examples": [
        "I soldati tornarono ai loro quartieri dopo la lunga marcia.",
        "Il personale di servizio aveva i propri quartieri al piano superiore della villa."
      ],
      "nota": "Spesso usato al plurale in questa accezione. Frequente nell'espressione 'quartiere generale', ovvero il luogo da cui si dirige un'operazione militare o organizzativa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nella locuzione 'non dare quartiere', assenza di pietà o di clemenza verso il nemico sconfitto; trattamento senza indulgenza.",
      "examples": [
        "In quella gara i campioni non diedero quartiere agli avversari.",
        "La critica non ha dato quartiere al nuovo romanzo dello scrittore."
      ],
      "nota": "Usato quasi esclusivamente nella locuzione fissa 'dare/non dare quartiere', con uso sia letterale in ambito militare storico sia figurato nel linguaggio comune."
    }
  ]
