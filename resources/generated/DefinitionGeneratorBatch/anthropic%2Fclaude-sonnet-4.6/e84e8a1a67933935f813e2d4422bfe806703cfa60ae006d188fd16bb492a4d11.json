  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte della giornata che va dal tramonto del sole all'inizio della notte, caratterizzata dalla diminuzione della luce naturale.",
      "examples": [
        "La sera d'estate è il momento migliore per passeggiare lungo il lungomare.",
        "Ci vediamo questa sera alle otto per cena."
      ],
      "nota": "Per estensione può indicare anche il periodo che va dal pomeriggio avanzato alla notte. Si distingue da 'notte', che indica il periodo di piena oscurità."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Evento o ricevimento che si svolge nelle ore serali, spesso con carattere mondano o culturale.",
      "examples": [
        "La sera di gala al teatro dell'opera è stata un successo straordinario.",
        "Organizzeremo una sera a tema per festeggiare il loro anniversario."
      ],
      "nota": "In questo senso si avvicina a 'serata', con cui è spesso intercambiabile nel parlato."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso figurato, fase finale o di declino di un periodo, di un'età o di una vita.",
      "examples": [
        "Nella sera della sua vita si dedicò interamente alla famiglia.",
        "Quella sconfitta segnò la sera di un'epoca gloriosa per il club."
      ],
      "nota": "Uso metaforico, per analogia con la sera come fase conclusiva del giorno. Tipico del registro letterario o elevato."
    }
  ]
