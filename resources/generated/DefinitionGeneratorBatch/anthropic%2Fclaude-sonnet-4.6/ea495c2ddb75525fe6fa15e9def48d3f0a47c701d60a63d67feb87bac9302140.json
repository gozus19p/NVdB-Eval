  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Il punto o momento in cui qualcosa comincia, prima parte di un processo, evento o periodo.",
      "examples": [
        "L'inizio del film è stato molto coinvolgente.",
        "Siamo ancora all'inizio del progetto, manca molto lavoro da fare.",
        "L'inizio dell'anno scolastico è fissato per settembre."
      ],
      "nota": "Si contrappone a 'fine' o 'termine'. Può riferirsi sia a un punto temporale preciso sia a una fase iniziale estesa. Comune nelle locuzioni 'all'inizio' (= nella fase iniziale) e 'fin dall'inizio' (= dal primo momento)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il tratto o la parte iniziale di un testo, di un discorso o di un'opera, che precede lo sviluppo centrale.",
      "examples": [
        "L'inizio del romanzo cattura subito l'attenzione del lettore.",
        "Ho riscritto l'inizio della relazione perché non mi convinceva."
      ],
      "nota": "In questo senso si riferisce a una porzione concreta di un testo o di un'opera, distinguendosi dall'accezione temporale astratta."
    }
  ]
