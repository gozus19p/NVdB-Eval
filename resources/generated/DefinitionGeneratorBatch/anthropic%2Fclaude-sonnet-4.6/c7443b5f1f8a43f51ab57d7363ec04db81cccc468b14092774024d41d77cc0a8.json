  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ingaggiare qualcuno come dipendente o collaboratore, instaurando un rapporto di lavoro.",
      "examples": [
        "L'azienda ha deciso di assumere dieci nuovi tecnici entro la fine dell'anno.",
        "Dopo il colloquio, l'hanno assunta con un contratto a tempo indeterminato."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Introdurre nell'organismo una sostanza, come un farmaco, un alimento o una droga, per via orale, inalatoria o altra.",
      "examples": [
        "Il medico le ha consigliato di assumere la compressa a stomaco pieno.",
        "Non bisogna assumere alcol insieme a certi antibiotici."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Prendere o adottare un atteggiamento, un'espressione, una postura o un ruolo.",
      "examples": [
        "Durante il dibattito ha assunto un tono molto formale.",
        "Con il passare dei mesi, il progetto ha assunto una forma completamente diversa."
      ],
      "nota": "Spesso usato con sostantivi astratti come 'tono', 'aspetto', 'forma', 'atteggiamento', 'importanza'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Accettare o fare propria una responsabilità, un impegno o un incarico.",
      "examples": [
        "Ha assunto la direzione della società in un momento molto difficile.",
        "Assumendosi la responsabilità dell'errore, ha evitato conseguenze peggiori."
      ],
      "nota": "Frequente nella costruzione riflessiva 'assumersi la responsabilità / il rischio / l'onere'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Prendere per vero o per dato un presupposto, senza necessariamente dimostrarlo; postulare.",
      "examples": [
        "Il modello assume che tutti gli agenti economici agiscano razionalmente.",
        "Assumiamo, per ipotesi, che le due variabili siano indipendenti."
      ],
      "nota": "Uso prevalente in contesti accademici, scientifici e filosofici; è anche il significato più comune dell'anglismo 'to assume', di cui questa accezione è talvolta un calco."
    }
  ]
