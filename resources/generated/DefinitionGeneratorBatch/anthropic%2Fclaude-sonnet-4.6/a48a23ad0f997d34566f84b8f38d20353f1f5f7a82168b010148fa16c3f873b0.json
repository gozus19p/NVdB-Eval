  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Tendenza dominante in un determinato periodo riguardo al modo di vestirsi, all'abbigliamento e all'aspetto esteriore, spesso soggetta a rapidi cambiamenti.",
      "examples": [
        "Quest'anno la moda propone colori vivaci e silhouette over.",
        "Ha sempre seguito la moda con grande attenzione, aggiornando il guardaroba ogni stagione."
      ],
      "nota": "Spesso usato con l'articolo determinativo 'la moda' per riferirsi all'industria o al sistema della moda nel suo complesso."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Usanza, costume o comportamento diffuso e temporaneamente prevalente in un certo ambito sociale o culturale, non necessariamente legato all'abbigliamento.",
      "examples": [
        "È di moda andare in vacanza in luoghi insoliti e fuori dai circuiti turistici.",
        "La meditazione è diventata una moda tra i giovani delle grandi città."
      ],
      "nota": "In questo senso, spesso ricorre nella locuzione 'essere di moda' o 'andare di moda', con sfumatura talvolta ironica o critica riguardo alla superficialità dell'adozione di certi comportamenti."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In statistica, il valore che ricorre con maggiore frequenza in una distribuzione di dati.",
      "examples": [
        "In questa serie di misurazioni, la moda è 7, che appare sei volte.",
        "Il professore ha spiegato la differenza tra media, mediana e moda usando esempi pratici."
      ],
      "nota": "Termine tecnico della statistica descrittiva; in questo senso non ha uso figurato né variazioni contestuali rilevanti."
    }
  ]
