  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Possedere qualcosa come bene materiale o proprietà.",
      "examples": [
        "Ho una casa al mare che affitto d'estate.",
        "Mia sorella ha tre macchine ma ne usa solo una."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Presentare una caratteristica fisica, qualità o attributo intrinseco.",
      "examples": [
        "Il bambino ha gli occhi chiari come il padre.",
        "Questo appartamento ha dei soffitti altissimi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Provare o sentire uno stato fisico, emotivo o psicologico.",
      "examples": [
        "Ho molta paura di volare.",
        "Dopo la corsa avevo una sete tremenda."
      ],
      "nota": "Ricorrente in costruzioni con sostantivi astratti che esprimono stati interni: avere fame, avere freddo, avere voglia, avere paura."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere o ricevere qualcosa.",
      "examples": [
        "Ho avuto finalmente una risposta dalla banca.",
        "Hai già avuto i risultati delle analisi?"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Intrattenere una relazione o un legame con qualcuno.",
      "examples": [
        "Ho un fratello che vive in Germania.",
        "Aveva tanti amici quando frequentava l'università."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Portare su di sé o indossare qualcosa.",
      "examples": [
        "Aveva un cappotto blu e una sciarpa rossa.",
        "Non ho l'ombrello con me, mi sono bagnata tutta."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Trascorrere o occupare un determinato periodo di tempo (riferito all'età).",
      "examples": [
        "Mia nonna ha novant'anni e sta benissimo.",
        "Quanti anni hai? Ne ho ventisei."
      ],
      "nota": null
    },
    {
      "pos": "verbo ausiliare",
      "definition": "Ausiliare usato per formare i tempi composti di verbi transitivi e di alcuni intransitivi.",
      "examples": [
        "Ho mangiato troppo a pranzo e ora mi sento pesante.",
        "Avevano già finito il lavoro quando arrivò il capo."
      ],
      "nota": "In italiano, la scelta dell'ausiliare nei tempi composti è tra 'avere' ed 'essere'. 'Avere' si usa con i verbi transitivi e con numerosi verbi intransitivi, mentre 'essere' si usa con molti intransitivi e con i riflessivi."
    },
    {
      "pos": "verbo transitivo (colloquiale)",
      "definition": "Riuscire a ingannare o ad avere la meglio su qualcuno.",
      "examples": [
        "Mi ha avuto con quella storia del portafoglio rubato.",
        "Non si fa avere facilmente: è troppo sveglio per cascarne."
      ],
      "nota": "Uso prevalentemente colloquiale e informale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il complesso dei beni e delle risorse economiche di cui dispone una persona; il patrimonio.",
      "examples": [
        "Ha speso tutto il suo avere per aprire quel negozio.",
        "Divise l'avere tra i figli prima di morire."
      ],
      "nota": "Usato quasi esclusivamente nella forma singolare e spesso preceduto da un possessivo."
    }
  ]
}