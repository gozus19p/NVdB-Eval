  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Tracciare segni grafici su una superficie per rappresentare parole, lettere o simboli.",
      "examples": [
        "Ha scritto il suo nome sul foglio con la penna.",
        "I bambini imparano a scrivere le lettere dell'alfabeto in prima elementare."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Comporre un testo, un'opera letteraria, un articolo o qualsiasi contenuto destinato alla lettura.",
      "examples": [
        "Moravia scrisse molti romanzi ambientati a Roma.",
        "Sta scrivendo una tesi di laurea sulla letteratura del Novecento."
      ],
      "nota": "Questo senso si applica a prodotti testuali di qualsiasi tipo: romanzi, poesie, articoli, saggi, ecc."
    },
    {
      "pos": "verbo transitivo/intransitivo",
      "definition": "Inviare una comunicazione scritta a qualcuno, come una lettera, un messaggio o una email.",
      "examples": [
        "Ti scrivo per aggiornarti sulla situazione.",
        "Non mi ha scritto da settimane e sono preoccupata."
      ],
      "nota": "In questo senso è frequente anche l'uso intransitivo con complemento introdotto da 'a': 'scrivere a qualcuno'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Indicare, riportare o registrare qualcosa per iscritto in un documento ufficiale, un modulo o un registro.",
      "examples": [
        "Scrivi la data di nascita nello spazio apposito.",
        "Il medico ha scritto una ricetta per gli antibiotici."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Esercitare la professione o l'attività di autore o giornalista.",
      "examples": [
        "Scrive per il Corriere della Sera da vent'anni.",
        "Ha sempre sognato di scrivere per vivere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Digitare testo su una tastiera o un dispositivo elettronico.",
      "examples": [
        "Scrivi il codice di accesso per sbloccare il telefono.",
        "Stava scrivendo velocemente sul computer quando è arrivata la luce."
      ],
      "nota": "Uso diffuso nel contesto digitale contemporaneo, estensione del senso grafico originario."
    }
  ]
