  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che fa uso della forza fisica per danneggiare, ferire o sopraffare altri; che manifesta aggressività fisica.",
      "examples": [
        "Il detenuto aveva un comportamento violento e veniva isolato dagli altri.",
        "Non voglio stare vicino a quella persona: è violenta e imprevedibile."
      ],
      "nota": "Si riferisce a persone o comportamenti caratterizzati da aggressione fisica diretta."
    },
    {
      "pos": "aggettivo",
      "definition": "Che implica o produce un impatto fisico di grande intensità, capace di causare danni o distruzione.",
      "examples": [
        "Una violenta esplosione ha distrutto l'intero edificio.",
        "Il temporale si è abbattuto sulla città con venti violenti e grandine."
      ],
      "nota": "Applicato a eventi naturali, fenomeni fisici o azioni meccaniche di grande forza."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha un'intensità emotiva o psicologica molto elevata, tale da risultare difficile da controllare o sopportare.",
      "examples": [
        "Provò una violenta gelosia quando vide il suo ex con un'altra persona.",
        "Tra i due fratelli scoppiò un violento litigio che durò ore."
      ],
      "nota": "Uso figurato riferito a sentimenti, emozioni o stati interiori particolarmente intensi."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di colore, contrasto o effetto visivo, che si impone con grande forza e immediatezza, risultando stridente o molto marcato.",
      "examples": [
        "Ha scelto un rosso violento per le pareti del salotto.",
        "Il contrasto tra il bianco e il nero in quel quadro è violento e deliberato."
      ],
      "nota": "Uso prevalentemente estetico-visivo, spesso con sfumatura di eccesso o di rottura dell'armonia."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che fa abitualmente uso della forza fisica o che manifesta comportamenti aggressivi.",
      "examples": [
        "I violenti del quartiere rendevano la vita difficile agli altri residenti.",
        "La polizia è intervenuta per allontanare i violenti dal corteo."
      ],
      "nota": null
    }
  ]
