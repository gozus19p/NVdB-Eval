  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Portare a compimento un'attività o un'opera, concludendola nella sua interezza.",
      "examples": [
        "Ho finito il rapporto stamattina e l'ho inviato al direttore.",
        "Devi finire i compiti prima di uscire a giocare."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Consumare o esaurire completamente una quantità di qualcosa.",
      "examples": [
        "Abbiamo finito il latte; devi andare a comprarne altro.",
        "I ragazzi hanno finito tutte le pizze in un quarto d'ora."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Giungere alla propria conclusione, cessare di durare o di svolgersi (riferito a eventi, periodi, processi).",
      "examples": [
        "Il film finisce alle undici di sera.",
        "L'estate è finita e già si sente l'aria fresca."
      ],
      "nota": "Usato con l'ausiliare 'essere'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trovarsi o capitare in un luogo, una situazione o una condizione determinati, spesso in modo inaspettato o involontario.",
      "examples": [
        "Dopo la lite con i colleghi è finito in aspettativa.",
        "Per un malinteso, la lettera è finita nell'ufficio sbagliato."
      ],
      "nota": "Usato con l'ausiliare 'essere'; spesso implica un esito non pianificato."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un determinato esito o risultato finale, concludersi in un certo modo.",
      "examples": [
        "La storia è finita bene per tutti i protagonisti.",
        "Se continua così, finirà nei guai."
      ],
      "nota": "Usato con l'ausiliare 'essere'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Cessare una relazione sentimentale o interrompere un legame interpersonale.",
      "examples": [
        "Dopo tre anni insieme, lei e Marco hanno finito.",
        "Hanno finito la scorsa estate, ma restano in buoni rapporti."
      ],
      "nota": "Uso colloquiale, spesso assoluto o accompagnato da 'con qualcuno'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Smettere di fare qualcosa, interrompere un'azione in corso.",
      "examples": [
        "Finiscila di lamentarti, per favore!",
        "Quando finisci di parlare al telefono, vieni a tavola."
      ],
      "nota": "Spesso costruito con 'di' + infinito; la forma 'finiscila' è molto frequente nel registro colloquiale con valore imperativo esortativo."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Terminare nello spazio, avere un limite o un confine fisico.",
      "examples": [
        "La strada finisce davanti al mare.",
        "Il bosco finisce proprio ai margini del paese."
      ],
      "nota": null
    }
  ]
