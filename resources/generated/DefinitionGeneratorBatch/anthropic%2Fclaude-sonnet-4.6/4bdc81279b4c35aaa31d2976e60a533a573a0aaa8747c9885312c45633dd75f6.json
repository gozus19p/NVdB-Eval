  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rientrare in possesso di qualcosa che era stato perso, rubato, dimenticato o temporaneamente ceduto.",
      "examples": [
        "Dopo settimane di ricerche, ha finalmente recuperato il portafoglio smarrito.",
        "La polizia è riuscita a recuperare i beni rubati durante la rapina."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Trarre in salvo persone o oggetti da situazioni di pericolo, difficoltà o luoghi inaccessibili.",
      "examples": [
        "I soccorritori hanno recuperato i naufraghi alla deriva in mare aperto.",
        "L'elicottero ha recuperato l'escursionista bloccato sulla parete rocciosa."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Riportare qualcosa o qualcuno a uno stato di funzionamento, salute o utilità dopo un periodo di deterioramento o crisi.",
      "examples": [
        "I medici sono riusciti a recuperare il paziente dopo un lungo coma.",
        "Il restauratore ha recuperato il dipinto che sembrava ormai perduto."
      ],
      "nota": "Distinto dal senso di 'rientrare in possesso' perché implica un processo di ripristino o guarigione, non solo un ritrovamento."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Compensare un ritardo, un deficit o una perdita di tempo, denaro o rendimento, raggiungendo il livello atteso o precedente.",
      "examples": [
        "Ha studiato intensamente per recuperare il programma perso durante la malattia.",
        "La squadra ha recuperato tre punti di svantaggio negli ultimi minuti della partita."
      ],
      "nota": "Frequente in contesti sportivi, scolastici e lavorativi."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Riutilizzare materiali o risorse che altrimenti andrebbero scartati, riciclandoli o reimpiegandoli in nuovi contesti.",
      "examples": [
        "Hanno recuperato le travi di legno del vecchio fienile per arredare il loft.",
        "Questa azienda recupera i materiali di scarto per produrre nuovi oggetti."
      ],
      "nota": "Questo senso è particolarmente attivo nel linguaggio dell'economia circolare e del design sostenibile."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Svolgere o far svolgere in data diversa un'attività precedentemente annullata o saltata, come una lezione, una partita o una giornata lavorativa.",
      "examples": [
        "L'ora di lezione persa verrà recuperata giovedì pomeriggio.",
        "La partita rinviata per il maltempo sarà recuperata mercoledì sera."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Ripristinare le proprie energie fisiche o psicologiche dopo uno sforzo, una malattia o un momento di difficoltà.",
      "examples": [
        "Dopo la maratona ci ha messo tre giorni a recuperarsi completamente.",
        "Con qualche giorno di riposo si è recuperata e ora sta benissimo."
      ],
      "nota": "La forma riflessiva è spesso usata in senso fisico ma può estendersi al recupero emotivo o mentale."
    }
  ]
