  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Articolazione intermedia dell'arto inferiore umano, posta tra la coscia e la gamba, che consente la flessione e l'estensione della gamba.",
      "examples": [
        "Si è fatto male al ginocchio durante la partita di calcio.",
        "Dopo la caduta dalla bici, aveva il ginocchio sbucciato e sanguinante.",
        "Il chirurgo ha operato il ginocchio del paziente per riparare il menisco."
      ],
      "nota": "Il plurale presenta una doppia forma: 'ginocchi' (maschile, più comune in senso anatomico generico) e 'ginocchia' (femminile, usato spesso in contesti espressivi o idiomatici, es. 'cadere in ginocchia')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte di un indumento, in particolare di pantaloni o calze, che copre o corrisponde all'articolazione del ginocchio.",
      "examples": [
        "Ha i pantaloni consumati al ginocchio dopo anni di lavoro in giardino.",
        "Quei jeans hanno il ginocchio strappato di proposito, è l'ultimo trend."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato, posizione di sottomissione, dipendenza o resa totale nei confronti di qualcuno o qualcosa.",
      "examples": [
        "Quella politica fiscale ha messo il paese in ginocchio.",
        "La crisi ha portato in ginocchio molte piccole imprese del settore."
      ],
      "nota": "Usato quasi esclusivamente nella locuzione 'mettere/portare/essere in ginocchio', con il significato di ridurre o trovarsi in uno stato di prostrazione o collasso."
    }
  ]
