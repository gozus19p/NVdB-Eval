  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi rapidamente da un luogo o da una situazione per sottrarsi a un pericolo, a una cattura o a qualcosa di temuto.",
      "examples": [
        "Il detenuto è riuscito a fuggire dal carcere durante la notte.",
        "Alla vista del cane, il gatto fuggì sul tetto."
      ],
      "nota": "Costruito spesso con le preposizioni 'da' (fuggire da qualcosa/qualcuno) o 'via'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Evitare deliberatamente qualcuno o qualcosa, tenendosene lontano.",
      "examples": [
        "Da quando litigarono, lei fugge qualsiasi occasione di incontrarlo.",
        "Il politico fugge le domande scomode dei giornalisti."
      ],
      "nota": "In questo uso transitivo il verbo è sinonimo di 'evitare' o 'schivare'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Scorrere o trascorrere velocemente, detto del tempo o di ciò che passa in modo inarrestabile.",
      "examples": [
        "Gli anni fuggono senza che ce ne accorgiamo.",
        "Le vacanze sono fuggite troppo in fretta."
      ],
      "nota": "Uso figurato, frequente in contesti poetici o letterari ma attestato anche nel parlato contemporaneo."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Andarsene da un luogo o da una condizione per cercare sollievo, libertà o evasione, senza necessariamente essere inseguiti.",
      "examples": [
        "Ogni estate fuggono dalla città per rifugiarsi in montagna.",
        "Aveva bisogno di fuggire dalla routine quotidiana."
      ],
      "nota": "In questo senso non implica pericolo reale, ma un desiderio di distacco da una situazione oppressiva o monotona."
    }
  ]
