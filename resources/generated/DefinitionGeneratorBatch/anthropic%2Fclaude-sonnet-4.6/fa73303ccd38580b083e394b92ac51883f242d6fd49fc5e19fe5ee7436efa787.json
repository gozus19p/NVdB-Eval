  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Oggetto sferico, spesso cavo e rimbalzante, usato in giochi e sport di vario tipo.",
      "examples": [
        "Il bambino calciò la palla oltre il cancello.",
        "La palla rimbalzò sul bordo del canestro senza entrare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel gioco del calcio e in altri sport, il possesso o il controllo del pallone durante la partita.",
      "examples": [
        "La squadra ha tenuto la palla per quasi tutto il secondo tempo.",
        "Pressing alto per recuperare palla nella metà campo avversaria."
      ],
      "nota": "In contesti sportivi 'palla' può essere usato come sinonimo di 'pallone' riferendosi all'attrezzo di gioco o alla sua gestione tattica."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Proiettile sferico o cilindrico sparato da un'arma da fuoco.",
      "examples": [
        "La palla lo colpì alla spalla destra.",
        "I soldati trovarono palle di cannone ancora conficcate nelle mura del castello."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Forma sferica assunta da un oggetto o da una massa di materia.",
      "examples": [
        "Arrotolò il filo di lana a palla per non aggrovigliarlo.",
        "Fece una palla di neve e la scagliò contro l'amico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f. (gergale, spesso al plurale)",
      "definition": "Bugia, menzogna o affermazione priva di fondamento; fandonia.",
      "examples": [
        "Non raccontarmi palle, so già come sono andate le cose.",
        "Quella storia è una palla colossale che nessuno dovrebbe credere."
      ],
      "nota": "Uso colloquiale e informale. Comune nell'espressione 'raccontare palle'."
    },
    {
      "pos": "sostantivo f. (gergale, spesso al plurale)",
      "definition": "Cosa o situazione estremamente noiosa, fastidiosa o irritante.",
      "examples": [
        "Questo film è una palla, me ne vado.",
        "Stare tre ore in fila alle Poste è una palla assurda."
      ],
      "nota": "Registro colloquiale, talvolta volgare a seconda del contesto. Affine all'espressione 'che palle!'."
    },
    {
      "pos": "sostantivo f. (gergale, volgare, al plurale)",
      "definition": "I testicoli, in riferimento all'anatomia maschile.",
      "examples": [
        "Prendere un calcio nelle palle è un dolore insopportabile.",
        "Nel gergo giovanile l'espressione è usata frequentemente in senso figurato."
      ],
      "nota": "Termine volgare, da usare con cautela. Da questa accezione derivano molte espressioni figurate colloquiali (es. 'rompere le palle', 'avere le palle' nel senso di coraggio)."
    },
    {
      "pos": "sostantivo f. (figurato)",
      "definition": "Opportunità favorevole, occasione da cogliere al momento giusto; usato soprattutto nelle locuzioni.",
      "examples": [
        "Era la palla giusta per rilanciarsi nel mercato e l'azienda non se la lasciò sfuggire.",
        "Ha avuto la sua palla e l'ha sprecata per colpa della sua indecisione."
      ],
      "nota": "Prevalentemente usato nella locuzione 'palla al balzo' (cogliere la palla al balzo) con il significato di approfittare prontamente di un'occasione."
    }
  ]
}