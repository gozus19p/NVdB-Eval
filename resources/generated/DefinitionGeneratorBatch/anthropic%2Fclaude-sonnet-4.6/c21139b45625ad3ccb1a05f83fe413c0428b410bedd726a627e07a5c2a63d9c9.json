  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Conosciuto da molte persone, di cui si ha ampia consapevolezza o informazione; famoso, risaputo.",
      "examples": [
        "È un fatto noto a tutti che il fumo fa male alla salute.",
        "Il regista è diventato noto grazie al suo primo film premiato a Cannes.",
        "La sua storia è ormai nota in tutto il paese."
      ],
      "nota": "Si usa spesso nella costruzione 'è noto che + indicativo/congiuntivo' per introdurre informazioni date per acquisite. Può assumere sfumatura di 'famigerato' in contesti negativi: 'un criminale noto alle forze dell'ordine'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Città della Sicilia meridionale, capoluogo di provincia, famosa per il suo centro storico barocco patrimonio UNESCO.",
      "examples": [
        "Abbiamo trascorso un weekend a Noto per visitare la cattedrale barocca.",
        "Noto è spesso definita la capitale del barocco siciliano."
      ],
      "nota": "Usato come nome proprio geografico; in questo senso si scrive con l'iniziale maiuscola."
    }
  ]
