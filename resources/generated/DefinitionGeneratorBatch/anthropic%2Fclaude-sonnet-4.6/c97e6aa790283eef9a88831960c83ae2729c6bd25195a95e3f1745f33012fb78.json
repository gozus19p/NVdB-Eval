  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Insegnante della scuola primaria, responsabile dell'istruzione di base dei bambini.",
      "examples": [
        "Il maestro ha spiegato le tabelline con molta pazienza.",
        "Da piccola avevo un maestro severo ma molto preparato."
      ],
      "nota": "Al femminile: maestra. In contesti formali si usa anche 'insegnante elementare'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di grande competenza e autorità in un'arte, un mestiere o una disciplina, riconosciuta come punto di riferimento dai propri allievi o seguaci.",
      "examples": [
        "Leonardo da Vinci è considerato uno dei più grandi maestri della pittura di tutti i tempi.",
        "Ha studiato scultura sotto la guida di un maestro rinomato."
      ],
      "nota": "Spesso usato come titolo onorifico anteposto al nome proprio: 'il Maestro Verdi'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Direttore d'orchestra o compositore di musica classica di alto livello, nonché insegnante di canto o strumento musicale.",
      "examples": [
        "Il maestro ha alzato la bacchetta e l'orchestra ha iniziato a suonare.",
        "Studia pianoforte dal maestro Ricci da quando aveva sei anni."
      ],
      "nota": "In ambito musicale 'Maestro' con iniziale maiuscola è il titolo per eccellenza con cui ci si rivolge a direttori d'orchestra e compositori affermati."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Artigiano o lavoratore altamente specializzato che ha raggiunto il massimo grado di qualificazione nel proprio campo.",
      "examples": [
        "Il maestro vetraio di Murano ha soffiato il vetro con una tecnica millenaria.",
        "Era un maestro falegname capace di costruire mobili di rara bellezza."
      ],
      "nota": "In questo senso si trova spesso in espressioni composte come 'maestro artigiano', 'maestro muratore', 'maestro orafo'."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di qualcosa che è principale, fondamentale o che mostra una perizia eccezionale.",
      "examples": [
        "Il ladro ha agito con una mossa maestra, sparendo senza lasciare tracce.",
        "Quella parete maestra non può essere abbattuta perché regge tutta la struttura."
      ],
      "nota": "In architettura 'muro/parete maestro/a' indica la struttura portante principale dell'edificio. In senso figurato 'colpo maestro' indica un'azione di grande abilità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Vento di nord-ovest tipico del Mediterraneo, detto anche maestrale.",
      "examples": [
        "Oggi soffia il maestro e il mare è molto agitato.",
        "Con questo maestro le barche faticano a rientrare in porto."
      ],
      "nota": "Forma sincopata di 'maestrale'. Più comune nella forma piena 'maestrale' nel parlato standard; 'maestro' è frequente nelle aree costiere."
    }
  ]
