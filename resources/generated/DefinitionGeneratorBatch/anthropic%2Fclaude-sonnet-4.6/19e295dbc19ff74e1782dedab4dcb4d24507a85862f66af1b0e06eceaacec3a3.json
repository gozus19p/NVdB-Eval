  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova dalla parte contraria rispetto a un punto di riferimento, collocato in direzione diametralmente inversa.",
      "examples": [
        "Le due finestre si affacciano su lati opposti dell'edificio.",
        "Partirono in direzioni opposte senza salutarsi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è in contrasto netto o in contraddizione con qualcos'altro per natura, carattere o contenuto.",
      "examples": [
        "I due candidati sostengono opinioni del tutto opposte sulla riforma fiscale.",
        "Hanno caratteri opposti: lui è estroverso, lei timidissima."
      ],
      "nota": "In questo senso è spesso usato come predicato nominale o in posizione attributiva per indicare incompatibilità concettuale, non solo spaziale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che è in totale contrasto o antitesi con qualcosa o qualcuno; il contrario.",
      "examples": [
        "Il coraggio e la viltà sono l'opposto l'uno dell'altro.",
        "Credevo che fosse onesto, ma si è rivelato l'esatto opposto."
      ],
      "nota": "Frequentemente preceduto dall'articolo determinativo e rafforzato da aggettivi come 'esatto' o 'vero': 'l'esatto opposto', 'il vero opposto'."
    },
    {
      "pos": "participio passato (verbo transitivo)",
      "definition": "Forma participiale del verbo 'opporre': frapposto come ostacolo o resistenza a qualcosa.",
      "examples": [
        "Il governo ha opposto un netto rifiuto alla proposta.",
        "Nessun argomento valido fu opposto alle accuse del pubblico ministero."
      ],
      "nota": "In quanto participio passato di 'opporre', può fungere da predicativo o da modificatore nominale in costruzioni passive."
    }
  ]
