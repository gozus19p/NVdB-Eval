  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta caratteristiche diverse tra loro, non uniforme, differenziato nella forma, nel contenuto o nella natura.",
      "examples": [
        "Il menù offre una scelta varia di piatti per tutti i gusti.",
        "Ha avuto un'esperienza lavorativa varia, passando da un settore all'altro."
      ],
      "nota": "Usato al singolare, si riferisce alla qualità di ciò che non è monotono o uniforme."
    },
    {
      "pos": "aggettivo (plurale)",
      "definition": "Usato al plurale per indicare una molteplicità di elementi distinti, equivalente a 'diversi', 'parecchi', 'molteplici'.",
      "examples": [
        "Varie persone hanno segnalato il problema alle autorità.",
        "Ho ricevuto vari messaggi di supporto dopo la pubblicazione dell'articolo."
      ],
      "nota": "Al plurale precede spesso il sostantivo senza articolo e ha valore quantitativo-indefinito, sovrapponibile a 'diversi' o 'parecchi'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che cambia nel tempo o nelle circostanze, mutevole, non costante.",
      "examples": [
        "Il suo umore era vario e imprevedibile nel corso della giornata.",
        "Le condizioni meteorologiche si preannunciano varie nei prossimi giorni."
      ],
      "nota": "Questo senso è meno frequente nell'italiano contemporaneo e si avvicina a 'variabile' o 'instabile'."
    }
  ]
