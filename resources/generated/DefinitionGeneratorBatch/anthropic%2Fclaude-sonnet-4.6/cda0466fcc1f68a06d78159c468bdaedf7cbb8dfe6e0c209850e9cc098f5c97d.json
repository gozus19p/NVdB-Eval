  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Recarsi abitualmente in un luogo, visitarlo con regolarità.",
      "examples": [
        "Frequenta quella palestra da tre anni ormai.",
        "Il locale è frequentato soprattutto da giovani universitari."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Seguire regolarmente un corso di studi, una scuola o un'istituzione formativa.",
      "examples": [
        "Ha frequentato il liceo classico e poi si è iscritta a medicina.",
        "Mio figlio frequenta la terza elementare."
      ],
      "nota": "In questo senso il complemento oggetto è tipicamente un'istituzione scolastica o un corso specifico."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere rapporti abituali e ripetuti con una persona, vederla spesso.",
      "examples": [
        "Da quando si è trasferito, frequenta molta gente nuova.",
        "Non frequento più i vecchi amici del liceo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere una relazione sentimentale o romantica con qualcuno, uscire regolarmente insieme.",
      "examples": [
        "Si sono messi insieme dopo aversi frequentato per quasi un anno.",
        "Lo sta frequentando da qualche mese, ma non è ancora ufficiale."
      ],
      "nota": "Uso tipico del registro colloquiale contemporaneo, spesso riferito a una fase preliminare rispetto a una relazione stabile."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Vedersi reciprocamente con regolarità, mantenere contatti abituali tra più persone.",
      "examples": [
        "Dopo il matrimonio ci siamo frequentati sempre meno.",
        "I due si frequentano da anni e sono ormai grandi amici."
      ],
      "nota": null
    }
  ]
