  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che offre benessere fisico, che permette di stare a proprio agio per le sue caratteristiche materiali; detto di oggetti, ambienti o situazioni che non causano disagio o fatica.",
      "examples": [
        "Questa poltrona è davvero comoda, potrei starci seduto per ore.",
        "L'appartamento è piccolo ma comodo, con tutti i servizi a portata di mano."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si adatta facilmente alle esigenze di qualcuno, che non richiede sforzo o sacrificio; pratico, conveniente.",
      "examples": [
        "Abitare vicino all'ufficio è molto comodo: ci metto dieci minuti a piedi.",
        "È comodo avere la spesa consegnata a domicilio."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, che evita impegni e fatiche, che agisce solo quando è vantaggioso per sé; pigro o opportunista.",
      "examples": [
        "È un tipo comodo: si fa vedere solo quando ha bisogno di qualcosa.",
        "Non fare il comodo e vieni ad aiutarci anche tu."
      ],
      "nota": "In questo senso l'aggettivo ha una connotazione negativa e valutativa. Spesso usato con il verbo 'fare' nella forma 'fare il comodo'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che avviene o si svolge senza fretta, con calma e tranquillità; detto di ritmi, tempi o modalità di azione.",
      "examples": [
        "Fai con comodo, non c'è nessuna fretta.",
        "Abbiamo tempi comodi per consegnare il progetto."
      ],
      "nota": "Frequente nell'espressione 'fare con comodo', usata per invitare qualcuno a non affrettarsi."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione di benessere, di facilità o di assenza di disagio; ciò che rende la vita più piacevole o meno faticosa.",
      "examples": [
        "Con l'età si apprezza sempre di più il comodo di una casa ben riscaldata.",
        "Ha rinunciato ai comodi della città per andare a vivere in campagna."
      ],
      "nota": "Usato sia al singolare sia al plurale ('i comodi'); al plurale indica spesso le comodità materiali della vita quotidiana."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Vantaggio personale, tornaconto, interesse proprio.",
      "examples": [
        "Lo fa solo per il suo comodo, non per aiutare gli altri.",
        "Si ricorda di noi solo quando fa comodo a lui."
      ],
      "nota": "Ricorrente nelle locuzioni 'fare comodo' (tornare utile) e 'per il proprio comodo'."
    }
  ]
}