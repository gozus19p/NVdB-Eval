  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Parte del corpo che collega la testa al tronco, nei vertebrati e in particolare nell'essere umano.",
      "examples": [
        "Aveva un dolore al collo dopo aver dormito in una posizione scomoda.",
        "La giraffa ha un collo straordinariamente lungo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte ristretta o allungata di un oggetto che ne ricorda la forma anatomica, come quella di una bottiglia, di un vaso o di un indumento.",
      "examples": [
        "Il vino era rimasto nel collo della bottiglia.",
        "Questo maglione ha il collo troppo stretto."
      ],
      "nota": "Comune in espressioni come 'collo della bottiglia', 'collo alto' (riferito a capi di abbigliamento)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Pacco, bagaglio o involto destinato alla spedizione o al trasporto, considerato come unità di carico.",
      "examples": [
        "La spedizione è composta da tre colli di cui uno particolarmente pesante.",
        "Il corriere ha consegnato tutti i colli previsti dalla fattura."
      ],
      "nota": "Uso tipico nel linguaggio commerciale, doganale e della logistica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Valico montano, passo tra due rilievi che consente il passaggio da una valle all'altra.",
      "examples": [
        "Abbiamo attraversato il collo di montagna prima che arrivasse il maltempo.",
        "Il collo del Frejus è percorribile tutto l'anno grazie al tunnel."
      ],
      "nota": "Uso prevalente nella toponomastica alpina e nell'italiano settentrionale; sinonimo di 'passo'."
    },
    {
      "pos": "sostantivo m. (uso figurato)",
      "definition": "Punto critico o di strozzatura che limita il flusso o lo sviluppo di un processo; elemento che costituisce un ostacolo o una limitazione.",
      "examples": [
        "La burocrazia rappresenta il collo di bottiglia di tutto il sistema.",
        "Dobbiamo individuare il collo di bottiglia nella catena produttiva."
      ],
      "nota": "Quasi esclusivamente nella locuzione 'collo di bottiglia', calco dell'inglese 'bottleneck', usata in contesti economici, informatici e organizzativi."
    }
  ]
