  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Essere presente, comparire o risultare incluso in un elenco, documento, graduatoria o contesto specifico.",
      "examples": [
        "Il suo nome figura tra i candidati selezionati per il premio.",
        "Questo articolo non figura nel catalogo ufficiale dell'editore."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Fare una certa impressione o bella mostra di sé in un contesto sociale, dimostrando prestigio o eleganza.",
      "examples": [
        "Con quel vestito ha figurato benissimo alla cerimonia.",
        "Vuole sempre figurare davanti agli amici, anche quando non ne ha i mezzi."
      ],
      "nota": "Spesso usato con avverbi di modo come 'bene' o 'male'; ha connotazione leggermente ironica quando implica ostentazione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rappresentare visivamente qualcosa o qualcuno attraverso un'immagine, un disegno o una descrizione.",
      "examples": [
        "Il pittore ha figurato la scena della battaglia con grande realismo.",
        "Il manoscritto medievale figurava santi e angeli con colori vivaci."
      ],
      "nota": "In questo senso è più comune nell'italiano letterario o nel linguaggio critico e artistico."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Immaginare o concepire mentalmente qualcosa o qualcuno in un certo modo.",
      "examples": [
        "Non riesco a figurarmi come potrebbe finire questa storia.",
        "Me lo figuravo molto più alto di come è in realtà."
      ],
      "nota": "In questo senso è quasi esclusivamente usato nella forma riflessiva 'figurarsi'."
    },
    {
      "pos": "verbo impersonale (forma riflessiva)",
      "definition": "Usato come risposta per negare che qualcosa costituisca un problema o un disturbo, equivalente a 'non c'è di che' o 'ma figurati'.",
      "examples": [
        "— Grazie mille per l'aiuto! — Ma figurati, è stato un piacere.",
        "— Spero di non averti disturbato. — Figurati, non stavo facendo nulla di importante."
      ],
      "nota": "Uso pragmatico e formulaico, tipico del parlato; le forme 'figurati' (informale) e 'si figuri' (formale) sono intercambiabili a seconda del registro."
    },
    {
      "pos": "verbo impersonale (forma riflessiva)",
      "definition": "Usato per esprimere ovvietà, rafforzamento di un'affermazione o ironia, con il senso di 'immagina un po'' o 'puoi ben immaginare'.",
      "examples": [
        "Se già fa fatica a camminare, figurati a correre!",
        "Non riesce a gestire le cose semplici, figuriamoci quelle complesse."
      ],
      "nota": "Questo uso enfatico è molto frequente nel parlato e serve spesso a introdurre un caso estremo o paradossale a scopo argomentativo."
    }
  ]
