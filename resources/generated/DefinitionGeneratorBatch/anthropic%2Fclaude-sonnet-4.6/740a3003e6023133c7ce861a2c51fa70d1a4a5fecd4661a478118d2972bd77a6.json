  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Magistrato investito dell'autorità statale di amministrare la giustizia, esaminare i casi portati in tribunale e pronunciare sentenze.",
      "examples": [
        "Il giudice ha condannato l'imputato a tre anni di reclusione.",
        "La giudice ha rinviato l'udienza alla settimana successiva."
      ],
      "nota": "In italiano contemporaneo la forma è invariabile nel genere grammaticale del sostantivo: 'il giudice' (m.) e 'la giudice' (f.), benché esista anche la variante 'la giudicessa', oggi rara e talvolta percepita come spregiativa."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona incaricata di valutare e giudicare i partecipanti o le opere in una competizione, concorso o gara, assegnando punteggi o decretando i vincitori.",
      "examples": [
        "I giudici della gara di pattinaggio hanno assegnato un punteggio altissimo alla giovane atleta.",
        "È stata chiamata come giudice al festival letterario per selezionare il romanzo vincitore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona ritenuta competente o legittimata a esprimere un parere autorevole su qualcosa, a valutare o distinguere ciò che è giusto, bello o corretto.",
      "examples": [
        "In materia di vini, Marco è un giudice infallibile.",
        "Non sono il giudice adatto per stabilire chi dei due abbia ragione."
      ],
      "nota": "Uso figurato, spesso in contesti in cui si sottolinea l'autorevolezza o, al contrario, la mancanza di legittimità della persona nel valutare qualcosa."
    }
  ]
