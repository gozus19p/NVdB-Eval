  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Essere soprannaturale presente nelle tradizioni religiose abramitiche, concepito come messaggero o servitore di Dio, tipicamente raffigurato con le ali e dotato di natura spirituale.",
      "examples": [
        "Secondo la Bibbia, un angelo apparve a Maria per annunciarle la nascita di Gesù.",
        "I bambini disegnano spesso gli angeli con grandi ali bianche e aureola dorata."
      ],
      "nota": "Nella teologia cattolica gli angeli sono organizzati in gerarchie (serafini, cherubini, arcangeli, ecc.). Il termine si distingue da 'arcangelo', che indica un rango superiore."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di straordinaria bontà, dolcezza o generosità, usato per lodare o esprimere affetto verso qualcuno.",
      "examples": [
        "Quella volontaria è un angelo: dedica tutto il suo tempo libero ad aiutare i senzatetto.",
        "Sei stato un angelo ad assistermi durante la malattia, non so come ringraziarti."
      ],
      "nota": "Uso figurato e iperbolico, frequente nel registro affettivo e familiare."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Termine d'affetto rivolto a una persona cara, in particolare a un bambino o al partner.",
      "examples": [
        "Dai, angelo mio, smettila di piangere che adesso arriviamo.",
        "Buonanotte, angelo, sogni d'oro."
      ],
      "nota": "Uso vocativo tipico del registro familiare e affettuoso; spesso accompagnato dal possessivo 'mio/mia'."
    }
  ]
