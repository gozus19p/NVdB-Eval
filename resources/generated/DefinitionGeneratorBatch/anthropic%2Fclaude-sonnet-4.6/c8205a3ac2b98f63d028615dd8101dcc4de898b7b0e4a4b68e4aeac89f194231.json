  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Testo scritto di lunghezza variabile destinato alla pubblicazione su un giornale, una rivista o un sito web, che tratta un argomento specifico.",
      "examples": [
        "Ha pubblicato un articolo di fondo sul Corriere della Sera.",
        "Sto leggendo un articolo interessante sulla crisi climatica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Singola unità normativa numerata all'interno di un testo giuridico, legislativo o contrattuale.",
      "examples": [
        "L'articolo 21 della Costituzione garantisce la libertà di espressione.",
        "Il contratto prevede all'articolo 5 le condizioni di recesso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Categoria grammaticale che precede il sostantivo per indicarne il genere, il numero e la definitezza o indefinitezza del referente.",
      "examples": [
        "In italiano, 'il', 'lo' e 'la' sono articoli determinativi.",
        "L'insegnante ha spiegato quando usare l'articolo indeterminativo."
      ],
      "nota": "Si distingue tra articolo determinativo (il, lo, la, i, gli, le) e articolo indeterminativo (un, uno, una, un')."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Singolo prodotto o merce in vendita, identificabile come unità distinta all'interno di un assortimento commerciale.",
      "examples": [
        "Questo articolo è esaurito in magazzino.",
        "Il negozio offre articoli sportivi di ogni tipo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Voce o sezione numerata di un elenco, una lista o un documento strutturato.",
      "examples": [
        "L'ordine del giorno comprende tre articoli da discutere.",
        "Passa al prossimo articolo dell'inventario."
      ],
      "nota": "In questo senso è vicino a 'punto' o 'voce', ma enfatizza la suddivisione formale del documento."
    }
  ]
