  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Produrre musica attraverso uno strumento musicale, azionandolo con la tecnica appropriata.",
      "examples": [
        "Mia figlia suona il pianoforte da quando aveva cinque anni.",
        "La band ha suonato tre concerti in una settimana."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Emettere un suono, riferito a uno strumento musicale, un campanello, un allarme o qualsiasi dispositivo sonoro.",
      "examples": [
        "Il telefono ha suonato tre volte prima che rispondessi.",
        "Le campane suonano ogni domenica mattina."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre un'impressione acustica o semantica di un certo tipo; risultare in un certo modo all'orecchio o alla mente.",
      "examples": [
        "Quella frase suona strana in italiano.",
        "Il suo discorso suonava falso fin dalle prime parole."
      ],
      "nota": "In questo senso il verbo è spesso seguito da un aggettivo predicativo (strano, bene, male, falso, ecc.) e ha valore copulativo-valutativo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Azionare un dispositivo di segnalazione acustica, come un campanello o un clacson, per richiamare l'attenzione.",
      "examples": [
        "Ho suonato il campanello ma nessuno ha risposto.",
        "Smettila di suonare il clacson, non si fa."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nel linguaggio colloquiale, colpire qualcuno con pugni o percosse; picchiare.",
      "examples": [
        "Se continui a provocarmi, ti suono.",
        "Lo hanno suonato di santa ragione fuori dal locale."
      ],
      "nota": "Uso informale e colloquiale, con connotazione di violenza fisica. Spesso usato all'iperbole."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un brano musicale su uno strumento o con la voce.",
      "examples": [
        "Il pianista ha suonato una sonata di Beethoven.",
        "Puoi suonare qualcosa di più allegro?"
      ],
      "nota": "Questo senso si sovrappone parzialmente al primo, ma si distingue per il focus sulla singola esecuzione di un pezzo anziché sulla pratica dello strumento in generale."
    }
  ]
