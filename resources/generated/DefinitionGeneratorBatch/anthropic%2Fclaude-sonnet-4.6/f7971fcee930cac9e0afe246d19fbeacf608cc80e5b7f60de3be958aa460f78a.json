  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Spostarsi da un luogo a un altro, percorrendo una certa distanza, spesso per turismo, lavoro o necessità.",
      "examples": [
        "Quest'estate abbiamo viaggiato per tutta la Spagna.",
        "Mia sorella viaggia spesso per lavoro e trascorre poco tempo a casa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere trasportato o in transito, detto di merci, pacchi o corrispondenza.",
      "examples": [
        "Il pacco viaggia in espresso e arriverà domani.",
        "Le merci deperibili viaggiano in celle frigorifere."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi o procedere a una determinata velocità, detto di veicoli o persone in movimento.",
      "examples": [
        "Il treno viaggiava a duecento chilometri orari.",
        "Stava viaggiando troppo veloce per quella strada di montagna."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Scorrere o propagarsi attraverso un mezzo o una rete, detto di segnali, dati o informazioni.",
      "examples": [
        "I dati viaggiano sulla rete a una velocità impressionante.",
        "La voce viaggia attraverso l'aria sotto forma di onde sonore."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "In senso figurato, lasciarsi andare con la fantasia o il pensiero, distaccarsi mentalmente dalla realtà presente.",
      "examples": [
        "Durante la lezione la sua mente viaggiava lontano, tra ricordi e sogni.",
        "Ama viaggiare con la fantasia leggendo romanzi di avventura."
      ],
      "nota": "Spesso usato con complementi come 'con la fantasia', 'con la mente' o 'col pensiero'."
    }
  ]
