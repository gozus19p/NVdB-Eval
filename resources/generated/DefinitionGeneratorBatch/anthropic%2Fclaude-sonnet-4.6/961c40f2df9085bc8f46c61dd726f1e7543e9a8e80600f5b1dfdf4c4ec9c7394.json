  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Capacità fisica di esercitare potenza muscolare, di sollevare, spingere o resistere a carichi e sforzi.",
      "examples": [
        "Bisogna avere molta forza per sollevare quel peso.",
        "Con gli anni ha perso la forza nelle gambe."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Energia interiore, resistenza psicologica o morale di fronte a difficoltà, dolore o avversità.",
      "examples": [
        "Ha affrontato la malattia con una forza d'animo straordinaria.",
        "Trovò la forza di andare avanti nonostante tutto."
      ],
      "nota": "Spesso in locuzioni come 'forza di volontà', 'forza d'animo'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In fisica, grandezza vettoriale che produce o tende a produrre un'accelerazione su un corpo o una deformazione in esso.",
      "examples": [
        "La forza gravitazionale mantiene i pianeti in orbita attorno al Sole.",
        "Il professore ha spiegato la formula per calcolare la forza risultante."
      ],
      "nota": "Senso tecnico-scientifico, ma ampiamente diffuso nell'uso comune."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Intensità o potenza di un fenomeno naturale, di un evento o di un'azione.",
      "examples": [
        "La forza del vento ha abbattuto diversi alberi.",
        "Rimase colpito dalla forza delle onde durante la tempesta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Potere coercitivo o violenza esercitata su qualcuno per obbligarlo a fare qualcosa contro la propria volontà.",
      "examples": [
        "Il contratto firmato sotto forza non ha valore legale.",
        "La polizia è intervenuta con la forza per disperdere i manifestanti."
      ],
      "nota": "Ricorre spesso nelle locuzioni 'con la forza', 'uso della forza'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Influenza, peso o autorità determinante di qualcosa nel condizionare situazioni o decisioni.",
      "examples": [
        "La forza delle circostanze ci ha costretti a cambiare piano.",
        "Nessuno può resistere alla forza dell'abitudine."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Gruppo organizzato di persone, spec. militari o di polizia, deputato a compiti di difesa, ordine o intervento.",
      "examples": [
        "Le forze dell'ordine sono intervenute rapidamente sul posto.",
        "Le forze armate del paese sono in stato di allerta."
      ],
      "nota": "In questo senso è quasi sempre usato al plurale: 'forze armate', 'forze dell'ordine', 'forze di pace'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Soggetto collettivo o movimento dotato di rilievo politico, sociale o economico.",
      "examples": [
        "Le forze politiche di opposizione hanno respinto la proposta.",
        "Le forze produttive del paese sono allo stremo."
      ],
      "nota": "Prevalentemente usato al plurale in contesti politici ed economici."
    },
    {
      "pos": "avverbio",
      "definition": "Forse, probabilmente; esprime incertezza o possibilità riguardo a qualcosa.",
      "examples": [
        "Forza che arriverà in ritardo, come al solito.",
        "Forza che non lo sapeva ancora."
      ],
      "nota": "Uso regionale (spec. settentrionale) con valore di 'forse'; meno diffuso nell'italiano standard."
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione usata per incoraggiare, incitare o spronare qualcuno a compiere uno sforzo o a non arrendersi.",
      "examples": [
        "Forza, manca poco alla fine!",
        "Forza ragazzi, dobbiamo farcela!"
      ],
      "nota": "Molto frequente nei contesti sportivi; può essere raddoppiata ('forza forza!') per maggiore enfasi."
    }
  ]
