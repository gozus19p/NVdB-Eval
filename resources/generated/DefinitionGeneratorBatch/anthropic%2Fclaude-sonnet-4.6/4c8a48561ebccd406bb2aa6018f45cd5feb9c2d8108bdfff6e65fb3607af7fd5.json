  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di qualità molto elevata, eccellente sotto ogni aspetto; al massimo grado della bontà o della validità.",
      "examples": [
        "Ha consegnato un lavoro ottimo, senza errori e nei tempi previsti.",
        "Il ristorante è noto per la sua ottima cucina tradizionale."
      ],
      "nota": "Superlativo assoluto di 'buono', con forma suppletiva (non *buonissimo nel registro formale). Può precedere o seguire il sostantivo, ma è più comune in posizione prenominale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il massimo grado di bontà, qualità o efficacia raggiungibile in una determinata situazione o campo.",
      "examples": [
        "Non accontentarti del buono quando puoi raggiungere l'ottimo.",
        "Il medico ha detto che le sue condizioni di salute sono al limite dell'ottimo."
      ],
      "nota": "Usato prevalentemente con l'articolo determinativo. Frequente nell'espressione 'il meglio è nemico dell'ottimo'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Valutazione scolastica o accademica corrispondente al massimo punteggio o al livello più alto in una scala di giudizi.",
      "examples": [
        "Ha preso ottimo in condotta per tutto l'anno scolastico.",
        "La commissione le ha assegnato un ottimo per la prova orale."
      ],
      "nota": "In contesto scolastico italiano, corrisponde tipicamente al voto 10 o alla menzione massima in pagelle e schede di valutazione."
    },
    {
      "pos": "esclamazione",
      "definition": "Espressione di approvazione, soddisfazione o accordo rispetto a quanto detto o proposto.",
      "examples": [
        "«Ci vediamo domani alle nove?» «Ottimo, perfetto per me.»",
        "Ottimo! Finalmente abbiamo trovato una soluzione."
      ],
      "nota": "Uso pragmatico in cui la parola funziona come interiezione valutativa, segnalando consenso entusiastico o compiacimento."
    }
  ]
