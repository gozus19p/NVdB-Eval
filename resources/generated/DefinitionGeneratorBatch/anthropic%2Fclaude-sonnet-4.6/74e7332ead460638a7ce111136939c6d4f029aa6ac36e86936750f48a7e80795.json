  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Gruppo di persone legate da vincoli di parentela, matrimonio o adozione, che condividono o hanno condiviso la stessa abitazione e relazioni affettive stabili.",
      "examples": [
        "La famiglia si è riunita a pranzo per festeggiare il compleanno della nonna.",
        "Ha una famiglia numerosa: tre figli, due cognati e quattro nipoti."
      ],
      "nota": "Nel senso più ristretto indica il nucleo composto da genitori e figli (famiglia nucleare); in senso più ampio comprende anche parenti più lontani (famiglia allargata)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme delle persone con cui si condividono legami affettivi profondi, indipendentemente da vincoli biologici o legali.",
      "examples": [
        "I miei amici più cari sono la mia vera famiglia.",
        "In quel gruppo di colleghi ho trovato una seconda famiglia."
      ],
      "nota": "Uso figurato che estende il concetto di famiglia oltre i legami di sangue, valorizzando l'appartenenza affettiva e la solidarietà."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Stirpe o casato, inteso come insieme di persone che discendono da un antenato comune e ne condividono il cognome o l'eredità.",
      "examples": [
        "La famiglia Medici dominò la scena politica fiorentina per secoli.",
        "È orgoglioso di appartenere a una famiglia di antica nobiltà."
      ],
      "nota": "In questo senso si riferisce spesso a dinastie, casati storici o lignaggi di rilievo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In biologia e tassonomia, categoria sistematica che raggruppa generi affini, collocata tra l'ordine e il genere.",
      "examples": [
        "Il cane e il lupo appartengono alla stessa famiglia, i Canidi.",
        "Le rose fanno parte della famiglia delle Rosacee."
      ],
      "nota": "Termine tecnico della classificazione biologica linneana; il nome delle famiglie in italiano termina tipicamente in -idi (animali) o -acee/-acee (piante)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di elementi accomunati da caratteristiche strutturali, funzionali o di origine simile, in ambiti come la linguistica, la matematica, la chimica o l'informatica.",
      "examples": [
        "L'italiano e lo spagnolo appartengono alla famiglia delle lingue romanze.",
        "Questo antibiotico appartiene alla famiglia dei macrolidi."
      ],
      "nota": "Uso estensivo e tecnico-scientifico; si parla ad esempio di famiglia di lingue, famiglia di funzioni matematiche, famiglia di composti chimici, famiglia di protocolli informatici."
    }
  ]
