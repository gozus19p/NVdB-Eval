  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che riguarda o interessa l'intero pianeta e tutti i popoli che lo abitano; di portata globale.",
      "examples": [
        "La crisi economica mondiale ha colpito tutti i paesi industrializzati.",
        "Il riscaldamento globale è una delle sfide mondiali più urgenti del nostro tempo."
      ],
      "nota": "Si distingue da 'internazionale', che indica relazioni tra più nazioni specifiche, mentre 'mondiale' implica un'estensione a tutto il globo."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a una competizione o manifestazione che coinvolge partecipanti da tutto il mondo, usato spesso in contesti sportivi.",
      "examples": [
        "Ha stabilito un record mondiale nei 100 metri piani.",
        "La federazione assegnerà il titolo mondiale al vincitore del torneo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Competizione sportiva a livello globale che riunisce rappresentanti di numerose nazioni, in particolare il Campionato del Mondo di calcio.",
      "examples": [
        "L'Italia ha vinto il mondiale di calcio nel 2006.",
        "Tutti i tifosi sono in attesa del prossimo mondiale di nuoto."
      ],
      "nota": "Usato spesso al plurale ('i mondiali') per riferirsi all'evento nella sua totalità o a edizioni specifiche. Con l'iniziale maiuscola e senza specificazione dello sport indica tipicamente il Campionato del Mondo di calcio."
    }
  ]
