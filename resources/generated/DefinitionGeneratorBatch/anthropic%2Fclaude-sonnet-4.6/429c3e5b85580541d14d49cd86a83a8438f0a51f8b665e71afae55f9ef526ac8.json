  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuno degli elementi ossei duri presenti nella cavità orale di vertebrati, usati per mordere, masticare e triturare il cibo.",
      "examples": [
        "Il bambino ha perso il primo dente da latte.",
        "Il dentista mi ha consigliato di usare il filo interdentale dopo ogni pasto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuna delle punte o sporgenze appuntite o a forma di cuneo presenti su strumenti, ingranaggi, utensili o superfici naturali.",
      "examples": [
        "I denti della sega erano consumati e tagliavano male.",
        "L'ingranaggio si è bloccato perché uno dei denti si è rotto."
      ],
      "nota": "Si usa per indicare le punte di pettini, forchette, ruote dentate, seghe, rastrelli e simili."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In geografia fisica, cima rocciosa aguzza e appuntita caratteristica di rilievi montuosi.",
      "examples": [
        "Il Dente del Gigante è una delle cime più famose del Monte Bianco.",
        "Dalla valle si ammirava il profilo frastagliato dei denti rocciosi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. (figurato)",
      "definition": "Simbolo di aggressività, ostilità o capacità offensiva, usato in espressioni idiomatiche.",
      "examples": [
        "Ce l'ha con me, ha un dente avvelenato contro di me da anni.",
        "Bisogna stringere i denti e andare avanti nonostante le difficoltà."
      ],
      "nota": "Ricorre in numerose locuzioni: 'avere il dente avvelenato' (nutrire rancore), 'stringere i denti' (sopportare con fermezza), 'mettere i denti' (diventare aggressivo o capace di difendersi)."
    },
    {
      "pos": "sostantivo m. (gastronomia)",
      "definition": "Nella locuzione 'al dente', indica il grado di cottura della pasta o di altri alimenti in cui rimane una leggera resistenza alla masticazione.",
      "examples": [
        "Gli italiani preferiscono la pasta cotta al dente.",
        "Scola gli spaghetti al dente e saltali subito in padella con il sugo."
      ],
      "nota": "La locuzione 'al dente' è utilizzata anche in altre lingue, come prestito dall'italiano."
    }
  ]
