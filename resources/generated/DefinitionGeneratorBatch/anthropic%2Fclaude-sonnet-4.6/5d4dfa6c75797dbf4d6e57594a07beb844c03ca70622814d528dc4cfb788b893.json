  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Parte laterale del corpo umano o animale compresa tra la coscia e la vita, corrispondente alla regione dell'anca e del bacino.",
      "examples": [
        "Dormire sul fianco sinistro aiuta la digestione.",
        "Il cavallo aveva una cicatrice sul fianco destro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lato o faccia laterale di un oggetto, di una struttura o di una formazione geografica.",
      "examples": [
        "L'eruzione vulcanica si è aperta sul fianco della montagna.",
        "I soldati attaccarono il fianco del castello nemico."
      ],
      "nota": "Comune in contesti militari per indicare il lato di uno schieramento, contrapposto al fronte e alla retroguardia."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Aspetto vulnerabile o punto debole di una persona, di un'argomentazione o di una situazione, suscettibile di critica o attacco.",
      "examples": [
        "La sua proposta offre il fianco a molte obiezioni.",
        "Bisogna fare attenzione a non dare il fianco agli avversari politici."
      ],
      "nota": "Uso figurato. Tipicamente ricorre nelle locuzioni 'offrire il fianco' e 'dare il fianco', con il significato di esporsi a critiche o attacchi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lato di un edificio o di un'imbarcazione, inteso come superficie esterna laterale.",
      "examples": [
        "Il fianco della nave era decorato con un fregio dorato.",
        "Sul fianco destro della cattedrale si apre un portale secondario."
      ],
      "nota": null
    }
  ]
