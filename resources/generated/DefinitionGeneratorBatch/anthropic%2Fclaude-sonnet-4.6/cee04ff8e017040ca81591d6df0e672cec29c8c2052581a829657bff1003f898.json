  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Diventare visibile, manifestarsi alla vista dopo essere stato assente o nascosto.",
      "examples": [
        "All'orizzonte comparve finalmente la vela della barca.",
        "Dopo giorni di pioggia, il sole è comparso tra le nuvole."
      ],
      "nota": "Contrario di 'sparire' o 'scomparire'. Si coniuga con l'ausiliare 'essere'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentarsi davanti a un'autorità giudiziaria o istituzionale in seguito a una convocazione formale.",
      "examples": [
        "L'imputato dovrà comparire davanti al giudice la prossima settimana.",
        "È stato citato a comparire in tribunale per testimoniare."
      ],
      "nota": "Uso prevalentemente giuridico e burocratico."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere presente o figurare in un testo, un elenco, uno schermo o un documento.",
      "examples": [
        "Il suo nome non compare nei registri dell'università.",
        "Un messaggio di errore è comparso sullo schermo del computer."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Mostrarsi in pubblico o in un contesto mediatico, cercando di farsi notare o di avere visibilità.",
      "examples": [
        "È il tipo di persona che vuole sempre comparire, anche quando non è necessario.",
        "Quella politica ama comparire in televisione ad ogni occasione."
      ],
      "nota": "In questo senso ha spesso una connotazione leggermente negativa, riferita a chi ricerca la visibilità per vanità o opportunismo."
    }
  ]
