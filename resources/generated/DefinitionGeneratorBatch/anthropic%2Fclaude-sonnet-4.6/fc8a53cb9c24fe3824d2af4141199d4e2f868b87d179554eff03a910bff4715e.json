  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Determinazione quantitativa di una grandezza fisica (lunghezza, peso, volume, ecc.) mediante confronto con un'unità di riferimento; il valore numerico che ne risulta.",
      "examples": [
        "Prendi le misure della stanza prima di comprare il tappeto.",
        "La misura della temperatura è espressa in gradi Celsius."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Dimensione corporea di una persona, usata per determinare la taglia di un indumento o di una calzatura.",
      "examples": [
        "Qual è la tua misura di giacca?",
        "Questo pantalone è fatto su misura per lui."
      ],
      "nota": "L'espressione 'su misura' indica un capo realizzato appositamente sulle dimensioni di una persona; per estensione si usa anche in senso figurato (es. 'un ruolo su misura')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strumento o unità convenzionale usata per effettuare una misurazione.",
      "examples": [
        "Il metro è la misura base del Sistema Internazionale per le lunghezze.",
        "In cucina si usano misure standard come il cucchiaio e la tazza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Provvedimento, disposizione o azione concreta adottata per raggiungere uno scopo o affrontare una situazione.",
      "examples": [
        "Il governo ha adottato misure urgenti per contenere l'inflazione.",
        "Sono necessarie misure di sicurezza più severe in quell'area."
      ],
      "nota": "Frequente al plurale in contesti politici, amministrativi e giuridici."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Moderazione, equilibrio nel comportamento o nel giudizio; capacità di non eccedere.",
      "examples": [
        "Bisogna parlare con misura se non si vuole offendere nessuno.",
        "Ha reagito con grande misura alla provocazione."
      ],
      "nota": "In questo senso è sinonimo di 'moderazione' e 'controllo'. Si usa spesso nelle locuzioni 'con misura' e 'senza misura'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In musica, unità di suddivisione del tempo musicale corrispondente a un gruppo fisso di battiti delimitato da stanghette sul pentagramma.",
      "examples": [
        "Il pezzo è scritto in misura ternaria.",
        "Il direttore d'orchestra indicava ogni misura con il gesto della mano."
      ],
      "nota": "Equivalente al termine 'battuta' in senso musicale; 'misura' è la denominazione più tecnica usata in teoria musicale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nella poesia e nella metrica, schema ritmico o sillabico di un verso; il numero di sillabe che lo compone.",
      "examples": [
        "L'endecasillabo è la misura più usata nella tradizione poetica italiana.",
        "Il poeta scelse una misura breve per dare al testo un ritmo incalzante."
      ],
      "nota": null
    }
  ]
