  "senses": [
    {
      "pos": "pronome indefinito",
      "definition": "Nessuna cosa, assenza totale di qualsiasi oggetto, fatto o entità.",
      "examples": [
        "Non ho mangiato niente da stamattina.",
        "C'è niente di nuovo sul lavoro?"
      ],
      "nota": "Usato prevalentemente in frasi negative (con 'non') o interrogative. In frasi affermative con valore negativo è comune nell'italiano parlato: 'Niente, non viene nessuno'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "L'assenza di essere, di realtà o di consistenza; il vuoto assoluto, ciò che non esiste.",
      "examples": [
        "Dal niente non può nascere qualcosa, dicono i filosofi.",
        "Tutta quella fatica si è ridotta al niente."
      ],
      "nota": "Usato spesso con l'articolo determinativo 'il'. Frequente nelle espressioni figurate 'dal niente' e 'ridursi al niente'."
    },
    {
      "pos": "avverbio",
      "definition": "Per nulla, in nessun modo; rafforzativo della negazione o dell'assenza.",
      "examples": [
        "Questo film non mi è piaciuto niente.",
        "Non sono niente stanca, posso continuare."
      ],
      "nota": "In questo uso equivale a 'affatto' o 'per niente'; si coloca tipicamente dopo il verbo o l'aggettivo che modifica."
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Privo di importanza, di valore o di consistenza; usato in senso predicativo per indicare qualcosa o qualcuno di trascurabile.",
      "examples": [
        "Una cosa da niente, non preoccuparti.",
        "È un problema da niente, si risolve in cinque minuti."
      ],
      "nota": "Ricorre quasi esclusivamente nella locuzione 'da niente', con funzione attributiva o predicativa."
    },
    {
      "pos": "interiezione",
      "definition": "Espressione usata per segnalare che non c'è nulla di importante da aggiungere, per troncare un discorso o per minimizzare qualcosa.",
      "examples": [
        "Niente, alla fine ho deciso di non andare.",
        "— Volevi dirmi qualcosa? — Niente, lascia perdere."
      ],
      "nota": "Tipico dell'italiano parlato; può aprire o chiudere un turno conversazionale con valore conclusivo o di rinuncia."
    }
  ]
