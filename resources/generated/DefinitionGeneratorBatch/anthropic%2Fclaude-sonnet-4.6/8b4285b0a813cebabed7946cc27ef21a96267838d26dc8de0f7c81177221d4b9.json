  "senses": [
    {
      "pos": "aggettivo numerale cardinale invariabile",
      "definition": "Indica una quantità pari a quattro più uno (5).",
      "examples": [
        "Ho comprato cinque mele al mercato.",
        "La riunione durerà cinque ore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Il numero intero che segue quattro e precede sei; la cifra o il simbolo che lo rappresenta.",
      "examples": [
        "Il cinque è il mio numero preferito.",
        "Ha scritto un cinque invece di un sei sul foglio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Voto scolastico insufficiente, corrispondente al valore numerico 5 in una scala da uno a dieci.",
      "examples": [
        "Ha preso cinque in matematica e deve riparare a settembre.",
        "Un cinque nel compito scritto non è un buon segnale."
      ],
      "nota": "In ambito scolastico italiano il cinque indica insufficienza, contrapposto al sei che rappresenta la sufficienza minima."
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Ora quinta del giorno o della notte, indicata nell'uso comune per riferirsi alle 5:00 o alle 17:00.",
      "examples": [
        "Il treno parte alle cinque di mattina.",
        "Ci vediamo alle cinque del pomeriggio davanti al bar."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invariabile",
      "definition": "Giorno cinque del mese.",
      "examples": [
        "L'appuntamento è fissato per il cinque di marzo.",
        "Ci siamo sposati il cinque maggio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. invariabile (uso gestuale/colloquiale)",
      "definition": "Gesto di saluto o congratulazione in cui due persone si battono il palmo della mano aperta l'uno contro l'altro.",
      "examples": [
        "Dai, dammi il cinque! Hai vinto!",
        "I due compagni di squadra si sono dati un cinque dopo il gol."
      ],
      "nota": "Espressione mutuata dall'inglese 'high five'; usata soprattutto in contesti informali e sportivi."
