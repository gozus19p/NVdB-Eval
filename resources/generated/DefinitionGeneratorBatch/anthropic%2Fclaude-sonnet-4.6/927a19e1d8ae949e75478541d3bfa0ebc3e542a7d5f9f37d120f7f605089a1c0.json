  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi in modo continuo e fluido da un punto all'altro, detto di liquidi o sostanze fluide.",
      "examples": [
        "L'acqua scorre veloce lungo il torrente dopo la pioggia.",
        "Il sangue scorreva dalla ferita sul braccio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trascorrere in modo continuo e percepito come rapido o uniforme, detto del tempo.",
      "examples": [
        "Le settimane scorrono veloci quando si è impegnati nel lavoro.",
        "Gli anni scorrono inesorabili e non ce ne accorgiamo."
      ],
      "nota": "Uso figurato derivato dal senso primario di flusso continuo."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi scivolando lungo una superficie o una guida, detto di oggetti o parti meccaniche.",
      "examples": [
        "Il cassetto scorre facilmente sui binari.",
        "La tenda scorre lungo l'asta senza ostacoli."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Leggere o esaminare qualcosa in modo rapido e superficiale, senza soffermarsi sui dettagli.",
      "examples": [
        "Ho scorso velocemente le ultime pagine del rapporto prima della riunione.",
        "Scorse l'elenco dei nomi alla ricerca del suo."
      ],
      "nota": "Si distingue da 'leggere' per la minore attenzione e la rapidità dell'azione."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Procedere o svilupparsi in modo fluido e senza intoppi, detto di testi, discorsi o narrazioni.",
      "examples": [
        "Il romanzo scorre bene: non riesci a smettere di leggerlo.",
        "Il dialogo scorre in modo naturale e non sembra forzato."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avanzare di posizione in una lista o graduatoria per effetto dello scorrimento automatico verso l'alto.",
      "examples": [
        "Dopo le rinunce, molti candidati sono scorsi in graduatoria.",
        "Se i vincitori rinunciano, la lista scorre e vengono chiamati i successivi."
      ],
      "nota": "Uso tipico del linguaggio burocratico-amministrativo riferito a concorsi, graduatorie e liste d'attesa."
    }
  ]
