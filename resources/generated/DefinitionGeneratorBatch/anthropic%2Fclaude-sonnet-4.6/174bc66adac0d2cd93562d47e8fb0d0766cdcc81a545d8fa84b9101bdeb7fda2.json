  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha il colore intermedio tra il giallo e il blu, tipico della vegetazione.",
      "examples": [
        "Il prato era di un verde intenso dopo le piogge primaverili.",
        "Preferisce le magliette verdi a quelle blu."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di frutto o vegetale non ancora maturo, raccolto prima del tempo.",
      "examples": [
        "Queste pesche sono ancora verdi, aspetta qualche giorno prima di mangiarle.",
        "Le olive verdi vengono raccolte prima che raggiungano la piena maturazione."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di esperienza, inesperto, alle prime armi.",
      "examples": [
        "È ancora un ragazzo verde, non aspettarti decisioni difficili da lui.",
        "Quando ero verde di questo mestiere, commettevo molti errori."
      ],
      "nota": "Uso figurato, spesso riferito a persone giovani o neofite in un ambito lavorativo o professionale."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo alla tutela dell'ambiente e all'ecologia; rispettoso dell'ecosistema.",
      "examples": [
        "La nuova amministrazione ha adottato una politica verde per ridurre le emissioni.",
        "Molte aziende si presentano come realtà verdi per attrarre consumatori sensibili all'ambiente."
      ],
      "nota": "Uso diffusosi a partire dagli anni Ottanta in parallelo con la nascita dei movimenti ecologisti e dei partiti Verdi."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona, pallido o con colorito del viso alterato per nausea, malessere o forte emozione.",
      "examples": [
        "Dopo il giro sulle montagne russe era verde dalla nausea.",
        "Lo guardò verde di rabbia, senza riuscire a proferire parola."
      ],
      "nota": "Si usa nelle locuzioni 'verde dalla nausea', 'verde di rabbia', 'verde di invidia'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il colore corrispondente alla lunghezza d'onda intermedia tra il giallo e il blu nello spettro visibile.",
      "examples": [
        "Il verde è il colore simbolo della speranza in molte culture.",
        "Ha tinteggiato le pareti del salotto con un verde salvia molto elegante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio naturale caratterizzato da vegetazione, area con alberi, erba e piante, specialmente in contesto urbano.",
      "examples": [
        "Il quartiere è ricco di verde pubblico e i residenti ne sono molto soddisfatti.",
        "I bambini hanno bisogno di spazi di verde dove giocare all'aperto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nella segnaletica stradale e nei semafori, il segnale luminoso che autorizza il passaggio o la circolazione.",
      "examples": [
        "Aspetta il verde prima di attraversare la strada.",
        "Il semaforo è passato al verde e le macchine sono ripartite."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di piante, erbe o fogliame usato come decorazione o ornamento.",
      "examples": [
        "Il fioraio ha aggiunto del verde per completare il bouquet.",
        "Ha decorato la tavola con del verde fresco e qualche fiore bianco."
      ],
      "nota": null
    }
  ]
