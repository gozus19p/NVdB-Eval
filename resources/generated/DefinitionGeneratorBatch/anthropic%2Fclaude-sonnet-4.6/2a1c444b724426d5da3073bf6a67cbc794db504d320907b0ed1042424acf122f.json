  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione fisica spiacevole e fastidiosa avvertita in una parte del corpo, causata da una lesione, una malattia o uno stimolo nocivo.",
      "examples": [
        "Dopo la caduta, sentiva un forte dolore alla caviglia.",
        "Il medico le prescrisse un antidolorifico per alleviare il dolore alla schiena."
      ],
      "nota": "In ambito medico si distingue tra dolore acuto (improvviso e di breve durata) e dolore cronico (persistente nel tempo)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato emotivo di sofferenza interiore profonda causato da un lutto, una perdita, una delusione o un'esperienza traumatica.",
      "examples": [
        "La morte del padre le ha lasciato un dolore che non riesce a superare.",
        "Cercava nelle parole degli amici un conforto al suo dolore."
      ],
      "nota": "In questo senso figurato si contrappone a gioia o felicità; può essere usato anche in contesti stilisticamente elevati o letterari."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Dispiacere o rammarico provato per qualcosa che si ritiene sbagliato, spiacevole o lamentevole, spesso riferito a situazioni che riguardano altri.",
      "examples": [
        "Mi fa dolore vedere come trattano quegli animali.",
        "È un dolore sapere che tanti giovani lasciano il paese."
      ],
      "nota": "In questo uso, spesso nella costruzione 'fare dolore' o 'essere un dolore', il termine esprime una reazione emotiva meno intensa rispetto al senso precedente, vicina al dispiacere."
    }
  ]
