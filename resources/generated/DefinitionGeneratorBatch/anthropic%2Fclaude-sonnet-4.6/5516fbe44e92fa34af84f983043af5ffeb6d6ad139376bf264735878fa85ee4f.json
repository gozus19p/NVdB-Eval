  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Movimento circolare o curvilineare compiuto attorno a un punto, un asse o lungo un percorso chiuso.",
      "examples": [
        "La Terra compie un giro completo attorno al Sole in un anno.",
        "Il ciclista ha percorso tre giri del circuito prima di fermarsi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Breve spostamento, passeggiata o escursione senza una meta precisa, fatta per svago o per visitare un luogo.",
      "examples": [
        "Andiamo a fare un giro in centro dopo cena?",
        "Ha fatto un giro per la città prima di tornare in albergo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di persone che frequentano abitualmente lo stesso ambiente, gruppo sociale informale.",
      "examples": [
        "È entrata nel giro dei designer più affermati della città.",
        "Conosco tutto il suo giro: si ritrovano ogni venerdì al bar sotto casa."
      ],
      "nota": "Spesso usato nell'espressione 'il giro di' seguito da un nome per indicare la cerchia di persone legate a qualcuno o a un ambiente specifico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Traffico o commercio illecito di merci o sostanze proibite.",
      "examples": [
        "La polizia ha smantellato un giro di droga che operava nel quartiere.",
        "Erano coinvolti in un giro di merce contraffatta."
      ],
      "nota": "Uso con connotazione negativa, tipicamente in contesti legati alla criminalità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Flusso o circolazione di denaro, affari o risorse all'interno di un sistema economico.",
      "examples": [
        "Il giro d'affari dell'azienda ha superato i dieci milioni di euro.",
        "Con quella manifestazione è entrato in città un giro di denaro notevole."
      ],
      "nota": "Frequente nell'espressione 'giro d'affari', equivalente a fatturato o volume di business."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Turno o ciclo nell'ambito di un gioco, di una competizione o di un'attività con fasi ripetute.",
      "examples": [
        "È il tuo giro: lancia i dadi.",
        "Al terzo giro di carte finalmente ha vinto una mano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di tempo approssimativo, arco temporale indicativo.",
      "examples": [
        "Nel giro di pochi giorni la situazione è completamente cambiata.",
        "Risolveremo il problema nel giro di un'ora."
      ],
      "nota": "Usato prevalentemente nell'espressione 'nel giro di' per indicare un lasso di tempo entro cui si svolge o si prevede che si svolga qualcosa."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In ciclismo, competizione a tappe su distanze e percorsi prestabiliti; per antonomasia, il Giro d'Italia.",
      "examples": [
        "Quest'anno il Giro partirà da Torino.",
        "Ha vinto il Giro per tre anni consecutivi."
      ],
      "nota": "Con l'iniziale maiuscola e senza ulteriori specificazioni, si riferisce comunemente al Giro d'Italia, la principale corsa ciclistica italiana."
    }
