      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Punto di partenza o di riferimento di una scala di misurazione, in particolare quella termica.",
      "examples": [
        "Lo zero della scala Celsius corrisponde al punto di congelamento dell'acqua.",
        "La temperatura è scesa sotto lo zero durante la notte."
      ],
      "nota": "Usato soprattutto in contesti meteorologici e scientifici; spesso nella locuzione 'sotto zero'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In senso figurato, persona o cosa priva di valore, capacità o rilevanza.",
      "examples": [
        "In cucina sono uno zero assoluto.",
        "Come manager si è rivelato uno zero totale."
      ],
      "nota": "Uso connotativo fortemente negativo; spesso rafforzato da aggettivi come 'assoluto' o 'totale'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Punto iniziale di un processo o di una situazione, il nulla da cui si parte.",
      "examples": [
        "Dopo il fallimento ha dovuto ricominciare da zero.",
        "Il progetto è stato azzerato e si riparte da zero."
      ],
      "nota": "Ricorre frequentemente nella locuzione 'da zero' con il significato di 'dall'inizio', 'senza niente di pregresso'."
    },
    {
      "pos": "aggettivo invariabile",
      "definition": "Che equivale a nessuno, nullo; indica l'assenza totale di qualcosa.",
      "examples": [
        "Ho zero voglia di uscire stasera.",
        "Le sue probabilità di vincere sono zero."
      ],
      "nota": "Uso informale e colloquiale, tipico dell'italiano parlato contemporaneo; si usa in posizione prenominale o predicativa, invariato nel genere e nel numero."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel calcio e in altri sport, punteggio nullo di una squadra o giocatore in una partita.",
      "examples": [
        "La partita è finita tre a zero per i padroni di casa.",
        "Il portiere ha mantenuto lo zero per tutta la gara."
      ],
      "nota": "Nel linguaggio sportivo 'tenere lo zero' significa non subire reti o punti."
    }
