  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Spostare qualcosa o qualcuno da una posizione a un'altra, imprimendo un cambiamento di luogo o di assetto fisico.",
      "examples": [
        "Ha mosso la sedia vicino alla finestra per leggere meglio.",
        "Il vento muoveva le foglie degli alberi nel cortile."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo / riflessivo",
      "definition": "Spostarsi da un luogo a un altro, cambiare posizione nello spazio.",
      "examples": [
        "Smettila di muoverti così tanto, devi stare fermo per la foto.",
        "La folla si mosse lentamente verso l'uscita dello stadio."
      ],
      "nota": "La forma riflessiva 'muoversi' è più comune nell'accezione intransitiva di spostamento spontaneo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Azionare un meccanismo o un congegno, mettendolo in funzione.",
      "examples": [
        "Muove il motore premendo quel pulsante rosso.",
        "Quale ingranaggio muove l'intero sistema?"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Suscitare un sentimento o uno stato d'animo in qualcuno, toccare emotivamente.",
      "examples": [
        "Quel discorso ha mosso il pubblico fino alle lacrime.",
        "La storia del bambino ci ha profondamente mossi."
      ],
      "nota": "Frequente nella costruzione 'muovere a + sostantivo astratto' (es. 'muovere a pietà', 'muovere a compassione')."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Spingere qualcuno ad agire, indurre a fare qualcosa.",
      "examples": [
        "Cosa ti ha mosso a prendere una decisione così drastica?",
        "È stata la curiosità a muoverla verso quella carriera."
      ],
      "nota": "Equivale a 'spingere', 'indurre', con sfumatura di causa interiore o motivazione profonda."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Formulare o avanzare formalmente un'obiezione, una critica o un'accusa.",
      "examples": [
        "Gli hanno mosso una serie di critiche pesanti durante la riunione.",
        "La commissione ha mosso diverse obiezioni alla proposta di legge."
      ],
      "nota": "Tipico dei registri formali e burocratici; si costruisce con complemento oggetto di tipo argomentativo (critica, obiezione, accusa, rimprovero)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nel gioco degli scacchi e in altri giochi da tavolo, spostare un pezzo secondo le regole del gioco.",
      "examples": [
        "Ha mosso il cavallo in una posizione inaspettata.",
        "Tocca a te muovere, pensa bene prima di decidere."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere origine o derivare da qualcosa, prendere le mosse da un punto di partenza.",
      "examples": [
        "La sua analisi muove da premesse teoriche molto solide.",
        "Il romanzo muove da un episodio autobiografico dell'autore."
      ],
      "nota": "Uso prevalentemente scritto e di registro medio-alto; equivale a 'partire da', 'avere come punto di partenza'."
    }
  ]
}