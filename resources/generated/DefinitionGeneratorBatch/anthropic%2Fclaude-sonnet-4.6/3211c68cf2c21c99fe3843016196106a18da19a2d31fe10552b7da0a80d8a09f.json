  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Porzione separata o separabile di un insieme più grande; frammento o parte di qualcosa di fisico.",
      "examples": [
        "Ho rotto il vaso e ho raccolto tutti i pezzi dal pavimento.",
        "Vuoi un pezzo di torta o preferisci aspettare?"
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Singolo elemento di un insieme composto da parti distinte, come componenti di un meccanismo, mobili da montare o pezzi di un gioco.",
      "examples": [
        "Manca un pezzo al puzzle e non riesco a completarlo.",
        "Il meccanico ha sostituito alcuni pezzi del motore."
      ],
      "nota": "Frequente nelle espressioni 'pezzo di ricambio' e 'pezzo di artiglieria'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Composizione musicale, letteraria o artistica considerata come unità autonoma.",
      "examples": [
        "Il pianista ha eseguito un pezzo di Chopin in modo impeccabile.",
        "Ha scritto un bel pezzo su quella vicenda per il giornale."
      ],
      "nota": "In ambito giornalistico, 'pezzo' designa specificatamente un articolo o un servizio."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona di un certo rilievo, importanza o autorevolezza in un determinato ambito.",
      "examples": [
        "È un pezzo grosso della finanza internazionale.",
        "Quel dirigente è un pezzo importante dell'azienda."
      ],
      "nota": "Usato quasi esclusivamente nelle locuzioni 'pezzo grosso' o 'pezzo da novanta', con connotazione di potere o prestigio."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di tempo o tratto di spazio di una certa estensione, usato in modo indefinito.",
      "examples": [
        "Non lo vedo da un bel pezzo.",
        "Abbiamo ancora un bel pezzo di strada da fare prima di arrivare."
      ],
      "nota": "Ricorre prevalentemente nelle locuzioni 'da un pezzo', 'un bel pezzo' con valore temporale o spaziale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona o cosa considerata in modo spregiativo o con forza espressiva, spesso in esclamazioni o insulti.",
      "examples": [
        "Che pezzo d'idiota, ha combinato un disastro!",
        "Sei proprio un pezzo d'incapace!"
      ],
      "nota": "Uso colloquiale o volgare, quasi sempre in locuzioni del tipo 'pezzo di + sostantivo insultante'."
    }
  ]
