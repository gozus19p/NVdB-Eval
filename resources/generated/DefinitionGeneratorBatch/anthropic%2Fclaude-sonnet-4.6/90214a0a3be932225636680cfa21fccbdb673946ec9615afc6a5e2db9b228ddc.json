  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Qualità del suono determinata dalla sua frequenza, che permette di distinguere suoni acuti da suoni gravi.",
      "examples": [
        "Il violino produce toni più acuti rispetto al contrabbasso.",
        "Quel campanello ha un tono argentino e piacevole."
      ],
      "nota": "In musica si distingue dal 'semitono', che è la metà dell'intervallo di un tono intero."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Altezza, intensità o inflessione della voce umana che trasmette uno stato d'animo, un atteggiamento o un'intenzione comunicativa.",
      "examples": [
        "Mi ha risposto con un tono seccato che non mi aspettavo.",
        "Abbassa il tono, per favore: non c'è bisogno di urlare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Registro stilistico o carattere espressivo generale di un testo scritto, di un discorso o di un'opera artistica.",
      "examples": [
        "Il romanzo ha un tono malinconico che pervade ogni pagina.",
        "L'articolo adotta un tono ironico per commentare la vicenda politica."
      ],
      "nota": "Distinguibile dal senso precedente perché si riferisce a testi o opere, non alla voce parlata."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Livello di eleganza, distinzione o decoro di una persona, di un ambiente o di un evento.",
      "examples": [
        "Quel ristorante ha molto tono: è frequentato dall'alta borghesia.",
        "Il suo modo di vestire dà tono all'intero locale."
      ],
      "nota": "Spesso usato nelle locuzioni 'dare tono' o 'avere tono'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In fisiologia, stato di tensione muscolare di base che il muscolo mantiene anche a riposo, necessario per il corretto funzionamento del corpo.",
      "examples": [
        "L'allenamento costante migliora il tono muscolare.",
        "Una prolungata inattività riduce il tono dei muscoli."
      ],
      "nota": "Comune anche nella forma composta 'tono muscolare'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In pittura e fotografia, gradazione di colore o di luce che determina la luminosità e il contrasto di un'immagine.",
      "examples": [
        "Il fotografo ha lavorato sui toni caldi per dare all'immagine un'atmosfera accogliente.",
        "Quel quadro gioca su toni di grigio e blu molto raffinati."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Intervallo musicale corrispondente a due semitoni, unità base della scala diatonica.",
      "examples": [
        "Tra il do e il re c'è un intervallo di un tono.",
        "L'insegnante ha spiegato la differenza tra toni e semitoni nella scala musicale."
      ],
      "nota": "Accezione tecnico-musicale, ma ampiamente diffusa anche tra non specialisti."
    }
  ]
