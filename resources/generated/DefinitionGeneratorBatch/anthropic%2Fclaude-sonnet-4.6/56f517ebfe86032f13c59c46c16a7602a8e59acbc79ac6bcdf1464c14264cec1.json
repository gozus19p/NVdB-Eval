  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Separare fisicamente qualcosa da una superficie o da un insieme a cui era unito o attaccato.",
      "examples": [
        "Ha staccato il manifesto dal muro con cura per non rovinarlo.",
        "Devi staccare il biglietto del treno prima di salire sul bus."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere il collegamento elettrico o il funzionamento di un apparecchio o impianto.",
      "examples": [
        "Prima di uscire di casa, ricordati di staccare il ferro da stiro.",
        "Il tecnico ha staccato la corrente per effettuare i lavori."
      ],
      "nota": "Spesso usato con oggetti come 'la spina', 'la corrente', 'il gas'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Allontanare qualcuno o qualcosa da un luogo, una persona o una situazione, interrompendo un legame fisico o affettivo.",
      "examples": [
        "Non riusciva a staccare gli occhi dallo schermo.",
        "I genitori faticavano a staccare il bambino dal parco giochi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nel contesto lavorativo o scolastico, terminare il proprio turno o orario di lavoro.",
      "examples": [
        "Stacco alle sei, poi ci vediamo per cena.",
        "Oggi ha staccato tardi a causa delle riunioni."
      ],
      "nota": "Uso colloquiale, spesso impiegato in forma assoluta senza complemento oggetto."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nello sport e in senso figurato, distanziare nettamente gli avversari o i concorrenti.",
      "examples": [
        "Il corridore ha staccato il gruppo nel tratto in salita.",
        "Con quella performance ha staccato tutti i rivali in classifica."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo/riflessivo",
      "definition": "Separarsi da una superficie, da un insieme o da una situazione, perdendo l'aderenza o il contatto.",
      "examples": [
        "L'intonaco si è staccato dal muro per via dell'umidità.",
        "Il bottone si è staccato dalla giacca durante il viaggio."
      ],
      "nota": "In forma riflessiva (staccarsi) indica il processo spontaneo di separazione."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Allontanarsi mentalmente o emotivamente da qualcosa o qualcuno, prendendo distanza psicologica.",
      "examples": [
        "Ha bisogno di staccarsi dal lavoro durante le vacanze.",
        "Col tempo è riuscita a staccarsi da quella relazione tossica."
      ],
      "nota": "Uso figurato del riflessivo; implica un distacco volontario e progressivo."
    }
  ]
