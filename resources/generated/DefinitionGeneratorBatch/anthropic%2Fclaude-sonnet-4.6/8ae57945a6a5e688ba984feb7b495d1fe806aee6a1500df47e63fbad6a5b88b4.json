  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Sostituire qualcosa o qualcuno con un'altra cosa o un'altra persona dello stesso tipo o di tipo diverso.",
      "examples": [
        "Ho cambiato le lenzuola stamattina.",
        "Devo cambiare il medico di base, quello attuale non mi convince."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Modificare le caratteristiche, l'aspetto o la natura di qualcosa o qualcuno rendendolo diverso da com'era.",
      "examples": [
        "Gli anni l'hanno cambiata profondamente.",
        "Quella esperienza ha cambiato il suo modo di vedere il mondo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Convertire una somma di denaro in valuta diversa o in tagli diversi.",
      "examples": [
        "Prima di partire per il Giappone ho cambiato cento euro in yen.",
        "Hai da cambiare una banconota da venti euro? Ho solo monete."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Passare da un mezzo di trasporto a un altro nel corso di un viaggio.",
      "examples": [
        "A Milano devi cambiare treno per proseguire verso Venezia.",
        "Ho cambiato due autobus prima di arrivare a destinazione."
      ],
      "nota": "Usato spesso in contesti di viaggio con mezzi pubblici; può reggere sia l'oggetto diretto (cambiare il treno) sia costruzioni assolute (devi cambiare a Bologna)."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Diventare diverso, subire una trasformazione rispetto a uno stato precedente.",
      "examples": [
        "Il tempo è cambiato all'improvviso: adesso piove.",
        "Le abitudini delle persone sono cambiate molto con l'arrivo degli smartphone."
      ],
      "nota": "In questa accezione intransitiva si costruisce con l'ausiliare 'essere'."
    },
    {
      "pos": "verbo riflessivo (cambiarsi)",
      "definition": "Togliersi gli abiti che si indossano e indossarne altri.",
      "examples": [
        "Torno a casa, mi cambio e poi esco di nuovo.",
        "Si è cambiata in fretta prima della cena."
      ],
      "nota": null
    }
  ]
