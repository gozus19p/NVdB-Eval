  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Parte posteriore del corpo umano comprendente le natiche e l'ano; fondoschiena.",
      "examples": [
        "Si è fatto male al culo cadendo dalla bici.",
        "Stai seduto tutto il giorno sul culo davanti al computer."
      ],
      "nota": "Termine volgare ma ampiamente diffuso nell'uso colloquiale; in contesti formali si preferiscono sinonimi come 'sedere', 'natiche' o 'fondoschiena'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Fortuna eccezionale e immeritata; colpo di fortuna.",
      "examples": [
        "Ha trovato lavoro subito, che culo!",
        "Vincere alla lotteria due volte è solo culo, non merito."
      ],
      "nota": "Uso figurato gergale molto frequente nell'italiano colloquiale. Espressioni tipiche: 'che culo!', 'avere un culo sfacciato'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte inferiore o terminale di un contenitore o oggetto allungato.",
      "examples": [
        "Il culo della bottiglia era scheggiato.",
        "Guarda nel culo del barattolo, c'è ancora un po' di marmellata."
      ],
      "nota": "Uso esteso in contesti informali e pratici; corrisponde a 'fondo' riferito a bottiglie, lattine e simili."
    }
  ]
