  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Spostarsi verso il luogo in cui si trova chi parla o verso un luogo considerato come punto di riferimento.",
      "examples": [
        "Vieni qui, ti devo dire una cosa.",
        "Mia sorella viene a trovarmi ogni domenica."
      ],
      "nota": "Si contrappone ad 'andare', che indica movimento in allontanamento dal parlante. L'ausiliare è 'essere'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Provenire, avere origine da un luogo, da una famiglia o da una situazione.",
      "examples": [
        "Viene da una piccola città del Sud.",
        "Quella ricetta viene dalla tradizione contadina."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Giungere, arrivare in un determinato momento o fase temporale.",
      "examples": [
        "Verrà il giorno in cui capirai.",
        "Prima viene il lavoro, poi il divertimento."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Risultare, riuscire in un certo modo come esito di un processo o di un'azione.",
      "examples": [
        "La torta è venuta benissimo quest'anno.",
        "Il disegno non mi è venuto come volevo."
      ],
      "nota": "Usato frequentemente per indicare il risultato di un'attività artigianale, culinaria o creativa."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere preso da un impulso, uno stato d'animo o una sensazione fisica, con soggetto grammaticale rappresentato dal sentimento stesso.",
      "examples": [
        "Mi viene da ridere ogni volta che ci penso.",
        "Gli è venuta una gran voglia di partire."
      ],
      "nota": "In questa costruzione il verbo è tipicamente usato con un complemento di termine (mi, ti, gli, ecc.) e regge un infinito introdotto da 'da' oppure un sostantivo."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Ammontare, dare come risultato numerico in un calcolo.",
      "examples": [
        "Quanto viene in tutto con le spese di spedizione?",
        "Tre per quattro viene dodici."
      ],
      "nota": null
    },
    {
      "pos": "verbo ausiliare",
      "definition": "Forma le costruzioni passive al posto di 'essere', sottolineando il processo piuttosto che lo stato.",
      "examples": [
        "Il documento viene firmato dal direttore ogni mattina.",
        "Le regole vengono aggiornate periodicamente."
      ],
      "nota": "In italiano, 'venire' come ausiliare passivo è usato prevalentemente con tempi semplici (presente, imperfetto, futuro) e non con i tempi composti, dove si preferisce 'essere'."
    },
    {
      "pos": "verbo intransitivo (figurato)",
      "definition": "Derivare logicamente, conseguire come deduzione o conclusione.",
      "examples": [
        "Da queste premesse viene che la teoria è insostenibile.",
        "Ne viene che dobbiamo rivedere tutto il piano."
      ],
      "nota": "Uso tipico nel ragionamento argomentativo e nel linguaggio saggistico."
    }
  ]
