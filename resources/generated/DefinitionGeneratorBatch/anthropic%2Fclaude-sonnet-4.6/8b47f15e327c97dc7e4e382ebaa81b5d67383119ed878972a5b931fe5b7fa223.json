  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Unirsi a qualcuno in matrimonio attraverso una cerimonia civile o religiosa; prendere come coniuge.",
      "examples": [
        "Ha sposato la sua fidanzata dopo cinque anni di relazione.",
        "Mia sorella sposerà un medico la prossima estate."
      ],
      "nota": "Può essere usato anche nella forma riflessiva reciproca 'sposarsi': 'Si sono sposati in municipio'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Officiare o celebrare una cerimonia nuziale, detto del sacerdote o del funzionario civile che unisce gli sposi.",
      "examples": [
        "Don Marco ha sposato i due giovani nella chiesa del paese.",
        "Il sindaco ha sposato personalmente la coppia in una cerimonia sobria."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Fare propria una causa, un'idea o una posizione, aderendovi con convinzione e impegno.",
      "examples": [
        "Il partito ha sposato la causa ambientalista come punto centrale del suo programma.",
        "Ha sposato quella filosofia di vita fin dalla giovinezza e non l'ha mai abbandonata."
      ],
      "nota": "Uso figurato. Indica un'adesione profonda e durevole, non una semplice simpatia superficiale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Combinare o far combaciare armoniosamente due elementi diversi, rendendoli coerenti tra loro.",
      "examples": [
        "Questo vino sposa perfettamente i sapori del pesce alla griglia.",
        "Il regista ha saputo sposare tradizione e modernità in un film originale."
      ],
      "nota": "Uso figurato, frequente nel linguaggio gastronomico e critico-artistico."
    }
  ]
