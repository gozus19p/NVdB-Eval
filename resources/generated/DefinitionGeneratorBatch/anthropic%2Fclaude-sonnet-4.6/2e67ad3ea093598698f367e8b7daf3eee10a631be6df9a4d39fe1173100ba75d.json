  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta caratteristiche, qualità o natura non uguali rispetto a qualcuno o qualcosa preso come termine di confronto.",
      "examples": [
        "Il tuo approccio al problema è completamente diverso dal mio.",
        "Oggi mi sento una persona diversa rispetto a ieri."
      ],
      "nota": "Regge spesso la preposizione 'da' per introdurre il termine di confronto."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si discosta dalla norma, dalla consuetudine o dalle aspettative comuni; fuori dall'ordinario.",
      "examples": [
        "Questo ristorante offre un'esperienza gastronomica davvero diversa.",
        "Ha uno stile di vita diverso che molti faticano a capire."
      ],
      "nota": "In questo uso può avere connotazione positiva (originale, insolito) o neutra."
    },
    {
      "pos": "aggettivo",
      "definition": "Usato per indicare una persona che non rientra nella norma sessuale o sociale dominante, in particolare con riferimento all'orientamento sessuale non eteronormativo.",
      "examples": [
        "Per anni aveva tenuto nascosto di essere diverso.",
        "In quegli anni, essere diverso significava vivere nell'ombra."
      ],
      "nota": "Uso eufemistico, diffuso soprattutto in contesti degli anni '70-'90; oggi meno comune, spesso avvertito come desueto o potenzialmente stigmatizzante."
    },
    {
      "pos": "aggettivo plurale",
      "definition": "Usato al plurale con valore di determinante indefinito, indica una quantità non precisata ma apprezzabile di persone o cose; equivale a 'parecchi', 'vari', 'più di uno'.",
      "examples": [
        "Ho ricevuto diverse telefonate stamattina.",
        "Diversi colleghi hanno manifestato il loro disaccordo."
      ],
      "nota": "In questa accezione il termine funziona come aggettivo indefinito e si usa quasi esclusivamente al plurale. Non implica confronto."
    }
  ]
