  "senses": [
    {
      "pos": "avverbio (negativo, rafforzativo)",
      "definition": "Rafforzativo della negazione, usato per escludere con enfasi qualcosa che potrebbe essere supposto o dato per scontato dall'interlocutore; equivale a 'affatto', 'per niente', 'proprio no'.",
      "examples": [
        "Non sono mica stanco, posso continuare a lavorare.",
        "Non l'ho mica dimenticato, ci stavo pensando proprio adesso.",
        "Mica facile trovare lavoro in questo periodo."
      ],
      "nota": "Frequente nell'italiano parlato e colloquiale. Può precedere il verbo senza 'non' in frasi ellittiche o esclamative ('Mica male!', 'Mica vero!'). In questo uso ha valore avverbiale negativo autonomo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Minerale silicato dalla struttura lamellare e dall'aspetto lucente e traslucido, facilmente sfaldabile in lamine sottili e flessibili; usato in elettrotecnica come isolante e nella cosmesi come pigmento iridescente.",
      "examples": [
        "Le rocce granitiche contengono spesso cristalli di mica.",
        "La polvere di mica viene aggiunta ai cosmetici per conferire effetti shimmer e brillantezza."
      ],
      "nota": "Termine tecnico-scientifico diffuso anche al di fuori dei contesti specialistici grazie all'uso nella cosmesi."
    }
  ]
