  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Condizione fisica in cui le forze che agiscono su un corpo si compensano reciprocamente, permettendo a quest'ultimo di mantenersi stabile in una determinata posizione senza cadere.",
      "examples": [
        "Il ginnasta ha mantenuto l'equilibrio sulla trave per tutta la durata dell'esercizio.",
        "Dopo l'infortunio alla caviglia, faticava a ritrovare l'equilibrio camminando."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato di stabilità e armonia tra elementi o forze contrastanti, tale da impedire che uno prevalga sugli altri.",
      "examples": [
        "Il trattato fu firmato per garantire l'equilibrio delle potenze europee.",
        "Bisogna trovare un equilibrio tra le esigenze del lavoro e quelle della vita privata."
      ],
      "nota": "Uso frequente in contesti politici, sociali ed economici per indicare la distribuzione bilanciata di poteri o risorse."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato di stabilità psicologica e emotiva di una persona, caratterizzato da autocontrollo e assenza di turbamenti eccessivi.",
      "examples": [
        "Nonostante le difficoltà, ha affrontato la situazione con grande equilibrio.",
        "La terapia l'ha aiutata a ritrovare un equilibrio interiore che aveva perso da tempo."
      ],
      "nota": "In questo senso si avvicina a termini come 'compostezza' e 'serenità', ma implica anche una componente di razionalità e controllo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In economia, condizione teorica in cui domanda e offerta si eguagliano, determinando un prezzo stabile sul mercato.",
      "examples": [
        "Il mercato tende spontaneamente verso un punto di equilibrio tra domanda e offerta.",
        "L'intervento statale ha alterato l'equilibrio del mercato immobiliare."
      ],
      "nota": "Termine tecnico dell'economia classica e neoclassica, ampiamente diffuso anche nel linguaggio giornalistico e divulgativo."
    }
  ]
