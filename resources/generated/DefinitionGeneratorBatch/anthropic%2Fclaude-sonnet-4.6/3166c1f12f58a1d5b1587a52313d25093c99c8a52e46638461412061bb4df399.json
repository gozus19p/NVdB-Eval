  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Segno grafico tracciato con uno strumento su una superficie; linea prodotta da un gesto di scrittura o disegno.",
      "examples": [
        "Con pochi tratti di matita riuscì a ritrarre il volto della donna.",
        "Il calligrafo eseguì ogni tratto con precisione millimetrica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Porzione continua di spazio, strada, fiume o percorso compresa tra due punti.",
      "examples": [
        "Il tratto autostradale tra Bologna e Firenze è spesso congestionato.",
        "Percorsero a piedi un lungo tratto di sentiero di montagna."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Porzione di tempo; periodo o momento determinato.",
      "examples": [
        "Per un lungo tratto della sua vita aveva vissuto all'estero.",
        "A un certo tratto della conversazione tutti ammutolirono."
      ],
      "nota": "Comune nella locuzione 'a un tratto' (= improvvisamente) e 'di tratto in tratto' (= di tanto in tanto)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Caratteristica fisica del volto o dell'aspetto esteriore di una persona.",
      "examples": [
        "Aveva i tratti delicati di sua madre.",
        "I tratti somatici del bambino tradivano chiaramente le sue origini nordeuropee."
      ],
      "nota": "Usato prevalentemente al plurale in questo senso."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Caratteristica del comportamento, della personalità o dello stile di qualcuno o qualcosa; aspetto peculiare.",
      "examples": [
        "Il suo carattere presenta tratti di grande generosità.",
        "Quella commedia ha tratti tipici del teatro dell'assurdo."
      ],
      "nota": "Usato spesso al plurale; in linguistica indica proprietà fonologiche o grammaticali (tratti distintivi)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Gesto o azione compiuta con un movimento rapido e deciso, specie nel contesto di operazioni fisiche.",
      "examples": [
        "Con un solo tratto di spugna cancellò tutto ciò che era scritto sulla lavagna.",
        "Aprì la busta con un tratto netto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Ricavato, derivato o estratto da qualcosa; che ha la propria origine in una fonte determinata.",
      "examples": [
        "Il film è tratto da un celebre romanzo dell'Ottocento.",
        "Lo spettacolo teatrale è tratto da una storia vera."
      ],
      "nota": "Participio passato del verbo 'trarre', usato frequentemente come aggettivo predicativo in contesti editoriali e cinematografici."
    },
    {
      "pos": "aggettivo",
      "definition": "Tirato fuori, estratto fisicamente da un luogo o da un contenitore.",
      "examples": [
        "Il coniglio tratto dal cappello del mago suscitò l'applauso del pubblico.",
        "Il documento tratto dall'archivio era ingiallito dal tempo."
      ],
      "nota": "Participio passato del verbo 'trarre' con valore aggettivale, in costruzione passiva."
    }
  ]
