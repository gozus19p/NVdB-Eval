  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione di disagio, irritazione o insofferenza provocata da qualcosa o qualcuno che disturba o infastidisce.",
      "examples": [
        "Il rumore continuo dei vicini mi dà un fastidio enorme.",
        "Provo fastidio ogni volta che qualcuno mi interrompe mentre parlo."
      ],
      "nota": "È il senso centrale e più frequente. Si costruisce spesso con i verbi 'dare', 'provare', 'sentire' e con la preposizione 'a' (dare fastidio a qualcuno)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Senso di nausea o di repulsione fisica, specialmente verso un odore, un sapore o una sostanza.",
      "examples": [
        "Quel profumo intenso mi dà fastidio allo stomaco.",
        "Sentì un fastidio alla gola appena assaggiò il medicinale."
      ],
      "nota": "Uso con sfumatura fisica, distinto dal disagio psicologico o emotivo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Problema, seccatura o contrattempo che causa preoccupazione o difficoltà pratiche.",
      "examples": [
        "Ho avuto un sacco di fastidi con la burocrazia per ottenere quel documento.",
        "Non voglio creare fastidi a nessuno con le mie richieste."
      ],
      "nota": "Usato spesso al plurale ('fastidi') per indicare una serie di problemi o seccature concrete. Sinonimo parziale di 'grattacapo' e 'seccatura'."
    }
  ]
