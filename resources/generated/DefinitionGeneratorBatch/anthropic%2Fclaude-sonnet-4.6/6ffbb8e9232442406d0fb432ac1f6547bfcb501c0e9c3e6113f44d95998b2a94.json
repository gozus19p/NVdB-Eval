  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non può essere omesso o evitato per raggiungere un determinato scopo o per soddisfare un bisogno; indispensabile.",
      "examples": [
        "Per partecipare al concorso è necessario presentare tutti i documenti richiesti.",
        "Il riposo è necessario per recuperare le forze dopo un lungo viaggio."
      ],
      "nota": "Può reggere una proposizione completiva introdotta da 'che' + congiuntivo o un infinito preceduto da 'di': 'è necessario che tu venga' / 'è necessario venire'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che consegue in modo inevitabile da una causa o da una premessa, senza possibilità di essere altrimenti; logicamente o causalmente obbligato.",
      "examples": [
        "La conclusione che ne deriva è necessaria: se tutti gli uomini sono mortali e Socrate è un uomo, allora Socrate è mortale.",
        "Il cambiamento era una conseguenza necessaria delle nuove leggi economiche."
      ],
      "nota": "Uso prevalente in contesti filosofici, logici o scientifici, in opposizione a 'contingente' o 'accidentale'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che è strettamente indispensabile, l'essenziale, il minimo richiesto per vivere o per fare qualcosa.",
      "examples": [
        "In viaggio porto solo il necessario, senza peso superfluo.",
        "Quella famiglia vive con il necessario e non si permette alcun lusso."
      ],
      "nota": "Usato quasi esclusivamente al singolare con articolo determinativo: 'il necessario'."
    }
  ]
