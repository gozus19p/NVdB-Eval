  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova a grande distanza nello spazio rispetto a un punto di riferimento.",
      "examples": [
        "La stazione è lontana da qui, ci vogliono almeno venti minuti a piedi.",
        "Vivono in un paese lontano, al confine con la Francia."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è separato da una grande distanza nel tempo, collocato in un passato o futuro remoto.",
      "examples": [
        "Quei ricordi appartengono a un'epoca lontana della mia vita.",
        "Il pensionamento è ancora lontano per me."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha scarsa vicinanza affettiva, relazionale o parentale; distante sul piano emotivo o dei legami.",
      "examples": [
        "Da quando si è trasferito, si è fatto sempre più lontano dagli amici di un tempo.",
        "È un parente lontano, lo vedo solo ai matrimoni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che differisce notevolmente da qualcosa, che non ha attinenza diretta con un argomento, un'idea o una posizione.",
      "examples": [
        "La sua proposta è lontana dalla realtà dei fatti.",
        "Queste conclusioni sono molto lontane da quello che sostenevo."
      ],
      "nota": "Spesso usato con la preposizione 'da' in costruzioni comparative."
    },
    {
      "pos": "avverbio",
      "definition": "A grande distanza nello spazio rispetto a un punto di riferimento.",
      "examples": [
        "Non abitano lontano, sono a dieci minuti di macchina.",
        "Si fermò a guardare lontano, verso l'orizzonte."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In senso figurato, a grande distanza rispetto a un obiettivo, a uno standard o a una condizione desiderata.",
      "examples": [
        "Siamo ancora lontano dal raggiungere un accordo.",
        "Con questi risultati sei ancora lontano dalla promozione."
      ],
      "nota": "In questa accezione è invariabile nella forma avverbiale e si costruisce tipicamente con 'da'."
    }
  ]
