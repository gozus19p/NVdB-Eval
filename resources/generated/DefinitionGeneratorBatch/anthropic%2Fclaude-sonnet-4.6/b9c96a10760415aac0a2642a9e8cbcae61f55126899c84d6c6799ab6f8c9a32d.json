  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Sistema di produzione, distribuzione e consumo di beni e servizi all'interno di una comunità, uno Stato o a livello globale.",
      "examples": [
        "La crisi del 2008 ha colpito duramente l'economia mondiale.",
        "Il governo ha adottato misure per rilanciare l'economia nazionale."
      ],
      "nota": "In questo senso si usa spesso con aggettivi geografici o di scala: economia italiana, economia europea, economia globale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Disciplina accademica e scientifica che studia i meccanismi di produzione, scambio e distribuzione delle risorse.",
      "examples": [
        "Ha conseguito una laurea in economia e commercio.",
        "L'economia comportamentale ha rivoluzionato la comprensione delle scelte umane."
      ],
      "nota": "Corrisponde alla scienza economica; non va confusa con il sistema economico reale."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Gestione oculata e parsimoniosa delle proprie risorse finanziarie o materiali, con l'obiettivo di evitare sprechi.",
      "examples": [
        "Grazie alla sua economia nelle spese, è riuscita a mettere da parte un bel gruzzolo.",
        "In tempi difficili bisogna fare economia e ridurre i consumi superflui."
      ],
      "nota": "In questo senso è sinonimo di risparmio e parsimonia; può avere connotazione positiva (prudenza) o, in contesti ironici, negativa (eccessiva avarizia)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Principio di efficienza nell'uso di mezzi espressivi, strutturali o tecnici, volto a ottenere il massimo risultato con il minimo dispendio di elementi.",
      "examples": [
        "L'economia del racconto è ammirevole: nessuna parola è superflua.",
        "Il regista ha costruito il film con grande economia di mezzi visivi."
      ],
      "nota": "Uso prevalentemente critico-letterario o artistico; si parla di 'economia narrativa', 'economia del linguaggio', ecc."
    }
  ]
