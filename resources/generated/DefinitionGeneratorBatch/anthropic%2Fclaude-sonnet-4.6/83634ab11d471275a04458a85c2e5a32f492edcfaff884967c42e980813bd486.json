  "senses": [
    {
      "pos": "aggettivo numerale cardinale, invariabile",
      "definition": "Che indica una quantità pari a tre più uno (4).",
      "examples": [
        "Ho comprato quattro mele al mercato.",
        "La settimana lavorativa standard dura cinque giorni, ma lui ne lavora solo quattro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale, invariabile – uso figurato",
      "definition": "Indica una quantità molto piccola, quasi irrisoria; usato in contesti iperbolici o enfatici per sottolineare scarsità o brevità.",
      "examples": [
        "Siamo rimasti in quattro gatti alla riunione.",
        "Ho detto quattro parole e già si è offeso."
      ],
      "nota": "In questo uso enfatico il valore non è letteralmente numerico ma esprime minimizzazione. Molto frequente nelle locuzioni idiomatiche."
    },
    {
      "pos": "sostantivo m., invariabile",
      "definition": "Il numero intero corrispondente alla cifra 4, considerato come entità astratta o come simbolo grafico.",
      "examples": [
        "Il quattro è un numero pari.",
        "Ha scritto un quattro sul foglio invece di un nove."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m., invariabile",
      "definition": "Nella valutazione scolastica italiana, voto corrispondente a 4/10, indicante una prestazione gravemente insufficiente.",
      "examples": [
        "Ha preso quattro in matematica e dovrà ripassare tutto.",
        "Un quattro al compito di italiano è una brutta notizia per i genitori."
      ],
      "nota": "Nel sistema scolastico italiano i voti vanno da 1 a 10; il quattro è considerato una insufficienza grave."
    },
    {
      "pos": "sostantivo m., invariabile",
      "definition": "Giorno del mese corrispondente al numero 4.",
      "examples": [
        "Ci vediamo il quattro di luglio.",
        "La riunione è fissata per il quattro del mese prossimo."
      ],
      "nota": null
    }
  ]
