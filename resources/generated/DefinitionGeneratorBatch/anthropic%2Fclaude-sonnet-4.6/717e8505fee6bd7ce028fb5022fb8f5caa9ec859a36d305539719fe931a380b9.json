  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non ha limiti né confini, che non può essere misurato o delimitato nello spazio, nel tempo o nella quantità.",
      "examples": [
        "L'universo potrebbe essere infinito e privo di margini.",
        "Guardando il mare di notte, si ha la sensazione di trovarsi di fronte a qualcosa di infinito."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Molto grande, numeroso o intenso, usato in senso iperbolico per indicare una quantità o misura straordinariamente elevata.",
      "examples": [
        "Ti sono infinitamente grato per tutto quello che hai fatto.",
        "Ha dimostrato una pazienza infinita nel gestire quella situazione difficile."
      ],
      "nota": "Uso figurato e iperbolico, frequente nel parlato e nella scrittura espressiva."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che non ha confini o limiti; concetto astratto di assenza di fine, spesso associato alla metafisica, alla filosofia o alla contemplazione esistenziale.",
      "examples": [
        "I filosofi hanno a lungo riflettuto sulla natura dell'infinito.",
        "Il poeta si perde nella contemplazione dell'infinito davanti alla siepe."
      ],
      "nota": "Il riferimento alla poesia di Leopardi 'L'Infinito' è culturalmente radicato nell'uso italiano di questo termine."
    },
    {
      "pos": "sostantivo m.",
      "definition": "In matematica, valore che supera ogni quantità finita, utilizzato per indicare un limite o una grandezza non numericamente definibile.",
      "examples": [
        "In analisi matematica, la funzione tende all'infinito quando x si avvicina a zero.",
        "Il simbolo ∞ rappresenta l'infinito nel calcolo differenziale e integrale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In grammatica, modo verbale non finito che esprime l'azione o lo stato in modo astratto e non determinato rispetto a persona o numero.",
      "examples": [
        "In italiano, l'infinito del verbo 'andare' è la forma base usata nei dizionari.",
        "L'insegnante ha spiegato come si coniuga il verbo all'infinito presente e passato."
      ],
      "nota": "Abbreviato spesso come 'inf.' nelle grammatiche e nei dizionari."
    }
  ]
