  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Apertura o varco attraverso cui si lascia un luogo chiuso o delimitato; punto di accesso in senso inverso rispetto all'entrata.",
      "examples": [
        "L'uscita di emergenza si trova in fondo al corridoio.",
        "I passeggeri sono pregati di dirigersi verso l'uscita numero 5."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Azione o fatto di andarsene da un luogo o di allontanarsi da una situazione; il momento in cui si lascia un ambiente.",
      "examples": [
        "All'uscita dalla riunione, Maria era visibilmente stanca.",
        "Aspettami fuori, ci vediamo all'uscita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Breve spostamento fuori casa o da un luogo abituale per svago, commissioni o altro; gita di breve durata.",
      "examples": [
        "Dopo settimane di lavoro intenso, ci siamo concessi un'uscita in montagna.",
        "Il sabato sera organizzano sempre un'uscita con gli amici."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Battuta spiritosa, risposta arguta o commento improvviso e inaspettato, spesso a effetto comico.",
      "examples": [
        "La sua uscita ha fatto ridere tutta la classe.",
        "Non me l'aspettavo: che uscita geniale!"
      ],
      "nota": "In questo senso ha spesso una connotazione positiva di arguzia, ma può anche indicare una battuta inopportuna o fuori luogo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In ambito economico-contabile, somma di denaro spesa o erogata; contrapposto a entrata.",
      "examples": [
        "Le uscite mensili superano ormai le entrate.",
        "Il bilancio familiare è in difficoltà a causa delle uscite impreviste."
      ],
      "nota": "Usato prevalentemente al plurale in contesti economici e contabili."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Pubblicazione, distribuzione o messa in circolazione di un prodotto editoriale, discografico, cinematografico o informatico.",
      "examples": [
        "L'uscita del nuovo album è prevista per il mese prossimo.",
        "La data di uscita del film è stata spostata a causa della pandemia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel calcio e in altri sport, intervento del portiere o di un giocatore che si sposta dalla propria posizione per intercettare la palla o l'avversario.",
      "examples": [
        "L'uscita del portiere ha sventato il contropiede degli avversari.",
        "È stata un'uscita rischiosa, ma il portiere ha bloccato il pallone."
      ],
      "nota": null
    }
  ]
