  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Collocare qualcosa o qualcuno in un luogo determinato, spostandolo dalla posizione originaria.",
      "examples": [
        "Metti il libro sul tavolo, per favore.",
        "Ha messo le chiavi nella borsa e non le trova più."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Indossare un capo di abbigliamento o un accessorio.",
      "examples": [
        "Oggi fa freddo, metti il cappotto prima di uscire.",
        "Non so quale vestito mettere per la cena di stasera."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Aggiungere un ingrediente o una sostanza a qualcosa durante una preparazione.",
      "examples": [
        "Ha messo troppo sale nella minestra.",
        "Metti un po' di zucchero nel caffè se lo vuoi dolce."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Investire o impiegare tempo, denaro o risorse in qualcosa.",
      "examples": [
        "Ha messo tutti i suoi risparmi in quella casa.",
        "Ci ha messo tre anni per finire la tesi."
      ],
      "nota": "In questa accezione si usa spesso con il verbo 'metterci' (forma con pronome clitico) per indicare il tempo o la quantità impiegata."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Provocare o causare un determinato stato d'animo o condizione in qualcuno.",
      "examples": [
        "Quella notizia mi ha messo di cattivo umore.",
        "Il suo comportamento mi mette a disagio."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Attivare o avviare un dispositivo, un apparecchio o un contenuto audio-visivo.",
      "examples": [
        "Metti la televisione, inizia il telegiornale.",
        "Ha messo la musica a tutto volume durante la festa."
      ],
      "nota": "Uso colloquiale sinonimo di 'accendere' o 'avviare'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Supporre per ipotesi, prendere come dato di partenza in un ragionamento.",
      "examples": [
        "Mettiamo che tu abbia ragione: come andremo avanti?",
        "Metti che domani piova: cosa facciamo del picnic?"
      ],
      "nota": "Usato spesso in frasi ipotetiche, in modo quasi impersonale o alla prima persona plurale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inserire o far comparire qualcuno o qualcosa in un contesto, un elenco, una situazione.",
      "examples": [
        "Il regista l'ha messa nel film come protagonista.",
        "Hai messo anche me nell'elenco degli invitati?"
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (mettersi)",
      "definition": "Portarsi in una determinata posizione o postura.",
      "examples": [
        "Si è messa seduta sul divano e ha iniziato a leggere.",
        "Mettiti in fila come gli altri, per favore."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (mettersi)",
      "definition": "Iniziare a svolgere un'attività o a trovarsi in uno stato.",
      "examples": [
        "Si è messo a piangere senza motivo apparente.",
        "Finalmente si è messa a studiare con serietà."
      ],
      "nota": "Costruito con la preposizione 'a' seguita dall'infinito per indicare l'inizio di un'azione."
    },
    {
      "pos": "verbo riflessivo (mettersi)",
      "definition": "Indossare su se stessi un capo di abbigliamento o un accessorio.",
      "examples": [
        "Si è messa il cappello e gli occhiali da sole.",
        "Non riesco a decidere cosa mettermi per il colloquio."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (mettersi)",
      "definition": "Iniziare una relazione sentimentale con qualcuno.",
      "examples": [
        "Si sono messi insieme la scorsa estate.",
        "Ti sei messa con qualcuno di nuovo?"
      ],
      "nota": "Uso colloquiale, tipico del parlato informale."
    }
