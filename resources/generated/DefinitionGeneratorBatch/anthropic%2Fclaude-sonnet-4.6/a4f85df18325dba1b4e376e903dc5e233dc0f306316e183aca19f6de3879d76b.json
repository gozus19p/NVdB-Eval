            "definitions": [
              {
                "glossa": "Qualsiasi animale vertebrato che vive e respira sott’acqua, di forma generalmente affusolata, rivestito di squame e dotato di pinne e coda o, anche improprio , mammifero acquatico, quale la balena, il delfino, eccetera",
                "source": "tdm"
              }
            ],
            "examples": [
              "pesce di mare",
              "di fiume",
              "di lago"
            ]
          },
          {
            "number": 2,
            "marks": [
              "specialmente"
            ],
            "definitions": [
              {
                "glossa": "Con scheletro formato da elementi ossei, con scheletro formato da elementi cartilaginei; molto bene; sanissimo; assolutamente zitto o fermamente intenzionato a non parlare, specialmente di un determinato argomento; con il corpo proteso in avanti",
                "source": "tdm"
              }
            ],
            "examples": [
              "pesce osseo",
              "pesce cartilagineo",
              "nuotare come un pesce",
              "sano come un pesce",
              "muto come un pesce",
              "tuffarsi a pesce"
            ]
          }
        ]
