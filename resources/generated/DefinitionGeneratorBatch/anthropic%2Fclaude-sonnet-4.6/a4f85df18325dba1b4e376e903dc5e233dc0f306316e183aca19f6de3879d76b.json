  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Animale vertebrato acquatico a sangue freddo, dotato di branchie per la respirazione e di pinne per il movimento, appartenente alla fauna di mari, fiumi e laghi.",
      "examples": [
        "Il pescatore ha tirato su un grosso pesce dal fiume.",
        "I pesci tropicali colorano l'acquario di sfumature vivaci."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "La carne di tale animale utilizzata come alimento.",
      "examples": [
        "Oggi a pranzo ho mangiato del pesce al forno con le patate.",
        "Il medico consiglia di consumare pesce almeno due volte a settimana."
      ],
      "nota": "In questo senso è usato come sostantivo di massa, spesso senza articolo o con articolo partitivo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Dodicesimo segno dello zodiaco, corrispondente al periodo compreso tra circa il 19 febbraio e il 20 marzo; persona nata sotto tale segno.",
      "examples": [
        "Mia sorella è dei Pesci e dicono che sia molto intuitiva.",
        "L'oroscopo dei Pesci prevede cambiamenti in amore per questa settimana."
      ],
      "nota": "In questo senso si usa prevalentemente al plurale e con la maiuscola: Pesci."
    },
    {
      "pos": "sostantivo m. (figurato)",
      "definition": "Persona ritenuta fredda, distaccata o poco reattiva sul piano emotivo o intellettivo.",
      "examples": [
        "Non aspettarti reazioni da lui: è un pesce, non si emoziona mai.",
        "A quella festa sembrava un pesce fuor d'acqua, non parlava con nessuno."
      ],
      "nota": "L'espressione 'pesce fuor d'acqua' indica una persona a disagio in un determinato contesto; 'essere un pesce' da solo può indicare freddezza emotiva o apatia."
    },
    {
      "pos": "sostantivo m. (gergale, informatica/cronaca)",
      "definition": "Tecnica di frode informatica mediante la quale si ingannano gli utenti inducendoli a fornire dati personali o credenziali, simulando comunicazioni ufficiali.",
      "examples": [
        "Ho ricevuto un'email di phishing che cercava di rubarmi le credenziali bancarie.",
        "Attenzione ai messaggi sospetti: potrebbero essere un tentativo di pesce, in gergo phishing."
      ],
      "nota": "In italiano si usa quasi sempre il termine inglese 'phishing'; il calco 'pesce' compare solo in contesti divulgativi informali come traduzione letterale dell'inglese 'fishing/phishing'."
    }
  ]
