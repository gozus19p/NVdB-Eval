  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Mammifero carnivoro domestico della famiglia dei felidi, dal corpo agile e flessuoso, con artigli retrattili e vista notturna sviluppata, tenuto comunemente come animale da compagnia.",
      "examples": [
        "Il gatto si è acciambellato sul divano e dorme dalla mattina.",
        "Abbiamo adottato un gatto randagio trovato nel cortile."
      ],
      "nota": "La femmina è chiamata 'gatta'; il giovane 'gattino'. Il termine si riferisce sia alla specie domestica (Felis catus) sia, in senso esteso, ad altri felidi selvatici (es. gatto selvatico)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona scaltra, silenziosa e difficile da cogliere di sorpresa, che si muove con destrezza evitando i problemi.",
      "examples": [
        "È un vecchio gatto, non riesci mai a prenderlo in fallo.",
        "In ufficio si comporta da gatto: non parla mai, ma sa tutto di tutti."
      ],
      "nota": "Uso figurato a connotazione prevalentemente positiva o neutra, che attribuisce alla persona le qualità stereotipicamente associate all'animale: astuzia, agilità, indipendenza."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Strumento meccanico a vite o a cremagliera usato per sollevare carichi pesanti, come un'automobile, detto anche cric.",
      "examples": [
        "Ho usato il gatto per cambiare la ruota bucata sul ciglio della strada.",
        "Controlla che il gatto sia nel bagagliaio prima di partire per il viaggio."
      ],
      "nota": "In questo senso è sinonimo di 'cric' e 'martinetto'. L'uso è comune nel linguaggio quotidiano e automobilistico."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nell'espressione 'gatto a nove code', strumento di punizione corporale costituito da un manico con nove cordicelle annodate, usato storicamente come frusta.",
      "examples": [
        "Il gatto a nove code era una punizione comune nella marina militare del XVIII secolo.",
        "Il romanzo descriveva le pene corporali, tra cui il gatto a nove code."
      ],
      "nota": "Uso settoriale storico; si incontra soprattutto in contesti narrativi, storici o figurati per indicare punizioni severe."
    }
  ]
