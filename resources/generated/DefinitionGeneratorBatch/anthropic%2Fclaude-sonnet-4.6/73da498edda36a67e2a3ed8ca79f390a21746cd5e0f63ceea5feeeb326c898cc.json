  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che manca di bellezza estetica, sgradevole all'aspetto visivo.",
      "examples": [
        "Quel palazzo è davvero brutto, non si inserisce per niente nel contesto del quartiere.",
        "Non pensare di essere brutta: hai dei lineamenti molto particolari."
      ],
      "nota": "Antonimo di 'bello'. Si applica a persone, oggetti, luoghi, opere d'arte."
    },
    {
      "pos": "aggettivo",
      "definition": "Di tempo atmosferico, caratterizzato da condizioni sfavorevoli come pioggia, vento o nuvole.",
      "examples": [
        "Con questo brutto tempo non possiamo uscire a fare il picnic.",
        "Le previsioni annunciano un fine settimana brutto su tutta la penisola."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Moralmente riprovevole, disonesto o contrario alle norme etiche e sociali.",
      "examples": [
        "È stato un brutto gesto lasciarti senza spiegazioni.",
        "Mentire ai propri genitori è una cosa brutta."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Grave, preoccupante o che ispira timore; detto di situazioni, malattie o eventi.",
      "examples": [
        "Ha preso una brutta influenza e dovrà stare a letto per una settimana.",
        "La situazione si sta mettendo in modo brutto, farei attenzione."
      ],
      "nota": "In questo uso esprime un giudizio valutativo sulla gravità o pericolosità di qualcosa, non sulla sua estetica."
    },
    {
      "pos": "aggettivo",
      "definition": "Di scarsa qualità, fatto male o insoddisfacente.",
      "examples": [
        "Ho letto un brutto romanzo: trama banale e personaggi piatti.",
        "Il suo intervento è stato brutto, senza idee né sostanza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciò che è esteticamente sgradevole o mancante di bellezza.",
      "examples": [
        "C'è anche del brutto nell'arte contemporanea che merita riflessione.",
        "La differenza tra il bello e il brutto è spesso soggettiva."
      ],
      "nota": "Usato come sostantivo astratto, spesso in contrapposizione a 'bello'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo sgradevole, male o in maniera che suscita preoccupazione; usato in costruzioni predicative o con verbi.",
      "examples": [
        "Le cose si stanno mettendo brutto: meglio prepararsi al peggio.",
        "Sta andando brutto per la nostra squadra, siamo sotto di due gol."
      ],
      "nota": "Uso avverbiale informale, frequente nell'italiano parlato, soprattutto nelle locuzioni 'mettersi brutto' e 'andare brutto'."
    }
  ]
