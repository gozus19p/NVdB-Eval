  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che possiede competenza, abilità o talento in un'attività o in un campo specifico.",
      "examples": [
        "È una brava pianista: ha vinto diversi concorsi internazionali.",
        "Mio figlio è molto bravo in matematica, ma fa fatica con le lingue."
      ],
      "nota": "Spesso seguito dalla preposizione 'in' + sostantivo o 'a' + infinito per specificare l'ambito di competenza: 'bravo in cucina', 'bravo a disegnare'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si comporta in modo corretto, onesto e moralmente irreprensibile; di buon carattere.",
      "examples": [
        "È un brav'uomo, disponibile e generoso con tutti.",
        "Fai il bravo mentre sei dalla nonna e non fare i capricci."
      ],
      "nota": "In questo senso è spesso usato con bambini o in contesti familiari/affettivi per indicare obbedienza e buona condotta."
    },
    {
      "pos": "aggettivo",
      "definition": "Usato in senso rafforzativo o ironico davanti a un sostantivo per evidenziare una qualità, spesso negativa o sorprendente.",
      "examples": [
        "Ha detto una bella bugia, il bravo ragazzo!",
        "Con la sua brava faccia tosta, ha chiesto un aumento dopo un mese."
      ],
      "nota": "Uso ironico: il contesto e l'intonazione segnalano il rovesciamento del significato positivo."
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione usata per esprimere approvazione, compiacimento o applauso nei confronti di qualcuno.",
      "examples": [
        "Bravo! Hai fatto un discorso eccellente.",
        "Alla fine dell'esibizione, il pubblico gridava 'Bravo! Bravo!'"
      ],
      "nota": "Al femminile diventa 'brava', al plurale 'bravi'/'brave'. In ambito teatrale e operistico il termine è utilizzato per acclamare i/le cantanti o attori/attrici."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che eccelle in un'attività o che dimostra notevole abilità in qualcosa.",
      "examples": [
        "In quella squadra ci sono dei veri bravi, difficile batterli.",
        "È uno dei bravi del settore: tutti lo cercano per i progetti più complessi."
      ],
      "nota": "Uso sostantivato dell'aggettivo, prevalentemente al plurale e in contesti informali."
    }
  ]
