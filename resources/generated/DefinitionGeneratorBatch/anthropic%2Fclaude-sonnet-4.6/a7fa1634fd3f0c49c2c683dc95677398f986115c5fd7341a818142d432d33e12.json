  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Immersione del corpo, o di parte di esso, in acqua o altro liquido, a scopo igienico, terapeutico o ricreativo.",
      "examples": [
        "Ogni sera fa un bagno caldo per rilassarsi dopo il lavoro.",
        "Il medico ha consigliato bagni di acqua salata per la guarigione della ferita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Locale di un'abitazione o di un edificio pubblico attrezzato per la cura e l'igiene personale, dotato generalmente di vasca o doccia, lavandino e water.",
      "examples": [
        "L'appartamento ha due bagni, uno per gli ospiti e uno padronale.",
        "Scusa, potrei usare il bagno?"
      ],
      "nota": "In italiano contemporaneo è il termine più comune per indicare il locale igienico, usato sia in contesti formali che informali; sinonimo parziale di 'toilette' e 'servizi'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Struttura balneare attrezzata sulla riva del mare o di un lago, che offre servizi ai bagnanti come ombrelloni, lettini e cabine.",
      "examples": [
        "Abbiamo preso l'abbonamento al bagno numero 15 per tutta l'estate.",
        "I bagni di Rimini sono tra i più frequentati della riviera adriatica."
      ],
      "nota": "Questo uso è tipico dell'italiano centro-settentrionale; nel Sud Italia si preferisce spesso 'lido'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Soluzione liquida in cui si immerge un oggetto o una sostanza per trattarla chimicamente, termicamente o fotograficamente.",
      "examples": [
        "Il gioielliere ha immerso il bracciale in un bagno d'oro.",
        "In camera oscura, la stampa viene immersa nel bagno di sviluppo."
      ],
      "nota": "Uso tecnico diffuso in chimica, fotografia tradizionale e metallurgia."
    },
    {
      "pos": "sostantivo m. (figurato)",
      "definition": "Esposizione prolungata e intensa a qualcosa di immateriale, come suoni, luci o atmosfere.",
      "examples": [
        "Il concerto è stato un bagno di musica travolgente.",
        "Camminare tra quelle foreste è stato un vero bagno di pace e silenzio."
      ],
      "nota": "Frequente nella locuzione 'bagno di folla', che indica l'immersione di un personaggio pubblico tra la gente per salutarla e stringerle la mano."
    }
  ]
