  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha un accumulo eccessivo di tessuto adiposo; di corporatura abbondante e pesante.",
      "examples": [
        "Da quando ha smesso di fare sport è diventato molto grasso.",
        "Il gatto grasso dormiva tutto il giorno sul divano."
      ],
      "nota": "Può avere connotazione negativa o neutra a seconda del contesto; spesso preferito il sinonimo 'in sovrappeso' in contesti formali o medici."
    },
    {
      "pos": "aggettivo",
      "definition": "Ricco di sostanze lipidiche; che contiene o è impregnato di olio, unto o materie grasse.",
      "examples": [
        "Evita i cibi grassi se vuoi tenere sotto controllo il colesterolo.",
        "Ha le mani grasse dopo aver aggiustato il motore."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di terreno agricolo, fertile e ricco di sostanze nutritive.",
      "examples": [
        "Le pianure della Lombardia sono terre grasse e molto produttive.",
        "Il contadino era fortunato ad avere un campo così grasso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di carattere tipografico, con tratto spesso e marcato; in neretto.",
      "examples": [
        "I titoli del giornale sono scritti in grassetto, ovvero in carattere grasso.",
        "Usa il corsivo per le citazioni e il grassetto per i termini chiave."
      ],
      "nota": "In tipografia si usa spesso la forma sostantivata 'grassetto' per riferirsi allo stile tipografico in neretto."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di suono o voce, pieno, profondo e risonante.",
      "examples": [
        "Aveva una risata grassa che si sentiva da tutto il corridoio.",
        "Il basso cantava con una voce grassa e avvolgente."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di parole o battute, volgare, scurrile, osceno.",
      "examples": [
        "La conversazione si fece presto grassa e poco adatta alla situazione.",
        "Raccontava barzellette grasse che imbarazzavano molti presenti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un periodo di prosperità economica o di abbondanza.",
      "examples": [
        "Negli anni grassi dell'economia italiana molte famiglie si arricchirono.",
        "Dopo anni magri, finalmente arrivarono tempi grassi per l'azienda."
      ],
      "nota": "Usato spesso in contrasto con 'magro' per descrivere cicli economici o periodi di fortuna/sfortuna; richiama la locuzione biblica 'anni grassi e anni magri'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sostanza lipidica di origine animale o vegetale, usata in cucina o in ambito industriale.",
      "examples": [
        "Sciogli il grasso di maiale in padella prima di aggiungere le verdure.",
        "Il grasso vegetale è spesso utilizzato nella produzione di margarina."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Tessuto adiposo presente nel corpo umano o animale.",
      "examples": [
        "Con la dieta e l'esercizio fisico ha perso molto grasso addominale.",
        "Il grasso corporeo è necessario per le funzioni vitali dell'organismo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sostanza lubrificante densa utilizzata per ridurre l'attrito tra parti meccaniche.",
      "examples": [
        "Bisogna mettere il grasso sui cuscinetti della bicicletta ogni stagione.",
        "Il meccanico applicò abbondante grasso sugli ingranaggi del motore."
      ],
      "nota": "In questo senso si distingue dall'olio lubrificante per la sua consistenza più densa e viscosa."
    }
  ]
