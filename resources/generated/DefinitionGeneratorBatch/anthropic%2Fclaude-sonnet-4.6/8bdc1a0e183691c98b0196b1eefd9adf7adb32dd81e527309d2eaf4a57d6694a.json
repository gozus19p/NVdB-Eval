  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo all'organizzazione e alla gestione del potere nello Stato, alle istituzioni pubbliche e alle attività di governo.",
      "examples": [
        "Il dibattito politico in Italia si è infiammato dopo le elezioni.",
        "La crisi politica ha portato alla caduta del governo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda le posizioni, le ideologie o le scelte di schieramento di partiti o movimenti nel contesto del potere pubblico.",
      "examples": [
        "Ha sempre avuto idee politiche molto radicali.",
        "La sua appartenenza politica non è mai stata un segreto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di persona o comportamento, che agisce con abilità diplomatica e calcolo strategico, evitando conflitti o sfruttando le situazioni a proprio vantaggio.",
      "examples": [
        "La sua risposta è stata molto politica: non ha scontentato nessuno.",
        "È un uomo politico nel senso peggiore del termine: dice sempre quello che fa comodo sentire."
      ],
      "nota": "In questo uso, il termine assume spesso una connotazione leggermente negativa, associata a opportunismo o mancanza di franchezza."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che esercita un ruolo attivo nella vita pubblica istituzionale, come parlamentare, amministratore o membro di un partito.",
      "examples": [
        "I politici italiani si sono riuniti per discutere la legge di bilancio.",
        "È una politica di lungo corso, con decenni di esperienza nel governo locale."
      ],
      "nota": "Il femminile 'politica' può riferirsi sia alla persona (la politica) sia alla disciplina o all'attività in sé; il contesto disambigua."
    }
  ]
