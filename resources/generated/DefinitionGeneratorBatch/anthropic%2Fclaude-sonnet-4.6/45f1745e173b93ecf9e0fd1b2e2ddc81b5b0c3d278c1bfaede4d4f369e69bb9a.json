  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Periodo di permanenza in un luogo diverso dalla propria residenza abituale, per vacanza, lavoro o altri scopi.",
      "examples": [
        "Il soggiorno a Parigi è durato tre settimane.",
        "Abbiamo prenotato un soggiorno di sette giorni in un resort alle Maldive."
      ],
      "nota": "In ambito burocratico e giuridico, il termine indica la permanenza regolamentata di uno straniero nel territorio nazionale, come in 'permesso di soggiorno'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stanza principale di un appartamento o di una casa, destinata alla vita comune e al ricevimento degli ospiti.",
      "examples": [
        "Abbiamo arredato il soggiorno con un divano nuovo e un tavolino basso.",
        "I bambini giocavano nel soggiorno mentre i genitori preparavano la cena."
      ],
      "nota": "Spesso usato come sinonimo di 'salotto' o 'sala', anche se 'soggiorno' può indicare un ambiente più informale e polivalente rispetto al 'salotto' tradizionale."
    }
  ]
