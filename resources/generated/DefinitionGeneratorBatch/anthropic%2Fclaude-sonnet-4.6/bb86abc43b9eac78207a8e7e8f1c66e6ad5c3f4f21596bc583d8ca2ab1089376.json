  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Struttura composta di gradini sovrapposti che permette di salire o scendere da un livello a un altro, fissa o mobile.",
      "examples": [
        "Ha salito le scale di corsa per non perdere l'ascensore.",
        "La scala a pioli era appoggiata al muro del magazzino."
      ],
      "nota": "Può indicare sia una singola rampa sia l'intero vano scale di un edificio; al plurale 'le scale' si riferisce spesso all'insieme delle rampe di un palazzo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Successione ordinata di valori, gradi o livelli che misura o classifica un fenomeno o una qualità.",
      "examples": [
        "La temperatura era di 37,5 gradi sulla scala Celsius.",
        "Il terremoto ha raggiunto il sesto grado della scala Richter."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Rapporto di proporzione tra le dimensioni reali di un oggetto o territorio e la loro rappresentazione grafica o modellistica.",
      "examples": [
        "La cartina è disegnata in scala 1:50.000.",
        "L'architetto ha costruito un modello in scala dell'edificio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Dimensione o ampiezza relativa di un fenomeno, un'operazione o un progetto.",
      "examples": [
        "Il progetto è stato realizzato su scala nazionale.",
        "L'intervento umanitario ha assunto una scala senza precedenti."
      ],
      "nota": "Spesso usato nelle locuzioni 'su larga scala', 'su piccola scala', 'su scala globale'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In musica, successione di note disposte in ordine ascendente o discendente secondo intervalli definiti.",
      "examples": [
        "Il pianista eseguiva scale cromatiche per riscaldarsi prima del concerto.",
        "La scala di do maggiore è la più semplice da imparare per i principianti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nel gioco delle carte, combinazione di carte consecutive dello stesso seme o di semi diversi, a seconda del gioco.",
      "examples": [
        "Ha vinto la mano con una scala reale.",
        "Mi mancava solo una carta per completare la scala."
      ],
      "nota": "Tipico del poker e di altri giochi di carte."
    }
  ]
