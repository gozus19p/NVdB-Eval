  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Attività lavorativa manuale o artigianale svolta abitualmente come fonte di reddito, generalmente acquisita attraverso apprendimento pratico.",
      "examples": [
        "Mio nonno ha fatto il falegname per tutta la vita: era un mestiere che amava profondamente.",
        "Imparare un mestiere richiede anni di pratica e dedizione."
      ],
      "nota": "Si distingue da 'professione', che implica solitamente una formazione accademica, e da 'lavoro', termine più generico. Spesso associato ad attività artigianali o tecniche."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Per estensione, qualsiasi occupazione o attività professionale svolta con competenza acquisita nel tempo, anche non manuale.",
      "examples": [
        "Fare il giornalista è un mestiere difficile, che richiede curiosità e rigore.",
        "L'insegnamento è un mestiere nobile ma spesso poco riconosciuto."
      ],
      "nota": "In questo uso più ampio, il termine si avvicina a 'professione' senza tuttavia perdere la connotazione di competenza pratica."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme di abilità tecniche e pratiche specifiche di un'attività, inteso come padronanza del saper fare.",
      "examples": [
        "Quel regista conosce il suo mestiere: ogni scena è costruita con grande precisione.",
        "Con gli anni ha acquisito un mestiere solido che si vede in ogni sua opera."
      ],
      "nota": "In questa accezione, il termine ha valore valutativo positivo e indica competenza consolidata; ricorre spesso nelle espressioni 'conoscere il proprio mestiere' e 'uomo di mestiere'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Attività disonesta, illecita o moralmente riprovevole esercitata abitualmente, con tono ironico o spregiativo.",
      "examples": [
        "Il borseggio era diventato il suo mestiere: operava sui mezzi pubblici con grande abilità.",
        "Quel faccendiere aveva fatto del traffico di favori il suo mestiere."
      ],
      "nota": "Uso figurato con forte connotazione ironica o negativa; il contesto chiarisce il giudizio morale implicito."
    }
  ]
