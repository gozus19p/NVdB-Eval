  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Condizione di chi non è soggetto a costrizioni fisiche, prigionia o schiavitù; possibilità di muoversi e agire senza essere trattenuto.",
      "examples": [
        "Dopo anni di detenzione, ha finalmente riacquistato la libertà.",
        "I prigionieri rivendicavano la loro libertà con una protesta silenziosa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Facoltà riconosciuta a un individuo o a un gruppo di compiere determinate azioni o esprimere pensieri senza subire impedimenti giuridici o politici; diritto civile garantito dall'ordinamento.",
      "examples": [
        "La libertà di stampa è un pilastro fondamentale della democrazia.",
        "La Costituzione tutela la libertà di religione e di opinione."
      ],
      "nota": "Spesso usato al plurale (libertà civili, libertà fondamentali) per indicare l'insieme dei diritti riconosciuti ai cittadini."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Assenza di vincoli, obblighi o restrizioni in un determinato ambito; possibilità di scegliere autonomamente come agire.",
      "examples": [
        "Finito il lavoro, ho tutta la libertà di organizzare il mio tempo come voglio.",
        "Gli fu data piena libertà di decidere come gestire il progetto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Atteggiamento di disinvoltura o di eccessiva familiarità nei confronti di qualcuno o qualcosa, che travalica le convenzioni sociali attese.",
      "examples": [
        "Si è preso troppe libertà con i colleghi, risultando invadente.",
        "Non mi piace il modo in cui si permette certe libertà senza essere stato invitato a farlo."
      ],
      "nota": "In questo senso è frequentemente al plurale e con connotazione negativa o critica."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Capacità della volontà umana di autodeterminarsi indipendentemente da condizionamenti esterni o determinismi; concetto centrale nella filosofia morale.",
      "examples": [
        "Il problema della libertà del volere è al centro del dibattito tra deterministi e compatibilisti.",
        "Kant concepisce la libertà come autonomia della ragione pratica."
      ],
      "nota": "Accezione prevalentemente filosofica, spesso accompagnata da specificazioni come 'libertà del volere' o 'libertà arbitrio'."
    }
  ]
