  "senses": [
    {
      "pos": "verbo intransitivo / transitivo",
      "definition": "Produrre con la voce una sequenza di suoni musicali modulati, eseguendo melodie con o senza testo.",
      "examples": [
        "Maria canta benissimo, dovrebbe iscriversi a un corso di lirica.",
        "Il coro ha cantato l'inno nazionale prima della partita."
      ],
      "nota": "Può essere usato in modo assoluto (senza oggetto) o con oggetto diretto (cantare una canzone, cantare un'aria)."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Emettere suoni melodiosi e ripetuti, detto di uccelli o di altri animali.",
      "examples": [
        "I merli cantano ogni mattina nel giardino.",
        "Le cicale cantavano senza sosta durante tutta l'estate."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre un suono continuo e tonalmente variato, detto di oggetti, elementi naturali o strumenti.",
      "examples": [
        "Il vento cantava tra i rami degli alberi.",
        "Il bollitore cantava sul fuoco annunciando che l'acqua era pronta."
      ],
      "nota": "Uso figurato o poetico, per similitudine con il canto umano o animale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Celebrare, esaltare o narrare qualcuno o qualcosa attraverso la parola scritta o poetica.",
      "examples": [
        "Dante cantò l'amore per Beatrice in molte delle sue opere.",
        "Molti poeti romantici hanno cantato le bellezze della natura."
      ],
      "nota": "Uso tipico del linguaggio letterario e poetico."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Confessare o rivelare informazioni compromettenti sotto pressione, specialmente in contesti investigativi o criminali.",
      "examples": [
        "Dopo ore di interrogatorio, il sospettato ha cominciato a cantare.",
        "Non ci volle molto perché l'arrestato cantasse e facesse i nomi dei complici."
      ],
      "nota": "Uso colloquiale e gergale, con connotazione legata al mondo della criminalità o delle indagini."
    }
  ]
