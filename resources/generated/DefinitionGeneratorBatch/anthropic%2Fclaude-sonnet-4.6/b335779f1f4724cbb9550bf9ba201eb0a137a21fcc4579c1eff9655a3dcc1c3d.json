  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Aumentare progressivamente di dimensioni fisiche, svilupparsi biologicamente passando da uno stadio giovanile a uno maturo, detto di esseri viventi.",
      "examples": [
        "I bambini crescono molto in fretta nei primi anni di vita.",
        "Le piante crescono meglio se ricevono abbastanza luce e acqua."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Aumentare in quantità, valore, intensità o dimensione, detto di fenomeni misurabili.",
      "examples": [
        "I prezzi continuano a crescere nonostante le misure del governo.",
        "Il numero degli iscritti all'associazione è cresciuto del trenta per cento nell'ultimo anno."
      ],
      "nota": "Si distingue dal senso biologico perché si applica a entità astratte o quantificabili, non a organismi viventi."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Svilupparsi sotto il profilo personale, intellettuale, morale o emotivo.",
      "examples": [
        "Questa esperienza all'estero mi ha fatto crescere molto come persona.",
        "Affrontare le difficoltà ti aiuta a crescere e a conoscerti meglio."
      ],
      "nota": "Uso figurato del senso biologico; frequentemente usato in contesti riflessivi o formativi."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trascorrere la propria infanzia e giovinezza in un determinato luogo o contesto.",
      "examples": [
        "Sono cresciuto in un piccolo paese di montagna.",
        "Ha cresciuto in una famiglia molto unita e questo ha segnato il suo carattere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Allevare e accudire un figlio o un giovane fino alla maturità.",
      "examples": [
        "Ha cresciuto tre figli da sola dopo la morte del marito.",
        "I nonni hanno cresciuto i nipoti con grande amore e dedizione."
      ],
      "nota": "In questo uso transitivo, è sinonimo di 'allevare' o 'tirare su'. Meno comune del corrispondente uso intransitivo."
    }
  ]
