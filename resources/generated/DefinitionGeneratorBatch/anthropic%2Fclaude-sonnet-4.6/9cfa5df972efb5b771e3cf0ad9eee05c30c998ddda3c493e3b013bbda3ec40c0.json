  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha o trasmette una temperatura elevata, percepita come tale al tatto o all'ambiente circostante.",
      "examples": [
        "Il caffè è ancora caldo, bevilo subito.",
        "Oggi è una giornata calda, meglio restare all'ombra."
      ],
      "nota": "Antonimo di 'freddo'. Si applica a oggetti, liquidi, cibi, condizioni atmosferiche."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di colore, che appartiene alla gamma dei rossi, arancioni e gialli, percepita visivamente come vivace e avvolgente.",
      "examples": [
        "Ha scelto tinte calde per arredare il soggiorno.",
        "Il tramonto dipingeva il cielo di colori caldi e intensi."
      ],
      "nota": "Uso tipico nel linguaggio della pittura, del design e della fotografia, in opposizione a 'colori freddi' (blu, verde, viola)."
    },
    {
      "pos": "aggettivo",
      "definition": "Di persona o comportamento, caratterizzato da affetto, cordialità e partecipazione emotiva sincera.",
      "examples": [
        "È una persona calda e generosa, sempre pronta ad aiutare.",
        "Ci ha riservato un'accoglienza calda e premurosa."
      ],
      "nota": "Uso figurato con connotazione positiva. Si contrappone a 'freddo' nel senso di distaccato o scostante."
    },
    {
      "pos": "aggettivo",
      "definition": "Di situazione, momento o contesto, caratterizzato da tensione, agitazione o pericolo imminente.",
      "examples": [
        "La zona è calda da mesi a causa dei continui scontri.",
        "È stato un periodo caldo per la politica nazionale."
      ],
      "nota": "Uso figurato, spesso in contesti giornalistici o politici. Affine all'espressione 'punto caldo'."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di notizia o informazione, molto recente e appena verificatasi.",
      "examples": [
        "Abbiamo una notizia calda appena arrivata dalla redazione.",
        "Le ultime notizie calde dal fronte vengono aggiornate ogni ora."
      ],
      "nota": "Spesso nella locuzione 'notizie calde' o 'a caldo', intendendo immediatamente dopo un evento."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione termica caratterizzata da una temperatura elevata, avvertita dall'ambiente o dal corpo.",
      "examples": [
        "Non riesco a dormire con questo caldo.",
        "Il caldo estivo quest'anno è stato insopportabile."
      ],
      "nota": "Usato per lo più al singolare e senza articolo in costruzioni esclamative ('Che caldo!'). Antonimo di 'freddo'."
    },
    {
      "pos": "avverbio",
      "definition": "In modo immediato, senza lasciare che la situazione si raffreddi emotivamente o temporalmente; subito dopo un evento.",
      "examples": [
        "A caldo ha detto cose che poi ha dovuto ritrattare.",
        "Meglio non prendere decisioni a caldo quando si è arrabbiati."
      ],
      "nota": "Usato quasi esclusivamente nella locuzione avverbiale 'a caldo'. Si contrappone a 'a freddo', che indica riflessione distaccata e posticipata."
    }
  ]
}