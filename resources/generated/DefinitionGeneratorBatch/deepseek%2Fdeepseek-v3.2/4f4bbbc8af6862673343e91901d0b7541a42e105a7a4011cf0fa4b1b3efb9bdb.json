  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Genitore del padre o della madre di una persona.",
      "examples": [
        "Il mio nonno materno racconta sempre storie della guerra.",
        "I nonni vanno spesso a prendere i nipoti a scuola."
      ],
      "nota": "Il termine femminile corrispondente è 'nonna'. La forma plurale è 'nonni', utilizzata anche per riferirsi collettivamente alla coppia."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Uomo molto anziano, spesso usato in modo affettuoso o rispettoso.",
      "examples": [
        "Quel nonno al parco gioca ancora a bocce con gli amici.",
        "Buongiorno, nonno, ha bisogno di aiuto per attraversare la strada?"
      ],
      "nota": "Uso figurato ed estensivo che enfatizza l'età avanzata e, talvolta, una posizione di saggezza o esperienza."
