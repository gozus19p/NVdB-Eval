  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "emettere un suono o una parola con voce molto forte e spesso acuta, spinta da un'emozione intensa come rabbia, dolore, eccitazione o paura.",
      "examples": [
        "Il bambino ha iniziato a urlare quando ha perso il suo giocattolo preferito.",
        "La folla ha urlato di gioia quando la squadra ha segnato il gol decisivo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "esprimere un concetto, una protesta o un'opinione con veemenza e insistenza, sia verbalmente che attraverso altri mezzi.",
      "examples": [
        "I titoli dei giornali urlano scandalo.",
        "Il colore rosso di quel quadro sembra urlare contro lo spettatore."
      ],
      "nota": "Uso figurato, spesso legato alla comunicazione non verbale o mediata che trasmette un messaggio con forza e immediatezza."
    },
    {
      "pos": "verbo transitivo",
      "definition": "pronunciare o gridare parole o frasi specifiche ad alta voce.",
      "examples": [
        "Il capitano urlò l'ordine di attaccare.",
        "Ha urlato il mio nome dall'altro lato della strada."
      ],
      "nota": null
    }
  ]
