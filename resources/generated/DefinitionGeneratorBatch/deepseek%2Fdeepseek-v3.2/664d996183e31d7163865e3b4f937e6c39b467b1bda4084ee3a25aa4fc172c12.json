  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere lo sporco da una superficie, un oggetto o un ambiente, rendendolo più ordinato e igienico.",
      "examples": [
        "Ogni sabato mattina pulisco a fondo il pavimento della cucina.",
        "Prima di usare il tagliere, ricordati di pulirlo bene con acqua calda."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Privare qualcosa di parti considerate superflue, dannose o indesiderate.",
      "examples": [
        "Il giardiniere ha pulito il roseto dalle foglie secche.",
        "Per migliorare il testo, bisogna pulire il manoscritto dalle ripetizioni."
      ],
      "nota": "Si usa spesso in contesti di manutenzione, selezione o revisione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Svuotare completamente il contenuto di qualcosa, soprattutto in modo rapido e totale.",
      "examples": [
        "Gli ospiti affamati hanno pulito il piatto di lasagne in pochi minuti.",
        "Quel giocatore d'azzardo è riuscito a pulire il banco in una sola serata."
      ],
      "nota": "Uso informale e spesso iperbolico, comune nel linguaggio familiare."
    },
    {
      "pos": "verbo riflessivo (pulirsi)",
      "definition": "Rimuovere lo sporco dal proprio corpo, in particolare dalle mani o dal viso.",
      "examples": [
        "Il bambino si è pulito le mani sul grembiule prima di sedersi a tavola.",
        "Dopo il lavoro in garage, è andato in bagno a pulirsi la faccia."
      ],
      "nota": null
    }
  ]
