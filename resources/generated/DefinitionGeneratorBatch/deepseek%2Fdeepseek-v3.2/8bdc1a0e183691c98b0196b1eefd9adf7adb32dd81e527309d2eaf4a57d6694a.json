  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo all'organizzazione e all'esercizio del potere in una società o all'attività di governo.",
      "examples": [
        "La riforma ha avuto importanti conseguenze politiche.",
        "Stiamo attraversando un periodo di grande instabilità politica."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che agisce o si muove con astuzia, calcolo e opportunismo, spesso mirando a un vantaggio personale.",
      "examples": [
        "La sua risposta fu molto politica, evitando di prendere una posizione netta.",
        "È un individuo estremamente politico in ogni sua mossa."
      ],
      "nota": "Uso figurato e spesso valutativo, che implica un giudizio negativo."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che svolge attività professionale nell'ambito della politica, tipicamente come membro di un partito o di un'assemblea elettiva.",
      "examples": [
        "Il politico ha tenuto un discorso in piazza.",
        "Molti cittadini non si fidano più dei politici."
      ],
      "nota": "Il femminile 'politica' è regolarmente usato per indicare una donna che svolge questa professione."
    }
  ]
