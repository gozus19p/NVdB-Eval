  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che offre condizioni piacevoli e agevoli, eliminando disagi o sforzi.",
      "examples": [
        "Ho trovato un hotel molto comodo vicino alla stazione.",
        "Le nuove sedie dell'ufficio sono davvero comode."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è a proprio agio, non imbarazzato o a disagio.",
      "examples": [
        "In sua presenza non mi sento mai del tutto comodo.",
        "Si comportava in modo troppo comodo per essere un ospite."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è conveniente o vantaggioso per la persona che ne parla.",
      "examples": [
        "Scegliere quel giorno sarebbe più comodo per i miei impegni.",
        "Una scusa comoda per evitare il lavoro."
      ],
      "nota": "Può avere una connotazione negativa di opportunismo o pigrizia."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Stanza in una casa destinata a servizi igienici.",
      "examples": [
        "Il comodo si trova alla fine del corridoio.",
        "Devo andare in comodo un attimo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione di agio, vantaggio o opportunità favorevole.",
      "examples": [
        "Ho preso il mio comodo per finire il lavoro.",
        "Trasferirsi ora sarebbe di grande comodo."
      ],
      "nota": "Spesso usato in espressioni fisse come 'prendersi il proprio comodo' o 'a comodo'."
    }
  ]
