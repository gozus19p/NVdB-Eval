  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha una temperatura elevata rispetto a un valore di riferimento considerato normale.",
      "examples": [
        "Oggi il caffè è troppo caldo per berlo.",
        "Dopo la corsa mi sento le mani calde."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a un clima o a un periodo caratterizzato da temperature elevate.",
      "examples": [
        "Siamo stati in Grecia durante i mesi più caldi.",
        "Il mese di luglio è stato insolitamente caldo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che trasmette cordialità, affetto o intensità emotiva.",
      "examples": [
        "La sua famiglia mi ha fatto un'accoglienza molto calda.",
        "Il pubblico ha riservato un applauso caldo al cantante."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di colore che tende al rosso, all'arancione o al giallo.",
      "examples": [
        "Ha scelto una tonalità calda per le pareti del salotto.",
        "Il tramonto dipingeva il cielo di colori caldi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "L'elevata temperatura dell'aria o dell'ambiente.",
      "examples": [
        "Il caldo di agosto mi fa venire il mal di testa.",
        "Non riesco a dormire a causa di questo caldo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La sensazione fisica prodotta da una temperatura elevata.",
      "examples": [
        "Ho chiuso la giacca perché non sentivo più il caldo.",
        "Il bagno turco provoca un caldo intenso ma benefico."
      ],
      "nota": null
    }
  ]
