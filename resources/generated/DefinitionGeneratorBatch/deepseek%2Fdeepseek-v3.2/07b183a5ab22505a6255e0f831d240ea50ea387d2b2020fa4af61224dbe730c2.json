  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Fratello di uno dei genitori o, più in generale, parente di grado analogo.",
      "examples": [
        "Mio zio Mario viene a cena stasera.",
        "Lo zio di Carlo è il suo tutore legale."
      ],
      "nota": "Il termine può essere usato anche per riferirsi ad un coniuge di una zia, pur non essendo fratello di un genitore, in un'accezione estesa per consanguineità."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Uomo adulto, spesso non parente, usato come appellativo familiare o amichevole, talvolta con connotazione di rispetto o confidenza.",
      "examples": [
        "'Zio, mi presti la bicicletta?', chiese il ragazzino al vicino.",
        "Salve, zio! Come sta la famiglia?"
      ],
      "nota": "Utilizzo colloquiale tipico di alcune regioni o in contesti informali."
    }
