  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Struttura specializzata di un organismo, composta di tessuti diversi, che svolge una o più funzioni fisiologiche specifiche.",
      "examples": [
        "Il cuore è un organo vitale per la circolazione del sangue.",
        "Un'alimentazione sana è importante per la salute di tutti gli organi interni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Mezzo di diffusione ufficiale o periodico di un'istituzione, un partito o un'associazione.",
      "examples": [
        "Quel giornale è l'organo di stampa del sindacato.",
        "Il bollettino comunale è l'organo ufficiale per le comunicazioni ai cittadini."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Agenzia, ente o struttura che svolge una funzione specifica all'interno di un'organizzazione più ampia.",
      "examples": [
        "Il consiglio di amministrazione è l'organo deliberativo della società.",
        "Il Parlamento è l'organo legislativo dello Stato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Strumento musicale a tastiera che produce suoni facendo vibrare l'aria attraverso canne di diversa lunghezza, azionato da una consolle e spesso installato stabilmente in edifici.",
      "examples": [
        "Durante la messa si è eseguita una sonata per organo.",
        "Il grande organo della cattedrale ha un suono maestoso."
      ],
      "nota": null
    }
