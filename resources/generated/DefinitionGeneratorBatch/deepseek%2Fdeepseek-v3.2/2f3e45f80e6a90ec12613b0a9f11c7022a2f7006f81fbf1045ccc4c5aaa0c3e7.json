  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi con rapidità da un luogo o da una situazione percepita come pericolosa, spiacevole o indesiderata.",
      "examples": [
        "I prigionieri sono riusciti a fuggire dal carcere durante la notte.",
        "Al sentire lo sparo, la folla iniziò a fuggire in preda al panico."
      ],
      "nota": "Sinonimo di scappare. Implica un moto da un punto verso l'esterno o la lontananza."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Sottrarsi, deliberatamente o meno, a qualcosa di fisicamente o psicologicamente avverso.",
      "examples": [
        "Cerca di fuggire dalle proprie responsabilità.",
        "Il suo sguardo sembrava voler fuggire dalla realtà."
      ],
      "nota": "Uso figurato; il complemento è spesso introdotto da 'da'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Dirigersi rapidamente altrove, scorrere via.",
      "examples": [
        "Il tempo sembra fuggire quando ci si diverte.",
        "Vidi un'ombra fuggire lungo il muro."
      ],
      "nota": "Uso esteso, spesso riferito a entità astratte (come il tempo) o a movimenti rapidi e fugaci."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Evitare, scansare qualcosa o qualcuno.",
      "examples": [
        "Fuggi gli sguardi dei curiosi.",
        "È un argomento che cerca sempre di fuggire."
      ],
      "nota": "Accettato nell'uso, anche se meno frequente della costruzione intransitiva con 'da'. Sinonimo di evitare, eludere."
    }
  ]
}