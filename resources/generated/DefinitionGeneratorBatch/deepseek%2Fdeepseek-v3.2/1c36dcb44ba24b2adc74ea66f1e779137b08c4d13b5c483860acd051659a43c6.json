  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Cittadino degli Stati Uniti d'America.",
      "examples": [
        "L'americano che ho incontrato a Roma parlava un buon italiano.",
        "Gli americani sono molto legati alla festa del Thanksgiving."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Cittadina degli Stati Uniti d'America.",
      "examples": [
        "L'americana che mi ha aiutato era molto gentile.",
        "Molte americane seguono con interesse le elezioni presidenziali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Bevanda preparata con un caffè espresso e acqua calda, che diluisce il caffè rendendolo simile per volume e forza a un caffè filtrato.",
      "examples": [
        "Al bar ho ordinato un americano perché preferisco un caffè più lungo.",
        "In Italia l'americano è meno popolare del caffè espresso."
      ],
      "nota": "Il termine può indicare anche la ricetta stessa (ad esempio, 'preparare un americano')."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo agli Stati Uniti d'America, alla loro cultura, lingua o caratteristiche.",
      "examples": [
        "Ha un accento americano molto marcato.",
        "Il film offre una prospettiva americana sulla storia."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce al continente americano nel suo complesso (Nord, Centro e Sud America).",
      "examples": [
        "La fauna americana include specie come il condor e il giaguaro.",
        "Studia le lingue americane precolombiane."
      ],
      "nota": "In questo senso più ampio e geografico, l'uso può generare ambiguità; spesso il contesto chiarisce se ci si riferisce agli USA o al continente."
    }
  ]
