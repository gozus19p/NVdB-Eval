  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "In anatomia, ciascuna delle protuberanze ghiandolari mammarie presenti nel torace delle donne.",
      "examples": [
        "La nutrice offrì il suo seno al neonato per allattarlo.",
        "L'esame clinico si concentra sulla salute del seno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte interna, profonda e spesso protetta di qualcosa; recesso o cavità.",
      "examples": [
        "Siamo entrati nel seno della foresta, dove la luce del sole fatica a penetrare.",
        "Nel seno della famiglia si confidano i problemi più intimi."
      ],
      "nota": "Uso figurato, spesso riferito a luoghi naturali o gruppi sociali."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In geometria e trigonometria, rapporto tra il cateto opposto a un angolo e l'ipotenusa in un triangolo rettangolo.",
      "examples": [
        "Per risolvere il problema, devi calcolare il seno dell'angolo di 30 gradi.",
        "La funzione seno è fondamentale in analisi matematica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Concavità o avvallamento in una superficie o un oggetto.",
      "examples": [
        "La barca trovò riparo nel seno della baia durante la tempesta.",
        "Il tavolo ha un leggero seno al centro dovuto all'usura."
      ],
      "nota": "Significato affine al senso 2, ma con applicazione più concreta a forme e oggetti."
    }
  ]
