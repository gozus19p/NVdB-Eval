  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Insieme di tendenze prevalenti nel campo dell'abbigliamento e dell'estetica in un dato momento e luogo, spesso proposte dall'industria e seguita dal pubblico.",
      "examples": [
        "La moda primavera-estate propone colori vivaci e tessuti leggeri.",
        "Le sue scelte nel vestire sono sempre allineate con le ultime tendenze della moda."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Tendenza, costume o comportamento diffuso e temporaneamente popolare in un ambito specifico della società.",
      "examples": [
        "La moda dei tatuaggi ha avuto una grande espansione negli ultimi vent'anni.",
        "C'è una moda per i viaggi in destinazioni poco conosciute."
      ],
      "nota": "Il senso si estende a settori diversi dall'abbigliamento, come gli hobby, il linguaggio o il consumo."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Attività, settore industriale e professionale che si occupa della progettazione, produzione e commercializzazione di capi di abbigliamento e accessori.",
      "examples": [
        "Ha studiato design e ora lavora nel mondo della moda.",
        "Milano è un'importante capitale internazionale della moda."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile (locuzione)",
      "definition": "Essere in auge, essere popolare o attuale in un determinato periodo.",
      "examples": [
        "I pantaloni a zampa d'elefante erano di moda negli anni Settanta.",
        "Oggi sono di moda le serie televisive nordiche."
      ],
      "nota": "Viene tipicamente usato nelle espressioni 'essere di moda' o 'andare di moda'."
    }
  ]
