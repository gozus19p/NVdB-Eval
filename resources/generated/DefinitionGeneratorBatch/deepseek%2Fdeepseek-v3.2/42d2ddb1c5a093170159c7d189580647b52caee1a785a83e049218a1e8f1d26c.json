  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Edificio o complesso di edifici destinato alla raccolta, conservazione ed esposizione pubblica di opere d'arte, reperti storici, scientifici o collezioni di particolare valore culturale.",
      "examples": [
        "Il museo archeologico conserva i resti dell'antica civiltà etrusca.",
        "Visiteremo il museo della scienza durante la gita scolastica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Istituzione permanente, senza scopo di lucro, al servizio della società, che acquisisce, conserva, studia, comunica ed espone il patrimonio materiale e immateriale dell'umanità e del suo ambiente.",
      "examples": [
        "Il nuovo museo ha un importante ruolo educativo per la comunità.",
        "Lavorare in quel museo significa dedicarsi alla ricerca e alla divulgazione."
      ],
      "nota": "Questa accezione pone l'accento sulla funzione istituzionale e sociale dell'ente, non solo sull'edificio fisico."
    }
  ]
