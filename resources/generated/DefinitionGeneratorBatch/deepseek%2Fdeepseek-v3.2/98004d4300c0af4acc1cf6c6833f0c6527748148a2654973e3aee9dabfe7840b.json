  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Arma da fuoco portatile di piccole dimensioni, destinata all'uso con una sola mano.",
      "examples": [
        "Il poliziotto estrasse la pistola dalla fondina.",
        "La collezione comprende pistole d'epoca in perfetto stato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Attrezzo manuale che, premendo un grilletto, spruzza un materiale fluido, tipicamente vernice o colla.",
      "examples": [
        "Ho usato la pistola per verniciare la ringhiera.",
        "Prima di sigillare la scatola, applica il silicone con la pistola."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce a un tipo di caffè espresso preparato velocemente e servito in piccola quantità.",
      "examples": [
        "Preferisco un caffè pistola a quello lungo.",
        "Al bar, per svegliarmi, ordino sempre un caffè pistola."
      ],
      "nota": "Uso prevalentemente in espressioni fisse come 'caffè pistola'."
    }
