  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Esporre verbalmente, con tono di insoddisfazione o sofferenza, un disagio, una situazione negativa o un torto subito.",
      "examples": [
        "Il cliente ha lamentato il ritardo nella consegna del pacco.",
        "Molti residenti lamentano la mancanza di parcheggi nel quartiere."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (lamentarsi)",
      "definition": "Esprimere verbalmente e ripetutamente la propria insoddisfazione, malessere o disappunto.",
      "examples": [
        "Mia nonna si lamenta spesso del freddo.",
        "Si è lamentato con il capo per l'orario di lavoro."
      ],
      "nota": "Questa forma è di uso molto più frequente rispetto al verbo transitivo diretto."
    }
  ]
