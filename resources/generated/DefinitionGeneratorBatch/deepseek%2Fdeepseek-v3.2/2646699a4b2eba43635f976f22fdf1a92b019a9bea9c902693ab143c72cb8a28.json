  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Sensazione di sofferenza e malessere dell'animo causata da un danno, una disgrazia o un rammarico.",
      "examples": [
        "Prova una profonda pena per la perdita del suo amico.",
        "Le sue parole mi hanno causato molta pena."
