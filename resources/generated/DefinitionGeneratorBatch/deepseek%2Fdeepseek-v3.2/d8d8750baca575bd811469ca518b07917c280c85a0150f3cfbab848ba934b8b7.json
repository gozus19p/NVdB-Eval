  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ritenere che un'affermazione, un fatto o una condizione siano veri o veritieri.",
      "examples": [
        "Non so perché, ma credo ogni parola che dice.",
        "La giuria ha dovuto credere la testimonianza dell'unico testimone oculare."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo / intransitivo (seguito dalla preposizione 'in')",
      "definition": "Nutrire fede, avere fiducia nella verità o nell'esistenza di qualcosa, specialmente di carattere religioso, ideologico o astratto.",
      "examples": [
        "Molte persone credono in un destino già scritto.",
        "È un uomo che crede fermamente nella giustizia."
      ],
      "nota": "Nel primo esempio 'credere' è intransitivo seguito da complemento; nel secondo è usato transitivamente con 'credere qualcosa a/in qualcuno' implicito."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere stima e fiducia nelle qualità o nella lealtà di una persona.",
      "examples": [
        "In questo momento difficile, ho bisogno di qualcuno in cui credere.",
        "Il manager crede molto nelle capacità dei suoi giovani giocatori."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (uso impersonale, spesso alla 3a persona singolare)",
      "definition": "Essere opinione diffusa o convinzione comune.",
      "examples": [
        "Si crede che l'abitudine di leggere ad alta voce ai bambini favorisca lo sviluppo del linguaggio.",
        "Una volta si credeva che la Terra fosse piatta."
      ],
      "nota": "Comunemente costruito con 'si' impersonale seguito da una proposizione completiva."
    }
  ]
