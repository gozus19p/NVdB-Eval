  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Periodo di tempo precedente al momento presente.",
      "examples": [
        "Il passato a volte ci sembra più luminoso del presente.",
        "Dai racconti dei nonni si può conoscere il passato."
      ],
      "nota": "Si contrappone a presente e futuro."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a un tempo precedente al momento attuale.",
      "examples": [
        "Nel corso passato ho avuto un ottimo professore.",
        "Le edizioni passate del festival si tenevano in centro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Terminato, non più attuale o in vigore.",
      "examples": [
        "Il pericolo è ormai passato.",
        "Quella moda è completamente passata."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "In riferimento a una persona, che ha superato un esame, una prova o un concorso.",
      "examples": [
        "Sono passato alla seconda fase del concorso.",
        "È stato l'unico passato all'orale."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è stato segnato da un'esperienza vissuta.",
      "examples": [
        "È un uomo dalla vita molto passata.",
        "Ha un viso passato, segnato dalle preoccupazioni."
      ],
      "nota": null
    },
    {
      "pos": "participio passato",
      "definition": "Forma verbale non finita che esprime un'azione compiuta.",
      "examples": [
        "Avendo finito il lavoro, si è concesso una pausa.",
        "Il libro, letto in una notte, gli è piaciuto molto."
      ],
      "nota": "Il termine è usato anche come categoria grammaticale per indicare questa forma verbale."
    }
  ]
