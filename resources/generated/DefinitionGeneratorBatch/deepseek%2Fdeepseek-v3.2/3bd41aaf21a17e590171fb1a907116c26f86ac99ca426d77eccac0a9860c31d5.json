  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che condivide un'attività, una situazione o un percorso con un'altra.",
      "examples": [
        "Il mio compagno di viaggio mi ha raccontato storie incredibili.",
        "Hanno scelto un nuovo compagno di squadra per la stagione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona con cui si intrattiene una relazione sentimentale stabile senza essere formalmente sposati.",
      "examples": [
        "Il mio compagno ed io stiamo pensando di comprare casa.",
        "Da anni vive con il suo compagno."
      ],
      "nota": "Il femminile è 'compagna'. Nel linguaggio contemporaneo, il termine è usato sia per relazioni eterosessuali che omosessuali."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Membro di un'organizzazione politica o sindacale, specialmente in contesti di sinistra.",
      "examples": [
        "I compagni della sezione hanno organizzato una riunione.",
        "Durante il congresso, i compagni hanno discusso la nuova linea."
      ],
      "nota": "Il termine è storicamente e tipicamente associato a partiti e movimenti di ispirazione socialista o comunista."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Termine di cortesia usato per rivolgersi a un uomo in modo amichevole e informale.",
      "examples": [
        "'Scusa, compagno, sai che ore sono?', chiese l'uomo alla fermata.",
        "'Compagni, vi invito a fare silenzio', disse l'oratore."
      ],
      "nota": "Questo uso, un tempo più comune, è oggi percepito come un po' datato o di registro colloquiale specifico."
    }
  ]
