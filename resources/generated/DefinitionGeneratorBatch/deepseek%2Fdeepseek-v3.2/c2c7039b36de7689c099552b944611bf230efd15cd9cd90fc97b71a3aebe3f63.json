  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non muta di posizione o condizione; stabile, permanente.",
      "examples": [
        "Il tavolo è fisso al pavito e non si può spostare.",
        "Ha un lavoro fisso presso un'azienda locale."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che rimane concentrato in modo intenso su qualcosa o qualcuno.",
      "examples": [
        "Mi guardava con uno sguardo fisso e inquietante.",
        "La sua mente era fissa sul problema da risolvere."
      ],
      "nota": "Spesso si usa per lo sguardo o l'attenzione."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Apparecchio telefonico collegato alla rete via cavo, non mobile.",
      "examples": [
        "Chiamami al fisso, il cellulare non prende qui.",
        "Abbiamo ancora il vecchio fisso installato in corridoio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Cosa che si ripete sempre nello stesso modo o nello stesso momento.",
      "examples": [
        "La cena è un fisso alle otto in punto.",
        "La sua partita a carte è un fisso del giovedì sera."
      ],
      "nota": "Spesso riferito a un'abitudine o un appuntamento ricorrente."
    }
  ]
