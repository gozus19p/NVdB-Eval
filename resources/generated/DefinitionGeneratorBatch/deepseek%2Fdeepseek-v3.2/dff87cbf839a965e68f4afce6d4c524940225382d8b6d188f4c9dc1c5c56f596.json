  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Movimento del corpo, in particolare del braccio o della mano, con cui si esprime un'intenzione, un sentimento o si accompagna la comunicazione verbale.",
      "examples": [
        "Con un gesto della mano, indicò la direzione da seguire.",
        "Fece un gesto di disapprovazione scrollando le spalle."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Atto o comportamento concreto che manifesta un sentimento o un atteggiamento, spesso di generosità o altruismo.",
      "examples": [
        "Il suo gesto di donare tutti i risparmi è stato molto apprezzato.",
        "Fu un bel gesto offrirsi di aiutarla nel momento del bisogno."
      ],
      "nota": "In questo senso, il termine assume una connotazione positiva e valutativa, riferendosi a un'azione significativa oltre il suo aspetto fisico."
    }
