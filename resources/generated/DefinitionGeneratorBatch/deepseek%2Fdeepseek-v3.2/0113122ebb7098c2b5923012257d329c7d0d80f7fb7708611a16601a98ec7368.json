  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Porre un oggetto in contatto con una superficie e esercitare una pressione muovendolo per strofinare, pulire o asciugare.",
      "examples": [
        "Prima di servire, ricordati di fregare il bicchiere con un panno pulito.",
        "Dopo aver mangiato, il bambino si è fregato le mani sulla maglietta."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Infrangere una regola o una legge, specialmente in modo non grave o in contesti informali.",
      "examples": [
        "Se non parcheggi nelle strisce, rischi di fregare il codice della strada.",
        "Questa volta ha fregato il regolamento, ma non è stato punito."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Derubare qualcuno o sottrargli qualcosa in modo astuto o ingannevole.",
      "examples": [
        "Al mercato hanno cercato di fregarmi con il resto.",
        "Quel truffatore è riuscito a fregare i risparmi a molti pensionati."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ingannare o trarre in inganno una persona.",
      "examples": [
        "Con quella scusa banale, pensava davvero di fregarmi?",
        "Mi hanno fregato facendomi credere che l'appuntamento fosse annullato."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo/riflessivo (slang)",
      "definition": "Procurare un danno, un'inconvenienza o una situazione spiacevole a qualcuno o a sé stessi.",
      "examples": [
        "La pioggia improvvisa ci ha fregato tutti i piani per il picnic.",
        "Se esci senza giacca con questo freddo, ti fregherai da solo."
      ],
      "nota": "Usato prevalentemente in registri colloquiali."
    }
  ]
