  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Trasferire la proprietà di un bene o di un servizio a un'altra persona in cambio di denaro.",
      "examples": [
        "Hanno deciso di vendere la casa per trasferirsi in campagna.",
        "La pasticceria vende dolci tradizionali fatti in casa."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rinunciare o sacrificare un principio, un'opportunità o la propria dignità in cambio di un vantaggio personale, spesso materiale.",
      "examples": [
        "Purtroppo, ha preferito vendere i suoi ideali pur di fare carriera.",
        "Non vendere il tuo talento per un lavoro che non ti appassiona."
      ],
      "nota": "Uso figurato e con connotazione spesso negativa o di biasimo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Promuovere o presentare in modo convincente e attraente un'idea, un prodotto o se stessi per ottenere consenso o successo.",
      "examples": [
        "Il candidato ha saputo vendere molto bene il suo programma agli elettori.",
        "L'allenatore deve riuscire a vendere la sua strategia alla squadra."
      ],
      "nota": "Uso figurato del linguaggio del marketing e della persuasione, non necessariamente negativo."
    },
    {
      "pos": "verbo intransitivo pronominale (vendere bene/male)",
      "definition": "Essere acquistato con una certa frequenza o successo dal mercato.",
      "examples": [
        "Quel modello di smartphone vende ancora molto bene.",
        "I suoi libri non vendono più come una volta."
      ],
      "nota": "Costruzione impersonale o con soggetto generico (il prodotto)."
    }
  ]
