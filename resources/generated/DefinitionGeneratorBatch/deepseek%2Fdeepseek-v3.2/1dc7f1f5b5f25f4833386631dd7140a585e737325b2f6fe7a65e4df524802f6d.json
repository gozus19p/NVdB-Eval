  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Mettere qualcosa nelle mani di una persona destinataria, con l'intenzione di trasferirne la disponibilità o di adempiere a un incarico.",
      "examples": [
        "Devo consegnare il pacco al portiere dell'edificio.",
        "L'assistente ha consegnato il rapporto direttamente al dirigente."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Cedere volontariamente qualcuno o sé stessi all'autorità costituita o a un potere superiore.",
      "examples": [
        "I banditi hanno deciso di consegnarsi alla polizia.",
        "Il criminale fu consegnato dalle forze dell'ordine alla giustizia."
      ],
      "nota": "Può essere utilizzato sia con complemento oggetto rappresentante la persona ceduta (forma attiva), sia in forma pronominale (consegnarsi) per indicare l'azione del soggetto che si cede volontariamente."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Portare qualcosa a un luogo designato, tipicamente come parte di un servizio di distribuzione.",
      "examples": [
        "Il corriere consegna la posta ogni mattina.",
        "Il ristorante consegna a domicilio entro un raggio di cinque chilometri."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Affidare completamente qualcuno o qualcosa a qualcun altro, spesso con connotazione di abbandono o rassegnazione.",
      "examples": [
        "Si è consegnato al sonno dopo una lunga giornata di lavoro.",
        "Consegnò il suo destino nelle mani del fato."
      ],
      "nota": null
    }
  ]
