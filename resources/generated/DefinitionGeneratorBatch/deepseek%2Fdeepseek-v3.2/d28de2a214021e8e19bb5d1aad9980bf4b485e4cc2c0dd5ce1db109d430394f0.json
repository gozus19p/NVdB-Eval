  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Pezzo di metallo, carta o materiale analogo, di forma, peso e valore stabilito per legge, usato come mezzo di scambio in un sistema economico.",
      "examples": [
        "La moneta da due euro è più pesante di quella da un euro.",
        "Per pagare il parcheggio serve moneta spicciola."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Unità di valuta ufficiale di uno Stato o di un'area economica.",
      "examples": [
        "L'euro è la moneta comune di molti paesi europei.",
        "Durante il viaggio bisogna cambiare la moneta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Denaro in forma di specie metallica, in contrapposizione alla cartamoneta.",
      "examples": [
        "Preferisco portare con me della moneta per le piccole spese.",
        "Il distributore automatico accetta solo moneta."
      ],
      "nota": "In questo senso, il termine è spesso usato nel linguaggio comune per indicare specificamente le monete metalliche."
    }
  ]
