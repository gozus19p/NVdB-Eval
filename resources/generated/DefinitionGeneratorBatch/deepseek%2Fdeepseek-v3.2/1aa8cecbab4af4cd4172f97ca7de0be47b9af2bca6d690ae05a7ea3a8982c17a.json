  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Separare in due o più parti utilizzando un utensile affilato, applicando forza.",
      "examples": [
        "Il panettiere tagliò il pane fresco con un coltello a serramanico.",
        "Per il progetto ho dovuto tagliare una lastra di compensato."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ridurre la lunghezza di qualcosa, tipicamente capelli, unghie, erba o tessuto.",
      "examples": [
        "Devo andare dal parrucchiere a farmi tagliare i capelli.",
        "Tagliò l'erba del prato domenica mattina."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere il flusso o la fornitura di qualcosa.",
      "examples": [
        "Per un guasto hanno tagliato l'acqua in tutto il quartiere.",
        "L'azienda ha deciso di tagliare i fondi per quel progetto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere una parte da un testo, un film o un discorso.",
      "examples": [
        "Il regista ha tagliato diverse scene nella versione finale del film.",
        "Il redattore mi ha consigliato di tagliare due paragrafi dell'articolo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Diminuire in modo significativo una quantità, un prezzo o un valore.",
      "examples": [
        "Il negozio taglia i prezzi di tutti i capi invernali.",
        "Il governo promette di tagliare le tasse per le famiglie."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "In ambito sportivo, cambiare bruscamente direzione durante una corsa per superare un avversario.",
      "examples": [
        "L'ala destra tagliò verso l'interno e calciò in porta.",
        "Per evitare il placcaggio, il giocatore tagliò sul lato sinistro."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo/riflessivo (tagliarsi)",
      "definition": "Prodursi accidentalmente una ferita con un oggetto affilato.",
      "examples": [
        "Mi sono tagliato il dito mentre affettavo le verdure.",
        "Attenzione al vetro rotto, potresti tagliarti."
      ],
      "nota": null
    }
