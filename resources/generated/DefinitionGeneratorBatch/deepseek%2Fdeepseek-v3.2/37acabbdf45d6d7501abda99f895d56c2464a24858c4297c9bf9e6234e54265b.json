  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere volontariamente e definitivamente un'azione o un'attività che si stava svolgendo.",
      "examples": [
        "Ho deciso di smettere di fumare per motivi di salute.",
        "Dopo trent'anni, ha smesso di lavorare ed è andato in pensione."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (aus. avere)",
      "definition": "Cessare di fare qualcosa, terminare un'azione.",
      "examples": [
        "Smetti di fare rumore, sto cercando di concentrarmi.",
        "Ha smesso di piovere poco fa."
      ],
      "nota": "È usato frequentemente con la preposizione 'di' seguita da un verbo all'infinito per indicare l'azione interrotta."
    },
    {
      "pos": "verbo intransitivo (aus. avere) - uso informale/idiomatico",
      "definition": "Arrestare qualcuno, specialmente nell'ambito sportivo o in situazioni di confronto.",
      "examples": [
        "Il difensore è riuscito a smettere l'attaccante avversario prima che potesse tirare in porta.",
        "È un avvocato così bravo che in tribunale smette tutti."
      ],
      "nota": "Utilizzo figurato e colloquiale, spesso in contesti agonistici o competitivi."
    }
  ]
