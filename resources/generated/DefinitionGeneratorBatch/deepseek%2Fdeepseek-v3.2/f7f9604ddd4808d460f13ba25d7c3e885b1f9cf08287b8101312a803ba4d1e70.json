  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione stabile di un corpo fisico, in cui le forze agenti su di esso si compensano, impedendo cadute o rotazioni involontarie.",
      "examples": [
        "Il ginnasta mantenne un perfetto equilibrio sul trapezio.",
        "La scultura sembra sfidare le leggi della fisica, ma è in realtà in equilibrio instabile."
      ],
      "nota": "In questo senso, l'equilibrio può essere classificato come stabile, instabile o indifferente, a seconda della reazione del corpo a una piccola perturbazione."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione di armonia, proporzione e stabilità all'interno di un sistema complesso, come un organismo, una relazione o una situazione.",
      "examples": [
        "È difficile trovare un equilibrio tra lavoro e vita privata.",
        "L'ecosistema del parco è mantenuto in un delicato equilibrio."
      ],
      "nota": "Questo senso figurato è estremamente comune e si applica a contesti psicologici, sociali, biologici ed economici."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Stato psicofisico di benessere, calma e lucidità mentale, privo di eccessi emotivi.",
      "examples": [
        "Dopo la meditazione, ha ritrovato il suo equilibrio interiore.",
        "Perdette completamente l'equilibrio quando ricevette la notizia."
      ],
      "nota": "Spesso usato in espressioni come 'perdere l'equilibrio' o 'ritrovare l'equilibrio' in senso metaforico."
    }
  ]
