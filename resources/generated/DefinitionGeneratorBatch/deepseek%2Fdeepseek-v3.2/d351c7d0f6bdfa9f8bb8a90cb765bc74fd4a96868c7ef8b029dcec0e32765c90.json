    {
      "pos": "sostantivo maschile",
      "definition": "Sentimento di attenzione e attrazione verso qualcuno o qualcosa, che spinge a prestare attenzione, a conoscere o a partecipare.",
      "examples": [
        "Ha sempre mostrato un grande interesse per la storia dell'arte.",
        "La presentazione ha suscitato molto interesse nella platea."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Utilità, beneficio o vantaggio che una persona o un ente può trarre da una situazione o un'azione.",
      "examples": [
        "Ha agito solo nel suo esclusivo interesse personale.",
        "La proposta risponde agli interessi dell'azienda."
      ],
      "nota": "Spesso utilizzato al plurale. Comprende anche il concetto di interesse pubblico o collettivo."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Compenso in denaro, generalmente espresso in percentuale, che si paga o si riceve per l'uso di un capitale prestato.",
      "examples": [
        "Il conto di risparmio offre un interesse annuale del 2%.",
        "Il mutuo ha un tasso di interesse molto vantaggioso."
      ],
      "nota": "Termine centrale nel linguaggio economico-finanziario."
    }
