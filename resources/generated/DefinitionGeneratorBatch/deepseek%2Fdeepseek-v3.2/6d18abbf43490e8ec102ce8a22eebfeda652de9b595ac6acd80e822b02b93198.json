  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Individuo riconosciuto dalla Chiesa come modello di virtù e intercessore presso Dio.",
      "examples": [
        "Il santo patrono della città viene festeggiato a settembre.",
        "Mi piace leggere le biografie dei santi medievali."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è stato canonizzato o considerato degno di culto per la sua vita esemplare.",
      "examples": [
        "Venerano il santo uomo da secoli.",
        "La santa vergine è oggetto di particolare devozione."
      ],
      "nota": "Precede il nome proprio, di norma maiuscolo, nel titolo di una persona canonizzata."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è moralmente irreprensibile o dotato di grande bontà.",
      "examples": [
        "Ha una pazienza da santo con i bambini.",
        "Non fare la santa, sappiamo che anche tu sbagli."
      ],
      "nota": "Usato spesso con intento ironico o iperbolico nel linguaggio comune."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è inviolabile, sacro o meritevole di rispetto assoluto.",
      "examples": [
        "Per lui il riposo domenicale è un santo diritto.",
        "La libertà di pensiero è un principio santo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Utilizzato in espressioni esclamative per enfatizzare sorpresa, sconcerto o protesta.",
      "examples": [
        "Santo cielo, che disordine in questa stanza!",
        "Santo Dio, non credevo potesse succedere."
      ],
      "nota": "Ricorre in formule fisse come interiezione attenuata."
    }
  ]
