  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un intervento chirurgico su una persona o una parte del corpo.",
      "examples": [
        "Il chirurgo decise di operare il paziente immediatamente.",
        "Devo operare l'occhio sinistro per rimuovere la cataratta."
      ],
      "nota": "Il complemento oggetto può essere la persona (il paziente) o la parte specifica del corpo (l'occhio)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Mettere in atto, realizzare un'azione complessa o un piano.",
      "examples": [
        "La polizia sta operando un vasto controllo nel quartiere.",
        "L'azienda ha operato importanti cambiamenti nella struttura organizzativa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Agire, svolgere la propria attività in un determinato campo o settore.",
      "examples": [
        "L'associazione opera nel settore dell'assistenza ai senza tetto.",
        "Il nuovo impianto industriale inizierà a operare il prossimo mese."
      ],
      "nota": "Spesso seguito da complementi introdotti da 'in', 'nel', 'per' che specificano l'ambito dell'azione."
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Produrre un effetto o un risultato.",
      "examples": [
        "La nuova legge opera a favore dei consumatori.",
        "Le condizioni atmosferiche hanno operato un cambiamento radicale nel paesaggio."
      ],
      "nota": "In questo senso, può anche essere considerato un uso causativo intransitivo (produrre un cambiamento)."
    }
  ]
