  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Azione violenta di un corpo che ne urta un altro, con conseguente contatto rapido e percussione.",
      "examples": [
        "Il vento ha sbatacchiato la porta con un colpo secco.",
        "Ha dato un colpo sulla spalla per attirare la sua attenzione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Improvviso evento dannoso o traumatico, sia fisico che psicologico.",
      "examples": [
        "La perdita del lavoro è stato un duro colpo per la famiglia.",
        "La notizia della sconfitta ha rappresentato un colpo per il morale della squadra."
      ],
      "nota": "Uso figurato, spesso associato a qualcosa di negativo e inaspettato."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Disparo di un'arma da fuoco.",
      "examples": [
        "Si è sentito un colpo di fucile provenire dal bosco.",
        "I carabinieri hanno fatto un colpo di avvertimento in aria."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Azione improvvisa e spesso illegale, mirata a ottenere un profitto o un risultato eclatante, tipicamente nel crimine.",
      "examples": [
        "La banda ha organizzato un colpo alla banca.",
        "Il recupero della refurtiva è stato un colpo di scena per le indagini."
      ],
      "nota": "Senso spesso associato a 'colpo grosso' o a espressioni come 'colpo di scena'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Mossa o azione abile e decisiva, spesso inattesa, in una competizione o in un contesto specifico.",
      "examples": [
        "L'ha battuto con un colpo a sorpresa nel finale dell'incontro.",
        "Il suo nuovo romanzo è un vero colpo di genio."
      ],
      "nota": "Utilizzato in contesti sportivi, artistici o intellettuali."
    }
  ]
