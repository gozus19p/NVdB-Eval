  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non corrisponde alla realtà dei fatti o alla verità; contraffatto o artefatto.",
      "examples": [
        "Il testimone ha reso una dichiarazione falsa.",
        "Il quadro era un'imitazione falsa di un'opera famosa."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che mostra ipocrisia o manca di sincerità nelle parole, nei sentimenti o nell'atteggiamento.",
      "examples": [
        "Il suo sorriso mi è parso falso e studiato.",
        "Mi stancano le persone false che non dicono mai ciò che pensano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Affermazione, dichiarazione o documento che altera intenzionalmente la verità.",
      "examples": [
        "La perizia ha dimostrato che la firma sul contratto era un falso.",
        "Sono state smascherate diverse falsità nelle sue memorie."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Copia non autentica di un oggetto, presentata come originale.",
      "examples": [
        "Il gioiello venduto a caro prezzo si è rivelato un falso.",
        "Il museo ha ritirato l'esposizione dopo aver scoperto che si trattava di un falso."
      ],
      "nota": null
    }
