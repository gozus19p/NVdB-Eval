  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Composto di un'unica sostanza, non mescolato o contaminato da altri elementi.",
      "examples": [
        "Ho bevuto un succo di mela puro, senza additivi.",
        "L'aria in montagna è molto più pura di quella in città."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato da totale sincerità e libertà da intenzioni nascoste o secondi fini.",
      "examples": [
        "Il suo era un gesto di pura generosità.",
        "Li ha aiutati per puro spirito di amicizia."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Assoluto, completo, non attenuato o mitigato da altri fattori.",
      "examples": [
        "La sua reazione fu dettata dal puro istinto.",
        "Quello che hai detto è puro e semplice egoismo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di attività sessuale, specialmente riferito a un ideale di castità.",
      "examples": [
        "Secondo la tradizione, la fanciulla doveva mantenersi pura fino al matrimonio.",
        "Nella mitologia, la dea era spesso associata a immagini pure e incorrotte."
      ],
      "nota": "Questo senso ha una forte connotazione religiosa, letteraria o moralistica."
    }
  ]
