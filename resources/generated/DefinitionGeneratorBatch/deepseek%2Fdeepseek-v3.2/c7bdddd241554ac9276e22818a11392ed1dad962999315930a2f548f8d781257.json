  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che appartiene a un determinato Stato e gode dei diritti civili e politici riconosciuti dalla legge.",
      "examples": [
        "Ogni cittadino ha il dovere di pagare le tasse.",
        "La nuova Costituzione garantisce i diritti di tutti i cittadini."
      ],
      "nota": "Può essere specificato con complemento di specificazione (es. 'cittadino italiano')."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Abitante di una città, contrapposto a chi vive in campagna.",
      "examples": [
        "Il rumore del traffico è una costante nella vita del cittadino.",
        "Da quando si è trasferita in paese, rimpiange i servizi a cui era abituata da cittadina."
      ],
