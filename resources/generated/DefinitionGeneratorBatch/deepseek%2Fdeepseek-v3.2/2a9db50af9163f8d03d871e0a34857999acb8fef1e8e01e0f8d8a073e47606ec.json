  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Titolo di rispetto e cortesia rivolto a un uomo, spesso sostituito nelle forme di cortesia dai termini \"lei\" o \"voi\".",
      "examples": [
        "Scusi, signore, ha lasciato cadere il suo portafoglio.",
        "\"Buongiorno, signore, desidera?\", chiese il cameriere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona di elevata condizione sociale, spesso caratterizzata da agiatezza economica e potere.",
      "examples": [
        "Il signore del villaggio decise di finanziare la costruzione della nuova scuola.",
        "In quell'epoca, i signori locali avevano un'autorità quasi assoluta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Titolo di rispetto formale anteposto al cognome di un uomo.",
      "examples": [
        "Ho un appuntamento con il signor Rossi.",
        "La lettera era indirizzata al signore Mario Bianchi."
      ],
      "nota": "Spesso usato in forma abbreviata (sig., sig.re) nella corrispondenza scritta o in contesti formali."
    },
    {
      "pos": "sostantivo maschile (con iniziale maiuscola, spesso preceduto da articolo)",
      "definition": "Nella religione cristiana, termine che indica Dio.",
      "examples": [
        "I fedeli pregano il Signore ogni giorno.",
        "Credono che il Signore li abbia guidati in quel momento difficile."
      ],
      "nota": null
    }
