  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo alla meccanica, ovvero quella branca della fisica che studia il movimento e l'equilibrio dei corpi.",
      "examples": [
        "La forza è un concetto fondamentale per la spiegazione meccanica del moto.",
        "Il pendolo compie un movimento puramente meccanico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Operato o funzionante mediante un meccanismo, senza o con minimo intervento umano.",
      "examples": [
        "Il nuovo aspirapolvere ha una spazzola rotante con movimento meccanico.",
        "Per avviare l'orologio è sufficiente caricarlo manualmente; è un movimento meccanico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Ripetitivo, privo di spontaneità o riflessione, eseguito per abitudine o in modo automatico.",
      "examples": [
        "Dopo anni di lavoro, la sua firma era diventata un gesto meccanico.",
        "Ripeteva quelle frasi con un tono piatto e meccanico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona specializzata nella riparazione, manutenzione o costruzione di macchine, motori o veicoli.",
      "examples": [
        "Il meccanico mi ha riparato la frizione dell'auto in una giornata.",
        "Mio zio lavora come meccanico industriale in una grande fabbrica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Persona specializzata nella riparazione, manutenzione o costruzione di macchine, motori o veicoli.",
      "examples": [
        "È una delle poche meccaniche specializzate in motori a reazione.",
        "La nuova officina ha assunto una brava meccanica."
      ],
      "nota": "La forma femminile segue la stessa definizione semantica della forma maschile, differenziandosi solo per il genere grammaticale."
    }
  ]
