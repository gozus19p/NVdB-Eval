  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Capacità dell'intelletto umano di pensare, comprendere e formulare giudizi in modo logico.",
      "examples": [
        "La filosofia ha sempre celebrato il primato della ragione sulle passioni.",
        "In quella discussione, prevalse la voce della ragione."
      ],
      "nota": "Contrapposta spesso a termini come 'istinto', 'sentimento' o 'follia'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Causa, motivo o giustificazione per cui qualcosa accade o viene fatto.",
      "examples": [
        "Non c'è alcuna ragione valida per comportarsi così.",
        "La ragione del suo licenziamento non è stata mai chiarita."
      ],
      "nota": "Spesso usato in espressioni come 'per questa ragione', 'a ragione', 'senza ragione'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Correttezza logica o veridicità di un'affermazione, di un'opinione o di una posizione in una disputa.",
      "examples": [
        "In quel dibattito, dopo un'ora, era chiaro chi aveva ragione.",
        "Devi ammettere che, stavolta, ha ragione lui."
      ],
      "nota": "Usato prevalentemente nelle locuzioni 'avere ragione' e 'dare ragione'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Quota proporzionale di un intero, specialmente in contesti commerciali o legati a ripartizioni.",
      "examples": [
        "Ogni socio avrà una ragione di profitto corrispondente al proprio investimento.",
        "La legge stabilisce la ragione di eredità per i figli legittimi."
      ],
      "nota": null
    }
  ]
