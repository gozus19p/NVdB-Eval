  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo a uno dei colori primari dello spettro visibile, situato tra il verde e l'arancione.",
      "examples": [
        "Il sole tramontava tingendo il cielo di un colore giallo intenso.",
        "Ho comprato una maglietta gialla perché mi porta fortuna."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce a un genere narrativo o cinematografico incentrato sulla risoluzione di un mistero o di un delitto.",
      "examples": [
        "È un'appassionata di romanzi gialli e ne legge almeno uno al mese.",
        "In televisione stanno trasmettendo un film giallo molto avvincente."
      ],
      "nota": "Il termine deriva dal colore delle copertine di una collana popolare di narrativa poliziesca."
    },
    {
      "pos": "aggettivo",
      "definition": "Che denota allarme, cautela o un pericolo potenziale, spesso in contesti informativi o di segnaletica.",
      "examples": [
        "Il Ministero ha diramato un'allerta gialla per il maltempo in arrivo.",
        "La spia gialla sul cruscotto indica un malfunzionamento del motore."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce a prodotti o contenuti a sfondo erotico o pornografico.",
      "examples": [
        "Quel giornale pubblicava spesso racconti gialli nella sua rubrica.",
        "Negli anni '70 alcuni film furono etichettati come 'cinema giallo'."
      ],
      "nota": "Uso colloquiale e in parte storico, oggi meno frequente."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il colore corrispondente all'aggettivo omonimo.",
      "examples": [
        "Il giallo è il suo colore preferito.",
        "L'artista ha utilizzato un giallo molto acceso per il quadro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Opera narrativa o film appartenente al genere poliziesco.",
      "examples": [
        "Ho appena finito di leggere un giallo della Christie.",
        "Stasera in prima serata va in onda un giallo ambientato a Venezia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Fatto misterioso e inspiegabile, spesso di natura delittuosa, che suscita curiosità e interrogativi.",
      "examples": [
        "La scomparsa dell'oggetto prezioso è ancora un giallo per la polizia.",
        "I giornali hanno montato un vero giallo sulla vicenda finanziaria."
      ],
      "nota": null
    }
  ]
