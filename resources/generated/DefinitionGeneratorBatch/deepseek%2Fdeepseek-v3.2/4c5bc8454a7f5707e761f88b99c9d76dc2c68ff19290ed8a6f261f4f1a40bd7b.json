  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Entrare in contatto fisico o visivo con qualcuno o qualcosa mentre ci si muove in direzioni opposte o convergenti.",
      "examples": [
        "Sulla strada per il lavoro ho incontrato la mia vecchia insegnante.",
        "Il proiettile ha incontrato il bersaglio con precisione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rinvenire o imbattersi in qualcosa, spesso in modo inaspettato o mentre si cerca.",
      "examples": [
        "Durante le ricerche abbiamo incontrato numerosi ostacoli.",
        "Nel libro ho incontrato una frase che mi ha colpito molto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Provare o subire una determinata reazione, situazione o stato.",
      "examples": [
        "La sua proposta ha incontrato il favore di tutti.",
        "Il nuovo prodotto ha incontrato difficoltà sul mercato."
      ],
      "nota": "Questo senso si applica tipicamente a reazioni, consenso, opposizione o simili."
    },
    {
      "pos": "verbo riflessivo (reciproco)",
      "definition": "Vedere e parlare con qualcuno in un luogo e momento stabiliti.",
      "examples": [
        "Ci siamo incontrati al bar per un caffè.",
        "I due capi di stato si incontreranno domani per i negoziati."
      ],
      "nota": null
    }
  ]
