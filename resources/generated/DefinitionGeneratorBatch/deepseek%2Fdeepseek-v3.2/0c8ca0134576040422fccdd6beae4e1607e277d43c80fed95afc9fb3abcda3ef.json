  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Ciò che serve a raggiungere uno scopo o a compiere un'azione.",
      "examples": [
        "La bicicletta è il mio mezzo di trasporto preferito.",
        "La televisione è un potente mezzo di comunicazione."
      ],
      "nota": "Spesso usato in espressioni composte come 'mezzo di trasporto', 'mezzo di pagamento'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Punto intermedio tra due estremi o valore mediano.",
      "examples": [
        "Il giusto compromesso sta nel mezzo.",
        "La sua opinione è un mezzo tra l'approvazione e il rifiuto totale."
      ],
      "nota": "Frequentemente utilizzato in espressioni come 'trovare un mezzo', 'via di mezzo'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento in cui qualcosa esiste, si propaga o è immerso.",
      "examples": [
        "La luce si propaga nel mezzo del vuoto.",
        "L'acqua è il mezzo in cui vivono molti organismi."
      ],
      "nota": "Usato soprattutto in ambito scientifico (es. 'mezzo di coltura', 'mezzo materiale')."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Metà di un'unità o di una misura intera.",
      "examples": [
        "Ho mangiato mezzo chilo di ciliegie.",
        "Vuoi un mezzo litro di vino o uno intero?"
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Veicolo, in particolare autobus o tram di linea.",
      "examples": [
        "Prendo sempre il mezzo pubblico per andare a lavoro.",
        "Hanno affittato un mezzo per il trasloco."
      ],
      "nota": "Uso comune nel linguaggio colloquiale e amministrativo."
    },
    {
      "pos": "aggettivo",
      "definition": "Situato a metà tra due punti, gradi o condizioni.",
      "examples": [
        "Siamo a metà percorso, nel punto mezzo.",
        "Scegli un colore di tono mezzo tra il blu e il verde."
      ],
      "nota": "Può precedere il sostantivo ('il mezzo chilometro') o essere predicativo ('la strada è mezzo deserta')."
    },
    {
      "pos": "avverbio",
      "definition": "In parte, parzialmente, non del tutto.",
      "examples": [
        "La porta era mezzo aperta.",
        "Mi sentivo mezzo addormentato durante la riunione."
      ],
      "nota": "In questa accezione è invariabile e precede tipicamente un aggettivo o un participio."
    }
  ]
}