  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Separare elementi precedentemente uniti o attaccati, rimuovendo il mezzo che li tiene insieme.",
      "examples": [
        "Dovrò staccare il francobollo dall'angolo della busta.",
        "Il calore ha fatto staccare la colla e il pezzo si è staccato."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere il flusso o la fornitura di un servizio, in particolare quello elettrico o idrico.",
      "examples": [
        "L'azienda minaccia di staccare la luce se non paghiamo la bolletta.",
        "Hanno staccato il gas per lavori di manutenzione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Distaccare qualcuno dal suo ruolo, incarico o luogo di lavoro, solitamente per assegnarlo ad altro.",
      "examples": [
        "Il comando ha deciso di staccare due agenti per il servizio d'ordine.",
        "La multinazionale lo ha staccato dalla sede centrale per un progetto all'estero."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo/riflessivo",
      "definition": "Creare una distanza, fisica o metaforica, tra sé e qualcosa o qualcuno, prendendo le distanze.",
      "examples": [
        "In quell'ambiente tossico, è importante staccarsi dalle dinamiche negative.",
        "Il corridore è riuscito a staccare tutti gli avversari negli ultimi chilometri."
      ],
      "nota": "Nel senso riflessivo ('staccarsi da'), indica un allontanamento volontario o un distacco emotivo."
    },
    {
      "pos": "verbo intransitivo (informale)",
      "definition": "Concludere un'attività lavorativa, smettere di lavorare per quel giorno.",
      "examples": [
        "Oggi stacco alle sei, finalmente!",
        "A che ora stacchi di solito dal lavoro?"
      ],
      "nota": "Uso colloquiale molto comune nel linguaggio lavorativo."
    }
  ]
