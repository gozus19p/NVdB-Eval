    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sistema organizzato per effettuare lo spostamento collettivo di persone all'interno di un'area.",
      "examples": [
        "Il trasporto pubblico nella capitale è molto efficiente.",
        "La congestione del traffico è un grave problema per il trasporto urbano."
      ],
      "nota": "Usato spesso in contesti amministrativi o di pianificazione."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Veicolo o mezzo specifico utilizzato per lo spostamento.",
      "examples": [
        "L'ambulanza è un trasporto di emergenza.",
        "Per quel viaggio hanno noleggiato un trasporto privato."
      ],
      "nota": "Significato meno comune, spesso impiegato in linguaggio tecnico o burocratico."
