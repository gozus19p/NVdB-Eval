  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Riprendere possesso di qualcosa che era stato perso, smarrito o sottratto",
      "examples": [
        "Dopo lunghe ricerche, siamo riusciti a recuperare il portafoglio smarrito.",
        "La polizia ha recuperato tutti i gioielli rubati."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Riacquistare una condizione fisica, psicologica o di performance che era peggiorata",
      "examples": [
        "Dopo l'infortunio ha dovuto lavorare duramente per recuperare la forma.",
        "Ha bisogno di qualche giorno per recuperare le forze."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Porre rimedio a uno svantaggio, un ritardo o una situazione negativa per tornare in pari",
      "examples": [
        "La squadra è riuscita a recuperare due goal di svantaggio nel secondo tempo.",
        "Devo recuperare le lezioni perse durante la malattia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rendere nuovamente utilizzabile un materiale o un oggetto attraverso il riciclo o il riuso",
      "examples": [
        "L'azienda ha un sistema efficiente per recuperare la plastica dagli scarti di produzione.",
        "Recuperiamo i mobili vecchi restaurandoli."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Raccogliere e salvare dati o informazioni da una fonte o supporto",
      "examples": [
        "Il tecnico è riuscito a recuperare tutti i file dal disco danneggiato.",
        "Stiamo cercando di recuperare gli archivi storici della biblioteca."
      ],
      "nota": null
    }
  ]
