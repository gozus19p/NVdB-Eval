  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Periodo di tempo caratterizzato da eventi, idee o condizioni sociali particolari che lo rendono distinguibile.",
      "examples": [
        "L'epoca rinascimentale fu un momento di grande fermento artistico e scientifico.",
        "Viviamo in un'epoca di rapidi cambiamenti tecnologici."
      ],
      "nota": "Usato spesso con aggettivi qualificativi o specificatori per delimitare il periodo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Momento o fase precisa nella vita di una persona o nella storia di qualcosa.",
      "examples": [
        "Quella fu un'epoca difficile per la nostra famiglia.",
        "L'azienda sta attraversando un'epoca di ristrutturazione."
      ],
      "nota": "Può riferirsi a un periodo circoscritto e significativo in un contesto più personale o limitato."
    }
  ]
