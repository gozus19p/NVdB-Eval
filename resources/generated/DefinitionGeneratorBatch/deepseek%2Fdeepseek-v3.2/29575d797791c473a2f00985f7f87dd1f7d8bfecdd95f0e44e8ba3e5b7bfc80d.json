  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Sottrarsi alla presa, alla vista o al controllo di qualcuno o qualcosa, spesso con agilità o rapidità.",
      "examples": [
        "Il coniglio riuscì a sfuggire al falco con un balzo improvviso.",
        "Il prigioniero tentò di sfuggire alla sorveglianza durante la notte."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (impersonale con 'a')",
      "definition": "Non venire percepito o compreso da qualcuno.",
      "examples": [
        "Il significato più profondo di quella poesia mi sfugge.",
        "Mi sfugge il motivo per cui abbia preso quella decisione."
      ],
      "nota": "Usato tipicamente con i pronomi indiretti (mi, ti, gli, ci, vi)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Evitare di subire un evento negativo o una situazione spiacevole.",
      "examples": [
        "Sfuggì per miracolo all'incidente stradale.",
        "Grazie all'allarme, siamo riusciti a sfuggire l'incendio."
      ],
      "nota": null
    }
  ]
