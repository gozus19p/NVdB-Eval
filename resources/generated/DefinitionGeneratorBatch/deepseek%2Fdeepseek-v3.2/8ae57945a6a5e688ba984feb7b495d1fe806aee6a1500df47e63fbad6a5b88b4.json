  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Sostituire qualcosa o qualcuno con un altro elemento o persona.",
      "examples": [
        "Devo cambiare le lenzuola della camera da letto.",
        "L'allenatore ha deciso di cambiare due giocatori all'intervallo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Modificare le caratteristiche, lo stato o la natura di qualcosa.",
      "examples": [
        "Stiamo cercando di cambiare la nostra strategia di marketing.",
        "Quella esperienza mi ha cambiato la vita."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare 'essere')",
      "definition": "Diventare diverso, subire una trasformazione.",
      "examples": [
        "Il tempo sta cambiando, sembra che arrivi il brutto tempo.",
        "Il suo umore è cambiato improvvisamente dopo quella notizia."
      ],
      "nota": "In questo senso intransitivo richiede l'ausiliare 'essere'."
    },
    {
      "pos": "verbo transitivo/intransitivo",
      "definition": "Scambiare una somma di denaro o una merce con altre di valore equivalente.",
      "examples": [
        "Puoi cambiare questi euro in dollari alla banca?",
        "Dov'è il negozio più vicino per cambiare questa maglietta che non mi va?"
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare 'avere')",
      "definition": "Spostarsi passando da un mezzo di trasporto a un altro durante un viaggio.",
      "examples": [
        "Per arrivare a quel paese bisogna cambiare due volte.",
        "A Milano ho cambiato treno per proseguire verso Torino."
      ],
      "nota": "In questa accezione specifica l'ausiliare è 'avere'."
    }
  ]
