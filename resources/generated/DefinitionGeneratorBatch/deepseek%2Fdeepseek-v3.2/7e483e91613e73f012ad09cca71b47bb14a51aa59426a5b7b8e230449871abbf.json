  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Portare qualcosa a compimento, facendo sì che non continui più.",
      "examples": [
        "Dovremo terminare il lavoro entro domani.",
        "Ha terminato il discorso con un ringraziamento."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Giungere alla sua fine, cessare di esistere o di svolgersi.",
      "examples": [
        "La riunione è terminata alle sei.",
        "Il sentiero termina in una radura."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (con complemento)",
      "definition": "Concludersi con un certo esito o risultato.",
      "examples": [
        "La partita è terminata in parità.",
        "La loro discussione è terminata male."
      ],
      "nota": "Spesso seguito da complementi introdotti da 'con', 'in' o avverbi di modo."
    }
  ]
