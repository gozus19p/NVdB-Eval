  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Lasciare definitivamente o per un lungo periodo qualcuno o qualcosa, cessando di occuparsene o di rimanervi accanto.",
      "examples": [
        "Il cane ha abbandonato il cucciolo sul ciglio della strada.",
        "Ha deciso di abbandonare la carriera per dedicarsi alla famiglia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere un'attività, uno studio o un impegno prima del suo completamento naturale.",
      "examples": [
        "Dopo il primo anno, ha abbandonato gli studi universitari.",
        "Abbandonò il progetto quando i finanziamenti furono tagliati."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rinunciare a un'idea, a un'opinione o a uno stato d'animo, lasciandosi andare a un altro.",
      "examples": [
        "Finalmente abbandonò ogni speranza di riconciliazione.",
        "Abbandonò ogni cautela e si lanciò nell'avventura."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo/pronominale",
      "definition": "Lasciarsi andare completamente a un sentimento, a un'azione o a una condizione fisica.",
      "examples": [
        "Si abbandonò al pianto dopo la triste notizia.",
        "Si abbandonò sul divano, esausto dalla giornata."
      ],
      "nota": "Nell'uso pronominale ('abbandonarsi') indica spesso un atteggiamento di totale rilassamento o resa emotiva."
    }
  ]
