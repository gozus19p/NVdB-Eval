  "senses": [
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Persona che detiene la carica più alta in un'assemblea, un consiglio, un'associazione o un organo collegiale, dirigendone le attività e le riunioni.",
      "examples": [
        "Il presidente della commissione ha dato inizio alla seduta.",
        "Fu eletto presidente del club sportivo all'unanimità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Capo di Stato di una repubblica, che esercita le funzioni di rappresentanza suprema.",
      "examples": [
        "Il presidente della Repubblica ha concesso la grazia.",
        "La visita del presidente francese è prevista per martedì."
      ],
      "nota": "In alcuni sistemi politici (es. presidenzialismo) il titolo può indicare anche il capo del governo."
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Persona a capo dell'amministrazione e della direzione di una società o di un'azienda.",
      "examples": [
        "Il presidente del consiglio di amministrazione ha presentato il bilancio.",
        "La presidente della banca ha annunciato la nuova strategia."
      ],
      "nota": null
    }
  ]
