  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo o appartenente alla città di Roma, alla sua storia, alla sua cultura o alle sue istituzioni.",
      "examples": [
        "Il centro storico romano è un patrimonio dell'umanità.",
        "La cucina romana prevede spesso piatti semplici e sostanziosi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Persona originaria o residente nella città di Roma.",
      "examples": [
        "Un vero romano conosce tutti i segreti della sua città.",
        "Il sindaco in carica è un romano doc."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo o appartenente all'antica civiltà di Roma, al suo impero o alla sua cultura.",
      "examples": [
        "L'Impero romano si estendeva su tre continenti.",
        "Il diritto romano è alla base di molti sistemi giuridici moderni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Cittadino o appartenente all'antica civiltà di Roma.",
      "examples": [
        "Un romano dell'epoca repubblicana avrebbe difficoltà a riconoscere la città imperiale.",
        "I romani costruirono strade e acquedotti in tutto il loro impero."
      ],
      "nota": null
    }
  ]
