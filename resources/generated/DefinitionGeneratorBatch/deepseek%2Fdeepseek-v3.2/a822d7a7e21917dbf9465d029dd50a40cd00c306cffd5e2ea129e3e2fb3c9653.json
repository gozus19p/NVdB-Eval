  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Strato o elemento lungo e sottile, di materiale vario, che serve per avvolgere, legare o ornare.",
      "examples": [
        "Mise una fascia elastica per fermare il rotolo di carta.",
        "La bambina indossava una fascia di seta nei capelli."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Parte di territorio, superficie o oggetto di forma allungata e relativamente stretta.",
      "examples": [
        "Una fascia di terreno incolto separava le due proprietà.",
        "Il mobile era decorato con una fascia di legno scuro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Ciascuno dei gruppi in cui viene suddivisa una popolazione, una serie di dati o un insieme di elementi secondo criteri di età, reddito, caratteristiche tecniche o simili.",
      "examples": [
        "L'indagine si concentra sulla fascia d'età tra i,25 e i,40 anni.",
        "Questo prodotto è destinato alla fascia di mercato più alta."
      ],
      "nota": "Spesso utilizzata con complementi introdotti da 'di' o 'per'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Benda larga che si avvolge intorno al corpo, in particolare all'addome, per sostenere, proteggere o comprimere.",
      "examples": [
        "Dopo l'intervento, le fu consigliato di portare una fascia addominale.",
        "Il sollevatore di pesi si è stretto una fascia lombare."
      ],
      "nota": null
    }
  ]
