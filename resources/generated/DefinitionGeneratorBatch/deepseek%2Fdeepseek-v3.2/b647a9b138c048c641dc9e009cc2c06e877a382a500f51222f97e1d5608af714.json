  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Quantità di oggetti o materiali che un mezzo di trasporto è in grado di trasportare o sta trasportando.",
      "examples": [
        "Il camion ha un carico di oltre dieci tonnellate.",
        "Abbiamo già stivato il carico nella stiva della nave."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Insieme di oggetti trasportati da qualcuno o sostenuti da qualcosa.",
      "examples": [
        "Portava un pesante carico di libri sulla schiena.",
        "Il carico della slitta era costituito da provviste e attrezzatura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Responsabilità, compito o impegno che richiede uno sforzo mentale o emotivo.",
      "examples": [
        "Sentiva il carico della gestione dell'azienda.",
        "La notizia ha aggiunto un ulteriore carico di preoccupazione."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "aggettivo",
      "definition": "Riempito o occupato al massimo della propria capacità di contenere o trasportare.",
      "examples": [
        "Il furgone era carico di mobili.",
        "Il treno partì carico di passeggeri."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Pieno di una sensazione o di un'emozione intensa.",
      "examples": [
        "Era carico di rabbia dopo il litigio.",
        "L'atmosfera in teatro era carica di tensione."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha assunto una quantità notevole di sostanza (come energia, elettricità o alcool).",
      "examples": [
        "La batteria è completamente carica.",
        "Evitò di guidare perché si sentiva un po' carico."
      ],
      "nota": null
    }
  ]
