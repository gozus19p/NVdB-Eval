  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Area di terreno ampia e non coltivata, coperta da una fitta vegetazione di alberi ad alto fusto.",
      "examples": [
        "Durante la passeggiata, abbiamo attraversato un bosco di querce secolari.",
        "I bambini si persero mentre giocavano nel bosco dietro casa."
      ],
      "nota": "Il termine 'bosco' denota generalmente un'estensione di terreno più ampia e meno fitta di una 'foresta'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Collettivo di alberi piantati con una precisa disposizione per uno scopo specifico (ornamentale, produttivo o sperimentale).",
      "examples": [
        "Il bosco di bambù nel giardino botanico crea un'atmosfera suggestiva.",
        "Hanno creato un bosco di alberi da frutto a scopo didattico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Folla o insieme molto numeroso di oggetti di tipo simile, percepito come fitto e disordinato.",
      "examples": [
        "Una volta aperta la porta, la stanza era un bosco di fili elettrici.",
        "Incontrò un bosco di mani alzate quando chiese ai volontari di intervenire."
      ],
      "nota": "Usato in senso figurato e spesso con una leggera connotazione negativa di disordine o sovrabbondanza."
    }
  ]
