  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che costituisce un tutto completo, non suddiviso né privato di una parte.",
      "examples": [
        "Ho mangiato l'intero piatto di pasta.",
        "Abbiamo visto l'intero film senza interruzioni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "In buone condizioni fisiche, non danneggiato o rotto.",
      "examples": [
        "Nonostante la caduta, il vaso è rimasto intero.",
        "Controlla che tutte le matite siano intere prima di metterle nello zaino."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che conserva integrità morale o caratteriale, non influenzato negativamente.",
      "examples": [
        "Rimase un uomo intero nonostante le difficoltà.",
        "La sua reputazione è rimasta intera dopo lo scandalo."
      ],
      "nota": "Usato in senso figurato per riferirsi a una persona o a un suo attributo immateriale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Numero che non è frazionario, che appartiene all'insieme dei numeri naturali, dei loro opposti e dello zero.",
      "examples": [
        "La somma di due interi è sempre un intero.",
        "In matematica, l'insieme degli interi è indicato con Z."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Moneta o banconota dal valore completo, non divisa in spiccioli.",
      "examples": [
        "Pagherò con un intero da cinquanta euro.",
        "Non aveva un intero, solo delle monete."
      ],
      "nota": "Uso comune nel linguaggio economico-informale."
    }
  ]
