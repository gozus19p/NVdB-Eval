  "senses": [
    {
      "pos": "sostantivo maschile/femminile",
      "definition": "Funzionario pubblico investito del potere di amministrare la giustizia, emettendo sentenze e pronunciandosi su controversie in sede giudiziaria.",
      "examples": [
        "Il giudice ha rinviato il processo per raccogliere nuove prove.",
        "La giudice è nota per la sua imparzialità e rigore nell'applicazione della legge."
      ],
      "nota": "La forma femminile 'giudice' è ormai accettata nell'uso corrente, sebbene esistano anche le varianti 'giudicessa' o 'la giudice'."
    },
    {
      "pos": "sostantivo maschile/femminile",
      "definition": "Persona chiamata a esprimere un parere valutativo o a decidere il vincitore in una competizione, gara o concorso.",
      "examples": [
        "Ha fatto da giudice in un talent show televisivo.",
        "La giudice del concorso di bellezza ha annunciato i finalisti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile/femminile",
      "definition": "Chi formula una valutazione critica o morale sul comportamento altrui, spesso con implicazione di severità o presunzione.",
      "examples": [
        "Non fare il giudice, non conosci tutti i dettagli della situazione.",
        "Si è comportata come una giudice inflessibile, condannando ogni minimo errore."
      ],
      "nota": "In questa accezione il termine assume spesso una connotazione negativa, sottolineando un atteggiamento critico eccessivo o arrogante."
    }
  ]
