  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Impegnarsi in uno scontro fisico o armato contro un avversario.",
      "examples": [
        "Le truppe dovranno combattere il nemico in campo aperto.",
        "I due lottatori si sono combattuti con grande determinazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Partecipare a una guerra o a un conflitto.",
      "examples": [
        "Mio nonno ha combattuto nella seconda guerra mondiale.",
        "Il paese è pronto a combattere per la propria indipendenza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Opporsi attivamente e con determinazione a qualcosa di negativo.",
      "examples": [
        "Il governo ha promesso di combattere l'evasione fiscale.",
        "Dobbiamo combattere i pregiudizi con l'informazione."
      ],
      "nota": "In questo senso figurato, l'oggetto è tipicamente un fenomeno astratto (es. corruzione, disuguaglianza) considerato avverso."
    },
    {
      "pos": "verbo intransitivo pronominale (combattersi)",
      "definition": "Sforzarsi di superare un impulso, un desiderio o un sentimento interiore contrastante.",
      "examples": [
        "Si combatteva tra il desiderio di parlare e la paura delle conseguenze.",
        "Mi combatto ogni giorno con la pigrizia per andare in palestra."
      ],
      "nota": null
    }
  ]
