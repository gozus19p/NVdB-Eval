  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Proprietà percettiva della luce, determinata dalla lunghezza d'onda, che permette di distinguere oggetti visivamente.",
      "examples": [
        "Il colore del cielo al tramonto è spesso arancione e rosa.",
        "Ha scelto un colore vivace per dipingere la stanza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Pigmento, sostanza utilizzata per tingere o dipingere.",
      "examples": [
        "Serve ancora del colore bianco per finire il lavoro.",
        "Questi colori ad olio sono di ottima qualità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Aspetto caratteristico o tono di qualcosa, spesso in senso figurato.",
      "examples": [
        "La sua descrizione ha dato molto colore alla vicenda.",
        "Il dibattito politico ha acquisito un colore nuovo dopo quell'intervento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Appartenenza etnica o caratteristica fisica legata alla pigmentazione della pelle, usata principalmente in contesti sociologici o demografici.",
      "examples": [
        "La discriminazione basata sul colore della pelle è un grave problema sociale.",
        "Una società multicolore è più ricca e dinamica."
      ],
      "nota": "Uso spesso in locuzioni come 'persona di colore'."
    }
