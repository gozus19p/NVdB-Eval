  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Entità che compie o subisce un'azione, o su cui verte una descrizione, dotata di capacità di scelta e responsabilità.",
      "examples": [
        "Il soggetto di questa indagine è stato identificato dalla polizia.",
        "Nello studio clinico, ogni soggetto ha firmato un consenso informato."
      ],
      "nota": "In questo senso, si contrappone spesso a 'oggetto'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona caratterizzata da specifiche qualità, spesso con una sfumatura critica o peculiare.",
      "examples": [
        "È un soggetto piuttosto sospetto, meglio starne alla larga.",
        "Conosciamo tutti soggetti simili, sempre pronti a lamentarsi."
      ],
      "nota": "Usato frequentemente in contesti colloquiali o burocratici con una connotazione spesso negativa o neutra-impersonale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Tema o argomento principale di un discorso, di un'opera artistica o di una trattazione.",
      "examples": [
        "Il soggetto del suo romanzo è la solitudine nelle metropoli.",
        "Cambiamo soggetto, questo discorso mi sta annoiando."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è esposto o suscettibile a qualcosa, in particolare a un rischio, a una condizione o a una legge.",
      "examples": [
        "Tutti i cittadini sono soggetti alle norme dello stato.",
        "Quella zona è soggetta a frequenti alluvioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Nella grammatica, elemento della frase che compie l'azione espressa dal verbo o di cui si dichiara qualcosa.",
      "examples": [
        "Nella frase 'Il gatto dorme', 'il gatto' è il soggetto.",
        "In italiano, il soggetto può essere sottinteso."
      ],
      "nota": "In questo senso, si contrappone a 'predicato'."
    }
  ]
