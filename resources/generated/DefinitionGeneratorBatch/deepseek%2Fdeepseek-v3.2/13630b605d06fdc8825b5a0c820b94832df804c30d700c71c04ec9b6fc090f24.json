  "senses": [
    {
      "pos": "aggettivo (predicativo)",
      "definition": "Che possiede abilità e competenza in un campo specifico.",
      "examples": [
        "Mia sorella è molto brava a suonare il pianoforte.",
        "Il nostro idraulico è un professionista bravo ed efficiente."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo (attributivo/predicativo)",
      "definition": "Che agisce in modo moralmente corretto, leale o degno di lode.",
      "examples": [
        "È stato bravo a confessare l'errore senza cercare scuse.",
        "In quella situazione difficile si è comportato da persona brava."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo (predicativo, spesso seguito da 'a' o 'nel')",
      "definition": "Che dimostra destrezza o efficacia nell'esecuzione di un'azione.",
      "examples": [
        "Non sono bravo a ricordare i nomi.",
        "Il bambino è diventato bravo nel nuoto dopo tanto allenamento."
      ],
      "nota": null
    },
    {
      "pos": "interiezione",
      "definition": "Esclamazione di approvazione, elogio o incoraggiamento rivolta a qualcuno.",
      "examples": [
        "Bravo! Hai superato l'esame con il massimo dei voti.",
        "Il pubblico ha gridato 'Brava!' all'attrice al termine della scena."
      ],
      "nota": "Può variare in genere (bravo/a/i/e) per accordarsi con il destinatario."
    }
  ]
