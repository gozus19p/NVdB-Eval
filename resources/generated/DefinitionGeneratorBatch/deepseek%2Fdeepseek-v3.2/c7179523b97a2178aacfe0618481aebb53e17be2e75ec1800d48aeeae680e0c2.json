  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Complesso di opere scritte di un popolo, di un'epoca o di un genere, considerate sotto l'aspetto artistico o culturale.",
      "examples": [
        "La letteratura italiana del Rinascimento è molto studiata all'estero.",
        "Il professore si occupa di letteratura comparata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di scritti che trattano di una determinata disciplina o argomento.",
      "examples": [
        "C'è un'ampia letteratura scientifica sul cambiamento climatico.",
        "Prima di iniziare la ricerca, ho esaminato tutta la letteratura disponibile sull'argomento."
      ],
      "nota": "In questo senso, il termine è spesso usato in ambito accademico o specialistico."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Attività, arte o pratica dello scrivere opere di valore artistico.",
      "examples": [
        "Si è dedicato alla letteratura dopo una lunga carriera in banca.",
        "Il premio riconosce il suo impegno nella letteratura per l'infanzia."
      ],
      "nota": null
    }
