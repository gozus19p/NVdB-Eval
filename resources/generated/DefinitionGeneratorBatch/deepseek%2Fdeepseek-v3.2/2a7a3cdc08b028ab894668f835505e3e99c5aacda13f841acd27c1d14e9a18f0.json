  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Norma giuridica generale e astratta emanata dall'autorità competente di uno Stato, vincolante per tutti i soggetti dell'ordinamento.",
      "examples": [
        "Il Parlamento ha approvato una nuova legge sulla protezione dei dati.",
        "La Costituzione è la legge fondamentale della Repubblica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Principio scientifico o matematico che descrive una relazione costante e universale tra fenomeni naturali o grandezze.",
      "examples": [
        "La legge di gravità descrive l'attrazione reciproca tra i corpi.",
        "La legge di Ohm stabilisce la relazione tra tensione, corrente e resistenza in un circuito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Regola o principio stabilito come norma di comportamento in un determinato ambito non necessariamente giuridico.",
      "examples": [
        "Le leggi del mercato hanno governato l'andamento dei prezzi.",
        "Ha scritto un libro sulle non scritte leggi della strada."
      ],
      "nota": "Spesso usato in espressioni come 'leggi del mercato', 'leggi della fisica', per indicare regole o principi considerati inevitabili o fondamentali in un certo dominio."
    }
  ]
