  "senses": [
    {
      "pos": "congiunzione causale",
      "definition": "Introduce una frase che esprime la causa o il motivo dell'azione o situazione enunciata nella proposizione principale.",
      "examples": [
        "Non esco perché piove.",
        "Si è ritirato dalla competizione perché non si sentiva bene."
      ],
      "nota": null
    },
    {
      "pos": "congiunzione finale",
      "definition": "Introduce una frase che esprime lo scopo o l'obiettivo dell'azione enunciata nella proposizione principale.",
      "examples": [
        "Lavoro sodo perché i miei figli possano studiare.",
        "Parla lentamente perché tutti possano capire."
      ],
      "nota": "In questo uso, è spesso seguito dal congiuntivo."
    },
    {
      "pos": "avverbio interrogativo",
      "definition": "Usato per introdurre una domanda diretta o indiretta che chiede il motivo o la ragione di qualcosa.",
      "examples": [
        "Perché sei così triste?",
        "Mi chiedo perché non abbia risposto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La causa, il motivo, la ragione che spiega un fatto o un comportamento.",
      "examples": [
        "Vorrei conoscere il perché della tua decisione.",
        "Non riesco a capire il perché di tutto questo trambusto."
      ],
      "nota": "Usato prevalentemente con l'articolo determinativo ('il perché')."
    }
  ]
