  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Far muovere qualcosa con forza per allontanarlo da sé, in modo che cada o finisca altrove.",
      "examples": [
        "Non buttare i rifiuti per terra, mettili nel cestino.",
        "Il bambino ha buttato la palla oltre la rete."
      ],
      "nota": "Uso letterale, spesso associato a gesti di scarto o lancio."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Disporre rapidamente e senza particolare cura qualcosa in un luogo.",
      "examples": [
        "Prima di uscire, buttò il libro nello zaino.",
        "Buttò le chiavi sul tavolo ed andò a rispondere al telefono."
      ],
      "nota": "Può implicare una certa trascuratezza nell'azione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Perdere, far cadere o distruggere in modo accidentale o in una situazione sfavorevole.",
      "examples": [
        "Con un'ultima mossa sbagliata, ha buttato la partita.",
        "Quella decisione avventata potrebbe buttare all'aria anni di lavoro."
      ],
      "nota": "Usato in senso figurato, spesso con sfumatura negativa per indicare un fallimento o uno spreco di opportunità."
    },
    {
      "pos": "verbo transitivo (con complemento indiretto)",
      "definition": "Lanciare sguardi o parole verso qualcuno o qualcosa.",
      "examples": [
        "Mi ha buttato un'occhiata di traverso e poi ha voltato la testa.",
        "Durante la discussione, gli hanno buttato addosso accuse infondate."
      ],
      "nota": "Senso figurato, spesso usato con termini come 'occhiata', 'sguardo', 'insulto'."
    },
    {
      "pos": "verbo pronominale (buttarsi)",
      "definition": "Lanciarsi con impeto in un'azione, in un luogo o in una situazione.",
      "examples": [
        "Si è buttato in acqua senza esitare.",
        "Dopo la laurea, si è buttato a capofitto nel mondo del lavoro."
      ],
      "nota": "Indica un'implicazione totale, spesso con determinazione o senza ponderazione."
    },
    {
      "pos": "verbo pronominale (buttarsi)",
      "definition": "Abbandonarsi a uno stato d'animo o a un comportamento in modo totale.",
      "examples": [
        "Dopo la notizia, si è buttato nella disperazione più profonda.",
        "Non ti buttare giù, la situazione può ancora migliorare."
      ],
      "nota": "Uso figurato che esprime un atteggiamento emotivo estremo, spesso negativo (es. 'buttarsi giù' per 'perdere il morale')."
    }
  ]
