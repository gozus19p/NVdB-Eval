  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Unità di tempo corrispondente approssimativamente al periodo impiegato dalla Terra per completare un'orbita intorno al Sole, convenzionalmente divisa in dodici mesi.",
      "examples": [
        "L'anno solare ha una durata di 365 giorni.",
        "Gli studenti hanno completato il corso in un anno accademico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Periodo di tempo, generalmente di dodici mesi, utilizzato come riferimento per l'età di una persona o di una cosa.",
      "examples": [
        "Mio figlio compie cinque anni la prossima settimana.",
        "Questa casa è stata costruita più di cento anni fa."
      ],
      "nota": "In questa accezione, il sostantivo è spesso usato in costruzioni per indicare l'età (es. 'ha X anni')."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Periodo di dodici mesi considerato dal punto di vista delle attività, dei risultati o delle condizioni che lo caratterizzano.",
      "examples": [
        "L'anno fiscale dell'azienda si è chiuso con un utile.",
        "Quest'anno è stato particolarmente piovoso per la nostra regione."
      ],
      "nota": "Può essere qualificato da aggettivi (buono, difficile, produttivo) o da un determinante (questo, quello)."
    }
  ]
