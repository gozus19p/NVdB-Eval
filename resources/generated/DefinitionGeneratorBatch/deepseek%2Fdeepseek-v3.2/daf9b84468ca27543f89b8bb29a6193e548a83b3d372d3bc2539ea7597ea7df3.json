  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Del colore del sangue o della brace ardente.",
      "examples": [
        "Ha acquistato una macchina di colore rosso.",
        "Le foglie d'autunno diventano rosse."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a ideologie o partiti politici di sinistra, spesso rivoluzionari o socialisti.",
      "examples": [
        "Il quartiere è tradizionalmente un'area rossa.",
        "Durante il dibattito, le sue posizioni erano chiaramente rosse."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il colore del sangue o della brace ardente.",
      "examples": [
        "Il rosso è il suo colore preferito.",
        "Questa tonalità di rosso è molto intensa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Persona che professa idee politiche di sinistra o rivoluzionarie.",
      "examples": [
        "La manifestazione era piena di rossi.",
        "In quel periodo storico, molti intellettuali si dichiaravano rossi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Segnale di divieto di passaggio o di pericolo, specialmente nel codice della strada.",
      "examples": [
        "L'automobilista non si è fermato al rosso.",
        "Il semaforo era già in fase di rosso quando è arrivato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Situazione di bilancio negativo, di perdita finanziaria.",
      "examples": [
        "La società ha chiuso l'anno in rosso.",
        "I conti della famiglia sono pericolosamente in rosso."
      ],
      "nota": "Espressione figurata derivante dalla pratica contabile di segnare i numeri negativi con l'inchiostro rosso."
    }
  ]
