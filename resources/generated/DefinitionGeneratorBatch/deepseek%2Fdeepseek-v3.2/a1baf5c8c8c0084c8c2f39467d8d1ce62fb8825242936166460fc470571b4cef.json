  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Produrre suoni o musica attraverso uno strumento musicale",
      "examples": [
        "Sa suonare il pianoforte alla perfezione.",
        "La banda sta suonando l'inno nazionale."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare avere)",
      "definition": "Emettere una sequenza ritmica di suoni",
      "examples": [
        "Le campane della chiesa suonano a festa.",
        "Alle sette l'allarme suonerà per l'evacuazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Produrre un suono specifico per indicare un momento o un evento",
      "examples": [
        "L'orologio suonò le dodici.",
        "Ti suono il clacson solo se non ti sposti."
      ],
      "nota": "L'oggetto diretto è tipicamente l'ora o il tipo di segnale acustico"
    },
    {
      "pos": "verbo transitivo/intransitivo (colloquiale)",
      "definition": "Percuotere, colpire qualcuno, anche in senso figurato",
      "examples": [
        "Se non la smetti, ti suono!",
        "Nell'ultimo round ha suonato l'avversario con un gancio sinistro."
      ],
      "nota": "Uso spesso figurato o minaccioso; nel significato sportivo (pugilato) indica un colpo efficace."
    }
  ]
