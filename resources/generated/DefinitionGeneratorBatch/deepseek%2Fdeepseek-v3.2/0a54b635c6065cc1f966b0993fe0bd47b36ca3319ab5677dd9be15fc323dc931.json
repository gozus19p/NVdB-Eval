  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Miscela gassosa che costituisce l'atmosfera terrestre e che gli esseri viventi respirano.",
      "examples": [
        "La finestra aperta ha fatto entrare aria fresca nella stanza.",
        "In montagna l'aria è più leggera e pura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Corrente d'atmosfera che si sposta in modo percettibile.",
      "examples": [
        "Oggi c'è una leggera aria di tramontana.",
        "Ha aperto la porta e un'aria gelida è entrata."
      ],
      "nota": "In questo senso è spesso preceduta da un determinante come 'un' po' di', 'una', o da un aggettivo qualificativo."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Aspetto esteriore, atteggiamento o modo di presentarsi di una persona.",
      "examples": [
        "Nonostante le difficoltà, manteneva un'aria serena.",
        "La sua aria distinta ingannava tutti sulla sua vera indole."
      ],
      "nota": "Spesso utilizzato in espressioni come 'avere l'aria di', 'darsi delle arie'. Connota un'impressione superficiale o non necessariamente veritiera."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Atmosfera, ambiente o clima morale, psicologico o sociale di un luogo o di una situazione.",
      "examples": [
        "In ufficio si respira un'aria di cambiamento.",
        "La riunione si è svolta in un'aria di grande cordialità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Composizione musicale per voce o strumenti, spesso con carattere melodico e distintivo, inserita in un'opera o altro lavoro più ampio.",
      "examples": [
        "L'aria 'Nessun dorma' è uno dei brani più celebri di Turandot.",
        "Il soprano ha eseguito l'aria con grande espressività."
      ],
      "nota": "Termine tecnico della musica classica, specificamente operistica."
    }
  ]
