  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "La condizione o l'evento in cui qualcosa si verifica dopo il momento previsto o programmato.",
      "examples": [
        "Il volo ha accumulato un ritardo di due ore.",
        "Devo scusarmi per il mio ritardo alla riunione."
      ],
      "nota": "Si riferisce tipicamente a persone, mezzi di trasporto o eventi."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Stato di insufficiente o rallentato sviluppo, progresso o raggiungimento rispetto a uno standard atteso.",
      "examples": [
        "Il bambino mostra un lieve ritardo nell'apprendimento del linguaggio.",
        "La regione soffre di un ritardo infrastrutturale rispetto al nord."
      ],
      "nota": "Usato spesso in contesti educativi, psicologici, tecnologici o socioeconomici."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Somma di denaro che deve essere pagata oltre il termine pattuito.",
      "examples": [
        "L'inquilino è tenuto a versare gli interessi di mora per ogni mese di ritardo.",
        "La legge prevede sanzioni per il ritardo nel pagamento delle tasse."
      ],
      "nota": "In questo senso, è spesso associato a termini come 'pagamento', 'versamento' o è usato in contesti amministrativi e legali."
    }
  ]
