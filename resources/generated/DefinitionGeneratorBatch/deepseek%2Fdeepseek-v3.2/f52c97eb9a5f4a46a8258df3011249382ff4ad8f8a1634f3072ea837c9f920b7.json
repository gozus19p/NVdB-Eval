  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Applicare terapie e interventi medici a qualcuno o qualcosa per guarire una malattia o alleviare un disturbo.",
      "examples": [
        "Il dottore sta cercando di curare la sua infezione con un nuovo antibiotico.",
        "Specialisti di tutto il mondo collaborano per curare quella rara patologia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Prestare attenzione costante e meticolosa a qualcosa, dedicandovi tempo e impegno per mantenerla in buono stato o farla prosperare.",
      "examples": [
        "Cura con grande dedizione il suo giardino di rose.",
        "Devi curare di più la presentazione, la forma è importante quanto il contenuto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere la responsabilità di organizzare, dirigere o sovrintendere a un progetto, un evento o una pubblicazione.",
      "examples": [
        "È stata incaricata di curare l'allestimento della mostra d'arte contemporanea.",
        "Quell'editore cura una collana di saggi storici molto prestigiosa."
      ],
      "nota": "Uso specializzato in ambiti come editoria, arte, eventi."
    },
    {
      "pos": "verbo riflessivo (curare di sé)",
      "definition": "Prestare attenzione al proprio aspetto fisico, alla propria salute o al proprio benessere psicologico.",
      "examples": [
        "Dopo quel periodo difficile, ha deciso di iniziare a curare di sé.",
        "Non cura mai il suo aspetto, sembra sempre trasandato."
      ],
      "nota": "La costruzione riflessiva 'curare di sé' è molto frequente e idiomatica."
    }
  ]
