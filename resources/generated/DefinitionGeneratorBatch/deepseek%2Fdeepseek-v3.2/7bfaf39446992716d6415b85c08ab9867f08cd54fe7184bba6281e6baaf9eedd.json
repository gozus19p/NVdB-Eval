  "senses": [
    {
      "pos": "sostantivo, m.",
      "definition": "Mezzo di trasporto motorizzato più pesante dell'aria, in grado di volare grazie a superfici portanti fisse.",
      "examples": [
        "L'aereo atterrerà con un leggero ritardo a causa del maltempo.",
        "Hanno prenotato i biglietti per un aereo diretto a New York."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene o è relativo all'aria o all'atmosfera.",
      "examples": [
        "La pressione aerea è diminuita rapidamente, preannunciando il temporale.",
        "Le particelle aeree possono trasportare allergeni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è svolto mediante velivoli o nell'ambito dell'aviazione.",
      "examples": [
        "La compagnia aerea ha annunciato nuove rotte per l'estate.",
        "Il trasporto aereo di merci deperibili è essenziale per l'economia globale."
      ],
      "nota": "È spesso utilizzato in locuzioni composte."
    }
  ]
