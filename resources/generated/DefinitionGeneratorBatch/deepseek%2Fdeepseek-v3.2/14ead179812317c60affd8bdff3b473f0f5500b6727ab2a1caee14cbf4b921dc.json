  "senses": [
    {
      "pos": "verbo intransitivo, transitivo",
      "definition": "Emittiere suoni articolati attraverso la bocca, formando parole per comunicare.",
      "examples": [
        "Il bambino ha iniziato a parlare all'età di un anno.",
        "Parla sempre a voce molto alta al telefono."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (con complemento di argomento introdotto da 'di')",
      "definition": "Aver qualcosa come oggetto di una conversazione o di un discorso.",
      "examples": [
        "Stamattina abbiamo parlato a lungo del nuovo progetto.",
        "Il libro parla delle migrazioni del Novecento."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (con complemento di compagnia introdotto da 'con')",
      "definition": "Intrattenere una conversazione con una o più persone.",
      "examples": [
        "Ho parlato con il direttore per chiarire la situazione.",
        "Parliamo un attimo, ho bisogno di un consiglio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Possedere la capacità di esprimersi in una determinata lingua.",
      "examples": [
        "Mio nonno parlava fluentemente il tedesco.",
        "Parla italiano molto bene, considerando che è qui da poco."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo figurato",
      "definition": "Essere espressivo o rivelare qualcosa in modo non verbale, attraverso l'aspetto o il comportamento.",
      "examples": [
        "Quel quadro parla di solitudine e malinconia.",
        "I suoi occhi parlavano di una grande tristezza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Modo di esprimersi verbalmente, caratterizzato da un particolare stile o registro.",
      "examples": [
        "Il suo parlare è sempre molto educato e formale.",
        "Ammiro il parlare semplice e diretto di quella scrittrice."
      ],
      "nota": "Uso prevalentemente letterario o elevato."
    }
  ]
