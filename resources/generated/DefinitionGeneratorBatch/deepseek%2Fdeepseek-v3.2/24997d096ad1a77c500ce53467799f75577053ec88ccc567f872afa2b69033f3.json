  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di materiale che oppone resistenza alla deformazione o alla penetrazione",
      "examples": [
        "Il marmo è un materiale duro.",
        "Mi sono sbattuto il piede contro uno scoglio duro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che richiede o implica sforzo fisico o mentale intenso",
      "examples": [
        "Il lavoro in miniera era molto duro.",
        "Ha superato un periodo durissimo dopo la perdita del lavoro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Severo, rigido, privo di comprensione o indulgenza",
      "examples": [
        "Il nuovo allenatore è molto duro con la squadra.",
        "Ha preso una decisione dura ma necessaria."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Persistente e difficile da sconfiggere o superare",
      "examples": [
        "È stato un avversario duro da battere.",
        "La squadra ha incontrato una resistenza molto dura."
      ],
      "nota": "Si usa spesso in ambito sportivo o competitivo."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Tipo di film o di fumetto caratterizzato da una rappresentazione realistica e spesso violenta della vita criminale",
