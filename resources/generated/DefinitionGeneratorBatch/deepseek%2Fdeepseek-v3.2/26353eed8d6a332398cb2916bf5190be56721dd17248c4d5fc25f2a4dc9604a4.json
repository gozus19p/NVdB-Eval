  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Animale vertebrato di sangue caldo, generalmente in grado di volare, caratterizzato dalla presenza di piume, un becco corneo e la deposizione di uova.",
      "examples": [
        "Un uccello canterino si è posato sul ramo.",
        "Ho osservato molti uccelli migratori durante la primavera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona giudicata ingenua, sprovveduta o facilmente ingannabile.",
      "examples": [
        "Si è fatto fregare come un uccello.",
        "Quel venditore ambulante vedeva negli anziani degli uccelli da spennare."
      ],
      "nota": "Termine colloquiale, spesso usato in espressioni fisse come 'prendere per un uccello'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Organo riproduttivo maschile esterno.",
