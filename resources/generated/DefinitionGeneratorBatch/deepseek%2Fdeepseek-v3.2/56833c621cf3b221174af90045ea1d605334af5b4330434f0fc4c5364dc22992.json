  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Mammifero carnivoro domestico di piccola taglia, appartenente alla famiglia dei Felidi, caratterizzato da corpo flessuoso, coda lunga e artigli retrattili.",
      "examples": [
        "Il mio gatto miagola ogni mattina per chiedere da mangiare.",
        "Un gatto nero attraversò la strada davanti alla mia auto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona astuta, scaltra, abile nel cavarsela in situazioni difficili.",
      "examples": [
        "Quel ragazzo è un vero gatto, riesce sempre a ottenere ciò che vuole.",
        "Per sopravvivere in quel quartiere devi essere un gatto."
      ],
      "nota": null
    }
