  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Capacità dell'individuo di scegliere liberamente e di decidere di agire in un certo modo.",
      "examples": [
        "Nonostante la stanchezza, con molta volontà ha terminato il lavoro.",
        "Il successo dipende spesso dalla volontà di persistere negli sforzi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Documento legale che esprime le ultime disposizioni di una persona relative alla destinazione dei propri beni dopo la morte.",
      "examples": [
        "Ha lasciato scritto nel suo testamento che la casa andrà in eredità al nipote.",
        "L'avvocato lesse pubblicamente le volontà del defunto."
      ],
      "nota": "Sinonimo formale di 'testamento'. L'uso è tipico in contesti legali o formali."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Desiderio, intenzione, disposizione d'animo verso qualcosa o qualcuno.",
      "examples": [
        "Ho la ferma intenzione di partire per un lungo viaggio il prossimo anno.",
        "Si è espresso con grande benevolenza nei confronti del nuovo collega."
      ],
      "nota": "In questa accezione, il termine è spesso accompagnato da un aggettivo (buona, cattiva, ferma) o da una specificazione (di fare qualcosa)."
    }
  ]
