    {
      "pos": "sostantivo m.",
      "definition": "Parte ristretta di alcuni contenitori, posta tra il corpo e l'apertura.",
      "examples": [
        "Il vino scorse lungo il collo della bottiglia.",
        "Afferra saldamente il collo del vaso per non farlo cadere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte superiore di un indumento che circonda la base del capo.",
      "examples": [
        "Il collo della camicia è troppo stretto.",
        "Ho macchiato il collo della maglietta con la salsa."
      ],
      "nota": "Per estensione metonimica, indica la parte dell'abito che copre la parte del corpo corrispondente."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Indica una grande dose di alcol bevuta in un'unica sorsata.",
      "examples": [
        "Si è scolato un collo di birra per scommessa.",
        "Dopo la notizia, si è fatto un collo di whisky per darsi coraggio."
      ],
      "nota": "Uso informale e figurato, che allude al gesto di bere alzando la bottiglia."
    }
