  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Caratteristica di essere operante, in movimento o in funzionamento.",
      "examples": [
        "Il cuore ha ripreso la sua normale attività dopo l'operazione.",
        "L'attività vulcanica nella zona è monitorata costantemente."
      ],
      "nota": "Questo senso si riferisce allo stato di un sistema o di un organismo."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Operazione, lavoro o occupazione in cui è impegnata una persona o un ente.",
      "examples": [
        "La sua principale attività è la consulenza finanziaria.",
        "L'associazione organizza attività ricreative per i bambini."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Insieme di operazioni commerciali, produttive o professionali svolte da un'impresa o da un libero professionista.",
      "examples": [
        "L'attività dell'azienda si è concentrata sul mercato estero.",
        "Ha avviato un'attività in proprio dopo anni di lavoro dipendente."
      ],
      "nota": "Spesso contrapposto a 'passività' in ambito economico o commerciale."
    }
