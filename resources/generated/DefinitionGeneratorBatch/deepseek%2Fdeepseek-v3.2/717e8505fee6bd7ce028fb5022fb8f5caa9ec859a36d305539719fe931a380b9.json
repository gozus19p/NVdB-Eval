  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Entità astratta o realtà concreta che non ha limiti misurabili, né inizio né fine, soprattutto riferita allo spazio o al tempo.",
      "examples": [
        "Il concetto dell'infinito ha affascinato filosofi e matematici per secoli.",
        "Guardando il cielo stellato, provo un senso di vertigine davanti all'infinito."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di limiti misurabili, che non ha termine o confine.",
      "examples": [
        "L'universo è considerato uno spazio infinito.",
        "La sua pazienza sembrava infinita."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Estremamente numeroso o grande, in quantità o intensità, al punto da risultare incalcolabile o incommensurabile.",
      "examples": [
        "Mi ha dato un'infinità di consigli utili.",
        "Provava un'infinita gratitudine per quel gesto."
      ],
      "nota": "In questo uso spesso precede un sostantivo singolare (es. 'infinita pazienza') o è seguito da 'di' + sostantivo plurale (es. 'un'infinità di problemi')."
    }
  ]
