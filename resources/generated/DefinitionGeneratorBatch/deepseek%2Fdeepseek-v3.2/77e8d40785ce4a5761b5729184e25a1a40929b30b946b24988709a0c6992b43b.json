  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "Aerosole visibile composto da minuscole particelle solide o goccioline liquide sospese, tipicamente prodotto da combustione incompleta.",
      "examples": [
        "Il fumo che usciva dal camino segnalava che qualcuno era in casa.",
        "L'incendio ha riempito la stanza di fumo nero e acre."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Atto o abitudine di inalare il vapore prodotto dalla combustione del tabacco o di altre sostanze.",
      "examples": [
        "Ha deciso di smettere con il fumo per la sua salute.",
        "Il fumo passivo può essere dannoso quanto quello attivo."
      ],
      "nota": "Questa accezione è spesso associata al concetto di 'vizio' o 'abitudine'."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Apparenza ingannevole o realtà falsa priva di sostanza concreta.",
      "examples": [
        "Le sue promesse erano solo fumo negli occhi, senza alcun riscontro pratico.",
        "Quel successo è stato più fumo che arrosto."
      ],
      "nota": "Questa accezione è figurata e compare spesso in espressioni idiomatiche."
    }
  ]
