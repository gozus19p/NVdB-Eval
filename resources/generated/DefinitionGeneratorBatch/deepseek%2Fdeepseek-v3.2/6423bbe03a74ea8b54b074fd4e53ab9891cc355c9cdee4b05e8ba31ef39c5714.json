      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Scuola secondaria di secondo grado, solitamente a indirizzo specialistico.",
      "examples": [
        "Si è diplomato all'istituto tecnico per geometri.",
        "Quell'istituto professionale è rinomato per i suoi corsi."
      ],
      "nota": "In questo senso è spesso parte del nome proprio della scuola (es. Istituto Alberghiero)."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Norma, principio o convenzione sociale consolidata e riconosciuta all'interno di un sistema giuridico, politico o culturale.",
      "examples": [
        "Il matrimonio è un istituto fondamentale in molte società.",
        "L'istituto della prescrizione è regolato dal codice civile."
      ],
      "nota": "Usato prevalentemente in contesti giuridici, sociologici o accademici."
    }
