  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Occasione in cui due o più persone si trovano a contatto fisicamente, spesso in modo pianificato, per conversare, discutere o svolgere un'attività insieme.",
      "examples": [
        "Abbiamo fissato un incontro per martedì prossimo per parlare del progetto.",
        "L'incontro tra i due vecchi amici fu molto emozionante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Competizione sportiva tra due contendenti o squadre.",
      "examples": [
        "L'incontro di calcio è terminato con un pareggio.",
        "L'incontro di boxe è stato molto combattuto."
      ],
      "nota": null
    },
    {
      "pos": "preposizione impropria",
      "definition": "Indica direzione verso qualcosa o qualcuno, movimento in avvicinamento.",
      "examples": [
        "Camminava incontro al destino che lo attendeva.",
        "Andò incontro all'amico che veniva da lontano."
      ],
      "nota": "Utilizzata prevalentemente in combinazione con i verbi di movimento (andare, venire, camminare, ecc.)."
    }
