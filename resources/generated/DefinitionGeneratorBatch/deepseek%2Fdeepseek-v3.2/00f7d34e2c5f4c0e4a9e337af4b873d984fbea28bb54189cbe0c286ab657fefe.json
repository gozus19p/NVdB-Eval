  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Titolo nobiliare attribuito a membri di famiglie reali, spesso figlio del re o dell'imperatore.",
      "examples": [
        "Il principe erediterà il trono alla morte del padre.",
        "Il principe azzurro è un personaggio delle fiabe."
      ],
      "nota": "Nell'uso comune, può assumere una connotazione ironica o critica quando riferito a persone privilegiate."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Individuo che eccelle o è considerato il più importante in un determinato ambito.",
      "examples": [
        "Machiavelli è considerato il principe dei politologi.",
        "È ritenuto il principe dei compositori del suo secolo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sovrano di un piccolo stato, specialmente in epoche storiche passate.",
      "examples": [
        "Il principe di Monaco è il capo dello stato.",
        "I principi tedeschi governavano i loro territori."
      ],
      "nota": "Può riferirsi a governanti che non hanno il titolo di re."
    }
  ]
