  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Provare uno stato di agitazione o ansia di fronte a una minaccia reale o percepita, a una possibilità negativa o a una persona o situazione ritenuta pericolosa.",
      "examples": [
        "Temeva di perdere il lavoro a causa della crisi economica.",
        "Il bambino temeva il buio e non voleva dormire da solo."
      ],
      "nota": "Può reggere un complemento oggetto diretto (una persona, una cosa) o una frase completiva introdotta da 'di' o 'che'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere un presentimento o una convinzione negativa riguardo a un evento futuro, anticipandone l'esito sfavorevole.",
      "examples": [
        "Temiamo che la situazione possa peggiorare ulteriormente.",
        "Il medico teme delle complicazioni post-operatorie."
      ],
      "nota": "In questo senso, spesso implica un giudizio fondato su indizi o esperienza, non solo un'emozione irrazionale. Spesso usato con la congiunzione 'che'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nutrire un profondo rispetto, spesso unito a soggezione, verso qualcuno o qualcosa, riconoscendone l'autorità, il potere o la superiorità.",
      "examples": [
        "I suoi sottoposti lo temevano per la sua severità inflessibile.",
        "Nella cultura tradizionale, si temeva l'ira degli dei."
      ],
      "nota": "Questo uso è più formale e meno comune nel parlato quotidiano. Può sovrapporsi semanticamente al primo senso, ma l'accento è posto sul rispetto/autorità più che sulla paura immediata."
    }
  ]
