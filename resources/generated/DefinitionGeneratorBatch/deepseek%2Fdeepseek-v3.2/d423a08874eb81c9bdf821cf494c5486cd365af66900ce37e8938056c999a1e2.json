  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Impedire o fermare il movimento o lo sviluppo di qualcosa.",
      "examples": [
        "Il camion incidentato ha bloccato il traffico per ore.",
        "La nuova legge potrebbe bloccare la costruzione dell'autostrada."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Congelare o sospendere un'attività, un processo o delle risorse, impedendone l'utilizzo.",
      "examples": [
        "La banca ha bloccato il conto per sospetta frode.",
        "Il governo ha deciso di bloccare i fondi del progetto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Impedire il corretto funzionamento di un meccanismo, di un sistema o di una persona, causando una momentanea inattività o incapacità di reagire.",
      "examples": [
        "Una paura improvvisa mi ha bloccato e non ho potuto parlare.",
        "Un bug nel software ha bloccato completamente il computer."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Difendere un avversario nello sport impedendogli di avanzare o di giocare il pallone.",
      "examples": [
        "Il difensore è riuscito a bloccare perfettamente l'attaccante avversario.",
        "Ha bloccato il tiro con un intervento miracoloso."
      ],
      "nota": "Uso specifico del linguaggio sportivo."
    },
    {
      "pos": "verbo riflessivo (bloccarsi)",
      "definition": "Smettersi di funzionare, diventando improvvisamente inoperativo o incapace di proseguire.",
      "examples": [
        "La serratura della porta si è bloccata e non riusciamo ad aprirla.",
        "Il motore dell'auto si è bloccato in mezzo al traffico."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo (bloccarsi)",
      "definition": "Perdere la capacità di agire o di parlare a causa di un'emozione intensa come imbarazzo, paura o shock.",
      "examples": [
        "Davanti al pubblico si è bloccato e ha dimenticato tutto il discorso.",
        "Quando l'hanno interrogata, si è bloccata e non ha saputo rispondere."
      ],
      "nota": null
    }
  ]
