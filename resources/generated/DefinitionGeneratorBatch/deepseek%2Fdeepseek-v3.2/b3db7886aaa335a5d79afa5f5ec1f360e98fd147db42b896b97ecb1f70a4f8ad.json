  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Porre qualcosa contro una superficie verticale o un'altra cosa per mantenerla in posizione eretta o in equilibrio",
      "examples": [
        "Appoggia la scala al muro prima di salire.",
        "Appoggiò la testa sul cuscino e si addormentò."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dare sostegno concreto o astratto a qualcuno o qualcosa, favorendone le azioni o gli obiettivi",
      "examples": [
        "Il partito ha deciso di appoggiare la proposta di legge.",
        "Appoggia sempre i suoi amici nei momenti difficili."
      ],
      "nota": null
    },
    {
      "pos": "verbo pronominale (appoggiarsi)",
      "definition": "Sorregersi facendo affidamento su qualcosa o su qualcuno",
      "examples": [
        "Si appoggiò al bastone per camminare.",
        "Il bambino si appoggia alla madre quando è stanco."
      ],
      "nota": "Per questo senso il verbo è usato nella forma riflessiva."
    }
  ]
