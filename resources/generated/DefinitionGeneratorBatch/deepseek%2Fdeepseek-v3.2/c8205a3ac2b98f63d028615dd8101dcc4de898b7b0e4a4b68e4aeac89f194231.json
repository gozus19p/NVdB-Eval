  "senses": [
    {
      "pos": "sostantivo, m.",
      "definition": "Elemento scritto, come un resoconto o un commento, pubblicato su un giornale, una rivista o altro mezzo di comunicazione di massa.",
      "examples": [
        "La giornalista ha scritto un articolo approfondito sulla crisi climatica.",
        "Ho letto un interessante articolo di opinione sul quotidiano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, m.",
      "definition": "Ciascuna delle singole unità o voci elencate in un documento legale o normativo, come una legge o un trattato.",
      "examples": [
        "Il progetto di legge è composto da venti articoli.",
        "L'articolo 1 della Costituzione definisce i principi fondamentali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, m.",
      "definition": "Oggetto distinto e vendibile, tipicamente parte di un assortimento commerciale o di un inventario.",
      "examples": [
        "Il negozio di casalinghi vende articoli per la casa di ogni tipo.",
        "L'articolo più richiesto nel catalogo è quello in edizione limitata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, m.",
      "definition": "Parte del discorso che precede un nome o un sintagma nominale, specificandone il riferimento in modo determinativo o indeterminativo.",
      "examples": [
        "Nella frase 'Il gatto dorme', 'il' è un articolo determinativo.",
        "L'articolo indeterminativo 'un' introduce un'entità non specificata."
      ],
      "nota": "In linguistica, si distingue tra articolo determinativo (il, lo, la, i, gli, le) e indeterminativo (un, uno, una)."
    }
  ]
