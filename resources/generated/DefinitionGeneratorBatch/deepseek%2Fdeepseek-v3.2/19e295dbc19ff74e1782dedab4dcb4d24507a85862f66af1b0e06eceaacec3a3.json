  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova in una posizione diametralmente contraria rispetto a qualcosa o qualcuno.",
      "examples": [
        "La loro casa si trova sulla strada opposta alla nostra.",
        "Le squadre si schierarono sui lati opposti del campo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è in completa antitesi per natura, qualità, direzione o valore.",
      "examples": [
        "Avevamo opinioni opposte sulla questione.",
        "Il freddo e il caldo sono sensazioni opposte."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La cosa, la persona o la qualità che è in diretta e totale contrapposizione a un'altra.",
      "examples": [
        "Il bianco è l'opposto del nero.",
        "La sua reazione fu l'opposto di quello che mi aspettavo."
      ],
      "nota": null
    }
  ]
