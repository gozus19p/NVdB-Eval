  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta caratteristiche non identiche a un altro elemento confrontato.",
      "examples": [
        "I loro approcci al problema sono molto diversi.",
        "Abbiamo visitato città con culture completamente diverse."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Più di uno, di vario tipo; alcuni.",
      "examples": [
        "Ho ricevuto diverse telefonate oggi.",
        "Diverse persone hanno espresso la stessa opinione."
      ],
      "nota": "In questo senso, 'diverso' è spesso usato al plurale e precede un sostantivo."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si discosta dalla norma, dall'ordinario o dal convenzionale.",
      "examples": [
        "Ha uno stile di vita molto diverso dalla media.",
        "È una soluzione diversa, ma potrebbe funzionare."
      ],
      "nota": null
    },
    {
      "pos": "pronome",
      "definition": "Un'altra persona o cosa, non specificata.",
      "examples": [
        "Non sono io, è un altro.",
        "Ne ho visti due, ma altri erano nascosti."
      ],
      "nota": "In questo uso, 'diverso' funziona come pronome indefinito, spesso al plurale ('altri')."
    }
  ]
