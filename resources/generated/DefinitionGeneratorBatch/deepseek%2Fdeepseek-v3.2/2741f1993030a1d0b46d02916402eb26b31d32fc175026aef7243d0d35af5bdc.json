  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Muoversi nello stesso percorso di una persona o cosa che precede, mantenendosi dietro di essa.",
      "examples": [
        "L'agente pedinava il sospettato senza farsi vedere.",
        "Il cane seguì il padrone per tutto il tragitto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Concentrare l'attenzione e le proprie facoltà percettive su qualcosa o qualcuno che si muove o si manifesta.",
      "examples": [
        "È difficile seguire il plot di quel film così intricato.",
        "Tutti seguivano con il naso all'insù il volo della mongolfiera."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Procedere in accordo con le indicazioni, le regole o il modello di qualcuno o qualcosa.",
      "examples": [
        "Il programmatore deve seguire scrupolosamente le specifiche tecniche.",
        "Il suo stile pittorico seguiva la corrente impressionista."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Essere temporalmente successivo a un evento, una fase o una condizione.",
      "examples": [
        "Allo scandalo seguì un lungo periodo di silenzio.",
        "Alla primavera segue l'estate."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Trarre le conseguenze logiche da una premessa o da una condizione.",
      "examples": [
        "Da quella premessa non può che seguire una conclusione sbagliata.",
        "Se il prezzo scende, ne segue una maggiore domanda."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo/intransitivo (impersonale)",
      "definition": "Frequentare un corso di istruzione o formazione.",
      "examples": [
        "Molti studenti seguono le lezioni online.",
        "Si segue un master in marketing digitale."
      ],
      "nota": "Nell'uso intransitivo impersonale, il verbo si costruisce spesso con 'si' ('si segue un corso')."
    }
  ]
