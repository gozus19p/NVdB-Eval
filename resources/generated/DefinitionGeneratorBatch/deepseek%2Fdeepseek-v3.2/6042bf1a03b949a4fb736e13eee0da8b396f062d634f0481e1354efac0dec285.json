  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Acquisire conoscenza o abilità attraverso lo studio, l'esperienza o l'insegnamento.",
      "examples": [
        "Ha deciso di imparare il francese prima di trasferirsi a Parigi.",
        "Il bambino ha imparato ad andare in bicicletta in un solo pomeriggio."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Memorizzare una sequenza di informazioni, come un testo o una parte teatrale.",
      "examples": [
        "L'attrice ha dovuto imparare un monologo di due pagine per l'audizione.",
        "Per l'esame di storia, dovrò imparare tutte le date a memoria."
      ],
      "nota": "In questo senso è spesso sinonimo di 'mandare a memoria' o 'memorizzare'."
    },
    {
      "pos": "verbo transitivo/intransitivo",
      "definition": "Trarre una lezione o un insegnamento da un'esperienza, positiva o negativa.",
      "examples": [
        "Dagli errori si può solo imparare per migliorarsi.",
        "Spero che tu abbia imparato la lezione e non ripeta lo stesso sbaglio."
      ],
      "nota": "Questo senso figurato implica spesso un cambiamento di comportamento futuro."
    }
  ]
