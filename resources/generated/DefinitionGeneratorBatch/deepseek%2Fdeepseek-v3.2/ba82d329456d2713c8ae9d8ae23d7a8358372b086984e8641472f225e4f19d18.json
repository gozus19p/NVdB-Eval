  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Parte chiusa della mano con le dita piegate contro il palmo, usata per colpire",
      "examples": [
        "Si è fatto male al polso quando ha sferrato un pugno violentissimo.",
        "Ha stretto i pugni per contenere la rabbia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Colpo inferto con la parte chiusa della mano",
      "examples": [
        "L'aggressione è avvenuta con un pugno al viso.",
        "Durante la rissa hanno scambiato pugni e calci."
      ],
      "nota": "L'accezione si riferisce all'azione di colpire, distinta dalla parte anatomica."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Quantità che può essere contenuta in una mano chiusa, spesso riferita a oggetti piccoli e solidi",
      "examples": [
        "Ha aggiunto un pugno di farina nell'impasto.",
        "Raccogliamo un pugno di sassolini per decorare il vaso."
      ],
      "nota": "L'uso è di tipo metaforico e indicativo per una piccola quantità indeterminata."
    }
