  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Mutua intesa o conformità di opinioni, decisioni o volontà tra due o più persone, raggiunta dopo una trattativa.",
      "examples": [
        "Le due parti hanno finalmente trovato un accordo sul prezzo.",
        "Abbiamo preso questo accordo per il bene di tutti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Documento o patto formale che stabilisce diritti, obblighi e condizioni tra le parti, spesso giuridicamente vincolante.",
      "examples": [
        "Il contratto di lavoro è un accordo scritto.",
        "Il governo ha firmato un accordo commerciale con l'Unione Europea."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Armonia o consonanza nella combinazione di suoni, colori o elementi diversi.",
      "examples": [
        "L'accordo delle sue voci era perfetto.",
        "L'accordo dei colori in quel quadro è molto piacevole."
      ],
      "nota": "Particolarmente comune in musica e arte."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Conformità, corrispondenza o adattamento armonico di una cosa a un'altra.",
      "examples": [
        "C'è un perfetto accordo tra le sue parole e le sue azioni.",
        "La costruzione deve essere in accordo con le norme urbanistiche."
      ],
      "nota": null
    }
  ]
