  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Continuare un'azione, un'attività o uno spostamento già avviati.",
      "examples": [
        "Nonostante la stanchezza, la squadra decise di proseguire nell'allenamento.",
        "La strada prosegue diritto per altri cinque chilometri."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Continuare a svolgere qualcosa, spesso un discorso o un percorso specifico.",
      "examples": [
        "Dopo una breve pausa, l'oratore proseguì il suo intervento.",
        "Proseguirono il viaggio nonostante le avverse condizioni meteorologiche."
      ],
      "nota": "Questo uso come transitivo è comune quando il complemento oggetto è un'attività discorsiva (es. discorso, ragionamento) o uno spostamento lungo un percorso specifico."
    }
