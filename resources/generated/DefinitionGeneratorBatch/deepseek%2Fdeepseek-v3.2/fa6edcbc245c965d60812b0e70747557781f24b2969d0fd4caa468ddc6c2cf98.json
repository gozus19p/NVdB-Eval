  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Somma di denaro che una persona o entità deve a un'altra, derivante da un prestito, un acquisto non saldato o un obbligo finanziario simile.",
      "examples": [
        "Ha finalmente estinto il debito con la banca dopo anni di sacrifici.",
        "L'azienda sta rinegoziando i suoi debiti per evitare il fallimento."
      ],
      "nota": "Contrapposto a 'credito'. Spesso usato in ambito finanziario, giuridico ed economico."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Obligo morale, sociale o di gratitudine percepito nei confronti di qualcuno o qualcosa.",
      "examples": [
        "Sento di avere un grande debito di riconoscenza verso i miei genitori.",
        "La società ha un debito verso i pionieri della ricerca scientifica."
      ],
      "nota": "Uso figurato comune, esprime un dovere non finanziario ma etico o affettivo."
    }
  ]
