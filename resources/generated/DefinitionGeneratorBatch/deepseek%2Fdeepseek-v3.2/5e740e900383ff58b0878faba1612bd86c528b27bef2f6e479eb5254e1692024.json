  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Porre in essere un'azione che viola una norma, un precetto o una legge, ed è considerata riprovevole.",
      "examples": [
        "Le autorità investigano per stabilire chi abbia commesso il furto.",
        "Ammettere di aver commesso un errore è segno di maturità."
      ],
      "nota": "Usato tipicamente con sostantivi che indicano reati o azioni negative (delitto, omicidio, errore, ingiustizia)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Consegnare qualcosa o qualcuno alla custodia o alla responsabilità di un'altra persona.",
      "examples": [
        "Il giudice decise di commettere l'imputato al carcere.",
        "Commetterò a voi il compito di organizzare l'evento."
      ],
      "nota": "Questo senso è oggi più raro e tendenzialmente formale o giuridico."
    }
  ]
