  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Partecipare a un'attività ludica, di svago o di competizione con regole prestabilite.",
      "examples": [
        "I bambini giocano in cortile con una palla.",
        "Stasera giochiamo a carte con i vicini."
      ],
      "nota": "Spesso seguito dalla preposizione \"a\" per indicare il gioco specifico (es. \"giocare a calcio\")."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Mettere in atto una mossa, una carta, un pezzo o un elemento analogo nel corso di un gioco o di una partita.",
      "examples": [
        "Ha giocato l'asso di cuori, vincendo la mano.",
        "Nella prossima mossa, giocherò il cavallo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Scommettere denaro in giochi d'azzardo.",
      "examples": [
        "Non dovresti giocare così tanto alle slot machine.",
        "Alcuni vanno al casinò solo per giocare."
      ],
      "nota": "Implica il rischio di perdita economica."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Partecipare a una competizione sportiva in modo professionistico o a livello agonistico.",
      "examples": [
        "Messi ha giocato nel Barcellona per molti anni.",
        "La squadra giocherà la finale domenica prossima."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (figurato)",
      "definition": "Agire in modo non serio o frivolo, senza considerare adeguatamente le conseguenze.",
      "examples": [
        "Non giocare con i sentimenti degli altri.",
        "Non si gioca con la sicurezza sul lavoro."
      ],
      "nota": "Usato spesso in contesti negativi o di ammonimento."
    },
    {
      "pos": "verbo intransitivo (figurato)",
      "definition": "Muoversi o interagire in modo vivace, variabile o imprevedibile, detto soprattutto di luce, colori o elementi naturali.",
      "examples": [
        "I riflessi del sole giocano sulla superficie dell'acqua.",
        "Un sorriso gli giocava sulle labbra."
      ],
      "nota": "Indica un movimento leggero, spesso associato a un effetto piacevole alla vista."
    }
  ]
