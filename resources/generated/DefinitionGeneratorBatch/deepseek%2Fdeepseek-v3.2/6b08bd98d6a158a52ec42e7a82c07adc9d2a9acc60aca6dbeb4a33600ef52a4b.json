  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Attività e pratica di governo, gestione delle relazioni di potere all'interno di una comunità, organizzazione o stato, e l'insieme delle azioni e delle scelte che le riguardano.",
      "examples": [
        "La politica estera del paese è molto discussa.",
        "Si è sempre interessato alla politica fin da giovane."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Indirizzo programmatico, linea d'azione o insieme di principi adottati da un partito, un governo, un'organizzazione o un individuo in ambito pubblico.",
      "examples": [
        "La politica aziendale prevede il lavoro da casa due giorni a settimana.",
        "Il ministro ha illustrato la nuova politica sociale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Arte o abilità nel gestire relazioni interpersonali o di gruppo in modo accorto e spesso opportunista per raggiungere i propri fini.",
      "examples": [
        "Ci vuole molta politica per navigare in quell'ambiente di lavoro.",
        "La sua ascesa è stata più frutto di politica che di merito."
      ],
      "nota": "In questa accezione, il termine assume spesso una connotazione negativa, associata a calcolo e manovre."
    }
  ]
