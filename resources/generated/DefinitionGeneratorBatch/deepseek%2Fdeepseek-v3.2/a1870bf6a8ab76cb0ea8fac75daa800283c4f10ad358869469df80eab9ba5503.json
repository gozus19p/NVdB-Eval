  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Entità spirituale, essenza celeste, considerata messaggera o servo di una divinità, di natura tipicamente benigna.",
      "examples": [
        "Secondo la tradizione, l'angelo Gabriele annunciò la nascita di Gesù.",
        "Nell'iconografia, gli angeli sono spesso raffigurati con le ali."
      ],
      "nota": "L'uso al femminile (\"angela\") è raro e non standard nella lingua contemporanea."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona dotata di qualità eccezionalmente buone, gentili o pure.",
      "examples": [
        "Quella bambina è un vero angelo, sempre pronta ad aiutare.",
        "Grazie per il tuo sostegno, sei stato un angelo in questo momento difficile."
      ],
      "nota": "Uso figurato e valutativo, spesso affettivo o iperbolico."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Soggetto di aspetto particolarmente bello, delicato o innocente.",
      "examples": [
        "Con quei riccioli biondi e gli occhi azzurri, il bambino sembra un angelo.",
        "Il suo volto da angelo contrastava con il carattere determinato."
      ],
      "nota": "Uso metaforico legato prevalentemente all'aspetto fisico, spesso riferito a bambini o giovani."
    }
  ]
