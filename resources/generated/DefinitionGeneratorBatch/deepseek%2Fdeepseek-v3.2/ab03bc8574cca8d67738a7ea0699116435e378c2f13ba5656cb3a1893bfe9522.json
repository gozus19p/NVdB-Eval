  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova al limite massimo o terminale di una scala, di una serie o di uno spazio.",
      "examples": [
        "La sua pazienza aveva raggiunto un punto estremo.",
        "Sono seduti ai due lati estremi del tavolo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Molto intenso, marcato o radicale, che spinge al limite una qualità o una condizione.",
      "examples": [
        "Il governo ha adottato misure estreme per contenere l'epidemia.",
        "Si tratta di una posizione politica estrema e poco conciliante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Il grado massimo o il punto limite di una condizione, di una situazione o di un processo.",
      "examples": [
        "Spesso la disperazione spinge le persone all'estremo.",
        "Ha affrontato la prova portando la sua resistenza all'estremo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Punto, elemento o individuo che occupa la posizione più periferica o terminale in una serie, in un gruppo o in uno spazio.",
      "examples": [
        "Il libro si trovava sull'estremo dello scaffale.",
        "Gli estremi dello schieramento politico si rifiutano di dialogare."
      ],
      "nota": null
    }
  ]
