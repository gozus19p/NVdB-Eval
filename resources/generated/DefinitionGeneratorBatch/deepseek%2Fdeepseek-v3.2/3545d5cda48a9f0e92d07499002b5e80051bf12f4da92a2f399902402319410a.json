  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo al momento presente, all'anno o al mese in corso.",
      "examples": [
        "La legge corrente non prevede questa disposizione.",
        "Il bilancio corrente mostra un leggero miglioramento rispetto allo scorso anno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che scorre, che fluisce in modo continuo.",
      "examples": [
        "Con il rubinetto corrente, non c'è mai abbastanza acqua calda.",
        "La lava corrente del vulcano minacciava i villaggi sottostanti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è in uso comune, diffuso o generalmente accettato.",
      "examples": [
        "È una pratica corrente in molti uffici.",
        "L'opinione corrente è che sia stato un incidente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Movimento continuo di un fluido, in particolare acqua o aria, in una direzione determinata.",
      "examples": [
        "La corrente del fiume era così forte da rendere pericolosa la traversata.",
        "Una forte corrente d'aria ha spento le candele."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Flusso di energia elettrica che attraversa un conduttore.",
      "examples": [
        "La casa è rimasta senza corrente elettrica per diverse ore.",
        "Assicurati di staccare la corrente prima di lavorare sull'impianto."
      ],
      "nota": "Abbreviazione comune di 'corrente elettrica'."
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Indirizzo, tendenza o movimento prevalente di pensiero, opinioni o comportamenti in un dato ambito.",
      "examples": [
        "La corrente principale della critica è favorevole alla nuova teoria.",
        "Nel partito esistono diverse correnti di pensiero."
      ],
      "nota": null
    }
  ]
