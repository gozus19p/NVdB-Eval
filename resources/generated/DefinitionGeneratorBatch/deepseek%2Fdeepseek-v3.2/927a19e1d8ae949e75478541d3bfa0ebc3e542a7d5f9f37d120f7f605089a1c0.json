  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi fluendo, per lo più in modo continuo e lineare, come un liquido.",
      "examples": [
        "Il fiume scorre placido verso il mare.",
        "Le lacrime le scorsero lungo le guance."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trascorrere, avanzare nel tempo in modo continuo e spesso percepito come rapido.",
      "examples": [
        "Le giornate di vacanza scorsero via troppo in fretta.",
        "Con la lettura, il tempo sembra scorrere più piacevolmente."
      ],
      "nota": "Senso figurato riferito al tempo."
    },
    {
      "pos": "verbo intransitivo/transitivo (ausiliare avere)",
      "definition": "Scivolare rapidamente sopra una superficie, con contatto leggero o senza penetrarla.",
      "examples": [
        "Le sue dita scorsero sui tasti del pianoforte.",
        "Scorse rapidamente gli occhi sulla lista dei nomi."
      ],
      "nota": "Nel senso transitivo indica far muovere qualcosa in questo modo (es. scorrere un dito sulla mappa)."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Procedere o svilupparsi in modo lineare e ordinato.",
      "examples": [
        "La conversazione scorreva senza intoppi.",
        "Il programma della serata è scritto qui, scorre dall'alto verso il basso."
      ],
      "nota": null
    }
