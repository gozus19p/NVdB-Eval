  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Stringere una persona con le braccia per manifestare affetto, saluto o consolazione.",
      "examples": [
        "La madre abbracciò il figlio al suo ritorno dal viaggio.",
        "Si abbracciarono con calore dopo anni di separazione."
      ],
      "nota": "Può esprimere anche congratulazioni o sostegno emotivo."
    },
    {
