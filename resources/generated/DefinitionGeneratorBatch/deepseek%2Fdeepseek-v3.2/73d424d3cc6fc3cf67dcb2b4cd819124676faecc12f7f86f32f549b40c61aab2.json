  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Pronunciare parole o compiere azioni con intenzione di provocare divertimento o ilarità, senza serietà.",
      "examples": [
        "Stava solo scherzando quando ha detto che avrebbe lasciato il lavoro.",
        "Durante la cena, hanno scherzato per tutta la sera."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Non essere affatto serio o impegnativo; essere facile o di poca importanza.",
      "examples": [
        "Questa prova è uno scherzo rispetto all'esame finale.",
        "Per lui, correre una maratona è uno scherzare."
      ],
      "nota": "Uso figurato, spesso seguito da preposizioni come 'rispetto a' o 'con'."
    }
