  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rivolgersi a qualcuno utilizzando il suo nome o un appellativo per attrarre la sua attenzione o per stabilire un contatto verbale",
      "examples": [
        "L'ho chiamata più volte, ma non mi ha sentito.",
        "Chiama il cameriere, per favore."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Contattare qualcuno per mezzo del telefono",
      "examples": [
        "Ti chiamo stasera per confermare l'appuntamento.",
        "Mi ha chiamato dal lavoro per dirmi che sarebbe stato in ritardo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Convocare o invitare qualcuno in un luogo o a partecipare a un evento",
      "examples": [
        "Il direttore ha chiamato tutti i dipendenti in riunione.",
        "Siamo stati chiamati a testimoniare in tribunale."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Assegnare un nome a qualcosa o a qualcuno",
      "examples": [
        "Hanno chiamato la bambina Lucia.",
        "Come chiamerete il nuovo ristorante?"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Richiedere la presenza o l'intervento di qualcuno per un compito specifico",
      "examples": [
        "In caso di emergenza, chiamate subito i soccorsi.",
        "Dovremo chiamare un idraulico per quella perdita."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Considerare o descrivere qualcuno o qualcosa in un certo modo",
      "examples": [
        "Non chiamerei questo comportamento corretto.",
        "Molti lo chiamano un genio."
      ],
      "nota": "Uso valutativo o attributivo."
    },
    {
      "pos": "verbo transitivo pronominale (chiamarsi)",
      "definition": "Avere come proprio nome; essere denominato in un certo modo",
      "examples": [
        "Mi chiamo Marco.",
        "Come si chiama quella montagna?"
      ],
      "nota": null
    }
  ]
