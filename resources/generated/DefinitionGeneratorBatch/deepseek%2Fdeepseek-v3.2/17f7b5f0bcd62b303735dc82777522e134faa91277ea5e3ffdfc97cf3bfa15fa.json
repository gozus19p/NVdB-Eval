  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Parte più bassa o fondamentale di una struttura fisica o di un concetto astratto, su cui poggia o da cui si sviluppa il resto.",
      "examples": [
        "La base della montagna era coperta di neve.",
        "La sua teoria ha una base logica solida."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Luogo o struttura che funge da centro per operazioni, in particolare militari, sportive o commerciali.",
      "examples": [
        "La nave è tornata alla base dopo la missione.",
        "L'azienda ha aperto una nuova base operativa in Asia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Sostanza chimica che, in soluzione acquosa, libera ioni ossidrile e neutralizza gli acidi.",
      "examples": [
        "Il sapone è una base debole.",
        "L'ammoniaca è una base comune utilizzata in molti prodotti per la pulizia."
      ],
      "nota": "Termine specifico della chimica."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Prima delle quattro posizioni che un giocatore deve toccare per segnare un punto nel gioco del baseball.",
      "examples": [
        "Il corridore è riuscito a raggiungere la prima base.",
        "La palla è stata lanciata verso la seconda base."
      ],
      "nota": "Termine specifico del baseball."
    },
    {
      "pos": "aggettivo",
      "definition": "Che costituisce il fondamento o l'elemento primario e indispensabile.",
      "examples": [
        "Hanno spiegato le regole base del gioco.",
        "Il corso fornisce una conoscenza base della materia."
      ],
      "nota": "Invariabile nel genere e nel numero. Può essere posposto o anteposto al nome."
    }
  ]
