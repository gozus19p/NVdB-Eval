  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Una delle due parti opposte in cui può essere diviso uno spazio, un corpo o un insieme, opposta a quella normalmente associata alla mano che si usa per scrivere o che domina l'attività manuale.",
      "examples": [
        "Gira a sinistra al prossimo incrocio.",
        "Metti la tazza sul tavolo alla tua sinistra."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Partito, movimento o insieme di posizioni politiche che privilegia il cambiamento sociale, l'uguaglianza e l'intervento dello stato nell'economia.",
      "examples": [
        "Il partito di sinistra ha vinto le elezioni.",
        "Il dibattito politico vede spesso contrapposti la destra e la sinistra."
      ],
      "nota": "Si contrappone tipicamente a 'destra' nel significato politico."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo alla parte opposta a quella normalmente associata alla mano dominante.",
      "examples": [
        "Ha un problema al braccio sinistro.",
        "La ruota sinistra della macchina era a terra."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di persona, che usa preferibilmente la mano opposta a quella dominante nella maggioranza della popolazione.",
      "examples": [
        "Mio figlio è mancino, scrive con la mano sinistra.",
        "È un tennista sinistro molto talentuoso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che suscita un'impressione di sfortuna, cattivo presagio o che è considerato sfavorevole.",
      "examples": [
        "Avere un corvo nero sulla finestra è stato visto come un segno sinistro.",
        "Quell'incontro fu preludio a eventi sinistri."
      ],
      "nota": "In questo senso è spesso letterario o elevato."
    }
  ]
