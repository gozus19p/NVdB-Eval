  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che agisce con forza fisica bruta, intenzionale e aggressiva, causando o minacciando di causare danno a persone o cose.",
      "examples": [
        "La repressione del corteo da parte delle forze dell'ordine fu particolarmente violenta.",
        "Ha un carattere violento e perde spesso il controllo quando si arrabbia."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di fenomeno naturale, situazione o manifestazione che si verifica con intensità e potenza eccezionali, in modo distruttivo o travolgente.",
      "examples": [
        "La tempesta fu così violenta che sradicò numerosi alberi.",
        "Lo scontro politico in parlamento è stato particolarmente violento."
      ],
      "nota": "L'uso si estende dalla forza fisica a quella metaforica, mantenendo la connotazione di intensità estrema."
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato da colori, contrasti o sensazioni forti, sgargianti, che colpiscono con immediatezza e spesso in modo stridente.",
      "examples": [
        "Il quadro è dominato da un rosso violento che attira immediatamente lo sguardo.",
        "Il profumo di quel fiore è così violento che può dare mal di testa."
      ],
      "nota": "Uso figurato che applica il concetto di forza intensa alle percezioni sensoriali."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che compie o è incline a compiere atti di aggressività fisica.",
      "examples": [
        "È stato denunciato come un violento dopo l'aggressione in strada.",
        "La legge deve proteggere le vittime dai violenti."
      ],
      "nota": "Uso sostantivato dell'aggettivo corrispondente."
    }
  ]
