  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Singola entità umana considerata nella sua specificità e distinta da altri",
      "examples": [
        "L’individuo fermato dalla polizia ha fornito tutte le sue generalità.",
        "Ogni individuo ha il diritto alla propria libertà di pensiero."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Singolo esemplare appartenente a una specie animale o vegetale",
      "examples": [
        "I biologi hanno catturato un individuo di quella specie per studiarlo.",
        "Ogni individuo di quella colonia di api svolge un ruolo preciso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona considerata, spesso con sfumatura negativa o neutra, senza riferimento alle sue qualità specifiche",
      "examples": [
        "Non si può fidare di quell’individuo losco.",
        "Un individuo sconosciuto ha bussato alla porta."
      ],
      "nota": "In questo senso, il termine può assumere una connotazione spregiativa o semplicemente generica, deindividualizzante."
    }
  ]
