  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento strutturale superiore che delimita e copre un edificio o un veicolo, proteggendo dall'esterno.",
      "examples": [
        "Il vento forte ha sollevato alcune tegole del tetto della casa.",
        "Dobbiamo riparare il tetto dell'auto dopo la grandinata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Limite massimo imposto a una quantità, come un prezzo, una spesa o un valore.",
      "examples": [
        "Il governo ha introdotto un tetto alle spese pubblicitarie per le campagne elettorali.",
        "Il contratto prevede un tetto massimo di rimborso per le spese mediche."
      ],
      "nota": "Uso figurato comune in contesti amministrativi, economici e contrattuali."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Livello massimo raggiungibile o concepibile in una scala di valori, prestazioni o possibilità.",
      "examples": [
        "Con quel nuovo motore, l'aereo ha toccato il tetto della sua velocità operativa.",
        "Per molti atleti, vincere una medaglia olimpica rappresenta il tetto delle proprie ambizioni sportive."
      ],
      "nota": "Uso figurato che esprime un confine superiore ideale o reale."
    }
