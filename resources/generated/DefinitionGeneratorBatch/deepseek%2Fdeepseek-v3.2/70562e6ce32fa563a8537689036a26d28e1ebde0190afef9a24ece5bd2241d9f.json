  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Sostanza formata da minutissime particelle solide di vario tipo, provenienti da disfacimento o erosione di altri materiali, che si deposita sulle superfici.",
      "examples": [
        "Dopo una settimana di vacanza, si era accumulata molta polvere sui mobili.",
        "Dovresti passare l'aspirapolvere perché c'è della polvere sul pavimento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Particelle solide finemente triturate di una sostanza specifica.",
      "examples": [
        "Ha aggiunto un pizzico di polvere di cannella all'impasto.",
        "In quella fabbrica si produce polvere di marmo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Stato o condizione di un corpo ridotto a frammenti minutissimi, spesso come risultato di una distruzione completa.",
      "examples": [
        "Dopo l'esplosione, l'edificio è stato ridotto in polvere.",
        "La statua di gesso cadde e si frantumò in polvere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Sostanza in polvere usata in cosmesi.",
      "examples": [
        "Ha applicato un po' di polvere sul viso prima di uscire.",
        "Questa polvere compatta ha una buona coprenza."
      ],
      "nota": "Riferito specificamente a prodotti per il trucco."
    }
  ]
