  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Parte prominente del viso tra gli occhi e la bocca, organo dell'olfatto e del respiro.",
      "examples": [
        "Si è rotto il naso durante la partita di pallacanestro.",
        "Con il raffreddore, il naso mi cola continuamente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Senso dell'olfatto.",
      "examples": [
        "Il cane ha un naso finissimo.",
        "Ha un naso da chef per gli aromi complessi."
      ],
      "nota": "Uso metonimico comune, spesso nelle espressioni 'aver buon naso', 'fidarsi del proprio naso'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Capacità intuitiva o perspicacia nel prevedere o individuare qualcosa.",
      "examples": [
        "Il poliziotto ha avuto un gran naso per scovare la pista giusta.",
        "Il manager ha dimostrato un ottimo naso per gli affari."
      ],
      "nota": "Uso figurato, tipico di espressioni come 'aver naso', 'avere fiuto'. Può sovrapporsi con la metonimia per il senso dell'olfatto, ma qui il riferimento è alle capacità cognitive."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte anteriore o protuberanza di un oggetto che ricorda la forma dell'organo o funge da elemento frontale.",
      "examples": [
        "Il naso dell'aereo era dipinto con colori vivaci.",
        "Sono urtato contro il naso del mobile."
      ],
      "nota": null
    }
