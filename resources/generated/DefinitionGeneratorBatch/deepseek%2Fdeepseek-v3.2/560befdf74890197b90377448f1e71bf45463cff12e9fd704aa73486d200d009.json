    {
      "pos": "aggettivo",
      "definition": "Che si riferisce o è proprio dell'Italia, del suo territorio, della sua popolazione, della sua cultura o della sua lingua.",
      "examples": [
        "La cucina italiana è famosa in tutto il mondo.",
        "La squadra italiana ha vinto il campionato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Cittadino di nazionalità o discendente dell'Italia.",
      "examples": [
        "Mio nonno era un italiano emigrato in America.",
        "In questa comunità ci sono molti italiani."
      ],
      "nota": "Usato anche al femminile (italiana)."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Lingua romanzo-parlata ufficialmente in Italia e in alcune zone della Svizzera.",
      "examples": [
        "Sto imparando l'italiano all'università.",
        "La traduzione dall'inglese all'italiano è molto precisa."
      ],
      "nota": null
    }
