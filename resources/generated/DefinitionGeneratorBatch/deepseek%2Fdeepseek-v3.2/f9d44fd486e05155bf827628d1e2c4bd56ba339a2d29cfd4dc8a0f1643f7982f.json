  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Parte terminale dell'arto superiore dell'uomo, dal polso in giù, comprendente palma, dorso e dita.",
      "examples": [
        "Si è scottata la mano toccando la pentola.",
        "Il bambino stringeva la mia mano per attraversare la strada."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Operazione di applicazione di qualcosa sulla superficie di un oggetto.",
      "examples": [
        "La parete avrà bisogno di una seconda mano di vernice.",
        "Dopo la prima mano di stucco, la superficie è più liscia."
      ],
      "nota": "Usato soprattutto nell'ambito della pittura, della finitura o della cosmetica."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Giro di carte distribuite o giocate in un determinato momento di una partita.",
      "examples": [
        "Vincere questa mano è cruciale per il punteggio finale.",
        "Ha giocato la sua ultima carta, chiudendo la mano."
      ],
      "nota": "Tipico dei giochi di carte."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Aiuto concreto, sostegno materiale offerto a qualcuno per compiere un'azione.",
      "examples": [
        "Mi serve una mano per spostare questo divano.",
        "Grazie per la mano che mi hai dato con le buste della spesa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Stile o caratteristica distintiva dell'opera di un artista, riconoscibile nella sua esecuzione.",
      "examples": [
        "Si riconosce la mano del maestro in questi chiaroscuri.",
        "Il restauro deve rispettare la mano originale del pittore."
      ],
      "nota": "Usato in ambito artistico e artigianale."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Scrittura, calligrafia caratteristica di una persona.",
      "examples": [
        "Ha una mano così chiara che i suoi appunti sono sempre leggibili.",
        "Riconosco la tua mano dalle lettere eleganti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Lato sinistro o destro di una strada o di un percorso.",
      "examples": [
        "In Inghilterra si guida a mano sinistra.",
        "Il negozio si trova sulla mano destra procedendo verso il centro."
      ],
      "nota": "Usato spesso nella locuzione 'a mano sinistra/destra'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Misura di lunghezza equivalente alla larghezza di una mano, circa 10 cm.",
      "examples": [
        "Il cavallo era alto più di sedici mani.",
        "Lasciare una mano di spazio tra i vasi."
      ],
      "nota": null
    }
