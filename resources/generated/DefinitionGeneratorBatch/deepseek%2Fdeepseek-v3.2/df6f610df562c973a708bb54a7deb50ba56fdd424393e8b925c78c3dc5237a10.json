      "pos": "sostantivo maschile",
      "definition": "Divisione amministrativa o urbana di una città, costituita da un insieme di edifici e strade.",
      "examples": [
        "Stanno costruendo un nuovo palazzo in quel quartiere.",
        "Il centro storico è il mio quartiere preferito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Complesso di locali riservati come alloggio, all'interno di un edificio di rappresentanza, di una caserma o di un convento.",
      "examples": [
        "Il generale ricevette gli ospiti nei suoi quartieri privati.",
        "I monaci si ritirarono nei loro quartieri dopo la preghiera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Tratto di gara nelle competizioni sportive che prevedono prove suddivise in segmenti.",
      "examples": [
        "Ha vinto il primo quartiere della gara di nuoto.",
        "Nel quartiere finale della corsa, ha dato il massimo."
      ],
      "nota": "Usato soprattutto in atletica, nuoto e ciclismo."
