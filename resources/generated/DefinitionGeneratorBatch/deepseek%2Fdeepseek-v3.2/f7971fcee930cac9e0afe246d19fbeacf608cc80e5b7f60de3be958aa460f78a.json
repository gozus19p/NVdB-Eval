  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Spostarsi da un luogo a un altro, in particolare coprendo distanze significative per vari scopi.",
      "examples": [
        "Amo viaggiare per conoscere nuove culture.",
        "Dovremo viaggiare tutta la notte per arrivare in tempo."
      ],
      "nota": "Senso basilare, relativo al movimento nello spazio. Spesso implica l'idea di movimento continuato o di percorrere un tratto di strada."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi a una certa velocità (detto di mezzi di trasporto).",
      "examples": [
        "Il treno viaggia a oltre trecento chilometri all'ora.",
        "In autostrada, la sua auto viaggiava ben oltre il limite consentito."
      ],
      "nota": "Utilizzato spesso per indicare la velocità media o sostenuta di un veicolo durante il suo percorso."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Passare o diffondersi rapidamente e su vasta scala (detto di informazioni, notizie, sentimenti).",
      "examples": [
        "La notizia dello scandalo ha viaggiato in pochi minuti su tutti i social network.",
        "Un'ondata di ottimismo sta viaggiando tra gli investitori."
      ],
      "nota": "Senso figurato che sfrutta l'idea metaforica del movimento rapido e ininterrotto tipico di un viaggio."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trascorrere il tempo o procedere in una certa condizione o stato.",
      "examples": [
        "Il nostro progetto viaggia su ottime basi e siamo fiduciosi.",
        "Con quelle premesse, la trattativa non viaggia verso una soluzione positiva."
      ],
      "nota": "Senso figurato che indica l'andamento, lo sviluppo o la situazione in cui qualcosa si trova durante il suo corso."
    }
  ]
