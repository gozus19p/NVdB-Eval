  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Porre nuovamente qualcosa nel luogo o nella condizione precedente.",
      "examples": [
        "Dopo la pulizia, ha rimesso i libri nello scaffale.",
        "Le difficoltà mi hanno rimesso al punto di partenza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Restituire una somma di denaro che era stata ricevuta o anticipata.",
      "examples": [
