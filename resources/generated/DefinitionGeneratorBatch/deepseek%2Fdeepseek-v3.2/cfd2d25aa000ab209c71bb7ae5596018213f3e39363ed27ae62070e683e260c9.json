  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Donna che esercita il potere sovrano in una monarchia.",
      "examples": [
        "La regina Elisabetta II ha regnato per oltre settant'anni.",
        "Il popolo acclamò la nuova regina con grande entusiasmo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Consorte del re.",
      "examples": [
        "La regina accompagnava il re in tutte le visite ufficiali.",
        "La morte della regina lasciò un profondo vuoto a corte."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Persona o cosa ritenuta la migliore o più importante nel suo genere.",
      "examples": [
        "La scienziata vinse il premio ed è considerata la regina della fisica.",
        "Per gli appassionati, quella varietà è la regina delle rose."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Il pezzo più potente nel gioco degli scacchi.",
      "examples": [
        "Ha sacrificato un pedone per proteggere la regina.",
        "Con la regina sotto attacco, la partita è praticamente persa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "L'unica femmina fertile in una colonia di insetti sociali, come api o formiche.",
      "examples": [
        "L'apicoltore individuò la regina nell'alveare.",
        "Senza la regina, l'intera colonia di formiche è destinata a perire."
      ],
      "nota": null
    }
