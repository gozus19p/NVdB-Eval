  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Sentimento di dubbio e diffidenza verso qualcuno o qualcosa, basato su segni percepiti come ambigui o minacciosi.",
      "examples": [
        "Il suo comportamento ambiguo ha destato i miei sospetti.",
        "Le indagini sono partite dopo un sospetto di frode."
      ],
      "nota": "Può riferirsi sia allo stato d'animo soggettivo sia al contenuto specifico del dubbio."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che è oggetto di tale sentimento di diffidenza, in particolare in un contesto investigativo o giudiziario.",
      "examples": [
        "La polizia ha identificato tre sospetti per il furto.",
        "L'interrogatorio si è concentrato sul principale sospetto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che desta o giustifica perplessità, diffidenza o l'impressione che possa nascondere qualcosa di negativo.",
      "examples": [
        "Quel pacchetto lasciato incustodito mi sembrava sospetto.",
        "Ha fatto una mossa molto sospetta durante la partita."
      ],
      "nota": null
    }
  ]
