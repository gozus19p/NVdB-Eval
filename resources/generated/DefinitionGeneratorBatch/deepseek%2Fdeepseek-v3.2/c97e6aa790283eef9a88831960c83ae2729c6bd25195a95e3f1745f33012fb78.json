  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che insegna una disciplina, un'arte o un mestiere, spesso con grande esperienza e autorità, o che guida il percorso di un allievo.",
      "examples": [
        "Il mio maestro di pianoforte mi ha insegnato la tecnica e la passione per la musica.",
        "In quella bottega artigiana, il maestro trasmetteva i segreti del mestiere ai giovani apprendisti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Individuo che ha raggiunto un livello di eccellenza e maestria riconosciuta in una determinata arte o attività.",
      "examples": [
        "Leonardo da Vinci è considerato un maestro assoluto del Rinascimento.",
        "Quell'ebanista è un vero maestro nell'intaglio del legno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Titolo di cortesia rivolto a uomini di una certa età o posizione sociale, in uso soprattutto in alcune regioni d'Italia.",
      "examples": [
        "\"Buongiorno, maestro, come sta?\" chiese il giovane al signore anziano.",
        "Il direttore della banda veniva chiamato \"maestro\" da tutti i paesani."
      ],
      "nota": "Uso regionale e/o tradizionale, talvolta formale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Chi dirige un'orchestra, un coro o un complesso musicale.",
      "examples": [
        "Il maestro ha alzato la bacchetta dando il via alla sinfonia.",
        "Il pubblico applaudì a lungo il maestro dopo il concerto."
      ],
      "nota": "In questo senso, spesso abbreviato in \"M°\"."
    },
    {
      "pos": "aggettivo",
      "definition": "Di opera, lavoro o realizzazione che dimostra una capacità tecnica e artistica superiore, esemplare.",
      "examples": [
        "Quella scultura è un'opera maestra della scultura barocca.",
        "Ha eseguito un colpo maestro risolvendo la difficile situazione."
      ],
      "nota": null
    }
  ]
