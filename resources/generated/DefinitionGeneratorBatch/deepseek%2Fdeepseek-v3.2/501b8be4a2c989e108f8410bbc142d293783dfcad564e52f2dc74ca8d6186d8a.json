  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Dispositivo elettronico che riceve e riproduce trasmissioni sonore trasmesse via onde elettromagnetiche.",
      "examples": [
        "Ha acceso la radio per ascoltare le notizie.",
        "Durante il viaggio in macchina ascoltiamo sempre la radio."
      ],
      "nota": "Si usa in opposizione a 'televisione'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Attività, settore o mezzo di comunicazione basato sulla diffusione di contenuti audio.",
      "examples": [
        "Lavora come giornalista per una radio locale.",
        "La radio trasmetteva in diretta il concerto."
      ],
      "nota": "Riferito all'istituzione, al canale di comunicazione o all'industria."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento chimico metallico, radioattivo, con numero atomico 88 (simbolo Ra).",
      "examples": [
        "Il radio fu scoperto dai coniugi Curie.",
        "La radioattività del radio è utilizzata in alcuni trattamenti medici."
      ],
      "nota": "Termine specialistico della chimica e della fisica, ma noto nell'uso comune per la sua radioattività."
    }
