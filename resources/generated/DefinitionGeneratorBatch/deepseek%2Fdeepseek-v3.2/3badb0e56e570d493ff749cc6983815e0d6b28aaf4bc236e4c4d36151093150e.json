  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Somma di denaro destinata o utilizzata per l'acquisto di beni o servizi.",
      "examples": [
        "Abbiamo ridotto le spese di casa per risparmiare.",
        "La costruzione del nuovo stadio è una spesa considerevole per il Comune."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Insieme degli alimenti e dei prodotti acquistati per uso domestico.",
      "examples": [
        "Aiutami a portare le buste della spesa dall'auto.",
        "Prima di partire, facciamo la spesa per la settimana."
      ],
      "nota": "In questo senso, il termine è tipicamente usato con verbi come 'fare', 'portare', 'sistemare'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Operazione o attività di acquisto, in particolare di prodotti alimentari o per la casa.",
      "examples": [
        "Torno fra un'ora, devo andare a fare la spesa.",
        "La spesa online è diventata molto più comoda."
      ],
      "nota": "Questo senso è semanticamente correlato al secondo, ma si focalizza sul processo d'acquisto anziché sulla merce acquistata."
    }
