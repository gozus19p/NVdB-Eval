    },
    {
      "pos": "aggettivo",
      "definition": "Preciso e formulato con terminologia specialistica, spesso in modo asettico o burocratico.",
      "examples": [
        "La relazione era scritta in un linguaggio molto tecnico e di difficile comprensione per i non addetti.",
        "Il contratto contiene diverse definizioni tecniche."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona esperta e specializzata nell'applicazione di conoscenze pratiche di un determinato settore.",
      "examples": [
        "Abbiamo chiamato un tecnico per riparare la caldaia.",
        "Il tecnico di laboratorio ha analizzato i campioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Responsabile della preparazione atletica, tattica e strategica di una squadra sportiva.",
      "examples": [
        "Il tecnico della nazionale ha annunciato la lista dei convocati.",
        "Dopo la sconfitta, il club ha deciso di cambiare tecnico."
      ],
      "nota": "Sinonimo comune di 'allenatore' nel contesto sportivo."
    }
