  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza organica che costituisce la riserva energetica di animali e piante, caratterizzata da una consistenza untuosa.",
      "examples": [
        "Per preparare il soffritto, usa un cucchiaio di grasso d'oliva.",
        "La carne di quella bistecca aveva troppo grasso visibile."
      ],
      "nota": "Nell'uso alimentare, spesso distinto in 'grasso animale' (es. strutto, burro) e 'grasso vegetale' (es. olio)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte del corpo umano o animale costituita prevalentemente da tessuto adiposo.",
      "examples": [
        "Con l'allenamento sta perdendo grasso e aumentando la massa muscolare.",
        "Il medico ha misurato la percentuale di grasso corporeo."
      ],
      "nota": "Usato spesso in contesti dietetici, sportivi o medici."
    },
    {
      "pos": "aggettivo",
      "definition": "Che contiene o è ricoperto da una quantità notevole di tessuto adiposo.",
      "examples": [
        "Dopo le feste si sentiva più grasso del solito.",
        "Il maiale è un animale tradizionalmente considerato grasso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di alimento, che contiene una elevata percentuale di lipidi.",
      "examples": [
        "I formaggi stagionati sono generalmente più grassi di quelli freschi.",
        "Cerca di evitare le salse troppo grasse."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di testo a stampa, caratterizzato da tratti marcati e spessi.",
      "examples": [
        "Metti il titolo in grassetto, ovvero in carattere grasso.",
        "Per evidenziare le parole chiave, usa il corsivo, non il grasso."
      ],
      "nota": "Il termine completo e tecnico è 'grassetto', ma 'grasso' è ampiamente usato in contesti informali o nella lingua parlata."
    },
    {
      "pos": "aggettivo",
      "definition": "Prospero, abbondante, riferito a un periodo di tempo o a una situazione economica.",
      "examples": [
        "Gli anni del boom furono anni grassi per l'economia italiana.",
        "Dopo il raccolto, finalmente arriveranno i tempi grassi."
      ],
      "nota": "Uso figurato, spesso in contrapposizione a 'magro'."
    }
  ]
