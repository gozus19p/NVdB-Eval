  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Membrana esterna che riveste il corpo degli animali vertebrati.",
      "examples": [
        "La pelle del delfino è liscia e oleosa.",
        "Durante l'estate bisogna proteggere la pelle dai raggi solari."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Materiale costituito da questa membrana conciata, utilizzato per la fabbricazione di capi d'abbigliamento, calzature o altri oggetti.",
      "examples": [
        "Questa giacca è in vera pelle.",
        "Preferisco una borsa in pelle sintetica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Superficie esterna sottile e flessibile di un oggetto o di un frutto.",
      "examples": [
        "Stai attento a non bucare la pelle della salsiccia.",
        "La pelle della mela contiene molte fibre."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Situazione di grave pericolo o di rischio concreto per l'incolumità o la vita di una persona.",
      "examples": [
        "In quell'incidente ci siamo salvati per miracolo, è andata di pelle.",
        "Durante l'assalto, ha rischiato la pelle più di una volta."
      ],
      "nota": "Espressioni come 'andare di pelle' o 'rischiare la pelle' sottolineano l'importanza dell'incolumità fisica, con riferimento metaforico alla vulnerabilità del corpo."
    }
  ]
