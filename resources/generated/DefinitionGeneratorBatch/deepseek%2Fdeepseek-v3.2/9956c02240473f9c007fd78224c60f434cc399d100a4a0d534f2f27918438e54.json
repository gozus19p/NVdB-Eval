  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Essere presente in un elenco, in una lista o in una classificazione.",
      "examples": [
        "Il suo nome figura tra i candidati al premio.",
        "Quella spesa non figura nel bilancio dell'anno scorso."
      ],
      "nota": "Specifica l'appartenenza formale o l'inclusione in un contesto enumerativo."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Apparire, essere rappresentato o menzionato in un'opera o in un contesto narrativo.",
      "examples": [
        "Il personaggio principale figura in tutte le scene del film.",
        "Nella leggenda figurano numerosi eroi e creature fantastiche."
      ],
      "nota": "Riguarda la presenza in una rappresentazione artistica, storica o discorsiva."
    },
    {
      "pos": "verbo riflessivo (figurarsi)",
      "definition": "Immaginare mentalmente qualcosa, rappresentarsela con il pensiero.",
      "examples": [
        "Non riesco a figurarmi la scena che descrivi.",
        "Si figurò un futuro pieno di successi."
      ],
      "nota": "Impresa di fantasia; spesso usato in forma interrogativa o negativa per esprimere incredulità ('Figurati se...')."
    },
    {
      "pos": "verbo riflessivo (figurarsi) - uso colloquiale",
      "definition": "Usato per rassicurare, minimizzare o rispondere a un ringraziamento, indicando che un'azione era scontata o non merita particolare riconoscenza.",
      "examples": [
        "'Grazie per l'aiuto.' 'Figurati, è stato un piacere.'",
        "'Scusa per il disturbo.' 'Figurati, non è nulla.'"
      ],
      "nota": "Formula di cortesia rispondente, equivalente a 'non c'è di che', 'prego', 'si immagini'. È un uso idiomatico consolidato."
    }
  ]
