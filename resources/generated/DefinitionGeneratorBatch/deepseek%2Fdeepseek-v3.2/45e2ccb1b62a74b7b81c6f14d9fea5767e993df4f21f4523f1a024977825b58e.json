  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Collettività di persone che abitano un determinato territorio e condividono tradizioni, lingua o origini comuni.",
      "examples": [
        "Il popolo italiano è noto per il suo attaccamento alle tradizioni culinarie.",
        "Lo studio delle migrazioni aiuta a comprendere la storia dei diversi popoli."
      ],
      "nota": "Può essere usato in senso ampio, riferito a gruppi etnici o nazionali."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Insieme dei cittadini di uno stato, considerati nella loro totalità in opposizione alle classi dirigenti.",
      "examples": [
        "Il leader si rivolse al popolo dalla piazza principale.",
        "La nuova legge è stata accolta con favore dal popolo."
      ],
      "nota": "Utilizzato spesso in contesti politici o storici."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Gruppo di persone caratterizzate da una condizione sociale modesta.",
      "examples": [
        "La taverna era frequentata soprattutto dalla gente del popolo.",
        "Quel racconto descrive la vita dura del popolo nei secoli passati."
      ],
      "nota": "Assume una connotazione sociale, talvolta con sfumatura affettiva o nostalgica."
    }
