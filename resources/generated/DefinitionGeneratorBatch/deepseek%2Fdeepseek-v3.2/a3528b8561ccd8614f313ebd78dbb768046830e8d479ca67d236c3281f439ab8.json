  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Eliminare errori, imprecisioni o difetti in qualcosa, portandolo a uno stato corretto o appropriato.",
      "examples": [
        "Il professore deve ancora correggere i compiti in classe.",
        "Prima di inviare il rapporto, è fondamentale correggere tutti i refusi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Modificare il comportamento o l'atteggiamento di qualcuno, specie un giovane, verso condotte ritenute migliori o più consone.",
      "examples": [
        "Il genitore cercava di correggere la maleducazione del figlio.",
        "Quell'esperienza negativa lo ha aiutato a correggere la sua arroganza."
      ],
      "nota": "Spesso usato in contesti educativi o di disciplina."
    },
    {
      "pos": "verbo transitivo/riflessivo",
      "definition": "Apportare una modifica a sé stessi o alle proprie azioni per rimediare a un errore o a una mancanza.",
      "examples": [
        "Dopo la critica, ha promesso di correggere il suo modo di lavorare.",
        "Devi correggerti se vuoi evitare di ripetere lo stesso sbaglio."
      ],
      "nota": "Nella forma riflessiva ('correggersi') indica un'auto-correzione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Aggiustare o regolare qualcosa, come un parametro o un dispositivo, per farlo funzionare nel modo desiderato.",
      "examples": [
        "Il tecnico è venuto per correggere la messa a punto del motore.",
        "Devi correggere la posizione della sedia per una postura ergonomica."
      ],
      "nota": null
    }
  ]
