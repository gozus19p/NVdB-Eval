  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Simulare di provare un'emozione o di avere una determinata qualità o condizione, comportandosi di conseguenza.",
      "examples": [
        "Non era arrabbiata, ma lo ha finto per far credere a tutti di avere una ragione.",
        "Ha finto disinteresse, ma si capiva che l'argomento lo toccava molto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Creare, inventare qualcosa con l'immaginazione, spesso con l'intento di ingannare.",
      "examples": [
        "Ha finto una scusa poco credibile per non presentarsi all'appuntamento.",
        "Il racconto si basa su eventi finti, anche se cercano di sembrare reali."
      ],
      "nota": "In questo senso, l'oggetto diretto è spesso una scusa, un motivo, una storia, ecc."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Fare mostra di qualcosa senza che corrisponda alla verità; comportarsi in modo non sincero.",
      "examples": [
        "Fingeva di non sentire le loro critiche.",
        "Non è il caso di fingere: siamo qui per parlare apertamente."
      ],
      "nota": "Spesso seguito da preposizioni come 'di'."
    }
  ]
