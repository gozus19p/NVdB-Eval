      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Costringere qualcuno o qualcosa in una condizione, stato o luogo peggiore o più limitato.",
      "examples": [
        "La grave crisi ha ridotto molte persone alla povertà.",
        "Le fiamme hanno ridotto la casa in cenere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Semplificare un'informazione complessa o articolata presentandola in forma più breve o essenziale.",
      "examples": [
        "Il relatore ha saputo ridurre un argomento difficile in pochi concetti chiari.",
        "Il riassunto riduce il romanzo di 300 pagine alle trame principali."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Modificare una sostanza chimica, soprattutto in ambito scientifico, sottraendo ossigeno o aggiungendo idrogeno o elettroni.",
      "examples": [
        "In quella reazione, il ferro viene ridotto da Fe³⁺ a Fe²⁺.",
        "Il processo metallurgico serve a ridurre il minerale per ottenere il metallo puro."
      ],
      "nota": "Uso specialistico prevalente in chimica e metallurgia."
    },
    {
      "pos": "verbo pronominale (ridursi)",
      "definition": "Diventare di minori dimensioni, quantità o importanza.",
      "examples": [
        "Con l'evaporazione, il liquido si è ridotto a un decimo.",
        "La sua fortuna si è ridotta notevolmente dopo gli investimenti sbagliati."
      ],
      "nota": null
    },
    {
      "pos": "verbo pronominale (ridursi)",
      "definition": "Concludersi o esprimersi essenzialmente in qualcosa.",
      "examples": [
        "Tutta la sua argomentazione si riduceva a una semplice scusa.",
        "La discussione si è ridotta a un elenco di lamentele reciproche."
      ],
      "nota": null
    }
