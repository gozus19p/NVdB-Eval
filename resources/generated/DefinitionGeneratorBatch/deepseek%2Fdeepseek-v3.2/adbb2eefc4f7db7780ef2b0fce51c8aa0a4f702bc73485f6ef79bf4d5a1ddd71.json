  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Organizzazione politica costituita per partecipare alla vita pubblica e rappresentare determinate idee e interessi, con lo scopo di conquistare e esercitare il potere.",
      "examples": [
        "Ha aderito al partito dopo un'attenta riflessione sui suoi programmi.",
        "Il partito ha deciso di presentare una mozione per modificare lo statuto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Decisione presa dopo aver considerato le diverse opzioni, scelta ritenuta vantaggiosa.",
      "examples": [
        "Dopo aver valutato i pro e i contro, ha preso il partito di rifiutare l'offerta.",
        "Il suo partito di investire tutto in quel settore si rivelò infelice."
      ],
      "nota": "Uso letterario o formale; sinonimo di 'decisione', 'risoluzione'."
    },
    {
      "pos": "aggettivo",
      "definition": "Di persona che, in una situazione conflittuale, si schiera a favore di una delle parti.",
      "examples": [
        "È sempre partito per il fratello minore in ogni discussione.",
        "Mi accorgo di essere partito e non riesco a giudicare con obiettività."
      ],
      "nota": "Usato prevalentemente in espressioni come 'essere partito'."
    }
  ]
