  "senses": [
    {
      "pos": "sostantivo, m./f.",
      "definition": "Persona che lavora alle dipendenze di un datore di lavoro, pubblico o privato, con un rapporto subordinato.",
      "examples": [
        "Il nuovo dipendente inizierà il suo lavoro lunedì prossimo.",
        "Tutti i dipendenti hanno diritto a ferie pagate."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è vincolato o condizionato dall'esistenza di qualcos'altro, a cui è subordinato.",
      "examples": [
        "La qualità del suono è dipendente dal tipo di altoparlante utilizzato.",
        "Il successo dell'iniziativa è dipendente dal supporto finanziario."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha sviluppato una condizione di assuefazione e bisogno patologico verso una sostanza psicoattiva o un comportamento.",
      "examples": [
        "È stato ricoverato in una comunità per persone dipendenti.",
        "La terapia mira a rendere il paziente non più dipendente dalla sostanza."
      ],
      "nota": null
    }
  ]
