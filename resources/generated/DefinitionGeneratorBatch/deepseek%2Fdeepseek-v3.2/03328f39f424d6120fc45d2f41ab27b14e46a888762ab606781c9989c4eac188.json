    {
      "pos": "aggettivo",
      "definition": "Di colore corrispondente alla luce pura, priva di tonalità",
      "examples": [
        "La neve è bianca.",
        "Mi piace il pane con mollica bianca."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Non scritto o privo di segni, elementi o contenuti",
      "examples": [
        "Prima di cominciare la relazione, fissò le idee su un foglio bianco.",
        "L'articolo è troppo lungo, ci sono troppe righe bianche."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Non macchiato da colpe, puro, innocente",
      "examples": [
        "Con un'anima così bianca, non poteva concepire il male.",
        "Il voto fu in bianco, nessuno lo denunciò."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di pelle chiara, tipica di alcune etnie",
      "examples": [
        "La popolazione bianca era maggioritaria in quella città.",
        "Ha i lineamenti tipici di un uomo bianco."
      ],
      "nota": "Usato come designazione etnico-razziale, può avere connotazioni problematiche; nell'uso contemporaneo va contestualizzato."
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Colore corrispondente alla luce pura, priva di tonalità",
      "examples": [
        "Il bianco è il suo colore preferito.",
        "Questo quadro è dominato dal bianco."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Tempo in cui non si svolge attività lavorativa o produttiva",
      "examples": [
        "I lavoratori hanno deciso uno sciopero e il bianco durerà tre giorni.",
        "Dopo il licenziamento, visse un periodo di bianco."
      ],
      "nota": "Uso figurato comune soprattutto in espressioni come 'fare il bianco' (scioperare) o 'bianco di disoccupazione'."
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Voto lasciato inespresso, non compilato, in una scheda elettorale",
      "examples": [
        "Il numero dei bianchi e delle schede nulle fu particolarmente alto.",
        "Si astenne, ma non votò bianco."
      ],
      "nota": "Accezione specifica in contesto politico-elettorale."
    }
  ]
