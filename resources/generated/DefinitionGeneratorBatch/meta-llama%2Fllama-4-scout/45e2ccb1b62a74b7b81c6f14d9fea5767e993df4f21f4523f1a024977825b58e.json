  "senses": [
    {
      "pos": "sostantivo",
      "definition": "Insieme delle persone che vivono in un determinato territorio e sono legate da una comune identità culturale, sociale e politica.",
      "examples": [
        "Il popolo italiano è noto per la sua passione per il calcio.",
        "Il popolo francese si è ribellato contro il governo con una grande manifestazione."
      ],
      "nota": null
