  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Testo che introduce o accompagna un'opera letteraria, artistica o musicale, indicando il suo nome e spesso l'autore",
      "examples": [
        "Il titolo del libro è 'I Promessi Sposi'",
        "Il titolo della canzone è stato cambiato all'ultimo minuto"
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ciascuno dei capi di un elenco, di una classifica o di una tabella, che ne indica il contenuto",
      "examples": [
        "Il titolo della colonna è 'Nome'",
        "Il titolo della riga è 'Data'"
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
