  "senses": [
    {
      "pos": "sostantivo",
      "definition": "Energia o potenza fisica che consente di compiere un'azione o di vincere una resistenza",
      "examples": [
        "La forza del vento ha abbattuto l'albero.",
        "Il sollevatore di pesi ha bisogno di molta forza per sollevare il massacro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo",
      "definition": "Potenza o capacità di agire o di produrre effetti",
      "examples": [
        "La forza dell'esercito ha permesso di vincere la battaglia.",
        "La forza delle sue argomentazioni ha convinto tutti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo",
      "definition": "Violenza o coazione esercitata per costringere qualcuno a fare qualcosa",
      "examples": [
        "La polizia ha usato la forza per disperdere i manifestanti.",
        "Non voglio usare la forza per risolvere il problema."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Costringere o obbligare qualcuno a fare qualcosa",
      "examples": [
        "Lo hanno forzato a partire.",
        "Non voglio forzarti a fare qualcosa che non vuoi."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Essere troppo forte o troppo intenso",
      "examples": [
        "Il caffè è troppo forte, forza troppo."
      ],
      "nota": "In questo senso, 'forza' è spesso usato in riferimento a cibi o bevande che hanno un sapore o un effetto troppo intenso."
    }
  ]
