  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "prendere su di sé una responsabilità, un compito o un ruolo",
      "examples": [
        "La società ha assunto un nuovo amministratore delegato.",
        "Il governo ha assunto la responsabilità dell'emergenza."
      ],
