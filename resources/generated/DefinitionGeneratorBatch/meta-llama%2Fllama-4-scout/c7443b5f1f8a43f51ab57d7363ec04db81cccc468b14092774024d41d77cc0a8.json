    },
    {
      "pos": "verbo transitivo",
      "definition": "prendere come vero o certo qualcosa",
      "examples": [
        "Assumo che tu sia d'accordo con me.",
        "La polizia ha assunto che il furto sia stato interno."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "ingannare, far credere qualcosa che non è",
      "examples": [
        "Mi ha assunto per un mio amico.",
        "Quel venditore mi ha assunto per un cliente soddisfatto."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "prendere una certa aria o apparenza",
      "examples": [
        "Si è assunto un'aria di superiorità.",
