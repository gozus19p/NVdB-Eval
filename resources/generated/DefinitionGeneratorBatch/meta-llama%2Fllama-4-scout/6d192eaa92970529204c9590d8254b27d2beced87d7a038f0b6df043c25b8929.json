  "senses": [
    {
      "pos": "verbo",
      "definition": "Muovere qualcosa verso di sé o in una direzione, esercitando una forza",
      "examples": [
        "Tirare la corda",
        "Tirare un oggetto verso di sé"
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Partire, muoversi rapidamente",
      "examples": [
        "Il razzo è tirato verso lo spazio",
        "Il proiettile tira verso il bersaglio"
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Esercitare una pressione su qualcosa per spostarlo o deformarlo",
      "examples": [
        "Tirare il filo per farlo passare nel buco",
        "Tirare la leva per azionare la macchina"
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Prendere una direzione, diriggersi verso un luogo",
      "examples": [
        "Mi tiro verso la cucina per prendere un bicchiere",
        "Si tira verso la porta per uscire"
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Essere tirato, essere mosso in una direzione",
      "examples": [
        "Tira vento da nord",
        "Tira una brutta aria"
      ],
      "nota": "In questo senso, il verbo è spesso usato in espressioni idiomatiche"
    },
    {
      "pos": "verbo",
      "definition": "Causare, provocare un effetto",
      "examples": [
        "La sua assenza tira su tutte le discussioni",
        "Il suo comportamento tira giù l'umore di tutti"
      ],
      "nota": "In questo senso, il verbo è spesso usato in modo figurato"
    }
  ]
