  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Sentimento di coinvolgimento, curiosità o attenzione verso qualcosa o qualcuno che si considera importante, attraente o degno di considerazione.",
      "examples": [
        "Ho un grande interesse per la storia antica egizia.",
        "Il suo nuovo progetto ha suscitato molto interesse tra i colleghi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Vantaggio o beneficio, materiale o morale, che si ricava da una situazione, attività o relazione.",
      "examples": [
        "Agisce sempre nel suo esclusivo interesse personale.",
        "È nell'interesse di tutti mantenere la pace e la stabilità."
      ],
      "nota": "Spesso usato al plurale in contesti economici o politici."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Remunerazione calcolata in percentuale sul capitale prestato o depositato, a fronte del suo utilizzo o della sua disponibilità per un certo periodo di tempo.",
      "examples": [
        "Il mutuo prevede un tasso di interesse fisso per i primi dieci anni.",
        "Gli interessi sul conto di risparmio vengono accreditati trimestralmente."
      ],
      "nota": "In ambito finanziario, può riferirsi sia alla somma netta sia al tasso percentuale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La parte o la quota di proprietà o di partecipazione che una persona ha in un'attività, un'azienda o un bene.",
      "examples": [
        "Ha venduto le sue quote di interesse nella società l'anno scorso.",
        "Il fondo ha acquisito un interesse di maggioranza nell'impresa emergente."
      ],
      "nota": "Usato principalmente in contesti economici e giuridici."
    }
  ]
