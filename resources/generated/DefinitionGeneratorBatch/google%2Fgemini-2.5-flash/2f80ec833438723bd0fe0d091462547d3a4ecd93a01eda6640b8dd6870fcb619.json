  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Individuo di una specie animale o vegetale che produce gameti di grandi dimensioni (uova o ovuli) e che è biologicamente predisposto alla gestazione e alla procreazione, se fecondato.",
      "examples": [
        "La femmina del leone è più agile del maschio e si occupa principalmente della caccia.",
        "Le api regine sono le uniche femmine fertili dell'alveare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Essere umano di sesso femminile, adulta o giovane, indipendentemente dalla sua età o condizione sociale.",
      "examples": [
        "Durante la conferenza, molte femmine hanno preso la parola per esprimere le loro opinioni.",
        "In quella famiglia, ogni femmina della stirpe aveva un carattere forte e indipendente."
      ],
      "nota": "Questo uso può talvolta essere percepito come riduttivo o descrittivo in contesti informali, ma è biologicamente neutro."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo o proprio dell'individuo che produce gameti femminili, o che presenta caratteristiche associate al genere femminile.",
      "examples": [
        "Il fiore femmina produce i semi dopo l'impollinazione.",
        "Ha un tipo di intelligenza che si potrebbe definire femmina, molto intuitiva e empatica."
      ],
      "nota": null
    }
  ]
