  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Attività professionale, per lo più manuale o artigianale, che richiede specifiche competenze pratiche e viene svolta per procurarsi di che vivere.",
      "examples": [
        "Ha imparato il mestiere di falegname da suo padre sin da giovane.",
        "Cercava un apprendista disposto a imparare il mestiere di orafo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Occupazione lavorativa in generale, indipendentemente dal tipo o dal livello di specializzazione, vista come fonte di reddito e impegno quotidiano.",
      "examples": [
        "Quel mestiere gli consente di viaggiare molto e conoscere persone nuove.",
        "È difficile cambiare mestiere alla sua età senza riqualificarsi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Abilità o pratica acquisita attraverso l'esperienza, che permette di svolgere un'attività con competenza e destrezza.",
      "examples": [
        "Si vede che ha il mestiere nel sangue, riesce sempre a risolvere i problemi.",
        "Il suo mestiere di scrittore si affina a ogni nuovo romanzo."
      ],
      "nota": "Spesso usato in espressioni come 'avere mestiere', 'fare mestiere'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione sociale o modo di agire ritenuto disdicevole o indecoroso, spesso riferito a pratiche immorali o illegali, ma anche a comportamenti opportunistici.",
      "examples": [
        "Ha rivelato il suo mestiere solo dopo essere stato scoperto.",
        "Non è un bel mestiere quello di sfruttare la buona fede altrui."
      ],
      "nota": "Uso figurato, spesso con connotazione negativa."
    }
  ]
