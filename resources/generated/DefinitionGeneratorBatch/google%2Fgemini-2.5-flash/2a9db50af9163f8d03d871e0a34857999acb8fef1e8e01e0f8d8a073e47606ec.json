  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Persona adulta di sesso maschile, spesso usato come appellativo di cortesia o rispetto.",
      "examples": [
        "Un signore anziano mi ha ceduto il posto sull'autobus.",
