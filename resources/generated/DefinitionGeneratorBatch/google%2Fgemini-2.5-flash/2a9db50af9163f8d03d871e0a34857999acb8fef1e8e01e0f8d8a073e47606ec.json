    },
    {
      "pos": "sostantivo maschile",
      "definition": "Uomo di rango sociale elevato, di grande autorità o potere, o che si distingue per il suo comportamento impeccabile e la sua eleganza.",
      "examples": [
        "Il signore del castello era molto temuto dai contadini.",
        "Si comportava sempre come un vero signore, con modi raffinati e gentili."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Termine usato per riferirsi a Dio o Gesù Cristo, specialmente in contesti religiosi, esprimendo devozione e venerazione.",
      "examples": [
        "Preghiamo il Signore per la pace nel mondo.",
        "Nessuno può servire due signori: Dio e la ricchezza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Indica il proprietario o il padrone di qualcosa, spesso un animale domestico o una proprietà.",
      "examples": [
        "Il cane ha aspettato pazientemente il suo signore fuori dal negozio.",
        "Chi è il signore di questa casa?"
      ],
      "nota": null
    }
