  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Oggetto di forma più o meno sferica, elastico e solitamente cavo, utilizzato in varie attività ludiche o sportive.",
      "examples": [
        "I bambini giocavano a palla nel parco fino al tramonto.",
        "Il portiere ha parato una palla difficilissima che andava all'incrocio dei pali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Proiettile di forma sferica adoperato in armi da fuoco, o materiale compatto e rotondo sparato da una macchina da guerra.",
      "examples": [
        "La palla di cannone colpì in pieno la fiancata della nave nemica.",
        "Il cacciatore caricò il fucile con una palla di piombo per la selvaggina di taglia grossa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Qualsiasi oggetto compatto che ha una forma arrotondata o globulare, oppure una massa di sostanza morbida o modellabile lavorata in questa forma.",
      "examples": [
        "Il cuoco ha preparato delle piccole palle di riso fritte come antipasto.",
        "Ha appallottolato la carta formando una palla e l'ha gettata nel cestino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Situazione fastidiosa, noiosa o insostenibile; anche, persona o cosa che provoca delusione o disappunto.",
      "examples": [
        "Che palla questa riunione, non finisce più!",
        "Mi ha raccontato una palla incredibile, non ci credo per niente."
      ],
      "nota": "Uso colloquiale e informale; spesso in espressioni esclamative."
    },
    {
      "pos": "verbointransitivo",
      "definition": "Ingannare qualcuno con affermazioni false o con un comportamento mendace.",
      "examples": [
        "Non mi dire palle, so benissimo la verità.",
        "Non palla, lo giuro, non sono stato io!"
      ],
      "nota": "Forma verbale derivata dall'uso del sostantivo 'palla' nel senso di menzogna, tipica del linguaggio giovanile e informale."
    }
