  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "La parte superiore del corpo degli esseri umani e degli animali, contenente il cervello e gli organi della vista, udito, olfatto e gusto.",
      "examples": [
        "Si strinse le mani sul capo per il dolore.",
        "Il bambino appoggiò il capo sulla spalla della madre."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che detiene un'autorità di comando o di direzione su un gruppo di individui, un'organizzazione o un settore specifico.",
      "examples": [
        "Il capo del dipartimento ha approvato il progetto.",
        "Il nuovo capo della banda ha stabilito nuove regole."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Estremità o principio di qualcosa, punto iniziale o terminale di un oggetto o un percorso.",
      "examples": [
        "Legò il capo della corda a un albero.",
        "Abbiamo raggiunto il capo del sentiero dopo ore di cammino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Articolo di abbigliamento.",
      "examples": [
        "Ho comprato un nuovo capo d'abbigliamento per la festa.",
        "Questo capo è di eccellente qualità e molto resistente."
      ],
      "nota": "L'uso è più comune al plurale o come parte di locuzioni (es. 'capo d'abbigliamento')."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sezione o parte di un testo, un documento o un discorso.",
      "examples": [
        "Il terzo capo del regolamento riguarda le sanzioni.",
        "Ho letto solo il primo capo del suo intervento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Unità di misura generica per indicare una singola entità o individuo, specialmente in contesti che riguardano conteggi di bestiame o persone.",
      "examples": [
        "Il pastore contò cento capi di bestiame.",
        "Per la manifestazione sono previsti diversi capi di imputazione."
      ],
      "nota": "Usato spesso in locuzioni come 'capi di bestiame', 'capi di imputazione'."
    }
  ]
