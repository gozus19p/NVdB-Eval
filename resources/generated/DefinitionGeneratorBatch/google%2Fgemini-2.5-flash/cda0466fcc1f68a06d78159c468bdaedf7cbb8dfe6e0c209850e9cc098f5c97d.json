  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rivolgersi o recarsi abitualmente in un luogo, un ambiente o un certo tipo di persone.",
      "examples": [
        "Ho smesso di frequentare quel bar perché era sempre troppo affollato.",
        "Mio fratello frequenta cattive compagnie da quando si è trasferito in città."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Seguire regolarmente un corso di studi, una lezione o un'istituzione educativa.",
      "examples": [
        "Mia figlia frequenta la terza elementare da quest'anno.",
        "Per migliorare le sue competenze, ha deciso di frequentare un corso serale di inglese."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere un rapporto di amicizia o un legame sentimentale con qualcuno.",
      "examples": [
        "Da qualche mese, frequenta una ragazza conosciuta all'università.",
        "Non frequento più i miei vecchi amici del liceo, abbiamo preso strade diverse."
      ],
      "nota": "Questo senso implica una relazione intima o personale."
    }
