  "senses": [
    {
      "pos": "aggettivo (m. sing.)",
      "definition": "Che ha un prezzo elevato, superiore alla media o al valore atteso.",
      "examples": [
        "Quel ristorante è molto caro, ma si mangia benissimo.",
        "Il petrolio è diventato così caro che guidare è un lusso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo (m. sing.)",
      "definition": "Che è oggetto di grande affetto, stima o considerazione, in quanto legato da un vincolo di parentela, amicizia o amore.",
      "examples": [
        "Un mio caro amico mi ha aiutato in un momento difficile.",
        "Il mio cane è per me un compagno molto caro e fedele."
      ],
      "nota": "Spesso usato come appellativo affettuoso o formale (es. 'Caro/a Dottore/ssa')."
    },
    {
      "pos": "aggettivo (m. sing.)",
      "definition": "Che è prezioso, importante o desiderato, non necessariamente in termini economici, ma per il suo valore intrinseco o sentimentale.",
      "examples": [
        "Questa è una foto molto cara a tutta la famiglia.",
        "La libertà è un bene caro che non va mai dato per scontato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Periodo o condizione caratterizzata da prezzi elevati dei beni di consumo, specialmente alimentari.",
      "examples": [
        "Si teme un nuovo caro-vita con l'aumento dell'inflazione.",
        "I provvedimenti governativi mirano a contrastare il caro carburanti."
      ],
      "nota": "Spesso usato in espressioni composte come 'caro-vita', 'caro bollette'."
    }
  ]
