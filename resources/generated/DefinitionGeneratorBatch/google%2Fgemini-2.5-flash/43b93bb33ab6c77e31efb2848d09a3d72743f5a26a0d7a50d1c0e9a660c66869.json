  "senses": [
    {
      "pos": "avverbio",
      "definition": "In una posizione frontale o avanzata rispetto a un punto di riferimento, nello spazio o nel tempo.",
      "examples": [
        "Ho parcheggiato l'auto proprio davanti all'ingresso del negozio.",
        "Il futuro è davanti a noi, pieno di opportunità."
      ],
      "nota": null
    },
    {
      "pos": "preposizione",
      "definition": "Indica una relazione spaziale o temporale di precedenza, significando 'prima di' o 'di fronte a'.",
      "examples": [
        "Si è inginocchiato davanti all'altare per pregare.",
        "Ha dovuto affrontare un compito difficile davanti a tutta la classe."
      ],
      "nota": "Spesso usata con la preposizione 'a' o 'a casa di'."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "La parte anteriore di qualcosa, ciò che si presenta per primo alla vista o al contatto.",
      "examples": [
        "Il davanti della maglietta era sporco di cioccolato.",
        "Ha preferito sedersi nel davanti dell'autobus per godere del panorama."
      ],
      "nota": null
    }
