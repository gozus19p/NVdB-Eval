  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "La parte o il lato di un oggetto, di un luogo o di una persona che si trova dalla parte del cuore, o dalla parte opposta rispetto alla direzione della mano dominante per la maggior parte degli individui.",
      "examples": [
        "Ho girato a sinistra all'incrocio e ho trovato subito il negozio.",
        "Il volante delle auto inglesi è a sinistra."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "In politica, l'insieme di movimenti, partiti o ideologie che si ispirano a principi di egualitarismo, progressismo e giustizia sociale, contrapponendosi generalmente alla destra.",
      "examples": [
        "Alle prossime elezioni la sinistra si presenterà unita.",
        "Il suo dibattito ha diviso l'opinione pubblica tra destra e sinistra."
      ],
      "nota": "Spesso in opposizione a 'destra'."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a ciò che si trova sul lato corrispondente alla mano non dominante della maggior parte delle persone, o rispetto alla parte opposta a 'destra'.",
      "examples": [
        "Ho parcheggiato l'auto sul lato sinistro della strada.",
        "La sua mano sinistra è ferita e non può scrivere."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Figuratamente, riferito a qualcosa che evoca sensazioni negative, di cattivo presagio, inquietante o infausto.",
      "examples": [
        "Un rumore sinistro proveniva dal bosco buio.",
        "Le sue parole avevano un tono sinistro che mi preoccupò."
      ],
      "nota": null
    }
  ]
