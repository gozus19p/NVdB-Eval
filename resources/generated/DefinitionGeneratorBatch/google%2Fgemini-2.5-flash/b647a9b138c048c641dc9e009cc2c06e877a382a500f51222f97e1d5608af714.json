  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Insieme di beni materiali o merci che vengono trasportate da un veicolo, una persona o un animale.",
      "examples": [
        "Il camion ha consegnato un carico di legna al magazzino.",
        "Ogni giorno porta sulle spalle un carico pesante di libri."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Riferito a persona, un impegno, una responsabilità o un insieme di preoccupazioni che gravano su di essa.",
      "examples": [
        "Si sentiva il carico di tutte le aspettative della famiglia.",
        "La gestione dell'azienda è un carico non indifferente per lui."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "aggettivo",
      "definition": "Che trasporta o contiene una quantità considerevole di qualcosa; pieno o riempito.",
      "examples": [
        "Il furgone era carico di pacchi da consegnare.",
        "Dopo la giornata di lavoro si sentiva carico di stanchezza."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un'arma da fuoco, il fatto che sia pronta a sparare perché ha munizioni nel serbatoio o nella camera di scoppio.",
      "examples": [
        "Fai attenzione, il fucile potrebbe essere carico.",
        "Prima di maneggiarla, assicurati che la pistola non sia carica."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un dispositivo elettronico o una batteria, che è alimentato o ha accumulato energia sufficiente per funzionare.",
      "examples": [
        "Il telefono è completamente carico e pronto all'uso.",
        "Le batterie ricaricabili sono ancora cariche."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a persona o ambiente, che è appesantito o saturo di un'emozione o un'atmosfera intensa.",
      "examples": [
        "La conversazione si è fatta carica di tensione.",
        "Il suo sguardo era carico di rancore."
      ],
      "nota": "Uso figurato."
    }
  ]
