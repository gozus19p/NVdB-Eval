  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte inferiore o di appoggio di un oggetto o di una struttura, su cui questa si sostiene o da cui prende avvio.",
      "examples": [
        "La base del monumento era decorata con sculture raffinate.",
        "Prima di verniciare, è fondamentale applicare una buona base per far aderire il colore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Principio fondamentale o insieme di dati di partenza su cui si fonda un ragionamento, un'idea, una teoria o un'azione.",
      "examples": [
        "La sua ipotesi scientifica non aveva una solida base di prove sperimentali.",
        "Le decisioni politiche devono essere prese su una base di fatti concreti, non di opinioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Luogo o installazione da cui si svolgono operazioni militari, scientifiche o logistiche.",
      "examples": [
        "La base militare è stata attaccata all'alba dalle forze nemiche.",
        "Gli esploratori hanno stabilito una piccola base nel deserto per le loro ricerche."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "L'elemento principale di un gruppo sociale, politico o organizzativo, composto dai suoi membri ordinari.",
      "examples": [
        "La base del partito ha espresso forte dissenso sulla nuova direttiva.",
        "È importante consultare la base dei lavoratori prima di firmare l'accordo sindacale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ciascuno dei vertici del triangolo o degli angoli di un poligono su cui si calcola l'area in geometria, o il lato maggiore di un triangolo isoscele.",
      "examples": [
        "Per calcolare l'area di un triangolo, devi moltiplicare la base per l'altezza e dividere per due.",
        "In un triangolo isoscele, i due angoli alla base sono sempre uguali."
      ],
      "nota": null
    }
  ]
