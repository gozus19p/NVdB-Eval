  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Piccola sacca cucita all'interno o all'esterno di un indumento, usata per contenere oggetti di piccole dimensioni.",
      "examples": [
        "Ho messo le chiavi di casa nella tasca dei pantaloni.",
        "La giacca ha diverse tasche interne ed esterne, molto comode."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso figurato, le risorse finanziarie o economiche a disposizione di una persona.",
      "examples": [
        "Il prezzo di quell'automobile è troppo alto per le mie tasche.",
        "Ha sempre avuto una tasca profonda, non ha mai avuto problemi di denaro."
      ],
      "nota": "Spesso usata in espressioni idiomatiche come 'avere le tasche vuote' o 'avere le tasche piene'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nello sport, in particolare nel biliardo, l'apertura ai lati o agli angoli del tavolo in cui cadono le bilie colpite correttamente.",
      "examples": [
        "La bilia è finita direttamente in tasca, che tiro fortunato!",
        "Ha sbagliato il colpo e la bilia bianca è andata in tasca."
      ],
      "nota": null
    }
  ]
