  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Guidare o controllare il funzionamento di un'organizzazione, un'attività o un gruppo di persone.",
      "examples": [
        "Il nuovo manager ha iniziato a dirigere il reparto vendite con grande energia.",
