  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che esiste solo nella fantasia o nell'immaginazione, non nella realtà.",
      "examples": [
        "Le creature fantastiche dei miti antichi popolano ancora i nostri sogni.",
        "Ha inventato una storia fantastica per giustificare il suo ritardo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Straordinario, eccezionale, meraviglioso; che suscita ammirazione o grande piacere.",
      "examples": [
        "Abbiamo passato una serata fantastica in compagnia di vecchi amici.",
        "Il suo nuovo romanzo è semplicemente fantastico, non riuscivo a smettere di leggerlo."
      ],
      "nota": "Questo senso ha una connotazione positiva molto forte e spesso è usato in contesti colloquiali."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il complesso di elementi, temi e personaggi che appartengono al regno della fantasia, spesso contrapposto alla realtà.",
      "examples": [
        "Molti scrittori attingono al fantastico per creare mondi alternativi e sorprendenti.",
        "Il limite tra il reale e il fantastico è spesso sfumato nell'arte."
      ],
      "nota": "Spesso usato in contesti critici o letterari per riferirsi a un genere o a una dimensione narrativa."
    }
  ]
