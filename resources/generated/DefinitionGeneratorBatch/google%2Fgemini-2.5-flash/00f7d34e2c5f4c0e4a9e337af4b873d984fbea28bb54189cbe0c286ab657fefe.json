  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Persona di sesso maschile che detiene il governo di uno stato monarchico o di un principato, oppure che è membro di una famiglia reale o nobile di alto rango.",
      "examples": [
        "Il principe ereditario ha visitato diverse città del regno.",
        "Molti bambini sognano di sposare un principe o una principessa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Chi eccelle significativamente in un determinato campo o attività, distinguendosi per capacità, influenza o importanza.",
      "examples": [
        "È considerato il principe della finanza nel suo paese.",
        "Questo romanzo è un principe tra le opere letterarie del Novecento."
      ],
      "nota": "Uso figurato per indicare superiorità o eccellenza."
    },
    {
      "pos": "aggettivo qualificativo",
      "definition": "Che è il più importante, il principale o il fondamentale all'interno di un insieme o di una categoria.",
      "examples": [
        "La sua preoccupazione principe era la sicurezza dei cittadini.",
        "Il quesito principe del dibattito era la riforma del sistema sanitario."
      ],
      "nota": null
    }
  ]
