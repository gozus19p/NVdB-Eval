  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Serie di immagini, sensazioni e pensieri che si manifestano involontariamente durante il sonno dell'individuo.",
      "examples": [
        "Ho fatto un sogno stranissimo la scorsa notte, parlava un gatto.",
        "A volte i sogni mi sembrano così reali che fatico a distinguere dalla realtà."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Idea o desiderio profondo e spesso irrealizzabile, idealizzato e ritenuto di grande importanza per il proprio futuro.",
      "examples": [
        "Il suo sogno è sempre stato quello di diventare un astronauta e viaggiare nello spazio.",
        "È importante non smettere mai di avere sogni e lottare per realizzarli, anche quando sembrano impossibili."
      ],
      "nota": "Questo senso si riferisce a un desiderio fervente di qualcosa, spesso grandioso e di difficile attuazione, che assume una dimensione quasi onirica nella mente di chi lo nutre."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Qualcosa di meraviglioso o ideale, che nella sua perfezione sembra appartienere a un'altra dimensione.",
      "examples": [
        "Quella casa in campagna, con il giardino fiorito e la vista sul lago, è un vero sogno.",
        "La nostra vacanza è stata un sogno: mare cristallino, ottimo cibo e relax totale."
      ],
      "nota": "Questo senso ha una connotazione più concreta e valuta positivamente un'esperienza o un oggetto che evoca sensazioni di perfezione o bellezza al di là del comune."
    }
