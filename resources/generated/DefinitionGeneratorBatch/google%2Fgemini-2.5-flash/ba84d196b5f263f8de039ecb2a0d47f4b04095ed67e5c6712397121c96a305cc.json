  "senses": [
    {
      "pos": "avverbio",
      "definition": "Introduce una frase o un elemento negativo, sottolineando che qualcosa non è assolutamente vero o non avverrà.",
      "examples": [
        "Non è mica un genio, ha solo studiato a fondo.",
        "Non è mica venuto a salutarci."
      ],
      "nota": "Spesso rafforza la negazione 'non' e può esprimere sorpresa o disappunto. Ha un uso colloquiale molto diffuso."
    },
    {
      "pos": "avverbio",
      "definition": "Utilizzato in frasi interrogative per esprimere una sfumatura di dubbio, perplessità o per attendere una conferma negativa.",
      "examples": [
        "Mica vorrai dirmi che non lo sapevi?",
        "Non è mica tardi per iniziare?"
      ],
      "nota": "In questo contesto, suggerisce una risposta negativa implicita o attesa."
    }
  ]
