  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Incontro competitivo tra due o più contendenti, squadre o individui, finalizzato a determinare un vincitore basandosi su regole predefinite.",
      "examples": [
        "Abbiamo giocato una partita a carte fino a tarda notte.",
        "La partita di calcio è stata rinviata a causa del maltempo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Quantità o lotto di merce identica spedita o ricevuta in un'unica transazione commerciale.",
      "examples": [
        "È arrivata una nuova partita di prodotti dall'estero.",
        "Le partite di vino pregiato sono state vendute all'asta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Situazione o questione importante che può avere esiti imprevedibili e che richiede attenzione o una decisione cruciale.",
      "examples": [
        "Si gioca una partita cruciale sul futuro dell'azienda.",
        "Il prossimo incontro politico sarà una partita difficile da giocare."
      ],
      "nota": "Spesso usato in espressioni come 'giocarsi la partita', 'una partita delicata'."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Ogni singola divisione o posta di un conto economico; anche, ciascuna delle voci di entrata o uscita in una transazione contabile.",
      "examples": [
        "Registriamo questa partita come spesa straordinaria.",
        "Il contabile ha controllato ogni singola partita di bilancio."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo femminile",
      "definition": "Separata in due o più parti; divisa o spaccata.",
      "examples": [
        "La torta è già partita, ognuno può prendere la sua fetta.",
        "Aveva la riga in testa ben partita al centro."
      ],
      "nota": "Participio passato del verbo 'partire' usato come aggettivo."
    }
  ]
