  "senses": [
    {
      "pos": "aggettivo numerale cardinale",
      "definition": "Numero ordinale che viene dopo quarantanove e prima di cinquantuno; indica una quantità pari a cinque volte dieci unità.",
      "examples": [
        "Ho comprato cinquanta rose per il compleanno di mia madre.",
        "Ci sono circa cinquanta persone in fila per entrare al concerto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il numero intero rappresentato dalla cifra 50.",
      "examples": [
        "Il cinquanta è un numero pari.",
        "Ha vinto alla lotteria con il numero cinquanta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Banconota o moneta del valore di cinquanta unità della valuta corrente.",
      "examples": [
        "Mi dai un cinquanta, per favore? Non ho spiccioli.",
        "Ha pagato il conto con una banconota da cinquanta euro."
      ],
      "nota": "Sovente usato in riferimento a banconote o monete di taglio significativo."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "L'anno cinquanta di un secolo o di un millennio, oppure l'età di cinquant'anni.",
      "examples": [
        "Nel cinquanta del secolo scorso ci fu una grande svolta culturale.",
        "Sta per compiere i cinquanta, ma ne dimostra molti meno."
      ],
      "nota": "Spesso abbreviato 'i Cinquanta' per riferirsi agli anni Cinquanta del XX secolo."
    }
  ]
