  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Grandezza quantificabile o dimensione di un oggetto o fenomeno, ottenuta tramite confronto con un'unità di riferimento.",
      "examples": [
        "Prendere la misura del tavolo prima di comprare la tovaglia è fondamentale.",
        "La misura della temperatura corporea di un febbricitante fornisce un'informazione utile allo sviluppo della diagnosi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Azionamento o provvedimento volto a raggiungere un determinato scopo o a porre rimedio a una situazione.",
      "examples": [
        "Il governo ha annunciato nuove misure di contenimento della pandemia.",
        "Adottare misure preventive è sempre meglio che curare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Limita o entità adeguata e appropriata di qualcosa, intesa come moderazione o giusta proporzione.",
      "examples": [
        "Bisogna sempre agire con misura, evitando gli eccessi.",
        "Non ha misura nel parlare, dice sempre più di quanto dovrebbe."
      ],
      "nota": "Spesso usata in espressioni idiomatiche come 'senza misura' o 'con misura'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Unità di riferimento standardizzata utilizzata per la quantificazione di grandezze.",
      "examples": [
        "Il metro è l'unità di misura della lunghezza nel Sistema Internazionale.",
        "Qual è la misura che useremo per pesare lo zucchero?"
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Determinazione della quantità o dell'estensione di un elemento, spesso con riferimento a un criterio oggettivo o soggettivo.",
      "examples": [
        "Un sistema di valutazione oggettivo è essenziale per la misura della produttività.",
        "La misura del successo di un progetto non è solo economica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ritmo o schema temporale che regola il susseguirsi degli eventi o dei suoni, in particolare in musica o nella metrica poetica.",
      "examples": [
        "Il direttore d'orchestra ha battuto la misura dando il via all'esecuzione.",
        "Il poeta ha scritto la sua ode in una misura insolita."
      ],
      "nota": null
    }
