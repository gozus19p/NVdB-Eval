  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che può accadere, realizzarsi o essere fatto; conforme alle leggi di natura o alle circostanze ammissibili.",
      "examples": [
        "È possibile che domani piova, controlla le previsioni.",
        "Faremo tutto il possibile per aiutarvi.",
        "Non è possibile risolvere l'equazione con questi dati."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Indica il grado massimo o il limite estremo di una qualità o quantità, spesso in combinazione con superlativi o in espressioni comparative.",
      "examples": [
        "Ti prego, rispondi il prima possibile.",
        "Abbiamo cercato la soluzione migliore possibile.",
        "Ho corso più veloce possibile per non perdere il treno."
      ],
      "nota": "Spesso in espressioni formate da superlativo e 'possibile' o da 'il più/meno' + aggettivo/avverbio + 'possibile'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Ciò che può accadere o esistere; l'insieme di tutte le potenzialità o eventualità future.",
      "examples": [
        "Un attore deve esplorare tutti i possibili per i suoi personaggi.",
        "L'idea di esplorare mondi diversi apre a infiniti possibili teorici."
      ],
      "nota": "L'uso sostantivato è più comune al plurale o in contesti filosofici/astratti."
    }
  ]
