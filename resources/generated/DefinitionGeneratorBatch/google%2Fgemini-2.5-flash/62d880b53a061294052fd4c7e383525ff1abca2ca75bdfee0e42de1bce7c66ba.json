  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Esprimere in modo verbale o non verbale una sofferenza fisica, un disagio emotivo o un malcontento.",
      "examples": [
        "Il bambino ha iniziato a lamentare un forte mal di pancia dopo aver mangiato troppi dolci.",
        "Molti cittadini lamentano la mancanza di servizi pubblici efficienti nel quartiere."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Esprimere verbalmente o con gemiti il proprio dolore, la propria insoddisfazione o il proprio malumore riguardo a una situazione che si vive.",
      "examples": [
        "Si lamentava continuamente del suo stipendio troppo basso, pur avendo un buon impiego.",
        "Non ti lamenti se la situazione non cambia, devi agire per migliorarla."
      ],
      "nota": null
    }
  ]
