  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "La madre di uno dei propri genitori.",
      "examples": [
        "Ogni domenica andiamo a pranzo dalla nonna paterna.",
        "Mia nonna mi ha insegnato a fare la pasta in casa."
