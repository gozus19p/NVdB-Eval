    {
      "pos": "sostantivo f.",
      "definition": "Una donna anziana, spesso con un'accezione affettuosa o rispettosa.",
      "examples": [
        "La nonna del quartiere prepara sempre dei dolci buonissimi per tutti.",
        "Ho visto una nonna attraversare la strada con un bastone."
      ],
      "nota": "Questo senso può essere usato anche in modo dispregiativo, a seconda del contesto e del tono."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Negli ambienti universitari o militari, studentessa o recluta più anziana o con maggiore esperienza all'interno di un gruppo, spesso in contesti di iniziazione o 'nonnismo'.",
      "examples": [
        "Le nonne del corso di medicina organizzano la festa per le matricole.",
        "Durante la fase di selezione, le nonne hanno messo alla prova i nuovi arrivati."
      ],
      "nota": "L'uso in questo senso è più specifico e contestuale."
