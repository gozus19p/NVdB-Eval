  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Sottrarsi al controllo, alla presa o alla percezione di qualcuno o qualcosa; riuscire a evitare un contatto fisico o una situazione indesiderata.",
      "examples": [
        "Il ladro è sfuggito alla sorveglianza e si è dileguato nella notte.",
        "Il pallone mi è sfuggito di mano proprio al momento del tiro."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Non essere notato, non venire compreso o ricordato da qualcuno.",
      "examples": [
        "Mi è sfuggito il suo nome, puoi ripetermelo per favore?",
        "Quel piccolo particolare è sfuggito all'attenzione di tutti."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a concetti, idee o ragionamenti, essere complesso o astratto al punto da non essere pienamente afferrato o compreso da qualcuno.",
      "examples": [
        "La sottigliezza di quel ragionamento mi sfugge completamente.",
        "Certe sfumature di significato tendono a sfuggirgli."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Uscire involontariamente o in modo incontrollato, detto di parole o espressioni.",
      "examples": [
        "Le è sfuggita una parolaccia durante la discussione.",
        "Non volevo, ma mi è sfuggita la frase di bocca."
      ],
      "nota": null
    }
  ]
