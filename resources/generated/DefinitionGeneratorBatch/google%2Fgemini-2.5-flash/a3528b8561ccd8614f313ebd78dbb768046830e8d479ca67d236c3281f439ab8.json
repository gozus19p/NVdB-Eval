  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere errori, imperfezioni o difetti da qualcosa.",
      "examples": [
        "Ho passato tutta la sera a correggere le bozze del libro prima della stampa.",
        "Il professore ha impiegato molto tempo per correggere tutti i compiti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Modificare o aggiustare qualcosa per renderlo più conforme, preciso o adatto a uno scopo.",
      "examples": [
        "Devi correggere la mira del tiro se vuoi colpire il centro del bersaglio.",
        "Il sapore del sugo era troppo acido, ho dovuto correggerlo un po' con dello zucchero."
      ],
      "nota": "Riferito a un'azione, un comportamento, un gusto, ecc."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ammonire o rimproverare qualcuno per un comportamento ritenuto sbagliato, allo scopo di farlo migliorare.",
      "examples": [
        "I genitori devono correggere i propri figli quando sbagliano, ma sempre con amore.",
        "L'allenatore ha corretto il giocatore con fermezza per la sua disattenzione in campo."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Migliorare il proprio comportamento o il proprio modo di agire, riconoscendo e emendando gli errori commessi.",
      "examples": [
        "Dopo quella brutta esperienza, ha deciso di correggersi e cambiare vita.",
        "È importante sapersi correggere quando si riceve una critica costruttiva."
      ],
      "nota": null
    }
  ]
