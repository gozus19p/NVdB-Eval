  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Un'attività commerciale o economica che implica uno scambio di beni, servizi o denaro con l'obiettivo di ottenere un profitto; anche l'oggetto di tale attività.",
      "examples": [
        "Ho concluso un ottimo affare per l'acquisto di quella casa.",
        "Il nuovo socio ha portato diversi affari promettenti all'azienda."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Una questione, un problema o una situazione da affrontare, spesso di carattere personale o privato, che richiede attenzione o una soluzione.",
      "examples": [
        "Ho un affare urgente da sbrigare in banca prima che chiuda.",
        "Non immischiarti negli affari altrui se non richiesto."
      ],
      "nota": "Spesso usato al plurale per indicare questioni personali o professionali."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un evento o una circostanza imprevista e solitamente spiacevole o complicata, che causa difficoltà o disagio.",
      "examples": [
        "Dopo la rottura, è stato un brutto affare per entrambi gestire la separazione dei beni.",
        "Quel litigio è diventato un affare serio che ha coinvolto tutta la famiglia."
      ],
      "nota": "In questa accezione è spesso preceduto da un aggettivo di valutazione come 'brutto', 'cattivo', 'serio'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Una cosa, un oggetto generico non meglio specificato, spesso di modesta importanza o di cui non si vuole o non si può precisare la natura.",
      "examples": [
        "Prendimi quell'affare che c'è sul tavolo, per favore.",
        "Non so come si chiami questo affare, ma serve per pulire."
      ],
      "nota": "Uso colloquiale e generico, simile a 'cosa', 'aggeggio'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un'opportunità o una circostanza vantaggiosa, specialmente dal punto di vista economico, che offre un beneficio notevole.",
      "examples": [
        "Comprare quei biglietti al cinquanta percento di sconto è stato un vero affare.",
        "Questo investimento sembra essere un affare d'oro per il futuro."
      ],
      "nota": "Spesso usato nell'espressione 'fare un affare' o 'essere un affare'."
    }
  ]
