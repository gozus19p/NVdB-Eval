  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Appellativo di cortesia usato per rivolgersi o riferirsi a donne giovani o non sposate.",
      "examples": [
        "La signorina al bancone ha risposto gentilmente a tutte le mie domande.",
        "Buongiorno, signorina, posso aiutarla a trovare qualcosa?"
      ],
      "nota": "L'uso di questo termine è diventato meno comune al di fuori di contesti specifici, spesso sostituito da 'signora' indipendentemente dallo stato civile, per evitare congetture personali."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Giovane donna che lavora come commessa, cameriera o in un ruolo di servizio simile.",
      "examples": [
        "Chiami la signorina per ordinare un caffè.",
        "La signorina del negozio di abbigliamento mi ha aiutato a scegliere il vestito più adatto."
      ],
      "nota": null
