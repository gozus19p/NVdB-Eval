  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Piena e incondizionata fiducia nella validità di qualcosa o nella veridicità di qualcuno, spesso basata su convinzioni personali piuttosto che su prove concrete.",
      "examples": [
        "Ho riposto tutta la mia fede nelle sue parole, sperando non mi deludesse.",
        "La fede nel progresso scientifico ha guidato molte scoperte."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Credenza in una o più divinità, o in principi religiosi e dogmi, che influenza la visione del mondo e il comportamento di un individuo o di una comunità.",
      "examples": [
        "Molte persone trovano conforto e guida nella loro fede religiosa.",
        "Ha dedicato la sua vita a diffondere la fede tra i popoli."
      ],
      "nota": "Spesso in contesti religiosi o spirituali."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Anello generalmente d'oro, scambiato tra gli sposi durante la cerimonia nuziale come simbolo del vincolo matrimoniale e dell'impegno reciproco.",
      "examples": [
        "La fede nuziale che porta al dito è un ricordo costante del suo amore.",
        "Hanno scelto delle fedi molto semplici ma eleganti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Documento o prova concreta che attesta la veridicità di un fatto o di un'informazione, fornendo garanzia legale o ufficiale.",
      "examples": [
        "Devi presentare una fede di nascita per ottenere il passaporto.",
        "La sua dichiarazione è stata accolta con fede, data la sua reputazione impeccabile."
      ],
      "nota": "Uso più formale o burocratico."
    }
  ]
