  },
  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Portare a compimento un'attività o un processo, giungendo alla sua fase finale.",
      "examples": [
        "Ho terminato il mio lavoro prima del previsto.",
        "Dobbiamo terminare il progetto entro la prossima settimana."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Giungere al proprio limite o alla propria conclusione, cessando di esistere o di svolgersi.",
      "examples": [
        "La strada termina in un vicolo cieco.",
        "Il corso terminerà a fine mese."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere come esito o risultato finale un determinato evento o situazione.",
      "examples": [
        "La discussione è terminata in un accordo unanime.",
        "La partita è terminata con la vittoria della nostra squadra."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Arrivare al proprio compimento o alla propria fine, detto di un'azione o un compito.",
      "examples": [
        "Il suo intervento si è terminato con un applauso scrosciante.",
        "La costruzione dell'edificio si è terminata in meno di un anno."
      ],
      "nota": "Questo senso è meno comune nell'uso corrente rispetto all'uso transitivo o intransitivo."
    }
  ]
