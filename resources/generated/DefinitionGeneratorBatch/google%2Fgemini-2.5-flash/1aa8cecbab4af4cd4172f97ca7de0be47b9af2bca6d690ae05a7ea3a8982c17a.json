  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dividere un oggetto utilizzando uno strumento affilato o un'azione che lo separi in più parti.",
      "examples": [
        "Ho tagliato la torta in otto fette e l'abbiamo mangiata tutta.",
        "Il sarto ha tagliato la stoffa secondo il modello per realizzare il vestito."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere una parte di qualcosa, accorciandola o eliminandola completamente.",
      "examples": [
        "Il parrucchiere mi ha tagliato i capelli cortissimi, sono quasi irriconoscibile.",
        "Dobbiamo tagliare le siepi del giardino prima che diventino troppo grandi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Diminuire la quantità, il numero o l'intensità di qualcosa.",
      "examples": [
        "Il governo ha deciso di tagliare le spese pubbliche per ridurre il deficit.",
        "Devo tagliare le calorie se voglio perdere peso."
      ],
      "nota": "Spesso usato in riferimento a riduzioni economiche o dietetiche."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Attraversare un percorso o una strada, spesso in modo diretto o intersecandola.",
      "examples": [
        "Per arrivare prima, abbiamo deciso di tagliare per il campo invece che seguire la strada principale.",
        "Il sentiero taglia il bosco e porta direttamente al lago."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Procurarsi una ferita, spesso accidentalmente, con uno strumento tagliente.",
      "examples": [
        "Si è tagliato un dito mentre affettava il pane, per fortuna era solo un piccolo taglio.",
        "Fai attenzione con quel coltello, potresti tagliarti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere bruscamente una comunicazione o un collegamento.",
      "examples": [
        "La linea è caduta, mi hanno tagliato la telefonata.",
        "Sei riuscito a tagliare la comunicazione satellitare con la base?"
      ],
      "nota": "Comunemente usato in contesti relati a comunicazioni telefoniche o telematiche."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Miscelare una sostanza con un'altra per alterarne la qualità, spesso per diluirla o modificarne le proprietà.",
      "examples": [
        "Si dice che molti commercianti taglino il vino con acqua per aumentare i profitti.",
        "L'hanno scoperto mentre tentava di tagliare la droga con altre sostanze per venderla."
      ],
      "nota": "Spesso implica un'azione fraudolenta o volta a ridurre la qualità."
    }
  ]
}