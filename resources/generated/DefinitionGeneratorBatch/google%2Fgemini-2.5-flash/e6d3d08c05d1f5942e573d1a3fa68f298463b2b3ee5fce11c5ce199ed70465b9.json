  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Atto di allontanarsi rapidamente da un luogo o situazione per evitare un pericolo, una difficoltà o una costrizione.",
      "examples": [
        "Dopo la rapina, i malviventi hanno tentato una fuga precipitosa a bordo di un'auto rubata.",
        "La notizia della sua malattia ha provocato la fuga di molti dei suoi amici meno leali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Rapido deflusso o dispersione di qualcosa, come persone, capitali, informazioni o risorse.",
      "examples": [
        "Si è verificata una fuga di dati sensibili dall'azienda a causa di un attacco informatico.",
        "La crisi economica ha causato una significativa fuga di cervelli verso paesi con maggiori opportunità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Componimento musicale polifonico, basato sull'imitazione e rielaborazione di uno o più temi, che si susseguono e si intrecciano tra le diverse voci.",
      "examples": [
        "Bach è considerato il maestro indiscusso nell'arte della fuga.",
        "Lo studente di musica eseguirà una complessa fuga a quattro voci al saggio di fine anno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Distanza, spazio vuoto o interruzione tra elementi contigui o parti di una struttura.",
      "examples": [
        "Una piccola fuga nell'impianto idraulico stava causando un lento gocciolamento.",
        "C'è una fuga di luce dalla finestra che mi impedisce di dormire bene."
      ],
      "nota": "Spesso riferito a elementi che dovrebbero essere sigillati o continui."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Senso di smarrimento, incertezza o isolamento, specialmente in un contesto sociale o relazionale.",
      "examples": [
        "Dopo la discussione, si sentiva in fuga dai pensieri e dalle parole non dette.",
        "A volte, in momenti di grande stress, sento una fuga dalla realtà che mi circonda."
      ],
      "nota": "Uso figurato."
    }
  ]
