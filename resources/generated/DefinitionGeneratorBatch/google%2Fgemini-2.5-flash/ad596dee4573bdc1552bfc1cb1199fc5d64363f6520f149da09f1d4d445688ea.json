  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Comunicare idee, sentimenti o informazioni attraverso parole, gesti o altri mezzi.",
      "examples": [
        "Ha espresso il suo disappunto con un lungo discorso.",
        "Non riesce a esprimere a parole ciò che prova."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Manifestare o rendere visibile una qualità, una caratteristica o un'emozione attraverso l'aspetto o il comportamento.",
      "examples": [
        "Il suo volto esprimeva una profonda tristezza.",
        "Questa opera d'arte esprime la gioia di vivere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Far uscire un liquido o una sostanza da qualcosa mediante pressione o spremitura.",
      "examples": [
        "Per fare il succo, bisogna esprimere gli agrumi con forza.",
        "Ha espresso il pus dalla ferita."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Rivelare i propri pensieri o sentimenti con chiarezza e sincerità.",
      "examples": [
        "Si è espresso liberamente durante la riunione.",
        "È importante esprimersi con rispetto anche quando si dissentisce."
      ],
      "nota": "L'uso riflessivo sottolinea l'azione di comunicare da parte del soggetto stesso."
    }
  ]
