  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Organismo vegetale, generalmente autotrofo, pluricellulare e sessile, caratterizzato dalla presenza di clorofilla e da una struttura composta tipicamente da radici, fusto o stelo, foglie e, in molte specie, fiori e frutti.",
      "examples": [
        "Nel giardino abbiamo piantato delle piante aromatiche come la salvia e il rosmarino.",
        "Le piante purificano l'aria e rendono l'ambiente più gradevole."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Disegno tecnico che rappresenta la disposizione spaziale di un edificio, di un ambiente o di un oggetto, solitamente in proiezione orizzontale come se fosse tagliato a una certa altezza dal suolo o visto dall'alto.",
      "examples": [
        "Ho consultato la pianta dell'appartamento per capire la distribuzione delle stanze.",
        "L'architetto ha mostrato la pianta del nuovo complesso residenziale durante la riunione."
      ],
      "nota": "Spesso utilizzato nell'ambito dell'architettura e dell'ingegneria."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "La parte inferiore del piede umano o animale che poggia sul terreno, caratterizzata da una struttura arcuata e da tessuto adiposo che funge da ammortizzatore.",
      "examples": [
        "Mi fanno male le piante dei piedi dopo aver camminato per ore.",
        "Il medico ha suggerito delle solette speciali per supportare la pianta del piede."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inserire nel terreno una pianta, un seme, un innesto o un oggetto appuntito, in modo che vi si stabilizzi o che possa attecchire e crescere.",
      "examples": [
        "Ho piantato un albero di limoni in giardino l'anno scorso.",
        "Il contadino sta piantando le nuove piantine di pomodoro nell'orto."
      ],
      "nota": "Forma coniugata del verbo 'piantare'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Posizionare qualcosa fermamente in un luogo, spesso con forza o decisione, in modo che rimanga stabile o visibile.",
      "examples": [
        "Ha piantato la bandiera sulla cima della montagna.",
        "Non puoi piantare il tuo campetto da tennis qui senza un permesso."
      ],
      "nota": "Forma coniugata del verbo 'piantare'. Può avere un'accezione anche figurata di 'stabilire con fermezza'."
    }
  ]
