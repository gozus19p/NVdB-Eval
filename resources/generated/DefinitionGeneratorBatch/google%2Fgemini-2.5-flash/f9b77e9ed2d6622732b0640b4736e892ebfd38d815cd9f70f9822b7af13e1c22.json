  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Articolazione complessa dell'arto inferiore che unisce la coscia alla gamba, permettendo movimenti di flessione ed estensione.",
      "examples": [
        "Dopo la caduta, mi faceva male un ginocchio e non riuscivo a camminare bene.",
        "Il bambino si è sbucciato le ginocchia giocando a calcio nel parco."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte di un indumento, generalmente pantaloni, corrispondente a tale articolazione, spesso soggetta a usura o a rinforzi.",
      "examples": [
        "I pantaloni di mio figlio hanno le ginocchia scucite per quante volte ci è caduto.",
        "Ha comprato un paio di jeans con i rinforzi sulle ginocchia, perfetti per i lavori in giardino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Curvatura o piegatura acuta in un tubo, un condotto o una struttura, che ne cambia improvvisamente la direzione.",
      "examples": [
        "Per far passare il cavo, abbiamo dovuto creare un ginocchio nel muro.",
        "Il tubo di scarico presentava un ginocchio troppo stretto, causando un ristagno dell'acqua."
      ],
      "nota": "Uso figurato e tecnico che richiama la forma dell'articolazione."
    }
  ]
