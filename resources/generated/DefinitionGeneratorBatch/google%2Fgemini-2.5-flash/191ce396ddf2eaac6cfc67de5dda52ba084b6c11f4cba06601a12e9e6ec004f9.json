  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Parte del corpo di un essere vivente che svolge una funzione specifica e vitale per l'organismo. Può essere interno o esterno.",
      "examples": [
        "Il cuore è un organo vitale per la circolazione del sangue.",
        "I polmoni sono gli organi responsabili della respirazione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Strumento musicale a tastiera che produce suoni tramite canne o ance, azionate da un flusso d'aria compressa, spesso utilizzato in contesti religiosi o per musica classica.",
      "examples": [
        "Il suono potente dell'organo riempiva l'intera chiesa.",
        "Ha studiato organo fin da bambino, diventando un organista di fama."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Componente di un ente, un'istituzione o un'organizzazione al quale sono attribuite specifiche competenze o funzioni decisionali e operative. Può essere collegiale o monocratico.",
      "examples": [
        "Il consiglio di amministrazione è l'organo decisionale della società.",
        "La giunta comunale è un organo esecutivo dell'amministrazione locale."
      ],
      "nota": "Spesso usato in ambito burocratico, legale o aziendale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Mezzo di diffusione delle informazioni, come un giornale, una rivista o un sito web, che rappresenta e veicola le idee o la linea di un partito politico, una corrente di pensiero o un'organizzazione.",
      "examples": [
        "Quel quotidiano è l'organo ufficiale del partito di maggioranza.",
        "La rivista scientifica funge da organo divulgativo per le ultime ricerche nel settore."
      ],
      "nota": null
    }
  ]
