  "senses": [
    {
      "pos": "sostantivo maschile/femminile",
      "definition": "Persona che interpreta un ruolo in una rappresentazione teatrale, cinematografica o televisiva, impersonando personaggi e recitando dialoghi.",
      "examples": [
        "L'attore ha ricevuto un premio Oscar per la sua toccante interpretazione.",
        "La giovane attrice si sta preparando per il suo debutto sul palco."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile/femminile",
      "definition": "Chi, in una determinata situazione o vicenda, svolge un ruolo significativo e influente, contribuendo attivamente al suo sviluppo.",
      "examples": [
        "Gli attori principali della crisi economica si riuniranno domani per trovare una soluzione.",
        "Il presidente è stato un attore chiave nelle trattative di pace."
      ],
      "nota": "Questo senso estende il significato della recitazione a contesti più ampi, indicando chi ha un ruolo determinante."
    },
    {
      "pos": "sostantivo maschile/femminile",
      "definition": "Nell'ambito del diritto, la parte che promuove un'azione legale o una causa in tribunale.",
      "examples": [
        "L'attore ha presentato una denuncia per diffamazione contro il suo vicino.",
        "Gli avvocati dell'attore hanno chiesto il risarcimento dei danni subiti."
      ],
      "nota": null
    }
  ]
