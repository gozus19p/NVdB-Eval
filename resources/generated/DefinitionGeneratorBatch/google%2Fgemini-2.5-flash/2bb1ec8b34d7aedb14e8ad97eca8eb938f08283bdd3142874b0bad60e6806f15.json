  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Precipitazione atmosferica che consiste in cristalli di ghiaccio minuti e leggeri, spesso agglomerati in fiocchi, che cadono dalle nubi quando la temperatura dell'aria è prossima o inferiore allo zero gradi Celsius.",
      "examples": [
        "Stanotte è caduta tanta neve che le strade sono impraticabili.",
        "I bambini giocavano a palle di neve nel giardino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Massa di sostanza di colore bianco, finemente polverizzata o tritata, che richiama l'aspetto della neve naturale.",
      "examples": [
        "Ho decorato la torta con una neve di zucchero a velo.",
        "Il pasticcere ha cosparso i bignè con neve di cocco."
      ],
      "nota": "Uso figurato per descrivere l'aspetto di un'altra sostanza."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Rumore visivo o disturbo che appare come un'immagine granulosa, irregolare e tremolante su schermi televisivi, monitor o altre superfici di visualizzazione elettronica, solitamente causato da un segnale debole o assente.",
      "examples": [
        "Il televisore mostrava solo neve a causa della scarsa ricezione dell'antenna.",
        "Quando il segnale è debole, lo schermo del computer inizia a mostrare della neve."
      ],
      "nota": null
    }
  ]
