  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Cedere la proprietà di un bene o di un servizio in cambio di una somma di denaro o di altro valore equivalente.",
      "examples": [
        "Ho deciso di vendere la mia automobile usata per comprarne una nuova.",
        "Il commerciante vende prodotti freschi e di alta qualità."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Essere ceduto in cambio di denaro o di altro valore, riferito a beni o servizi.",
      "examples": [
        "Quella casa si è venduta molto velocemente, c'erano molti acquirenti interessati.",
        "I biglietti per il concerto si venderanno sicuramente tutti in pochi giorni."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo figurato",
      "definition": "Tradire una persona, rivelare un segreto o rinunciare ai propri principi o ideali in cambio di un beneficio personale.",
      "examples": [
        "Per un tornaconto personale, ha venduto i suoi compagni, rivelando i loro piani.",
        "Non si dovrebbe mai vendere la propria dignità per ottenere un vantaggio effimero."
      ],
      "nota": "Spesso usato in contesti negativi, con connotazione di tradimento o indegnità."
    }
