  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che richiede notevole impegno, fatica o abilità per essere fatto, compreso o risolto.",
      "examples": [
        "L'esame di matematica era molto difficile, tanto che pochi studenti sono riusciti a superarlo.",
        "Trovare un parcheggio in centro, il sabato sera, è sempre un'impresa difficile."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Persona o situazione che presenta ostacoli o complicazioni, rendendo arduo il rapporto, la gestione o la risoluzione.",
      "examples": [
        "Era un ragazzo difficile, sempre in conflitto con gli altri e incapace di accettare le critiche.",
        "La situazione politica attuale è piuttosto difficile, ricca di tensioni e incertezze."
      ],
      "nota": "Riferito a persone, spesso implica una personalità complessa o problematica."
    },
    {
      "pos": "aggettivo",
      "definition": "Di cosa che è rara, scarsa o non facilmente reperibile.",
      "examples": [
        "In questo periodo è difficile trovare biglietti per il concerto, sono andati a ruba in poche ore.",
        "La vera amicizia, quella incondizionata, è un bene prezioso e difficile da trovare."
      ],
      "nota": null
    }
  ]
