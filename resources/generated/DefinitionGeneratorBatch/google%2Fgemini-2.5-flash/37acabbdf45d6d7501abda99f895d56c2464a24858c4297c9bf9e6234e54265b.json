  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere un'attività o un'abitudine, specialmente se dannosa o indesiderabile.",
      "examples": [
        "Ho deciso di smettere di fumare l'anno scorso e mi sento molto meglio.",
        "Non riesce a smettere di pensare a quel problema."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Cessare di indossare o di utilizzare un indumento o un oggetto.",
      "examples": [
        "Dopo la giornata di lavoro, smise l'uniforme e indossò abiti comodi.",
        "Devo smettere queste scarpe perché sono troppo piccole."
      ],
      "nota": "Questo significato è meno comune nell'italiano contemporaneo rispetto ad 'interrompere'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Interrompersi, cessare di accadere, riferito a fenomeni naturali o situazioni.",
      "examples": [
        "La pioggia sembra non voler smettere più.",
        "Il motore ha smesso di funzionare improvvisamente."
      ],
      "nota": null
    }
  ]
