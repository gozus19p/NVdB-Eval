  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Aeromobile per il trasporto di persone o merci, caratterizzato da ali fisse e propulsione a motore.",
      "examples": [
        "Abbiamo preso un aereo per la nostra vacanza in Sardegna.",
        "L'aereo ha subito un ritardo di due ore a causa del maltempo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce all'aria, che si trova o si muove nell'aria.",
      "examples": [
        "Le correnti aeree influenzano il clima della regione.",
        "Ha una grazia aerea nel ballare, come se non toccasse terra."
      ],
      "nota": "Nel secondo esempio, 'aerea' ha un senso figurato per indicare leggerezza e grazia."
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha poca consistenza o solidità, leggero, impalpabile.",
      "examples": [
        "Ha costruito dei castelli aerei, sogni irrealizzabili.",
        "La sua mente era piena di pensieri aerei e fantastici."
      ],
      "nota": "Questo senso è spesso usato in contesti figurati per indicare qualcosa di intangibile o inconsistente."
    }
  ]
