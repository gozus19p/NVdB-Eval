  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Ciascuna delle due parti uguali in cui un oggetto, una quantità o un periodo di tempo viene diviso.",
      "examples": [
        "Ho mangiato solo metà della torta, l'altra metà l'ho lasciata per te.",
        "Ci siamo incontrati a metà strada tra le nostre città.",
        "Lavorerò soltanto metà giornata la prossima settimana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La parte centrale o un punto imprecisato di un processo, di un percorso o di un intervallo.",
      "examples": [
        "Siamo a metà del progetto, ci aspetta ancora molto lavoro.",
        "Il film diventa interessante solo a metà.",
        "A metà del mese ti aspetto per la cena."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Una persona che completa o si abbina perfettamente a un'altra, spesso in contesti affettivi o relazionali.",
      "examples": [
        "Finalmente ho trovato la mia dolce metà.",
        "Ci vuole più di una vita per trovare l'altra metà della mela.",
        "Era felice di aver incontrato la sua metà dopo tanti anni."
      ],
      "nota": "Uso figurato per indicare la partner o l'anima gemella."
    }
