  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Mantenere nella memoria informazioni, esperienze o persone, o richiamarle alla coscienza dopo un certo tempo.",
      "examples": [
        "Non riesco a ricordare dove ho lasciato le chiavi.",
        "Ricordo ancora con affetto i giorni passati insieme durante l'infanzia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Far sì che qualcuno non dimentichi qualcosa, richiamando la sua attenzione su un fatto o un dovere.",
      "examples": [
        "Ti ricordo che domani abbiamo un appuntamento importante.",
        "Mi ha ricordato di spegnere le luci prima di uscire."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Avere l'aspetto, le caratteristiche o le qualità di qualcuno o qualcosa, evocando un'associazione mentale.",
      "examples": [
        "Questo dolce mi ricorda la torta che faceva mia nonna.",
        "Il suo modo di parlare mi si ricorda un po' il mio vecchio professore."
      ],
      "nota": "Spesso usato nella forma 'ricordarsi di' o 'ricordare a' con un complemento oggetto."
    }
  ]
