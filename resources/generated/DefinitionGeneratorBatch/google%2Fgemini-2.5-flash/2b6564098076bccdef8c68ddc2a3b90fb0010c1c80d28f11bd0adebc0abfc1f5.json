  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Formazione vegetale caratterizzata dalla presenza dominante di alberi, spesso ad alto fusto, che copre una vasta area di terreno.",
      "examples": [
        "Andammo a raccogliere funghi nel bosco dietro casa.",
        "Il bosco fitto rendeva difficile il passaggio e nascondeva la vista del cielo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Una grande quantità o raggruppamento di elementi simili o disposti in modo da evocare l'immagine di un'area forestale, spesso in senso figurato.",
      "examples": [
        "Un bosco di antenne si stagliava contro il cielo, deturpando il paesaggio urbano.",
        "Tra il bosco di pali della staccionata, era difficile distinguere la strada."
      ],
      "nota": "Questo uso estende il significato letterale a insiemi densi di oggetti che simboleggiano una foresta."
    }
  ]
