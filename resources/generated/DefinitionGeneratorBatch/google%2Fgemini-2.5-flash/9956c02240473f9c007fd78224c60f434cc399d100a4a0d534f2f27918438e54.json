  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rappresentare una persona, un oggetto o un concetto attraverso immagini, simboli o descrizioni.",
      "examples": [
        "Il codice miniato figurava scene della vita di corte.",
        "Il racconto figurava un mondo utopico dove tutti vivevano in armonia."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un aspetto o una presenza in un determinato contesto, suscitando una specifica impressione.",
      "examples": [
        "Non figura bene presentarsi in ritardo a un colloquio.",
        "Il suo nome non figura nella lista degli invitati."
      ],
      "nota": "Spesso usato in espressioni impersonali o con valore enfatico."
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Essere presente o comparire in un luogo, un elenco o un contesto, acquisendo visibilità.",
      "examples": [
        "La sua firma si figura tra i documenti più importanti.",
        "Le sue idee si figurano tra le proposte innovative della riunione."
      ],
      "nota": "L'uso pronominale intensifica l'idea di apparizione o collocazione."
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Immaginare o concepire mentalmente qualcosa, facendosene un'idea chiara.",
      "examples": [
        "Non mi figuro come possa essere arrivato a questa conclusione.",
        "Cercava di figurarsi il volto dell'interlocutore mai incontrato."
      ],
      "nota": "Comunemente usato in espressioni negative o interrogative per negare la possibilità di immaginare."
    }
  ]
