  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Ciascuna delle due parti laterali del corpo di una persona o di un animale, tra il torace e la coscia.",
      "examples": [
        "Il pugile ha ricevuto un colpo potente al fianco, facendolo barcollare.",
        "Il medico ha palpato delicatamente il fianco del paziente per esaminare l'organo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Lato laterale di un oggetto, di un edificio, di un rilievo geografico o di un'imbarcazione.",
      "examples": [
        "Ho parcheggiato l'auto lungo il fianco della strada, vicino al guardrail.",
        "Le truppe nemiche sferrarono un attacco sul fianco della collina, cercando di aggirare le nostre difese."
      ],
      "nota": "Spesso usato nell'ambito militare o per descrivere formazioni."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Posizione o direzione che si trova immediatamente accanto a qualcosa o qualcuno.",
      "examples": [
        "Mi ha camminato al fianco per tutto il tragitto, nonostante la pioggia.",
        "La nuova ala del museo è stata costruita proprio al fianco dell'edificio storico."
      ],
      "nota": "Spesso usato in espressioni preposizionali come 'al fianco di'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sostegno, appoggio morale o concreto che viene offerto a qualcuno in una situazione di difficoltà o in un'impresa comune.",
      "examples": [
        "Sono contento di averla al mio fianco in questo momento così difficile della mia vita.",
        "Il presidente ha promesso il pieno fianco del governo per la ricostruzione delle zone colpite dal terremoto."
      ],
      "nota": "Uso figurato, specialmente nell'espressione 'essere al fianco di'."
    }
  ]
