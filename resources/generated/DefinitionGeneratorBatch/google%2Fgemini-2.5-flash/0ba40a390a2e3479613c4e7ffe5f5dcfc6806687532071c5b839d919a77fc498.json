  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Pronunciare o emettere suoni per attirare l'attenzione di qualcuno o per invitarlo ad avvicinarsi.",
      "examples": [
        "Ho provato a chiamarti, ma non hai risposto.",
        "Il professore ha chiamato lo studente alla lavagna."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dare un nome o un appellativo a qualcuno o qualcosa.",
      "examples": [
        "I genitori hanno deciso di chiamare la figlia Sofia.",
        "Vorrei chiamare il mio nuovo cane 'Buddy'."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Contattare qualcuno telefonicamente.",
      "examples": [
        "Ti chiamo stasera per organizzare la cena.",
        "Ho chiamato il tecnico per riparare il guasto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Far venire o richiedere la presenza di qualcuno in un determinato luogo o per una specifica funzione.",
      "examples": [
        "Dobbiamo chiamare un'ambulanza, l'incidente è grave.",
        "La squadra ha chiamato diversi nuovi giocatori per la prossima stagione."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Avere un determinato nome o appellativo (riferito a sé stessi).",
      "examples": [
        "Mi chiamo Marco e sono di Roma.",
        "Come si chiama questo tipo di fiore?"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Considerare, definire o qualificare qualcuno o qualcosa in un certo modo.",
      "examples": [
        "Molti lo chiamano un genio della finanza.",
        "Questa situazione si può chiamare un vero fallimento."
      ],
      "nota": "Spesso usato in contesti di attribuzione di caratteristiche o giudizi."
    }
  ]
