  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Il legittimo potere di comandare, di prendere decisioni o di far rispettare le leggi, riconosciuto e accettato all'interno di un sistema o una comunità.",
      "examples": [
        "Le decisioni prese dall'autorità locale devono essere rispettate da tutti i cittadini.",
        "Il governo ha rafforzato l'autorità delle forze dell'ordine per contrastare la criminalità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Persona o ente investito di un tale potere, che detiene una posizione di comando o responsabilità.",
      "examples": [
        "Le autorità competenti stanno indagando sull'incidente per determinarne le cause.",
        "Dobbiamo rivolgerci alle autorità sanitarie per avere informazioni precise sulle vaccinazioni."
      ],
      "nota": "Spesso usato al plurale per indicare gli organi di governo o controllo."
    },
    {
      "pos": "sostantivo f.",
      "definition": "La capacità di imporre il proprio prestigio, la propria influenza o le proprie conoscenze, ottenuta attraverso il rispetto, la competenza o l'autorevolezza morale o intellettuale.",
      "examples": [
        "Il professore ha dimostrato una grande autorità nella sua materia, riuscendo a spiegare concetti complessi in modo chiaro.",
        "Nonostante la sua giovane età, la dottoressa si è guadagnata l'autorità e la stima di tutti i colleghi."
      ],
      "nota": "Differisce dal primo senso in quanto non implica necessariamente un potere legale o formale, ma un'influenza personale riconosciuta."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Una fonte di ispirazione o un esperto riconosciuto in un determinato campo del sapere o dell'arte, la cui opinione è considerata valida e degna di fede.",
      "examples": [
        "Per la sua profonda conoscenza della fisica quantistica, è considerato un'autorità indiscussa nel settore.",
        "Nel campo della filosofia antica, Aristotele è da sempre un'autorità citata e studiata."
      ],
      "nota": null
    }
  ]
