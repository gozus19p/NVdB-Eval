  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Affidare qualcosa o qualcuno alla custodia o alla responsabilità altrui, oppure recapitarlo a destinazione.",
      "examples": [
        "Ho dovuto consegnare i documenti al notaio prima della scadenza.",
        "Il corriere non è riuscito a consegnare il pacco perché il destinatario era assente."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ritornare o restituire qualcosa che era stato precedentemente affidato, dato in prestito o commissionato.",
      "examples": [
        "Gli studenti devono consegnare i compiti entro venerdì prossimo.",
        "Dopo la lettura, devi consegnare il libro prestato alla biblioteca."
      ],
      "nota": "Spesso usato nel contesto scolastico o burocratico in riferimento a compiti, elaborati, documenti."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Permettere che una persona o un luogo passi sotto il controllo o la giurisdizione di altri, spesso in un contesto di resa o tradimento.",
      "examples": [
        "I ribelli furono costretti a consegnare le armi alle forze governative.",
        "Il generale decise di consegnare la città per evitare ulteriori spargimenti di sangue."
      ],
      "nota": "Ha spesso una connotazione di resa, rinuncia forzata o, in alcuni contesti, di tradimento."
    }
  ]
