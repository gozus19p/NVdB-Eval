  "senses": [
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Funzionario pubblico che, nell'ambito di un processo giudiziario, ha il compito di esaminare i fatti e applicare le leggi per emettere una sentenza o un provvedimento.",
      "examples": [
        "Il giudice ha ascoltato le testimonianze di entrambe le parti prima di pronunciarsi.",
        "La corte era composta da tre giudici, uno dei quali era il presidente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Persona che, per le proprie competenze o per autorità riconosciuta, è chiamata a valutare, esprimere un parere o decidere in merito a una competizione, una questione o una situazione.",
      "examples": [
        "I giudici della gara di ballo hanno assegnato i punteggi basandosi su tecnica e interpretazione.",
        "Vorrei chiederle un consiglio, lei è un ottimo giudice in fatto di vini."
      ],
      "nota": "Questo senso si estende spesso a contesti non legali, indicando una persona esperta o autorevole."
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Entità o principio astratto che simboleggia la capacità di discernere il giusto dallo sbagliato o di determinare il destino di qualcosa.",
      "examples": [
        "Sarà il tempo il vero giudice di questa decisione.",
        "La storia si è rivelata un giudice severo delle azioni di quel leader."
      ],
      "nota": "Uso figurato."
    }
  ]
