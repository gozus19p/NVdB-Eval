  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che concerne o si estende a tutto il globo terrestre; che interessa tutti i popoli della Terra.",
      "examples": [
        "La seconda guerra mondiale ha avuto un impatto devastante sull'intero pianeta.",
        "Il riscaldamento globale è un problema mondiale che richiede una soluzione congiunta."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di portata eccezionale, universale o di altissimo livello, spesso in riferimento a competizioni, eventi o riconoscimenti.",
      "examples": [
        "Ha stabilito un nuovo record mondiale nel salto in lungo.",
        "L'esposizione di arte contemporanea ha raggiunto una risonanza mondiale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Campionato del mondo, competizione sportiva internazionale che assegna il titolo di campione globale in una determinata disciplina.",
      "examples": [
        "L'Italia ha vinto l'ultimo mondiale di calcio nel 2006.",
        "La squadra si sta preparando intensamente per il mondiale di pallavolo."
      ],
      "nota": "Spesso usato al plurale per indicare l'evento in generale."
    }
