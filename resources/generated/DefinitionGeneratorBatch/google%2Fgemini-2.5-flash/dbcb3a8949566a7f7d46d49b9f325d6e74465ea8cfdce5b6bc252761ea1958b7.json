  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo o appartenente alla città di Roma, alla sua storia, cultura o ai suoi abitanti.",
      "examples": [
        "La cucina romana è molto apprezzata per i suoi piatti tradizionali.",
        "Il Foro Romano è uno dei siti archeologici più famosi al mondo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Nativo o residente della città di Roma.",
      "examples": [
        "Molti artisti romani si sono esibiti in questo teatro.",
        "Ha sposato una ragazza romana e si è trasferito nella capitale."
      ],
      "nota": "Questo senso si sovrappone a 'abitante di Roma', ma enfatizza la provenienza piuttosto che la semplice residenza."
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo all'antica Roma, al suo impero o alla sua civiltà.",
      "examples": [
        "Il diritto romano ha influenzato gran parte dei sistemi giuridici moderni.",
        "Molte delle nostre istituzioni civili hanno radici nella civiltà romana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Abitante o nativo della città di Roma.",
      "examples": [
        "I romani sono noti per la loro ospitalità.",
        "Un romano doc ama la carbonara e le passeggiate al Tevere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "L'antica popolazione che fondò e sviluppò l'Impero Romano.",
      "examples": [
        "I romani parlavano il latino e adoravano un pantheon di divinità.",
        "Le opere ingegneristiche costruite dai romani sono ancora visibili oggi."
      ],
      "nota": null
    }
  ]
