  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Parte staccata o separata da un oggetto o un insieme più grande, solitamente ottenuta per rottura, taglio, o divisione.",
      "examples": [
        "Mi è caduto il vaso e si è rotto in mille pezzi.",
        "Passami un pezzo di pane, per favore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento costitutivo o componente di un meccanismo, una struttura o un sistema.",
      "examples": [
        "Un pezzo di ricambio è indispensabile per riparare il motore.",
        "Mancava un pezzo al puzzle, per questo non riuscivo a completarlo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Opera d'arte o composizione musicale o letteraria con una propria autonomia e un valore artistico.",
      "examples": [
        "Quel pezzo di Brahms mi commuove sempre profondamente.",
        "Il nuovo pezzo teatrale ha ricevuto ottime recensioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Unità di misura informale per indicare una quantità singola di qualcosa, spesso non specificata numericamente con precisione.",
      "examples": [
        "Ho comprato un bel pezzo di formaggio dal salumiere.",
        "Dammi un pezzo di torta, anche piccolo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In senso figurato, persona considerata abile, attraente o degna di nota, spesso con una connotazione positiva o ammirativa.",
      "examples": [
        "Quel calciatore è proprio un bel pezzo, ha segnato tre gol da solo.",
        "La nuova collega è un gran pezzo, competente e carismatica."
      ],
      "nota": "Questo senso è colloquiale e può avere anche una connotazione scherzosa o ammirativa."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In senso figurato, singola informazione o notizia che contribuisce a formare un quadro più completo di una situazione.",
      "examples": [
        "Messo insieme tutti i pezzi, ho capito chi era il colpevole.",
        "Non abbiamo ancora tutti i pezzi per risolvere il caso."
      ],
      "nota": null
    }
  ]
