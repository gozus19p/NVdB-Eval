  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Rivestimento esterno del corpo degli animali e dell'essere umano, costituito da un tessuto connettivo elastico e resistente che svolge funzioni protettive, sensoriali e termoregolatrici.",
      "examples": [
        "La sua pelle era abbronzata dal sole estivo.",
        "Ha una pelle molto sensibile agli agenti atmosferici."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Materiale ottenuto dalla concia della pelle di animali, largamente impiegato nella produzione di capi d'abbigliamento, calzature, borse e altri oggetti.",
      "examples": [
        "Ho comprato una borsa di pelle italiana di alta qualità.",
        "Il giubbotto di pelle è un classico intramontabile."
      ],
      "nota": "Spesso usato come attributo per indicare il materiale (es. 'scarpe di pelle')."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Lo strato più esterno di alcuni frutti o ortaggi, che ne protegge la polpa interna.",
      "examples": [
        "Ho sbucciato la mela togliendo la pelle sottile.",
        "La pelle della pesca è vellutata al tatto."
      ],
      "nota": "Può essere usata anche per riferirsi alla buccia o scorza, a seconda del contesto."
    },
    {
      "pos": "sostantivo f.",
      "definition": "La superficie esterna di qualcosa, specialmente quando è sottile e delicata, o l'aspetto esteriore di una situazione o di un evento.",
      "examples": [
        "La vernice ha formato una pelle lucida sul mobile.",
        "Sotto la pelle della normalità, covava una grande incertezza."
      ],
      "nota": "Uso figurato per indicare l'aspetto superficiale o la facciata di qualcosa."
    },
    {
      "pos": "sostantivo f.",
      "definition": "La vita stessa di una persona o di un animale, specialmente in espressioni che indicano pericolo o salvezza.",
      "examples": [
        "Si è salvato la pelle per un soffio durante l'incidente.",
        "Ha dovuto rischiare la propria pelle per difendere i suoi ideali."
      ],
      "nota": "Spesso usata in locuzioni idiomatiche come 'salvare la pelle' o 'rischiare la pelle'."
    }
  ]
