  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non ha autonomia o indipendenza, ma è subordinato o influenzato da qualcos'altro.",
      "examples": [
        "La sua felicità è dipendente dall'approvazione degli altri.",
        "Il risultato finale sarà dipendente dalla nostra capacità di collaborare."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a una persona economicamente o gerarchicamente subordinata a un'altra, tipicamente in ambito lavorativo.",
      "examples": [
        "Ha un contratto di lavoro dipendente da un'azienda farmaceutica.",
        "È un lavoratore dipendente da oltre vent'anni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Persona che presta la propria attività lavorativa sotto la direzione e il controllo di un datore di lavoro, in cambio di una retribuzione.",
      "examples": [
        "I dipendenti dell'ufficio hanno organizzato uno sciopero per protestare contro i tagli.",
        "Ogni dipendente ha diritto a un certo numero di giorni di ferie retribuite all'anno."
      ],
      "nota": "Si riferisce sia a uomini che a donne."
    }
  ]
