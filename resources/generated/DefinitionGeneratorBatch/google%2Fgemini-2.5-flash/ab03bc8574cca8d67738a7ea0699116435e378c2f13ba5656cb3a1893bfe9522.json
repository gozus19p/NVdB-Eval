  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova all'estremità o ai confini spaziali o temporali di qualcosa.",
      "examples": [
        "Il paese si trova all'estremo nord della regione.",
        "Ha dedicato le sue estreme energie al completamento del progetto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che rappresenta il grado massimo o minimo di un fenomeno o di una qualità; eccessivo, radicale, superlativo.",
      "examples": [
        "La situazione richiede interventi estremi per essere risolta.",
        "Ha espresso un'estrema gratitudine per l'aiuto ricevuto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Ultimo nel tempo o nell'ordine di una serie di eventi o di una successione.",
      "examples": [
        "La decisione finale è stata l'estrema riga del discorso.",
        "Ha rilasciato le sue estreme dichiarazioni prima di ritirarsi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il punto più distante o più grande di qualcosa, sia in senso spaziale che figurato.",
      "examples": [
        "Non è giusto giudicare le persone basandosi sugli estremi.",
        "È arrivato all'estremo della sopportazione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Comportamento o idea che si discosta molto dalla norma o dalla moderazione.",
      "examples": [
        "Evita gli estremi nel tuo stile di vita.",
        "Le sue opinioni politiche rasentano gli estremi."
      ],
      "nota": null
    }
  ]
