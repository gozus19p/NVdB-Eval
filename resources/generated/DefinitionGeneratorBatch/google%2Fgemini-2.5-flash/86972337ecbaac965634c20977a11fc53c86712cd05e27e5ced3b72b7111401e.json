  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Caratteristica distintiva o insieme di tratti particolari che identificano una categoria specifica di persone, oggetti o fenomeni.",
      "examples": [
        "Che tipo di musica ti piace ascoltare?",
        "Esistono diversi tipi di caffè in commercio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona di cui si vuole indicare in modo generico l'aspetto, il carattere o il comportamento.",
      "examples": [
        "È un tipo molto simpatico e disponibile, ci ha aiutato subito.",
        "Guarda quel tipo strano laggiù, non l'avevo mai visto prima."
      ],
      "nota": "Spesso usato in contesti informali per riferirsi a qualcuno in modo poco specifico."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Modello o esemplare che serve come riferimento o prototipo per la produzione o la classificazione di altri elementi simili.",
      "examples": [
        "Questo è il tipo originale su cui sono basati tutti i modelli successivi.",
        "Il nuovo modello di auto è un tipo sportivo e molto elegante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In tipografia, la singola unità di metallo o legno recante scolpito a rilievo un carattere alfanumerico o un simbolo, usata per la composizione.",
      "examples": [
        "Le antiche macchine da stampa usavano i tipi mobili per comporre le pagine.",
        "Ogni tipo era inciso con grande precisione per ottenere una stampa chiara."
      ],
      "nota": null
    }
  ]
