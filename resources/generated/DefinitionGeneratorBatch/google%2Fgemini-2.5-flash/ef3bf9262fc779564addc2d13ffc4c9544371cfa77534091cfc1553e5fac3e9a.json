  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si manifesta o accade in modo repentino e inaspettato, senza preavviso o preparazione.",
      "examples": [
        "Un rumore improvviso mi ha fatto sobbalzare.",
        "La sua partenza improvvisa ha sorpreso tutti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Atto, comportamento o evento che si verifica senza premeditazione o preparazione, spesso dettato dall'istinto o dalla casualità.",
      "examples": [
        "Decise di partire di punto in bianco, per un improvviso desiderio di avventura.",
        "Ha agito d'improvviso, senza pensarci due volte."
      ],
      "nota": "Spesso usato nella locuzione avverbiale 'all'improvviso' o 'd'improvviso'."
    }
