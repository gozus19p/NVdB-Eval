  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che è venerato per la sua pietà o per aver subito il martirio, riconosciuto come tale da una religione, specialmente quella cristiana.",
      "examples": [
        "San Francesco è il patrono d'Italia.",
        "La vita dei santi è spesso fonte di ispirazione per i fedeli."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Considerato sacro o inviolabile, degno di profondo rispetto e venerazione.",
      "examples": [
        "Mantenere la parola data è un impegno santo.",
        "Per molte culture, la famiglia è un'istituzione santa e intoccabile."
      ],
      "nota": "Riferito a concetti astratti o istituzioni."
    },
    {
      "pos": "aggettivo",
      "definition": "Persona estremamente buona, generosa o ingenua.",
      "examples": [
        "Mia nonna è una santa, ha sempre una buona parola per tutti."
      ],
      "nota": "Spesso usato in senso figurato o iperbolico, anche in tono ironico."
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Individuo che, per la sua vita di eccezionale virtù, è venerato come tale in una religione, specialmente nel cristianesimo, e funge da intercessore presso la divinità.",
      "examples": [
        "Invocare i santi in preghiera è una pratica comune.",
        "Ogni paese ha il suo santo patrono, celebrato con feste dedicate."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Immagine, statua o raffigurazione di un soggetto venerato.",
      "examples": [
        "C'è un piccolo santo nella nicchia del muro.",
        "Teneva sempre con sé un santino come portafortuna."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Espressione usata in esclamazioni per indicare fastidio, meraviglia o disapprovazione.",
      "examples": [
        "Santo cielo, che guaio abbiamo combinato!",
        "Che santo diavolo, mi hai spaventato a morte!"
      ],
      "nota": "Usato in esclamazioni fisse come 'santo cielo', 'santo subito'."
    }
  ]
}