  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di piccolissime particelle solide, molto leggere, che si depositano sulle superfici o rimangono sospese nell'aria, spesso derivanti dalla disintegrazione di materiali o da processi naturali.",
      "examples": [
        "Ho passato la mattinata a togliere la polvere dai mobili.",
        "Dopo il crollo, una densa nube di polvere ha avvolto l'edificio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Sostanza solida finemente granulare, spesso impiegata in ambito chimico, alimentare o farmaceutico, o come propellente per armi da fuoco.",
      "examples": [
        "L'atleta ha mescolato la polvere proteica con l'acqua.",
        "Il cacciatore ha caricato il fucile con la polvere da sparo."
      ],
      "nota": "A differenza del primo senso, qui si riferisce a una sostanza specifica con una funzione, non a un semplice accumulo di particelle."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Lo stato di dissoluzione o consunzione totale; la condizione di qualcosa che si riduce a nulla o si disgrega completamente, spesso in senso figurato per riferirsi alla fine di un'esistenza o di un'impresa.",
      "examples": [
        "I suoi sogni di gloria si ridussero in polvere dopo il fallimento.",
        "La città antica è stata ritrovata sotto metri di polvere e detriti."
      ],
      "nota": "Uso figurato per indicare la distruzione o il disfacimento."
    }
  ]
