  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Impegno finanziario che una persona o un'entità contrae nei confronti di un'altra, obbligandosi a restituire una somma di denaro o un bene.",
      "examples": [
        "Ho pagato tutti i miei debiti e ora sono finalmente libero.",
        "Il debito pubblico è aumentato notevolmente quest'anno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Obbligo morale o sociale, un dovere che si sente di dover adempiere o un riconoscimento per un favore ricevuto.",
      "examples": [
        "Sento di avere un debito di gratitudine nei suoi confronti per l'aiuto che mi ha dato.",
        "È venuto a saldare il suo debito d'onore dopo anni."
      ],
      "nota": "Spesso usato in espressioni come 'debito di gratitudine', 'debito d'onore'."
    },
    {
      "pos": "aggettivo",
      "definition": "Conforme a ciò che è giusto, appropriato o lecito; che è opportuno o dovuto.",
      "examples": [
        "Ha ricevuto il debito riconoscimento per il suo lavoro.",
        "Agire secondo la debita procedura è fondamentale."
      ],
      "nota": "Spesso usato in forme come 'il debito', 'la debita'."
    }
  ]
