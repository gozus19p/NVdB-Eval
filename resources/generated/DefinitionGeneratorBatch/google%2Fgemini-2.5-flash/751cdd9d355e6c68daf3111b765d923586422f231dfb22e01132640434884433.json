  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dirigere un veicolo o un animale, controllandone la direzione e la velocità.",
      "examples": [
        "Ho imparato a guidare l'auto fin da giovane, appena ho preso la patente.",
