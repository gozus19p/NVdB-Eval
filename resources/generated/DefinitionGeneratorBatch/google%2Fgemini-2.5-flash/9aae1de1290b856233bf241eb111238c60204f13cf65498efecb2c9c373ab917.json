  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si incontra o si verifica con poca frequenza o in quantità limitata.",
      "examples": [
        "Le orchidee di quella specie sono fiori molto rari da trovare in natura.",
        "È un evento così raro che capita una volta ogni cent'anni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che denota un pregio o una qualità eccezionale, che lo rende quasi unico nel suo genere.",
      "examples": [
        "Un talento così raro merita di essere coltivato con cura e attenzione.",
        "Possiede una rara capacità di ascolto, che lo rende un amico prezioso."
      ],
      "nota": "Spesso usato in contesti di apprezzamento o ammirazione."
    },
    {
      "pos": "aggettivo",
      "definition": "Di materiale o tessuto, che presenta una tessitura rada, con spazi significativi tra gli elementi.",
      "examples": [
        "Il tessuto di lino, soprattutto d'estate, è molto raro e permette alla pelle di respirare.",
        "I capelli erano così rari che la cute si intravedeva facilmente."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "Di uso non frequente o non costante.",
      "examples": [
        "Viene in città molto raro, quasi ogni cinque anni.",
        "Si manifesta raro con scatti d'ira, per il resto è sempre tranquillo."
      ],
      "nota": "È meno comune dell'avverbio 'raramente', ma attestato nell'uso colloquiale."
    }
  ]
