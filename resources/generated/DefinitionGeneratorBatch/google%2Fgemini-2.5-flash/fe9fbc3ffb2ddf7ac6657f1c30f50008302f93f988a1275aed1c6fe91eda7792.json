  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova a grande distanza nello spazio o nel tempo rispetto a un punto di riferimento o all'osservatore.",
      "examples": [
        "La sua casa è molto lontana dalla mia, ci vuole un'ora per arrivarci.",
        "Il ricordo di quell'estate è ormai lontano, quasi sbiadito nella memoria."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è dissimile o estraneo per natura, carattere o principi rispetto a qualcosa d'altro.",
      "examples": [
        "Le sue idee sono lontane dal mio modo di pensare, non riusciamo a trovarci d'accordo.",
        "Una soluzione del genere sarebbe lontana dalle nostre aspettative iniziali."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "A grande distanza nello spazio o nel tempo.",
      "examples": [
        "Ho parcheggiato lontano perché non ho trovato posto più vicino.",
        "Andare lontano da tutto mi ha aiutato a riflettere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Un luogo o un periodo di tempo che si trova a grande distanza o che non è vicino.",
      "examples": [
        "Preferisce guardare il mondo dal lontano, senza immergersi troppo nelle faccende altrui.",
        "Dal lontano ci giungevano le note di un'antica melodia."
      ],
      "nota": "Spesso usato con la preposizione 'da' per indicare provenienza o separazione da un punto distante."
    }
  ]
