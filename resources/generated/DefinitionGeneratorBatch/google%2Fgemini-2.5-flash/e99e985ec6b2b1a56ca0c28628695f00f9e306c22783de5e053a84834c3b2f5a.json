  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Inseguire e catturare animali selvatici a scopo alimentare, sportivo o di controllo della popolazione.",
      "examples": [
        "Gli antichi abitanti delle caverne usavano frecce e lance per cacciare i mammut.",
        "Mio nonno andava sempre a cacciare cinghiali in montagna durante la stagione.",
        "Il bracconiere è stato arrestato mentre cercava di cacciare animali protetti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Allontanare o espellere qualcuno o qualcosa con la forza o in modo risoluto da un luogo o una posizione.",
      "examples": [
        "Il proprietario ha dovuto cacciare gli inquilini che non pagavano l'affitto da mesi.",
        "Dopo la lite, lo hanno cacciato via dal locale.",
        "È stato cacciato dalla squadra per il suo comportamento antisportivo."
      ],
      "nota": "Spesso usato in contesti di allontanamento forzato o autoritario."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Introdurre qualcosa con forza o rapidità all'interno di un'altra cosa, spesso con un gesto deciso.",
      "examples": [
        "Ha cacciato la chiave nella toppa e ha girato con fretta.",
        "Il bambino caccia il dito nel naso quando è annoiato.",
        "Non cacciare la mano dentro il sacchetto senza guardare cosa c'è."
      ],
      "nota": "Implica un'azione rapida e a volte invadente."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ricercare con insistenza o trovare qualcosa con difficoltà, spesso riferito a informazioni o oggetti specifici.",
      "examples": [
        "Dobbiamo cacciare tutte le prove possibili per risolvere il mistero.",
        "Sono ore che cerco di cacciare la soluzione a questo enigma.",
        "È un lavoro duro cacciare la verità in un mare di menzogne."
      ],
      "nota": "Uso figurato che estende il concetto di 'ricerca' tipico della caccia al mondo delle idee o delle informazioni."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Finire in una situazione spiacevole o difficile a causa delle proprie azioni o di eventi esterni.",
      "examples": [
        "Se continui così, ti caccerai nei guai.",
        "Non volevo, ma mi sono cacciato in un bel pasticcio.",
        "Spero di non cacciarmi in situazioni imbarazzanti durante il viaggio."
      ],
      "nota": "Comunemente usato nell'espressione 'cacciarsi nei guai' o 'cacciarsi in un pasticcio'."
    }
  ]
