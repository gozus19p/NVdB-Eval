  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non è soggetto a limitazioni, vincoli o costrizioni di tipo fisico, morale o legale.",
      "examples": [
        "Ho una mente completamente libera da pregiudizi.",
        "Il cittadino è libero di esprimere la propria opinione senza timore di ritorsioni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non è impegnato, occupato o utilizzato da qualcosa o qualcuno.",
      "examples": [
        "Hai un minuto libero per aiutarmi con questo compito?",
        "Il parcheggio davanti al cinema è completamente libero a quest'ora."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non è sotto il controllo o la proprietà di altri; autonomo, indipendente.",
      "examples": [
        "Dopo il divorzio si sentiva finalmente una donna libera dai condizionamenti della famiglia del marito.",
        "Il popolo ha lottato a lungo per la sua terra e ora gode di uno stato libero e sovrano."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non è vincolato da un obbligo o da un dovere specifico; esente.",
      "examples": [
        "Oggi sono libero dal lavoro, possiamo andare al mare.",
        "Il professore mi ha dato un giorno libero per finire la ricerca."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che può muoversi o agire senza impedimenti, senza ostacoli.",
      "examples": [
        "Lascia che il gatto sia libero di esplorare il giardino.",
        "I bambini giocavano liberi nel prato, correndo e saltando senza preoccupazioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Nell'ambito dello sport, specialmente nel calcio, un giocatore che ha il compito di coprire la difesa, posizionandosi dietro i compagni di reparto senza marcare un avversario specifico.",
      "examples": [
        "Il libero era il perno della difesa nella squadra degli anni Settanta.",
        "La tattica con il libero è stata progressivamente abbandonata nel calcio moderno."
      ],
      "nota": "Riferimento a un ruolo calcistico ormai meno diffuso, ma ancora noto."
    }
  ]
