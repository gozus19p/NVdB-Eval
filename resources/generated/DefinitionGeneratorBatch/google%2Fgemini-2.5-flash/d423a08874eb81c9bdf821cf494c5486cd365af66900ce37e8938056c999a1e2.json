  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Impedire completamente il movimento o il funzionamento di qualcosa o qualcuno.",
      "examples": [
        "Un guasto improvviso ha bloccato il treno in galleria.",
        "La polizia è riuscita a bloccare la fuga del rapinatore."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere un processo, un'attività o un progetto, impedendone il proseguimento.",
      "examples": [
        "La mancanza di fondi ha bloccato lo sviluppo del nuovo software.",
        "Le trattative sono state bloccate a causa di disaccordi insormontabili."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Fissare saldamente un oggetto in una determinata posizione, in modo che non possa muoversi.",
      "examples": [
        "È necessario bloccare le ruote del veicolo prima di effettuare la riparazione.",
        "La gru ha bloccato il carico in sicurezza prima di sollevarlo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Nel linguaggio informatico, impedire l'accesso o l'utilizzo di una risorsa, un account o un utente.",
      "examples": [
        "L'amministratore ha bloccato l'account dell'utente che ha violato le regole.",
        "Il firewall ha bloccato l'accesso a siti web ritenuti pericolosi."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Perdere la capacità di muoversi o di agire liberamente, spesso a causa di paura o sorpresa.",
      "examples": [
        "Di fronte alla minaccia, il cervo si è bloccato e non è riuscito a scappare.",
        "Quando l'ho vista, mi sono bloccato e non sono riuscito a dire una parola."
      ],
      "nota": null
    }
  ]
