  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Grandezza fisica vettoriale che esprime la rapidità di variazione di una posizione rispetto al tempo e la direzione del movimento.",
      "examples": [
        "La velocità del suono nell'aria è di circa 343 metri al secondo.",
        "Il satellite ha raggiunto una velocità orbitale elevatissima."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La rapidità con cui si svolge un'azione, un processo o un evento.",
      "examples": [
        "Ha svolto il compito con una velocità sorprendente, finendo in pochi minuti.",
        "La velocità di propagazione di un'epidemia può avere conseguenze devastanti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In meccanica e automobilismo, ognuna delle possibili regolazioni del rapporto di trasmissione di un veicolo, che determina la potenza e la rapidità raggiunta.",
      "examples": [
        "Ha messo la terza velocità per affrontare la salita ripida.",
        "Il pilota ha ingranato la marcia più alta per raggiungere la massima velocità in rettilineo."
      ],
      "nota": "Spesso usato come sinonimo di 'marcia'."
    }
