  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Atto, evento o momento in cui due o più persone si trovano o si vedono intenzionalmente o in modo casuale.",
      "examples": [
        "Il nostro primo incontro è avvenuto alla festa di compleanno di Marco.",
        "Abbiamo organizzato un incontro per discutere il progetto la prossima settimana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Appuntamento o riunione formale tra persone o gruppi per trattare questioni specifiche, spesso di natura diplomatica, politica o professionale.",
      "examples": [
        "L'incontro tra i due presidenti si è concluso con un comunicato congiunto.",
        "Parteciperò a un incontro di lavoro domani mattina per definire gli obiettivi annuali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Evento sportivo che vede confrontarsi due squadre o atleti in una competizione.",
      "examples": [
        "L'incontro di calcio è stato rinviato a causa del maltempo.",
        "Ha vinto l'incontro di tennis dopo una partita molto combattuta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Confronto o scontro, spesso di idee o interessi contrapposti.",
      "examples": [
        "L'incontro tra le diverse visioni ha generato un dibattito acceso.",
        "Questo romanzo offre un profondo incontro con la cultura orientale."
      ],
      "nota": "Distinguere questo senso da 'confronto' o 'scontro' che implicano maggiore conflittualità, mentre 'incontro' in questo contesto può indicare anche un arricchimento reciproco."
    },
    {
      "pos": "preposizione impropria",
      "definition": "In direzione di, verso un punto o una persona.",
      "examples": [
        "Mi sono diretto incontro a lui non appena l'ho visto.",
        "Il vento soffiava incontro, rendendo difficile il cammino."
      ],
      "nota": "Spesso usato in combinazione con verbi di movimento, come 'andare incontro', 'venire incontro'."
    }
  ]
