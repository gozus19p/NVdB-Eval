  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta molteplici caratteristiche, forme, tipi o qualità differenti tra loro.",
      "examples": [
        "Ho una collezione molto varia di francobolli da tutto il mondo.",
        "Il menù del ristorante offre una scelta varia di piatti per tutti i gusti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che non rimane costante, che subisce cambiamenti o alterazioni nel tempo o nella situazione.",
      "examples": [
        "Le condizioni meteorologiche sono state piuttosto varie durante la giornata, con sole e rovesci improvvisi.",
        "Il suo umore è vario, può passare dalla gioia alla tristezza in pochi minuti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è disomogeneo, composto da elementi eterogenei o non uniformi.",
      "examples": [
        "Il tessuto è vario nella trama, con inserti di diversi materiali.",
        "Il pubblico presente allo spettacolo era molto vario per età ed estrazione sociale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Un insieme di cose diverse, un misto o un assortimento.",
      "examples": [
        "Ha preparato un vario di frutta fresca per il dessert.",
        "In soffitta abbiamo trovato un vario di oggetti antichi e moderni."
      ],
      "nota": "Questo uso è meno comune dell'aggettivo e si trova spesso in espressioni come 'un vario di...'"
    }
  ]
