  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Singolo avvenimento o fatto, spesso di una certa rilevanza o particolare, che si inserisce in una serie più ampia di eventi o in un contesto complessivo.",
      "examples": [
        "L'arresto del criminale è stato l'episodio culminante delle indagini.",
        "Ricordo ancora quell'episodio divertente accaduto durante le vacanza estiva."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Ciascuna delle parti autonome in cui è suddivisa un'opera narrativa seriale (come un film, una serie televisiva, un fumetto, un podcast), che rientra in una trama generale ma ha una sua compiutezza.",
      "examples": [
        "Ho guardato tutti gli episodi dell'ultima stagione della mia serie preferita.",
        "Ogni settimana attendiamo con ansia il nuovo episodio del podcast di fantascienza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un breve e circoscritto periodo di tempo in cui si manifesta una condizione, spesso anomala o particolare, all'interno di una situazione più estesa e continuativa.",
      "examples": [
        "Durante l'inverno abbiamo avuto diversi episodi di freddo intenso.",
        "Il paziente ha avuto un episodio febbrile notturno, ma ora sta meglio."
      ],
      "nota": null
    }
  ]
