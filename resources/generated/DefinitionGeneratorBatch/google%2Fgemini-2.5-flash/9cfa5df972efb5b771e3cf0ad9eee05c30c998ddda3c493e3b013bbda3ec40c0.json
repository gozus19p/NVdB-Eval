  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha o emana un'alta temperatura, superiore alla media o gradevole al tatto.",
      "examples": [
        "Oggi fa davvero caldo, si boccheggia per la strada.",
        "Mi piace bere il caffè caldo al mattino."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a colori, tonalità che richiamano il fuoco o il sole, come il rosso e l'arancione, e che trasmettono una sensazione di vivacità ed energia.",
      "examples": [
        "Ha scelto delle tonalità calde per le pareti del salotto.",
        "Il tramonto dipingeva il cielo con colori caldi e intensi."
      ],
      "nota": "Contrario di 'freddo' in questo contesto."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a capi d'abbigliamento, che fornisce un buon isolamento termico contro il freddo.",
      "examples": [
        "Ho comprato un maglione molto caldo per l'inverno.",
        "Questa coperta calda è perfetta per le serate autunnali."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Figurato: riferito a una persona o un atteggiamento, che mostra affettuosità, passione, entusiasmo o partecipazione emotiva intensa.",
      "examples": [
        "Mi ha accolto con un abbraccio caldo e sincero.",
        "Ha pronunciato parole calde che hanno toccato il cuore di tutti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Sensazione di elevata temperatura o lo stato atmosferico caratterizzato da essa.",
      "examples": [
        "In estate soffro molto il caldo.",
        "Dopo la corsa sentiva un gran caldo addosso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Situazione di forte emozione, tensione o passione.",
      "examples": [
        "Nel caldo della discussione, ha perso la pazienza.",
        "Il caldo della battaglia li ha spinti a osare."
      ],
      "nota": "Spesso usato in espressioni preposizionali come 'nel caldo di'."
    }
  ]
