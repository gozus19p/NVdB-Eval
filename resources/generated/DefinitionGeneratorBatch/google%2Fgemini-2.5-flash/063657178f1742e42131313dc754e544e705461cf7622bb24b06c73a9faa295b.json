  "senses": [
    {
      "pos": "avverbio di luogo",
      "definition": "In posizione posteriore rispetto a un punto di riferimento, in contrapposizione a 'davanti'.",
      "examples": [
        "Ho lasciato le chiavi dietro la porta, sul tavolino.",
        "Il bambino si nascondeva dietro le tende per non farsi vedere."
      ],
      "nota": null
    },
    {
      "pos": "avverbio di luogo",
      "definition": "In un luogo successivo o seguente, con riferimento a un percorso o una sequenza.",
      "examples": [
        "Non guardare dietro, continua a camminare.",
        "Chiudi la porta dietro di te quando esci."
      ],
      "nota": null
    },
    {
      "pos": "preposizione impropria",
      "definition": "Indica il retro, la parte posteriore o il lato opposto di qualcosa.",
      "examples": [
        "Ha parcheggiato la macchina dietro il garage.",
        "C'è un bel giardino dietro la casa."
      ],
      "nota": null
    },
    {
      "pos": "preposizione impropria",
      "definition": "In seguito a un evento o una persona, con un significato di successione temporale o di conseguenza.",
      "examples": [
        "Non lasciare debiti dietro di te se vuoi essere sereno.",
        "Dietro ogni grande successo c'è sempre molto lavoro."
      ],
      "nota": "Spesso usato in espressioni idiomatiche come 'lasciare dietro', 'mettere dietro'."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "La parte posteriore di un oggetto o di un corpo.",
      "examples": [
        "Mi fa male il dietro della testa dopo la caduta.",
        "Il dietro del pantalone si è strappato camminando."
      ],
      "nota": "Uso colloquiale."
    }
