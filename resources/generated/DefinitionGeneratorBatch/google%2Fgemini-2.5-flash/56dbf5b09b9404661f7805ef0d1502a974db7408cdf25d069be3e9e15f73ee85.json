  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Rivolgere uno sforzo, un'azione o un pensiero verso un determinato scopo o direzione, o avere una propensione naturale verso qualcosa.",
      "examples": [
        "In questo periodo tendo ad alzarmi sempre tardi la mattina.",
        "Il suo discorso tendeva a sminuire l'importanza dell'evento.",
        "Ogni sua azione tende al raggiungimento dei suoi obiettivi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Mettere in tensione o estendere qualcosa che è elastico o flessibile, tirandolo tra due punti o in una certa direzione.",
      "examples": [
        "Bisogna tendere bene la corda prima di appenderci i panni.",
        "Ha teso l'arco per scoccare la freccia.",
        "Il vento tendeva le vele della piccola imbarcazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Offrire o porgere qualcosa a qualcuno con la mano, spesso con l'intenzione di dare o ricevere.",
      "examples": [
        "Ha teso la mano per salutarmi cordialmente.",
        "Il mendicante tendeva una ciotola vuota ai passanti.",
        "Ti tenderò un braccio se avrai bisogno di aiuto."
      ],
      "nota": "Sovente usato in espressioni idiomatiche come 'tendere la mano' o 'tendere l'orecchio'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Predisporre un inganno o una trappola per catturare o danneggiare qualcuno.",
      "examples": [
        "Hanno teso un agguato ai rapinatori.",
        "La polizia ha teso una trappola al trafficante di droga.",
        "Certo che sei stato ingenuo a cadere nella trappola che ti hanno teso."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Allungarsi o stirarsi in una certa direzione, spesso per raggiungere qualcosa o per distendersi.",
      "examples": [
        "Si tese per afferrare il libro sullo scaffale più alto.",
        "Il gatto si tese sulla poltrona dopo un lungo sonno.",
        "Si è teso per sentire meglio la discussione."
      ],
      "nota": null
    }
  ]
