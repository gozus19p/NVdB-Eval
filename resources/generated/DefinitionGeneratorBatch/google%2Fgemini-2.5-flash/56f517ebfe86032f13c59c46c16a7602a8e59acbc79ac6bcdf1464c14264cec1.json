  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Separare qualcosa dal punto o dalla superficie a cui era attaccata o unita, usando forza o un taglio.",
      "examples": [
        "Ho dovuto staccare l'etichetta appiccicosa dalla bottiglia.",
        "Il vento forte ha staccato alcune tegole dal tetto della casa."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Interrompere una connessione, un collegamento o un'alimentazione.",
      "examples": [
        "Ricordati di staccare la spina della televisione prima di uscire.",
        "Ha dovuto staccare il microfono per evitare l'eco."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Guadagnare o raggiungere un vantaggio, un distacco, in termini di tempo, punti o posizione, rispetto a qualcun altro.",
      "examples": [
        "Il ciclista è riuscito a staccare il gruppo negli ultimi chilometri.",
        "La nostra squadra ha staccato gli avversari di ben dieci punti nel terzo quarto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rilasciare o emettere un documento, un biglietto o un permesso.",
      "examples": [
        "L'impiegato ha staccato la ricevuta del pagamento.",
        "Dobbiamo staccare i biglietti per il concerto entro questa sera."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un elemento musicale o un suono in modo netto, ben separato dagli altri.",
      "examples": [
        "Il pianista deve staccare bene le note di questo passaggio.",
        "Il direttore d'orchestra ha chiesto ai violini di staccare i vibrato."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Separarsi fisicamente o emotivamente da un luogo, una persona o una situazione.",
      "examples": [
        "Dopo ore di studio, sentivo il bisogno di staccarmi un po' dai libri.",
        "È difficile staccarsi dalla propria famiglia quando si vive all'estero."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentare un forte contrasto visivo, spiccare, distinguersi nettamente.",
      "examples": [
        "Il rosso vivo delle rose staccava sul verde scuro delle foglie.",
        "La sua voce forte staccava rispetto al tono sommesso degli altri partecipanti."
      ],
      "nota": null
    }
  ]
