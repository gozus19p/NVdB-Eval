  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Felino domestico di piccola taglia, generalmente ricoperto di pelo, allevato dall'uomo come animale da compagnia per la sua agilità e indipendenza, noto per essere un predatore di piccoli roditori.",
      "examples": [
        "Il mio gatto passa le giornate a dormire sul divano.",
        "Ho adottato un gatto randagio dal rifugio e ora è felicissimo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Specie di pesci d'acqua salata, spesso chiamati anche pesci gatto, che presentano lunghi bargigli attorno alla bocca.",
      "examples": [
        "In acquario ho visto un gatto di mare molto curioso.",
        "I pescatori hanno tirato su una rete piena di pesci gatto."
      ],
      "nota": "Questo senso si riferisce a diverse specie di pesci con caratteristiche comuni, ma non è direttamente collegato all'animale terrestre."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Dispositivo meccanico utilizzato per sollevare pesi, specialmente veicoli, tramite un sistema a leva o idraulico.",
      "examples": [
        "Per cambiare la ruota dell'auto mi serve un gatto.",
        "Il meccanico ha usato il gatto per sollevare il furgone."
      ],
      "nota": null
    },
    {
      "pos": "espressione idiomatica",
      "definition": "Situazione o comportamento molto disonesto e sleale, spesso nascosto o insidioso.",
      "examples": [
        "C'è del gatto sotto, non mi fido di questa offerta così vantaggiosa.",
        "Temo ci sia qualche gatto in questa faccenda, è troppo strano."
      ],
      "nota": "Usato principalmente nell'espressione 'c'è del gatto' o 'qui gatta ci cova'."
    }
  ]
