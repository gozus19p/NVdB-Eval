  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Movimento del corpo, specialmente delle mani, delle braccia o della testa, compiuto per esprimere un'idea, un sentimento o per accompagnare il linguaggio parlato.",
      "examples": [
        "Un semplice gesto con la mano fu sufficiente a salutare i miei amici.",
        "Ha fatto un gesto di impazienza quando ha visto il ritardo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Azione o comportamento significativo e talvolta appariscente, compiuto per dimostrare un atteggiamento, un sentimento o un intento, spesso con una valenza simbolica o etica.",
      "examples": [
        "Il suo è stato un gesto di grande generosità verso chi aveva bisogno.",
        "Compiere un gesto eroico ha significato sacrificare la propria vita per gli altri."
      ],
      "nota": "Questo senso enfatizza l'aspetto morale o simbolico dell'azione."
    }
