  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Stato di riposo profondo e naturale in cui l'organismo rallenta le sue funzioni vitali, cessa le attività coscienti e si recupera dalle fatiche fisiche e mentali.",
      "examples": [
        "Dopo una lunga giornata di lavoro, un buon sonno è ristoratore.",
        "Il bambino è caduto in un sonno profondo subito dopo aver mangiato.",
        "Ho passato tutta la notte insonne e ora ho un gran bisogno di sonno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sensazione fisiologica impellente di addormentarsi o desiderio di coricarsi per riposare.",
      "examples": [
        "Avevo così tanto sonno che faticavo a tenere gli occhi aperti.",
        "Il sonno mi assalì durante la lezione, nonostante il caffè.",
        "Non riesco a concentrarmi, ho troppo sonno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Periodo, più o meno prolungato, in cui una persona dorme.",
      "examples": [
        "Ho fatto un sonno agitato, pieno di sogni strani.",
        "Mi sono goduto un sonno ininterrotto per otto ore.",
        "Il suo sonno fu interrotto da un rumore improvviso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Figurativamente, condizione di inattività, inerzia o torpore, specialmente in riferimento a facoltà intellettuali, morali o a processi sociali.",
      "examples": [
        "Il paese è uscito da un lungo sonno economico dopo anni di stagnazione.",
        "Le sue capacità artistiche erano rimaste in un sonno forzato per molto tempo.",
        "È ora di risvegliarsi dal sonno dell'indifferenza e agire."
      ],
      "nota": "Spesso usato in espressioni come 'il sonno della ragione' o 'il sonno della morte'."
    }
  ]
