  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Collocare qualcosa in modo che resti stabile o trovi sostegno su qualcos'altro, solitamente una superficie o un oggetto di base.",
      "examples": [
        "Ho appoggiato la borsa sul sedile posteriore dell'auto.",
        "Sei pregato di appoggiare i piedi sul poggiapiedi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sostenere un'idea, una proposta o una persona, fornendo aiuto, consenso o supporto morale o pratico.",
      "examples": [
        "Il partito ha deciso di appoggiare la riforma del sistema sanitario.",
        "Molti colleghi hanno appoggiato la mia candidatura per il nuovo ruolo."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Mettere il proprio corpo o una sua parte a contatto con qualcosa per trovare stabilità o riposo.",
      "examples": [
        "Si appoggiò allo schienale della sedia per rilassarsi.",
        "Il bambino si appoggiò alla madre, cercando conforto."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a un'imbarcazione a vela, cambiare bordo al vento, ma in modo più dolce e graduale rispetto a 'virare'.",
      "examples": [
        "La barca ha appoggiato dolcemente, prendendo una nuova direzione.",
        "Dobbiamo appoggiare per sfruttare al meglio il vento."
      ],
      "nota": "Specifica del linguaggio nautico."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito al cibo o al vino, subire un processo di maturazione o affinamento che ne migliora le qualità organolettiche.",
      "examples": [
        "Il formaggio deve appoggiare per almeno un mese prima di essere consumato.",
        "Questo vino ha bisogno di appoggiare ancora un po' in cantina."
      ],
      "nota": "Uso comune in enologia e gastronomia."
    }
  ]
