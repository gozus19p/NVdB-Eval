  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Modalità di organizzazione degli elementi costitutivi di un insieme, che ne determina la forma, la stabilità e le proprietà funzionali.",
      "examples": [
        "La struttura ossea di un organismo è fondamentale per il suo movimento.",
        "Il nuovo edificio presenta una struttura moderna e resistente ai terremoti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Organizzazione interna di un testo, un discorso o un'opera d'arte, che ne definisce l'articolazione logica o compositiva e il modo in cui le sue parti sono connesse tra loro.",
      "examples": [
        "La struttura narrativa del romanzo è complessa ma affascinante.",
        "L'analisi della struttura grammaticale di una frase è essenziale per comprenderne il significato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Organizzazione sociale, politica o economica che regola il funzionamento e le relazioni all'interno di una comunità o di un'istituzione.",
      "examples": [
        "La struttura burocratica dello Stato può rallentare i processi decisionali.",
