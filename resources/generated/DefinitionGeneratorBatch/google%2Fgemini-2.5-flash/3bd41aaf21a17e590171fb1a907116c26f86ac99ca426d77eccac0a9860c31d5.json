  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Persona con cui si condivide un periodo della vita, un'esperienza o un'attività, stabilendo un legame basato sulla partecipazione e la vicinanza.",
      "examples": [
        "Ho incontrato il mio compagno di scuola dopo tanti anni e abbiamo ricordato i vecchi tempi.",
        "Durante il viaggio, ho trovato un compagno di avventura che mi ha aiutato a superare le difficoltà."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Nelle relazioni sentimentali, persona con cui si ha un vincolo affettivo stabile e coabitazione, senza necessariamente essere uniti in matrimonio.",
      "examples": [
        "Il mio compagno mi ha preparato una cena a lume di candela per il nostro anniversario.",
        "Vivono insieme da dieci anni e si considerano compagni a tutti gli effetti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Individuo che aderisce allo stesso partito politico, specialmente nell'ambito di movimenti o ideologie di sinistra, o che condivide principi ideologici similari.",
      "examples": [
        "I compagni di partito si sono riuniti per discutere le prossime elezioni regionali.",
        "È un vecchio compagno di lotte, abbiamo condiviso molte battaglie politiche."
      ],
      "nota": "L'uso di 'compagno' in questo senso è fortemente connotato e storicamente legato a specifici contesti politici e sociali."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si trova insieme a qualcos'altro per formare una coppia o un abbinamento.",
      "examples": [
        "Ho perso il calzino compagno e ora non posso usare questo paio.",
        "Il cassetto contiene la chiave compagna di questa serratura."
      ],
      "nota": null
    }
  ]
