  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non ha limiti nello spazio, nel tempo o nella quantità; illimitato, interminabile.",
      "examples": [
        "L'universo è uno spazio infinito di cui non conosciamo i confini.",
        "Provo per te un amore infinito.",
        "Il numero di decimali in pi greco è infinito e non ripetitivo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di grande o grandissima entità, senza possibilità di essere misurato o compreso nella sua totalità.",
      "examples": [
        "Ho un'infinita stima per il tuo lavoro.",
        "Ha mostrato una pazienza infinita nell'aiutarmi.",
        "La sua bontà è davvero infinita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il concetto di ciò che non ha fine o limite; entità illimitata o illimitatezza.",
      "examples": [
        "I filosofi si sono interrogati sull'infinito per secoli.",
        "Studiando l'universo, gli scienziati si confrontano con il mistero dell'infinito.",
        "Il limite è stato uno spunto per pensare all'infinito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "In grammatica, una delle forme indefiniti del verbo, che esprime l'azione in modo generico, senza indicare persona, numero o modo.",
      "examples": [
        "Nel 'Cantico delle Creature', San Francesco usa spesso l'infinito del verbo.",
        "L'infinito del verbo 'mangiare' è 'mangiare'.",
        "Costruire è l'infinito più adatto in questo caso."
      ],
      "nota": null
    }
  ]
