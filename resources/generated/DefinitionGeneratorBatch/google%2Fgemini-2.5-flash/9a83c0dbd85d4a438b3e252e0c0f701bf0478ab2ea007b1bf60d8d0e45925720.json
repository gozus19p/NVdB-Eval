  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere la proprietà o il possesso di un bene o servizio mediante il pagamento di una somma di denaro o altro mezzo di scambio.",
      "examples": [
        "Ho deciso di acquistare una nuova automobile per le mie esigenze di lavoro.",
        "Le aziende spesso competono per acquistare i diritti di trasmissione degli eventi sportivi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere qualcosa, come una qualità, un vantaggio o una condizione, attraverso un processo o uno sforzo.",
      "examples": [
        "Con il tempo e l'esperienza, si possono acquistare nuove abilità professionali.",
        "Il progetto ha iniziato ad acquistare importanza dopo i primi risultati positivi."
      ],
      "nota": "Riferito a concetti astratti, qualità, prestigio, forza, ecc."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a valori finanziari o prezzi, aumentare o salire.",
      "examples": [
        "Il valore delle azioni della compagnia ha iniziato ad acquistare dopo l'annuncio dei nuovi investimenti.",
        "Il prezzo dell'oro continua ad acquistare a causa dell'instabilità economica."
      ],
      "nota": null
    }
  ]
