  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "La percezione visiva di una particolare frequenza dello spettro elettromagnetico, o l'insieme delle frequenze che un oggetto riflette o emette.",
      "examples": [
        "Il rosso è il mio colore preferito.",
        "Le farfalle attirano i fiori con la vivacità dei loro colori."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La pigmentazione naturale della pelle, dei capelli o degli occhi di una persona o di un animale.",
      "examples": [
        "Ha un bel colore ambrato sulla pelle dopo le vacanze estive.",
        "I suoi occhi hanno un colore insolito, tra il verde e il blu."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un pigmento o una vernice usati per dipingere, tingere o alterare l'aspetto cromatico di un oggetto.",
      "examples": [
        "Ho comprato dei nuovi colori ad olio per i miei quadri.",
        "Prima di verniciare la macchina, bisogna scegliere il colore giusto."
      ],
      "nota": "Spesso usato al plurale per indicare l'insieme dei materiali pittorici."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "L'apparenza generale, l'atmosfera o il carattere distintivo di un luogo, di un evento o di un'opera d'arte.",
      "examples": [
        "La musica jazz aggiunge un colore particolare alla serata.",
        "Il racconto è arricchito da descrizioni che danno un forte colore locale."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Nelle carte da gioco, ciascuno dei quattro semi (cuori, quadri, fiori, picche) o, in altri giochi, la categoria specifica di carte che permette di superare altre di minor valore.",
      "examples": [
        "Ho giocato un due di picche, ma il mio avversario ha fatto colore e ha vinto la mano.",
        "Nel poker, avere un colore significa avere cinque carte dello stesso seme."
      ],
      "nota": "Nel gioco delle carte, a volte indica specificamente l'ottenimento di una combinazione vincente."
    }
  ]
