  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Fare riferimento a parole o testi altrui, riproducendoli o menzionandoli esplicitamente per sostenere un'affermazione o approfondire un argomento.",
      "examples": [
        "L'avvocato ha citato diverse sentenze precedenti a supporto della sua tesi.",
        "Nel suo discorso, il professore ha citato un famoso verso di Dante."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Menzionare o nominare qualcuno o qualcosa in un determinato contesto, spesso in tono elogiativo o di ringraziamento.",
      "examples": [
        "Vorrei citare i miei collaboratori per l'ottimo lavoro svolto.",
        "Il cantante ha citato i suoi fan come ispirazione per il nuovo album."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Convocare legalmente una persona a comparire davanti a un'autorità giudiziaria o amministrativa.",
      "examples": [
        "Il testimone è stato citato in tribunale per deporre sul caso.",
        "L'azienda è stata citata in giudizio per violazione di contratto."
      ],
      "nota": null
    }
  ]
