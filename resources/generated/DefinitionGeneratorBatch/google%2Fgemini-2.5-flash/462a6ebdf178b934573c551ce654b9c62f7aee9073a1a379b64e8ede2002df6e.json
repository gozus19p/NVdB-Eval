  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Provare una sensazione di paura o ansia per qualcosa che potrebbe accadere o per qualcuno, percepito come una minaccia.",
      "examples": [
        "Temo che il meteo possa peggiorare in serata.",
        "Molti cittadini temono per la propria sicurezza dopo gli ultimi eventi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rispettare profondamente o avere un senso di reverenza verso qualcuno o qualcosa, ammirandone la forza o l'autorità.",
      "examples": [
        "Temo il giudizio dei miei superiori, ma cerco sempre di dare il massimo.",
        "Il re era temuto e rispettato da tutto il suo popolo per la sua saggezza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Supporre o sospettare con una certa apprensione che qualcosa sia vero o stia per accadere, spesso con una connotazione negativa.",
      "examples": [
        "Temo di aver commesso un errore nella compilazione del modulo.",
        "Il medico temeva una possibile complicazione dopo l'intervento chirurgico."
      ],
      "nota": null
    }
