  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Ognuna delle formazioni dure e biancastre presenti nella bocca degli esseri umani e di molti animali, impiegate per masticare il cibo e, in alcuni casi, per la difesa o l'attacco.",
      "examples": [
        "Il bambino ha perso il suo primo dente da latte.",
        "Il leone mostrava i suoi denti affilati prima di ruggire."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sporgenza o punta rigida e sporgente che fa parte di un oggetto o meccanismo e ne caratterizza la forma o la funzione.",
      "examples": [
        "I denti della forchetta sono di acciaio inossidabile.",
        "Ha rotto un dente nel pettine mentre si spazzolava i capelli."
      ],
      "nota": "Fa riferimento a oggetti la cui forma ricorda quella di un dente."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Desiderio o impulso intenso, spesso associato a un sentimento di forte invidia o rancore represso nei confronti di qualcuno o qualcosa.",
      "examples": [
        "Nonostante il successo dell'amico, teneva il suo dente ben nascosto.",
        "Ho ancora il dente avvelenato per quella vecchia discussione."
      ],
      "nota": "Usato in espressioni idiomatiche come 'avere il dente avvelenato' o 'tenere un dente'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte appuntita e robusta delle montagne che si protende verso l'alto, solitamente rocciosa e isolata, che spicca sul profilo del paesaggio.",
      "examples": [
        "Abbiamo scalato i ripidi denti della montagna.",
        "All'orizzonte si stagliavano i denti aguzzi delle Dolomiti."
      ],
      "nota": "Uso metaforico nel contesto geografico o alpinistico."
    }
  ]
