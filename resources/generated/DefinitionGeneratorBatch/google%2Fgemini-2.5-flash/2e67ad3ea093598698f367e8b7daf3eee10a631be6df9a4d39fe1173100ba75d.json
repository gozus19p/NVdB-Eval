  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non è uguale o simile, che presenta caratteristiche differenti rispetto a qualcos'altro o a qualcun altro.",
      "examples": [
        "Abbiamo gusti molto diversi in fatto di musica.",
        "Le opinioni sul progetto erano così diverse che non si è raggiunto un accordo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Molteplice, vario, costituito da elementi non omogenei.",
      "examples": [
        "La mostra espone opere d'arte di diverso genere e periodo storico.",
        "Ha dovuto affrontare problemi diversi per portare a termine il lavoro."
      ],
      "nota": "Si usa spesso per indicare varietà o pluralità."
    },
    {
      "pos": "pronome indefinito",
      "definition": "Un certo numero, alcune entità o persone non specificate.",
      "examples": [
        "Diversi hanno espresso il loro disaccordo durante l'assemblea.",
        "Ho letto diversi libri sull'argomento, ma nessuno mi ha convinto del tutto."
      ],
      "nota": "Utilizzato in funzione pronominale per indicare 'molti', 'alcuni'."
    }
  ]
