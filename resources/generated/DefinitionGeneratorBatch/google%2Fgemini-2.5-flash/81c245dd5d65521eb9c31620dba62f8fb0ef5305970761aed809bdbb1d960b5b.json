  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Assenza totale o parziale di luce in un ambiente o un luogo, che rende difficile o impossibile la percezione visiva.",
      "examples": [
        "Temo il buio della notte quando sono da solo.",
        "La stanza era immersa nel buio più completo dopo il blackout."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Stato di ignoranza, incertezza o mancanza di comprensione rispetto a una situazione, un concetto o un evento.",
      "examples": [
        "La sua mente era avvolta nel buio riguardo alla soluzione del problema.",
        "Prima dell'indagine, c'era un completo buio su chi fosse il colpevole."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato dalla mancanza di luce, scuro o poco illuminato.",
      "examples": [
        "Entrarono in un corridoio buio e umido.",
        "Il cielo era buio e minacciava pioggia a dirotto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a qualcosa di sconosciuto, misterioso o che suscita incertezza e timore.",
      "examples": [
        "Il futuro appare ancora buio per molte famiglie.",
        "Ci sono aspetti bui nella sua storia che preferisce non rivelare."
      ],
      "nota": "Uso figurato."
    }
