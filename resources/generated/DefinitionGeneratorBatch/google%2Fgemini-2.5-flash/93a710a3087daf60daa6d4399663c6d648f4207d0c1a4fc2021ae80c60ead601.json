  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Unione di più persone o enti per un fine comune, spesso di natura ricreativa, culturale, sociale o politica.",
      "examples": [
        "L'associazione di volontariato ha organizzato una raccolta fondi per i bisognosi del quartiere.",
        "Ha fondato un'associazione culturale per promuovere la lettura tra i giovani."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Atto del collegare mentalmente due o più idee, concetti o immagini in base a un rapporto di somiglianza, contiguità o causalità.",
      "examples": [
        "La sua mente faceva continue associazioni tra il presente e il passato.",
        "Il terapeuta cerca di capire le associazioni libere del paziente per interpretare i suoi pensieri."
      ],
      "nota": "Si riferisce al processo cognitivo di stabilire connessioni."
    },
    {
      "pos": "sostantivo f.",
      "definition": "L'atto o il processo di unire o mettere insieme elementi diversi per formare un insieme organico o un raggruppamento.",
      "examples": [
        "L'associazione dei colori nel dipinto crea un effetto armonioso.",
        "La corretta associazione dei farmaci è fondamentale per l'efficacia della terapia."
      ],
      "nota": "Può riferirsi sia a elementi astratti che concreti."
    }
  ]
