  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Determinare il numero o la quantità di elementi di un insieme, spesso enumerandoli uno dopo l'altro.",
      "examples": [
        "Ho chiesto al bambino di contare le pecore per addormentarsi.",
        "Bisogna contare attentamente i soldi prima di pagare il conto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Includere qualcosa o qualcuno in un calcolo o in un gruppo.",
      "examples": [
        "Se contiamo anche te, siamo in cinque a cena.",
        "Non ho contato le spese di viaggio nel budget finale."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere importanza, essere rilevante o significativo.",
      "examples": [
        "Le sue parole contano molto per me, mi fido del suo giudizio.",
        "In questa situazione, ogni minimo dettaglio conta."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Fare affidamento su qualcuno o qualcosa, riporre fiducia.",
      "examples": [
        "Puoi contare sul mio aiuto se ne avrai bisogno.",
        "Contiamo molto sulla tua partecipazione all'evento."
      ],
      "nota": "Spesso accompagnato dalla preposizione 'su'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un determinato valore o punteggio in un gioco o in un contesto competitivo.",
      "examples": [
        "Nel bridge, l'asso conta undici punti.",
        "Ogni gol conta per la classifica finale del campionato."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Raccontare o narrare qualcosa, esporre una vicenda o un fatto.",
      "examples": [
        "Il nonno amava contare storie ai nipoti prima di dormire.",
        "Mi ha contato ogni singolo dettaglio della sua giornata."
      ],
      "nota": "Uso meno comune rispetto ad 'enumerare' o 'narrare', ma ancora attestato."
    }
  ]
