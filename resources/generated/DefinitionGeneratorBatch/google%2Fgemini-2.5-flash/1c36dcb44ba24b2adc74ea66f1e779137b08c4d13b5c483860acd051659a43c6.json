  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo o proveniente dall'America, intesa come continente o come gli Stati Uniti d'America.",
      "examples": [
        "Il continente americano è vasto e diversificato.",
        "Ha acquistato un'auto sportiva di fabbricazione americana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Abitante o nativo dell'America, o specificamente degli Stati Uniti d'America.",
      "examples": [
        "Molti americani hanno origini europee.",
        "L'americano medio spesso viaggia per piacere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Tipo di caffè lungo, ottenuto aggiungendo acqua calda all'espresso, per stemperarne il sapore intenso.",
      "examples": [
        "Per favore, un caffè americano e una brioche.",
        "A colazione preferisco sempre un americano piuttosto che un espresso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Tipo di cocktail a base di vermut rosso, Campari e soda, guarnito con una fetta d'arancia.",
      "examples": [
        "Ha ordinato un americano come aperitivo.",
        "Il barista ha preparato un ottimo americano equilibrato."
      ],
      "nota": null
    }
  ]
