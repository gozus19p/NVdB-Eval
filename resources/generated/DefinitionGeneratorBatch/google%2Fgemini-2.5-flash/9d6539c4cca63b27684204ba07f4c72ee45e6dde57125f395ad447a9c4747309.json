    {
      "pos": "verbo transitivo",
      "definition": "Dare impulso o vivacità a un evento o a una situazione, rendendola più interessante o attiva.",
      "examples": [
        "Un buon presentatore sa come animare la serata, coinvolgendo il pubblico.",
        "La discussione è stata animata da interventi appassionati e talvolta provocatori."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Stimolare o spingere qualcuno ad agire o a provare un determinato sentimento.",
      "examples": [
        "La speranza animava i soldati, spingendoli a combattere con coraggio.",
        "È stata animata da un desiderio irrefrenabile di scoprire la verità."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Mostrare vivacità o esaltazione in reazione a qualcosa, spesso nell'espressione del viso o nel comportamento.",
      "examples": [
        "Alla notizia del suo arrivo, si è animato di gioia.",
        "Il suo volto si animava ogni volta che parlava della sua passione."
      ],
      "nota": null
