  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Persona di sesso femminile che ha il medesimo padre e la medesima madre di un'altra persona, o almeno uno dei due genitori in comune.",
      "examples": [
        "Mia sorella maggiore si è trasferita all'estero per lavoro.",
        "Ha tre sorelle, tutte più giovani di lei."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Donna, genericamente o con riferimento affettuoso, con cui si condivide un legame di solidarietà, amicizia profonda o appartenenza a un medesimo gruppo (religioso, sociale, ecc.).",
      "examples": [
        "Le suore di questo convento sono chiamate tra loro 'sorelle'.",
        "Le donne presenti alla manifestazione si sono unite gridando 'sorella, conta su di noi!'."
      ],
      "nota": "Spesso usato in contesti di fratellanza religiosa, politica o di movimento sociale."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Ciascuna delle due macchine rotanti che in alcune professioni operano in coppia per svolgere un'unica funzione.",
      "examples": [
        "Le due gru, note come 'sorelle', lavoravano in perfetta sincronia per sollevare il carico.",
        "Il meccanico ha dovuto sostituire una delle due 'sorelle' della fresatrice."
      ],
      "nota": "Uso specialistico e colloquiale in alcuni settori lavorativi."
    }
  ]
