  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "L'insieme delle opere scritte, orali o audiovisive di carattere creativo e artistico, riconosciute e studiate per il loro valore estetico e intellettuale, o che riflettono la cultura e la storia di un popolo o di un'epoca.",
      "examples": [
        "La letteratura italiana vanta capolavori di fama mondiale.",
        "Ha dedicato la sua vita allo studio della letteratura medievale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "L'attività o la produzione di testi a scopi creativi, espressivi o informativi, spesso considerata come una professione o una vocazione.",
      "examples": [
        "Si dedica alla letteratura nel tempo libero, scrivendo racconti e poesie.",
        "Ha deciso di abbandonare la carriera accademica per dedicarsi completamente alla letteratura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "L'insieme delle pubblicazioni e dei testi prodotti su un determinato argomento o campo del sapere, con finalità informative, scientifiche o tecniche.",
      "examples": [
        "Ho consultato la letteratura scientifica più recente sull'intelligenza artificiale.",
        "La letteratura medica su questa patologia è vasta e in continuo aggiornamento."
      ],
      "nota": "Si riferisce a documenti specialistici e non a opere artistiche."
    }
  ]
