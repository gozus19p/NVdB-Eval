  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Il capo supremo della Chiesa cattolica, considerato successore di San Pietro e vicario di Cristo in terra.",
      "examples": [
        "Il papa ha impartito la benedizione Urbi et Orbi dalla loggia di San Pietro.",
        "Molti fedeli si sono radunati per assistere all'udienza del papa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un ecclesiastico di alto rango o dignitario religioso in alcune Chiese cristiane orientali, equivalente a un prete o a un vescovo.",
      "examples": [
        "Nella Chiesa ortodossa, un 'papa' può indicare un sacerdote o un vescovo.",
        "Il papa copto è il capo della Chiesa copta ortodossa di Alessandria."
      ],
      "nota": "Questo uso è meno comune nell'italiano contemporaneo in contesti non specialistici, ma è attestato."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che, per la sua autorità, competenza o influenza, è considerata una figura dominante o indiscussa in un determinato ambito o settore.",
      "examples": [
        "È il papa della moda, ogni sua collezione detta le tendenze.",
        "Quel professore è riconosciuto come il papa della filologia classica."
      ],
      "nota": "Uso figurato."
    }
  ]
