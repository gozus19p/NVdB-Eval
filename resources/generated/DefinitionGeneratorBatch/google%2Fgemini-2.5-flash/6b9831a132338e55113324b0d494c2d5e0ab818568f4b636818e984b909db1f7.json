  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi velocemente da un luogo o da una situazione, spesso per sottrarsi a un pericolo, una cattura o un impegno sgradito.",
      "examples": [
        "Il ladro è scappato dalla finestra prima dell'arrivo della polizia.",
        "Vorrei scappare da questa routine e viaggiare un po'."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Sfuggire al controllo o alla sorveglianza di qualcuno; essere perso o non più raggiungibile.",
      "examples": [
        "Mi è scappato il telefono di mano ed è caduto in terra.",
        "Non puoi lasciare che ti scappi questa occasione irripetibile."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere pronunciato o detto in modo involontario, senza l'intenzione di farlo.",
      "examples": [
        "Mi è scappata una parolaccia, scusa.",
        "Le è scappato un sorriso in un momento poco opportuno."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Verificarsi o accadere inaspettatamente, specialmente in relazione a funzioni fisiologiche.",
      "examples": [
        "Non è riuscito a trattenersi e gli è scappata una risata contagiosa.",
        "Al bambino sono scappati alcuni bisogni prima di arrivare in bagno."
      ],
      "nota": "Spesso usato in espressioni colloquiali con valore eufemistico."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un esito negativo o non riuscire in un'impresa, fallire.",
      "examples": [
        "Il piano è scappato, dovremo trovare un'altra soluzione.",
        "Dopo tanti sforzi, il progetto è purtroppo scappato."
      ],
      "nota": "Uso meno comune, tipico di contesti colloquiali o regionali e spesso con l'ausiliare 'essere'."
    }
  ]
