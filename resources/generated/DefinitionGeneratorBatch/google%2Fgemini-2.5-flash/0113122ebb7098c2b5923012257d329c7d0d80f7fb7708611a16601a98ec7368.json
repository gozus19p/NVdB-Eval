  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Sottrarre un bene a qualcuno con inganno, astuzia o destrezza, spesso in modo illecito.",
      "examples": [
        "Mi hanno fregato il portafoglio mentre ero distratto.",
        "Ha fregato l'esame copiando dal compagno."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ingannare una persona, approfittandosi della sua buona fede o ingenuità.",
      "examples": [
        "Quel venditore cerca sempre di fregare i clienti con merce scadente.",
        "Non ti far fregare dalle apparenze."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Non importare nulla, essere indifferente a qualcosa o qualcuno.",
      "examples": [
        "A me non frega nulla di quello che pensano gli altri.",
        "Del suo giudizio, onestamente, non me ne può fregare di meno."
      ],
      "nota": "Ha un registro colloquiale e può avere una connotazione volgare."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Strofinare energicamente una superficie con una certa pressione.",
      "examples": [
        "Ho dovuto fregare bene la pentola per togliere il bruciato.",
        "La nonna fregava il pavimento con la cera fino a farlo brillare."
      ],
      "nota": "Questo senso è meno comune nell'italiano contemporaneo rispetto agli altri, ma ancora attestato."
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Danneggiarsi o rompersi in modo irrimediabile, oppure essere irrimediabilmente compromesso o perduto.",
      "examples": [
        "Se non mi sbrigo, si frega la macchina per il troppo caldo.",
        "Il nostro progetto si è fregato a causa di un ritardo nei finanziamenti."
      ],
      "nota": "Ha un registro colloquiale."
    }
  ]
