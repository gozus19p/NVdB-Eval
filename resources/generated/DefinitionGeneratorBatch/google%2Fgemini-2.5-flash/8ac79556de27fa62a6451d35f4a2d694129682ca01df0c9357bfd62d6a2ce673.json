  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "La capacità intrinseca di un individuo di prendere decisioni, scegliere o agire in piena autonomia e coscienza.",
      "examples": [
        "Ho agito di mia spontanea volontà, nessuno mi ha forzato.",
        "La sua ferrea volontà gli ha permesso di superare ogni ostacolo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il desiderio o l'intenzione specifica di realizzare o ottenere qualcosa.",
      "examples": [
        "Ho espresso la mia volontà di partecipare all'evento.",
        "Il testamento rifletteva le ultime volontà del defunto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La determinazione o la risolutezza nel perseguire un obiettivo, superando difficoltà o ostacoli.",
      "examples": [
        "Ci vuole molta volontà per imparare una nuova lingua da zero.",
        "Ha dimostrato una grande volontà nel portare a termine il progetto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il potere decisionale o l'autorità di imporre le proprie scelte a qualcuno o su qualcosa.",
      "examples": [
        "La volontà popolare si è espressa chiaramente durante le elezioni.",
        "Era una persona con una forte volontà e non accettava compromessi."
      ],
      "nota": "Spesso in contesti che implicano un'azione di governo o di direzione."
    }
  ]
