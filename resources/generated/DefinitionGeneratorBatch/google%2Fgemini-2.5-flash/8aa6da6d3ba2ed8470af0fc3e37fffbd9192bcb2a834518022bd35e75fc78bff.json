  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non contiene nulla al suo interno o non è occupato da persone o oggetti.",
      "examples": [
        "Ho trovato il frigorifero vuoto.",
        "La casa è rimasta vuota da quando i vicini si sono trasferiti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Pieno di noia, privo di significato o di contenuto interessante; che provoca un senso di aridità interiore.",
      "examples": [
        "Ho passato una giornata vuota a casa senza fare nulla di produttivo.",
        "Le sue promesse si sono rivelate parole vuote, senza alcun seguito pratico."
      ],
      "nota": "Riferito spesso a concetti astratti come parole, promesse, vita, ecc."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Spazio privo di materia o di oggetti che lo riempiano.",
      "examples": [
        "Ho sentito un senso di vuoto dopo la sua partenza.",
        "È caduto nel vuoto, ma per fortuna si è salvato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Mancanza o assenza di qualcosa di essenziale o desiderato, che genera un senso di privazione o incompletezza.",
      "examples": [
        "Provo un vuoto incolmabile nel cuore da quando ho perso il mio amico.",
        "C'è un vuoto legislativo su questa materia che andrebbe colmato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un'assenza temporanea di attività o di ciò che ci si aspetterebbe, specialmente in contesti professionali o commerciali.",
      "examples": [
        "Abbiamo registrato un vuoto di ordini nell'ultimo trimestre.",
        "Dopo il successo iniziale, c'è stato un vuoto di pubblico per la nuova pièce teatrale."
      ],
      "nota": null
    }
  ]
