  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Il fratello del proprio padre o della propria madre, o il marito della propria zia.",
      "examples": [
        "Mio zio materno mi ha insegnato a giocare a scacchi fin da bambino.",
        "Ogni estate trascorro le vacanze nella casa al mare di mio zio e mia zia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Termine informale e affettuoso usato per rivolgersi a un uomo anziano o a una persona di età considerevolmente maggiore, non necessariamente imparentata, a cui si porta rispetto o affetto, o in segno di familiarità.",
      "examples": [
        "Ciao zio, come stai? È tanto che non ci vediamo!",
        "Il mio vicino di casa è un vecchio zio simpatico che racconta sempre barzellette."
      ],
      "nota": "Questo uso è colloquiale e può variare regionalmente."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Al plurale, 'gli zii' si riferisce ai fratelli dei genitori a prescindere dal sesso, o alla coppia formata dallo zio e dalla zia.",
      "examples": [
        "Durante le festività natalizie andiamo sempre a trovare tutti i nostri zii e i cugini.",
        "Gli zii di Marco gli hanno regalato una bicicletta nuova per il suo compleanno."
      ],
      "nota": null
    }
  ]
