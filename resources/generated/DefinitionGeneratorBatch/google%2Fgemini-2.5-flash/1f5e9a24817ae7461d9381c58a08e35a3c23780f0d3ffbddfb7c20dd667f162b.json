  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Striscia sottile e allungata di materiale flessibile, utilizzata per legare, decorare, misurare o come supporto per la registrazione di dati.",
      "examples": [
        "Ha legato il pacco con un nastro rosso vivace.",
        "Il nastro isolante è fondamentale per piccoli lavoretti elettrici in casa.",
        "Il nastro magnetico delle vecchie audiocassette si rovinava facilmente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Percorso lungo e stretto, che si estende in una particolare direzione, spesso con andamento sinuoso.",
      "examples": [
        "La strada serpeggiava come un nastro bianco tra le colline verdi.",
        "Il nastro d'asfalto sembrava non finire mai durante il viaggio notturno."
      ],
      "nota": "Uso figurato per indicare una strada o un percorso."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Linea di demarcazione, solitamente di stoffa colorata, che simboleggia l'arrivo o la fine di una gara, specialmente nelle competizioni di corsa.",
      "examples": [
        "Il maratoneta ha tagliato il nastro dopo oltre due ore di corsa.",
        "Molti atleti sognano di tagliare per primi il nastro alle Olimpiadi."
      ],
      "nota": null
    }
