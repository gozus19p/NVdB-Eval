  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Alimento ottenuto dalla cottura di un impasto a base di farina di cereali (principalmente frumento), acqua, lievito e sale, fondamentale in molte culture.",
      "examples": [
        "Ogni mattina compro del pane fresco dal fornaio.",
        "A cena abbiamo mangiato un buon pane casareccio con salumi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il nutrimento necessario per la sopravvivenza o, in senso più ampio, tutto ciò che è indispensabile per vivere.",
      "examples": [
        "Ha lavorato duramente per portare il pane a casa.",
        "In tempo di crisi, il pane quotidiano è diventato un lusso per molti."
      ],
      "nota": "Questo senso è spesso metaforico ed è legato al concetto di sostentamento."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un pezzo, generalmente compatto e di forma regolare, di una sostanza commestibile tagliato o porzionato.",
      "examples": [
        "Ho comprato un pane di burro al supermercato.",
        "Le mamme portano in tavola il pane di carne."
      ],
      "nota": "Si riferisce a una forma solida e porzionabile di alimenti diversi dal pane tradizionale."
    }
  ]
