  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Gruppo di persone unite da profondi legami di parentela, convivenza e, frequentemente, da vincoli matrimoniali o affettivi, che condividono una dimora e spesso anche risorse economiche e responsabilità reciproche.",
      "examples": [
        "Ho passato le vacanze estive con tutta la mia famiglia a casa dei nonni.",
        "Il pranzo della domenica era un momento importante per riunire tutta la famiglia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso più ampio, l'insieme di persone discendenti da un antenato comune o che portano lo stesso cognome, a prescindere dalla convivenza o dal legame immediato.",
      "examples": [
        "È stato difficile ricostruire l'albero genealogico della mia famiglia fino al XVII secolo.",
        "La famiglia Rossi è una delle più antiche e rispettate di questo paese."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In biologia, categoria tassonomica che raggruppa generi con caratteristiche comuni significative.",
      "examples": [
        "Il lupo appartiene alla famiglia dei Canidi, mentre il gatto a quella dei Felidi.",
        "Le ricerche genetiche hanno permesso di ridefinire alcune relazioni tra le famiglie di piante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Un insieme di oggetti, elementi, strumenti o concetti che condividono proprietà, origini o funzioni simili, formando un gruppo omogeneo.",
      "examples": [
        "Questo set di attrezzi appartiene alla famiglia degli strumenti a percussione.",
        "In linguistica, le lingue romanze costituiscono una famiglia derivata dal latino."
      ],
      "nota": "Spesso usato in contesti tecnici o classificatori per indicare gruppi di elementi affini."
    }
  ]
