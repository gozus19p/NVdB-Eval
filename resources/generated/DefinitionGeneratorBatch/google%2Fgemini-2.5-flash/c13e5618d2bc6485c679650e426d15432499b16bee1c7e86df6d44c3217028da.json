  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Singola unità di un genere o di una specie, considerata come entità distinta e autonoma.",
      "examples": [
        "Ogni individuo ha il diritto di esprimere la propria opinione.",
        "La ricerca ha studiato il comportamento di cento individui appartenenti a diverse fasce d'età."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona, genericamente considerata, talvolta con una connotazione negativa o dispregiativa, indicando una persona di scarso valore o di condotta discutibile.",
      "examples": [
        "C'era un individuo sospetto che si aggirava intorno alla mia auto.",
        "Non voglio avere niente a che fare con quell'individuo, è una persona inaffidabile."
      ],
      "nota": "L'uso in questo senso può variare da neutro a fortemente negativo a seconda del contesto e dell'intonazione."
    },
    {
      "pos": "aggettivo",
      "definition": "Non divisibile o non separabile in parti più piccole; che mantiene la sua unità.",
      "examples": [
        "La società è un corpo unitario e individuo, non un insieme di parti sconnesse.",
        "La materia è composta da particelle elementari indivisibili, ovvero individuali nel loro genere."
      ],
      "nota": "Raro nell'uso contemporaneo come aggettivo, spesso sostituito da 'indivisibile'."
    }
  ]
