  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Territorio su cui un monarca esercita il proprio potere di governo, spesso ereditario, o una nazione governata da un re o una regina.",
      "examples": [
        "Il principe ereditario tornerà presto nel regno per prendere il suo posto.",
        "Molti antichi regni sono ormai diventati repubbliche democratiche."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Periodo di tempo durante il quale una persona governa o detiene una posizione di potere o influenza predominante.",
      "examples": [
        "Il regno di quel sovrano fu caratterizzato da pace e prosperità.",
        "Durante il suo regno alla guida dell'azienda, le vendite sono triplicate."
      ],
      "nota": "Si riferisce sia a un monarca che a chiunque abbia un ruolo di leadership o predominio."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Ambito o sfera d'azione in cui qualcosa o qualcuno esercita un dominio, un controllo o un'influenza assoluta, o dove una determinata caratteristica è prevalente.",
      "examples": [
        "Il regno animale comprende una vasta diversità di specie viventi.",
        "Per i bambini, il giardino è un vero regno di avventura e scoperta.",
        "Quel professore è un lumetto nel regno della matematica superiore."
      ],
      "nota": "Spesso usato in espressioni come 'regno animale', 'regno vegetale', 'regno minerale' per indicare grandi categorizzazioni naturali, o in senso figurato per un'area di competenza o influenza."
    }
  ]
