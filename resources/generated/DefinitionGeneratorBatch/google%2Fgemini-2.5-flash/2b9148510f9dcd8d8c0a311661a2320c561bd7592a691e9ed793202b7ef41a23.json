  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Unità di misura del tempo corrispondente alla ventiquattresima parte di un giorno solare medio, composta da sessanta minuti.",
      "examples": [
        "Ci vediamo tra un'ora al solito bar.",
        "Il treno parte fra mezz'ora."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Momento specifico della giornata o particolare frangente temporale.",
      "examples": [
        "Che ora è?",
        "È un'ora propizia per iniziare il progetto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Periodo, di solito di breve durata, dedicato a una specifica attività o che coincide con particolari circostanze.",
      "examples": [
        "Le ore di lezione sono volate via velocemente.",
        "Ha dedicato le sue ore migliori allo studio."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In questo momento, al presente.",
      "examples": [
        "Ora devo andare, sono in ritardo.",
        "Che cosa fai ora?"
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "Subito, senza indugi, in un futuro immediato.",
      "examples": [
        "Ora arrivo, dammi un secondo.",
        "Vado a pranzare ora, poi ti richiamo."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In quel momento specifico, in riferimento a un tempo passato o futuro.",
      "examples": [
        "Ti ricordi quando eravamo piccoli? Ora la vedo come un'altra vita.",
        "Se in quel momento avessimo avuto più coraggio, ora tutto sarebbe diverso."
      ],
      "nota": "Spesso usato per introdurre un contrasto o una conseguenza rispetto a un evento o a una situazione precedente."
    },
    {
      "pos": "congiunzione coordinante",
      "definition": "Usato per indicare un'alternativa o un'opposizione, spesso in correlazione con un altro 'ora'.",
      "examples": [
        "Ora ride, ora piange, non si capisce mai cosa voglia.",
        "Ora piove, ora c'è il sole: il tempo è instabile."
      ],
      "nota": "Generalmente ricorre nella forma 'ora... ora...'"
    }
  ]
