  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Estremità degli arti superiori dell'uomo, dotata di cinque dita opponibili, utilizzata per afferrare, toccare e compiere varie azioni.",
      "examples": [
        "Ho bisogno della tua mano per sollevare questo peso.",
        "Ha stretto la sua mano in segno di saluto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il controllo, l'autorità o l'influenza esercitati da qualcuno su una situazione o su altre persone.",
      "examples": [
        "La situazione è sfuggita di mano alle autorità competenti.",
        "Ha dato una mano preziosa all'organizzazione dell'evento."
      ],
      "nota": "Spesso in espressioni idiomatiche come 'fuori mano', 'dare una mano'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di carte da gioco distribuite a un giocatore in una singola partita o fase di gioco.",
      "examples": [
        "Con questa mano non credo di poter vincere.",
        "Ha avuto una mano fortunata a poker."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La zona o il lato destro o sinistro di una persona o di un oggetto, o una direzione relativa a essa.",
      "examples": [
        "Tieni la destra sulla mano di guida.",
        "A sinistra della strada c'è un bel panorama."
      ],
      "nota": "Usato principalmente in locuzioni avverbiali come 'a mano destra', 'a seconda mano'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il modo o la cura con cui qualcosa viene fatto o eseguito, o il lavoro stesso eseguito dall'uomo piuttosto che da una macchina.",
      "examples": [
        "Si vede la mano dell'artista in questo dipinto.",
        "Questo dolce è fatto a mano, senza l'uso di macchinari industriali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Una passata, una stesura o una singola applicazione di una sostanza su una superficie.",
      "examples": [
        "Ci vorrebbe un'altra mano di vernice per coprire le imperfezioni.",
        "Dopo la prima mano di stucco, la parete era pronta per la pittura."
      ],
      "nota": null
    }
  ]
