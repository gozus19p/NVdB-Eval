  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Il numero intero naturale che segue il sette e precede il nove, rappresentato dalla cifra 8.",
      "examples": [
        "L'otto è un numero pari.",
        "Il mio numero fortunato è l'otto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Indicazione oraria specifica corrispondente all'ottava ora del giorno o della notte.",
      "examples": [
        "Ci vediamo alle otto in punto davanti al cinema.",
        "Il treno parte alle otto e venti da Milano Centrale."
      ],
      "nota": "Spesso in correlazione con 'alle' o 'all'una, alle due, ecc.' per indicare l'ora."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un'imbarcazione a remi, tipicamente utilizzata nelle competizioni sportive, su cui trovano posto otto vogatori più un timoniere.",
      "examples": [
        "La squadra universitaria ha vinto la regata con l'otto.",
        "L'allenatore sta scegliendo gli equipaggi per l'otto olimpico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale cardinale",
      "definition": "Corrispondente a una quantità di otto unità o elementi.",
      "examples": [
