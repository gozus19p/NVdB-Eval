  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova o agisce all'interno di qualcosa o di qualcuno; che non è manifesto o visibile dall'esterno.",
      "examples": [
        "Le pareti interne dell'edificio sono state tinteggiate di recente.",
        "Ha confessato di vivere un conflitto interno da molto tempo.",
        "Il funzionamento interno del motore è piuttosto complesso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte più intima o nascosta di un luogo, di un oggetto o di una persona; l'ambiente domestico o privato.",
      "examples": [
        "L'interno della casa era arredato con gusto raffinato.",
        "Ha descritto il suo interno con grande onestà durante la terapia.",
        "Dall'esterno sembrava normale, ma l'interno era un disastro."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio sportivo, indica il calciatore che ricopre il ruolo di centrocampista o una posizione simile, spesso sulla fascia laterale.",
      "examples": [
        "L'interno sinistro ha segnato un gol spettacolare.",
        "Il coach ha schierato due interni a supporto dell'attaccante.",
        "Un buon interno deve avere visione di gioco e capacità di corsa."
      ],
      "nota": "Riferito specificamente al contesto calcistico o sportivo."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Un settore o dipartimento all'interno di un'organizzazione o di un'istituzione, in particolare quello che si occupa degli affari e della sicurezza nazionale.",
      "examples": [
        "Il Ministro dell'Interno ha annunciato nuove misure di sicurezza.",
        "Il colloquio si è tenuto presso gli uffici dell'Interno.",
        "Le decisioni dell'Interno influenzano la vita quotidiana dei cittadini."
      ],
      "nota": "Spesso usato in riferimento al Ministero degli Interni."
    }
  ]
}