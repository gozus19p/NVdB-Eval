  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si differenzia dalla norma, dall'ordinario; eccezionale, fuori dal comune per qualità, entità o importanza.",
      "examples": [
        "Ha compiuto un lavoro straordinario per portare a termine il progetto in tempo.",
        "Il panorama dalla cima della montagna era davvero straordinario, toglieva il fiato."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di carattere o dimensione insolita e non prevista, che va al di là della prassi corrente.",
      "examples": [
        "È stata convocata una riunione straordinaria per discutere dell'emergenza.",
        "Il governo ha approvato delle misure straordinarie per far fronte alla crisi economica."
      ],
      "nota": "Spesso in riferimento a eventi, provvedimenti o attività."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Lavoro o servizio svolto oltre il normale orario stabilito o oltre il compenso pattuito.",
      "examples": [
        "Ho dovuto fare un'ora di straordinario per finire il report.",
        "Questo mese mi pagheranno anche le ore di straordinario che ho accumulato."
      ],
      "nota": null
    }
  ]
