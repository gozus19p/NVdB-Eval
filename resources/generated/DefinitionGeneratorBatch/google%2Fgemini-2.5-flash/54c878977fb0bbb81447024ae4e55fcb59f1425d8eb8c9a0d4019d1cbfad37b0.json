  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Azione del colpire o del venire colpito; il rumore o l'effetto che ne deriva.",
      "examples": [
        "Ha ricevuto un colpo alla testa durante la caduta.",
        "Si è sentito un forte colpo alla porta e tutti si sono spaventati."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Azione improvvisa e spesso violenta o decisiva, nel tentativo di raggiungere un obiettivo o in relazione a cause naturali.",
      "examples": [
        "Il colpo di stato ha rovesciato il governo in poche ore.",
        "Un colpo di fortuna ha permesso alla squadra di vincere la partita."
      ],
      "nota": "Spesso in locuzioni come 'colpo di stato', 'colpo di fortuna', 'colpo di fulmine'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Manifestazione improvvisa e intensa di un fenomeno climatico o corporeo.",
      "examples": [
        "Ho preso un colpo di freddo uscendo senza cappotto.",
        "Un colpo di tosse lo ha interrotto mentre parlava."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Tentativo riuscito o fallito di commettere un furto o una rapina.",
      "examples": [
        "La banda ha pianificato il colpo per mesi prima di agire.",
        "Il colpo alla banca è fallito a causa dell'allarme."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Ogni singola detonazione di un'arma da fuoco.",
      "examples": [
        "Si sono sentiti tre colpi provenire dal bosco.",
        "Il cacciatore ha sparato un colpo a vuoto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sensazione improvvisa e intensa, spesso emotiva.",
      "examples": [
        "È stato un vero colpo al cuore sentire quella notizia.",
        "La sua partenza è stata un duro colpo per tutta la famiglia."
      ],
      "nota": "Utilizzato in senso figurato per descrivere un impatto emotivo."
    }
  ]
