  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "La parte della giornata che va dall'alba all'ora di pranzo, caratterizzata dal sorgere del sole e dall'inizio delle attività quotidiane.",
      "examples": [
        "Ogni mattino mi sveglio presto per fare colazione in pace.",
        "Il mattino seguente eravamo già in viaggio verso la costa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il periodo iniziale o la fase iniziale di un evento, un fenomeno o della vita di una persona.",
      "examples": [
        "Siamo solo al mattino della discussione, il peggio deve ancora arrivare.",
        "Il mattino della sua carriera era promettente, ma poi incontrò molte difficoltà."
      ],
      "nota": "Uso figurato per indicare l'inizio o la giovinezza."
    },
    {
      "pos": "avverbio",
      "definition": "Durante le prime ore della giornata.",
      "examples": [
        "Ho lavorato mattino e sera per finire il progetto in tempo.",
        "Ci siamo incontrati mattino, ma non abbiamo concluso nulla."
      ],
      "nota": "Spesso usato in combinazione con 'sera' per indicare un lasso di tempo continuato o ripetuto."
    }
  ]
