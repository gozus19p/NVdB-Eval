  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Locata in casa, la cucina è l'ambiente destinato alla preparazione del cibo e, spesso, anche al consumo dei pasti.",
      "examples": [
        "Ho comprato un nuovo tavolo per la cucina.",
        "La nostra cucina è piccola ma molto accogliente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "L'apparecchio che serve per cuocere i cibi, generalmente dotato di fornelli e forno.",
      "examples": [
        "Devo accendere la cucina per preparare la cena.",
        "Abbiamo sostituito la vecchia cucina con un modello più moderno a induzione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "L'insieme delle tecniche e delle tradizioni culinarie proprie di un luogo, di un popolo o il modo personale di cucinare di un individuo.",
      "examples": [
        "Adoro la cucina italiana, specialmente la pasta fresca.",
        "Mio nonno aveva una cucina ricca di sapori tradizionali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il reparto di un'attività commerciale o di una struttura ricettiva dove vengono preparati i pasti.",
      "examples": [
        "Lo chef è tornato in cucina per supervisionare i piatti.",
        "La cucina del ristorante è all'avanguardia con attrezzature moderne."
      ],
      "nota": null
    }
  ]
