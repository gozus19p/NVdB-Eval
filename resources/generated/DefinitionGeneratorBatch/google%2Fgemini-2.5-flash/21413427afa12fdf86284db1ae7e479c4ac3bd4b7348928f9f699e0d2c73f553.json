  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Corrispondere una somma di denaro o un bene equivalente in cambio di un oggetto, un servizio ricevuto o un debito contratto.",
      "examples": [
        "Ho dovuto pagare le bollette prima della scadenza.",
        "Quanto hai pagato per quel vestito nuovo?"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Subire le conseguenze, positive o negative, di un'azione o di un comportamento.",
      "examples": [
        "Alla fine, pagherà per tutti gli errori che ha commesso.",
        "Il suo duro lavoro ha pagato, ottenendo la promozione desiderata."
      ],
      "nota": "Questo senso è spesso usato in contesti di causa-effetto, implicando una retribuzione o una punizione."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere conveniente o vantaggioso, portare beneficio o profitto.",
      "examples": [
        "A volte investire tempo nello studio non paga immediatamente, ma a lungo termine sì.",
        "Un atteggiamento proattivo paga sempre nel mondo del lavoro."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Offrire e farsi carico delle spese per qualcosa che riguarda un'altra persona.",
      "examples": [
        "Questa sera pago io la cena per festeggiare la tua promozione.",
        "Le ha pagato il viaggio a Parigi come regalo di compleanno."
      ],
      "nota": null
    }
  ]
