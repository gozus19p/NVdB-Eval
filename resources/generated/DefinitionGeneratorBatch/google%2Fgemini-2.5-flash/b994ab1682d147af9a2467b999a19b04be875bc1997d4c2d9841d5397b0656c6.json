  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che compie atti di forza fisica o prevaricazione con l'intento di ledere, sottomettere o distruggere persone, animali o cose.",
      "examples": [
        "L'uomo è stato accusato di comportamento violento dopo aver aggredito l'arbitro.",
        "Il regime ha represso la dimostrazione con metodi violenti e brutali."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di fenomeno naturale o manifestazioni fisiche, che si manifesta con grande intensità o forza distruttiva.",
      "examples": [
        "Un violento temporale si è abbattuto sulla città, causando allagamenti e disagi.",
        "Hanno registrato uno scisma violento nell'attività sismica della zona."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di sentimento, emozione o reazione, che si presenta con un'intensità inusuale e travolgente.",
      "examples": [
        "Ha provato una violenta gelosia nel vedere l'ex fidanzata con un altro.",
        "Il film ha suscitato una violenta indignazione tra gli spettatori per le scene esplicite."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di colore, sapore o contrasto, che è eccessivamente intenso, stridente o sgradevole per impatto sul senso.",
      "examples": [
        "Il quadro presentava colori talmente violenti da disturbare la vista.",
        "Il sapore di quel formaggio è troppo violento per i miei gusti delicati."
      ],
      "nota": "Riferito a impressioni sensoriali, indica un'intensità che supera una soglia di piacevolezza o armonia."
    },
    {
      "pos": "aggettivo",
      "definition": "Di morte o fine, che avviene per cause esterne e traumatiche, non naturali.",
      "examples": [
        "Molti interrogativi circondano la violenta fine dell'imperatore.",
        "Il documentario ricostruiva la violenta dipartita del poeta."
      ],
      "nota": null
    }
  ]
