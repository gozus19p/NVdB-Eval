  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento testuale autonomo e organico, inserito in una pubblicazione periodica o in una raccolta, che tratta di un argomento specifico.",
      "examples": [
        "Ho letto un articolo molto interessante sulla sostenibilità ambientale.",
        "Il giornalista ha pubblicato un articolo di fondo sulla crisi economica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Ciascuno dei punti o delle clausole che compongono un testo legislativo, un contratto, un regolamento o un documento simile.",
      "examples": [
        "L'articolo 3 della Costituzione sancisce l'uguaglianza di tutti i cittadini.",
        "Dobbiamo rivedere l'articolo del contratto che riguarda le penali."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Nella grammatica italiana, parte variabile del discorso che precede un nome o un elemento nominalizzato, indicandone la determinazione o l'indeterminatezza e concordando con esso in genere e numero.",
      "examples": [
        "Gli articoli determinativi sono 'il', 'lo', 'la', 'i', 'gli', 'le'.",
        "Ha sbagliato l'accordo dell'articolo con il sostantivo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Oggetto fabbricato, bene di consumo o prodotto merceologico destinato alla vendita.",
      "examples": [
        "Il negozio offre una vasta gamma di articoli per la casa.",
        "Alcuni articoli di lusso sono esenti da tasse doganali."
      ],
      "nota": "Spesso usato al plurale, 'articoli', per indicare un assortimento di merci."
    }
  ]
