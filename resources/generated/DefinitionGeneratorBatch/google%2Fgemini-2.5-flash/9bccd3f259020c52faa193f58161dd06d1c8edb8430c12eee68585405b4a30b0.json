  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte di qualcosa o di un orientamento spaziale che si trova sul lato dove, in un essere umano, è posizionato il braccio più forte (generalmente il destro).",
      "examples": [
        "Sulla destra dell'edificio c'è un piccolo giardino.",
        "Il mio posto è sempre alla destra del guidatore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In politica, l'insieme dei partiti, movimenti o ideologie che tradizionalmente si richiamano a principi di conservazione sociale, gerarchia, nazionalismo o liberismo economico, in opposizione alla sinistra.",
      "examples": [
        "Le prossime elezioni potrebbero vedere un'affermazione della destra.",
        "I movimenti della destra radicale hanno guadagnato consensi in molti paesi europei."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si trova o è orientato verso la parte indicata, tipicamente contrapposta alla sinistra.",
      "examples": [
        "La mano destra è quella con cui scrivo.",
        "Il marciapiede destro era pieno di gente."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In direzione o sul lato di riferimento indicato, opposto a sinistra.",
      "examples": [
        "Gira a destra al prossimo semaforo.",
        "Il cassetto si trova sulla destra della scrivania."
      ],
      "nota": null
    }
  ]
