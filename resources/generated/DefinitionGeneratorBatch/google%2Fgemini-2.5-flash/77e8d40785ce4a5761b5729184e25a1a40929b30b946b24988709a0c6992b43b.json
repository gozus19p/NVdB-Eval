  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Insieme di particelle solide e gassose finissime, generalmente prodotto da una combustione, che si diffonde nell'aria in un denso addensamento visibile.",
      "examples": [
        "Dal camino usciva un denso fumo nero.",
        "L'odore di fumo si sentiva in tutta la casa dopo l'incendio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Atto di aspirare e espellere fumo dal tabacco combusto, tipicamente tramite sigarette, sigari o pipa.",
      "examples": [
        "Ho smesso completamente il fumo da due anni.",
        "Il fumo passivo è dannoso per la salute."
      ],
      "nota": "Si riferisce all'abitudine del fumare."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sostanza a base di hashish o marijuana, consumata per inalazione delle sue esalazioni.",
      "examples": [
        "È stato ritrovato in possesso di alcune dosi di fumo.",
        "Il commercio di fumo è illegale in molti paesi."
      ],
      "nota": "Uso colloquiale e gergale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Apparenza ingannevole, vana illusione o qualcosa di inconsistente e privo di fondamento.",
      "examples": [
        "Tutte le sue promesse si sono rivelate solo fumo.",
        "Non inseguire solo il fumo, cerca la sostanza nei rapporti."
      ],
      "nota": "Uso figurato."
    }
  ]
