  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Periodo di tempo che intercorre tra l'alba e il tramonto, caratterizzato dalla presenza della luce solare.",
      "examples": [
        "Durante il giorno, il sole splende alto nel cielo.",
        "Preferisco lavorare di notte e riposare durante il giorno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Intervallo di 24 ore che costituisce l'unità base del calendario, comprendente un periodo di luce e uno di oscurità.",
      "examples": [
        "Ci sono sette giorni in una settimana.",
        "Il mio compleanno è tra pochi giorni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Momento specifico o data precisa, spesso associata a un evento o una ricorrenza particolare.",
      "examples": [
        "Il giorno del matrimonio è stato indimenticabile.",
        "Quel giorno è cambiato tutto nella mia vita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Per estensione, periodo o epoca caratterizzato da determinate condizioni, tendenze o stili di vita.",
      "examples": [
        "Ai nostri giorni è difficile trovare un lavoro stabile.",
        "I giorni della giovinezza sono i più spensierati."
      ],
      "nota": "Spesso usato al plurale (i nostri giorni, i miei giovani giorni)."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La luce o la luminosità presente durante l'arco di tempo in cui il sole è sopra l'orizzonte.",
      "examples": [
        "In montagna il chiarore del giorno è più intenso.",
        "Si è fatto giorno, è ora di alzarsi."
      ],
      "nota": "Comunemente usato nell'espressione 'si è fatto giorno'."
    }
  ]
