  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Insieme delle cose o degli elementi presenti all'interno di qualcosa, sia in senso fisico che astratto.",
      "examples": [
        "Il contenuto della scatola era una sorpresa inaspettata.",
        "Il contenuto del libro offre una profonda riflessione sulla società moderna."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "L'argomento o la materia trattata in un'opera, in un discorso o in qualsiasi forma di comunicazione.",
      "examples": [
        "Il contenuto del dibattito si è focalizzato sulle questioni ambientali.",
        "I corsi online offrono materiali didattici ricchi di contenuti multimediali."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che denota moderazione o che è tenuto a freno, spesso riferito a espressioni, emozioni o comportamenti.",
      "examples": [
        "Ha mantenuto un tono contenuto nonostante la provocazione.",
        "La sua rabbia era appena contenuta, pronta a esplodere all'improvviso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di dimensioni limitate, che occupa uno spazio non eccessivo, o con costi e consumi ridotti.",
      "examples": [
        "L'appartamento è piccolo ma ben contenuto, ideale per una persona sola.",
        "Il progetto ha richiesto costi contenuti, rispettando il budget iniziale."
      ],
      "nota": null
    },
    {
      "pos": "verbo participio passato",
      "definition": "Che è stato albergato o raccolto in un certo spazio o volume.",
      "examples": [
        "L'acqua contenuta nella cisterna è sufficiente per tre giorni.",
        "Le informazioni contenute nel documento sono riservate."
      ],
      "nota": "Forma participio passato del verbo 'contenere', usata anche come aggettivo."
    }
  ]
