  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Il pianeta su cui viviamo, inteso come corpo celeste in cui si sviluppano la vita e le attività umane.",
      "examples": [
        "Gli astronauti hanno visto la Terra dallo spazio, un punto azzurro nel buio.",
        "Studiata da millenni, la Terra continua a rivelare i suoi segreti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La parte solida della superficie terrestre, in contrapposizione al mare o all'aria.",
      "examples": [
        "Dopo giorni di navigazione, i marinai avvistarono finalmente la terra.",
        "Il sole sorge dalla terra e tramonta nel mare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il suolo, lo strato più esterno della crosta terrestre, in particolare quello coltivabile o edificabile.",
      "examples": [
        "I contadini lavorano la terra ogni giorno per garantire il raccolto.",
        "Hanno acquistato un ampio appezzamento di terra per costruire una casa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Un territorio abitato, una regione, una nazione o il luogo di nascita o di origine di una persona.",
      "examples": [
        "Viaggiò in molte terre lontane prima di fare ritorno a casa.",
        "Per un espatriato, la terra natia rimane sempre nel cuore."
      ],
      "nota": "Spesso utilizzato in senso figurato per indicare la patria o il luogo di origine."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il materiale non roccioso e non sabbioso che costituisce gran parte del suolo, spesso impiegato per diversi scopi.",
      "examples": [
        "Un vaso pieno di terra è essenziale per la crescita delle piante.",
        "I bambini giocavano sporcandosi le mani con la terra del giardino."
      ],
      "nota": null
    }
  ]
