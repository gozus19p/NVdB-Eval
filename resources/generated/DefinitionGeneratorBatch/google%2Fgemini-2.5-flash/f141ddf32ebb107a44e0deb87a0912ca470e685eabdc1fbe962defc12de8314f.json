  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Detto di persona che mostra avvilimento, scoraggiamento o infelicità.",
      "examples": [
        "Dopo la brutta notizia, il ragazzo era completamente buttato sul divano.",
        "La vedo un po' buttata ultimamente, forse ha qualche problema."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a oggetto, mal riuscito o realizzato con poca cura.",
      "examples": [
        "Quel progetto è stato buttato via, non ne verrebbe nulla di buono.",
        "Aveva dei disegni buttati nel cassetto, neanche li guardava più."
      ],
      "nota": "Spesso usato nell'espressione 'lavoro buttato'."
    },
    {
      "pos": "verbo",
      "definition": "Forma del participio passato del verbo 'buttarsi', che indica il congiungersi di più elementi in una singola unità.",
      "examples": [
        "Si sono buttati tutti i pomodori nel sugo per fare la salsa.",
        "Le montagne si sono buttate a valle, formando la pianura."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Forma del participio passato del verbo 'buttare', che indica l'azione di lanciare o scagliare con forza qualcosa.",
