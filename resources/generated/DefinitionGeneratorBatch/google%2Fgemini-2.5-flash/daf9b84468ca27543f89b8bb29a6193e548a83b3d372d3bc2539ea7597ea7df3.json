  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di colore che richiama quello del sangue, del fuoco o dei petali di papavero, situato all'estremità dello spettro visibile verso le lunghezze d'onda maggiori.",
      "examples": [
        "Indossava un vestito rosso acceso che attirava l'attenzione.",
        "Le foglie autunnali assumono spesso una colorazione rossa molto vivida."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito al viso, che presenta un arrossamento temporaneo dovuto a calore, emozione, sforzo fisico o imbarazzo.",
      "examples": [
        "Dopo la corsa il suo volto era rosso e sudato.",
        "Diventò rosso per la vergogna quando capì l'errore commesso."
      ],
      "nota": "Spesso in correlazione con stati emotivi o condizioni fisiche passeggere."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il colore che richiama le caratteristiche del sangue, del fuoco o dei petali di papavero.",
      "examples": [
        "Il rosso è il mio colore preferito, mi mette allegria.",
        "Ha dipinto la parete di un rosso intenso, quasi bordeaux."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Segnale luminoso di arresto o divieto, come quello semaforico o di un'indicazione stradale.",
      "examples": [
        "Non puoi passare, il semaforo è rosso.",
        "Ha bruciato il rosso e ha causato un incidente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Vino prodotto con uve a bacca scura, da cui acquisisce la tipica colorazione.",
      "examples": [
        "Preferisco un buon rosso robusto per accompagnare la carne.",
        "Quella sera abbiamo bevuto un eccellente rosso toscano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Dato economico negativo o situazione finanziaria deficitaria.",
      "examples": [
        "Il bilancio dell'azienda chiude in rosso per il secondo anno consecutivo.",
        "Dopo le vacanze il conto bancario era nettamente in rosso."
      ],
      "nota": "Uso figurato, spesso in contesti economici o finanziari."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Simbolo di ideologie politiche di sinistra o rivoluzionarie, particolarmente quelle legate al comunismo.",
      "examples": [
        "Durante la manifestazione, sventolavano bandiere rosse.",
        "Il rosso fu un colore emblematico per molti movimenti operai."
      ],
      "nota": "Uso figurato e connotativo, legato alla simbologia politica."
    }
  ]
