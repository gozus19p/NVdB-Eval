  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento principale di cui si parla in una frase o in una discussione, o su cui si concentra un'indagine.",
      "examples": [
        "Il soggetto di questo libro è la storia della tecnologia moderna.",
        "Nella sua ricerca, ha studiato il soggetto della disoccupazione giovanile."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona o entità astratta che compie o subisce l'azione espressa dal verbo, o a cui si riferisce uno stato, specificato in una frase.",
      "examples": [
        "In 'Mario mangia una mela', 'Mario' è il soggetto della frase.",
        "Il pronome personale può fungere da soggetto implicito."
      ],
      "nota": "Riferimento specifico alla terminologia grammaticale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Determinata persona, con riferimento alle sue caratteristiche o al suo ruolo in un contesto specifico.",
      "examples": [
        "È un soggetto davvero interessante, pieno di talenti nascosti.",
        "Hanno individuato diversi soggetti sospetti nella zona."
      ],
      "nota": "Può avere una connotazione neutra o leggermente negativa/positiva a seconda del contesto."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Individuo vivente (animale o umano) utilizzato per studi o esperimenti.",
      "examples": [
        "I test sono stati condotti su un gruppo di soggetti volontari.",
        "Il laboratorio ha bisogno di nuovi soggetti per la ricerca genetica."
      ],
      "nota": "Utilizzato principalmente in contesti scientifici o medici."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a chi o ciò che è sottoposto, dipendente o esposto a qualcosa, spesso con una connotazione di vulnerabilità o necessità di obbedienza.",
      "examples": [
        "È una persona molto ansiosa, sempre soggetta a crisi di panico.",
        "Tutti i cittadini sono soggetti alle leggi dello Stato."
      ],
      "nota": null
    }
  ]
