  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Facoltà di pensare, comprendere e operare giudizi, tipica degli esseri umani.",
      "examples": [
        "L'uomo è un animale dotato di ragione.",
        "Ha perso la ragione per un momento di intensa paura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Motivo o causa che giustifica un'azione, un'opinione o una situazione.",
      "examples": [
        "Non c'è ragione per cui tu debba comportarti così.",
        "Mi ha dato buone ragioni per cambiare idea."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Fondamento logico o correttezza di un fatto, un'affermazione o un calcolo.",
      "examples": [
        "Le sue argomentazioni erano piene di ragione e buon senso.",
        "Hai perfettamente ragione, ho sbagliato i conti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Stato di equilibrio mentale e lucidità, o la capacità di agire con senno e prudenza.",
      "examples": [
        "Dopo il lungo viaggio, gli ci è voluto un po' per tornare in ragione.",
        "È una persona di grande ragione, non si lascia prendere dal panico."
      ],
      "nota": "Spesso usata in espressioni idiomatiche come 'tornare in ragione' o 'essere in ragione'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Diritto o titolo legittimo su qualcosa, spesso in ambito commerciale o legale.",
      "examples": [
        "Questa merce è di mia ragione e deve essere consegnata a me.",
        "Ha agito per una giusta ragione, difendendo i suoi averi."
      ],
      "nota": "Comunemente usata in espressioni come 'a ragione di' (nel senso di 'in proporzione a') o ‘saldo a ragione’."
    }
  ]
