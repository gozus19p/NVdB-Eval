  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Sovrana di uno stato monarchico, colei che detiene il potere supremo per diritto di nascita o in seguito a matrimonio con un re.",
      "examples": [
        "La regina Elisabetta II ha regnato per oltre settant'anni.",
        "Dopo la morte del monarca, sua figlia è diventata la nuova regina."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Pedina del gioco degli scacchi, la più potente sulla scacchiera, capace di muoversi in ogni direzione per un numero illimitato di caselle.",
      "examples": [
        "Negli scacchi, la regina è un pezzo fondamentale per l'attacco.",
        "Il giocatore ha sacrificato un pedone per salvare la sua regina."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Donna che eccelle in una specifica disciplina, attività o campo, tanto da esserne considerata la figura più rappresentativa e influente.",
      "examples": [
        "È stata la regina della canzone italiana per decenni.",
        "Maria Callas è universalmente riconosciuta come la regina della lirica."
      ],
      "nota": "Uso figurato per indicare primato o eccellenza."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ape femmina fertile, l'unica in grado di deporre le uova in un alveare, dalla quale discendono tutte le altre api della colonia.",
      "examples": [
        "L'apicoltore ha individuato la regina nell'alveare.",
        "Senza la regina, la colonia di api non può sopravvivere."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In senso figurato, ciò che rappresenta il fulcro o l'elemento dominante di un luogo, un contesto o un insieme di cose.",
      "examples": [
        "Venezia è la regina dell'Adriatico per la sua bellezza.",
        "La pizza napoletana è la regina della tavola italiana."
      ],
      "nota": "Spesso usato in espressioni cristallizzate."
    }
  ]
