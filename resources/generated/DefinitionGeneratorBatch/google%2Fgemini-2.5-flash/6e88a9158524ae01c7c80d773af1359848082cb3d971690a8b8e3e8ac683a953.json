  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Parte del corpo femminile corrispondente alle mammelle, spesso considerata come simbolo di maternità o bellezza.",
      "examples": [
        "Il chirurgo ha eseguito un intervento al seno.",
        "Ha dovuto affrontare una difficile diagnosi di tumore al seno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte interna e concava di un corpo o di un elemento naturale, che accoglie o racchiude qualcosa.",
      "examples": [
        "La nave ha attraccato nel seno del porto, riparata dal vento.",
        "I marinai cercarono rifugio nel seno della baia durante la tempesta."
      ],
      "nota": "Spesso usato in riferimento a insenature naturali come golfi o anse."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In matematica, in un triangolo rettangolo, rapporto tra la lunghezza del cateto opposto a un angolo acuto e la lunghezza dell'ipotenusa.",
      "examples": [
        "Il seno di 90 gradi è uguale a uno.",
        "È necessario calcolare il seno dell'angolo per risolvere il problema geometrico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Spazio intimo o privato, ambito familiare o contesto sociale circoscritto in cui ci si sente protetti e accolti.",
      "examples": [
        "È cresciuto nel seno di una famiglia amorevole.",
        "Ha trovato conforto nel seno della comunità religiosa."
      ],
      "nota": "Uso figurato."
    }
  ]
