  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "L'atto di produrre suoni melodici con la voce, sia umani che animali.",
      "examples": [
        "Il canto degli uccelli all'alba mi ha svegliato dolcemente.",
        "Ha dedicato molti anni allo studio del canto lirico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Composizione musicale o poetica destinata ad essere eseguita con la voce.",
      "examples": [
        "Quel canto popolare è stato tramandato di generazione in generazione.",
        "Il coro ha eseguito un canto natalizio con grande spiritualità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La capacità o l'arte di utilizzare la voce per produrre musica.",
      "examples": [
        "Ha un canto eccezionale e una notevole estensione vocale.",
        "Il suo canto è così potente da riempire l'intera sala."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sezione di un'opera letteraria, in particolare di un poema epico, che ne costituisce una parte divisoria significativa.",
      "examples": [
        "La Divina Commedia è divisa in canti, ognuno dei quali narra un episodio.",
        "Ho letto il canto quinto dell'Inferno, è davvero toccante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il lato o l'estremità più stretta di un oggetto, solitamente una lastra o un volume.",
      "examples": [
        "Appoggia il libro sul tavolo, sul canto della copertina.",
        "La scultrice lavorò il canto della pietra, rendendola più liscia."
      ],
      "nota": "Spesso usato nell'espressione 'di canto' per indicare una posizione laterale o verticale rispetto alla superficie più ampia."
    }
  ]
