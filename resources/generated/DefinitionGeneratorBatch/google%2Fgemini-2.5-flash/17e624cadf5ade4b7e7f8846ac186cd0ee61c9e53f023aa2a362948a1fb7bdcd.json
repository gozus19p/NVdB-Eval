  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un'attività, un processo o un intervento su qualcosa o qualcuno, al fine di modificarlo, aggiustarlo o trattarlo.",
      "examples": [
        "Il chirurgo ha operato il paziente per rimuovere il tumore.",
        "Gli ingegneri stanno operando delle modifiche strutturali all'edificio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un effetto o una conseguenza, produrre un risultato; essere efficace.",
      "examples": [
        "La nuova normativa opererà grandi cambiamenti nel settore.",
        "Il farmaco ha operato rapidamente contro il dolore."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Svolgere un'attività lavorativa o professionale, agire in un determinato campo o settore.",
      "examples": [
        "L'azienda opera nel settore tecnologico da oltre vent'anni.",
        "I volontari operano in zone disagiate per portare aiuto."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Svolgere la propria attività in un determinato modo o con specifici strumenti, oppure agire su sé stessi producendo un effetto.",
      "examples": [
        "La macchina si è operata da sola, seguendo le istruzioni preimpostate.",
        "Il corpo si opera costantemente per mantenere l'equilibrio."
      ],
      "nota": "Questo uso è meno comune e più specialistico, spesso in contesti tecnici o biologici."
    }
  ]
