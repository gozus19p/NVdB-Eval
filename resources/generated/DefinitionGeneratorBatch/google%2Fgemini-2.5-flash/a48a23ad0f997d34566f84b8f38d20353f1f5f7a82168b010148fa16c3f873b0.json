  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Tendenza o stile prevalente in un determinato periodo storico, specialmente nel modo di vestire, di acconciarsi o di comportarsi.",
      "examples": [
        "La moda di quest'anno vede il ritorno dei pantaloni a zampa d'elefante.",
        "Seguire la moda è una scelta personale, non un obbligo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il settore industriale e commerciale che progetta, produce e vende abiti, accessori e articoli di lusso, spesso legati a eventi come sfilate e collezioni esclusive.",
      "examples": [
        "Milano è considerata una delle capitali della moda a livello mondiale.",
        "Lavorare nel mondo della moda richiede creatività e dedizione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Un modo di agire o di pensare che diventa popolare per un breve periodo di tempo, spesso senza un fondamento duraturo, e che poi decade rapidamente.",
      "examples": [
        "La dieta del limone è stata solo una moda passeggera.",
        "Molti adolescenti seguono le mode lanciate dai loro idoli."
      ],
      "nota": "Spesso usato in riferimento a fenomeni effimeri o trend passeggeri, in contrasto con tendenze più profonde o consolidate."
    }
