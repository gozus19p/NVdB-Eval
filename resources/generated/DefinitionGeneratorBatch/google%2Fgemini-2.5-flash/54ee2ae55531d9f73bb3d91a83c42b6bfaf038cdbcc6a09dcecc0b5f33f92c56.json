  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Assumere una posizione caratterizzata dall'appoggio del tronco su una superficie, mantenendo le gambe piegate e i piedi a terra o sollevati.",
      "examples": [
        "Ti aspetto qui, puoi venire a sedere accanto a me.",
        "Il bambino si rifiutava di sedere a tavola per mangiare."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a oggetti, essere posto o poggiato su una superficie, in particolare in modo stabile o decorativo.",
      "examples": [
        "Il vassoio sedeva precariamente sul bordo del tavolo.",
        "Sopra il camino, una statuina di porcellana sedeva con eleganza."
      ],
      "nota": "Uso meno comune, tipicamente applicato a oggetti, spesso con un'accezione di staticità o posizionamento delicato."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte posteriore del corpo umano, tra la schiena e le gambe, su cui ci si siede; i glutei.",
      "examples": [
        "Dopo la lunga camminata, gli facevano male le gambe e il sedere.",
        "Cadendo, ha battuto forte il sedere per terra."
      ],
      "nota": "Linguaggio comune, colloquiale, spesso preferito a 'glutei' o 'natiche' in conversazioni informali."
    }
