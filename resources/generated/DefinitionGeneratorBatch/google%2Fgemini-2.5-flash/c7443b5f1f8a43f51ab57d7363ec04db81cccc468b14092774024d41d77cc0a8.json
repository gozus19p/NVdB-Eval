  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dare un impiego o un incarico retribuito a qualcuno.",
      "examples": [
        "L'azienda ha deciso di assumere nuovi dipendenti per espandere il settore vendite.",
