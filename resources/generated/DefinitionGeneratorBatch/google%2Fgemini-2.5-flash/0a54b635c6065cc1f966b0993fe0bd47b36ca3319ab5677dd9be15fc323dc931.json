  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Miscela gassosa incolore, inodore e insapore che costituisce l'atmosfera terrestre, essenziale per la respirazione degli esseri viventi.",
      "examples": [
        "Un po' di aria fresca dopo una giornata chiusa in ufficio fa sempre bene.",
        "È importante arieggiare bene le stanze per ricambiare l'aria."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Spazio atmosferico che circonda la Terra; il cielo o l'elemento in cui si muovono gli aeromobili.",
      "examples": [
        "L'aquilone si alzò leggero nell'aria.",
        "Il pilota solcava l'aria con grande destrezza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Aspetto esteriore, atteggiamento o espressione del viso che rivela lo stato d'animo o la personalità di una persona o di una situazione.",
      "examples": [
        "Quella persona ha sempre un'aria misteriosa.",
        "Il dipinto aveva un'aria malinconica che mi ha colpito molto."
      ],
      "nota": "Spesso in espressioni come 'farsi aria' (ventilarsi) o 'tirarsela' (darsi arie, atteggiarsi)."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Melodia o brano musicale cantato da un solista, spesso all'interno di un'opera lirica o di un'oratorio.",
      "examples": [
        "Il soprano ha eseguito una magnifica aria del 'Barbiere di Siviglia'.",
        "Quest'aria è una delle più celebri del repertorio operistico italiano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Ventilazione, movimento di gas generato artificialmente.",
      "examples": [
        "Con il caldo di oggi ci vorrebbe un po' di aria condizionata.",
        "La pompa immette aria nel serbatoio."
      ],
      "nota": null
    }
  ]
