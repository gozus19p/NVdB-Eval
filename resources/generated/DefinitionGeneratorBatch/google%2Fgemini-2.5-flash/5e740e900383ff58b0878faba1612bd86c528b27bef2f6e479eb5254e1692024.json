  },
  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Compiere un'azione, specialmente negativa, illecita o dannosa.",
      "examples": [
        "Temeva di commettere un errore irreparabile durante l'operazione.",
        "Il criminale ha commesso un grave furto nel centro commerciale."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Affidare un compito o un incarico a qualcuno; dare in gestione o in custodia.",
      "examples": [
        "Ho commesso l'organizzazione dell'evento al mio assistente più fidato.",
        "Gli fu commessa la responsabilità di proteggere la famiglia reale."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Impegnarsi o dedicarsi con serietà a un'azione, un'attività o un progetto, specialmente se di lunga durata o di notevole impegno.",
      "examples": [
        "Si è commesso allo studio della medicina con grande dedizione.",
        "Non voleva commettersi in un progetto senza avere tutte le informazioni necessarie."
      ],
      "nota": "Spesso usato nella forma pronominale 'commettersi a qualcosa' o 'commettersi di fare qualcosa'."
    }
  ]
