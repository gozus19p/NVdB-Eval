  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che offre agio, benessere o facile fruizione, privo di difficoltà o disagi.",
      "examples": [
        "Ho comprato un divano molto comodo per il salotto.",
        "Questa posizione è più comoda per lavorare al computer."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di persona, chi cerca o preferisce situazioni che richiedono scarso impegno o fatica.",
      "examples": [
        "È un ragazzo un po' comodo, non ama fare lavori pesanti.",
        "Non essere così comodo, alzati e aiutami!"
      ],
      "nota": "Ha una connotazione leggermente negativa, spesso associata alla pigrizia."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione o situazione di agio e benessere fisico o materiale.",
      "examples": [
        "Cercava sempre il comodo e evitava ogni fatica.",
        "Per il suo comodo, ha preso un taxi invece di camminare."
      ],
      "nota": "Spesso usato in espressioni come 'fare i propri comodi' per indicare un comportamento egoistico."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un pezzo di arredamento mobile (toilette, pitale) utilizzato per espletare le proprie funzioni fisiologiche, in particolare in contesti storici o in assenza di servizi igienici moderni.",
      "examples": [
        "La nonna usava ancora il comodo di notte.",
        "Nel museo era esposto un antico comodo da camera."
      ],
      "nota": "Uso meno frequente nell'italiano contemporaneo per indicare i servizi igienici moderni (WC)."
    }
  ]
