  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Comunicare informazioni, spesso riguardanti un possibile rischio, un cambiamento imminente o una direttiva, a qualcuno affinché ne sia informato e possa agire di conseguenza.",
      "examples": [
        "Ho avvertito i miei colleghi della riunione straordinaria di domani mattina.",
        "Ti avevo avvertito di non toccare quel filo scoperto, ora vedi cosa è successo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Percepire mentalmente o sensorialmente qualcosa, prendere coscienza di una sensazione o di uno stato d'animo.",
      "examples": [
        "Ho iniziato ad avvertire un forte mal di testa durante il viaggio.",
        "Marco ha avvertito un disagio crescente nell'ambiente di lavoro."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Accorgersi di qualcosa attraverso l'esperienza o la riflessione, diventare consapevole di uno stato o di una condizione personale.",
      "examples": [
        "Solo dopo l'incidente si è avvertito di aver corso un rischio enorme.",
        "Mi sono avvertito di essere stanco e ho deciso di riposare."
      ],
      "nota": null
    }
  ]
