  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Collocare o posizionare qualcosa in un determinato luogo o su una superficie.",
      "examples": [
        "Ho messo il libro sullo scaffale.",
        "Devi mettere i piatti a lavare dopo cena."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Indossare un capo di abbigliamento o un accessorio.",
      "examples": [
        "Metterò la giacca pesante perché fa freddo.",
        "Ha messo gli occhiali da sole prima di uscire."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dare inizio a qualcosa, avviare un'azione o un processo.",
      "examples": [
        "Hanno messo su un'azienda di successo in pochi anni.",
        "Il governo deve mettere in atto nuove riforme economiche."
      ],
      "nota": "Spesso usato in espressioni idiomatiche come 'mettere su', 'mettere in atto'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Causare una particolare condizione o sensazione in qualcuno.",
      "examples": [
        "Quel film mi ha messo molta tristezza.",
        "La notizia lo ha messo in ansia."
      ],
      "nota": "Usato per esprimere effetti emotivi o stati d'animo."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inserire o includere qualcosa in un insieme o un contesto.",
      "examples": [
        "Dobbiamo mettere queste informazioni nel rapporto finale.",
        "Non dimenticare di mettere la tua firma sul documento."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Destinare denaro, tempo o risorse a uno scopo specifico.",
      "examples": [
        "Ho messo da parte molti soldi per il viaggio.",
        "Dobbiamo mettere più impegno in questo progetto."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Indossare su di sé un capo di abbigliamento o un accessorio.",
      "examples": [
        "Si è messo subito il cappotto appena è entrato.",
        "Non so cosa mettermi per la festa di stasera."
      ],
      "nota": "Corrisponde al significato transitivo di 'indossare', ma con soggetto e oggetto coincidenti."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Assumere una determinata postura o posizione del corpo.",
      "examples": [
        "Si è messo a sedere sul divano.",
        "Il bambino si è messo in piedi da solo per la prima volta."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Iniziare improvvisamente un'azione o un compito.",
      "examples": [
        "Si è messo a ridere senza motivo.",
        "Appena ha avuto un momento libero, si è messo a studiare."
      ],
      "nota": "Spesso seguito da 'a' + infinito."
    }
  ]
