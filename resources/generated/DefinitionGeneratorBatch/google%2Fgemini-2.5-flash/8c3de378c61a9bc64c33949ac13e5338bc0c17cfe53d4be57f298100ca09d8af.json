  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di colore primario, spesso associato al sole, al limone o all'oro, intermedio tra il verde e l'arancione nello spettro visibile.",
      "examples": [
        "Ho comprato una maglietta giallo vivo per l'estate.",
        "Le foglie degli alberi diventano gialle in autunno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a un genere letterario o cinematografico caratterizzato da suspense, mistero e spesso da un'indagine su un crimine.",
      "examples": [
        "Sto leggendo un romanzo giallo avvincente di Agatha Christie.",
        "Il film giallo che abbiamo visto ieri sera era pieno di colpi di scena."
      ],
      "nota": "Spesso usato come sostantivo per indicare il genere stesso."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il colore giallo.",
      "examples": [
        "Il giallo è il mio colore preferito.",
        "Ha dipinto la parete di un giallo tenue."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Un'opera letteraria o cinematografica appartenente al genere del mistero e del crimine.",
      "examples": [
        "Ho portato un giallo dalla biblioteca per il weekend.",
        "Quel regista è famoso per i suoi gialli intricati."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Informazione o notizia non confermata, spesso sensazionalistica o scandalistica, diffusa per creare clamore o distogliere l'attenzione.",
      "examples": [
        "Quel giornale pubblica solo gialli e pettegolezzi.",
        "La vicenda era piena di misteri e veri e propri gialli irrisolti."
      ],
      "nota": "L'uso in questo senso è per estensione del significato di 'giallo' come genere investigativo, ma riferito a fatti reali ambigui."
    }
  ]
