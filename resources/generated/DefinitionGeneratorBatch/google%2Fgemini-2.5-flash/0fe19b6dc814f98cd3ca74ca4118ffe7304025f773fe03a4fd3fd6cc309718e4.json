  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha una temperatura bassa, inferiore alla media o a quella percepita come gradevole; che provoca una sensazione termica sgradevole.",
      "examples": [
        "Oggi fa un tempo molto freddo, copriti bene.",
        "L'acqua del mare era fredda e non ho fatto il bagno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a persona, che manca di sentimenti, affettuosità o empatia; distaccato, indifferente.",
      "examples": [
        "Ha risposto con un tono freddo, senza mostrare alcuna emozione.",
        "Il suo atteggiamento freddo mi ha fatto sentire a disagio."
      ],
      "nota": "Spesso usato per descrivere un comportamento o una reazione."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a colore, che tende verso tonalità bluastre, grigie o violacee, spesso contrapposto ai colori caldi.",
      "examples": [
        "Ha scelto delle pitture dalle tonalità fredde per la sua stanza da letto.",
        "Il verde smeraldo è considerato un colore freddo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a ragionamento, analisi o processo, che è oggettivo, logico e privo di coinvolgimento emotivo; razionale.",
      "examples": [
        "Ha analizzato la situazione con fredda lucidità, senza farsi prendere dal panico.",
        "È necessario un approccio freddo e scientifico per risolvere il problema."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "La condizione di bassa temperatura dell'ambiente o la sensazione fisica che ne deriva.",
      "examples": [
        "Il freddo di questi giorni è insopportabile, non riesco neanche a uscire di casa.",
        "Ho sentito un brivido di freddo lungo la schiena."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "La mancanza di affetto, di calore umano o di coinvolgimento emotivo in una relazione o situazione.",
      "examples": [
        "Tra loro c'era un freddo che si tagliava con un coltello.",
        "Ha percepito il freddo nell'accoglienza, nonostante le apparenze."
      ],
      "nota": null
    }
  ]
