  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che può essere usato, impiegato o utilizzato per un determinato scopo; reperibile.",
      "examples": [
        "Il prodotto non è ancora disponibile in tutti i negozi.",
        "Ci sono ancora alcuni posti disponibili per il concerto di stasera."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a una persona, che è pronto e propenso ad aiutare gli altri, a collaborare o a fare qualcosa.",
      "examples": [
        "La sua collaboratrice è sempre molto disponibile ad accogliere nuove mansioni.",
        "Il medico si è mostrato disponibile a rispondere a tutte le nostre domande."
      ],
      "nota": "Questo senso si riferisce a una disposizione d'animo o atteggiamento."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a una persona, che ha tempo libero e non è impegnato, quindi può dedicarsi ad altro.",
      "examples": [
        "Sarò disponibile per un incontro a partire dalle cinque del pomeriggio.",
        "È un periodo lavorativo intenso, ma il prossimo mese sarò più disponibile."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riguardo a un oggetto o una risorsa, che non è vincolato o impegnato e può essere assegnato o destinato.",
      "examples": [
        "Abbiamo fondi disponibili per completare il progetto entro la fine dell'anno.",
        "Il posto auto libero è disponibile per i visitatori."
      ],
      "nota": null
    }
  ]
