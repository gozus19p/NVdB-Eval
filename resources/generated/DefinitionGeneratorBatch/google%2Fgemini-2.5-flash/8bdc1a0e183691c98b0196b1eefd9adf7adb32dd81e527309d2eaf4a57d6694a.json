  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che concerne la vita, l'organizzazione e il governo dello Stato o della comunità civile; relativo all'interesse collettivo.",
      "examples": [
        "Le decisioni politiche influenzano la vita di tutti i cittadini.",
        "Il dibattito politico è stato molto acceso e ha coinvolto diverse fazioni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo alla strategia e alle tattiche usate per acquisire o mantenere il potere o per influenzare decisioni in un dato contesto.",
      "examples": [
        "Ha compiuto una mossa politica astuta per ottenere l'appoggio degli altri membri del consiglio.",
        "La sua carriera è stata caratterizzata da una spiccata intelligenza politica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Persona che si dedica all'attività di governo o alla gestione della cosa pubblica, sia professionalmente sia per impegno civile.",
      "examples": [
        "Il politico ha annunciato le sue dimissioni dopo lo scandalo.",
        "Molti giovani desiderano diventare politici per cambiare il proprio paese."
      ],
      "nota": "Si riferisce sia a uomini che a donne."
    }
  ]
