  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "La capacità di agire e di scegliere autonomamente, senza costrizioni o vincoli esterni imposti da altri o dalle circostanze",
      "examples": [
        "Ogni cittadino ha diritto alla libertà di pensiero e di espressione.",
        "Dopo anni di prigionia, finalmente ha riacquistato la libertà."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Lo stato di chi non è prigioniero o sottomesso, ma si trova in una condizione di non schiavitù o detenzione",
      "examples": [
        "I ribelli lottavano per la libertà del loro popolo dall'oppressore.",
        "Al termine della pena, l'uomo riebbe la sua libertà."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La disponibilità di tempo impiegabile a proprio piacimento, senza impegni o doveri prestabiliti",
      "examples": [
        "Durante le vacanze, mi godo la completa libertà di non avere orari.",
        "Avere la libertà di viaggiare è un privilegio che apprezzo molto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Un eccessivo arbitrio o una mancanza di misura in azioni, costumi o espressioni, che si spinge oltre i limiti del rispetto o della convenienza",
      "examples": [
        "Si è preso troppa libertà nel commentare il lavoro altrui.",
        "La sua libertà di linguaggio ha offeso molti presenti."
      ],
      "nota": "Questo senso ha una connotazione negativa."
    }
  ]
