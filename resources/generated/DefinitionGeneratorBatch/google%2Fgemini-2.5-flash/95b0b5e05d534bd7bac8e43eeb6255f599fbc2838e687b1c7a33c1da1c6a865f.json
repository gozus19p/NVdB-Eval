  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Qualcosa che è realmente accaduto o che esiste in modo oggettivo.",
      "examples": [
        "Il fatto che tu sia qui mi rende felice.",
        "Dobbiamo attenerci ai fatti e non alle congetture."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un'azione compiuta da qualcuno.",
      "examples": [
        "Ha commesso un fatto grave e ora dovrà risponderne.",
        "Il suo primo fatto da presidente fu tagliare le tasse."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un evento o una circostanza significativa.",
      "examples": [
        "La caduta del muro di Berlino fu un fatto storico.",
        "Quel fatto cambiò per sempre la sua vita."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Compiuto, realizzato o portato a termine.",
      "examples": [
        "Il lavoro è ormai fatto, possiamo riposare.",
        "A tavola, è già tutto fatto!"
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a qualcosa di adatto, appropriato o idoneo per uno scopo specifico.",
      "examples": [
        "Questo abito non è fatto per occasioni formali.",
        "Sembra fatto apposta per te."
      ],
      "nota": null
    },
    {
      "pos": "participio passato",
      "definition": "Forma del verbo 'fare' che indica un'azione compiuta.",
      "examples": [
        "Ho fatto la spesa prima di tornare a casa.",
        "Le promesse fatte non sono state mantenute."
      ],
      "nota": "Questo senso è la declinazione del participio passato del verbo 'fare' e si usa in tempi composti o come aggettivo/sostantivo."
    }
