  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Persona che studia, interpreta e narra gli eventi del passato, basandosi su fonti e metodologie rigorose.",
      "examples": [
        "Un bravo storico deve essere imparziale nella sua analisi dei fatti.",
        "La scoperta di nuovi documenti ha costretto gli storici a rivedere alcune teorie consolidate."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo alla storia, allo studio degli eventi passati o alla loro narrazione.",
      "examples": [
        "L'indagine storica ha rivelato dettagli inaspettati sulla dinastia.",
        "Quel periodo storico è caratterizzato da grandi innovazioni culturali e scientifiche."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un evento, un luogo o un personaggio che ha avuto grande rilevanza negli annali del passato o che è degno di essere ricordato.",
      "examples": [
        "È stato un momento storico per la nazione, atteso da decenni.",
        "Il centro storico della città è patrimonio dell'UNESCO e attira molti turisti."
      ],
      "nota": "Spesso usato per indicare qualcosa di eccezionale o di grande importanza nel contesto attuale o passato."
    }
