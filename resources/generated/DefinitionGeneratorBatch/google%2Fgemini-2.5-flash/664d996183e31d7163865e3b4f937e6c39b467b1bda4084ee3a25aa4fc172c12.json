  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere sporco, macchie, detriti o impurità da una superficie o un oggetto per renderlo nitido e igienico.",
      "examples": [
        "Devo pulire il pavimento prima che arrivino gli ospiti.",
        "Ha passato un'ora a pulire l'auto per la mostra."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Togliere le parti superflue o indesiderate da qualcosa, specialmente cibo, per prepararlo al consumo o all'uso.",
      "examples": [
        "La cuoca sta pulendo il pesce dal guscio e dalle interiora.",
        "Ho passato tutta la mattina a pulire le verdure dell'orto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Liberare un ambiente o un luogo da persone o elementi ritenuti indesiderati, pericolosi o dannosi.",
      "examples": [
        "Le forze dell'ordine hanno pulito la zona dalla presenza di spacciatori.",
        "È necessario pulire il disco rigido dai file temporanei per migliorarne le prestazioni."
      ],
      "nota": "Uso figurato o esteso per indicare un'operazione di 'bonifica' o 'eliminazione'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sottrarre un bene o un valore, spesso in modo illecito, impoverendo qualcuno o qualcosa.",
      "examples": [
        "I ladri hanno completamente pulito la cassaforte contenente i gioielli.",
        "Il giocatore d'azzardo ha pulito il tavolo da tutti i soldi del suo avversario."
      ],
      "nota": "Uso colloquiale e figurato, con connotazione negativa."
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Rendersi deterso o immacolato, specialmente riferito alla pelle o a parti del corpo.",
      "examples": [
        "Il gatto si è pulito le zampette dopo aver mangiato.",
        "Dopo il lavoro, ho bisogno di pulirmi bene le mani dal grasso."
      ],
      "nota": null
    }
  ]
