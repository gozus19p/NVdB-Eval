  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo alla tecnica, alle sue applicazioni pratiche o alle procedure specialistiche proprie di un determinato campo.",
      "examples": [
        "Hai risolto il problema di natura tecnica riscontrato ieri?",
        "Per quel guasto serve un intervento meramente tecnico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che denota o richiede grande competenza specifica e abilità operativa in un determinato settore.",
      "examples": [
        "Ha svolto un lavoro estremamente tecnico e preciso.",
        "La sua analisi della situazione è stata molto tecnica e ha evidenziato ogni limite."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Una persona che possiede conoscenze approfondite e competenze pratiche in un settore specialistico, in grado di applicare tecniche e procedure specifiche.",
      "examples": [
        "È arrivato un tecnico per riparare la caldaia.",
        "La squadra ha bisogno di un buon tecnico per migliorare le perfomance."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Nell'ambito sportivo, la persona responsabile della preparazione, dell'allenamento e della strategia di una squadra o di un singolo atleta.",
      "examples": [
        "Il tecnico della squadra ha deciso formazioni diverse per la partita.",
        "Secondo il tecnico, l'atleta deve migliorare sotto il profilo della resistenza."
      ],
      "nota": null
    }
  ]
