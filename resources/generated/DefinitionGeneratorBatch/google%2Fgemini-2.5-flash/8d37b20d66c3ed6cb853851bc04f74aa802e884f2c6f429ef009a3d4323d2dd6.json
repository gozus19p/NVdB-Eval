  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Goccia di liquido salato che viene prodotta dalle ghiandole lacrimali degli occhi in risposta a stimoli emotivi (dolore, gioia, tristezza) o irritazioni fisiche.",
      "examples": [
        "Una singola lacrima scese lungo la sua guancia, tradendo la sua emozione.",
        "Le lacrime di gioia le riempirono gli occhi quando ha ricevuto la notizia inaspettata.",
        "Le lacrime scorrevano copiose lavando via la polvere dal suo viso stanco."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Piccola quantità di un liquido che stilla o si condensa, assumendo una forma simile a una goccia.",
      "examples": [
        "Dal soffitto cadevano piccole lacrime d'acqua che macchiavano il pavimento.",
        "Le lacrime di rugiada brillavano sulle foglie al mattino.",
        "Quando il bicchiere è colmo, l'acqua forma una lacrima sul bordo."
      ],
      "nota": "Si riferisce a liquidi diversi da quelli prodotti dagli occhi, per similarità di forma o comportamento."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strappo o piccolo foro visibile su un tessuto, una pagina o un altro materiale sottile.",
      "examples": [
        "Ha accidentalmente fatto una lacrima nella pagina del libro, rovinando il testo.",
        "C'era una piccola lacrima sul vestito nuovo, quindi l'ho rimandato indietro.",
        "Nel vecchio documento si potevano notare diverse lacrime e pieghe."
      ],
      "nota": "Uso figurato per indicare un difetto o una rottura."
    }
  ]
