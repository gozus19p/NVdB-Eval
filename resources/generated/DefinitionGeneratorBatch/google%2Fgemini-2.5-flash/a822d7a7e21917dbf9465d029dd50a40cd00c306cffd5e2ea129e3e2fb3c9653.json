  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Striscia di tessuto o altro materiale flessibile usata per avvolgere, cingere o decorare.",
      "examples": [
        "La dottoressa ha applicato una fascia elastica per sostenere la caviglia infortunata.",
        "Ha legato i capelli con una fascia colorata prima di uscire."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Un'area o zona geografica, economica, sociale o temporale, con caratteristiche uniformi o simili.",
      "examples": [
        "La fascia costiera è densamente popolata e ricca di strutture turistiche.",
        "Il governo ha introdotto nuove agevolazioni fiscali per la fascia di reddito più bassa.",
        "Guardo sempre i programmi televisivi in quella fascia oraria."
      ],
      "nota": "Spesso usato nell'espressione 'fascia oraria' o 'fascia di età'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "In matematica o fisica, una regione del piano o dello spazio delimitata da due superfici parallele.",
      "examples": [
        "Il satellite ha inviato dati relativi alla fascia di ozono.",
        "Nella topografia, le curve di livello possono delimitare fasce altimetriche."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Elemento decorativo orizzontale, spesso in rilievo, presente sulla superficie di un edificio o di un mobile.",
      "examples": [
        "La facciata del palazzo era ornata da una fascia a motivi floreali.",
        "Una fascia di legno intagliato correva lungo il bordo superiore dell'armadio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Nella simbologia araldica, un semicerchio o banda orizzontale che attraversa uno scudo.",
      "examples": [
        "Lo stemma di famiglia era caratterizzato da una fascia rossa su campo bianco.",
        "La fascia araldica era stata tramandata di generazione in generazione."
      ],
      "nota": null
    }
  ]
