  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Essere soprannaturale, spesso rappresentato con ali, che, secondo diverse tradizioni religiose, è un messaggero o un aiutante di Dio e protettore degli esseri umani.",
      "examples": [
        "Si narra che un angelo sia apparso in sogno per dare un messaggio divino.",
        "Molti credono che ognuno di noi abbia un angelo custode che veglia sulla propria vita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona estremamente buona, innocente o di squisita gentilezza, paragonata per le sue qualità morali all'essere soprannaturale.",
      "examples": [
        "Quel bambino è un angelo, non fa mai dispetti a nessuno.",
        "La mia vicina è un angelo, mi ha aiutato tantissimo durante la malattia."
      ],
      "nota": "L'uso è spesso metaforico o iperbolico per esaltare le virtù di qualcuno."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "In senso figurato, persona molto bella o affascinante, la cui presenza o aspetto suscitano ammirazione.",
      "examples": [
        "Con un abito così, sembri un angelo sceso dal cielo.",
        "Era un angelo, con quegli occhi azzurri e i capelli biondi."
      ],
      "nota": "Spesso utilizzato in contesti amorosi o per descrivere la bellezza fisica."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Nel linguaggio familiare o come appellativo affettuoso, modo di chiamare una persona amata, specialmente un bambino, per indicare tenerezza o affetto profondo.",
      "examples": [
        "Vieni qui, angelo mio, ti stringo forte.",
        "Dormi bene, angelo, la mamma è qui con te."
      ],
      "nota": "Questo uso è distintamente vocativo e affettivo."
    }
  ]
