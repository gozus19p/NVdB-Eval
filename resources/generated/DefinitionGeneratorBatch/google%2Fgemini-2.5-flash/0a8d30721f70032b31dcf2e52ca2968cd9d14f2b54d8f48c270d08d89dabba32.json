  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Creare o rappresentare qualcosa che non corrisponde alla realtà, spesso con l'intento di ingannare o nascondere la verità.",
      "examples": [
        "Il bambino ha finto di dormire per non andare a scuola.",
        "Non fingere indifferenza, so che la cosa ti preoccupa."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Comportarsi o apparire in un modo non autentico, simulando un atteggiamento o uno stato d'animo.",
      "examples": [
        "Si finge felice, ma in realtà è molto triste per l'accaduto.",
        "Molte persone si fingono esperte su argomenti di cui non sanno nulla."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Immaginare o concepire mentalmente qualcosa che non esiste o non è reale.",
      "examples": [
        "Finse un mondo popolato da draghi e unicorni.",
        "Non riesco a fingere un futuro senza di te."
      ],
      "nota": "In questo senso è meno comune e spesso sostituibile con 'immaginare' o 'concepire'."
    }
