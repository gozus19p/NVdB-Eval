  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Sentimento di dolore profondo, tristezza o afflizione, spesso causato da un evento sfortunato o dalla perdita di qualcosa o qualcuno.",
      "examples": [
        "Provava una grande pena per la sorte degli animali abbandonati.",
        "Le sue parole mi hanno riempito di pena e rammarico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Punizione o castigo inflitto per una trasgressione, un reato o una colpa, previsto dalla legge o da un'autorità.",
      "examples": [
        "La pena per quel crimine è stata molto severa.",
        "Ha scontato la sua pena in carcere per diversi anni."
      ],
      "nota": "Spesso usato in contesti giuridici o morali per indicare la conseguenza negativa di un'azione. Compara con 'penalità'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Sforzo faticoso o grande difficoltà incontrata nel compiere un'azione o nel raggiungere un obiettivo.",
      "examples": [
        "È riuscito a finire il lavoro solo a prezzo di grande pena.",
        "Mi sono dato molta pena per organizzare la festa, ma ne è valsa la pena."
      ],
      "nota": "Frequente nell'espressione 'a pena di' o 'con pena' per indicare un risultato ottenuto con difficoltà."
    }
  ]
