  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Emettere suoni melodiosi con la voce, spesso eseguendo un brano musicale o esprimendo emozioni attraverso la modulazione vocale.",
      "examples": [
        "Ho sentito il gallo cantare all'alba.",
        "Mia sorella sa cantare benissimo l'opera."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire un brano musicale o un testo poetico utilizzando la voce.",
      "examples": [
        "Ha cantato una serenata sotto la sua finestra.",
        "Il coro canterà un inno prima della partita."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Si dice di uccelli o altri animali quando emettono i loro tipici versi caratteristici, spesso melodiosi o ripetitivi.",
      "examples": [
        "Gli uccelli hanno iniziato a cantare con i primi raggi del sole.",
        "Il canarino canta nella sua gabbia."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Variare il tono di voce o avere un accento particolare dovuto alle inflessioni dialettali o regionali di un luogo.",
      "examples": [
        "Quando parla, si sente che canta un po' in romagnolo.",
        "Lei canta in un modo buffo, si capisce subito che non è di qui."
      ],
      "nota": "L'uso è spesso informale e può avere una connotazione valutativa, a volte scherzosa."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Rendere noto, rivelare o confessare informazioni segrete o riservate, spesso sotto pressione o per ottenere un vantaggio.",
      "examples": [
        "Dopo ore di interrogatorio, il sospettato ha finalmente iniziato a cantare.",
        "Se i bambini iniziano a cantare, scopriranno chi ha rotto il vaso."
      ],
      "nota": "Uso figurato, comune in contesti informali o polizieschi."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a uno strumento musicale, produrre suoni chiari, pieni e gradevoli.",
      "examples": [
        "Quel violino canta divinamente.",
        "Le campane antiche cantano con un suono armonioso."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Esprimere o narrare poeticamente o in modo solenne, esaltando solitamente vicende eroiche o memorabili.",
      "examples": [
        "I poeti antichi amavano cantare le gesta degli eroi.",
        "L'epica canta le imprese di popoli passati."
      ],
      "nota": "Uso letterario o elevato, spesso riferito a opere d'arte o testi scritti."
    }
  ]
