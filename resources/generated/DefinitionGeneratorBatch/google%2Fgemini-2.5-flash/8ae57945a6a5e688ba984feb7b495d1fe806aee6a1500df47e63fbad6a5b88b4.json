  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Modificare o sostituire qualcosa con un'altra cosa differente o nuova.",
      "examples": [
        "Ho deciso di cambiare lavoro per cercare nuove opportunità.",
        "Dobbiamo cambiare l'acqua dei pesci ogni settimana."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Scambiare denaro di un taglio con denaro equivalente di tagli minori, o convertire una valuta in un'altra.",
      "examples": [
        "Potresti cambiarmi questi cinquanta euro in tagli più piccoli?",
        "Prima di partire, devo cambiare gli euro in dollari."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Subire una trasformazione o un'evoluzione, assumendo caratteristiche diverse dal precedente stato.",
      "examples": [
        "Il tempo è cambiato improvvisamente, ora piove.",
        "È incredibile come i bambini cambino in così pochi anni."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Passare da un mezzo di trasporto a un altro, o da una linea a un'altra, per proseguire un viaggio.",
      "examples": [
        "Per arrivare a destinazione, dobbiamo cambiare treno a Bologna.",
        "Non ho voglia di cambiare autobus, preferisco camminare."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Modificare le proprie abitudini, opinioni, comportamenti o il proprio aspetto esteriore.",
      "examples": [
        "Dopo quell'esperienza, si è cambiato molto nel modo di pensare.",
        "Si è cambiata d'abito per la cena di gala."
      ],
      "nota": null
    }
  ]
