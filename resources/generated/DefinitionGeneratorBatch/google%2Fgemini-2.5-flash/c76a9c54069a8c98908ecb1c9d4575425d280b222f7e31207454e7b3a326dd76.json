  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Ambiente delimitato all'interno di un edificio, destinato a specifiche funzioni abitative o lavorative.",
      "examples": [
        "La mia camera da letto è molto luminosa e spaziosa.",
        "Abbiamo affittato una camera doppia con vista sul mare.",
        "La riunione si terrà nella camera del consiglio all'ottavo piano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Organo o assemblea legislativa di uno Stato, facente parte del Parlamento.",
      "examples": [
        "La Camera dei Deputati ha approvato la nuova legge sul bilancio.",
        "Il presidente della Camera ha aperto la seduta con un discorso programmatico."
      ],
      "nota": "Spesso usato in riferimento alla 'Camera dei Deputati', o 'Camera Alta/Bassa' in sistemi bicamerali."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Mezzo meccanismo che produce immagini in movimento; dispositivo elettronico utilizzato per registrare video o fotografare.",
      "examples": [
        "Ho comprato una nuova camera digitale per le vacanze.",
        "Le telecamere di sicurezza hanno ripreso l'intera scena del furto."
      ],
      "nota": "Spesso abbreviato da 'fotocamera' o 'videocamera'. In questo senso 'camera' è l'abbreviazione per questi strumenti."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Ogni ambiente o porzione interna delimitata, all'interno di un macchinario o di una struttura complessa, destinato a particolari funzioni.",
      "examples": [
        "La camera di combustione del motore è un componente cruciale.",
        "I tecnici hanno ispezionato la camera stagna del sottomarino."
      ],
      "nota": null
    }
  ]
