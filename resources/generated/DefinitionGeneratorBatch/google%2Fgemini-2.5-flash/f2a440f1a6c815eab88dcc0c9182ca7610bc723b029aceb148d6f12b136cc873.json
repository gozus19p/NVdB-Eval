  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Il tempo trascorso, gli eventi o le esperienze che si sono già verificati.",
      "examples": [
        "Lasciamoci alle spalle il passato e guardiamo al futuro con ottimismo.",
        "Il passato influenza sempre il nostro presente, anche se non ce ne rendiamo conto.",
        "Non riesco a dimenticare il passato, mi tormenta ancora."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si è già verificato o compiuto; che appartiene a un periodo di tempo precedente a quello attuale.",
      "examples": [
        "Le memorie degli anni passati riaffiorano nella sua mente.",
        "La settimana passata è stata molto intensa e piena di impegni.",
        "È un evento passato, non ha più alcuna rilevanza."
      ],
      "nota": null
    },
    {
      "pos": "verbo",
      "definition": "Participio passato del verbo 'passare', che indica l'azione di oltrepassare un luogo, di trascorrere un periodo di tempo, di subire un'esperienza o di avvenire.",
      "examples": [
        "Ho passato l'esame con ottimi voti.",
        "Siamo passati sotto il ponte per evitare il traffico.",
        "Quel momento è passato in un baleno, quasi non me ne sono accorto."
      ],
      "nota": "Questo senso è la forma verbale del participio passato, spesso usata in tempi composti o con funzione aggettivale."
    }
  ]
