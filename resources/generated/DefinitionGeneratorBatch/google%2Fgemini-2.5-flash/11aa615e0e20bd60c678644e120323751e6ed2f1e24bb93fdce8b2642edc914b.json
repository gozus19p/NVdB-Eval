  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Avere al proprio interno o racchiudere qualcosa in uno spazio specifico.",
      "examples": [
        "Il vaso non può contenere tutti quei fiori.",
        "Questa stanza contiene molti mobili antichi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ricprendere qualcosa, impedendo che si manifesti con forza o che si propaghi oltre certi limiti.",
      "examples": [
        "È stato difficile contenere la sua rabbia dopo la discussione.",
        "Le dighe servono a contenere la piena dei fiumi."
      ],
      "nota": "Spesso usato in riferimento a emozioni, forze o fenomeni naturali."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Limitare le dimensioni, la quantità o il costo di qualcosa per non superare un determinato livello.",
      "examples": [
        "Dobbiamo contenere le spese se vogliamo arrivare a fine mese.",
        "Il governo sta cercando di contenere l'inflazione con nuove misure economiche."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Riuscire a controllare le proprie emozioni, reazioni o impulsi, evitando di esprimere ciò che si prova o ciò che si vorrebbe fare.",
      "examples": [
        "Si sforzò di contenersi, anche se la notizia lo aveva turbato profondamente.",
        "Durante la riunione, fu essenziale che tutti i presenti riuscissero a contenersi per mantenere un clima sereno."
      ],
      "nota": "Implica un'azione volontaria di autocontrollo."
    }
  ]
