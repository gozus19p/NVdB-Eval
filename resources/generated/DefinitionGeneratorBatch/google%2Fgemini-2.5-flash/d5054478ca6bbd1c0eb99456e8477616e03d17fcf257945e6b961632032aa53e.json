  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Atto concreto di impiegare o adoperare qualcosa per uno scopo, oppure il modo in cui qualcosa viene utilizzato.",
      "examples": [
        "L'uso eccessivo del telefono può danneggiare la vista.",
        "Ha fatto un uso improprio degli strumenti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Pratica o consuetudine stabilita e riconosciuta all'interno di una comunità o società, che determina il modo accettato di comportarsi o agire in determinate situazioni.",
      "examples": [
        "È d'uso in questa regione salutarsi con un bacio sulla guancia.",
        "Secondo gli usi e i costumi locali, la cerimonia si svolge in piazza."
      ],
      "nota": "Spesso in espressioni come 'secondo l'uso', 'è d'uso'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Fruizione o godimento di un bene o di un diritto, che può essere limitato o pieno.",
      "examples": [
        "Gli abitanti hanno il diritto d'uso del pascolo comune.",
        "Il contratto prevedeva l'uso esclusivo della proprietà."
      ],
      "nota": "Principalmente in contesti giuridici o amministrativi."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "L'essere valido o accettato in un determinato momento storico o contesto, in riferimento a un linguaggio, una moda o un'abitudine.",
      "examples": [
        "Alcune parole sono cadute in disuso nel linguaggio moderno.",
        "Questa giacca è ormai fuori uso, mettila via."
      ],
      "nota": "Spesso in locuzioni come 'in uso', 'fuori uso', 'in disuso'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Impiegare o adoperare qualcosa per uno scopo specifico; servirsi di un oggetto o di una risorsa.",
      "examples": [
        "Normalmente non uso il sale quando cucino.",
        "Dovresti usare un tono più gentile quando parli con i bambini."
      ],
      "nota": "Questo è il significato base del verbo 'usare'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere l'abitudine o la consuetudine di compiere una certa azione o di comportarsi in un dato modo.",
      "examples": [
        "Quando ero bambino, usavo leggere un libro prima di dormire.",
        "Non si usa più scrivere lettere a mano."
      ],
      "nota": "Comunemente seguito da un infinito introdotto da 'a' o senza preposizione, o da un costrutto con 'che'."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Servirsi di qualcosa come propria abitudine o consuetudine.",
      "examples": [
        "Mi sono usato fin da piccolo ad alzarmi presto.",
        "Non mi ci sono mai usato a queste temperature rigide."
      ],
      "nota": "Meno comune e più formale rispetto all'uso intransitivo."
    }
  ]
