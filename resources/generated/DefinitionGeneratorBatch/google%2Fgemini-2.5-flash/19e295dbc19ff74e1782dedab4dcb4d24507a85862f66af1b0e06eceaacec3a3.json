  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova di fronte, in posizione speculare o contrastante rispetto a qualcos'altro.",
      "examples": [
        "Le due case si trovavano sui lati opposti della strada.",
        "Ha espresso un parere completamente opposto al mio."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è fondamentalmente diverso o incompatibile, sia per caratteristiche che per scopi.",
      "examples": [
        "Le loro idee politiche erano diametralmente opposte.",
        "I risultati ottenuti erano l'esatto opposto di quanto speravamo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Ciò che è contrario o specularmente diverso rispetto a un referente.",
      "examples": [
        "Il bianco è l'opposto del nero.",
        "Ha sostenuto l'esatto opposto di quanto affermato in precedenza."
      ],
      "nota": null
    },
    {
      "pos": "verbo (transitivo)",
      "definition": "Forma del participio passato del verbo 'opporre', che indica l'azione di mettere contro o porre come ostacolo.",
      "examples": [
        "Ha opposto una ferma resistenza alle sue richieste.",
        "Le sue obiezioni erano già state opposte durante la riunione."
      ],
      "nota": "Questo senso si riferisce principalmente all'uso participiale del lemma."
    }
  ]
