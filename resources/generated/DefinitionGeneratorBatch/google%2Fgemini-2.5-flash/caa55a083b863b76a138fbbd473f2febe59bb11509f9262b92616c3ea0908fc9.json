  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Movimento che si compie alternando l'appoggio dei piedi per camminare o spostarsi.",
      "examples": [
        "Ho fatto alcuni passi avanti prima di fermarmi.",
        "Il bambino ha mosso i suoi primi passi da solo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Il luogo o lo spazio percorso con un singolo movimento del piede, o la distanza tra un piede e l'altro durante il cammino.",
      "examples": [
        "Siamo a pochi passi dalla cima della montagna.",
        "Dista solo due passi da qui."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Andatura, cadenza o ritmo con cui si procede camminando o muovendosi.",
      "examples": [
        "Mantenere un passo costante è importante per una buona corsa.",
        "Il passo lento della lumaca è proverbiale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Un punto di accesso o un valico montano che consente di attraversare una catena montuosa o un ostacolo naturale.",
      "examples": [
        "Il passo del Brennero è un importante collegamento tra l'Italia e l'Austria.",
        "Il passo carsico era gelato e difficile da superare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Fase, stadio o punto specifico di un processo, di un'azione o di una serie di operazioni.",
      "examples": [
        "Abbiamo compiuto un passo importante per la risoluzione del problema.",
        "Il primo passo per imparare è ascoltare attentamente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Brano o estratto di un testo scritto o musicale.",
      "examples": [
        "Ha letto un passo significativo del romanzo.",
        "Il direttore d'orchestra ha richiesto di ripetere quel passo musicale."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un determinato corso o svolgimento; accadere, verificarsi.",
      "examples": [
        "Cosa ti passa per la mente in questo momento?",
        "Non riesco a capire cosa stia per passare."
      ],
      "nota": "In questo senso è sempre usato in forma impersonale o con un soggetto neutro."
    }
  ]
