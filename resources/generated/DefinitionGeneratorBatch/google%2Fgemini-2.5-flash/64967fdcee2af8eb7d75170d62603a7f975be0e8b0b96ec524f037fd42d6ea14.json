  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Sensazione spiacevole, disagio fisico o irritazione leggera, spesso causata da qualcosa che turba la tranquillità o l'equilibrio.",
      "examples": [
        "Provo un leggero fastidio alla gola da quando ho preso freddo.",
        "Il rumore costante del trapano mi sta causando un enorme fastidio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Circostanza, persona o situazione che provoca irritazione, disturbo o impaccio.",
      "examples": [
        "Quei continui ritardi sono un vero fastidio.",
        "Sei un fastidio quando non mi lasci lavorare in pace."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Sentimento di avversione o repulsione verso qualcosa o qualcuno, spesso accompagnato da insofferenza.",
      "examples": [
        "Ho un grande fastidio per le persone che non rispettano gli orari.",
        "Provo un certo fastidio all'idea di dover stare in fila per ore."
      ],
      "nota": "Spesso usato in espressioni come 'avere fastidio di/per'."
    }
  ]
