  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di cielo o atmosfera, privo di nuvole e limpido, che permette la piena visibilità del sole o delle stelle.",
      "examples": [
        "Dopo la pioggia, il cielo è diventato sereno e luminoso.",
        "Le previsioni meteo annunciano tempo sereno per tutto il fine settimana."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di persona, calmo, tranquillo e privo di preoccupazioni o turbamenti emotivi.",
      "examples": [
        "Nonostante le difficoltà, ha mantenuto un atteggiamento sereno.",
        "Era visibilmente sereno dopo aver risolto tutti i suoi problemi."
      ],
      "nota": "Spesso usato per descrivere uno stato d'animo o una disposizione mentale."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione meteorologica di aria limpida e cielo senza nuvole o fenomeni atmosferici avversi.",
      "examples": [
        "Dopo la tempesta è tornato il sereno.",
        "Godiamoci questo momento di sereno prima che arrivi il maltempo."
      ],
      "nota": "Usato principalmente al singolare. Può indicare il tempo atmosferico in sé, o metaforicamente un periodo di tranquillità."
    }
  ]
