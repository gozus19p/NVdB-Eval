  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di colore opposto al nero, che riflette tutte le radiazioni visibili dello spettro luminoso; tipicamente il colore della neve, del latte o della carta.",
      "examples": [
        "Indossava una camicia bianco puro per la cerimonia.",
        "Le pareti della stanza erano state dipinte di bianco per farla sembrare più grande."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a persona, di etnia caucasica, con pelle chiara.",
      "examples": [
        "Il nuovo collega è un ragazzo alto e bianco, con i capelli biondi.",
        "Le popolazioni bianche originarie dell'Europa si sono diffuse in tutto il mondo."
      ],
      "nota": "L'uso di 'bianco' per riferirsi all'etnia è comune ma può talvolta essere percepito come riduttivo o stereotipato."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un periodo di tempo, caratterizzato da forte freddo e abbondante presenza di neve.",
      "examples": [
        "Ci aspettiamo un Natale bianco quest'anno, con temperature sotto zero.",
        "Le previsioni meteo annunciano un weekend bianco sulle Alpi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il colore che riflette tutte le radiazioni visibili dello spettro luminoso, spesso associato a purezza o pulizia.",
      "examples": [
        "Il bianco è il suo colore preferito per l'arredamento.",
        "In molte culture, il bianco è il simbolo della pace."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Una porzione di un uovo che circonda il tuorlo, trasparente quando cruda e bianca quando cotta, composta principalmente da albumina.",
      "examples": [
        "Per questa ricetta servono solo i bianchi delle uova montati a neve.",
        "Separare il bianco dal tuorlo richiede una certa manualità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Spazio non stampato o vuoto su una pagina o in un documento.",
      "examples": [
        "Lascia un bianco in fondo alla pagina per la firma.",
        "Il testo era interrotto da ampi bianchi per migliorarne la leggibilità."
      ],
      "nota": null
    }
  ]
