  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Comporre e tracciare segni grafici, lettere o simboli su una superficie mediante uno strumento (come una penna, una matita, una tastiera), in modo da formare parole, frasi o testi.",
      "examples": [
        "Ho dovuto scrivere una relazione dettagliata per il mio capo.",
        "I bambini imparano a scrivere il proprio nome già all'asilo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Creare, comporre o redigere un testo letterario, scientifico, giornalistico o di qualsiasi altro genere comunicativo.",
      "examples": [
        "Quella autrice è famosa per scrivere romanzi di fantascienza di grande successo.",
        "Mi ha chiesto di scrivere un articolo sulle nuove tendenze del mercato."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Corrispondere o comunicare con qualcuno per mezzo di testi scritti, inviati per posta, email o messaggistica istantanea.",
      "examples": [
        "Mi scrive spesso per raccontarmi le sue avventure in viaggio.",
        "Non riesce a scrivere per più di un'ora al giorno senza stancarsi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rappresentare graficamente, in genere con linee, segni o immagini, concetti, disegni o schemi.",
      "examples": [
        "Ha dedicato il pomeriggio a scrivere la mappa del tesoro che aveva immaginato.",
        "Il professore ha scritto alla lavagna l'equazione con il gessetto."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Rendersi noto attraverso la pubblicazione di opere letterarie o scientifiche.",
      "examples": [
        "Con il suo ultimo saggio, si è scritto un posto di rilievo tra i filosofi contemporanei.",
        "Dopo aver vissuto una vita avventurosa, ha deciso di scriversi un'autobiografia."
      ],
      "nota": null
    }
  ]
