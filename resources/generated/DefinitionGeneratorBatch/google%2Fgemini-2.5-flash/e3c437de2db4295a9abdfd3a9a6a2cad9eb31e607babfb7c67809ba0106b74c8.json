  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo ai cittadini, alla loro convivenza organizzata e ai diritti e doveri che ne derivano all'interno di uno stato o una comunità.",
      "examples": [
        "Il diritto civile regola i rapporti tra le persone private.",
        "La disobbedienza civile è una forma di protesta non violenta."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce alla sfera non militare, religiosa o ecclesiastica, in contrapposizione ad esse.",
      "examples": [
        "Ha ricevuto un matrimonio civile in comune.",
        "Il servizio civile volontario è un'alternativa alla leva."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che dimostra buone maniere, cortesia e rispetto nelle relazioni interpersonali, agendo in modo educato e conforme alle norme sociali.",
      "examples": [
        "È una persona molto civile, saluta sempre tutti con un sorriso.",
        "Per favore, mantieniti su toni civili durante la discussione."
      ],
      "nota": "Spesso usato per indicare un comportamento adeguato e rispettoso del prossimo."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a costruzioni o opere destinate all'uso quotidiano della popolazione, in contrasto con quelle militari o industriali specifiche.",
      "examples": [
        "L'ingegneria civile si occupa della progettazione di ponti e edifici.",
        "Durante la guerra, molte case civili furono bombardate."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Persona che non appartiene alle forze armate o a corpi militari.",
      "examples": [
        "In tempo di guerra, i civili sono spesso le prime vittime.",
        "Molti civili sono stati evacuati dalla zona di conflitto."
      ],
      "nota": null
    }
  ]
