  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "L'insieme delle attività e delle risorse di un territorio o di una collettività umana, finalizzate alla produzione, distribuzione e consumo di beni e servizi.",
      "examples": [
        "L'economia del paese è basata principalmente sul turismo.",
        "Il governo ha annunciato nuove misure per rilanciare l'economia nazionale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La disciplina che studia come le persone e le società allocano risorse scarse per soddisfare bisogni e desideri illimitati.",
      "examples": [
        "Ho scelto di frequentare la facoltà di economia all'università.",
        "Il premio Nobel per l'economia è stato assegnato a un ricercatore americano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il risparmio nell'uso di qualcosa, la gestione oculata di risorse per evitare sprechi.",
      "examples": [
        "È importante fare economia sui consumi energetici per ridurre le spese.",
        "Ha mostrato grande economia di mezzi nel realizzare il progetto."
      ],
      "nota": "Spesso usato nel contesto di 'fare economia'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il sistema di gestione e organizzazione di qualcosa, specialmente in riferimento a una struttura complessa o a una casa.",
      "examples": [
        "Si occupa dell'economia domestica da quando vive da solo.",
        "L'economia del romanzo è molto ben strutturata, senza parti superflue."
      ],
      "nota": "In questo senso è meno comune nell'uso corrente rispetto agli altri significati."
    }
  ]
