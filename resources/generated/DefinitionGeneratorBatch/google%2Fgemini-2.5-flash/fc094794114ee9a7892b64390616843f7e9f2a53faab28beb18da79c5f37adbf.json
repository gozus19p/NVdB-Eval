  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Parte anatomica che unisce la testa al tronco negli esseri umani e in molti animali.",
      "examples": [
        "Si è storto il collo nell'incidente e ora deve portare il collare ortopedico.",
        "Il cigno ha un collo lungo ed elegante che gli permette di raggiungere il cibo sott'acqua."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Parte ristretta di un oggetto, solitamente allungata, che ne costituisce l'estremità o la giunzione con un'altra parte.",
      "examples": [
        "Ha rotto il collo della bottiglia tentando di aprirla con il coltello.",
        "Il collo del violino è l'elemento che sorregge la tastiera e le corde."
      ],
      "nota": "Si usa comunemente per indicare la parte superiore e più stretta di recipienti come bottiglie, vasi o flaconi."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Elemento di un indumento che avvolge o adorna la parte superiore del busto, intorno al collo.",
      "examples": [
        "La camicia ha un collo alto che si chiude con un bottone.",
        "Il maglione ha un collo a V che mette in risalto la collana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Termine usato nel linguaggio comune per indicare il punto di strozzatura o il tratto più stretto di un passaggio, una valle o un istmo.",
      "examples": [
        "La strada attraversa un colle ripido che viene chiamato il collo di montagna.",
        "Il collo di terra che unisce i due continenti è strategico per i commerci."
      ],
      "nota": "Spesso usato in contesti geografici."
    }
  ]
