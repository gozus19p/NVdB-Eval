  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Affermare qualcosa che non corrisponde alla verità, con l'intento di ingannare o nascondere.",
      "examples": [
        "È sbagliato mentire ai propri genitori, anche per futili motivi.",
        "Il bambino è stato rimproverato per aver mentito sul suo compito di matematica."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Non corrispondere a quanto ci si aspettava o a quanto ci si era prefissati, deludendo le aspettative.",
      "examples": [
        "Le sue promesse hanno mentito; non ha mantenuto nulla di ciò che aveva detto.",
        "Il tempo ha mentito alle previsioni, e ha piovuto tutto il giorno."
      ],
      "nota": "Questo uso è più formale o letterario e si riferisce a situazioni in cui un'aspettativa viene disattesa."
    }
