  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Muovere con un flusso continuo e regolare, tipico di liquidi o fluidi.",
      "examples": [
        "L'acqua del fiume scorreva placidamente verso valle.",
        "Il sangue scorre nelle vene portando ossigeno a tutto il corpo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Spostarsi o passare con continuità e fluidità, specialmente riferito a elementi non liquidi o a sequenze temporali.",
      "examples": [
        "Le immagini scorrevano velocemente sullo schermo.",
        "Il tempo sembrava scorrere senza sosta durante l'attesa.",
        "Il dito scorreva lentamente sulla pagina per seguire la riga."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere in una condizione di fluidità e mancanza di ostacoli nell'avanzamento, specialmente di un processo o di un evento.",
      "examples": [
        "La conversazione scorreva piacevolmente tra i due amici.",
        "La pratica per l'ottenimento del permesso dovrebbe scorrere senza intoppi."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Far passare o far muovere qualcosa su una superficie o attraverso uno spazio.",
      "examples": [
        "Ha scorso lo sguardo su tutti i volti presenti.",
        "Puoi scorrere le tue dita sui tasti del pianoforte per scaldarle."
      ],
      "nota": "Spesso utilizzato con un senso di rapidità o superficialità nel movimento."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Consumarsi o esaurirsi gradualmente nel tempo, specialmente riferito alle energie o alla vita di una persona.",
      "examples": [
        "Era un uomo anziano, la sua vita si era ormai scorso.",
        "Le sue forze si stavano scorrendo dopo la lunga malattia."
      ],
      "nota": "Meno comune nell'uso moderno rispetto ad altre accezioni di 'scorrere'."
    }
  ]
