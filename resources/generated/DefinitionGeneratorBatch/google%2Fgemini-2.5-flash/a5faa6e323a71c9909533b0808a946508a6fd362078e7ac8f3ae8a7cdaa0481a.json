  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Dichiarare, sostenere o garantire con forza che qualcosa è vero o esiste.",
      "examples": [
        "Il testimone ha affermato di aver visto l'incidente chiaramente.",
