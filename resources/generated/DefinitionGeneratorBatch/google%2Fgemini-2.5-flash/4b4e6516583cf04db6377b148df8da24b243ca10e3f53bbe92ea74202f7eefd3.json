  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha accumulato una notevole quantità di tessuto adiposo nel corpo, oltre la norma.",
      "examples": [
        "Quel signore è diventato molto grasso dopo le feste.",
        "Il gatto della vicina è talmente grasso che fatica a muoversi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a un alimento che contiene un'alta percentuale di lipidi o unto.",
      "examples": [
        "Sarebbe meglio evitare cibi troppo grassi per la digestione.",
        "Il formaggio stagionato è solitamente più grasso di quello fresco."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato da una presenza abbondante o eccessiva di una sostanza che conferisce untuosità o densità.",
      "examples": [
        "Il terreno del giardino è troppo grasso per coltivare certe piante.",
        "La vernice grassa ha un tempo di asciugatura più lungo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che indica una condizione di benessere economico, prosperità o abbondanza.",
      "examples": [
        "Quello è stato un periodo grasso per l'azienda, abbiamo fatto molti affari.",
        "Era un uomo d'affari molto grasso che viveva nel lusso più sfrenato."
      ],
      "nota": "Spesso usato in espressioni come 'tempi grassi', 'affari grassi'."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Sostanza organica lipidica presente negli organismi animali o vegetali, utilizzata come riserva energetica o componente strutturale.",
      "examples": [
        "Per dimagrire è importante ridurre l'apporto di grassi nella dieta.",
        "Il grasso corporeo serve anche a proteggere gli organi interni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Materiale lubrificante o untuoso di derivazione minerale o sintetica, impiegato in meccanica o in altre applicazioni industriali.",
      "examples": [
        "È necessario applicare del grasso agli ingranaggi per evitarne l'usura.",
        "Quel meccanismo ha bisogno di un po' di grasso per funzionare correttamente."
      ],
      "nota": null
    }
  ]
