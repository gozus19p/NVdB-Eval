  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Andare o venire fuori da un luogo chiuso o da uno spazio delimitato.",
      "examples": [
        "Sono dovuto uscire di casa presto per prendere il treno.",
        "Il cane è uscito dal giardino attraverso un buco nella rete."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi da una situazione, un ambiente sociale o un gruppo di persone.",
      "examples": [
        "Ha deciso di uscire dall'azienda dopo vent'anni di servizio.",
        "Non riesco a uscire da questa brutta situazione economica."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentarsi al pubblico, essere pubblicato, essere messo in commercio (riferito a prodotti, opere, eventi).",
      "examples": [
        "Il nuovo album del gruppo uscirà il prossimo mese.",
        "Il film è uscito nelle sale cinematografiche giovedì scorso."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Frequentare qualcuno in modo platonico o romantico, avere una relazione.",
      "examples": [
        "Stasera esco con degli amici per una birra.",
        "Hanno cominciato a uscire insieme un mese fa e sembrano molto felici."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere presente o visibile, apparire (riferito a fenomeni, risultati, elementi in un contesto).",
      "examples": [
        "Dal vulcano esce del fumo bianco.",
        "Nell'analisi dei dati sono usciti risultati inaspettati."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Superare un limite, una misura o una norma, andare oltre il previsto.",
      "examples": [
        "Nella sua reazione è uscito dai binari della decenza.",
        "Il progetto è uscito di molto dal budget iniziale."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere origine, provenire da qualcosa o qualcuno.",
      "examples": [
        "Questo prodotto esce da una piccola azienda artigianale.",
        "Spesso le sue idee migliori escono da conversazioni informali."
      ],
      "nota": null
