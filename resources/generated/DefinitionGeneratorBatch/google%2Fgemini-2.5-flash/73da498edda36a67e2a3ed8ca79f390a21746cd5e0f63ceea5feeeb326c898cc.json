  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che è spiacevole alla vista o al tatto, privo di armonia o grazia estetica.",
      "examples": [
        "Quel quadro è davvero brutto, non mi piace per niente.",
        "Ha comprato un divano brutto che stona con l'arredamento."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è sgradevole o fastidioso, che causa disagio o malumore.",
      "examples": [
        "Abbiamo passato un brutto quarto d'ora a causa del traffico.",
        "Mi ha raccontato una brutta storia che mi ha lasciato l'amaro in bocca."
      ],
      "nota": "Spesso usato in riferimento a esperienze, situazioni o notizie."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è di pessima qualità o fattura, mal riuscito, scadente.",
      "examples": [
        "Il film era brutto, siamo usciti prima della fine.",
        "Ha fatto proprio un brutto lavoro, dovrò rifarlo da capo."
      ],
      "nota": "Si riferisce spesso al risultato di un'azione o alla qualità di un prodotto."
    },
    {
      "pos": "aggettivo",
      "definition": "Che è moralmente riprovevole, malvagio o ingiusto.",
      "examples": [
        "È stato un brutto gesto quello di tradire la fiducia dell'amico.",
        "Non parlare in quel modo, è una brutta cosa da dire."
      ],
      "nota": "Indica un giudizio etico o morale."
    },
    {
      "pos": "avverbio",
      "definition": "In modo cattivo, male; in modo sgradevole o dannoso.",
      "examples": [
        "Oggi va tutto brutto, non ne va una giusta.",
        "Si è comportato brutto con me, sono molto deluso."
      ],
      "nota": "Uso colloquiale, spesso con il verbo 'andare' o 'stare' o 'fare'."
    }
  ]
