  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova o ha un'altezza modesta rispetto a un punto di riferimento o alla media generale; poco elevato.",
      "examples": [
        "L'aereo volava molto basso, sfiorando le cime degli alberi.",
        "Ha comprato un tavolo basso per il soggiorno, ideale davanti al divano."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che ha un valore o un'intensità ridotti; di scarsa qualità o livello.",
      "examples": [
        "Il prezzo della benzina è rimasto basso per tutta la settimana.",
        "Le sue aspettative sul risultato erano piuttosto basse date le premesse."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a un suono o una voce grave, di frequenza vibratoria contenuta.",
      "examples": [
        "Il contrabbasso produce un suono profondo e molto basso.",
        "La sua voce era insolitamente bassa quella mattina, quasi un sussurro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a persona, che non ha dignità o che è malvagio e vile.",
      "examples": [
        "Il suo comportamento è stato veramente basso e inammissibile.",
        "Non mi aspettavo un gesto così basso da parte sua."
      ],
      "nota": "Uso figurato."
    },
    {
      "pos": "avverbio",
      "definition": "A una quota o altezza ridotta; vicino al suolo o ad un livello inferiore.",
      "examples": [
        "Parla più basso, altrimenti ci sentiranno tutti.",
        "L'uccello volava basso sul lago per pescare."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Strumento musicale a corda grave (spesso sinonimo di contrabbasso) o, per estensione, chitarra basso elettrica.",
      "examples": [
        "Marco suona il basso in una band jazz.",
        "Il suo basso ha un suono potente e ben definito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Voce maschile più grave nel canto.",
      "examples": [
        "Il coro cercava un basso per completare la sezione maschile.",
        "Ha una voce da basso profonda e risonante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il piano terreno di un edificio; ambiente situato a livello della strada o poco al di sotto.",
      "examples": [
        "Abitano nel basso del palazzo, vicino all'ingresso.",
        "Hanno adibito il basso a garage e magazzino."
      ],
      "nota": null
    }
  ]
}