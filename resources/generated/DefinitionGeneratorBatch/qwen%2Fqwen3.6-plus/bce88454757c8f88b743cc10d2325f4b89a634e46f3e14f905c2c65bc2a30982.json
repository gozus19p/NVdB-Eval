  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che richiede notevole impegno, capacità o fatica per essere compiuto, compreso o superato.",
      "examples": [
        "Questo capitolo di fisica è davvero difficile da comprendere senza le basi necessarie.",
        "Risolvere i problemi logistici in tempi brevi è un compito molto complesso per il nuovo team."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che presenta scarse probabilità di realizzarsi o di verificarsi.",
      "examples": [
        "Con tutti questi impegni lavorativi è improbabile che riusciamo a vederci prima della fine del mese.",
        "Considerata la prolungata siccità, le riserve idriche torneranno ai livelli normali solo con piogge abbondanti."
      ],
      "nota": "Si usa frequentemente in costruzioni impersonali seguite da un verbo al congiuntivo introdotto da 'che' (es. 'è difficile che accada') o da un infinito (es. 'difficile da realizzare')."
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a persona o indole: poco accomodante, irritabile o complicato da gestire nelle relazioni interpersonali.",
      "examples": [
        "Da quando è entrato nell'adolescenza, mio figlio è diventato complicato e raramente accetta suggerimenti.",
        "Il nuovo responsabile ha un temperamento rigido e fatica a creare un clima collaborativo in ufficio."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a circostanza, condizione o fase di vita: marcato da disagi, ristrettezze economiche o tensione sociale.",
      "examples": [
        "Dopo la chiusura dell'unica fabbrica del paese, le famiglie stanno attraversando un periodo di ristrettezze generalizzate.",
        "Le nuove normative fiscali hanno creato una congiuntura economica delicata per le piccole imprese artigiane."
      ],
      "nota": null
    }
  ]
