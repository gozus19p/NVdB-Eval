  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Ampia estensione di terreno caratterizzata da una copertura densa di alberi e vegetazione arbustiva, che forma un ecosistema complesso e spesso chiuso.",
      "examples": [
        "Durante il fine settimana molte famiglie preferiscono fare una passeggiata nel bosco per allontanarsi dal caos cittadino.",
        "Il guardaparco ha ricordato che è vietato accendere fuochi all'interno del bosco per prevenire gli incendi estivi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Configurazione fitta e intricata di elementi verticali o allungati, disposti in prossimità tra loro in modo tale da creare un effetto visivo di densità e disordine.",
      "examples": [
        "Il panorama della nuova periferia è dominato da un impressionante bosco di torri di vetro e cemento.",
        "Ristrutturare il vecchio appartamento ha significato districarsi in un bosco di cavi elettrici e tubature obsolete."
      ],
      "nota": "Ocurrenza frequente nel linguaggio giornalistico e nella prosa descrittiva, utilizzata per trasmettere un'impressione di sovrabbondanza o ingombro visivo di natura artificiale."
    }
  ]
