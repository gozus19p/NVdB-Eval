  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Emettere una decisione ufficiale in sede processuale dopo l'esame delle prove e delle argomentazioni delle parti.",
      "examples": [
        "Il tribunale dovrà giudicare il caso entro la fine del mese.",
        "I magistrati hanno giudicato gli imputati colpevoli di tutti i reati."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Valutare i pregi e i difetti di una persona, un comportamento o un'opera, elaborando un parere critico.",
      "examples": [
        "Non spetta a te giudicare le scelte di vita di tuo fratello.",
        "La critica specializzata ha giudicato positivamente l'ultima raccolta letteraria dell'autrice."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ritenere, considerare vero, opportuno o caratterizzato da determinate qualità un fatto, una persona o una situazione.",
      "examples": [
        "Giudico indispensabile un intervento immediato sulla rete idrica comunale.",
        "Il direttivo ha giudicato la proposta economicamente vantaggiosa."
      ],
      "nota": "Costruito prevalentemente con un complemento predicativo dell'oggetto o con una frase infinitiva priva di preposizione."
    }
