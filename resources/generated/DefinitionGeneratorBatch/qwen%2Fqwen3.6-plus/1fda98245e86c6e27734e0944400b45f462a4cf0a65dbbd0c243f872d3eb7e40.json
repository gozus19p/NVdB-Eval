  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Condizione sociale e giuridica in cui una persona o una collettività non è soggetta a dominazione, incarcerazione o divieti ingiustificati, e può esercitare i propri diritti fondamentali.",
      "examples": [
        "La Costituzione italiana garantisce la libertà di stampa e di assemblea.",
        "Molti trattati internazionali sanciscono la libertà di movimento tra i paesi firmatari."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Capacità di un individuo di operare scelte, esprimere pensieri e compiere azioni in base alle proprie inclinazioni, senza essere vincolato da imposizioni esterne o condizionamenti psicologici.",
      "examples": [
        "Il lavoro da remoto garantisce ai dipendenti la possibilità di organizzare le proprie giornate senza vincoli fissi.",
        "Dopo anni di routine, ha deciso di trasferirsi in provincia per vivere con maggiore autonomia e ritmi più tranquilli."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Atteggiamento di confidenza non richiesta o di mancanza di rispetto verso il prossimo, che supera i limiti della buona educazione o del ruolo sociale.",
      "examples": [
        "Non accetto che un estraneo si prenda la possibilità di entrare in ufficio senza appuntamento.",
        "In famiglia non tolleriamo che gli ospiti si prendano certe ingerenze nella vita privata dei nostri figli."
      ],
      "nota": "Impiegato prevalentemente in contesti interpersonali, spesso in costruzioni come 'prendersi la libertà di' o 'darsi troppe confidenze', con sfumatura pragmatica di fastidio o disapprovazione."
    }
  ]
