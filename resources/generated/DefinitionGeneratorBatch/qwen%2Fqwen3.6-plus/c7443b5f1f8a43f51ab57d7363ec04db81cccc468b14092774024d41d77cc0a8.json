  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Conferire a una persona un incarico lavorativo retribuito, inserendola stabilmente nell'organico di un'azienda o ente.",
      "examples": [
        "La multinazionale prevede di assumere oltre duecento figure tecniche nei prossimi mesi.",
        "Non appena laureato, è stato assunto come ricercatore presso un'università tedesca."
      ],
      "nota": "Uso dominante in ambito economico, aziendale e del diritto del lavoro."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Introdurre nell'organismo alimenti, bevande, farmaci o altre sostanze, generalmente per via orale o secondo prescrizioni mediche.",
      "examples": [
        "È fondamentale non assumere bevande alcoliche nelle ore che precedono la guida.",
        "Il foglietto illustrativo specifica di assumere le gocve con abbondante acqua lontano dai pasti."
      ],
      "nota": "Frequente in contesti clinici, farmacologici e di educazione alimentare; il complemento oggetto indica tipicamente la sostanza ingerita."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Far propria o manifestare in modo progressivo una determinata configurazione fisica, un atteggiamento, una funzione o un valore simbolico.",
      "examples": [
        "L'edificio ha assunto una fisionomia molto più moderna dopo la ristrutturazione.",
        "Con il diffondersi dei social network, l'informazione ha assunto ritmi e caratteristiche completamente diversi."
      ],
      "nota": "Si combina prevalentemente con complementi oggetto astratti (carica, aspetto, rilievo, significato, atteggiamento, dimensioni)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Accettare come punto di partenza una proposizione, un dato o una condizione, senza necessariamente dimostrarne la veridicità, per condurre un ragionamento, un calcolo o un modello teorico.",
      "examples": [
        "Per semplificare l'equazione del moto, i fisici assumono l'assenza di resistenza dell'aria.",
        "Nel suo saggio il filosofo assume che la libertà individuale rappresenti un valore assoluto."
      ],
      "nota": "Tipico del linguaggio scientifico, matematico e umanistico; implica un'accettazione funzionale e provvisoria ai fini della dimostrazione o dell'analisi."
    }
  ]
