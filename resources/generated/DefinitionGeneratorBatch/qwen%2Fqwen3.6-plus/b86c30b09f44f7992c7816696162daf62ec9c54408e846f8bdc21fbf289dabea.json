  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Indirizzare, volgere o orientare un oggetto, uno sguardo o un'azione verso un punto o una direzione specifici.",
      "examples": [
        "Per evitare l'ingorgo, l'autista ha diretto il veicolo verso la tangenziale.",
        "Durante la conferenza, il relatore ha saputo dirigere l'attenzione del pubblico sui dati più recenti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Guidare, sovraintendere e coordinare il funzionamento di un'organizzazione, di un gruppo di persone o di un'opera artistica o professionale.",
      "examples": [
        "Dopo anni di esperienza nel settore, è stata chiamata a dirigere il reparto marketing internazionale.",
        "Il compositore ha diretto la prima esecuzione del suo sinfonico con grande rigore espressivo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo pronominale",
      "definition": "Muoversi o avviarsi spontaneamente verso una determinata meta o direzione.",
      "examples": [
        "Appena scesi dalla nave, i passeggeri si sono diretti subito verso il terminal partenze.",
        "Il temporale si sta dirigendo verso la costa tirrenica e potrebbe causare forti rovesci."
      ],
      "nota": "La forma pronominale è lessicalizzata e rappresenta l'accezione più frequente per indicare il movimento del soggetto verso un luogo; richiede l'ausiliare 'essere' nei tempi composti."
    }
  ]
