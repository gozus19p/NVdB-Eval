  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Potere o diritto legittimo di comandare, prendere decisioni vincolanti o esercitare il controllo, attribuito a una carica pubblica o a un'istituzione.",
      "examples": [
        "Il provvedimento è stato adottato in virtù dell'autorità conferita dalla normativa vigente.",
        "Durante la crisi, il comandante ha esercitato la propria autorità per mantenere la disciplina."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Persona, organo o ente investito di poteri pubblici o di funzioni di vigilanza, regolamentazione e comando.",
      "examples": [
        "Le autorità locali hanno predisposto un piano straordinario per gestire l'afflusso turistico.",
        "L'azienda ha presentato ricorso all'autorità competente entro i termini previsti dalla legge."
      ],
      "nota": "Si usa prevalentemente al plurale quando si fa riferimento in modo generale agli organi di governo, controllo o sicurezza."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Riconoscimento sociale o scientifico della superiore competenza di un soggetto in un determinato settore, che conferisce credibilità e forza persuasiva alle sue affermazioni o opere.",
      "examples": [
        "Lo studioso è considerato un'autorità riconosciuta a livello internazionale nel campo della linguistica storica.",
        "I giuristi citano spesso la sua pubblicazione poiché è diventata un'autorità in materia di diritto commerciale."
      ],
      "nota": null
    }
