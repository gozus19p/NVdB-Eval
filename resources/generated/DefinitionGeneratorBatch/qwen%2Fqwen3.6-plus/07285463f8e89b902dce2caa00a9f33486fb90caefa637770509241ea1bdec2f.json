  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Parte anatomica superiore del corpo umano o animale, collegata al tronco dal collo e contenente l'encefalo, gli organi di senso e le strutture masticatorie.",
      "examples": [
        "Dopo una giornata molto faticosa, si è seduta sul divano e ha appoggiato la testa sui cuscini.",
        "Il veterinario ha visitato l'animale controllando attentamente la parte superiore del corpo per escludere traumi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Insieme delle facoltà cognitive, della capacità di ragionamento e dell'equilibrio psichico considerati come strumenti di giudizio e decisione.",
      "examples": [
        "Devi usare la testa prima di firmare un contratto così vincolante e irreversibile.",
        "Lo spavento improvviso gli ha annebbiato le idee, facendogli perdere temporaneamente la lucidità necessaria per reagire."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Porzione anteriore, superiore o terminale di un oggetto, di un veicolo o di una struttura, oppure posizione di guida all'interno di un gruppo o di una fila.",
      "examples": [
        "La parte frontale del chiodo si è piegata dopo essere stata colpita ripetutamente dal martello.",
        "Durante la sfilata, il portabandiera ha guidato il corteo posizionandosi all'estremità anteriore del gruppo."
      ],
      "nota": "In ambiti specialistici (nautico, ferroviario) si preferiscono termini come 'prua' o 'motrice', ma questa accezione rimane di uso ampio nel linguaggio comune."
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Lato di una moneta o medaglia che reca l'effigie di un volto, tradizionalmente contrapposto al retro.",
      "examples": [
        "Per decidere chi inizia il gioco, hanno lanciato una monetina scommettendo sull'uscita della faccia con il ritratto.",
        "Il numismatico ha esaminato attentamente il lato raffigurante il profilo per valutarne il grado di conservazione."
      ],
      "nota": null
    }
  ]
