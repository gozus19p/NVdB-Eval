  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "periodo di luce naturale tra l'alba e il tramonto, in contrapposizione alla notte",
      "examples": [
        "D'estate il giorno è molto lungo e le temperature restano elevate fino a sera.",
        "Preferiamo fare escursioni durante il giorno per evitare il buio e il freddo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "intervallo di ventiquattr'ore che costituisce l'unità base del calendario civile, calcolato da mezzanotte a mezzanotte",
      "examples": [
        "Ogni giorno mi alzo alle sette per andare in ufficio.",
        "Il progetto deve essere completato entro tre giorni lavorativi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "data determinata o ricorrenza particolare, spesso associata a eventi personali, storici o celebrazioni",
      "examples": [
        "Il giorno del matrimonio è stato segnato da una pioggia improvvisa.",
        "Ricordati di restituire il libro entro il giorno pattuito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "fase, periodo o condizione della vita di una persona o dell'esistenza di un'entità, intesa come successione di eventi o stati d'animo",
      "examples": [
        "Nei suoi giorni più felici non riusciva a immaginare che le cose sarebbero cambiate.",
        "Quella azienda ha conosciuto giorni di grande prosperità prima della crisi."
      ],
      "nota": "Uso figurato ma comune nell'italiano contemporaneo, specialmente in contesti narrativi o riflessivi."
    }
