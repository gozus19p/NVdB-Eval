  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Istituzione pubblica o privata che raccoglie, conserva, studia ed espone al pubblico collezioni di opere d'arte, reperti storici, scientifici o naturali a scopo culturale, educativo o di ricerca.",
      "examples": [
        "Domenica andremo al museo di arte contemporanea con la scuola.",
        "Il museo archeologico della città ospita una collezione unica di reperti etruschi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Luogo, ambiente o realtà considerati statici, antiquati o eccessivamente conservatori, in cui si percepisce una marcata resistenza al cambiamento e all’innovazione.",
      "examples": [
        "Quella piccola azienda è diventata un museo, continuano a usare le stesse procedure degli anni Novanta.",
        "Con tutte le sue vecchie tradizioni e l'assenza di iniziative nuove, il paese sembra un museo vivente."
      ],
      "nota": "Utilizzato prevalentemente in senso spregiativo o ironico per sottolineare un'eccessiva fossilizzazione."
    }
  ]
