  "senses": [
    {
      "pos": "aggettivo / sostantivo (m.)",
      "definition": "Condizione ambientale caratterizzata dall'assenza o dalla forte riduzione di illuminazione naturale o artificiale.",
      "examples": [
        "A causa del guasto in centrale, l'intero quartiere è rimasto al buio per diverse ore.",
        "Ha abbassato le tapparelle per creare il buio necessario prima della proiezione."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Attribuito a un colore che presenta una tonalità intensa e poco luminosa, vicina al nero.",
      "examples": [
        "Per la cena elegante ha indossato un abito di lana blu buio.",
        "Le piastrelle della cucina sono state posate in un verde buio che nasconde bene i segni d'uso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo / sostantivo (m.)",
      "definition": "Condizione intellettuale, emotiva o situazionale di incertezza, mancanza di informazioni chiare o assenza di prospettive rassicuranti.",
      "examples": [
        "Senza il manuale tecnico, gli ingegneri sono rimasti al buio sulla procedura di avviamento.",
        "Dopo la chiusura dell'attività, il proprietario ha attraversato un periodo personale molto buio."
      ],
      "nota": "In uso figurato, ricorre prevalentemente in costruzioni predicative o in sintagmi preposizionali che indicano stato di ignoranza o preoccupazione."
    }
  ]
