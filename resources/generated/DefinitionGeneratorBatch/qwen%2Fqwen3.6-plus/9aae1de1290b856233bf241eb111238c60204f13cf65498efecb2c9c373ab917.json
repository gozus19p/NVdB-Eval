  "senses": [
    {
      "pos": "aggettivo qualificativo",
      "definition": "Che si verifica o si manifesta con intervalli di tempo molto ampi; poco frequente.",
      "examples": [
        "In questa zona costiera le burrasche autunnali sono sempre più rare.",
        "Le occasioni di incontro tra i due gruppi familiari sono ormai estremamente rare."
      ],
      "nota": "Si riferisce tipicamente a eventi, fenomeni o situazioni soggette alla dimensione temporale."
    },
    {
      "pos": "aggettivo qualificativo",
      "definition": "Presente in numero o quantità limitata; difficile da reperire in natura o sul mercato.",
      "examples": [
        "I reperti di quell'epoca sono considerati molto rari e hanno un alto valore commerciale.",
        "La flora alpina di queste specie è diventata rara a causa dei cambiamenti climatici."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo qualificativo",
      "definition": "Di gas, fluido o atmosfera caratterizzato da una bassa concentrazione di particelle e da consistenza poco compatta.",
      "examples": [
        "Salendo di quota l'aria si fa progressivamente più rara, rendendo necessario l'uso di bombole.",
        "Nelle zone desertiche l'umidità atmosferica è così rara da non lasciare tracce di condensa."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo qualificativo",
      "definition": "Di persona, qualità o situazione che si discosta nettamente dalla norma, risultando insolita, straordinaria o sorprendente.",
      "examples": [
        "Possiede una pazienza rara nel gestire clienti difficili senza mai alzare la voce.",
        "È davvero raro trovare un professionista così puntuale e preciso nel proprio lavoro."
      ],
      "nota": "Accezione figurata e valutativa, spesso usata con sfumature enfatiche, ironiche o di lode."
