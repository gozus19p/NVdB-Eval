  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce al cielo o al tempo atmosferico privo di nuvole, foschia o precipitazioni.",
      "examples": [
        "Domani il cielo dovrebbe essere completamente sereno, perfetto per una gita in montagna.",
        "Dopo tre giorni di pioggia intensa, finalmente è tornato un tempo sereno."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a persona, atteggiamento o contesto, che è tranquillo, pacato e privo di preoccupazioni, tensioni o conflitti.",
      "examples": [
        "Nonostante le difficoltà, Maria affronta il nuovo lavoro con un animo sereno.",
        "Vorrei che i miei figli crescessero in un ambiente familiare sereno e stimolante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Condizione meteorologica caratterizzata da cielo limpido, visibilità ottimale e assenza di piogge o venti forti.",
      "examples": [
        "Le previsioni indicano un graduale miglioramento con ritorno al sereno già da domani mattina.",
        "Il sereno attuale non durerà a lungo, perché sta arrivando un fronte perturbato da ovest."
      ],
      "nota": "Termine tecnico e giornalistico proprio dei bollettini meteo, spesso usato nelle costruzioni 'bel sereno' o 'ritorno al sereno'."
    }
  ]
