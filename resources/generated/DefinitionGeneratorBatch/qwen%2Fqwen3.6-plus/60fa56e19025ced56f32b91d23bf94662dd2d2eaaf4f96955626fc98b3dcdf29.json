  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che esiste o viene considerato da solo all'interno di una categoria o di un contesto specifico, senza altri elementi dello stesso tipo.",
      "examples": [
        "Tra tutti i partecipanti, è l'unico ad aver completato la maratona senza assistenza.",
        "Abbiamo analizzato ogni documento disponibile, ma il solo utile ai fini della ricerca era quello archiviato nell'ultimo archivio."
      ],
      "nota": "Spesso sostantivato ('l'unico', 'l'unica') per riferirsi direttamente alla persona o alla cosa in questione; mantiene valenza neutra e quantitativa."
    },
    {
      "pos": "aggettivo",
      "definition": "Dotato di caratteristiche, pregi o qualità così spiccati e rari da non trovare riscontro o paragone in altri elementi della categoria di riferimento.",
      "examples": [
        "La mostra espone sculture contemporanee caratterizzate da uno stile assolutamente particolare e privo di imitatori.",
        "Grazie alla sua formazione trasversale, ha sviluppato un approccio originale alla risoluzione dei problemi aziendali che lo distingue dai colleghi."
      ],
      "nota": "Presenta forte connotazione positiva ed enfatizzante; in contesti promozionali o turistici può subire un processo di svalutazione semantica per abuso retorico."
