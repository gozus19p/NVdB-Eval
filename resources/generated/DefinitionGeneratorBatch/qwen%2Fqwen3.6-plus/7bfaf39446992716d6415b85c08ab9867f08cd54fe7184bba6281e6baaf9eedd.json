  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha relazione con l'aria o l'atmosfera terrestre, o che si svolge al loro interno.",
      "examples": [
        "Il traffico aereo sopra la regione è stato sospeso per motivi di sicurezza.",
        "La merce è stata spedita con corriere prioritario aereo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di aspetto, movimento o suono estremamente leggero, delicato e privo di peso apparente.",
      "examples": [
        "La coreografa ha costruito lo spettacolo su sequenze leggere e fluttuanti.",
        "Nel registro acuto il flauto produce un timbro etereo che aleggia nell'ambiente."
      ],
      "nota": "Impiego frequente in contesti artistici, letterari o descrittivi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Veicolo motorizzato dotato di ali fisse, più pesante dell'aria, progettato per il volo e il trasporto di persone o merci.",
