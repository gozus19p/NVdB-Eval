  "senses": [
    {
      "pos": "transitivo",
      "definition": "Sottrarre a qualcuno un bene o del denaro mediante azione fraudolenta o approfittando di una circostanza favorevole.",
      "examples": [
        "Durante la confusione in metropolitana gli hanno fregato il portafoglio.",
        "Quella piattaforma ti frega i dati personali non appena accetti le condizioni."
      ],
      "nota": "Uso colloquiale molto frequente nell'italiano parlato contemporaneo."
    },
    {
      "pos": "transitivo",
      "definition": "Ingannare o danneggiare deliberatamente qualcuno, spesso in ambito commerciale o contrattuale, facendogli credere il falso o sfruttandone la fiducia.",
      "examples": [
        "Il meccanico mi ha fregato sostituendo il pezzo originale con uno di scarsa qualità.",
        "Si è reso conto troppo tardi di essere stato fregato dai soci in affari."
      ],
      "nota": null
    },
    {
      "pos": "intransitivo pronominale",
      "definition": "Costituire motivo di interesse, preoccupazione o importanza per una persona; utilizzato quasi esclusivamente in forme negative o interrogative per esprimere distacco o indifferenza verso un tema o una persona.",
      "examples": [
        "Non me ne frega assolutamente nulla di chi avrà vinto la gara.",
        "Che te ne frega se ho deciso di partire domani?"
      ],
      "nota": "Nella variante pronominale è tipicamente seguito dalla preposizione 'di' (fregarsene di qualcosa/qualcuno). La forma impersonale 'non frega (niente/nulla)' è altrettanto diffusa."
    },
    {
      "pos": "transitivo",
      "definition": "Strofinare con insistenza una superficie per pulirla, asciugarla o rimuovere residui o sostanze.",
      "examples": [
        "Prima di verniciare il mobile devi fregare bene il legno per togliere la vecchia polvere.",
        "Dopo la passeggiata nella neve si è fregato le mani contro il maglione per riscaldarle."
      ],
      "nota": "Registro informale; in contesti più formali o tecnici si preferiscono i verbi 'strofinare', 'sfregare' o 'pulire'."
    }
  ]
