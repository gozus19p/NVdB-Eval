  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Capacità fisica o mentale di agire, resistere a fatica o dolore, e di compiere azioni impegnative o prolungate.",
      "examples": [
        "Dopo l'infortunio, sta recuperando gradualmente la forza necessaria per camminare senza assistenza.",
        "Non aveva più la forza di reagire alle continue provocazioni dei colleghi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Intensità o energia con cui si manifesta un fenomeno naturale, un'azione, un evento o un'emozione.",
      "examples": [
        "Il vento soffiava con una forza tale da sradicare gli alberi più giovani.",
        "L'emozione lo travolse con un'intensità inaspettata, lasciandolo senza parole."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Uso della violenza o della costrizione fisica o psicologica per imporre la propria volontà o ottenere qualcosa contro l'altrui adesione.",
      "examples": [
        "I ladri sono entrati nell'appartamento sfondando la porta con la violenza.",
        "Non si può imporre una decisione condivisa ricorrendo alla coercizione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di persone organizzate e impiegate collettivamente in un determinato ambito operativo, istituzionale o produttivo.",
      "examples": [
        "Le forze dell'ordine hanno istituito posti di blocco lungo l'autostrada.",
        "L'azienda ha deciso di potenziare la forza lavoro per affrontare il picco di ordinazioni natalizie."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "In fisica, grandezza vettoriale che, applicata a un corpo, ne modifica lo stato di quiete o di moto, oppure ne provoca la deformazione.",
      "examples": [
        "La gravità è responsabile del mantenimento delle orbite planetarie attorno al Sole.",
        "Per calcolare l'accelerazione del proiettile, devi considerare tutte le grandezze agenti su di esso."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Efficacia, validità o potere vincolante di una norma, un accordo o un provvedimento giuridico.",
      "examples": [
        "Il nuovo codice della strada entrerà in vigore il primo luglio del prossimo anno.",
        "Quella direttiva europea ha piena validità normativa in tutti gli Stati membri."
      ],
      "nota": "Frequentemente riscontrata nelle locuzioni 'entrare in vigore' e 'avere validità di legge'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Espressione di incitamento a procedere, reagire o non arrendersi di fronte a un ostacolo o una difficoltà.",
      "examples": [
        "Coraggio, manca solo un ultimo sforzo e avremo concluso il lavoro in tempo.",
        "Su ragazzi, la partita è ancora aperta e potete assolutamente recuperare."
      ],
      "nota": "Usato prevalentemente in contesti pragmatici come esortazione diretta, spesso in posizione isolata o iniziale."
    }
  ]
