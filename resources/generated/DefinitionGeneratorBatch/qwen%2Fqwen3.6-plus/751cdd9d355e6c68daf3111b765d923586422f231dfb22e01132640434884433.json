  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Manovrare i comandi di un mezzo di trasporto per controllarne il movimento e la direzione.",
      "examples": [
        "Ha ottenuto la patente e ora può guidare l'automobile da solo.",
        "Durante il viaggio di ritorno ho preferito mettermi io al volante per far riposare mio marito."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Dirigere, coordinare o amministrare un gruppo di persone, un'organizzazione o un'attività verso un determinato obiettivo.",
      "examples": [
        "Il nuovo presidente del consiglio ha saputo guidare il paese attraverso una fase di profonda crisi economica.",
        "Spetta all'insegnante guidare gli studenti durante il lavoro di gruppo e garantire il rispetto dei ruoli."
      ],
      "nota": "Frequente in contesti professionali, educativi e istituzionali per indicare leadership o responsabilità manageriale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Influenzare, determinare o ispirare il comportamento e le scelte di qualcuno, agendo come principio motivante o riferimento fondamentale.",
      "examples": [
        "Non farti guidare dalla fretta quando devi firmare un contratto importante.",
        "È la curiosità che l'ha sempre spinta a esplorare nuove discipline scientifiche."
      ],
      "nota": "L'uso figurato è tipicamente retto da soggetti astratti (es. valori, istinti, ragionamento, esempi) e si applica a percorsi decisionali o esistenziali."
    }
