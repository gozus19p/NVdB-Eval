  "senses": [
    {
      "pos": "avverbio (registro colloquiale, usato in frasi negative o come smentita implicita)",
      "definition": "Particella negativa che rafforza un enunciato negato o introduce una contrapposizione, con valore di 'per niente', 'affatto' o 'non è affatto così'.",
      "examples": [
        "Non ho mica voglia di uscire con questo temporale.",
        "Pensavi che avessi già risolto il problema? Mica affatto, devo ancora fare diversi tentativi."
      ],
      "nota": "Nell'italiano contemporaneo compare frequentemente sia in posizione postverbale (spesso in combinazione con 'non') sia in posizione iniziale per negare un'aspettativa o un'affermazione precedente; in contesti ellittici può assumere sfumatura ironica o approvativa (es. 'Mica male!')."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Minerale silicatico caratterizzato da struttura cristallina lamellare e facile sfaldatura, ampiamente sfruttato in edilizia e nell'industria dei materiali isolanti e decorativi.",
      "examples": [
        "Le cave della Val d'Ossola estraggono grandi quantità di mica di ottima qualità.",
        "L'artigiano ha mescolato polvere di mica alla vernice per ottenere un riflesso metallizzato."
      ],
      "nota": null
    }
  ]
