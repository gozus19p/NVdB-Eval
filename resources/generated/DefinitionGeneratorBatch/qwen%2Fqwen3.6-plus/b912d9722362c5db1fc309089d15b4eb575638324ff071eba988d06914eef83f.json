  "senses": [
    {
      "pos": "aggettivo numerale invariabile",
      "definition": "Indica una quantità esatta pari a dieci decine o a novantanove più uno.",
      "examples": [
        "La nuova collana del marchio comprende esattamente cento capi.",
        "Per iscriverti al corso devi versare un acconto di cento euro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale invariabile",
      "definition": "Utilizzato in senso iperbolico o approssimativo per indicare un numero molto elevato e indefinito di elementi o occasioni.",
      "examples": [
        "Ho provato in cento modi diversi a riparare la stampante senza successo.",
        "Te l'ho già ripetuto cento volte, controlla sempre le fonti prima di citarle."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "La cifra o il segno grafico che rappresenta quella quantità; in ambito scolastico e concorsuale indica il punteggio massimo ottenibile in una valutazione.",
      "examples": [
        "Sul display della cassa lampeggiava chiaramente il cento dopo l'ultimo sconto.",
        "Tutta la classe ha esultato quando il professore ha assegnato il primo cento dell'anno."
      ],
      "nota": "Nell'uso scolastico è frequentemente associato a 'lode' per segnalare una performance eccellente oltre la soglia standard."
