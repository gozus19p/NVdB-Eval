  "senses": [
    {
      "pos": "aggettivo numerale",
      "definition": "Quantità esatta pari a quattro più uno, collocata immediatamente dopo il quattro e prima del sei.",
      "examples": [
        "Per completare la ricetta occorrono cinque uova fresche.",
        "La squadra ha segnato cinque gol nella partita di andata."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo numerale",
      "definition": "Indica un numero ridotto e non precisato di elementi, persone o unità di misura; assume valore di qualche o alcuni.",
      "examples": [
        "Aspettami cinque minuti, arrivo subito con le chiavi.",
        "Ne ho visti cinque o sei, ma nessuno era adatto alle mie esigenze."
      ],
      "nota": "Utilizzato frequentemente in registri colloquiali per esprimere approssimazione o enfasi pragmatica su una quantità percepita come contenuta."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Valutazione scolastica che attesta un rendimento nettamente inferiore alla soglia minima di accettabilità didattica.",
      "examples": [
        "All'interrogazione di storia ho preso cinque e dovrò recuperare l'insufficienza.",
        "La media dell'ultimo trimestre è stata abbassata da un cinque in matematica."
      ],
      "nota": "Termine consolidato nel sistema di valutazione italiano, in scala numerica da uno a dieci, dove rappresenta il gradino immediatamente precedente la sufficienza."
    }
