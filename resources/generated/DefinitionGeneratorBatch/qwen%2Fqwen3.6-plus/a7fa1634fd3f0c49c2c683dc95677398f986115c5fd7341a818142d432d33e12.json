  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Locale di un'abitazione o di un edificio pubblico dotato di impianti idrico-sanitari, destinato all'igiene personale e ai bisogni fisiologici.",
      "examples": [
        "Ho dimenticato le chiavi sul mobile del bagno.",
        "Il bagno dell'hotel ha il riscaldamento a pavimento e una doccia a getto di pioggia."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Azione di lavare il proprio corpo o di immergersi completamente nell'acqua per igiene, svago o sollievo fisico.",
      "examples": [
        "Dopo la lunga escursione, un bagno caldo ti aiuterà a rilassare i muscoli.",
        "Fa sempre il bagno la sera prima di andare a dormire."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Stabilimento commerciale situato in prossimità del mare, di un lago o di una piscina, attrezzato con servizi per la balneazione e l'esposizione solare.",
      "examples": [
        "Il bagno privato offre un servizio navetta e lettini ombreggiati.",
        "Abbiamo trascorso la domenica al bagno con i bambini, alternando nuoto e lettura."
      ],
      "nota": "Termine di uso frequente nel linguaggio turistico e colloquiale per indicare lo stabilimento balneare."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Contenitore o vasca riempita con acqua o altro liquido, in cui si immerge un oggetto o un alimento per sottoporlo a un trattamento termico, di pulitura o chimico.",
      "examples": [
        "Per trattare il legno, immergilo nel bagno di olio protettivo per qualche ora.",
        "Il restauratore ha lasciato il reperto in un bagno di soluzioni specifiche per rimuoverne la patina ossidata."
      ],
      "nota": null
    }
  ]
