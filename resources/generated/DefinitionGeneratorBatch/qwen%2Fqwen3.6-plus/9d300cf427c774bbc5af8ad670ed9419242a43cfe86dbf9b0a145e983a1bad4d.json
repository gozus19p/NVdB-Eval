  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Capo di Stato elettivo in un Paese organizzato in forma repubblicana.",
      "examples": [
        "Il presidente ha firmato il decreto per la riforma del welfare sanitario.",
        "La presidente della Repubblica ha accolto il corpo diplomatico al Quirinale."
      ],
      "nota": "Indica esclusivamente la massima carica istituzionale in ordinamenti non monarchici; nei contesti formali e ufficiali si preferisce l'uso invariato al femminile anziché 'presidentessa'."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che dirige i lavori di un'assemblea, di un collegio o che rappresenta e coordina un ente, un'associazione, una società o un gruppo di lavoro.",
      "examples": [
        "Il presidente del consiglio di amministrazione ha comunicato le nuove linee strategiche agli azionisti.",
        "Durante il convegno, la presidente ha moderato il dibattito assicurando uguale tempo a tutti i relatori."
      ],
      "nota": null
    }
  ]
