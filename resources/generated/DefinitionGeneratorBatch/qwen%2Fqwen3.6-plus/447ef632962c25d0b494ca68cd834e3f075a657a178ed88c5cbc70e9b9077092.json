  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Porre fine a una condizione di prigionia, costrizione o dipendenza imposta a una persona o a un gruppo.",
      "examples": [
        "Il trattato internazionale ha permesso di liberare i civili trattenuti nella zona di conflitto.",
        "Il percorso terapeutico lo ha aiutato a liberare la coscienza da un senso di colpa durato decenni."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere oggetti, ostacoli o elementi superflui che occupano spazio, bloccano il passaggio o compromettono l'uso di un luogo o di un dispositivo.",
      "examples": [
        "Prima di iniziare i lavori dobbiamo liberare completamente il seminterrato da scatoloni e vecchie attrezzature.",
        "I soccorritori sono intervenuti tempestivamente per liberare la carreggiata dai veicoli incidentati prima dell'ora di punta."
      ],
      "nota": "Include l'accezione comune in ambito digitale relativa all'eliminazione di file o dati per recuperare spazio di archiviazione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Produrre ed espellere nell'ambiente circostante energie, sostanze chimiche, radiazioni, suoni o informazioni.",
      "examples": [
        "Il processo di fermentazione ha iniziato a liberare anidride carbonica che ha fatto saltare il tappo della bottiglia.",
        "Questa centrale è in grado di liberare nella rete elettrica una potenza costante per sostenere il fabbisogno invernale."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Sbarazzarsi volontariamente di una presenza sgradita, di un vincolo contrattuale o di un'imposizione psicologica o fisica.",
      "examples": [
        "Ha deciso di liberarsi della vecchia auto per acquistare un modello più efficiente e sicuro.",
        "Dopo anni di convivenza difficile, si è finalmente liberato di una routine lavorativa che gli impediva di vivere serenamente."
      ],
      "nota": "La costruzione con particella pronominale è fortemente idiomatica e indica un'azione deliberata del soggetto volta a modificare il proprio stato o a sottrarsi a un vincolo esterno."
    }
  ]
