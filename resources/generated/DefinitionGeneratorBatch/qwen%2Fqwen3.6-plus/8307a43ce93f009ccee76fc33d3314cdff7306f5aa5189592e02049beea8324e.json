  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Sensazione fisica di bisogno di assumere cibo, causata dalla carenza di nutrienti nell'organismo.",
      "examples": [
        "Dopo la lunga camminata ho una fame terribile e non vedo l'ora di sedermi a tavola.",
        "I bambini che giocano al parco tutto il pomeriggio tornano a casa con una fame incontrollabile."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Desiderio intenso, bisogno urgente o aspirazione irrinunciabile verso qualcosa di immateriale, come conoscenze, successi o esperienze.",
      "examples": [
        "Ha una fame insaziabile di nuove tecnologie e aggiorna le sue competenze ogni mese.",
        "Il movimento culturale è nato dalla voglia di cambiamento che attraversava l'intera generazione."
      ],
      "nota": "Si costruisce prevalentemente con la struttura sintattica 'avere fame di' seguita da sostantivo o verbo all'infinito."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Condizione sociale o storica di estrema penuria di generi alimentari, che colpisce collettivamente una popolazione o un territorio.",
