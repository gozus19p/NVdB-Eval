  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Attività di direzione e amministrazione degli affari pubblici di un paese o di una comunità, inclusi i processi decisionali, le istituzioni rappresentative e le dinamiche di potere.",
      "examples": [
        "Le campagne elettorali hanno dominato i telegiornali per tutta la scorsa settimana.",
        "Molti cittadini partecipano attivamente ai consigli comunali per influenzare le scelte sulla viabilità locale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Linea di azione coerente e programmata definita da un ente, un'azienda o un privato per il raggiungimento di determinati obiettivi gestionali o operativi.",
      "examples": [
        "Il consiglio di amministrazione ha varato un nuovo indirizzo per la gestione del lavoro agile.",
        "Per contenere i costi, la direzione ha adottato una rigorosa strategia di razionalizzazione delle spese."
      ],
      "nota": "Nell'uso contemporaneo è frequentemente impiegata come equivalente del termine inglese policy, soprattutto in contesti aziendali, accademici e di amministrazione pubblica."
    }
  ]
