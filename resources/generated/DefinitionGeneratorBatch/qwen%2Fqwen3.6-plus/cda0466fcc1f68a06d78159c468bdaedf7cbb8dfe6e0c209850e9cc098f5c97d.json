  "senses": [
    {
      "pos": "transitivo",
      "definition": "Recarsi con regolarità in un determinato luogo o partecipare con costanza a un corso, a un'attività ricreativa o a un'istituzione formativa.",
      "examples": [
        "Ogni mattina frequenta la palestra prima di andare in ufficio.",
        "Decise di frequentare un corso di lingua per prepararsi al trasferimento all'estero."
      ],
      "nota": null
    },
    {
      "pos": "transitivo",
      "definition": "Trascorrere abitualmente del tempo in compagnia di una o più persone, coltivando relazioni sociali, amicali o sentimentali.",
      "examples": [
        "Da quando si è stabilita a Milano, frequenta soprattutto vecchie compagne di università.",
        "I genitori gli hanno sempre raccomandato di non frequentare certe compagnie."
      ],
      "nota": "In ambito relazionale assume frequentemente una connotazione valutativa, sottolineando l'influenza positiva o negativa esercitata dalle persone con cui si interagisce."
    }
