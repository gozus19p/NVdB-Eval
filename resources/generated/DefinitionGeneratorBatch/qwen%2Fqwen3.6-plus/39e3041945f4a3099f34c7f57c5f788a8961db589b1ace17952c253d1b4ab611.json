  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Mettere a disposizione di qualcuno un oggetto, una somma o una risorsa, trasferendone il possesso o la disponibilità in modo temporaneo o definitivo.",
      "examples": [
        "Mi ha dato le chiavi del magazzino prima di andare in ferie.",
        "La banca ha dato un prestito agevolato alle piccole imprese locali."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Comunicare o trasmettere a qualcuno notizie, informazioni, pareri o risposte.",
      "examples": [
        "L'agenzia stampa ha dato la notizia dell'intervento con due ore di anticipo.",
        "Non posso dare opinioni su una faccenda che non conosco bene."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Concedere il permesso, l'autorizzazione o la possibilità materiale o morale di compiere qualcosa.",
      "examples": [
        "Il consiglio comunale ha dato il via libera alla ristrutturazione del teatro.",
        "Gli hanno dato due giorni di tempo per preparare la presentazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Attribuire, assegnare o stimare un valore, una qualità, un'età, un nome o una responsabilità.",
      "examples": [
        "Il perito ha dato all'immobile una valutazione leggermente inferiore al mercato.",
        "L'esaminatore gli ha dato un punteggio pieno per la creatività della soluzione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Svolgere la funzione di verbo supporto per un sostantivo d'azione o di gesto, conferendo coniugazione a un evento altrimenti nominale.",
      "examples": [
        "Dobbiamo dare un'occhiata ai documenti prima di firmare il contratto.",
        "Le ha dato un bacio sulla fronte e ha chiuso la porta piano."
      ],
      "nota": "Il significato principale è veicolato dal sostantivo che segue il verbo, mentre quest'ultimo apporta la struttura argomentale e la flessione temporale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Produrre, generare o comportare un effetto, un risultato, un profitto o una conseguenza.",
      "examples": [
        "Quella varietà di olivo dà un olio leggero e delicato.",
        "La campagna pubblicitaria non ha dato i riscontri economici previsti."
      ],
      "nota": null
    },
    {
      "pos": "verbo pronominale",
      "definition": "Dedicarsi con intensità e costanza a un'attività, a una professione, a una persona o a un impegno personale.",
      "examples": [
        "Dopo la laurea si è dato completamente alla ricerca biomedica.",
        "Durante la crisi si è dato da fare per aiutare i vicini più fragili."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere un affaccio, un orientamento o uno sbuco verso un determinato luogo, spazio o punto cardinale.",
