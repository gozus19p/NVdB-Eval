  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha valore, misura o quantità pari a due volte rispetto a un termine di paragone.",
      "examples": [
        "Per la cena abbiamo preparato una porzione doppia di lasagne.",
        "Il costo della riparazione è risultato il doppio della stima iniziale."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Costituito da due strati sovrapposti, elementi affiancati o ripiegato su se stesso in due parti uguali.",
      "examples": [
        "La finestra è dotata di un vetro doppio per isolare termicamente l'ambiente.",
        "Il documento va stampato su foglio con impaginazione doppia faccia."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che nasconde secondi fini, manifesta ambiguità o contraddizione nella condotta o nel significato delle parole.",
      "examples": [
        "Il manager ha usato un linguaggio doppio per evitare di prendere posizioni nette.",
        "Quel sorriso ambiguo e doppio mi ha messo in allarme fin dal primo incontro."
      ],
      "nota": "Impiega una connotazione valutativa negativa, associata alla simulazione o alla falsità comportamentale."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Quantità, valore o numero che corrisponde esattamente a due volte un altro riferimento.",
      "examples": [
        "Per completare il trasloco ci è voluto il doppio del tempo previsto.",
        "Non accettare di pagare il doppio solo perché il prodotto è di marca."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "In sport di racchetta o volano, incontro disputato da due atleti per ciascuna squadra.",
      "examples": [
        "La coppia italiana si è aggiudicata il doppio maschile del torneo di Roma.",
        "Nel doppio la coordinazione tra i compagni è più importante della potenza del singolo."
      ],
      "nota": "Denominazione tecnica propria di discipline come tennis, badminton e ping pong."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Professionista del cinema o dello spettacolo che sostituisce l'attore principale in scene rischiose o che richiedono competenze fisiche e tecniche specifiche.",
      "examples": [
        "Il regista ha assunto un esperto di cadute per fare da doppio durante le riprese in autostrada.",
        "Molte sequenze d'azione vengono realizzate dal doppio e poi integrate digitalmente con il volto della star."
      ],
      "nota": "Corrisponde al termine tecnico 'controfigura' o 'stunt performer'."
    }
  ]
