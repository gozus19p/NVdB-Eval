  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Nelle tradizioni religiose abramitiche, essere spirituale concepito come messaggero o intermediario tra la divinità e gli esseri umani.",
      "examples": [
        "Nell'iconografia classica l'angelo è spesso raffigurato con ali spiegate e abiti luminosi.",
        "Il racconto biblico descrive come gli angeli apparvero ai pastori per annunciare la nascita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Individuo caratterizzato da eccezionale bontà, pazienza o generosità, che si rivela provvidenziale in situazioni di difficoltà.",
      "examples": [
        "Durante la convalescenza, mia sorella è stata un vero angelo, non mi ha fatto mai mancare nulla.",
        "Grazie a quell'angelo che mi ha prestato l'auto, sono riuscito ad arrivare in tempo per il colloquio."
      ],
      "nota": "Pur essendo grammaticalmente maschile, nell'uso figurato il termine viene comunemente esteso a persone di sesso femminile."
    }
