  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "Ciascuna delle due parti uguali in cui viene suddiviso un intero, o quantità pari alla metà di un'unità di misura.",
      "examples": [
        "Durante la cena ha ordinato un mezzo di vino rosso.",
        "Tagliato il nastro in due, ha conservato il pezzo a lui più utile."
      ],
      "nota": "Nell'uso parlato contemporaneo è frequente per indicare mezza porzione di alimento o bevanda, spesso in sostituzione del termine equivalente."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Punto, zona o spazio interposto tra due o più entità, situato in posizione centrale o equidistante rispetto ai confini.",
      "examples": [
        "Il gatto si è infilato in mezzo ai cespugli per evitare la pioggia.",
        "Posiziona il vaso esattamente in mezzo al tavolo, lontano dai bordi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Strumento, procedura, canale o risorsa impiegata per conseguire uno scopo o ottenere un determinato risultato.",
      "examples": [
        "La diplomazia rimane il canale più efficace per risolvere le crisi internazionali.",
        "Le piattaforme digitali sono diventate risorse essenziali per la didattica a distanza."
      ],
      "nota": "In contesti formali o filosofici viene spesso contrapposto al concetto di obiettivo finale."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Veicolo, pubblico o privato, adibito al trasporto di persone o di merci su strada, rotaia, acqua o in aria.",
      "examples": [
        "Per evitare il traffico cittadino preferisco spostarmi con i trasporti pubblici.",
        "Il concessionario ha ritirato l'automobile per una revisione ordinaria."
      ],
      "nota": "Accezione fortemente specialistica nell'ambito dei trasporti e della mobilità urbana."
    },
    {
      "pos": "avverbio",
      "definition": "In misura parziale, approssimativa o non completa; esprime uno stato, una condizione o un'azione parzialmente realizzati.",
      "examples": [
        "Dopo lo sforzo prolungato era quasi addormentato sulla poltrona.",
        "La notizia riporta fatti sostanzialmente veri, ma omette i dettagli conclusivi."
      ],
      "nota": "In questa funzione precede tipicamente aggettivi o participi passati e rimane invariabile, anche quando il soggetto è femminile o plurale."
    },
    {
      "pos": "aggettivo (m./f.)",
      "definition": "Che corrisponde a metà di una quantità o indica una caratteristica intermedia, non pienamente estrema o compiuta.",
      "examples": [
        "La ricetta richiede una quantità esatta di farina pari a cinquecento grammi.",
        "L'azienda ha proposto un accordo a metà strada per soddisfare entrambe le richieste."
      ],
      "nota": "Quando accompagna sostantivi indica valore quantitativo; nell'italiano contemporaneo tende a mostrare resistenza alla concordanza di genere in contesti misurabili o fissazioni fraseologiche."
    }
  ]
}