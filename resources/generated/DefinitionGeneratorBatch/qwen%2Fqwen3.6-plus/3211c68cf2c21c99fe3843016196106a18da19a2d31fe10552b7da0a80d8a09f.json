  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "Porzione fisica staccata da un tutto o frammento risultato dalla suddivisione di un oggetto intero.",
      "examples": [
        "Taglia l'impasto in pezzi più piccoli prima di infornarlo.",
        "Il vaso è caduto dal mobile e ora è ridotto in mille pezzi sul pavimento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Singolo esemplare considerato come unità autonoma all'interno di una serie, collezione, produzione commerciale o kit di montaggio.",
      "examples": [
        "Il collezionista ha finalmente recuperato il pezzo mancante per completare la sua raccolta di francobolli.",
        "Questo orologio è un vero pezzo d'antiquariato, perfettamente conservato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Composizione o registrazione musicale, indipendentemente dal genere, dalla durata o dalla modalità di distribuzione.",
      "examples": [
        "La band ha aperto il concerto con un pezzo strumentale molto energico.",
        "Ha pubblicato un nuovo pezzo sulle piattaforme di streaming ieri sera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Individuo che riveste un ruolo di prestigio, detiene grande autorità o spicca per capacità e influenza in un determinato ambito sociale o professionale.",
      "examples": [
        "Alla fiera c'erano pezzi molto importanti dell'industria tecnologica internazionale.",
        "Non cercare di fare il pezzo grosso con me, in questo reparto comando io."
      ],
      "nota": "Uso figurato e colloquiale, frequentemente associato a modificatori come 'grosso', 'forte' o all'espressione idiomatica 'da novanta'."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Quantità rilevante o porzione significativa di tempo, spazio, distanza o altra entità non fisica.",
      "examples": [
        "Per arrivare al rifugio abbiamo percorso ancora un bel pezzo di sentiero sterrato.",
        "Ci vorrà un pezzo prima che il cantiere sia completato e riaperto al traffico."
      ],
      "nota": null
    }
  ]
