  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Insieme di elementi, oggetti o concetti raggruppati in base a proprietà, funzioni o caratteristiche comuni all'interno di un sistema di ordinamento o di studio.",
      "examples": [
        "L'archivio digitale è stato riorganizzato suddividendo i documenti per categorie tematiche.",
        "Il supermercato espone i prodotti in scaffali distinti per categoria merceologica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Classe di partecipanti a gare o competizioni, atleti, veicoli o soggetti in contesti normativi e assicurativi, ripartiti secondo parametri fissati come età, peso, livello di preparazione o tipo di utilizzo.",
      "examples": [
        "Dopo anni nel settore giovanile, il tennista è stato promosso nella categoria professionisti.",
        "Le tariffe del servizio variano in base alla categoria professionale del richiedente."
      ],
      "nota": "Uso prevalente in ambito sportivo, automobilistico e nella classificazione previdenziale o assicurativa."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Livello di qualità, prestigio o importanza riconosciuto a una persona, un prodotto o un'attività, spesso espresso in espressioni che ne indicano il rango.",
      "examples": [
        "Si tratta di un ristorante di categoria, dove il servizio è impeccabile e la cucina è raffinata.",
        "Per un intervento così delicato serve un chirurgo di categoria, non possiamo improvvisare."
      ],
      "nota": "Frequentemente impiegato in costrutti con la preposizione 'di' (es. 'di categoria', 'prima categoria', 'fuori categoria') con valore intensivo o distintivo."
    }
  ]
