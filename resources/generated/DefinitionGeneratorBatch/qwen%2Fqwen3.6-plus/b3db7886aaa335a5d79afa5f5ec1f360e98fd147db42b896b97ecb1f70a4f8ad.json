  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Collocare o adagiare un oggetto o una parte del corpo su o contro un'altra cosa affinché vi rimanga in equilibrio, riceva sostegno o trovi riposo.",
      "examples": [
        "Dopo averli lavati, ha appoggiato i bicchieri sull'asciugamano.",
        "Non appoggiare il bicchiere sul bordo del mobile, potrebbe cadere."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Manifestare adesione o fornire sostegno concreto, morale, politico o economico a una persona, un'iniziativa o un'idea.",
      "examples": [
        "L'associazione culturale ha deciso di appoggiare economicamente la rassegna teatrale.",
        "Molti cittadini hanno appoggiato la proposta di pedonalizzare il centro storico."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Fondare un ragionamento, un'affermazione o una decisione su elementi fattuali, prove o argomentazioni verificabili.",
      "examples": [
        "La tesi di laurea si appoggia su un'analisi quantitativa dei dati raccolti negli ultimi cinque anni.",
        "Non è possibile appoggiare questa accusa a indizi così vaghi e contraddittori."
      ],
      "nota": "Accezione tipica dei registri formali, accademici o giuridici."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Inclinare il corpo o una sua parte contro una superficie o un sostegno per mantenere l'equilibrio o riposare.",
      "examples": [
        "Dopo la maratona si è appoggiato alla ringhiera per riprendere fiato.",
        "Durante la lezione non è consentito appoggiarsi ai banchi con le gambe."
      ],
      "nota": "Realizzato morfologicamente con la forma pronominale appoggiarsi; indica l'azione che ricade sul soggetto stesso."
    }
  ]
}