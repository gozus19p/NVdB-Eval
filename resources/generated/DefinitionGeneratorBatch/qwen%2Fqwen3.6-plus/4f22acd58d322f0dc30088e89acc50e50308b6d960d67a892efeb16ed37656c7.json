  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Trattenersi in un luogo o mantenere uno stato di quiete fino alla comparsa di una persona, di un oggetto o al verificarsi di un evento.",
      "examples": [
        "Ti aspetterò davanti alla stazione finché non scenderai dal treno.",
        "Non possiamo aspettare oltre, la prenotazione vale ancora per dieci minuti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Avere la previsione o la convinzione che un fatto si verificherà o che qualcuno o qualcosa presenterà determinate caratteristiche.",
      "examples": [
        "Non mi aspettavo che la riunione durasse così tanto.",
        "Dopo tutte quelle lodi, ci aspettavamo un prodotto molto più raffinato."
      ],
      "nota": "Spesso utilizzato con valore valutativo; in forma negativa o interrogativa può esprimere sorpresa o delusione di fronte a realtà inaspettate."
    }
  ]
