  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Tessuto di rivestimento esterno che protegge l'organismo umano e animale, composto da epidermide e derma e ricco di terminazioni nervose e ghiandole.",
      "examples": [
        "Dopo quella lunga esposizione al sole, la sua pelle si è arrossata e scottata.",
        "Le creme idratanti servono a mantenere la pelle morbida ed elastica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Materiale resistente e flessibile ottenuto dalla concia del derma animale, comunemente impiegato nella manifattura di calzature, borse, abbigliamento e rivestimenti.",
      "examples": [
        "Ha comprato una giacca di pelle nera dal taglio moderno.",
        "Questo portafoglio è fatto in pelle conciata vegetalmente e durerà anni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "La propria vita o incolumità fisica, con specifico riferimento a situazioni di grave pericolo o rischio mortale.",
      "examples": [
        "Per fortuna sono riuscito a salvarmi e a non rimetterci la pelle nell'incidente.",
        "Ha rischiato la pelle per portare in salvo i bambini dalla casa in fiamme."
      ],
      "nota": "Uso figurato che compare stabilmente in locuzioni idiomatiche e fraseologismi fissi."
    }
