  "senses": [
    {
      "pos": "sostantivo, femminile",
      "definition": "Movimento ordinato e continuativo di un fluido, di particelle o di energia che si propaga in una direzione precisa attraverso un mezzo o un conduttore.",
      "examples": [
        "La corrente del fiume era troppo forte per attraversarlo a nuoto.",
        "Il temporale ha fatto saltare la corrente in tutto il palazzo."
      ],
      "nota": "Nell'uso quotidiano, quando impiegato in modo assoluto, indica quasi sempre l'energia elettrica distribuita dalla rete."
    },
    {
      "pos": "sostantivo, femminile",
      "definition": "Tendenza culturale, ideale o politica, oppure gruppo organizzato che, all'interno di un movimento più ampio, si distingue per posizioni o obiettivi specifici.",
      "examples": [
        "All'interno del movimento ambientalista è emersa una corrente più radicale.",
        "Quella corrente letteraria ha rivoluzionato il modo di concepire la poesia contemporanea."
      ],
      "nota": "Estensione figurata dal senso fisico, molto frequente in ambito sociologico, politico e culturale."
    },
    {
      "pos": "aggettivo",
      "definition": "Che scorre o si muove in modo continuo.",
      "examples": [
        "Per una corretta igiene è consigliabile sciacquare le verdure con acqua corrente.",
        "I mulini tradizionali sfruttavano la forza delle acque correnti per azionare le macine."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che appartiene al periodo di tempo in corso, che si sta verificando in questo momento.",
      "examples": [
        "La fattura deve essere saldata entro il quindici del mese corrente.",
        "Le previsioni economiche per l'anno corrente sono state riviste al ribasso."
      ],
      "nota": "Si pospone generalmente al sostantivo temporale a cui si riferisce (es. mese, anno, bimestre)."
    },
    {
      "pos": "aggettivo",
      "definition": "Di uso comune, quotidiano, largamente diffuso o ordinariamente accettato.",
      "examples": [
        "Quell'espressione dialettale è ormai entrata nel linguaggio corrente e viene compresa anche dai non nativi.",
        "Per mantenere in equilibrio il bilancio, il comune ha dovuto tagliare le spese correnti."
      ],
      "nota": "In ambito bancario e contabile qualifica le operazioni di ordinaria amministrazione o gli strumenti di pagamento più diffusi (es. conto corrente, moneta corrente)."
    }
  ]
