  "senses": [
    {
      "pos": "sostantivo, maschile",
      "definition": "Parte del corpo umano o animale che congiunge la testa al resto del tronco o torace.",
      "examples": [
        "Si è stirato un muscolo del collo durante l'allenamento.",
        "I cigni hanno un collo molto lungo ed elegante."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Sezione più stretta che collega due parti più ampie di un oggetto, tipicamente in contenitori, strumenti musicali o calzature.",
      "examples": [
        "Versa l'olio tenendo la bottiglia saldamente per il collo.",
        "Il collo della chitarra si è crepato dopo un urto accidentale."
      ],
      "nota": "Ricorre prevalentemente in sintagma con il nome dell'oggetto di riferimento (es. collo della bottiglia, del vaso, dello stivale)."
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Persona, incarico o situazione considerata un peso, un'occupazione gravosa o un fastidio continuativo.",
      "examples": [
        "Ho questo progetto urgente sul collo e non riesco a concentrarmi su altre pratiche.",
        "Suo cugino in cerca di sistemazione gli sta sul collo da mesi."
      ],
      "nota": "Accezione figurata di registro informale, stabilizzata nelle locuzioni 'avere sul collo' o 'tenere sul collo'."
    }
