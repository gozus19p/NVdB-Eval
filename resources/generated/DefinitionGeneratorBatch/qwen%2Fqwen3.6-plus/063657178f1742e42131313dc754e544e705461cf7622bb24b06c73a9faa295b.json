  "senses": [
    {
      "pos": "avverbio",
      "definition": "Indica una posizione stazionaria o un movimento verso la parte posteriore rispetto al parlante o a un riferimento implicito.",
      "examples": [
        "I bambini si sono seduti tutti davanti, mentre gli adulti sono rimasti dietro.",
        "Non bloccare l'ingresso, spostati sul lato opposto e mettiti dietro."
      ],
      "nota": "Si usa spesso in correlazione oppositiva con «avanti» o «davanti»."
    },
    {
      "pos": "preposizione",
      "definition": "Regge un nome o un pronome specificando la collocazione o la direzione verso la zona posteriore di un determinato elemento.",
      "examples": [
        "Il giardino si estende proprio dietro la villetta.",
        "Camminavano ordinatamente uno dietro l'altro lungo il sentiero."
      ],
      "nota": "Grammaticalmente classificata come preposizione impropria; quando regge pronomi personali tonici richiede l'ausilio della preposizione «di» (es. «dietro di te»)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La faccia o la zona opposta a quella anteriore di un corpo, un oggetto o un edificio.",
      "examples": [
        "Ho controllato il dietro della scatola e ho trovato le istruzioni per il montaggio.",
        "La facciata del palazzo è stata restaurata, ma il dietro dell'edificio versa ancora in pessimo stato."
      ],
      "nota": "Forma invariabile al plurale; l'uso è comune nel parlato e in contesti tecnici o descrittivi."
    }
  ]
