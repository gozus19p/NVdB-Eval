  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che non cambia posizione, saldamente ancorato o stabilmente collocato in un punto.",
      "examples": [
        "Lo scaffale è stato imbullonato al muro e ora non oscilla più.",
        "Prima di salire, verifica che la pedana sia completamente immobile."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Stabilito in anticipo in modo definitivo e che non subisce variazioni nel tempo, nell'importo o nella frequenza.",
      "examples": [
        "Il canone mensile è bloccato da tre anni nonostante gli aumenti dei costi.",
        "Ci vediamo ogni giovedì per l'incontro che si ripete con cadenza immutata."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un rapporto di lavoro caratterizzato da durata indeterminata e garanzia di continuità retributiva.",
      "examples": [
        "Dopo anni di incarichi a progetto, ha finalmente ottenuto una posizione stabile nel settore pubblico.",
        "Il bando richiede titoli meno stringenti per chi già opera con un impiego a tempo indeterminato."
      ],
      "nota": "Spesso contrapposto a precario o a termine."
    },
    {
      "pos": "aggettivo",
      "definition": "Rivolto in modo incessante e invariato verso un oggetto, uno scopo o un'idea.",
      "examples": [
        "Teneva gli occhi concentrati sullo schermo senza mai distogliere lo sguardo.",
        "Era talmente assorta nella ricerca che non riusciva a staccare i pensieri dall'obiettivo."
      ],
      "nota": "Ricorrente nelle locuzioni sguardo puntato o idea dominante."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Apparecchio telefonico collegato direttamente alla rete di cablaggio domestico o aziendale.",
      "examples": [
        "Mio nonno preferisce usare la linea tradizionale piuttosto che lo smartphone.",
        "Abbiamo disdetto l'abbonamento al telefono da parete perché tutti i familiari hanno il cellulare."
      ],
      "nota": "Nel linguaggio comune, usato in contrapposizione a dispositivo mobile."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Impiego lavorativo a tempo indeterminato, inteso come garanzia di stabilità economica e sociale.",
      "examples": [
        "Finalmente ha trovato quel posto sicuro che cercava da anni.",
        "Oggi molti giovani rinunciano al lavoro tradizionale per provare a mettersi in proprio."
      ],
      "nota": "Uso colloquiale e sostantivato dell'accezione lavorativa."
    }
  ]
