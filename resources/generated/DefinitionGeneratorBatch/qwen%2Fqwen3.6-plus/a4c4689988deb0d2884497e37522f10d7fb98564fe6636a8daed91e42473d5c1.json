  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che consente riposo o movimento senza affaticamento o fastidio, riferito a indumenti, calzature, arredi o simili.",
      "examples": [
        "Queste nuove scarpe sono talmente comode che ci cammino tutto il giorno senza accorgermene.",
        "Il materasso è comodo, ma la rete del letto cigola leggermente."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Facilmente raggiungibile o utilizzabile per la sua posizione, collocazione o caratteristiche strutturali.",
      "examples": [
        "L'appartamento è comodo, si trova a dieci minuti a piedi dalla fermata della metropolitana.",
        "Abbiamo scelto un orario comodo per la riunione, così chi ha figli può partire tardi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che risulta utile, necessario o vantaggioso in un determinato contesto, spesso utilizzato in strutture predicative per indicare un'opportunità concreta o un bisogno soddisfatto.",
      "examples": [
        "Quei documenti vecchi mi farebbero comodo per completare la pratica bancaria.",
        "Il tuo aiuto mi è tornato molto comodo per finire il trasloco prima di sera."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che implica l'assenza di fatica o sforzo, talvolta con sfumatura negativa legata alla ricerca dell'agio personale o all'opportunismo.",
      "examples": [
        "Ha preferito la soluzione più comoda, anche se non rispettava il regolamento originario.",
        "Cerca sempre l'aspetto più comodo di ogni faccenda, rinunciando a fare scelte impegnative."
      ],
      "nota": null
    }
  ]
