  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Piccolo mammifero carnivoro della famiglia dei felidi, comunemente tenuto come animale da compagnia o per il controllo di roditori.",
      "examples": [
        "Il gatto dorme tranquillamente sul davanzale nonostante il rumore del traffico.",
        "Abbiamo adottato un gatto randagio che si aggirava nel nostro giardino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona dotata di particolare agilità, scaltrezza o prontezza di riflessi, capace di destreggiarsi con facilità in situazioni complesse.",
      "examples": [
        "Non provare a anticiparlo, è un gatto e ti sfugge sempre all'ultimo momento.",
        "Nelle trattative commerciali si è rivelato un gatto, ottenendo condizioni vantaggiose senza esporsi troppo."
      ],
      "nota": "Uso figurato di registro colloquiale, impiegato per sottolineare abilità pratica, furberia o capacità di evitare pericoli."
    }
  ]
