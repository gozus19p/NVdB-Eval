  "senses": [
    {
      "pos": "verbo intransitivo e transitivo",
      "definition": "Emettere un suono vocale molto forte e prolungato, generalmente per rabbia, dolore, paura, eccitazione o per farsi sentire a grande distanza; dire o esprimere parole con tono eccessivamente elevato.",
      "examples": [
        "Il pubblico ha iniziato a urlare di gioia non appena ha visto apparire gli artisti sul palco.",
        "Non serve alzare la voce, ti sento chiaramente anche se parli con calma."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riferito a oggetti, colori, abbigliamento o elementi grafici, risultare eccessivamente vistoso, appariscente o di gusto poco raffinato, attirando l'attenzione in modo aggressivo o sgradevole.",
      "examples": [
        "Quella giacca giallo acceso con le paillettes urla già da lontano e non si addice a un contesto formale.",
        "Le insegne luminose e i cartelloni pubblicitari urlano dalle facciate per catturare lo sguardo dei passanti."
      ],
      "nota": "Uso frequente nella critica estetica e nel linguaggio giornalistico per indicare un eccesso di visibilità percepito come volgare o poco elegante."
    }
  ]
