  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Piccola sacca o scomparto, cucito o applicato su un indumento o su un contenitore simile, destinato a custodire oggetti di piccole dimensioni.",
      "examples": [
        "Prima di uscire di casa ha infilato le chiavi nella tasca del cappotto.",
        "Questi pantaloni da lavoro hanno tasche laterali molto capienti per gli attrezzi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Disponibilità di denaro o risorse economiche personali, valutata in relazione alla capacità di sostenere spese specifiche.",
      "examples": [
        "L'aumento del costo dei carburanti continua a pesare sulle tasche delle famiglie.",
        "Ha anticipato tutte le spese di trasloco, prelevando direttamente dalle proprie tasche."
      ],
      "nota": "Ricorre frequentemente in locuzioni come 'pesare sulle tasche' o 'toccare le tasche' per indicare un esborso economico immediato o un aggravio finanziario."
    }
  ]
