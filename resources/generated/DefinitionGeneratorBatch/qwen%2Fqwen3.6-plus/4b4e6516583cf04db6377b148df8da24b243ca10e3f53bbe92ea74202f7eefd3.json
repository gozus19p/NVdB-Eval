  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta un'eccessiva quantità di tessuto adiposo nel corpo, riferito a persona o animale.",
      "examples": [
        "Il veterinario ha consigliato di ridurre le porzioni perché il cane è ormai troppo grasso.",
        "Con la vita sedentaria è facile diventare grassi se non si bilancia correttamente l'introito calorico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che contiene elevate percentuali di lipidi o sostanze oleose, riferito ad alimenti o preparati.",
      "examples": [
        "La ricetta tradizionale richiede pancetta piuttosto grassa per insaporire adeguatamente il sugo.",
        "Per una dieta ipolipidica è preferibile evitare i formaggi stagionati più grassi a favore di varianti magre."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato da alta fertilità e capacità di sostenere abbondanti raccolti, riferito a terreni o zone agricole.",
      "examples": [
        "Il terreno di questa valle è così fertile che i raccolti raddoppiano rispetto alle zone collinose.",
        "Dopo anni di riposo il suolo è tornato grasso e pronto per le semine primaverili."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di notevole entità, abbondante o altamente remunerativo, riferito a somme di denaro, guadagni o patrimoni.",
      "examples": [
        "Dopo anni di gavetta ha firmato un contratto dalla retribuzione decisamente cospicua.",
        "Quell'affare inaspettato gli ha garantito una rendita mensile davvero abbondante."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di carattere di scrittura o tratto grafico dallo spessore marcato e dal colore intenso, utilizzato per evidenziare parti di testo.",
      "examples": [
        "Per il titolo della brochure ho preferito un font marcato che risaltasse visivamente sulla pagina.",
        "Il manuale tecnico evidenzia i comandi di sicurezza con un tratto più spesso rispetto al resto del corpo del documento."
      ],
      "nota": "Nell'uso tipografico e grafico-editoriale contemporaneo è frequentemente affiancato o sostituito da 'grassetto'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza untuosa e viscosa di origine animale o vegetale, impiegata in ambito alimentare, cosmetico o lubrificante.",
      "examples": [
        "Dopo aver arrostito la carne, ho recuperato il liquido oleoso colato nella teglia per saltare le patate.",
        "I meccanici applicano regolarmente il composto lubrificante su cuscinetti e ingranaggi per prevenire l'attrito eccessivo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Accumulo di tessuto adiposo che funge da riserva energetica o di protezione negli organismi viventi.",
      "examples": [
        "Con il passare degli anni il metabolismo rallenta e l'organismo tende ad accumulare più riserve sulla zona addominale.",
        "Lo screening medico ha evidenziato un eccesso di tessuto lipidico viscerale che potrebbe complicare il quadro cardiaco."
      ],
      "nota": null
    }
