  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Sostituire una persona, un oggetto o una condizione con un altro elemento di pari o simile funzione.",
      "examples": [
        "Prima del trasloco ho preferito cambiare le serrature di casa.",
        "Dopo il fallimento della trattativa, il consiglio ha cambiato direttore con un profilo più esperto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Alterare le caratteristiche, la forma, la direzione o l'assetto di qualcosa, rendendola diversa dallo stato precedente.",
      "examples": [
        "Quel viaggio ha cambiato per sempre la sua prospettiva sulle priorità professionali.",
        "Dovremmo cambiare la disposizione dei divani per illuminare meglio l'angolo lettura."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Subire una trasformazione o un'evoluzione nel tempo, presentando aspetti, tratti o condizioni differenti rispetto al passato.",
      "examples": [
        "Con l'arrivo dell'equinozio il tempo cambia rapidamente e le temperature scendono.",
        "Negli ultimi anni il suo approccio alla gestione della squadra è profondamente cambiato."
      ],
      "nota": "L'ausiliare è di norma il verbo essere quando il mutamento riguarda il soggetto in modo intrinseco, mentre avere è ammesso e sempre più frequente in contesti informali o per fenomeni circostanziali."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Indossare indumenti diversi da quelli portati in precedenza, solitamente per igiene, adattamento climatico o adeguamento a un nuovo contesto.",
      "examples": [
        "Appena arrivo in palestra mi tolgo la giacca e devo cambiarmi prima di iniziare la lezione.",
        "In campeggio è fondamentale cambiarsi i vestiti appena si rientrano dalla pioggia per non prendere freddo."
      ],
      "nota": null
    }
  ]
