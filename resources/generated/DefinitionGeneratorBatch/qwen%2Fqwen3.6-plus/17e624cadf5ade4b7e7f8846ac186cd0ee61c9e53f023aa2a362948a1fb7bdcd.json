  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Svolgere un'attività professionale, commerciale o organizzativa all'interno di un determinato settore, territorio o istituzione.",
      "examples": [
        "L'impresa opera principalmente nel mercato dell'elettronica di consumo.",
        "Diverse organizzazioni umanitarie operano nelle zone più colpite dal conflitto."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Manifestare la propria azione o produrre conseguenze specifiche, con riferimento a meccanismi, forze naturali o principi regolatori.",
      "examples": [
        "Le leve psicologiche operano spesso in modo inconsapevole sulle decisioni d'acquisto.",
        "In assenza di controlli esterni, operano dinamiche di autoregolazione interne al gruppo."
      ],
      "nota": "Prevalente in registri scientifici, economici e sociologici."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire o deliberare formalmente un'azione, una suddivisione, una modifica o una selezione, specialmente in contesti amministrativi, giuridici o tecnici.",
      "examples": [
        "Il sindaco ha operato una drastica riduzione delle spese comunali.",
        "Prima di procedere con l'analisi, il ricercatore deve operare una chiara separazione tra i due fenomeni."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sottoporre un paziente a un intervento chirurgico a scopo diagnostico o terapeutico.",
      "examples": [
        "L'équipe medica ha operato il bambino con una tecnica mininvasiva.",
        "I chirurghi hanno operato il paziente in seguito alla frattura del femore."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Esercitare la professione medica eseguendo abitualmente interventi chirurgici.",
      "examples": [
        "Il dottore opera presso la clinica universitaria da oltre quindici anni.",
        "Dopo il periodo di specializzazione, ha iniziato a operare in un centro privato."
      ],
      "nota": "Regge frequentemente complementi di luogo o di struttura organizzativa."
    }
