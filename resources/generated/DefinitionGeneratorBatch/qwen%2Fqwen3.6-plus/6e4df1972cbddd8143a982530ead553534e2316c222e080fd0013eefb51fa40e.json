  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di scarsa estensione verticale o di altezza ridotta rispetto alla media o a un termine di paragone.",
      "examples": [
        "Suo fratello è molto basso per la sua età.",
        "Quel mobile troppo basso non si addice al soffitto alto della stanza."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Collocato a una quota, un’altitudine o un livello non elevato rispetto al suolo o a un punto di riferimento.",
      "examples": [
        "Le nuvole basse coprivano le cime delle montagne.",
        "L’acqua del fiume era straordinariamente bassa a causa della lunga siccità."
      ],
      "nota": "Si contrappone spesso a «alto» nella descrizione di livelli o posizioni spaziali."
    },
    {
      "pos": "aggettivo",
      "definition": "Caratterizzato da un suono grave o da un volume di intensità ridotta.",
      "examples": [
        "La sua voce era così bassa che nessuno riusciva a sentirla in fondo alla sala.",
        "Hanno suonato una nota bassa per mantenere il ritmo del brano."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Contraddistinto da un valore, una quantità, un’intensità o un grado numericamente o qualitativamente esigui.",
      "examples": [
        "Il prezzo del biglietto è rimasto sorprendentemente basso nonostante l'inflazione.",
        "Con quella bassa votazione non supererà l’esame di amministrazione aziendale."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Relativo a una condizione sociale, un rango o un livello culturale considerati inferiori o popolari.",
      "examples": [
        "Proviene da un ceto sociale basso ma ha ottenuto ottimi risultati accademici.",
        "Quel romanzo è scritto con un linguaggio volutamente basso per adattarsi ai personaggi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "La parte inferiore o la zona più in fondo di un oggetto, di un contenitore o di uno spazio.",
      "examples": [
        "Ha cercato le chiavi cadute sul basso della credenza.",
        "Il sedimento scuro si è accumulato nel basso del recipiente."
      ],
      "nota": "Spesso usato in costruzioni con la preposizione «di» o nei sintagmi «dal basso», «in basso»."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Il registro vocale o strumentale più grave; per estensione, il cantante o il musicista specializzato in tale estensione.",
      "examples": [
        "Il basso della corale ha eseguito l’assolo con grande sicurezza.",
        "L'orchestra ha bisogno di un basso esperto per coprire le parti gravi."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In modo da produrre un'intensità sonora ridotta o a una quota non elevata rispetto al suolo o a un riferimento.",
      "examples": [
        "Parlate basso, il bambino si è appena addormentato.",
        "Il drono è volato troppo basso e ha urtato contro i rami degli alberi."
      ],
      "nota": "Nell'uso quotidiano prevale nettamente la sfumatura legata al volume o al tono della voce."
    }
  ]
}