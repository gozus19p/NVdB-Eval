  "senses": [
    {
      "pos": "transitivo",
      "definition": "Produrre musica o suoni strutturati mediante uno strumento musicale.",
      "examples": [
        "Mio fratello suona la chitarra nel gruppo da quando aveva diciassette anni.",
        "Durante il concerto ha suonato tre classici del jazz improvvisando sul finale."
      ],
      "nota": null
    },
    {
      "pos": "transitivo",
      "definition": "Premere o azionare un congegno allo scopo di generare un segnale acustico.",
      "examples": [
        "Suona il citofono perché ti apriamo subito.",
        "L'autista ha suonato il clacson per evitare l'impatto con il pedone."
      ],
      "nota": null
    },
    {
      "pos": "intransitivo",
      "definition": "Emettere suoni o segnali acustici in modo autonomo o attivato da cause esterne.",
      "examples": [
        "Il telefono ha suonato tre volte prima che qualcuno rispondesse.",
        "Ieri mattina l'allarme antincendio ha suonato per un falso positivo."
      ],
      "nota": null
    },
    {
      "pos": "intransitivo",
      "definition": "Produrre una specifica impressione uditiva o psicologica, spesso in combinazione con aggettivi o avverbi valutativi.",
      "examples": [
        "La sua giustificazione suona poco credibile alla luce dei nuovi documenti.",
        "Questa parola suona armoniosa alla fine della frase."
      ],
      "nota": "Funziona come verbo copulativo, indicando risalto percettivo o soggettivo piuttosto che un'azione fisica."
    },
    {
      "pos": "transitivo",
      "definition": "Battere nettamente un avversario in una competizione o in un confronto verbale.",
      "examples": [
        "La squadra ospite ci ha suonato per novanta minuti senza concedere occasioni.",
        "Nel dibattito pubblico l'hanno suonato sui dati di bilancio."
      ],
      "nota": "Registro colloquiale e sportivo, diffuso nell'italiano contemporaneo parlato."
    }
  ]
