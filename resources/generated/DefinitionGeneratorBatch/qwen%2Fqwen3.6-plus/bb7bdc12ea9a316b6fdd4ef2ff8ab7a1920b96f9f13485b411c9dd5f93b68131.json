  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Margine esterno, orlo o perimetro di una superficie, di un oggetto o di un'apertura.",
      "examples": [
        "Ha appoggiato il piatto troppo vicino al margine del tavolo e l'ha fatto cadere.",
        "La tovaglia presenta un ricamo geometrico lungo tutto il perimetro esterno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Fianco laterale di un'imbarcazione, compreso tra la linea di galleggiamento e la parte superiore dello scafo.",
      "examples": [
        "Il marinaio ha controllato le condizioni del fianco della nave dopo la tempesta notturna.",
        "Le onde violente hanno ripetutamente schiumato contro la struttura laterale dello scafo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio interno o parte operativa di un veicolo o mezzo di trasporto, utilizzato quasi esclusivamente nelle locuzioni 'a bordo' e 'salire a bordo'.",
      "examples": [
        "I passeggeri sono rimasti seduti all'interno dell'aereo fino al completo spegnimento del segnale.",
        "Il meccanico è salito sul treno per individuare il guasto al sistema di climatizzazione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Soglia estrema o limite prossimo a una condizione critica, impiegato in contesti figurati per segnalare un'imminente trasformazione o un pericolo.",
      "examples": [
        "Dopo mesi di tensioni familiari, il gruppo era sull'orlo di una separazione definitiva.",
        "L'azienda ha rischiato di finire sul limite della bancarotta a causa del calo delle vendite."
      ],
      "nota": "Frequentemente introdotto dalla preposizione 'sul'."
    }
  ]
