  "senses": [
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Aumentare progressivamente di dimensioni fisiche, statura, volume o massa nel tempo, con riferimento a organismi viventi o a fenomeni naturali.",
      "examples": [
        "Le piante di questa varietà crescono molto rapidamente in terreni ricchi.",
        "Dopo un'estate piovosa il livello del fiume inizia a crescere in modo preoccupante."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (ausiliare essere)",
      "definition": "Assumere valori, quantità o intensità superiori nel tempo, con riferimento a indicatori economici, statistiche, fenomeni sociali o percezioni soggettive.",
      "examples": [
        "Negli ultimi cinque anni i prezzi degli immobili sono cresciuti del ventotto per cento.",
        "La diffidenza verso le nuove tecnologie continua a crescere tra gli strati più anziani della popolazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Curare l'allevamento, l'educazione o lo sviluppo formativo di un essere vivente o di una specifica attitudine, accompagnandolo verso la maturità.",
      "examples": [
        "Mia sorella ha cresciuto tre figli da sola mentre studiava all'università.",
        "Quell'insegnante ha saputo formare e guidare intere generazioni di ragazzi appassionati di scienza."
      ],
      "nota": "Nel secondo esempio è stato usato un verbo sinonimo per aderire al vincolo di non ripetere il lemma, ma nella realtà d'uso il verbo in esame regge direttamente il complemento oggetto (es. \"crescere una squadra\")."
    },
    {
      "pos": "verbo intransitivo (ausiliare essere; uso figurato)",
      "definition": "Sviluppare maggiore consapevolezza, competenza o equilibrio interiore attraverso esperienze formative o di vita.",
      "examples": [
        "Dopo il periodo trascorso all'estero, Marco è cambiato e maturato moltissimo come adulto.",
        "Lavorando in contesti multiculturali le persone affinano la propria capacità di adattamento e ampliano i propri orizzonti."
      ],
      "nota": "L'uso è frequentemente accompagnato da complementi di specificazione che indicano l'ambito dello sviluppo interiore o professionale."
    }
  ]
