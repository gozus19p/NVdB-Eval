  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Collocare un oggetto o una persona in un luogo dove non sia facilmente visibile o individuabile.",
      "examples": [
        "Ha nascosto le chiavi sotto il vaso di fiori per sicurezza.",
        "Il gatto si nasconde dietro il divano quando sente i tuoni."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Non rivelare intenzionalmente informazioni fatti o circostanze che altri potrebbero conoscere.",
      "examples": [
        "L'azienda ha cercato di nascondere i dati reali sulle vendite.",
        "Non serve nascondere la verità, prima o poi verrà a galla."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
