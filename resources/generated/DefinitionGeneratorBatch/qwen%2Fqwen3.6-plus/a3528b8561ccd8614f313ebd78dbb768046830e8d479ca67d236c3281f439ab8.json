  "senses": [
    {
      "pos": "transitivo",
      "definition": "Eliminare errori, inesattezze o difetti da un testo, un calcolo, un dato o un'opera scritta.",
      "examples": [
        "La professoressa passerà la serata a correggere i compiti in classe.",
        "Prima di inviare il rapporto, ho dovuto rivedere il documento per sistemare alcune inesattezze numeriche."
      ],
      "nota": null
    },
    {
      "pos": "transitivo",
      "definition": "Modificare, regolare o indirizzare un'azione, un comportamento o un meccanismo per renderlo più efficace, preciso o conforme a uno standard positivo.",
      "examples": [
        "Il navigatore ha permesso al pilota di modificare la traiettoria in tempo utile per evitare la turbolenza.",
        "Con un intervento mirato l'ingegnere è riuscito a compensare le oscillazioni della struttura."
      ],
      "nota": "Uso frequente in ambito tecnico, scientifico e sportivo per indicare l'aggiustamento o la compensazione di parametri."
    },
    {
      "pos": "transitivo",
      "definition": "Rimproverare o richiamare all'ordine qualcuno, in particolare un minore, allo scopo di indirizzarne educativamente la condotta.",
      "examples": [
        "Il genitore ha richiamato all'ordine il figlio per il tono irrispettoso usato a tavola.",
        "Gli educatori hanno il compito di guidare i ragazzi quando assumono atteggiamenti scorretti verso i compagni."
      ],
      "nota": null
    },
    {
      "pos": "intransitivo pronominale",
      "definition": "Riconoscere e modificare autonomamente i propri errori, vizi o abitudini negative per migliorare il proprio comportamento.",
      "examples": [
        "Dopo l'ultimo avvertimento, il ragazzo ha cambiato atteggiamento e ha smesso di arrivare in ritardo.",
        "Nessuno è perfetto, ma è fondamentale dimostrare la volontà di migliorare dopo un errore."
      ],
      "nota": null
    }
  ]
