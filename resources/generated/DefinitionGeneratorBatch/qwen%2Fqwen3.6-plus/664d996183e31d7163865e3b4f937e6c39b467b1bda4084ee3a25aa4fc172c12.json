  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rimuovere sporco, polvere, macchie o sostanze indesiderate da una superficie, un oggetto o un ambiente.",
      "examples": [
        "Prima di partire hanno deciso di pulire a fondo l'appartamento.",
        "Usa un panno in microfibra per pulire il monitor senza graffiarlo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Preparare un alimento eliminando le parti non commestibili, la terra o lo sporco in modo da renderlo pronto alla cottura o al consumo.",
      "examples": [
        "Prima di cucinarlo, è necessario pulire accuratamente il pesce eliminando le viscere.",
        "Ha dedicato il pomeriggio a pulire i funghi raccolti nel bosco."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eliminare errori, refusi, parti superflue o elementi indesiderati da un testo, un documento o un insieme di dati.",
      "examples": [
        "L'editore ha dovuto pulire il manoscritto da diverse imprecisioni storiche.",
        "Il ricercatore ha usato uno script per pulire il dataset prima dell'analisi statistica."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "[registro informale] Asportare completamente oggetti, merci o denaro da un luogo, lasciando vuoto o impoverito chi subisce l'azione.",
      "examples": [
        "I ladri sono entrati di notte e ci hanno pulito il garage in pochi minuti.",
        "Durante i saldi straordinari i clienti hanno pulito gli espositori lasciando poco o nulla."
      ],
      "nota": "L'accezione è frequente nel linguaggio giornalistico e colloquiale per indicare un furto totale o un'acquisizione rapida ed esauriente di merce."
    }
  ]
