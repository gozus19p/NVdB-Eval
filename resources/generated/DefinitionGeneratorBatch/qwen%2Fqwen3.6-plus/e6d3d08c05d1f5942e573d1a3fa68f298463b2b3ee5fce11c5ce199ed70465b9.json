  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Atto di spostarsi rapidamente da un luogo per sottrarsi a un pericolo, a un controllo o a una condizione spiacevole.",
      "examples": [
        "Durante l'alluvione, la fuga degli abitanti verso le zone più elevate è stata immediata e caotica.",
        "I prigionieri hanno organizzato una fuga notturna sfruttando un varco nella recinzione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Comportamento o tendenza psicologica volta a evitare il confronto con aspetti difficili della vita quotidiana, delle proprie emozioni o della società circostante.",
      "examples": [
        "Passare ore sui social network è diventato per lui un meccanismo di fuga dalle responsabilità professionali.",
        "La critica ha definito il romanzo un'opera letteraria segnata da una palese fuga dal contesto storico reale."
      ],
      "nota": "Frequente in locuzioni cristallizzate come 'fuga dalla realtà' o 'fuga dai problemi'."
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Fuoriuscita involontaria e spesso pericolosa di un gas, di un vapore o di un liquido da un contenitore, da una tubatura o da un impianto per guasto o danneggiamento.",
      "examples": [
        "I vigili del fuoco hanno evacuato l'intero palazzo dopo aver rilevato una forte fuga di gas nella cantina.",
        "Il tecnico ha isolato immediatamente la valvola responsabile della fuga d'acqua prima che allagasse il magazzino."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Forma musicale polifonica e contrappuntistica in cui un tema principale viene presentato da una prima voce e successivamente ripreso, imitato e sviluppato in modo sistemico da altre voci o strumenti.",
      "examples": [
        "Lo studente di conservatorio ha dedicato tutto il pomeriggio allo studio e all'esecuzione della fuga in fa minore di Bach.",
        "Il brano si apre con un'introduzione lenta che sfocia in una fuga complessa e rigorosa."
      ],
      "nota": null
    }
  ]
