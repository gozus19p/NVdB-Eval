  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta il colore della neve o del latte, privo di pigmenti scuri o tinte forti.",
      "examples": [
        "Ha acquistato un completo bianco per la cerimonia.",
        "Le cime delle montagne sono rimaste bianche fino a tarda primavera."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di scritte, disegni o qualsiasi contenuto grafico o testuale.",
      "examples": [
        "Ha firmato un assegno in bianco senza specificare la somma.",
        "Lasciamo questa pagina bianca per le note del relatore."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Moralmente puro, innocente o privo di colpe e responsabilità penali.",
      "examples": [
        "Dopo mesi di indagini preliminari, è risultato completamente bianco da ogni addebito.",
        "Pur essendo sotto processo, mantiene la coscienza bianca e agisce con rettitudine."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Colore caratterizzato dalla massima luminosità e riflessione della luce, percepito come assenza di tinta.",
      "examples": [
        "Il bianco della lavagna abbaglia quando entra il sole pomeridiano.",
        "Ha optato per un bianco caldo invece del bianco ottico per le pareti di casa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio non stampato o non scritto su un foglio, un documento o una pagina digitale.",
      "examples": [
        "L'impaginatore ha calcolato i bianchi in modo da rendere la lettura più scorrevole.",
        "Compila i bianchi del modulo con la penna a sfera prima di consegnarlo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "La parte albuminosa, trasparente e viscosa che avvolge il tuorlo dell'uovo.",
      "examples": [
        "Per la ricetta servono solo i tuorli, quindi puoi tenere da parte i bianchi per preparare la meringue.",
        "Il bianco si rapprende completamente a una temperatura inferiore rispetto al centro del tuorlo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona appartenente a gruppi etnici o popolazioni caratterizzate tradizionalmente da carnagione chiara.",
      "examples": [
        "La composizione demografica del quartiere è cambiata, con una significativa presenza di bianchi e immigrati.",
        "Nel dibattito pubblico si è discusso a lungo delle disparità economiche tra neri e bianchi nel corso del secolo scorso."
      ],
      "nota": "Termine di uso frequente in contesti sociologici, demografici e politico-mediatici; assume connotazioni prevalentemente descrittive o critiche in base al quadro discorsivo di riferimento."
    }
  ]
