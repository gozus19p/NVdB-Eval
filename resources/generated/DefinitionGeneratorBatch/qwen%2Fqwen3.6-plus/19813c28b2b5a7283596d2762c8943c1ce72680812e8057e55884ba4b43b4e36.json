  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di qualità o intensità notevolmente superiore alla media, che suscita ammirazione o forte impressione.",
      "examples": [
        "Ha ottenuto un successo notevole in campo artistico.",
        "La sua capacità di risolvere problemi complessi è davvero eccezionale."
      ],
      "nota": "Usato prevalentemente con valenza valutativa positiva."
    },
    {
      "pos": "aggettivo",
      "definition": "Previsto o attuato al di fuori dell'orario, del calendario o delle procedure ordinarie per far fronte a circostanze specifiche o temporanee.",
      "examples": [
        "Il consiglio comunale è stato convocato in seduta speciale per votare il bilancio.",
        "L'università ha pubblicato un bando aggiuntivo per coprire i posti vacanti."
      ],
      "nota": "In opposizione a ordinario in contesti amministrativi, scolastici e lavorativi."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lavoro eseguito oltre l'orario contrattuale previsto, o la relativa compensazione economica.",
      "examples": [
        "Questo mese ho accumulato troppe ore extra e la stanchezza si fa sentire.",
        "Nel contratto è stabilita una maggiorazione del cinquanta per cento per le ore supplementari."
      ],
      "nota": "Attestato quasi esclusivamente al plurale (gli straordinari)."
    }
  ]
