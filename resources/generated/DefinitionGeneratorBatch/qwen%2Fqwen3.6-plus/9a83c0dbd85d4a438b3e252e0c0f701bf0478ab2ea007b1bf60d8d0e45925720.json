  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Procurarsi un bene o un servizio corrispondendo una somma di denaro come prezzo pattuito.",
      "examples": [
        "Ho deciso di acquistare un'auto usata prima dell'inizio della stagione invernale.",
        "I visitatori possono acquistare i biglietti per il museo direttamente sul sito ufficiale."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ottenere, sviluppare o far propria una qualità, una condizione, un riconoscimento o un vantaggio, spesso in seguito a un'esperienza o a un processo graduale.",
      "examples": [
        "Dopo mesi di allenamento intensivo, l'atleta ha acquistato una resistenza fisica eccezionale.",
        "Con il passare degli anni, la piccola impresa ha acquistato una solida credibilità nel settore."
      ],
      "nota": null
    }
