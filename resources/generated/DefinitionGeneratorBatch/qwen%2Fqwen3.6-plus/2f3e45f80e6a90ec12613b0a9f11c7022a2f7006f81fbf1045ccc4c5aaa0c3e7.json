  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi con rapidità o circospezione da un ambiente, una persona o una condizione per mettersi in salvo o sottrarsi a una situazione di pericolo o disagio.",
      "examples": [
        "I turisti hanno dovuto fuggire dalla spiaggia quando è scattato l'allarme tsunami.",
        "Dopo aver perso il lavoro, ha deciso di fuggire dalla capitale e trasferirsi in provincia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Cercare deliberatamente di non affrontare o di eludere un compito, un dovere o una circostanza percepita come gravosa o spiacevole.",
      "examples": [
        "Non puoi continuare a fuggire le responsabilità familiari sperando che qualcun altro risolva i problemi.",
        "Molti preferiscono isolarsi nei social network per fuggire la complessità delle relazioni reali."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Trascorrere o scorrere via con notevole velocità, in modo da risultare quasi impercettibile, detto specialmente del tempo o di periodi della vita.",
      "examples": [
        "Con l'arrivo degli impegni universitari i mesi fuggiscono senza che me ne renda conto.",
        "Mentre ridevamo e raccontavamo vicende del passato, il tempo è fuggito in pochi minuti."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Venire meno improvvisamente alla percezione visiva, al controllo manuale o alla memoria, risultando temporaneamente o definitivamente inaccessibile.",
      "examples": [
        "Il numero di telefono mi è fuggito di mente proprio mentre stavo per chiamare.",
        "La chiave del laboratorio gli è fuggita di mano ed è caduta nel tombino."
      ],
      "nota": "Si presenta frequentemente in costruzioni fissate con la preposizione \"di\" seguita da un sostantivo (di mente, di vista, di mano, dagli occhi)."
    }
  ]
