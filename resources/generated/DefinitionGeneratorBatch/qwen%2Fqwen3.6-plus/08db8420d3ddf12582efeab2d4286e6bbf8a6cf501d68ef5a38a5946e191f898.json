  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Atto di cortesia, servizio o aiuto prestato o richiesto a qualcuno, di norma informale e non dovuto.",
      "examples": [
        "Mi faresti un favore e passeresti a ritirare un pacco in posta?",
        "Le sarò per sempre grato per il favore che mi hai reso quando ero in difficoltà."
      ],
      "nota": "Frequentemente associato a verbi come fare, chiedere, restituire; presuppone una dinamica di reciprocità sociale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Approvazione, simpatia o appoggio manifestato da individui, collettività o autorità verso una persona o un'iniziativa.",
      "examples": [
        "La nuova proposta di legge ha raccolto vasto favore tra i parlamentari.",
        "Dopo lo scandalo finanziario, la società ha perso rapidamente il favore del mercato."
      ],
      "nota": "Comune in contesti istituzionali, mediatici o commerciali; spesso regge complementi introdotti da 'di' o 'presso'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Circostanza o condizione che agevola il successo, arreca beneficio o volge una situazione verso l'esito desiderato.",
      "examples": [
        "Le recenti riforme fiscali giocano nettamente a favore delle piccole imprese.",
        "L'errore di valutazione dell'arbitro ha finito per agire a favore della squadra ospite."
      ],
      "nota": "Utilizzato prevalentemente nelle costruzioni preposizionali 'a favore di' e nella locuzione verbale 'giocare a favore di'."
    }
  ]
