  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Intesa formale o informale tra due o più parti che definisce condizioni comuni, stabilisce impegni reciproci o risolve divergenze.",
      "examples": [
        "Dopo mesi di trattative, le due delegazioni hanno sottoscritto un accordo economico.",
        "Non siamo riusciti a trovare un accordo sull'orario delle consegne."
      ],
      "nota": "Frequente in contesti giuridici, diplomatici e commerciali; nell'uso quotidiano indica anche una semplice intesa verbale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Corrispondenza, sintonia o armonia tra elementi, opinioni, comportamenti o aspetti visivi e uditivi.",
      "examples": [
        "Tra le sue dichiarazioni e i fatti concreti non c'è alcun accordo.",
        "Il designer ha cercato un perfetto accordo tra i toni caldi del legno e le finiture metalliche."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nella teoria musicale, combinazione simultanea di tre o più suoni di altezza diversa considerati funzionalmente come una singola unità armonica.",
      "examples": [
        "Il pianista ha ripetuto l'accordo iniziale fino a trovare la giusta intensità.",
        "Per accompagnare la voce serve un accordo di settima dominante."
      ],
      "nota": "Termine tecnico di uso generalizzato in ambito musicale e nella didattica strumentale."
    }
  ]
