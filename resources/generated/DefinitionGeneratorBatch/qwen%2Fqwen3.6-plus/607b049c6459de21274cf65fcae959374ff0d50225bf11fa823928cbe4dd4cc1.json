  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova racchiuso o situato nella parte più profonda di un corpo, di un oggetto o di uno spazio, in opposizione a ciò che ne costituisce la superficie o l'area circostante.",
      "examples": [
        "La temperatura interna del forno raggiunge i duecento gradi dopo dieci minuti di preriscaldamento.",
        "Il dolore interno alla gamba richiede un'ecografia per escludere una trombosi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Proprio di un determinato gruppo, organizzazione o ambito sociale, che si svolge, ha validità o produce effetti esclusivamente al suo interno senza relazioni dirette con soggetti esterni.",
      "examples": [
        "Il direttivo ha approvato un nuovo codice interno sulla trasparenza dei compensi.",
        "Le frizioni interne alla coalizione hanno ritardato l'uscita del comunicato stampa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Spazio, struttura o parte situata al di là del confine estero di un edificio, di un corpo o di un contenitore.",
      "examples": [
        "L'interno della basilica è stato restaurato dopo il crollo di una sezione dell'intonaco.",
        "Una fessura nella parete lasciava filtrare un po' di aria fresca nell'interno del vano scala."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Locale adibito ad abitazione, in genere appartamento, situato all'interno di un condominio o di un complesso residenziale.",
      "examples": [
        "L'agenzia immobiliare propone un interno luminoso di ottanta metri quadri con doppi servizi.",
        "Hanno visitato un interno al quinto piano prima di procedere con la proposta d'acquisto."
      ],
      "nota": "Diffuso nel linguaggio tecnico-immobiliare e nella contrattazione privata."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Numero telefonico assegnato a una singola postazione o ufficio all'interno di una rete con centralino.",
      "examples": [
        "Per contattare il reparto amministrazione, componga il numero principale e digiti l'interno trecentoquindici.",
        "Il centralinista mi ha passato l'interno del responsabile della logistica senza intoppi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Studente che sostiene un esame presso l'istituto scolastico o universitario in cui ha frequentato regolarmente le lezioni, anziché presso una sede d'esame esterna.",
      "examples": [
        "La maggior parte dei diplomati si iscrive come interno per il colloquio finale dell'anno.",
        "Gli esami per gli esterni e gli interni si svolgono nella stessa aula ma con calendari separati."
      ],
      "nota": "Accezione propria del sistema scolastico e universitario italiano."
    }
  ]
}