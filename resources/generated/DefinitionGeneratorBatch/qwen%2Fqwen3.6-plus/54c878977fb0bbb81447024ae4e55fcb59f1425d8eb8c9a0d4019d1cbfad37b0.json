  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Percossa o urto violento inferto a una persona o a un oggetto, spec. mediante l'uso di un'arma, un attrezzo o una parte del corpo.",
      "examples": [
        "Il pugile ha sferrato un colpo potentissimo che ha atterrato l'avversario.",
        "Il martello ha assestato un colpo violento contro la parete, creando una profonda crepa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Rumore secco e improvviso generato da un impatto violento, da un'esplosione o dallo sparo di un'arma.",
      "examples": [
        "Un rumore secco ha squarciato il silenzio della notte, facendo sobbalzare tutti i presenti.",
        "In lontananza si distingueva chiaramente l'eco degli spari, accompagnata da un boato sordo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Evento improvviso e inatteso che suscita sorpresa, emozione intensa o produce un effetto rilevante; manifestazione breve e repentina di un fenomeno o di uno stato fisico.",
      "examples": [
        "La notizia inattesa gli ha dato un trauma tale che è rimasto senza parole.",
        "Una folata d'aria improvvisa ha rovesciato tutti i documenti sulla scrivania prima che potessimo raccoglierli."
      ],
      "nota": "Ricorre frequentemente in locuzioni cristallizzate come colpo di scena, colpo di fulmine, colpo di tosse/sonno o colpo di telefono, indicando manifestazioni improvvise o inattese."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Azione tecnica, lancio o mossa consistente nel percuotere o inviare un attrezzo, una palla o un pezzo di gioco secondo le regole di una disciplina sportiva o ludica.",
      "examples": [
        "L'attaccante ha chiuso la partita con un intervento di testa decisivo sotto la traversa.",
        "Nel gioco da tavolo ogni partecipante può effettuare un solo lancio per turno prima di passare la mano."
      ],
      "nota": "Tipico del lessico tecnico-sportivo e dei giochi di abilità."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Rapina, furto o azione illecita pianificata e realizzata con abilità e audacia, spec. se volta a un ingente bottino.",
      "examples": [
        "La banda ha organizzato l'operazione nei minimi dettagli, aspettando il momento in cui le guardie sarebbero cambiate turno.",
        "Il quotidiano ha raccontato nei particolari come sia stato pianificato quel furto milionario, definendolo l'azione criminosa più audace degli ultimi anni."
      ],
      "nota": "Registro giornalistico e colloquiale; assume valore metonimico indicando il risultato economico più che la violenza fisica dell'atto."
    }
  ]
