  "senses": [
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Pronunciare una dichiarazione solenne, spesso in contesti istituzionali o legali, per impegnarsi a rispettare un obbligo o per attestare la veridicità di un fatto, invocando un principio etico o sacro come garanzia.",
      "examples": [
        "I nuovi magistrati entrano in carica solo dopo aver giurato sulla Costituzione.",
        "Il testimone è salito al banco per giurare di dire tutta la verità davanti ai giudici."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Affermare o garantire con assoluta certezza la corrispondenza al vero di un'informazione o la sicura realizzazione di un evento.",
      "examples": [
        "Ti giuro che non ho visto il messaggio che mi avevi mandato stamattina.",
        "Giurerei di aver chiuso la porta a chiave, ma ora la trovo aperta."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riporre fiducia incrollabile nell'utilità di un oggetto, nell'efficacia di un metodo o nell'affidabilità di una persona, considerandoli insostituibili dopo un'esperienza positiva.",
      "examples": [
        "Per il mal di schiena non cambio idea: giuro solo su questo materasso ortopedico.",
        "Mio padre giura sulle vecchie ricette scritte a mano per preparare il ragù."
      ],
      "nota": "La costruzione richiede comunemente la preposizione 'su' prima del complemento di riferimento."
    }
  ]
