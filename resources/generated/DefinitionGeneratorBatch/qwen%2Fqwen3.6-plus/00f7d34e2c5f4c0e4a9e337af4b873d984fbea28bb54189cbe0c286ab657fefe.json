  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Titolo nobiliare attribuito al figlio di un sovrano regnante o a chi detiene la sovranità su un piccolo Stato indipendente.",
      "examples": [
        "Il principe ereditario ha presenziato alla cerimonia di inaugurazione del restauro.",
        "Il territorio è rimasto per secoli sotto il governo illuminato del locale signore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona considerata la massima autorità, il punto di riferimento o l'esponente di maggior prestigio in un determinato settore o disciplina.",
      "examples": [
        "Viene universalmente riconosciuto come il massimo esponente della critica letteraria contemporanea.",
        "La conferenza ha radunato i nomi più illustri della neurochirurgia europea."
      ],
      "nota": "Impiegato frequentemente in contesti giornalistici, culturali e della comunicazione; può assumere sfumature ironiche o iperboliche quando attribuito a protagonisti di ambiti effimeri o di intrattenimento."
    },
    {
      "pos": "aggettivo m./f., invariabile",
      "definition": "Che riveste il ruolo preminente, fondamentale o di maggiore rilevanza all'interno di un insieme, di un contesto o di una gerarchia.",
      "examples": [
        "La carenza di personale qualificato resta il nodo cruciale che impedisce il lancio del progetto.",
        "Nel dibattito pubblico è emerso come argomento cardine la riforma del sistema sanitario."
      ],
      "nota": "Forma invariabile che si colloca abitualmente dopo il nome a cui si riferisce; l'impiego è consolidato nel registro scritto, accademico e giornalistico come alternativa enfatica a 'preminente' o 'fondamentale'."
    }
  ]
