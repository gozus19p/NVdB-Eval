  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Facoltà intellettiva di comprendere, valutare e collegare concetti con coerenza logica, distinguendola dall'impulsività o dalle emozioni.",
      "examples": [
        "Con l'età ha imparato a gestire gli stati d'animo e a prendere decisioni guidandosi con la ragione.",
        "Il saggio ha esaminato i limiti della mente umana nel comprendere fenomeni che sfuggono alla pura intelletualità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Motivo, causa o circostanza determinante che spiega un fatto, una scelta o un comportamento.",
      "examples": [
        "Per motivi di sicurezza il cantiere è temporaneamente chiuso al pubblico.",
        "Qual è la vera causa che ti ha spinto a cambiare lavoro così all'improvviso?"
      ],
      "nota": "Ricorrente al plurale quando si indica un insieme di motivazioni concomitanti."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Fondatezza, verità o giustizia di un'opinione o di una posizione durante un confronto o una controversia.",
      "examples": [
        "Dopo aver revisionato i documenti, il direttore ha ammesso che il collaboratore aveva ragione.",
        "In quella discussione nessuno aveva completamente il vero, ma alla fine hanno prevalso i dati oggettivi."
      ],
      "nota": "Costituisce la base semantica di locuzioni cristallizzate nell'uso corrente come 'avere ragione', 'dare ragione' e 'rendersi conto'."
    }
  ]
