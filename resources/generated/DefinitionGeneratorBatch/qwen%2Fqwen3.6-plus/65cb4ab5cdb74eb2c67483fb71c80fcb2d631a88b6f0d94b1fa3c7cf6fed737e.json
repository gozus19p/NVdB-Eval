  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Organo sporgente situato nella parte centrale del viso, preposto all'olfatto e alla respirazione.",
      "examples": [
        "Dopo aver passato ore al freddo, aveva il naso completamente arrossato.",
        "Quando si è chinato per raccogliere la penna, ha battuto la punta del naso sul bordo del tavolo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Parte anteriore e sporgente di un oggetto, in particolare di calzature, veicoli, aeromobili o imbarcazioni.",
      "examples": [
        "Ha preferito le scarpe con il naso arrotondato perché le trova più comode per camminare.",
        "Durante la manovra, il naso dell'aereo ha sfiorato la recinzione di protezione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Capacità intuitiva di percepire, anticipare o valutare con prontezza situazioni, rischi o opportunità.",
      "examples": [
        "Per questo tipo di investimenti ci vuole buon naso e molta esperienza.",
        "Ha avuto il naso di capire in anticipo che l'offerta era solo un espediente pubblicitario."
      ],
      "nota": "Frequente in costruzioni come 'avere buon/cattivo naso', 'averci naso' o 'andare a naso'."
    }
