  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova in una posizione geografica o fisica separata da un notevole intervallo rispetto a un punto di riferimento o a chi osserva.",
      "examples": [
        "La baita si trova in una valle isolata e molto separata dai centri abitati.",
        "Attraverso il binocolo riusciva a distinguere le cime coperte di neve all'orizzonte."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a un'epoca, un evento o un periodo situati a un considerevole intervallo cronologico rispetto al presente o a un momento di riferimento.",
      "examples": [
        "Quei ricordi d'infanzia appartengono ormai a una fase remota della sua vita.",
        "I racconti dei nonni ci proiettano in un'epoca trascorsa che fatica a farsi rivivere."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di attinenza, somiglianza o affinità con una determinata caratteristica, idea o situazione; percepito come concettualmente o ideologicamente estraneo.",
      "examples": [
        "Le sue dichiarazioni sono completamente avulse dalla verità dei fatti.",
        "Questa proposta organizzativa non rispecchia affatto le nostre attuali priorità aziendali."
      ],
      "nota": "Spesso regge la preposizione 'da' per esplicitare il termine di paragone o di distacco."
    },
    {
      "pos": "avverbio",
      "definition": "In una posizione collocata a notevole distanza, nello spazio o nel tempo, rispetto a chi parla o a un punto di riferimento stabilito.",
      "examples": [
        "Molti studenti preferiscono trasferirsi altrove per frequentare un'università prestigiosa.",
        "Durante l'escursione di gruppo non superare il margine del bosco."
      ],
      "nota": null
    }
  ]
