  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Titolo onorifico e vocativo di cortesia impiegato per riferirsi a una donna adulta o per rivolgerle la parola, usato da solo o anteposto al cognome.",
      "examples": [
        "La signora Conti ha ritirato il pacco presso l'ufficio postale.",
        "Mi scusi, signora, avrebbe l'orario aggiornato dei treni per Roma?"
      ],
      "nota": "Corrisponde alle forme inglesi Mrs. o Ms.; è la forma standard in contesti formali, amministrativi e commerciali."
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Donna adulta considerata nella sua fase di maturità, in contrapposizione a bambina o ragazza, talvolta con sfumatura che ne suggerisce compostezza o rispetto sociale.",
      "examples": [
        "Al concerto si vedevano soprattutto signore eleganti con le riviste in mano.",
        "Ha aiutato una signora anziana a salire i gradini della metropolitana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Moglie o compagna di vita, termine usato preferibilmente quando si cita la propria o la donna di un'altra persona in contesti formali, discreti o colloquiali.",
      "examples": [
        "Mia signora è impegnata fino a sera, quindi parteciperò da solo all'inaugurazione.",
        "Il responsabile del personale ha chiesto se alla cerimonia interverrà anche la sua signora."
      ],
      "nota": "Forma alternativa a 'moglie' o 'compagna', tuttora viva in registri medio-formali e in varie zone d'Italia."
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Persona che detiene un'abilità tecnica, intellettuale o creativa eccezionale, riconosciuta come punto di riferimento in un settore specifico.",
      "examples": [
        "Nella conservazione dei dipinti rinascimentali è considerata una signora, i cui metodi fanno scuola in Europa.",
        "Quel regista indipendente è ormai una signora del cinema documentaristico contemporaneo."
      ],
      "nota": "Uso figurato e metaforico, richiede quasi sempre un complemento di specificazione (es. 'della diplomazia', 'del pianoforte') per chiarire l'ambito di competenza."
    }
  ]
