  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che suscita una reazione di scarso apprezzamento estetico alla vista o all'udito; privo di bellezza, armonia o gradevolezza formale.",
      "examples": [
        "Il nuovo palazzo presenta una facciata grigia e sgradevole che contrasta con l'armonia del quartiere.",
        "La voce stonata e stridente dell'oratore ha creato un fastidio generale tra i presenti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che denota tratti negativi, preoccupanti o spiacevoli, riferito a eventi, condizioni atmosferiche, notizie o caratteristiche morali.",
      "examples": [
        "La notizia del fallimento aziendale ha gettato nel panico tutti i dipendenti.",
        "Con il cielo coperto e le nuvole cariche di pioggia, la gita in montagna è fortemente sconsigliata."
      ],
      "nota": null
    }
  ]
