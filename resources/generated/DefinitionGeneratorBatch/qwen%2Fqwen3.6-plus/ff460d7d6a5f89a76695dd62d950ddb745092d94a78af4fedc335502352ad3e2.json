      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda lo studio, la ricerca o i criteri metodologici della disciplina che indaga e ricostruisce le vicende umane del passato.",
      "examples": [
        "Il convegno ha riunito ricercatori per discutere le nuove prospettive dell'indagine accademica sulle fonti primarie.",
        "L'analisi del manoscritto richiede un approccio critico fondato sul confronto archivistico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è attivo, esistente o viene coltivato da lungo tempo, risultando consolidato dalla continuità.",
      "examples": [
        "In quella traversa si trova ancora una panetteria che tramanda la ricetta tradizionale da cinque generazioni.",
        "La rivalità calcistica tra le due città è nota in tutta la regione per la sua intensità e durata."
      ],
      "nota": "Impiegato frequentemente in ambito commerciale, istituzionale o relazionale per indicare attività o legami radicati nel tempo."
    },
    {
      "pos": "sostantivo (m./f.)",
      "definition": "Ricercatore o professionista che si occupa, per vocazione o incarico accademico, dell'indagine e dell'interpretazione delle vicende passate.",
      "examples": [
        "Il docente ha dedicato vent'anni all'archivio di Stato per ricostruire le origini del borgo medievale.",
        "La ricercatrice ha pubblicato un volume definitivo sulla diplomazia rinascimentale, ottenendo riconoscimenti internazionali."
