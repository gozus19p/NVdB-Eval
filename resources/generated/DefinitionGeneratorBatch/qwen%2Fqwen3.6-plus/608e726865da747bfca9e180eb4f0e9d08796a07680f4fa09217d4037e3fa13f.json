  "senses": [
    {
      "pos": "verbo (intransitivo, transitivo)",
      "definition": "Produrre suoni organizzati in sequenze melodiche e ritmiche utilizzando la voce umana.",
      "examples": [
        "Mia sorella canta nel coro della parrocchia da dieci anni.",
        "I bambini hanno cantato insieme tutta la serata per festeggiare il compleanno della maestra."
      ],
      "nota": null
    },
    {
      "pos": "verbo (intransitivo)",
      "definition": "Emettere suoni ripetitivi e modulati tipici di alcuni animali, insetti o oggetti in funzione.",
      "examples": [
        "Dopo il tramonto i grilli cantano tra l'erba alta.",
        "La caffettiera inizia a cantare appena l'acqua raggiunge la temperatura di ebollizione."
      ],
      "nota": "Usato prevalentemente in contesti descrittivi e narrativi."
    },
    {
      "pos": "verbo (intransitivo)",
      "definition": "Rivelare informazioni riservate o confessare responsabilità, specialmente sotto interrogatorio o pressione.",
      "examples": [
        "Dopo ore di domande insistenti, il sospettato ha finalmente cantato.",
        "Stai attento a chi confidi i tuoi piani, perché potrebbe cantare con le autorità."
      ],
      "nota": "Registro informale e colloquiale, frequente in contesti investigativi, giornalistici o narrativi di genere."
    }
  ]
