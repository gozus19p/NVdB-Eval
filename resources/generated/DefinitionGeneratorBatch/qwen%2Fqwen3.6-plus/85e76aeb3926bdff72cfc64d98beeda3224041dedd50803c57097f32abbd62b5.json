  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che comprende la totalità degli elementi, della durata o dell'estensione di qualcosa, senza omissioni o limitazioni.",
      "examples": [
        "Abbiamo trascorso l'intera giornata al mare senza fare altro.",
        "L'intero quartiere è rimasto senza elettricità per diverse ore."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Non spezzato, non frammentato o non danneggiato nella sua struttura fisica originale.",
      "examples": [
        "Dopo la caduta, il vaso di ceramica è rimasto miracolosamente intero.",
        "Per facilitare il trasloco preferiamo spostare i mobili interi anziché smontarli."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Entità o quantità considerata nella sua completezza e unità, in contrapposizione alle singole parti che la compongono.",
      "examples": [
        "La somma delle varie porzioni deve corrispondere esattamente all'intero.",
        "Prima di approvare il piano, la commissione vuole valutare l'intero e non solo i dettagli isolati."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "In matematica, numero appartenente all'insieme che comprende i naturali, i loro opposti e lo zero, privo di parte frazionaria o decimale.",
      "examples": [
        "Il docente ha illustrato come operare con gli interi positivi e negativi alla lavagna.",
        "Nella risoluzione dell'equazione sono stati scartati i decimali, mantenendo solo gli interi."
      ],
      "nota": "Ampio uso in contesti scolastici e scientifici; l'insieme di tali numeri è indicato convenzionalmente con il simbolo ℤ."
    }
  ]
