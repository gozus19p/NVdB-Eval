    {
      "pos": "sostantivo m.",
      "definition": "Struttura rigida e compatta, formata da tessuto in prevalenza calcificato, che unita alle altre compone lo scheletro dei vertebrati e ne garantisce sostegno e movimento.",
      "examples": [
        "Dopo la caduta sulle scale, il medico ha diagnosticato la frattura di un osso della caviglia.",
        "Il cane ha sepolto un osso avanzato dal pranzo nel giardino per consumarlo più tardi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Situazione particolarmente complessa da risolvere o individuo dai tratti caratteriali restii e difficili da gestire o convincere.",
      "examples": [
        "Quella pratica amministrativa si è rivelata un osso difficile da masticare per il nuovo ufficio.",
        "Non provare a fargli cambiare idea subito, è un osso duro e non cederà facilmente alle pressioni."
      ],
      "nota": "Compare frequentemente in locuzioni cristallizzate ('osso duro', 'masticare l'osso') con sfumatura pragmatica di sfida o resistenza."
    }
