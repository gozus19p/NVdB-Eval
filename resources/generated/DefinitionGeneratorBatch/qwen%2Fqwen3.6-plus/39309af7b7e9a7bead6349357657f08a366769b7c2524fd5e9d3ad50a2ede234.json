  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Proprietà fisica della materia e della radiazione luminosa che determina la percezione visiva di tonalità come il rosso, il blu o il giallo.",
      "examples": [
        "Il colore del cielo al tramonto era particolarmente intenso.",
        "I bambini stavano imparando a riconoscere i colori primari a scuola."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sostanza o preparato chimico-naturale usato per tingere, pitturare o rivestire superfici, modificandone l’aspetto visivo.",
      "examples": [
        "Per ristrutturare la camera abbiamo scelto un colore lavabile e resistente all'umidità.",
        "L'artista ha diluito il colore con trementina per ottenere un effetto più trasparente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Tonalità o aspetto della pelle, specialmente del volto, che può rivelare condizioni di salute, reazione emotiva o caratteristiche fisiche.",
      "examples": [
        "Al ritorno dalle vacanze mostrava un colore della pelle molto più scuro.",
        "Lo spavento improvviso gli ha tolto ogni colore dal volto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Carattere, atmosfera o orientamento distintivo che connota un ambiente, un evento, un’opera o un’idea, specialmente in ambito politico, culturale o sociale.",
      "examples": [
        "La cerimonia ha mantenuto un colore sobrio nonostante la grande affluenza.",
        "Nelle settimane successive, le proteste hanno assunto un colore politico sempre più radicale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nei giochi di carte, ciascuno dei semi (come cuori, quadri, fiori o picche) che identificano le carte e ne regolano l'obbligo di risposta.",
      "examples": [
        "Devi rispondere con una carta dello stesso colore per non perdere la mano.",
        "In quel gioco è fondamentale contare quante carte mancano del colore avversario."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Apparenza o motivo fittizio utilizzato per mascherare la vera natura o le reali intenzioni di un’azione o discorso.",
      "examples": [
        "Hanno effettuato il sopralluogo sotto il colore di una verifica standard, ma cercavano prove di irregolarità.",
        "Sotto il colore di un consiglio amichevole, le ha comunicato in realtà una decisione già presa."
      ],
      "nota": null
    }
  ]
