  "senses": [
    {
      "pos": "verbo (intransitivo)",
      "definition": "Assumere e mantenere una posizione statica con il peso del corpo sostenuto dalle natiche e dalle cosce, generalmente su un mobile o una superficie rialzata.",
      "examples": [
        "Durante la conferenza ho preferito sedere in fondo alla sala per ascoltare con più tranquillità.",
        "I relatori possono sedere liberamente ai posti disponibili prima dell'inizio dei lavori."
      ],
      "nota": "Nell'uso quotidiano parlato è frequentemente sostituito dalla forma pronominale 'sedersi'."
    },
    {
      "pos": "verbo (intransitivo)",
      "definition": "Occupare stabilmente una carica, un incarico o un posto all'interno di un'assemblea, un organo collegiale o un'istituzione rappresentativa.",
      "examples": [
        "Da due mandati siede in consiglio regionale senza aver mai presentato un disegno di legge proprio.",
        "Il membro anziano che siede al comitato etico ha votato a favore della proposta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Regione anatomica posteriore del corpo umano, formata dai glutei, che costituisce il naturale punto di appoggio quando il busto è in posizione verticale o reclinata.",
      "examples": [
        "Dopo tre ore di cammino in salita sentivo già il sedere indolenzito e avevo bisogno di una pausa.",
        "Quella panca di legno è troppo dura, mi ha fatto male al sedere."
      ],
      "nota": "Termine di registro neutro o leggermente informale, impiegato comunemente come alternativa educata o attenuativa a vocaboli più volgari."
    }
