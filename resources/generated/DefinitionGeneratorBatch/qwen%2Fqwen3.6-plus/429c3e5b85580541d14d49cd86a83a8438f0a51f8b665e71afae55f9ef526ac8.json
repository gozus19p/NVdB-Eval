  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Struttura calcificata e dura situata nelle arcate boccali dei vertebrati, adibita principalmente alla triturazione del cibo e, in numerose specie, alla cattura della preda o alla difesa.",
      "examples": [
        "Masticando una noce troppo dura, mi sono scheggiato un dente e ora devo rivolgermi al dentista.",
        "I lupi e i cani selvatici mostrano subito questi organi appuntiti quando un estraneo invade il loro territorio."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Elemento sporgente e regolare disposto lungo il bordo o la superficie di un utensile, di un attrezzo o di un componente meccanico, concepito per tagliare, districare, agganciare o trasmettere forza motrice.",
      "examples": [
        "La lama della sega circolare ha perso un dente durante il lavoro e ora vibra pericolosamente tranciando il legno.",
        "Per districare i capelli bagnati senza spezzarli, i professionisti consigliano vivamente l'uso di un pettine a denti larghi."
      ],
      "nota": null
    }
  ]
