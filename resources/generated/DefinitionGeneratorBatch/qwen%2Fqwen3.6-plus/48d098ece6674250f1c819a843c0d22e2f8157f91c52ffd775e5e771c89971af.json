  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Privo di sostanze estranee, impurezze o alterazioni; integro nella sua composizione originale.",
      "examples": [
        "Per la ricetta servono ottanta grammi di miele puro, senza aggiunte di zucchero.",
        "L'aria pura delle alte quote ha subito alleviato il suo mal di testa."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Privo di colpe, malizie o intenzioni illecite; moralmente integro e sincero.",
      "examples": [
        "Nonostante le accuse infondate, ha sempre conservato un animo puro e leale.",
        "I bambini agivano mossi da un affetto puro, senza secondi fini."
      ],
      "nota": "Usato spesso in contesti letterari, religiosi o psicologici per descrivere l'innocenza o la trasparenza intenzionale."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si presenta in forma assoluta e senza commistioni; impiegato per marcare la natura esclusiva o schietta di una circostanza o qualità astratta.",
      "examples": [
        "La sua promozione è stata frutto di puro caso, non di preparazione specifica.",
        "Si tratta di una pura speculazione teorica, lontana dalla pratica quotidiana."
      ],
      "nota": "Funziona come intensificatore restrittivo anteponendosi a sostantivi astratti, con valore simile a 'semplice', 'assoluto' o 'esclusivo'."
    }
  ]
