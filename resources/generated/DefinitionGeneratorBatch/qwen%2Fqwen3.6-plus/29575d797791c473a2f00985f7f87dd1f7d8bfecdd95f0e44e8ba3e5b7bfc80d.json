  "senses": [
    {
      "pos": "verbo transitivo / intransitivo",
      "definition": "Evitare intenzionalmente il contatto o l’esposizione a persone, situazioni o responsabilità percepite come minacciose, spiacevoli o vincolanti.",
      "examples": [
        "Ha fatto di tutto per sfuggire ai creditori dopo la chiusura della sua attività.",
        "L'azienda ha tentato di sfuggire alle responsabilità legali trasferendo la sede in un altro Stato."
      ],
      "nota": "Si costruisce frequentemente con la preposizione \"a\" o direttamente con il complemento oggetto, a seconda del registro e della tradizione d'uso."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Lasciare accidentalmente la presa o il controllo diretto, oppure sottrarsi rapidamente a una condizione di costrizione fisica o materiale.",
      "examples": [
        "Il bicchiere di vetro mi è sfuggito di mano mentre cercavo di aprire la finestra.",
        "Il cane è sfuggito al guinzaglio e si è nascosto sotto un'auto parcheggiata."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo (con dativo di riferimento)",
      "definition": "Restare al di fuori della percezione, della memoria o della comprensione di qualcuno; non essere afferrato concettualmente o passare inosservato.",
      "examples": [
        "Il significato di quella frase tecnica mi sfugge completamente.",
        "Non sfugge a nessuno il cambio di atteggiamento mostrato dalla dirigenza nelle ultime settimane."
      ],
      "nota": "Spesso adoperato in forma negativa o interrogativa retorica per ribadire che un aspetto è in realtà evidente o pienamente comprensibile."
    }
  ]
