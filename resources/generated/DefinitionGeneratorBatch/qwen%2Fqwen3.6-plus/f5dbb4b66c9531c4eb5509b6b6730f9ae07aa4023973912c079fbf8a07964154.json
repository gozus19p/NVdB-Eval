  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Ancorare saldamente un oggetto a una struttura o renderne stabile la posizione, impedendone spostamenti o vibrazioni involontarie.",
      "examples": [
        "Basta avvitare due tasselli per ancorare il quadro alla parete in sicurezza.",
        "Prima di partire, l'autotrasportatore deve bloccare bene il carico sul rimorchio con delle cinghie."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Stabilire in modo definitivo e concordato una scadenza, un valore economico, un luogo o una normativa.",
      "examples": [
        "Abbiamo programmato la riunione per giovedì prossimo alle undici in sala conferenze.",
        "Il nuovo decreto stabilisce requisiti più severi per le certificazioni energetiche degli edifici."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rivolgere lo sguardo in modo prolungato e intenso verso una persona o un oggetto, mantenendo l'attenzione visiva immobile e concentrata.",
      "examples": [
        "Il gatto continuava a osservare con attenzione il punto esatto dove era scomparso il topo.",
        "In molti contesti sociali, guardare intensamente uno sconosciuto è considerato una mancanza di educazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Imprimere indelebilmente nella mente un ricordo, un concetto o un'esperienza per evitarne la dimenticanza.",
      "examples": [
        "Ripassare le formule prima della verifica serve a conservarle nella memoria a lungo termine.",
        "Quell'esperienza drammatica gli ha scolpito indelebilmente l'immagine del volto di suo padre."
      ],
      "nota": "Ricorre frequentemente in combinazione con le espressioni 'in mente', 'nella memoria' o 'nella testa'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sottoporre una pellicola fotografica o un materiale sensibile alla luce a un trattamento chimico che ne arresta il processo di sviluppo, rendendo l'immagine permanente e non più alterabile.",
      "examples": [
        "Dopo lo sviluppo, i rullini vanno immersi nel bagno di arresto e poi in una soluzione che stabilizza l'immagine.",
        "Un tempo nei laboratori scolastici si insegnava a rendere permanenti le stampe in bianco e nero seguendo procedure precise."
      ],
      "nota": "Termine tecnico proprio della fotografia analogica e del trattamento chimico-industriale di superfici, tessuti e materiali sensibili."
    }
