  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Facoltà fisiologica di percepire stimoli luminosi e di distinguere forme, colori e distanze tramite gli organi dell'occhio.",
      "examples": [
        "Con l'avanzare dell'età, molti pazienti lamentano un progressivo calo della visione notturna.",
        "La terapia farmacologica ha migliorato significativamente la sua visione periferica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Atto concreto di osservare con gli occhi o immagine che si presenta alla consapevolezza durante tale osservazione.",
      "examples": [
        "La visione del panorama dalla terrazza è stata il momento più atteso della vacanza.",
        "Durante la camminata in montagna, ogni visione di un rifugio ci ridava slancio per raggiungere la meta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Proiezione pubblica o trasmissione televisiva di un'opera audiovisiva; condizione che consente al pubblico di assistervi.",
      "examples": [
        "La nuova stagione della serie arriverà in visione esclusiva sulla piattaforma streaming a partire da venerdì.",
        "Il regista ha partecipato alla prima visione in sala per presentare il cast ai giornalisti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Prospettiva strutturata o quadro mentale adottato per analizzare, giudicare o organizzare la realtà, i fenomeni sociali o i progetti futuri.",
      "examples": [
        "Il documento programmatico espone una visione chiara e innovativa per il futuro del settore energetico.",
        "I due partiti partono da una visione opposta riguardo alla riforma del sistema sanitario."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Percezione improvvisa di contenuti non fisicamente presenti, riconducibile a esperienze mistiche, stati onirici o alterazioni temporanee della coscienza.",
      "examples": [
        "I mistici descrivevano nei loro diari le intense apparizioni interiori vissute durante la preghiera.",
        "Dopo giorni di febbre alta, il paziente ha riferito al medico di aver sofferto di ricorrenti allucinazioni notturne."
      ],
      "nota": null
    }
  ]
