  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Serie ordinata di voci, nomi, dati o oggetti, redatta su un supporto cartaceo o digitale per facilitare la consultazione, il controllo o la memorizzazione.",
      "examples": [
        "Prima di andare al supermercato ho aggiunto il caffè all'elenco della spesa.",
        "Il segretario ha stampato la lista dei presenti prima di iniziare la riunione."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Raggruppamento di candidati che si presentano uniti in una competizione elettorale o sindacale sotto un medesimo simbolo e programma.",
      "examples": [
        "Alle comunali di quest'anno si sono presentate cinque liste civiche.",
        "L'elettore può assegnare una preferenza a un singolo capolista."
      ],
      "nota": "In ambito politico, il termine indica sia l'insieme dei candidati sia l'organizzazione che li sostiene."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Striscia sottile e allungata di materiale flessibile, come tessuto, carta, cuoio o metallo, impiegata solitamente per rifiniture, decorazioni o chiusure.",
      "examples": [
        "Per rinforzare il bordo della giacca ha cucito una lista di velluto nero.",
        "Il pacco è stato sigillato con una lista di carta adesiva trasparente."
      ],
      "nota": null
    }
