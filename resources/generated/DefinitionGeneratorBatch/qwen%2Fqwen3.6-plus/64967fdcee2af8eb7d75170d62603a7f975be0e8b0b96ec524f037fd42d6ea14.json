  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione fisica di lieve dolore, irritazione o disagio localizzato in una parte del corpo.",
      "examples": [
        "Dopo la lunga camminata ho avvertito un fastidio al ginocchio destro.",
        "Il medico mi ha consigliato un gel per alleviare il fastidio cutaneo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Stato psicologico di irritazione, contrarietà o lieve repulsione suscitato da una persona, un comportamento o una situazione.",
      "examples": [
        "Provo un certo fastidio quando qualcuno interrompe continuamente il discorso.",
        "Ho deciso di cambiare posto perché l'ambiente troppo rumoroso mi metteva a disagio."
      ],
      "nota": "Frequentemente selezionato dai verbi 'provare', 'sentire' o 'dare'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona, oggetto o circostanza considerata fonte di disturbo, intralcio o seccatura pratica.",
      "examples": [
        "Queste pratiche burocratiche sono un fastidio che ci fa perdere tempo prezioso.",
        "Non voglio essere un fastidio per te, quindi organizziamo l'incontro con calma."
      ],
      "nota": null
    }
  ]
