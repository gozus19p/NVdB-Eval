  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Lato o porzione di spazio che corrisponde alla mano con cui la maggior parte delle persone scrive o maneggia gli utensili.",
      "examples": [
        "Siediti pure alla mia destra, così possiamo parlare meglio.",
        "Il semaforo era visibile solo svoltando appena dopo il ponte verso quella parte."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Schieramento politico, o insieme di partiti e ideologie, tradizionalmente caratterizzato da posizioni conservatrici, liberiste in economia o nazionaliste.",
      "examples": [
        "Gli elettori di quest'area hanno sostenuto con convinzione la nuova coalizione.",
        "Il dibattito in aula è stato dominato dagli interventi delle forze conservatrici e dei partiti di opposizione."
      ],
      "nota": "Il termine nasce dalla consuetudine ottocentesca di far sedere i gruppi parlamentari conservatori sui sedili posti a lato del presidente dell'assemblea rispetto al centro della sala."
    },
    {
      "pos": "aggettivo (f. sing.)",
      "definition": "Che si trova, o appartiene, alla parte del corpo o dell'oggetto opposta a quella in cui è situato il cuore.",
      "examples": [
        "Dopo la caduta si è procurato una leggera distorsione alla caviglia.",
        "La ruota anteriore dell'auto ha sbandato sul bagnato per qualche metro prima di riprendere aderenza."
      ],
      "nota": "Forma flessa femminile singolare utilizzata per concordare con nomi del medesimo genere e numero; impiego sistematicamente contrapposto al correlato 'sinistra'."
    }
  ]
