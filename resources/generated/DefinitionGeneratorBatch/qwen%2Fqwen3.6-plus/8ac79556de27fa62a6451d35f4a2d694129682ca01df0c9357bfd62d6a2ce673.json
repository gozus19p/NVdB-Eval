  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Facoltà della mente umana di determinare consapevolmente le proprie azioni, controllando gli impulsi e perseguendo un obiettivo con costanza.",
      "examples": [
        "Per superare le difficoltà ha fatto affidamento sulla forza di volontà e sulla disciplina quotidiana.",
        "La mancanza di volontà rende vana anche la preparazione più accurata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Desiderio determinato e intenzione ferma di compiere una specifica azione o di realizzare un determinato scopo.",
      "examples": [
        "Ha comunicato ufficialmente la volontà di dimettersi al termine del trimestre.",
        "Nonostante le obiezioni, la volontà di avviare l’impresa è rimasta incrollabile."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Predisposizione positiva e disponibilità interiore a collaborare, a impegnarsi o ad aiutare gli altri.",
      "examples": [
        "Il successo della campagna dipende dalla buona volontà di tutti i partecipanti.",
        "Si è dedicato al recupero del quartiere con una sincera volontà di migliorare la vita degli abitanti."
      ],
      "nota": "Spesso preceduta dall'aggettivo 'buona' per sottolineare la disponibilità verso il prossimo o verso un compito specifico."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Disposizione, di norma testamentaria, con cui una persona decide la destinazione dei propri beni o esprime desideri da attuarsi dopo la morte.",
      "examples": [
        "Il notaio ha letto in udienza le ultime volontà del defunto, disponendo la devoluzione dell’eredità a favore dell’ente benefico.",
        "Gli eredi si sono adoperati per rispettare fino in fondo la volontà della zia, devolvendo le somme ai progetti da lei indicati."
      ],
      "nota": "Ricorre prevalentemente nelle locuzioni fisse 'ultima volontà' o 'ultime volontà', anche al di fuori di strettissimi contesti notarili."
    }
  ]
