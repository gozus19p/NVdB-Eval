  },
  "senses": [
    {
      "pos": "aggettivo",
      "definition": "che si trova o avviene a breve distanza nello spazio o nel tempo rispetto a un termine di riferimento",
      "examples": [
        "La metropolitana è così vicina che ci arrivo a piedi in dieci minuti.",
        "Le scadenze fiscali sono ormai vicine."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che condivide orientamenti ideali, gusti o sentimenti affettivi con qualcuno o qualcosa, manifestando forte affinità o sostegno",
      "examples": [
        "I due partiti sono molto vicini su questo tema.",
        "Si sente molto vicino alle cause ambientaliste."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "individuo la cui abitazione o sede operativa si colloca nelle immediate vicinanze di un luogo specifico",
      "examples": [
        "Domani organizzeremo una cena per tutti i vicini del palazzo.",
        "Ha bussato alla porta per chiedere un attrezzo al vicino."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "a breve distanza, in prossimità del punto, dell'oggetto o del momento considerato",
      "examples": [
        "Siediti più vicino al camino, fa davvero freddo.",
        "Hanno piantato gli alberi troppo vicino al muro di casa."
      ],
      "nota": "ricorre sistematicamente in costruzioni preposizionali con 'a' quando regge un complemento esplicito, e accetta regolarmente avverbi di grado come 'molto' o 'più'"
    }
  ]
