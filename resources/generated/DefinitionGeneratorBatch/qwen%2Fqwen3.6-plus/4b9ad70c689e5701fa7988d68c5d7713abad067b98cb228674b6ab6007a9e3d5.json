  "senses": [
    {
      "pos": "verbo intransitivo e transitivo",
      "definition": "Affrontare un avversario o un esercito in conflitto con le armi o con la forza fisica.",
      "examples": [
        "I soldati hanno combattuto in difesa del confine per settimane.",
        "La fanteria leggera combatté il nemico in un terreno impervio."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Impegnarsi con determinazione per contrastare, eliminare o sconfiggere un fenomeno negativo, una malattia, un'ingiustizia o un ostacolo concreto o astratto.",
      "examples": [
        "Le associazioni locali combattono il degrado urbano con progetti di riqualificazione.",
        "Molti pazienti combattono contro i sintomi della malattia cronica."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Prendere parte a una competizione sportiva, agonistica o elettorale mettendo in campo il massimo sforzo per prevalere.",
      "examples": [
        "La squadra ha combattuto fino al novantesimo minuto per conquistare il pareggio.",
        "I candidati hanno combattuto una campagna elettorale molto accesa."
      ],
      "nota": "Uso frequente nei registri giornalistico e sportivo."
    },
    {
      "pos": "verbo pronominale",
      "definition": "Affrontarsi reciprocamente in uno scontro fisico o verbale tra due o più parti.",
      "examples": [
        "I due eserciti si sono combattuti nella pianura per giorni.",
        "Le due fazioni politiche si combattono aspramente in parlamento."
      ],
      "nota": null
    }
  ]
