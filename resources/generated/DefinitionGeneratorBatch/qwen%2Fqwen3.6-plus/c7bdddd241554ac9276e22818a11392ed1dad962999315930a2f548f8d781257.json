  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona riconosciuta come membro a pieno titolo di uno Stato, con conseguenti diritti e obblighi giuridici, politici e sociali.",
      "examples": [
        "Tutti i cittadini maggiorenni sono chiamati alle urne per eleggere i rappresentanti del Parlamento.",
        "La recente riforma pensionistica ha suscitato numerose perplessità tra i cittadini prossimi alla quiescenza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Abitante di un centro abitato di medie o grandi dimensioni, considerato nella sua interazione con i servizi locali e la vita quotidiana.",
      "examples": [
        "I cittadini del quartiere hanno organizzato una raccolta firme per chiedere la pedonalizzazione della zona storica.",
        "L'assessore all'ambiente ha invitato ogni cittadino a differenziare correttamente i rifiuti per migliorare il decoro urbano."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che si riferisce allo spazio urbano, alla sua organizzazione territoriale o alle infrastrutture di un determinato nucleo abitativo.",
      "examples": [
        "Il traffico cittadino peggiora sensibilmente durante le festività e nei fine settimana.",
        "Il comune ha stanziato fondi ingenti per la manutenzione della rete idrica cittadina."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che riguarda la sfera pubblica, la partecipazione alla vita collettiva e il rispetto delle norme di convivenza comune.",
      "examples": [
        "Le scuole promuovono progetti didattici per sviluppare una maggiore responsabilità e un comportamento cittadino maturo.",
        "Il dibattito cittadino sul recupero degli spazi pubblici è diventato un tema centrale della campagna elettorale."
      ],
      "nota": "Tipicamente associato a sostantivi astratti come 'coscienza', 'impegno', 'dovere' o 'educazione' per enfatizzare la dimensione civica e relazionale dell'individuo."
    }
  ]
