  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo alla Cina, alla sua cultura, storia, istituzioni o prodotti.",
      "examples": [
        "I turisti apprezzano particolarmente i piatti tipici della cucina cinese.",
        "Il governo cinese ha annunciato nuove misure per il commercio estero."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m. e f.",
      "definition": "Persona originaria della Cina o che ne possiede la cittadinanza.",
      "examples": [
        "Molti studenti cinesi scelgono le università europee per conseguire un master.",
        "Il mio nuovo collega è cinese e si è trasferito a Milano due anni fa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lingua sinotibetana parlata ufficialmente in Cina e a Taiwan, diffusa anche nelle comunità diasporiche e caratterizzata da un sistema di scrittura logografico.",
      "examples": [
        "Ho deciso di iscrivermi a un corso di cinese per il prossimo semestre.",
        "Imparare il cinese richiede anni di pratica costante e memorizzazione dei caratteri."
      ],
      "nota": "Il termine funge da iperonimo per la famiglia linguistica, che comprende varietà come il mandarino e il cantonese."
    },
    {
      "pos": "aggettivo",
      "definition": "Detto di scrittura, testo o discorso estremamente difficile da leggere, decifrare o comprendere.",
      "examples": [
        "La calligrafia del dottore è diventata così illeggibile che sembra proprio cinese.",
        "Il manuale d'uso è scritto con un gergo talmente specialistico da risultare cinese per un profano."
      ],
      "nota": "Uso figurato e prevalentemente colloquiale, impiegato per enfatizzare l'incomprensibilità semantica o la cattiva grafia."
    }
  ]
