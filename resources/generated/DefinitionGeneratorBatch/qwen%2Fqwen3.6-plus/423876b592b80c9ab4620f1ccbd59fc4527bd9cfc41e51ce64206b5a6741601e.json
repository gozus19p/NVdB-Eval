  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che presenta una notevole estensione nel senso trasversale o orizzontale; non angusto o limitato.",
      "examples": [
        "In questo tratto il fiume scorre in un alveo molto esteso.",
        "La nuova carreggiata permette il transito di tre veicoli affiancati."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Di indumento o calzatura, avente dimensioni superiori a quelle necessarie per contenere il corpo; non aderente.",
      "examples": [
        "Ho dovuto cambiare taglia perché la giacca risultava un po' troppo abbondante sulle spalle.",
        "Queste scarpe mi stringono, domani ne cercherò un modello più comodo."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Figurato: abbondante, generoso o caratterizzato da apertura e disponibilità, spec. riferito a idee, risorse o atteggiamenti.",
      "examples": [
        "Il dirigente ha concesso permessi generosi durante le festività natalizie.",
        "Durante la riunione ha dimostrato vedute molto aperte sulle nuove strategie aziendali."
      ],
      "nota": "Frequente in locuzioni cristallizzate come 'essere di man larga' o 'avere vedute ampie'."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Ampio spazio libero o distanza dai margini che delimitano un'area circoscritta.",
      "examples": [
        "I bambini potevano giocare in sicurezza nel piazzale sgombro davanti alla scuola.",
        "Per manovrare il furgone serve uno spazio notevole, altrimenti si rischia di strisciare contro i muri."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Zona di mare aperta e distante dalla costa, non soggetta a ripari o insenature.",
      "examples": [
        "Le condizioni meteorologiche sono proibitive al largo, mentre la costa rimane calma.",
        "Il peschereccio ha gettato l'ancora lontano dalla riva per ripararsi dal vento."
      ],
      "nota": "Quasi sempre introdotto dalla preposizione 'al' e tipico del linguaggio nautico o meteorologico."
    },
    {
      "pos": "avverbio",
      "definition": "A distanza di sicurezza o in posizione defilata rispetto a un riferimento centrale o a un pericolo potenziale.",
      "examples": [
        "Durante il taglio della legna, tieniti a distanza dai frammenti che schizzano via.",
        "Il cane ha evitato di passare in mezzo al sentiero per non intralciare i passanti."
      ],
      "nota": "Comunemente combinato con verbi di moto o posizione come 'tenersi', 'stare' o 'girare'."
    },
    {
      "pos": "avverbio",
      "definition": "Formula di comando usata per ordinare a terzi di allontanarsi o di liberare il passaggio.",
      "examples": [
        "Lasciate passare l'ambulanza, fate spazio!",
        "All'uscita dello stadio il personale ha ripetuto il comando per far defluire la folla."
      ],
      "nota": "Funziona sintatticamente come interiezione indipendente, spesso in contesti di emergenza o gestione di assembramenti."
    }
  ]
