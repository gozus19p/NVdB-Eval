  "senses": [
    {
      "pos": "verbo intransitivo (con *che*, *di*) / transitivo",
      "definition": "Ritenere vero, probabile o possibile un fatto o un'informazione, basandosi su deduzioni, impressioni o fonti non verificate.",
      "examples": [
        "Credo che il treno arriverà in ritardo a causa del maltempo.",
        "Non credo di aver lasciato il gas aperto, controlliamo comunque."
      ],
      "nota": "Nel registro colloquiale e formale è frequentemente usato con valore attenuativo o di cortesia per presentare un'opinione personale senza imporla come certezza assoluta."
    },
    {
      "pos": "verbo transitivo / intransitivo (con *in*, *a*)",
      "definition": "Nutrire fiducia nelle capacità, nell'onestà o nelle intenzioni di qualcuno, riconoscendone l'affidabilità.",
      "examples": [
        "Il direttore crede nei giovani e li promuove fin dall'ingresso in azienda.",
        "Ti credo sulla parola, anche se la circostanza sembra poco plausibile."
      ],
      "nota": "La costruzione transitiva diretta o con la preposizione *a* si focalizza sulla veridicità immediata delle dichiarazioni altrui; l'uso con *in* esprime una fiducia progettuale, di supporto morale o di stima duratura."
    },
    {
      "pos": "verbo intransitivo (con *in*, *a*)",
      "definition": "Professare un'adesione profonda a una religione, a una divinità o a un sistema di principi etici e valoriali.",
      "examples": [
        "Non segue un culto organizzato, ma crede fermamente in un principio di armonia universale.",
        "Questa associazione crede nel dialogo come unico strumento per risolvere i conflitti sociali."
      ],
      "nota": "Si distingue dall'uso meramente intellettuale per la componente spirituale, valoriale o dottrinale implicata, tipica del linguaggio religioso, filosofico o dell'impegno civile."
    }
  ]
