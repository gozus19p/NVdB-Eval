  "senses": [
    {
      "pos": "avverbio",
      "definition": "In posizione frontale o anteriore nello spazio, oppure in condizione di precedere altri elementi in una graduatoria, ordine o successione temporale, rispetto a un punto di riferimento esplicito o sottinteso.",
      "examples": [
        "Ho lasciato le chiavi sul tavolo davanti, così le trovi appena entri.",
        "Nonostante l'inizio incerto, la squadra ha mantenuto il primo posto e ora è davanti in classifica."
      ],
      "nota": "Nell'uso sintattico si combina frequentemente con la preposizione 'a' per introdurre un complemento di luogo (es. 'davanti a casa')."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "La faccia, la superficie o la sezione anteriore e frontalmente visibile di un oggetto, di un capo di abbigliamento o di una struttura.",
      "examples": [
        "Mangiando con frettolosità, si è versato il sugo proprio sul davanti della camicia.",
        "Il davanti del mobile è in legno massello, mentre i lati sono in compensato verniciato."
      ],
      "nota": "Utilizzato prevalentemente in contesti legati all'abbigliamento, all'arredamento e all'architettura; opposto concettuale di 'dietro' o 'schiena'."
    }
  ]
