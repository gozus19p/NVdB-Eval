  "senses": [
    {
      "pos": "aggettivo qualificativo (attributivo e predicativo, accordo regolare)",
      "definition": "Che manifesta malvagità, crudeltà o assenza di scrupoli nei rapporti interpersonali.",
      "examples": [
        "Non lasciare che quella persona entri in casa, ha un carattere davvero cattivo.",
        "Le sue cattive intenzioni sono diventate evidenti a tutti dopo quelle dichiarazioni."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo qualificativo (attributivo e predicativo, accordo regolare)",
      "definition": "Nocivo o dannoso per la salute fisica, l'integrità o il corretto funzionamento di qualcosa.",
      "examples": [
        "Il fumo e una vita sedentaria hanno un cattivo effetto sul sistema cardiovascolare.",
        "La scarsa ventilazione e l'umidità creano un cattivo odore che ristagna in cantina."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo qualificativo (attributivo e predicativo, accordo regolare)",
      "definition": "Di qualità scadente, inefficace o che non soddisfa gli standard attesi.",
      "examples": [
        "Il regista ha girato un cattivo film che la critica ha stroncato unanimemente.",
        "La connessione internet è cattiva e non riesco a partecipare alla riunione online."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo qualificativo (attributivo e predicativo, accordo regolare)",
      "definition": "Che esprime o provoca una condizione psicologica, emotiva o situazionale negativa e spiacevole.",
      "examples": [
        "Stamattina si è svegliato di cattivo umore e ha preferito non rispondere a nessuno.",
        "Un cattivo presentimento le ha impedito di prendere quel treno, salvandola per caso da un incidente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Personaggio di finzione che si oppone al protagonista o agli eroi in un'opera narrativa, cinematografica o teatrale.",
      "examples": [
        "Nel nuovo film di supereroi il cattivo è interpretato da un attore premio Oscar.",
        "I bambini tifano sempre affinché il cattivo venga sconfitto alla fine della storia."
      ],
      "nota": "Uso tipico del linguaggio dello spettacolo e della narrativa di genere, spesso in contrapposizione a 'buono' o 'eroe'."
    }
  ]
