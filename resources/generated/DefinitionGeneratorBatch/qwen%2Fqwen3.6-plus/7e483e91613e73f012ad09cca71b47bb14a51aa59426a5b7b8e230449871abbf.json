  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Portare a compimento un'attività, un'opera o un processo; condurre qualcosa fino al suo punto conclusivo.",
      "examples": [
        "Dopo tre anni di studio, ha finalmente terminato la tesi di laurea.",
        "L'azienda ha terminato la produzione del vecchio modello per lanciarne uno nuovo."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Cessare di verificarsi o di protrarsi; giungere naturalmente o forzatamente al proprio confine temporale, spaziale o concettuale.",
      "examples": [
        "La trasmissione televisiva termina esattamente a mezzanotte.",
        "Il corridoio termina in una grande vetrata affacciata sul giardino."
      ],
      "nota": null
    }
  ]
