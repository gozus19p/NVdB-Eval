  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si presenta con la tonalità cromatica collocata all'estremità dello spettro della luce visibile, caratterizzata dalla maggiore lunghezza d'onda.",
      "examples": [
        "Ha verniciato la facciata del garage con una tinta molto intensa e brillante.",
        "Le foglie degli aceri in autunno assumono sfumature calde e uniformi."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a partiti, movimenti o ideologie politiche di ispirazione socialista o comunista.",
      "examples": [
        "La città ha espresso un voto netto per le liste di sinistra alle ultime comunali.",
        "Durante la Guerra Fredda molti paesi temevano l'espansione dei regimi dell'Est."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che, per estensione metaforica, caratterizza situazioni o stati d'animo connotati da forte passione, calore o, in contesti diversi, da violenza e pericolo.",
      "examples": [
        "Hanno condiviso un'esperienza estiva intensa tra viaggi, concerti e nuove amicizie.",
        "Le cronache hanno documentato i disordini che hanno insanguinato il centro storico."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che, nell'uso predicativo e in riferimento a bilanci o conti, indica una condizione di deficit o di perdita rispetto alle entrate.",
      "examples": [
        "Il rendiconto annuale è negativo perché le spese di gestione hanno superato i ricavi.",
        "Dopo l'acquisto dell'auto usata, il saldo del conto corrente è rimasto sotto zero."
      ],
      "nota": "Usato prevalentemente all'interno della locuzione avverbiale e predicativa «in rosso»."
    },
    {
      "pos": "sostantivo m.",
      "definition": "La tonalità cromatica percepita come calda e intensa, comunemente associata a elementi naturali come il fuoco o il sangue.",
      "examples": [
        "Il cielo al tramonto si è tinto di sfumature accese verso l'orizzonte.",
        "Ha optato per questa tonalità per rivestire la parete centrale del soggiorno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel gioco della roulette, gruppo di diciotto numeri o caselle contrassegnati da questa colorazione, su cui è possibile effettuare una puntata specifica.",
      "examples": [
        "Ha deciso di puntare sull'alternanza al nero per compensare le perdite precedenti.",
        "La pallina ha rimbalzato più volte sul tamburo prima di fermarsi sulla casella colorata."
      ],
      "nota": null
    }
  ]
