  "senses": [
    {
      "pos": "aggettivo qualificativo",
      "definition": "Dotato di elevata capacità tecnica, intellettuale o artistica in un determinato ambito o attività.",
      "examples": [
        "Mia sorella è molto brava a risolvere problemi complessi in tempi brevi.",
        "Il nuovo allenatore è bravo nel motivare i giocatori anche nei momenti difficili."
      ],
      "nota": "Nella sintassi contemporanea regge prevalentemente la preposizione 'a' seguita da verbo all'infinito o da sostantivo; può funzionare sia come attributo sia come predicato nominale."
    },
    {
      "pos": "aggettivo qualificativo",
      "definition": "Che manifesta un comportamento corretto, disciplinato o incline al rispetto delle regole, con speciale riferimento a minori e animali domestici.",
      "examples": [
        "Devi fare il bravo e finire i compiti prima di uscire con gli amici.",
        "Il gatto è stato bravo e non ha graffiato il divano nuovo."
      ],
      "nota": "Frequente nella costruzione esortativa 'fare il/la bravo/a'; assume spesso connotazione valutativo-affettiva o pedagogica."
    },
    {
      "pos": "interiezione",
      "definition": "Formula di approvazione, plauso o incoraggiamento rivolta a chi ha compiuto un'azione meritevole o conseguito un risultato positivo.",
      "examples": [
        "Bravo! Hai finalmente superato l'esame dopo tanti sforzi.",
        "Bravi entrambi, il vostro progetto ha vinto il primo premio nella categoria giovani."
      ],
      "nota": "Forma lessicalizzata derivata dall'aggettivo; varia in genere e numero ('brava', 'bravi', 'brave') per accordo deittico con il destinatario dell'enunciazione."
    }
  ]
