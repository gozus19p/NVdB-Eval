  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Padre del padre o della madre; uomo appartenente alla generazione immediatamente precedente a quella dei genitori.",
      "examples": [
        "Ogni domenica i bambini vanno a pranzo dal nonno paterno.",
        "Mio nonno mi ha tramandato una collezione di lettere scritte durante la guerra."
      ],
      "nota": "Il femminile corrispondente è 'nonna'. Al plurale il termine indica il collettivo dei genitori dei genitori."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Uomo anziano, persona avanti con gli anni, utilizzato in modo generico o affettivo per rivolgersi o riferirsi a un esponente della terza età privo di legami di parentela diretti.",
      "examples": [
        "Il nonno seduto sulla panchina del parco osserva sempre i passanti con curiosità.",
        "Scusa nonno, potresti indicarmi la strada per la stazione più vicina?"
      ],
      "nota": "L'impiego al plurale ('i nonni') è frequente anche con il significato di antenati o di popolazione della terza età considerata nel complesso."
    }
  ]
