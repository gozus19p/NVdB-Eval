  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Prestare assistenza, svolgere mansioni o mettersi a disposizione per conto di una persona o di una collettività, garantendone le necessità materiali o organizzative.",
      "examples": [
        "Il personale dell'albergo deve servire gli ospiti garantendo la massima discrezione.",
        "Quell'associazione serve le famiglie in difficoltà fornendo supporto psicologico e alimentare."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Porgere, distribuire e portare a tavola o negli spazi preposti cibi, bevande o pietanze a chi ne fa richiesta o partecipa a un pasto.",
      "examples": [
        "La cuoca ha servito il risotto ancora fumante a tutti i commensali.",
        "Prima della conferenza serviranno caffè e snack ai partecipanti nell'area ristoro."
      ],
      "nota": null
    },
    {
      "pos": "verbo impersonale",
      "definition": "Essere necessario, indispensabile o richiesto per un determinato scopo, con l'entità necessaria che funge da soggetto grammaticale e il destinatario espresso da complemento indiretto.",
      "examples": [
        "Mi serve un parere tecnico prima di firmare il contratto.",
        "Per completare la ricerca servono almeno due settimane aggiuntive.",
        "Servirebbe una pausa per riprendere le energie."
      ],
      "nota": "Nei tempi composti richiede regolarmente l'ausiliare 'essere' (es. 'è servito', 'sono servite')."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avere una specifica funzione o utilità pratica; risultare idoneo o funzionale al raggiungimento di un determinato scopo, spesso introdotto dalle preposizioni 'a' o 'per'.",
      "examples": [
        "Questa applicazione serve a monitorare le spese quotidiane senza errori.",
        "A che cosa serve conservare vecchi documenti se non vengono più consultati?"
      ],
      "nota": "Nei tempi composti richiede l'ausiliare 'essere'."
    },
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "In ambito sportivo, lanciare, calciare o colpire la palla o il disco per dare inizio a un turno di gioco o per impostare un'azione verso un compagno di squadra.",
      "examples": [
        "Il tennista ha deciso di servire con la mano sinistra per sorprendere l'avversario.",
        "Il centrocampista deve servire l'attaccante con un passaggio preciso in area di rigore."
      ],
      "nota": null
    }
  ]
