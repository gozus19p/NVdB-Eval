  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Insegnante, in particolare nella scuola primaria, o più genericamente educatore e docente scolastico.",
      "examples": [
        "La maestra di terza elementare ha organizzato una gita didattica per gli alunni.",
        "Molti ricordano con gratitudine il maestro che li ha avviati alla lettura."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che ha raggiunto un'alta competenza e riconosciuta autorevolezza in un'arte, un mestiere o una disciplina, fungendo spesso da modello o guida per altri.",
      "examples": [
        "È considerato un maestro della ceramica tradizionale e le sue opere vincono premi internazionali.",
        "Prima di intraprendere il percorso, è utile confrontarsi con un maestro del settore."
      ],
      "nota": "Spesso esteso a figure di riferimento morale, spirituale o intellettuale."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Direttore d'orchestra o compositore musicale; titolo professionale e di cortesia adoperato nel contesto della musica colta.",
      "examples": [
        "Il maestro ha diretto la sinfonia con grande precisione e intensità emotiva.",
        "Dopo il concerto il pubblico ha riconosciuto il lavoro del maestro e dei musicisti con un lungo applauso."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo (prevalentemente in funzione attributiva o in sintagmi nominali fissi)",
      "definition": "Che denota grande abilità, perfezione tecnica o valore esemplare, spesso in riferimento a un gesto, un'opera o una strategia.",
      "examples": [
        "Ha sferrato un colpo maestro che ha ribaltato l'esito della partita.",
        "La decisione del regista si è rivelata una scelta maestra per la riuscita del film."
      ],
      "nota": null
    }
  ]
