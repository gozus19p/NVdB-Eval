  "senses": [
    {
      "pos": "verbo, transitivo",
      "definition": "Lasciare un luogo, una persona o una cosa, interrompendo la propria presenza o le cure e le responsabilità verso di essi",
      "examples": [
        "Dopo anni ha deciso di lasciare la città per trasferirsi in campagna.",
        "Non è morale trascurare un animale domestico solo perché diventa scomodo da gestire."
      ],
      "nota": null
    },
    {
      "pos": "verbo, transitivo",
      "definition": "Rinunciare volontariamente a un'attività, a un progetto, a un'idea o a una consuetudine, interrompendone il proseguimento",
      "examples": [
        "Per motivi economici l'azienda ha dovuto sospendere il piano di espansione all'estero.",
        "Dopo tre esami bocciati, ha preferito interrompere gli studi universitari."
      ],
      "nota": null
    },
    {
      "pos": "verbo, riflessivo",
      "definition": "Cedere completamente a un sentimento, a un istinto o a una condizione fisica, rilassando la propria volontà o il controllo di sé",
      "examples": [
        "Stanchissimo, si è lasciato cadere sul divano senza nemmeno togliersi le scarpe.",
        "Di fronte alla notizia si è dedicato completamente al pianto liberatorio."
      ],
      "nota": "La forma pronominale è strutturale per questo significato; l'esempio mostra l'uso naturale con preposizioni 'a', 'su' o 'tra le braccia di'."
    }
  ]
