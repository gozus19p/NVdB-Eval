  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona che interpreta un ruolo in uno spettacolo teatrale, cinematografico, televisivo o in altre produzioni dello spettacolo dal vivo e registrato.",
      "examples": [
        "Il nuovo film ha ricevuto numerosi premi soprattutto per la performance dell'interprete principale.",
        "Dopo anni di gavetta in teatro, è finally riuscito a ottenere una parte in una serie di successo."
      ],
      "nota": "Nell'uso contemporaneo, il termine è spesso esteso in senso figurato per indicare chiunque ricopra un ruolo attivo e di primo piano in una certa vicenda o contesto (es. politico, economico)."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Nel linguaggio giuridico, persona fisica o giuridica che promuove un'azione legale contro un'altra parte dinanzi a un giudice.",
      "examples": [
        "La causa civile è stata promossa dall'attore per il mancato rispetto del contratto.",
        "Il tribunale ha respinto le richieste dell'attore per insufficienza di prove."
      ],
      "nota": null
    }
  ]
