  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che ha un prezzo elevato, superiore alla media o alle possibilità economiche di chi acquista.",
      "examples": [
        "Non posso permettermi quella borsa perché è davvero troppo cara per il mio budget.",
        "Negli ultimi mesi il costo del trasporto pubblico è aumentato e l'abbonamento è diventato molto caro."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è tenuto in grande considerazione per il profondo affetto, la stima o la gratitudine che suscita.",
      "examples": [
        "È una persona molto cara a tutta la famiglia per la sua indole generosa.",
        "Quel vecchio compagno di scuola mi è sempre rimasto caro nonostante il tempo passato."
      ],
      "nota": "Frequentemente usato come formula di cortesia o affettiva nell'intestazione di lettere, email o messaggi, e come vocativo nel parlato."
    },
    {
      "pos": "avverbio",
      "definition": "A un prezzo molto elevato o, in senso figurato, con un grave sacrificio, danno o pregiudizio.",
      "examples": [
        "Il suo comportamento incauto gli è costato caro in termini di reputazione professionale.",
        "Chi non rispetta gli accordi stabiliti se la fa pagare cara."
      ],
      "nota": "Si combina tipicamente con verbi come 'costare' o 'far pagare', concordando morfologicamente con il soggetto o l'oggetto della frase."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Individuo a cui si è legati da profondo affetto, in particolare un familiare o un amico intimo.",
      "examples": [
        "Durante le feste natalizie ha finalmente trovato il tempo per riunirsi con i suoi cari.",
        "La commemorazione è stata organizzata in intimità, riservata esclusivamente ai parenti e ai cari defunti."
      ],
      "nota": "Utilizzato quasi esclusivamente nella forma plurale per indicare collettivamente le persone amate."
    }
  ]
