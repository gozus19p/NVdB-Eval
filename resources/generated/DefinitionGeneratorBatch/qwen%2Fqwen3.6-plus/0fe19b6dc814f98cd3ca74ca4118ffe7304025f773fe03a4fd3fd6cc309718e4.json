  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova a una temperatura bassa, inferiore a quella considerata standard o piacevole.",
      "examples": [
        "Dopo la passeggiata sotto la pioggia ho le scarpe ancora umide e i piedi freddi.",
        "L'aria in alta montagna è fredda anche in piena estate."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che manifesta indifferenza, distacco o mancanza di partecipazione emotiva nei rapporti interpersonali.",
      "examples": [
        "Di fronte alle nostre richieste il dirigente è rimasto freddo e impassibile.",
        "Mi ha salutato con un tono freddo, senza stringermi la mano."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Riferito a pietanze o bevande che non vengono riscaldate prima del consumo o che vengono servite a temperatura ambiente o inferiore.",
      "examples": [
        "Per il picnic ho preparato dei piatti freddi come insalate e tramezzini.",
        "In estate preferisco mangiare una pasta fredda condita con verdure crude e olio."
      ],
      "nota": "Si contrappone a 'caldo' in riferimento alla categoria di alimenti."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Sensazione fisica di abbassamento della temperatura corporea o di contatto con oggetti non caldi.",
      "examples": [
        "Appena sono uscito di casa senza giacca ho sentito subito il gelo addosso.",
        "Il gatto si è rannicchiato vicino al camino per ripararsi dal freddo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Condizione meteorologica caratterizzata da basse temperature o il periodo invernale.",
      "examples": [
        "Il freddo intenso di questa settimana ha causato il blocco delle tubazioni in diverse città.",
        "Quando arriva il freddo in montagna è necessario usare le gomme invernali."
      ],
      "nota": "Spesso usato con aggettivi come 'intenso', 'polare', 'rigido' per indicare ondate di gelo o la stagione invernale."
    }
  ]
