  "senses": [
    {
      "pos": "verbo intransitivo / transitivo indiretto",
      "definition": "Divertirsi partecipando a un'attività ricreativa o sportiva, liberamente o rispettando norme condivise dal gruppo.",
      "examples": [
        "I bambini giocano in cortile fino al tramonto.",
        "La domenica giochiamo a calcetto con i colleghi dell'ufficio."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Scommettere somme di denaro o beni materiali in gare di fortuna o pronostici, sperando di ottenerne di maggiori.",
      "examples": [
        "Ha giocato cinquecento euro sulla corsa più quotata.",
        "Mia zia gioca regolarmente una schedina al bar della piazza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Eseguire una mossa, mostrare un elemento o effettuare un'azione all'interno di una competizione regolamentata o di una gara.",
      "examples": [
        "Durante la partita di scacchi ha giocato l'alfiere per controllare la diagonale principale.",
        "Per vincere la mano ha giocato immediatamente l'asso di cuori."
      ],
      "nota": "Tipico dei linguaggi tecnici legati a sport di squadra, giochi di carte e giochi da tavolo."
    },
    {
      "pos": "verbo transitivo / pronominale",
      "definition": "Affidare a fattori incerti o mettere a repentaglio beni, opportunità o aspetti personali cruciali.",
      "examples": [
        "Ha giocato la propria credibilità su una promessa non verificata.",
        "Non puoi giocarti l'unica opportunità di carriera per un litigio banale."
      ],
      "nota": "In italiano contemporaneo la forma pronominale è fortemente preferita quando il complemento oggetto indica un valore soggettivo o esistenziale."
    },
    {
      "pos": "verbo intransitivo con reggenza 'su' / transitivo figurato",
      "definition": "Utilizzare in modo calcolato un elemento, un'ambiguità o un contrasto per ottenere consenso, influenzare gli altri o generare un effetto specifico.",
      "examples": [
        "Quel regista gioca sull'ambiguità dei personaggi per tenere alta l'attenzione del pubblico.",
        "La campagna elettorale gioca sui timori della sicurezza per raccogliere voti."
      ],
      "nota": "Frequente nel linguaggio giornalistico, pubblicitario e della comunicazione persuasiva."
    }
  ]
