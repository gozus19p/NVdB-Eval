  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Essere presente, indicato o menzionato in un elenco, un documento, una classifica o un registro ufficiale.",
      "examples": [
        "Il suo nome figura tra i vincitori del concorso nazionale.",
        "Nel bilancio consuntivo figurano diverse voci di spesa straordinaria."
      ],
      "nota": "Accetta indifferentemente gli ausiliari essere o avere; nei registri formali e scritti prevale spesso essere."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentarsi o agire in un contesto sociale o professionale riscuotendo un giudizio positivo o negativo, solitamente specificato da avverbi di valutazione.",
      "examples": [
        "La nuova delegazione ha figurato benissimo durante il summit internazionale.",
        "Purtroppo la squadra ha figurato male nel derby, commettendo errori evitabili."
      ],
      "nota": "L'accezione ha valore pragmatico-valutativo e ricorre frequentemente in combinazione con 'bene', 'male', 'brillantemente' o 'pessimamente'."
    },
    {
      "pos": "verbo pronominale",
      "definition": "Immaginare o dedurre mentalmente un fatto, una situazione o l'esito di un evento; usato spesso in forma esclamativa o imperativa per manifestare incredulità, ironia o per considerare un'ipotesi come del tutto improbabile o, al contrario, scontata.",
      "examples": [
        "Non serve aggiungere dettagli, me lo figuro benissimo da solo.",
        "Figuriamoci se lasceremo l'auto incustodita in quella zona!"
      ],
      "nota": "Nelle forme cristallizzate 'figurati' o 'figuriamoci' funziona come marcatore pragmatico di enfasi negativa o rifiuto retorico."
    }
  ]
