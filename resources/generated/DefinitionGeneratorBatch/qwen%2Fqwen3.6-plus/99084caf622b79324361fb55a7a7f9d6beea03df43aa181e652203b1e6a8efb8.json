  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Andare incontro a una persona, una situazione critica o un pericolo con atteggiamento deciso per opporvisi, superarlo o reagire allo stimolo negativo.",
      "examples": [
        "I soccorritori hanno affrontato le fiamme senza esitazione nonostante il calore intenso.",
        "Prima o poi dovremo affrontare quel vicino per far rispettare il regolamento condominiale."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Prendere in considerazione, analizzare in profondità o cercare di risolvere una questione, un tema di dibattito o un problema pratico o teorico.",
      "examples": [
        "Nella conferenza di domani affronteremo il tema della transizione ecologica.",
        "Il manuale affronta con rigore scientifico le principali teorie della personalità."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sostenere economicamente, fisicamente o psicologicamente una fatica, un compito gravoso, un percorso lungo o una spesa rilevante.",
      "examples": [
        "Molte imprese hanno affrontato costi imprevisti a causa dell'aumento delle materie prime.",
        "Gli escursionisti hanno affrontato otto ore di cammino su terreno accidentato."
      ],
      "nota": null
    }
  ]
