  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Attività economica esercitata in modo abituale e continuativo per procurarsi il sostentamento; occupazione lavorativa.",
      "examples": [
        "Dopo anni di studio, ha finalmente trovato un mestiere che le permette di viaggiare per lavoro.",
        "L'imprenditore sostiene che il mercato richieda più voglia di imparare un mestiere concreto."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Complesso di conoscenze pratiche, abilità tecniche e accorgimenti che si acquisiscono direttamente con l'esperienza in un determinato ambito operativo.",
      "examples": [
        "Il vecchio falegname ha trasmesso ai nipoti tutti i segreti del mestiere.",
        "In cucina la teoria conta poco: bisogna soprattutto conoscere il mestiere e affidarsi alla pratica."
      ],
      "nota": "Frequente in sintagmi come 'imparare il mestiere' o 'segreto del mestiere', con riferimento a competenze trasmesse per tradizione o esperienza diretta."
    }
  ]
