  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Diventare visibile, mostrarsi o giungere in un determinato luogo, spesso in modo improvviso o inatteso.",
      "examples": [
        "Dopo aver atteso per ore, il pacco è finalmente comparso sulla scrivania.",
        "All'improvviso è comparso dal nulla senza fare il minimo rumore."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere presente, pubblicato o riportato in un elenco, un testo, un documento o un'opera.",
      "examples": [
        "Il tuo nome non compare nell'elenco dei partecipanti alla conferenza.",
        "Questa variante lessicale compare raramente nella letteratura contemporanea."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentarsi di persona davanti a un'autorità giudiziaria o amministrativa per rispondere a una convocazione o adempiere a un obbligo legale.",
      "examples": [
        "Il testimone è stato citato a comparire in tribunale entro la fine del mese.",
        "Per la pratica di successione, gli eredi devono comparire personalmente in notaio."
      ],
      "nota": "Nell'ambito giuridico e amministrativo si costruisce tipicamente con le preposizioni «davanti a» o «presso» seguite dall'ente competente."
    }
  ]
