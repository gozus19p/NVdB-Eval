    {
      "pos": "sostantivo m.",
      "definition": "Singola unità narrativa autonoma che compone un'opera distribuibile in sequenza, tipicamente in ambito televisivo, radiofonico o digitale.",
      "examples": [
        "L'ultimo pezzo della serie ha lasciato il pubblico in trepida attesa del finale.",
        "Ogni giovedì gli autori caricano sulla piattaforma un nuovo appuntamento del programma."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Avvenimento singolo e circoscritto, considerato nella sua specificità all'interno di un contesto o di una successione di fatti più ampia.",
      "examples": [
        "Quell'avvenimento di tensione tra le due fazioni è stato rapidamente ridimensionato.",
        "Nel corso della sua carriera ha attraversato momenti di forte incertezza professionale."
      ],
      "nota": "In ambito clinico e medico la parola assume valore tecnico per indicare la manifestazione transitoria e delimitata nel tempo di una sintomatologia o di un disturbo."
    }
