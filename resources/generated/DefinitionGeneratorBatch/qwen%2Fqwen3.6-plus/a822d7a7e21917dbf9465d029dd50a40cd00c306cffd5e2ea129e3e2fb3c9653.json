  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Striscia di tessuto, spesso elastica, utilizzata per avvolgere, sostenere o comprimere una parte del corpo o un oggetto.",
      "examples": [
        "Dopo la distorsione, il medico ha consigliato di indossare una fascia per proteggere il ginocchio.",
        "Ha stretto il manico della valigia con una fascia di nylon per evitare che si aprisse."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Nastro di stoffa, spesso dai colori simbolici, portato a tracolla o al collo come insegna di una carica istituzionale o di un'appartenenza cerimoniale.",
      "examples": [
        "Il neopresidente del consiglio di quartiere ha ricevuto la fascia durante la seduta inaugurale.",
        "Nel corteo rionale ogni figurante era facilmente riconoscibile grazie al colore della fascia indossata."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Zona territoriale o intervallo temporale delimitato da estremi precisi e caratterizzato da condizioni o proprietà specifiche.",
      "examples": [
        "La nuova normativa urbanistica tutela le costruzioni situate nella fascia costiera a meno di cento metri dalla battigia.",
        "I biglietti del museo hanno prezzo ridotto per i visitatori che accedono durante la fascia pomeridiana."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Gruppo o categoria di individui e fenomeni classificati in base a valori quantitativi o caratteristiche qualitative condivise.",
      "examples": [
        "La riforma previdenziale ha modificato le aliquote per le fasce di reddito medio-alte.",
        "Questa indagine statistica confronta le abitudini digitali delle diverse fasce d'età."
      ],
      "nota": null
    }
  ]
