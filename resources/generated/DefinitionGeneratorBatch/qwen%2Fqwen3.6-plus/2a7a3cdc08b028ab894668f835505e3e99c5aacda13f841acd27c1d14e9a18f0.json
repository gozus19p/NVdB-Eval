            "definitions": [
              {
                "glossa": "Principio normativo che regola il comportamento degli uomini; quella emanata dagli organi che detengono il potere legislativo; l’insieme dei principi di giustizia che si ritiene siano istintivi e universali nell’uomo; principio della coscienza che guida l’uomo nel discernere il bene dal male; l’insieme delle norme religiose che nelle religioni rivelate si ritengono dettate da Dio agli uomini; il complesso delle norme che regolano la vita sociale in quanto distinta dalla legge divina",
                "source": "tdm"
              }
            ],
            "examples": [
              "legge positiva",
              "scritta",
              "legge naturale",
              "legge morale",
              "legge divina",
              "legge umana"
