  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Norma scritta e vincolante emanata da un'autorità statale o sovranazionale che disciplina i diritti e i doveri dei cittadini e delle istituzioni.",
      "examples": [
        "Il parlamento ha approvato una nuova legge per ridurre l'inquinamento acustico.",
        "Nessuno può invocare l'ignoranza della norma per giustificare un illecito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Principio generale che descrive una relazione costante, universale e verificabile nei fenomeni naturali, fisici o matematici.",
      "examples": [
        "La caduta libera dei corpi obbedisce a un principio fisico fondamentale.",
        "In economia esiste una regola classica che mette in rapporto la domanda con l'offerta."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Regola non scritta, consuetudine radicata o vincolo morale considerato inderogabile all'interno di un gruppo o di un contesto specifico.",
      "examples": [
        "Nell'ambiente militare il principio gerarchico è assoluto e indiscutibile.",
        "Per le comunità tradizionali il dovere dell'ospitalità rappresenta un valore sacro."
      ],
      "nota": "Utilizzato frequentemente in costrutti fissi per indicare regole percepite come naturali, inevitabili o fortemente identitarie."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Percorso di studi universitari dedicato all'approfondimento del sistema normativo e alla formazione forense.",
      "examples": [
        "Dopo il diploma ha scelto di iscriversi a giurisprudenza presso l'università di Roma.",
        "Molti iscritti al corso affrontano il tirocinio pratico subito dopo l'esame finale."
      ],
      "nota": "Nel linguaggio accademico e colloquiale è considerato sinonimo di giurisprudenza, soprattutto nelle denominazioni di facoltà o corsi di laurea."
    }
  ]
