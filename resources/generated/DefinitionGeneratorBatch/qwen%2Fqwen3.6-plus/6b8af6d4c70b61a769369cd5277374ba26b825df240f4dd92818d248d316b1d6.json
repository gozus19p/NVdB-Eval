  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Ampia estensione di terreno, generalmente pubblica o gestita per fini collettivi, destinata alla tutela di ambienti naturali oppure allo svago e alla ricreazione all'aria aperta.",
      "examples": [
        "Nel fine settimana abbiamo trascorso il pomeriggio camminando tra i vialetti del parco cittadino.",
        "Le autorità regionali hanno recentemente ampliato l'area protetta per preservare la biodiversità locale."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Insieme organizzato di veicoli, macchinari, attrezzature o individui che fanno riferimento a una specifica organizzazione, attività o servizio.",
      "examples": [
        "La direzione aziendale ha stanziato fondi ingenti per il rinnovo del parco macchine della logistica interna.",
        "Il nuovo software gestionale consente di monitorare le preferenze e l'attività dell'intero parco clienti."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Contraddistinto da moderazione, sobrietà o misurazione nel consumo di risorse, nell'espressione verbale o nel comportamento generale.",
      "examples": [
        "Durante la negoziazione è rimasto parco nelle dichiarazioni, limitandosi a esporre i dati essenziali.",
        "Nonostante la solida situazione economica, mantiene uno stile di vita parco nelle spese quotidiane."
      ],
      "nota": null
    }
