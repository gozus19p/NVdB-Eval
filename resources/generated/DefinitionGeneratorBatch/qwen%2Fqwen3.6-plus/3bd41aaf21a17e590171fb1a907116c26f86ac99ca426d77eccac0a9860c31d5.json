  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Persona che condivide con un'altra un'attività, un percorso di formazione, un lavoro o un'esperienza comune.",
      "examples": [
        "I miei compagni di università mi hanno aiutato a preparare la tesi.",
        "Durante il viaggio in treno ho fatto amicizia con un compagno di scompartimento."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che convive stabilmente con un'altra in una relazione affettiva e sentimentale, indipendentemente dall'esistenza di un vincolo matrimoniale.",
      "examples": [
        "Da dieci anni convive con il suo compagno e hanno appena acquistato casa.",
        "Per il mio compleanno organizzeremo una cena solo io e il mio compagno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Militante o simpatizzante di un partito o movimento politico, spec. di area progressista o di sinistra, usato spesso come forma di appello o appellativo reciproco.",
      "examples": [
        "Il segretario ha esordito ringraziando i compagni intervenuti alla riunione di circolo.",
        "Durante il dibattito alcuni compagni hanno criticato apertamente la nuova strategia elettorale."
      ],
      "nota": "In contesti politici il termine è frequentemente impiegato anche come vocativo."
    }
  ]
