  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Stato di interezza, armonia o concordia tra membri di un collettivo o parti di un territorio",
      "examples": [
        "Dopo anni di divisioni, il consiglio ha finalmente ritrovato unità nel decidere le nuove linee guida.",
        "L'unità nazionale è stata messa a dura prova durante la grave crisi economica."
      ],
      "nota": "Frequentemente impiegato in contesti politici, sociali o istituzionali per indicare solidarietà di intenti e coordinamento."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Singolo elemento funzionale considerato come parte distinta di un sistema o di un'organizzazione più ampia",
      "examples": [
        "L'azienda ha istituito una nuova unità dedicata alla gestione delle emergenze informatiche.",
        "Il complesso residenziale è stato diviso in diverse unità abitative con ingressi indipendenti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Quantità fissa o entità standardizzata adottata come termine di paragone per quantificare o valutare altre grandezze della stessa natura",
      "examples": [
        "Il metro è l'unità di lunghezza ufficialmente riconosciuta per le misurazioni civili.",
        "In economia, il potere d'acquisto si calcola rapportando il reddito a un'unità di spesa standard."
      ],
      "nota": "Spesso accompagnato da complementi di specificazione come 'di misura', 'monetaria', 'contabile' o 'funzionale'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Il numero uno o la cifra che lo rappresenta, in particolare nella posizione più a destra di un numero intero nel sistema di numerazione posizionale",
      "examples": [
        "Nel numero 527, la cifra delle unità è il sette.",
        "Durante l'addizione in colonna, se la somma delle unità supera il nove, bisogna riportare una decina alla colonna successiva."
      ],
      "nota": null
    }
