  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Muoversi intenzionalmente da un luogo a un altro coprendo una certa distanza, generalmente mediante un mezzo di trasporto o a piedi.",
      "examples": [
        "Quest'anno abbiamo deciso di viaggiare in treno per visitare tutta la costa ligure.",
        "Le famiglie con bambini piccoli preferiscono viaggiare nelle ore meno trafficate."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Procedere, muoversi o essere trasmesso secondo un determinato ritmo, velocità o stato di avanzamento, con riferimento a veicoli, processi, progetti o flussi di informazioni.",
      "examples": [
        "Il treno ad alta velocità viaggia a trecento chilometri orari per la maggior parte del percorso.",
        "Nonostante le difficoltà iniziali, il progetto di ricerca viaggia bene e i primi risultati sono molto promettenti."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Lasciarsi trasportare dalla fantasia o dal pensiero, perdendo temporaneamente il contatto con la realtà circostante per fantasticare o riflettere in modo astratto.",
      "examples": [
        "Durante la riunione noiosa, Marco ha passato il tempo a viaggiare immaginando avventure in luoghi esotici.",
        "A volte mi capita di chiudere gli occhi e di viaggiare con la mente verso ricordi lontani."
      ],
      "nota": null
    }
