  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che si trova in condizione di subordinazione gerarchica o che necessita di un altro elemento per funzionare o verificarsi; determinato da fattori esterni.",
      "examples": [
        "Il risultato dell'esito elettorale è dipendente dall'affluenza alle urne.",
        "Molte startup rimangono dipendenti dai finanziamenti pubblici per sopravvivere nelle prime fasi di vita."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che manifesta una condizione patologica o compulsiva di bisogno irreprimibile verso una sostanza, un'attività o un comportamento specifico.",
      "examples": [
        "Dopo anni di abuso alcolico, è riconosciuto clinicamente come dipendente.",
        "Non posso più considerarmi un utente occasionale: ormai sono completamente dipendente dai social network."
      ],
      "nota": "In ambito clinico e psicologico, indica spesso la necessità di un intervento terapeutico o di supporto specializzato."
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona inserita in un rapporto lavorativo subordinato, che presta la propria attività intellettuale o manuale in cambio di una retribuzione e nel rispetto di un contratto aziendale o pubblico.",
      "examples": [
        "L'azienda ha comunicato ai propri dipendenti che il bonus verrà erogato a dicembre.",
        "I dipendenti dell'ospedale hanno organizzato un turno straordinario per gestire l'emergenza."
      ],
      "nota": null
    }
  ]
