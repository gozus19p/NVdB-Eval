  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Configurazione esteriore, contorno e disposizione spaziale degli elementi che costituiscono un corpo o un oggetto materiale.",
      "examples": [
        "La forma del vaso è stata progettata per adattarsi perfettamente al davanzale della finestra.",
        "Dopo il taglio, i capelli hanno assunto una sagoma più leggera e facile da gestire."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Modalità, maniera o tipo specifico con cui un fenomeno, un'azione, un documento o un istituto viene organizzato, espresso o realizzato.",
      "examples": [
        "La proposta di legge è stata presentata sotto forma di emendamento al testo unico.",
        "Il colloquio si è svolto in forma scritta per garantire la tracciabilità delle risposte."
      ],
      "nota": "Frequentemente impiegato in locuzioni preposizionali come «sotto forma di» o «in forma di»."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Stato di efficienza fisica e mentale, condizione di salute, preparazione o allenamento ottimale.",
      "examples": [
        "Dopo le vacanze al mare mi sento finalmente pronto per riprendere gli allenamenti.",
        "Il preparatore atletico ha ridotto i carichi di lavoro per aiutare la squadra a raggiungere il picco di efficienza."
      ],
      "nota": "Uso prevalente e consolidato in ambito sportivo, clinico e del benessere personale."
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Impianto strutturale, stilistico o compositivo di un'opera dell'ingegno o di un messaggio, valutato in sé stesso e in contrapposizione al contenuto tematico.",
      "examples": [
        "Il critico ha lodato la cura metrica del componimento tralasciando il messaggio politico sotteso.",
        "Nel dibattito letterario contemporaneo si discute spesso se debba prevalere l'equilibrio estetico o la sostanza narrativa."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Unità commerciale o manufatto realizzato conferendo una configurazione specifica a un materiale alimentare o plastico durante il processo di lavorazione.",
      "examples": [
        "Al banco del supermercato ho acquistato un blocco stagionato di pecorino per la cena di stasera.",
        "Il panificatore controlla che ogni pezzo esca dal forno con la crosta uniformemente dorata."
      ],
      "nota": "Termine tecnico-commerciale di ampio uso, diffuso soprattutto nei settori caseario, dolciario e della panificazione."
    }
  ]
