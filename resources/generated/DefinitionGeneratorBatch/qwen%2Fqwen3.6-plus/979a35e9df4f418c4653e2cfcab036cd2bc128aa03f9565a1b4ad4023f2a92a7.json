  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Ampio locale interno a un edificio, progettato o adattato per ospitare gruppi di persone o per lo svolgimento di attività specifiche, lavorative, sociali o di servizio.",
      "examples": [
        "La scuola ha allestito una nuova sala per le riunioni dei genitori.",
        "Ti aspetto nella sala d'attesa, vicino alla reception."
      ],
      "nota": "Si combina frequentemente con specificazioni o aggettivi che ne precisano la funzione (es. da pranzo, operatoria, conferenze, prove)."
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Locale pubblico attrezzato con posti a sedere e impianti tecnici per la proiezione cinematografica o la rappresentazione teatrale e musicale; per metonimia, designa il circuito commerciale di distribuzione di un film o l'insieme del pubblico presente.",
      "examples": [
        "Il film è finalmente uscito in sala dopo mesi di postproduzione.",
        "La sala è rimasta in silenzio fino ai titoli di coda."
      ],
      "nota": "Nel linguaggio cinematografico e teatrale, l'espressione 'in sala' contrappone la fruizione pubblica e collettiva a quella domestica, televisiva o in streaming."
    }
  ]
