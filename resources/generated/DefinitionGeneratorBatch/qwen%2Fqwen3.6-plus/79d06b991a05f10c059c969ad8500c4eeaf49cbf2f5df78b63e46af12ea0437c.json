  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Che indica una pluralità non determinata di entità differenti tra loro, funzionando come quantificatore o determinante indefinito.",
      "examples": [
        "Dovresti consultare vari esperti prima di prendere una decisione definitiva.",
        "Esistono vari modi per risolvere il problema senza creare conflitti."
      ],
      "nota": "Utilizzato prevalentemente al plurale; in contesto moderno si sovrappone spesso a 'diversi' o 'parecchi'."
    },
    {
      "pos": "aggettivo",
      "definition": "Che presenta al proprio interno una composizione eterogenea, ricca di elementi o manifestazioni differenti; non monotono o uniforme.",
      "examples": [
        "La rassegna cinematografica propone un programma molto vario, adatto a tutti i gusti.",
        "Durante il colloquio ha dimostrato una preparazione estremamente varia e interdisciplinare."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che è soggetto a frequenti mutamenti o alternanze imprevedibili nel tempo; incostante.",
      "examples": [
        "In questa stagione alpina il tempo è piuttosto vario, meglio equipaggiarsi per ogni eventualità.",
        "La condizione economica del settore è stata varia nell'ultimo trimestre, tra segnali di ripresa e fasi di stallo."
      ],
      "nota": "Ricorrente soprattutto in contesti meteorologici, clinici o economici per descrivere fluttuazioni frequenti."
    }
  ]
