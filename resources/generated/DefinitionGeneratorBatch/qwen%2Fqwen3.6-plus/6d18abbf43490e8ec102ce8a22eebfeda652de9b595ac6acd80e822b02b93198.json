  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Considerato sacro, consacrato alla divinità o rivestito di una particolare dignità nella tradizione religiosa, con riferimento a persone, luoghi, oggetti o ricorrenze.",
      "examples": [
        "La Settimana Santa è celebrata con processioni solenni in molte regioni d'Italia.",
        "I fedeli organizzano pellegrinaggi verso la Terra Santa per visitare i luoghi della tradizione biblica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona che la Chiesa cristiana ha ufficialmente canonizzato, riconoscendone le virtù eroiche e ammettendola al culto pubblico della comunità dei fedeli.",
      "examples": [
        "Il lungo processo di indagine si è concluso con la proclamazione del nuovo santo da parte del pontefice.",
        "Nel calendario liturgico ogni data è tradizionalmente dedicata a uno o più modelli di fede riconosciuti."
      ],
      "nota": "Al femminile cambia in 'santa'; la forma femminile indica comunemente anche la festa onomastica ('domani è santa Lucia')."
    },
    {
      "pos": "aggettivo (valutativo)",
      "definition": "Che si distingue per una bontà esemplare, una generosità costante o una pazienza straordinaria, spesso in contesti di difficoltà o sofferenza altrui.",
      "examples": [
        "Mio nonno è davvero santo, capace di perdonare qualsiasi torto senza mai alzare la voce.",
        "Dopo ore di attesa allo sportello serve una pazienza santa per non perdere le staffe."
      ],
      "nota": "Frequente l'uso ironico o polemico per stigmatizzare chi ostenta una virtuosità di facciata o, al contrario, mostra comportamenti egoistici."
    },
    {
      "pos": "sostantivo m. (figurato, colloquiale)",
      "definition": "Persona che nella vita ordinaria manifesta abnegazione, disponibilità e tolleranza fuori dal comune, arrivando a sopportare situazioni gravose per il bene altrui.",
      "examples": [
        "Con tre figli piccoli e un lavoro massacrante, quella mamma è una santa vera.",
        "Per gestire quell'ufficio caotico e i clienti sempre insoddisfatti ci vorrebbe un santo in carica."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo (enfatizzante/esclamativo)",
      "definition": "Impiegato in sequenze cristallizzate o esclamazioni per esprimere stupore, stizza, meraviglia o per rafforzare un giudizio, privo di qualsiasi connotazione religiosa.",
      "examples": [
        "Santo cielo, non avevo proprio visto che il treno era già passato!",
        "Santa verità, quel film è davvero impossibile da sopportare fino alla fine."
      ],
      "nota": "Distribuito esclusivamente in locuzioni fisse come 'santo cielo', 'santa pazienza', 'santa verità'."
    }
  ]
