  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Lanciare un oggetto o una persona applicando forza muscolare, proiettandolo a distanza.",
      "examples": [
        "Il ragazzo ha buttato la palla oltre la staccionata per recuperarla.",
        "Durante la lite ha buttato i documenti a terra senza raccoglierli."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Gettare via, eliminare o disfarsi di ciò che è considerato inutile, deteriorato o superfluo.",
      "examples": [
        "Prima di traslocare dobbiamo buttare tutta la roba vecchia.",
        "Non buttare gli avanzi di pasta, puoi riscaldarli a pranzo."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sperperare o non valorizzare risorse economiche, tempo prezioso o circostanze favorevoli.",
      "examples": [
        "Ha buttato tutti i suoi risparmi in un investimento fallito.",
        "È un peccato buttare un'occasione così ghiotta per una semplice paura."
      ],
      "nota": "Frequente l'abbinamento con la particella avverbiale 'via'."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Redigere, annotare o verbalizzare un'idea con rapidità e senza curarne la forma definitiva.",
      "examples": [
        "Ho buttato giù lo schema della presentazione in cinque minuti.",
        "Durante il dibattito qualcuno ha buttato lì una domanda molto pertinente."
      ],
      "nota": "Si realizza soprattutto nelle locuzioni fisse 'buttare giù' (scrivere) e 'buttare lì' (dire)."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Emanare o diffondere verso l'esterno fumo, odori, scintille o rumori in quantità percepita come rilevante.",
      "examples": [
        "La vecchia caldaia butta fumi neri se non si fa la manutenzione.",
        "Quella stampante butta un odore di ozono fastidioso."
      ],
      "nota": "Registro colloquiale; indica un'emissione fisica abbondante o invadente."
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Compire un lancio del proprio corpo o dedicarsi con impulsività e determinazione a un'attività, un rischio o un cambiamento di vita.",
      "examples": [
        "Si è buttato in piscina senza fare il bagno prima.",
        "Dopo anni di gavetta, si è buttato in proprio aprendo un locale."
      ],
      "nota": "Valenza riflessiva; il senso figurato implica una scelta coraggiosa o improvvisa."
    }
  ]
