  "senses": [
    {
      "pos": "sostantivo femminile",
      "definition": "Lasso di tempo, generalmente lungo, caratterizzato da tratti storici, culturali, sociali o scientifici omogenei che lo distinguono nettamente da periodi precedenti o successivi.",
      "examples": [
        "La caduta dell'Impero romano ha chiuso un'epoca e ne ha aperta una completamente nuova in Europa.",
        "Gli studiosi analizzano le trasformazioni urbane confrontando l'architettura di questa epoca con quella del dopoguerra."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo femminile",
      "definition": "Persona, evento o creazione culturale di straordinario rilievo, considerato un punto di svolta, un modello insuperabile o un simbolo nostalgico del passato.",
      "examples": [
        "Quel tennista è un'epoca per gli appassionati del circuito, nessuno è più riuscito a eguagliare le sue prestazioni su erba.",
        "Le serate in quel vecchio caffè letterario erano un'epoca, con i dibattiti accesi e un'atmosfera che oggi si fa fatica a ritrovare."
      ],
      "nota": "Uso figurato e valutativo, frequente nel registro colloquiale, giornalistico e della critica per esprimere ammirazione o rimpianto verso un modello percepito come irripetibile."
    }
  ]
