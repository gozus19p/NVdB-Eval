  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Corrispondere una somma di denaro o un mezzo equivalente in cambio di un bene, di un servizio o per estinguere un'obbligazione economica.",
      "examples": [
        "Devo ancora pagare la bolletta della luce prima di domani.",
        "L'azienda pagherà i fornitori tramite bonifico bancario."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Subire le conseguenze negative, materiali o morali, di un'azione o di un comportamento considerato errato o colpevole.",
      "examples": [
        "Prima o poi dovrai pagare per le tue bugie.",
        "Ha pagato molto caro l'errore di valutazione del mercato."
      ],
      "nota": "Spesso impiegato in espressioni come 'pagare caro' o seguito dalla preposizione 'per' per introdurre la causa."
    },
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Produrre un rendimento economico, fruttare interessi o generare un utile apprezzabile.",
      "examples": [
        "Questo investimento paga bene nonostante l'instabilità dei mercati.",
        "Il conto deposito paga gli interessi a cadenza mensile."
      ],
      "nota": "Accezione specifica del linguaggio economico-finanziario."
    }
  ]
