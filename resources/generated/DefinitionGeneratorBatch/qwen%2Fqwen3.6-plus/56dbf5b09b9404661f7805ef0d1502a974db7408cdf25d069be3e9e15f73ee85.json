  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Rendere un oggetto rigido o sottoposto a tensione tirandone le estremità o applicando forze opposte.",
      "examples": [
        "Il liutaio ha dovuto tendere le corde del violino per accordarlo prima del concerto.",
        "Per evitare che si formassero pieghe, hanno teso la stoffa su un telaio di legno."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Protendere o orientare una parte del corpo, lo sguardo o l'attenzione in direzione di qualcuno o qualcosa.",
      "examples": [
        "Durante il brindisi, il direttore ha teso il bicchiere verso gli ospiti seduti al tavolo laterale.",
        "L'insegnante tendeva lo sguardo verso l'ultima fila per richiamare l'attenzione degli studenti distratti."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Predisporre e nascondere un dispositivo di cattura o preparare strategicamente un attacco a sorpresa.",
      "examples": [
        "I carabinieri hanno deciso di tendere un agguato nel parcheggio dove avvenivano gli scambi illegali.",
        "In passato era comune tendere lacci per catturare la selvaggina nelle vicinanze del bosco."
      ],
      "nota": "Ricorre quasi esclusivamente in costruzioni lessicalizzate come 'tendere un agguato', 'tendere un'imboscata' o 'tendere una trappola'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Dirigere il proprio movimento o indirizzare la propria azione con un obiettivo specifico verso un luogo, un compito o un risultato.",
      "examples": [
        "La nuova riforma tende a semplificare le pratiche burocratiche per i cittadini.",
        "Il progetto sociale tende a favorire l'inclusione delle fasce più vulnerabili."
      ],
      "nota": "Regge normalmente le preposizioni 'a' o 'verso' e richiede l'ausiliare 'avere'."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentare una propensione naturale o un'alta probabilità statistica di evolvere, cambiare o manifestare un certo comportamento o valore.",
      "examples": [
        "Sua figlia tende a preoccuparsi eccessivamente prima di ogni esame universitario.",
        "I costi delle materie prime tendono verso l'alto a causa dell'instabilità logistica globale."
      ],
      "nota": "Indica una dinamica progressiva o un'inclinazione non necessariamente volitiva, distinguendosi dall'accezione finalistica."
    }
  ]
