  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Relativo all'Italia, al suo territorio, alla sua cultura, alle sue istituzioni o alla popolazione che vi risiede.",
      "examples": [
        "La legislazione italiana prevede agevolazioni fiscali per le startup innovative.",
        "Il design italiano è riconosciuto a livello mondiale per l'equilibrio tra estetica e funzionalità."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona nata in Italia o che ne possiede la cittadinanza.",
      "examples": [
        "Dopo decenni all'estero, molti italiani scelgono di rientrare in patria per assistere i familiari.",
        "L'italiano che ha vinto il premio internazionale ha dedicato la vittoria alla sua città natale."
      ],
      "nota": "Il femminile è 'italiana'; al maschile plurale può assumere valore collettivo, indicando l'intera popolazione del Paese."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Lingua romanza derivata dal volgare fiorentino, adottata come idioma ufficiale della Repubblica Italiana e utilizzata nell'istruzione, nell'amministrazione e nella letteratura.",
      "examples": [
        "Durante il viaggio in Giappone, abbiamo avuto difficoltà a comunicare perché quasi nessuno parlava italiano.",
        "Il corso serale è rivolto a chi vuole migliorare la pronuncia e la scorrevolezza nell'uso dell'italiano parlato."
      ],
      "nota": "In ambito scolastico e accademico indica anche la materia di studio dedicata alla grammatica, alla storia e alla letteratura di questa lingua."
    }
  ]
