  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Far cambiare collocazione o disposizione a un corpo materiale o a una sua parte.",
      "examples": [
        "Non sono riuscito a sollevare quella cassa perché era troppo pesante per spostarla da solo.",
        "Durante la riabilitazione, il fisioterapista gli ha fatto ruotare e allungare le dita della mano con molta delicatezza."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Suscitare, provocare o alimentare in qualcuno una reazione emotiva o psicologica.",
      "examples": [
        "La lettura di quelle lettere ha suscitato una profonda nostalgia in chi le ha ritrovate.",
        "Nonostante la recitazione convincente, lo spettacolo non è riuscito a destare l'attenzione del pubblico distratto."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Intraprendere, avanzare o presentare in ambito formale o istituzionale un'iniziativa, una richiesta o un rilievo.",
      "examples": [
        "La squadra tecnica ha deciso di compiere i primi passi verso la standardizzazione del protocollo.",
        "L'opposizione ha scelto di avanzare diverse obiezioni durante il dibattito parlamentare."
      ],
      "nota": "Uso tipicamente collocato in contesti burocratici, legali o procedurali; ricorre frequentemente con complementi nominali come passi, critiche, obiezioni o istanze."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Avviarsi, partire o dirigersi verso una meta, generalmente accompagnato da complementi di moto.",
      "examples": [
        "All'alba, la colonna di veicoli ha iniziato ad avviarsi lentamente verso il confine.",
        "Dopo la breve sosta, le truppe hanno marciato rapidamente occupando le posizioni strategiche."
      ],
      "nota": "Registro formale, letterario o giornalistico; nell'italiano parlato contemporaneo si preferisce la forma pronominale o verbi alternativi."
    }
  ]
