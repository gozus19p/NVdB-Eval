  "senses": [
    {
      "pos": "sostantivo (f.)",
      "definition": "Individuo di una specie animale o vegetale che possiede gli organi riproduttivi preposti alla produzione di ovuli o cellule uovo.",
      "examples": [
        "In questa specie di uccelli migratori, solo la femmina si occupa della cova delle uova.",
        "Gli allevatori hanno selezionato gli esemplari destinati alla riproduzione scartando i maschi e tenendo le femmine più sane."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (f.)",
      "definition": "Persona appartenente al sesso biologico opposto a quello maschile; termine tipico del registro colloquiale, che può veicolare sfumature spregiative o enfatizzanti, mentre in ambito statistico o medico mantiene un valore puramente descrittivo.",
      "examples": [
        "Tra gli studenti del corso di ingegneria ci sono pochi ragazzi e ancora meno femmine.",
        "I dati demografici confermano che le femmine rappresentano la maggioranza della popolazione over ottanta."
      ],
      "nota": "L'uso riferito ad esseri umani è marcatamente informale; in contesti istituzionali, giornalistici o formali si preferiscono 'donna' o la locuzione 'sesso femminile'."
    }
