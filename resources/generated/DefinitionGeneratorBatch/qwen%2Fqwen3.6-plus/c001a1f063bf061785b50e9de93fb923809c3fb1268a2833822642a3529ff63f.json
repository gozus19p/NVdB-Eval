  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Stella gassosa al centro del sistema planetario a cui appartiene la Terra, visibile come disco luminoso nel cielo diurno.",
      "examples": [
        "Gli astronomi hanno calcolato con precisione l'età del nostro sole, stimata in circa 4,6 miliardi di anni.",
        "Il moto di rivoluzione del sole attorno al centro della galassia richiede oltre duecento milioni di anni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Luce e calore emessi dall'astro diurno, percepiti come irradiazione ambientale sulla superficie terrestre.",
      "examples": [
        "Questo pomeriggio la radiazione diurna batte così forte che è consigliabile applicare una protezione elevata prima di uscire.",
        "Abbiamo spostato il divano lontano dalla finestra perché il sole pomeridiano surriscalda troppo l'ambiente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Persona o entità considerata fonte esclusiva di gioia, conforto o centro affettivo fondamentale per qualcuno.",
      "examples": [
        "Dopo un lungo periodo di tristezza, l'arrivo di quel cucciolo è diventato il suo sole e il centro della sua vita affettiva.",
        "Per i nonni quel bambino è l'allegria della casa e riempie di significato ogni incontro familiare."
      ],
      "nota": null
    }
  ]
