  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Prendere un'altra persona come proprio marito o moglie mediante un vincolo legale o religioso.",
      "examples": [
        "Dopo anni di convivenza, ha finalmente sposato la sua compagna.",
        "I miei genitori si sono trasferiti a Napoli prima che lui sposasse mia madre."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Adottare come propria, sostenere attivamente o aderire a un'idea, una causa, un progetto o un orientamento politico.",
      "examples": [
        "Il nuovo direttore ha sposato fin da subito una strategia commerciale più inclusiva.",
        "Non vogliamo sposare nessuna delle due fazioni in questa delicata controversia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Accostare o armonizzare tra loro elementi differenti, in particolare riferito a stili, materiali, colori o concetti.",
      "examples": [
        "L'architetto è riuscito a sposare strutture moderne con elementi storici senza stravolgere il contesto.",
        "Questo vitigno a bacca bianca sposa perfettamente i piatti a base di pesce e crostacei."
      ],
      "nota": "Ricorrente in ambiti legati al design, alla moda, all'enogastronomia e alla comunicazione visiva."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Celebrare o officiare la cerimonia che sancisce l'unione legale o religiosa di due persone.",
      "examples": [
        "Il parroco li ha sposati nella piccola chiesa di montagna.",
        "Domani mattina il vicesindaco sposerà la coppia nella sala consiliare."
      ],
      "nota": "Il soggetto grammaticale è tipicamente un ministro di culto o un'autorità pubblica competente."
    }
  ]
