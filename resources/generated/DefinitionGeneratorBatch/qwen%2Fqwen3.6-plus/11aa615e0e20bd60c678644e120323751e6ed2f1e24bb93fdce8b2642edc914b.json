  "senses": [
    {
      "pos": "transitivo",
      "definition": "Avere al proprio interno o in un determinato spazio; racchiudere o includere oggetti, elementi o informazioni.",
      "examples": [
        "La valigia contiene solo l'essenziale per il weekend.",
        "Il documento ufficiale contiene tre allegati importanti da firmare."
      ],
      "nota": null
    },
    {
      "pos": "transitivo",
      "definition": "Tenere sotto controllo, limitare o frenare l'espansione, l'intensità o l'aumento di fenomeni, emozioni o grandezze economiche.",
      "examples": [
        "La banca centrale ha deciso di contenere l'inflazione alzando i tassi di interesse.",
        "I medici raccomandano di contenere lo stress adottando una routine più equilibrata."
      ],
      "nota": "Frequente nei registri economico, sanitario e psicologico per indicare l'azione di tenere a bada un processo tendente all'eccesso o al danno."
    },
    {
      "pos": "riflessivo",
      "definition": "Moderare il proprio comportamento, le proprie spese o le proprie reazioni entro limiti di misura, frugalità o autocontrollo.",
      "examples": [
        "Nonostante le forti critiche ricevute, si è contenuto e ha risposto con calma.",
        "Dopo l'anno difficile, ci siamo contenuti evitando viaggi e cene fuori casa."
      ],
      "nota": "Richiede obbligatoriamente l'uso del pronome riflessivo corrispondente al soggetto."
    }
  ]
