  "senses": [
    {
      "pos": "sostantivo (maschile)",
      "definition": "Sensazione soggettiva di gioia, soddisfazione o appagamento provocata da un'esperienza, un'attività o un contatto.",
      "examples": [
        "Leggere un buon libro davanti al camino mi regala un vero piacere.",
        "Non ha provato alcun piacere nell'ascoltare le sue lamentele continue."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (maschile)",
      "definition": "Atto di cortesia o favore richiesto o concesso nei rapporti interpersonali, spesso espresso con tono garbato.",
      "examples": [
        "Ti chiederei un grosso piacere: potresti coprire il mio turno domani?",
        "Gli ha fatto un grande piacere accompagnare gli ospiti alla stazione."
      ],
      "nota": "In contesti formali o di cortesia sostituisce esplicitamente termini come «favore» o «cortesia»."
    },
    {
      "pos": "verbo (intransitivo, impersonale, ausiliare «essere»)",
      "definition": "Suscitare gradimento o interesse in una persona; incontrare il favore o l'approvazione.",
      "examples": [
        "Mi piace molto ascoltare la musica classica durante i viaggi in treno.",
        "A quella collega non sono mai piaciuti i cambiamenti improvvisi di programma."
      ],
      "nota": "Il soggetto grammaticale coincide con la persona o la cosa che suscita il gradimento, mentre chi prova il sentimento è espresso tramite un pronome o sintagma di termine (a me, a lui, a noi, ecc.)."
    }
  ]
