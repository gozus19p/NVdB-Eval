  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Cedere la proprietà di un bene o un servizio a un acquirente, ottenendone un corrispettivo in denaro.",
      "examples": [
        "Abbiamo deciso di vendere la macchina dopo dieci anni e i passaggi di proprietà sono stati molto semplici.",
        "In quel mercato rionale molti contadini vendono direttamente i loro prodotti di stagione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Sacrificare o rivelare, per tornaconto personale, principi morali, ideali, riservatezza o la fiducia altrui.",
      "examples": [
        "Un vero professionista non vende mai i propri valori etici pur di compiacere il datore di lavoro.",
        "Durante il processo è emerso che l'imputato aveva venduto documenti riservati a una testata estera."
      ],
      "nota": "In questo ambito assume forte connotazione negativa, equiparandosi concettualmente al tradimento o alla corruzione."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Riscuotere successo sul mercato, trovare numerosi acquirenti o generare un elevato volume di transazioni commerciali.",
      "examples": [
        "Il nuovo videogioco vende a ritmi incredibili fin dalla prima settimana di lancio.",
        "Purtroppo questo tipo di abbigliamento formale vende sempre meno rispetto al casual."
      ],
      "nota": "Costruzione tipica con soggetto inanimato, spesso accompagnata da avverbi di modo o quantità."
    }
