  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Spostare un oggetto esercitando una forza diretta verso sé stessi o lungo un asse specifico",
      "examples": [
        "Per aprire il vecchio cancello rustico bisogna tirare la catena con decisione",
        "Il cavallo tirava il carro lungo la strada sterrata"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Scagliare un oggetto, vibrare un colpo fisico o effettuare un lancio verso un bersaglio",
      "examples": [
        "L'attaccante ha tirato la palla nell'angolo basso senza dare scampo al portiere",
        "Durante la lite gli ha vibrato un pugno improvviso alla spalla"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Tracciare rapidamente una linea, un disegno o redigere un testo in modo sommario",
      "examples": [
        "Prima della riunione ho dovuto tirare giù un promemoria con le idee principali",
        "L'architetto ha tracciato due linee sulla planimetria per indicare il passaggio"
      ],
      "nota": "Spesso accompagnato dalla particella avverbiale 'giù'"
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Dirigersi o procedere verso una certa direzione geografica o figurata",
      "examples": [
        "Se continui a tirare dritto per tre chilometri arriverai alla stazione",
        "Con questo ritmo stiamo procedendo verso un risultato positivo"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inalare aria o gas attraverso le vie respiratorie con un movimento attivo di aspirazione",
      "examples": [
        "Si fermò un attimo sul balcone per tirare una lunga boccata di aria fresca",
        "In alta quota bisogna aspirare il respiro più a fondo per ossigenare i muscoli"
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Continuare a funzionare, mantenere l'efficienza o resistere nel tempo",
      "examples": [
        "Spero che la batteria del telefono duri almeno fino a stasera",
        "Questo vecchio motore mantiene le prestazioni ancora sorprendentemente bene dopo vent'anni"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Ricavare conseguenze, bilanci o deduzioni a partire da premesse o dati raccolti",
      "examples": [
        "Dopo aver analizzato i dati di vendita, il manager deve prendere le decisioni strategiche finali",
        "Prima di investire, dobbiamo calcolare il totale dei costi sostenuti finora"
      ],
      "nota": "Frequente in locuzioni cristallizzate come 'tirare le somme' o 'tirare le conclusioni'"
    },
    {
      "pos": "verbo intransitivo / impersonale",
      "definition": "Sperimentare un'inclinazione o un desiderio spontaneo verso un'attività o uno stato",
      "examples": [
        "Oggi non mi tira molto affrontare il trasferimento in un'altra città",
        "Quando sento quell'odore mi attira istintivamente di tornare al mare"
      ],
      "nota": "Registato prevalentemente nei registri informale e colloquiale"
    },
    {
      "pos": "verbo transitivo",
      "definition": "Produrre stampe, copie o duplicati a partire da un originale fisico o digitale",
      "examples": [
