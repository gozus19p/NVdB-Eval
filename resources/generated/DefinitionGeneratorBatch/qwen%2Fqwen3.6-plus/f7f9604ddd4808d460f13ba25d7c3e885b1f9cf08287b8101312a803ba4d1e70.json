  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "Condizione in cui forze, grandezze o componenti fisiche o chimiche di un sistema si controbilanciano reciprocamente, mantenendo uno stato di stabilità.",
      "examples": [
        "Gli ingegneri hanno analizzato le forze in gioco per garantire la stabilità strutturale del ponte.",
        "L'architetto ha progettato le fondamenta in modo che il peso dell'edificio sia ripartito in modo uniforme sul terreno."
      ],
      "nota": "Riferito principalmente a contesti scientifici e tecnici."
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Capacità del corpo umano o animale di mantenere una postura stabile e di evitare la caduta.",
      "examples": [
        "Dopo la caduta in bicicletta, il bambino ha faticato a ritrovare la stabilità sulle gambe.",
        "La ginnastica dolce aiuta gli anziani a preservare la coordinazione e a muoversi con sicurezza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Stabilità emotiva e mentale che consente di affrontare le situazioni con razionalità, evitando reazioni impulsive o eccessi.",
      "examples": [
        "Il percorso terapeutico le ha permesso di ritrovare una maggiore serenità interiore dopo un periodo molto difficile.",
        "Gestire lo stress quotidiano richiede strumenti adeguati per non compromettere il proprio benessere psicologico."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Condizione di armonia o giusta proporzione tra componenti diverse all'interno di un organismo sociale, economico o istituzionale.",
      "examples": [
        "Gli accordi internazionali puntano a mantenere una ripartizione stabile del potere tra le diverse nazioni.",
        "La sostenibilità del bilancio statale dipende da un corretto rapporto tra entrate fiscali e spesa pubblica."
      ],
      "nota": "Spesso impiegato in sintagmi fissi legati a politica, economia, ecologia e relazioni internazionali."
    }
