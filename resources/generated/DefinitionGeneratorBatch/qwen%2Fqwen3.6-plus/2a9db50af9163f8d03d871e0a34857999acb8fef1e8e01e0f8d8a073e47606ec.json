  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "Titolo onorifico e forma di appello rispettosa per un uomo adulto, utilizzato da solo o prima del nome e del cognome in contesti formali.",
      "examples": [
        "Mi scusi, signore, potrebbe indicarmi la strada per la stazione?",
        "Il pacco è stato consegnato ieri mattina al signore che abita al quarto piano."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Individuo che si distingue per educazione, eleganza e benessere economico nel comportamento e nello stile di vita.",
      "examples": [
        "Si veste e si muove sempre da vero signore, senza mai ostentare la propria ricchezza.",
        "Anche nelle difficoltà ha mantenuto le maniere e la dignità di un signore."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Persona che esercita autorità, controllo o diritto di proprietà su beni, territori o altre persone.",
      "examples": [
        "Dopo anni di contese legali è diventato il signore indiscusso di quella tenuta agricola.",
        "Non permettere che l'ansia si faccia signore delle tue decisioni."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Entità divina suprema nella tradizione monoteista, identificata con Dio o con Gesù Cristo.",
      "examples": [
        "I fedeli si sono raccolti in preghiera per ringraziare il Signore delle grazie ricevute.",
        "Affidiamo questo momento difficile alla misericordia del Signore."
      ],
      "nota": "In ambito religioso e liturgico il termine si scrive invariabilmente con l'iniziale maiuscola."
    }
  ]
