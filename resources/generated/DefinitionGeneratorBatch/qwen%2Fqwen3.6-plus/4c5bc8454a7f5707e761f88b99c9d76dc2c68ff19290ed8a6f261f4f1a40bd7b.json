  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Venire a trovarsi alla presenza di una persona o di un animale, per caso o in modo previsto.",
      "examples": [
        "Ieri ho incontrato un vecchio compagno di scuola al bar.",
        "Mentre camminavano nel parco, hanno incontrato una volpe."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Trovarsi di fronte a una situazione complessa, a un ostacolo o a un aspetto negativo.",
      "examples": [
        "Durante la ristrutturazione della casa abbiamo incontrato diversi imprevisti.",
        "La nuova proposta di legge ha incontrato forti opposizioni in parlamento."
      ],
      "nota": "L'uso ha prevalentemente connotazione negativa o di difficoltà, sebbene in contesti specifici possa riferirsi a circostanze neutrali o positive non ostative."
    }
  ]
