  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "sostanza allo stato fluido, priva di forma propria e capace di adattarsi a quella del recipiente che la contiene",
      "examples": [
        "Il tecnico ha prelevato un campione del fluido per analizzarlo in laboratorio.",
        "Versare il contenuto nel contenitore prima di chiuderlo ermeticamente."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "che si trova in uno stato di fluidità fisicamente caratterizzato da volume proprio e assenza di forma definita",
      "examples": [
        "A temperature particolarmente basse, l'ossigeno passa dallo stato gassoso a quello condensato e scorrevole.",
        "Molti pazienti preferiscono assumere i farmaci in formulazione scioglibile o in gocce per facilitare la deglutizione."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "disponibile in denaro contante o facilmente trasformabile in contante nel breve periodo",
      "examples": [
        "L'azienda ha affrontato le emergenze operative grazie a una consistente riserva di fondi immediatamente spendibili.",
        "Prima di firmare il rogito, ha verificato di avere sufficiente capitale disponibile per coprire la caparra."
      ],
      "nota": "terminologia specialistica dell'ambito economico-finanziario"
    },
    {
      "pos": "aggettivo",
      "definition": "limpido, trasparente e cristallino, privo di impurità, torbidità o opacità visiva o sonora",
      "examples": [
        "Dopo il temporale, l'azzurro del cielo appariva particolarmente nitido e brillante.",
        "Nonostante la stanchezza, manteneva uno sguardo limpido e vivace che colpiva chi lo incontrava."
      ],
      "nota": "ricorrente in registri letterario e descrittivo, spesso riferito a occhi, lacrime, luci o atmosfere"
    }
  ]
