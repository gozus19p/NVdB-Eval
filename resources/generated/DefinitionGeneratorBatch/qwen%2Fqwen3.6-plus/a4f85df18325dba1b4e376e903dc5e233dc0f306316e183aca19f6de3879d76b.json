  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Vertebrato acquatico a respirazione branchiale, provvisto di pinne e di solito ricoperto di squame.",
      "examples": [
        "Il ricercatore ha censito oltre duecento specie di fauna ittica, concentrando l'attenzione sul comportamento del vertebrato marino.",
        "In quello stagno vivono solo esemplari di piccola taglia, ma la specie più resistente è un organismo d'acqua dolce autoctono."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Carne edibile di vertebrati acquatici, comunemente utilizzata nell'alimentazione umana.",
      "examples": [
        "Il nutrizionista raccomanda di consumare proteine ittiche bollite o al vapore almeno due volte a settimana.",
        "Al mercato rionale ho acquistato un bel trancio da grigliare per la cena di stasera."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Persona inesperta, credulona o facilmente raggirabile; per estensione, soggetto di modesto rilievo o, in specifiche gerarchie informali, di grande potere e influenza.",
      "examples": [
        "Durante la prima esercitazione pratica si è dimostrato un vero novellino, sbagliando ogni manovra richiesta.",
        "Nell'inchiesta giudiziaria i magistrati hanno deciso di concentrarsi sui dirigenti apicali tralasciando i complici di basso rango."
      ],
      "nota": "L'accezione figurata è frequente in contesti professionali, sportivi o investigativi e si cristallizza spesso in espressioni consolidatesi nell'uso come 'pesci grossi' o 'pesci piccoli'."
    }
  ]
