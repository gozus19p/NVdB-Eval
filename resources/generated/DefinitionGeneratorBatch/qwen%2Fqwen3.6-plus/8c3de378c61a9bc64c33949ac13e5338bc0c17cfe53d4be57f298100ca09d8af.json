  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Di un colore simile a quello del sole, del limone o delle banane mature.",
      "examples": [
        "Ha dipinto la cucina di un giallo molto luminoso.",
        "In autunno le foglie di platano diventano tutte gialle."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Colore primario situato nello spettro visibile tra il verde e l'arancione.",
      "examples": [
        "Il giallo della mimosa annuncia l'arrivo della primavera.",
        "Per ottenere il verde si mescola il giallo con il blu."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Genere narrativo o cinematografico incentrato sullo svolgimento di un'indagine per scoprire l'autore di un delitto o risolvere un enigma.",
      "examples": [
        "Legge principalmente romanzi polizieschi perché è un grande appassionato di giallo.",
        "La nuova serie televisiva è un giallo psicologico ambientato in un paesino di montagna."
      ],
      "nota": "Deriva, per metonimia, dal colore delle copertine dei volumi pubblicati da Mondadori a partire dal 1929 nella collana \"I libri gialli\"."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Avvenimento, situazione o vicenda dal carattere oscuro, misterioso, difficile da comprendere o da risolvere.",
      "examples": [
        "La scomparsa del giornalista rimane un giallo che gli inquirenti non riescono a sciogliere.",
        "C'è un giallo dietro le dimissioni improvvise del direttore generale."
      ],
      "nota": null
    }
  ]
