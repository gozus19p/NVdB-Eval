  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Portare a compimento con le proprie azioni una condotta o un evento considerato sbagliato, illecito, moralmente riprovevole o dannoso.",
      "examples": [
        "Il tecnico ha commesso un errore nella configurazione del server, causando un'interruzione del servizio.",
        "La giuria lo ha riconosciuto colpevole per aver commesso il reato in stato di ubriachezza.",
        "Non avrebbe mai voluto commettere quella leggerezza, ma la fretta gli ha giocato un brutto scherzo."
      ],
      "nota": "Il verbo regge in prevalenza complementi oggetto che denotano azioni illecite, colpevoli o negative; per azioni neutre o positive l'uso contemporaneo richiede 'fare' o 'compiere'."
    }
  ]
