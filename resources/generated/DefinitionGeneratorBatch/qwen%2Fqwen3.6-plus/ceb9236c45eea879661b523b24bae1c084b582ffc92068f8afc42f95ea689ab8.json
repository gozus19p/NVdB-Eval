  "senses": [
    {
      "pos": "sostantivo (m.)",
      "definition": "Porzione di curva, in particolare di circonferenza, compresa tra due punti estremi.",
      "examples": [
        "Con il compasso ha tracciato un arco di novanta gradi sul foglio da disegno.",
        "La strada di montagna descrive un ampio arco prima di immettersi nell'uscita."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Elemento costruttivo a forma curva, solitamente composto da conci o mattoni sovrapposti, impiegato per sostenere carichi o coprire un'apertura.",
      "examples": [
        "Il portone della dimora cinquecentesca è incorniciato da un grande arco in pietra.",
        "La cattedrale gotica è celebre per la struttura complessa dei suoi archi rampanti."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Strumento da lancio costituito da un fusto flessibile e incurvato alle estremità, provvisto di una corda tesa per scagliare frecce.",
      "examples": [
        "Gli atleti della squadra nazionale si allenano quotidianamente con l'arco.",
        "Nel museo storico è esposto un antico arco composito in legno e corno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Accessorio per strumenti musicali a corde, formato da un'asta ricurva e da un fascio di crini o fibre tese parallelamente, che viene strofinato sulle corde per produrre il suono.",
      "examples": [
        "Il primo violinista ha cambiato i crini dell'arco prima del concerto.",
        "Una corretta impugnatura dell'arco è fondamentale per ottenere un suono pulito."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo (m.)",
      "definition": "Intervallo di tempo o tratto di superficie delimitato da un punto di inizio e uno di fine.",
      "examples": [
        "I lavori di ristrutturazione sono stati completati nell'arco di una sola settimana.",
        "La monografia analizza le opere del pittore nell'arco di trent'anni di produzione."
      ],
      "nota": "Usato prevalentemente in contesti figurati per indicare durata o estensione, spesso introdotto dalle preposizioni 'in' o 'nell'."
    }
  ]
