  "senses": [
    {
      "pos": "sostantivo, femminile",
      "definition": "Nucleo di persone unite da vincoli di sangue, matrimonio, adozione o affettivi, che convivono o costituiscono un'unità sociale riconosciuta.",
      "examples": [
        "Dopo il trasloco, tutta la famiglia ha collaborato per sistemare le scatole.",
        "Negli ultimi anni il concetto giuridico e sociale di questa istituzione si è ampliato notevolmente."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, femminile",
      "definition": "Categoria della classificazione scientifica degli organismi viventi, collocata gerarchicamente sopra il genere e sotto l'ordine, che raggruppa entità con caratteristiche anatomiche ed evolutive comuni.",
      "examples": [
        "Il cane, il lupo e la volpe fanno parte dello stesso raggruppamento di carnivori.",
        "Gli esperti hanno classificato il nuovo ceppo microbico in un taxon già noto ai ricercatori."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, femminile",
      "definition": "Insieme di lingue o dialetti che derivano da una protolingua comune e presentano sistematiche corrispondenze fonetiche, morfosintattiche e lessicali.",
      "examples": [
        "Lo spagnolo e il francese appartengono al medesimo gruppo di idiomi di origine latina.",
        "I glottologi ricostruiscono l'evoluzione storica studiando le affinità tra questi gruppi linguistici."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, femminile",
      "definition": "Insieme di persone, oggetti, istituzioni o fenomeni accomunati da origine, caratteristiche strutturali, funzioni o legami storici e culturali.",
      "examples": [
        "Questo modello di automobile appartiene al gruppo di vetture ibride compatte più vendute quest'anno.",
        "Tutti i programmi applicativi della suite formano un ecosistema software perfettamente integrato."
      ],
      "nota": null
    }
  ]
