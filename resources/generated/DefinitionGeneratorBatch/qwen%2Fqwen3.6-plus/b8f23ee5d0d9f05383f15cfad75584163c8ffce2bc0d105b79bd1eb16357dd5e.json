  "senses": [
    {
      "pos": "aggettivo",
      "definition": "Proprio dell'invenzione narrativa o della creatività intellettuale; non corrispondente alla realtà concreta ma frutto dell'immaginazione.",
      "examples": [
        "La trama del romanzo è ambientata in un regno popolato da draghi e maghi che non esistono nella storia reale.",
        "I racconti della sua infanzia avevano un'aura irreale, quasi costruiti con elementi inventati di sana pianta."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Straordinariamente positivo, di notevole pregio o piacevolezza; eccezionale.",
      "examples": [
        "Abbiamo trascorso un weekend magnifico al mare, con il sole sempre alto e una compagnia brillantissima.",
        "Il tuo intervento durante la conferenza è stato davvero eccellente e ha catturato l'attenzione di tutti i presenti."
      ],
      "nota": "Uso prevalentemente colloquiale o enfatico, molto frequente nel parlato contemporaneo come valutazione positiva generica."
    },
    {
      "pos": "aggettivo",
      "definition": "Che si discosta nettamente dalla verosimiglianza o dai parametri reali; esagerato o inverosimile.",
      "examples": [
        "Le cifre fornite dal responsabile sono del tutto irreali e non trovano alcun riscontro nei documenti ufficiali.",
        "Pretendere che un cantiere così complesso venga chiuso in quarantotto ore è un obiettivo completamente campato in aria."
      ],
      "nota": "Spesso impiegato in contesti critici o ironici, specialmente riferito a preventivi, statistiche o aspettative irraggiungibili."
    }
  ]
