  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Suddivisione geografica o amministrativa di un centro abitato, solitamente delimitata da confini precisi e caratterizzata da funzioni, servizi o un'identità sociale specifica.",
      "examples": [
        "La nuova linea della metropolitana attraversa tre quartieri prima di arrivare in centro.",
        "Nel nostro quartiere mancano ancora parchi giochi e spazi verdi."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "(per metonimia) L'insieme degli abitanti di una determinata zona urbana, concepito come comunità dotata di volontà o azioni collettive.",
      "examples": [
        "Tutto il quartiere si è mobilitato per ripulire le strade dopo la tempesta.",
        "Negli ultimi anni il quartiere ha sviluppato un forte spirito di appartenenza."
      ],
      "nota": "Uso frequente nel linguaggio giornalistico e sociologico per evidenziare la partecipazione civica o la coesione territoriale."
    }
