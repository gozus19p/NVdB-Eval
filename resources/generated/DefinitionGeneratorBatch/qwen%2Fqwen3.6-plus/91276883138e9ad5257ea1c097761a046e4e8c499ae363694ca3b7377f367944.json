  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Allontanarsi da un luogo chiuso o delimitato portandosi verso l'esterno.",
      "examples": [
        "La lezione è terminata e gli studenti hanno iniziato a uscire dall'aula.",
        "Prima di uscire, controlla di aver spento i fornelli e chiuso la porta a chiave."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Recarsi fuori dall'abitazione o da un contesto privato per dedicarsi a svaghi, incontri sociali o commissioni.",
      "examples": [
        "Stasera vorrei uscire con gli amici invece di restare a casa a guardare la televisione.",
        "Durante l'inverno esce molto poco perché preferisce il caldo domestico e la lettura."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Essere pubblicato, distribuito o immesso sul mercato, con riferimento a opere intellettuali, prodotti commerciali o informazioni ufficiali.",
      "examples": [
        "Il nuovo album della band uscirà venerdì in formato sia digitale che fisico.",
        "I risultati dell'esame universitario usciranno sul portale didattico entro domani pomeriggio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentare un determinato risultato, aspetto finale o qualità a seguito di uno svolgimento o processo creativo, produttivo o discorsivo.",
      "examples": [
        "La cena è uscita bene anche se abbiamo dovuto improvvisare con quello che restava in frigo.",
        "Dal confronto tra i docenti è uscita una strategia didattica più inclusiva per le classi speciali."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Cessare di appartenere a una condizione, stato o ruolo, superandolo o abbandonandolo progressivamente.",
      "examples": [
        "L'azienda è uscita dalla fase di recessione grazie alla riduzione dei costi e a nuovi investimenti.",
        "Il presidente della regione uscirà dalla carica alle prossime elezioni amministrative."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Presentare discrepanze o incoerenze rispetto a quanto calcolato, misurato o logicamente atteso.",
      "examples": [
        "Ho rifatto la somma per la terza volta, ma i conti non escono: mancano cento euro.",
        "Questa ipotesi di ricerca non esce perché si basa su campioni statistici troppo piccoli."
      ],
      "nota": null
    }
  ]
