  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Non cessare, procedere senza interruzione nel tempo o nello spazio, oppure persistere in una condizione, un fenomeno o un comportamento già manifestato.",
      "examples": [
        "La pioggia è continuata per tutta la notte, allagando le strade più basse.",
        "Nonostante le prime cure, il fastidio alla gamba continua a farsi sentire quando sale le scale."
      ],
      "nota": "Regge comunemente gli ausiliari avere o essere a seconda del contesto; quando introduce un'altra azione, si costruisce con la preposizione a seguita dal verbo all'infinito."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Portare avanti, senza interromperla, un'attività, un'opera, un discorso o un rapporto già intrapresi.",
      "examples": [
        "Dopo la breve pausa caffè, il relatore ha continuato la sua esposizione davanti alla platea.",
        "Nonostante i tagli al bilancio, l'amministrazione ha continuato i lavori di restauro del teatro comunale."
      ],
      "nota": "Richiede un complemento oggetto diretto esplicito e regge esclusivamente l'ausiliare avere."
    }
  ]
