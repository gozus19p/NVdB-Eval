  "senses": [
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona che assiste o partecipa a un evento, fatto o situazione e può riferire quanto accaduto o percepito direttamente.",
      "examples": [
        "Era testimone dell'incidente e ha chiamato subito i soccorsi.",
        "Molti passanti sono stati testimoni della manifestazione in piazza."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Persona chiamata a comparire in un procedimento giudiziario per riferire sotto giuramento fatti di cui ha conoscenza diretta o indiretta.",
      "examples": [
        "Il giudice ha convocato il testimone chiave per la deposizione di domani.",
        "La difesa ha presentato tre testimoni a favore dell'imputato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m./f.",
      "definition": "Oggetto, documento o elemento che fornisce prova o documentazione di un evento, periodo o stato di cose.",
      "examples": [
        "Il vecchio orologio è testimone silenzioso di generazioni di famiglie.",
        "Questa fotografia è un testimone fedele del nostro viaggio in montagna."
      ],
      "nota": null
    }
  ]
