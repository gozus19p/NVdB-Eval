  "senses": [
    {
      "pos": "sostantivo f.",
      "definition": "Parte terminale dell'arto superiore umano, caratterizzata da pollice e quattro dita, adibita principalmente alla prensione, alla manipolazione di oggetti e alla percezione tattile.",
      "examples": [
        "Si è tagliato la mano sbucciando una mela con il coltello.",
        "Ha alzato la mano per chiedere di uscire durante la lezione di matematica."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo f.",
      "definition": "Abilità pratica, precisione o competenza tecnica nel compiere specifiche attività, in particolare di tipo manuale, artigianale o artistico.",
      "examples": [
        "Il pizzaiolo ha dimostrato una mano incredibile nel stendere la pasta senza romperla.",
        "Per incidere il legno servono attrezzi affilati e un'esecuzione guidata da mano esperta."
      ],
      "nota": "Ricorrente in costruzioni predicative come 'avere buona mano' o 'perdere la mano'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Contributo concreto offerto o richiesto per agevolare lo svolgimento di un compito o per superare una situazione di difficoltà.",
      "examples": [
        "Mi potreste dare una mano a portare le casse al piano di sopra?",
        "L'associazione cerca volontari disposti a dare una mano durante il weekend di pulizia."
      ],
      "nota": "Impiegato quasi esclusivamente nelle locuzioni 'dare una mano' o 'chiedere una mano'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Strato sottile e uniforme di una sostanza, come vernice, intonaco o colla, applicato in un'unica passata su una superficie.",
      "examples": [
        "Dopo la prima applicazione di smalto, il mobile ha già un aspetto più levigato.",
        "Il restauratore ha steso una mano di colla specifica per fissare la carta da parati."
      ],
      "nota": "Termine tecnico corrente nel lavoro manuale, nella ristrutturazione e nella decorazione."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Situazione di disponibilità, influenza diretta o controllo effettivo su una persona, un oggetto o una vicenda.",
      "examples": [
        "Con i nuovi documenti, gli inquirenti hanno finalmente in mano le prove decisive.",
        "La gestione del ristorante è passata di mano dopo una lunga trattativa con gli acquirenti."
      ],
      "nota": "Si combina tipicamente con verbi di stato o moto come 'tenere', 'avere', 'passare', 'cadere'."
    },
    {
      "pos": "sostantivo f.",
      "definition": "Fase o turno di svolgimento in alcuni giochi, in particolare di carte o biliardo, durante il quale ciascun partecipante utilizza le proprie risorse o esegue un tiro secondo le regole stabiliti.",
      "examples": [
        "L'ultima fase del torneo di poker ha ribaltato completamente la classifica finale.",
        "Abbiamo continuato a giocare a tombola fino a tarda notte, cambiando turno ogni volta."
      ],
      "nota": null
    }
  ]
