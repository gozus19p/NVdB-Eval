  "senses": [
    {
      "pos": "verbo intransitivo",
      "definition": "Pronunciare battute o espressioni giocose con l'intento di divertire o alleggerire la conversazione, senza richiedere che quanto detto venga preso sul serio.",
      "examples": [
        "Durante la cena si è creato un clima molto disteso perché Marco non ha smesso un attimo di scherzare.",
        "Per favore, non offenderti per la mia osservazione: stavo solo scherzando per rompere il ghiaccio."
      ],
      "nota": null
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Affrontare una situazione seria, un pericolo o una responsabilità con eccessiva superficialità, non attribuendole la dovuta considerazione.",
      "examples": [
        "In ambito medico non si può mai scherzare con le dosi dei farmaci senza consultare un professionista.",
        "Dopo l'incidente hanno compreso che non c'è più spazio per scherzare sulla manutenzione degli impianti."
      ],
      "nota": "Si costruisce prevalentemente con le preposizioni 'su' o 'con'; nell'uso corrente veicola una netta sfumatura di ammonimento rispetto a comportamenti imprudenti."
    }
