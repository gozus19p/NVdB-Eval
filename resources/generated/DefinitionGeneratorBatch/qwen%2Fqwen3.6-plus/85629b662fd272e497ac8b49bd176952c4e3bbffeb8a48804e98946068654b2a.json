  "senses": [
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Realizzare caratteri alfabetici o grafici su un supporto tramite strumenti manuali o dispositivi elettronici, al fine di fissare informazioni, messaggi o pensieri.",
      "examples": [
        "Ha scritto il suo nome sul registro con una calligrafia ordinata.",
        "I bambini imparano a formare le lettere e a scrivere in prima elementare."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Creare o comporre un'opera testuale, letteraria, giornalistica o musicale, ricoprendo il ruolo di autore.",
      "examples": [
        "L'autrice ha deciso di comporre un romanzo storico ambientato nel Rinascimento.",
        "Ha redatto la sceneggiatura del film che ha vinto il festival internazionale."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inviare una comunicazione, un messaggio o un testo a una persona specifica, attraverso corrispondenza tradizionale o digitale.",
      "examples": [
        "Ti contatterò domani appena avrò notizie fresche.",
        "Le ha inviato un'email per confermare l'appuntamento di venerdì."
      ],
      "nota": "Spesso regge la preposizione 'a' per introdurre il destinatario della comunicazione."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Memorisare, registrare o trasferire dati e informazioni su un dispositivo di archiviazione fisica o digitale.",
      "examples": [
        "Il sistema deve salvare i dati di accesso in una directory protetta.",
        "L'applicazione registra le informazioni sul server centrale senza errori."
      ],
      "nota": "Termine di uso prevalente in ambito informatico e tecnologico."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Determinare in modo duraturo e irreversibile il corso di eventi, la reputazione o il destino di qualcuno o qualcosa.",
      "examples": [
        "Quella vittoria ha segnato una nuova pagina nella storia del club.",
        "Il suo sacrificio ha definito un capitolo fondamentale nella medicina moderna."
      ],
      "nota": "Uso figurato e idiomatico, spesso in costruzioni metaforiche legate a eventi storici o percorsi personali."
    },
    {
      "pos": "verbo intransitivo",
      "definition": "Produrre segni grafici in modo regolare e leggibile, con riferimento a penne, matite o strumenti di tracciatura.",
      "examples": [
        "Questa penna non funziona più perché la cartuccia è esaurita.",
        "La matita traspone male su carta troppo liscia e vetrata."
      ],
      "nota": "Il soggetto della frase è lo strumento di tracciatura, non la persona che compie l'azione."
    }
  ]
