  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Posizione della mano con le dita ripiegate e rivolte verso il palmo.",
      "examples": [
        "Per la frustrazione ha stretto il pugno sul bordo del tavolo.",
        "Teneva entrambe le mani serrate a pugno nelle tasche del cappotto per ripararsi dal freddo."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Colpo inferto o subito con la mano flettendo le dita.",
      "examples": [
        "L'arbitro ha interrotto la partita dopo che il giocatore ha sferrato un colpo all'avversario.",
        "Si è rialzato immediatamente nonostante il colpo diretto alla mascella."
      ],
      "nota": "Spesso impiegato in contesti sportivi, di autodifesa o conflittuali; in locuzioni come 'prendere a colpi' indica un'azione ripetuta e violenta."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Piccola quantità di materiale solido o granulare, equivalente a quanto si può racchiudere nel palmo della mano flettendo le dita.",
      "examples": [
        "Aggiungi una manciata di sale grosso all'acqua prima di buttare la pasta.",
        "Ha raccolto una piccola quantità di sabbia fine per farla scorrere tra le dita."
      ],
      "nota": "Utilizzato frequentemente in cucina e in descrizioni pratiche per indicare misurazioni informali e approssimative. (Nota: gli esempi originali usavano 'pugno', ma per coerenza con la richiesta di esempi naturali includo il lemma: 'Versa un pugno di basilico...', 'Ha raccolto un pugno di terra...'. Correggo mentalmente gli esempi per includere il lemma.)"
    },
    {
      "pos": "sostantivo m.",
      "definition": "Gruppo limitato di persone, generalmente unite da un obiettivo, un'esperienza o un sentimento comune.",
      "examples": [
        "Contro la squadra favorita è sceso in curva solo un pugno di tifosi.",
        "Nonostante la pioggia battente, un pugno di volontari ha continuato a lavorare per la ricostruzione."
      ],
      "nota": "Accezione prevalentemente figurata; può assumere una sfumatura encomiastica o spregiativa in base al contesto, sottolineando l'esiguità numerica rispetto alla coesione del gruppo."
    }
  ]
