  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Allontanare con decisione o forza una persona o un'entità da un determinato luogo, impiego o condizione sociale.",
      "examples": [
        "Il preside ha deciso di cacciare dalla scuola tutti gli studenti coinvolti nell'episodio.",
        "Dopo la cattiva gestione del budget, il consiglio d'amministrazione lo ha cacciato dalla carica direttiva."
      ],
      "nota": "Regge frequentemente il complemento di provenienza introdotto da 'di' o 'da'; usato anche in senso figurato per situazioni non fisiche."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Inseguire, catturare o abbattere animali selvatici, solitamente per attività sportiva o per sussistenza alimentare.",
      "examples": [
        "Mio zio si sveglia all'alba per cacciare cinghiali nei boschi dell'Appennino.",
        "Nella riserva naturale è severamente vietato cacciare la fauna protetta durante il periodo di nidificazione."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Emettere, estrarre o far uscire qualcosa con impulso violento, sforzo improvviso o impazienza.",
      "examples": [
        "Non riusciva più a trattenere la rabbia e ha cacciato un urlo che ha gelato tutti in sala.",
        "Dopo mesi di rinvii, finalmente il cliente ha cacciato fuori la somma pattuita."
      ],
      "nota": "Di uso marcatamente colloquiale; spesso accompagna le particelle avverbiali 'fuori' o 'via' per specificare l'idea di estrazione forzata o eliminazione immediata."
    }
  ]
