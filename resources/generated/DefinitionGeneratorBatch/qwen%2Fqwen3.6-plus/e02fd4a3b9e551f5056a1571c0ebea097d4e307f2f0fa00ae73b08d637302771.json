  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Veicolo ferroviario formato da una serie di vagoni collegati tra loro, trainati da una motrice o dotati di trazione autonoma, destinato al trasporto di passeggeri o merci su rotaie.",
      "examples": [
        "Per andare in vacanza abbiamo preferito il treno all'auto, così da viaggiare senza stress.",
        "Il capostazione ha annunciato un ritardo di venti minuti per la prossima composizione in partenza dal binario tre."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Successione ininterrotta e rapida di elementi, eventi o azioni che si susseguono uno dopo l'altro con intensità.",
      "examples": [
        "Dopo lo scandalo, il portavoce ha dovuto rispondere a un treno di domande incalzanti da parte dei cronisti.",
        "Quella stagione la squadra ha vissuto un treno di infortuni che ne ha compromesso seriamente il rendimento."
      ],
      "nota": "Usato prevalentemente in contesti figurati, spesso in abbinamento a sostantivi astratti indicanti eventi, parole o situazioni particolarmente ravvicinate o faticose."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Coda o strascico di un abito formale o cerimoniale, realizzato con tessuto lungo che striscia sul terreno dietro chi lo indossa.",
      "examples": [
        "L'abito nuziale della sposa presentava una lunga strascico impreziosito da merletti e cristalli.",
        "Durante la sfilata la modella ha dovuto imparare a muoversi senza calpestare la parte posteriore del vestito."
      ],
      "nota": null
    }
  ]
