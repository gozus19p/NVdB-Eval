  "senses": [
    {
      "pos": "sostantivo maschile",
      "definition": "Stato fisiologico periodico di riposo in cui la coscienza e le attività motorie volontarie sono temporaneamente sospese e l'organismo recupera le energie.",
      "examples": [
        "Il neonato è caduto in un sonno profondo e ristoratore subito dopo la poppata.",
        "Durante la notte il cervello elabora le informazioni acquisite nelle diverse fasi di riposo notturno."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Stimolo fisiologico o sensazione di forte stanchezza che induce la necessità immediata di addormentarsi.",
      "examples": [
        "Dopo il viaggio in autostrada mi sta prendendo un sonno che non riesco a contrastare.",
        "La noia della riunione mi faceva venire voglia di chiudere gli occhi per via della pesantezza delle palpebre."
      ],
      "nota": "Frequentemente impiegato in locuzioni cristallizzate come 'aver sonno' o 'prendere sonno'."
    },
    {
      "pos": "sostantivo maschile",
      "definition": "Condizione di inerzia, stagnazione o mancanza di iniziativa e dinamismo in contesti sociali, economici o culturali.",
      "examples": [
        "L'intero comparto manifatturiero versa in un sonno decennale che scoraggia gli investitori esteri.",
        "Il nuovo assessore ha dovuto scuotere l'ente locale da un lungo periodo di immobilismo amministrativo."
      ],
      "nota": "Uso metaforico diffuso nel giornalismo e nella saggistica per indicare ristagno strutturale o pigrizia istituzionale."
    }
