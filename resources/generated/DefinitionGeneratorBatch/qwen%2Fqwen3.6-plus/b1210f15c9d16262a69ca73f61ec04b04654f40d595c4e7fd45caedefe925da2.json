  "senses": [
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Commettere un errore o un'inesattezza in un'azione, un calcolo, una scelta o un giudizio.",
      "examples": [
        "Hai sbagliato a non verificare le fonti prima di condividere la notizia.",
        "Se sbagli i calcoli adesso, tutto il lavoro della mattina andrà sprecato."
      ],
      "nota": "Spesso regge la costruzione preposizione 'a' + infinito o si impiega in forma pronominale per evidenziare l'involontarietà dell'azione."
    },
    {
      "pos": "verbo transitivo e intransitivo",
      "definition": "Mancare il punto, il bersaglio o l'obiettivo fisico e concettuale a cui è diretto un lancio, un movimento o un'intenzione.",
      "examples": [
        "Il tiratore ha sbagliato la mira a causa del vento laterale.",
        "Quando si tratta di individuare le criticità in un progetto, non sbaglia mai un colpo."
      ],
      "nota": "In contesto figurato denota il mancato raggiungimento di una meta o, in forma negativa, una competenza o precisione costante."
    }
