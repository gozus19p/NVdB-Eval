  "senses": [
    {
      "pos": "verbo, intransitivo (ausiliare avere)",
      "definition": "Affermare consapevolmente il falso o nascondere deliberatamente la verità a un interlocutore, al fine di ingannare, tutelare sé stessi o altri, o evitare conseguenze negative.",
      "examples": [
        "Non puoi continuare a mentirmi, ormai ho visto le prove che non posso ignorare.",
        "A volte si preferisce tacere per proteggere qualcuno, ma alterare i fatti crea solo più ansia nel lungo periodo."
      ],
      "nota": null
    },
    {
      "pos": "verbo, intransitivo (ausiliare avere)",
      "definition": "Presentare caratteristiche, segnali o dati che non corrispondono alla realtà oggettiva, inducendo in errore chi osserva o interpreta la situazione.",
      "examples": [
        "Le apparenze mentono, quindi non giudicare la solidità di quell'edificio basandoti solo sulla facciata.",
        "La memoria mente spesso con il passare degli anni, presentando versioni degli eventi che si discostano dai fatti reali."
      ],
      "nota": "Uso figurato o esteso, tipico di contesti che coinvolgono percezioni visive, fenomeni naturali, segni diagnostici, statistiche o processi cognitivi."
    }
  ]
