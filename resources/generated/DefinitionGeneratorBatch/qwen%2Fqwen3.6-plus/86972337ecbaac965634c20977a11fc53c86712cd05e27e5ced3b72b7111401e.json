  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Categoria o classe di oggetti, fenomeni o concetti accomunati da caratteristiche fondamentali comuni.",
      "examples": [
        "Questo modello di contratto è valido solo per questo tipo di società.",
        "In commercio si trovano diversi tipi di batterie ricaricabili."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo m.",
      "definition": "Individuo o persona, usato prevalentemente in registri informali con sfumatura neutra o lievemente valutativa.",
      "examples": [
        "Non mi fido di quel tipo che ha cambiato lavoro tre volte in un anno.",
        "È un tipo riservato, ma quando apre il discorso diventa brillante."
      ],
      "nota": "L'uso riflette spesso una valutazione implicita sul carattere o sull'affidabilità della persona."
    },
    {
      "pos": "sostantivo m.",
      "definition": "Esemplare che incarna in modo ideale o prototipico le caratteristiche di una determinata classe.",
      "examples": [
        "Non è il tipo di persona che se ne va senza salutare.",
        "Quel ristorante è il tipo di locale dove si mangia bene spendendo il giusto."
      ],
      "nota": null
    },
    {
      "pos": "avverbio (colloquiale)",
      "definition": "Elemento invariabile usato per segnalare somiglianza, approssimazione numerica o esemplificazione, equivalente a 'più o meno', 'simile a' o 'diciamo'.",
      "examples": [
        "La conferenza è durata tipo tre ore, forse di più.",
        "Il suo stile è molto eclettico, tipo quello dei designer scandinavi degli anni Sessanta."
      ],
      "nota": "Forma altamente grammaticalizzata nel parlato informale; può introdurre citazioni dirette o funzionare come marcatore discorsivo senza alterare la struttura sintattica della frase."
    }
  ]
