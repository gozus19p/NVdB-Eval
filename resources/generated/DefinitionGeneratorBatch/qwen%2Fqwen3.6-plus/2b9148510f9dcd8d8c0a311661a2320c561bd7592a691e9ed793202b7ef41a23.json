  "senses": [
    {
      "pos": "sostantivo, f.",
      "definition": "Unità di misura del tempo pari a sessanta minuti, corrispondente a un ventiquattresimo del giorno.",
      "examples": [
        "Il film dura circa due ore e mezza.",
        "Abbiamo camminato per un'ora intera sotto la pioggia."
      ],
      "nota": "Usato prevalentemente per indicare una durata."
    },
    {
      "pos": "sostantivo, f.",
      "definition": "Momento determinato o periodo circoscritto della giornata, identificato da un orario preciso o da un contesto specifico.",
      "examples": [
        "A quest'ora del mattino il traffico è già intenso.",
        "È ora di uscire, altrimenti arriveremo in ritardo alla cena.",
        "Che ore sono?"
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In questo preciso momento, attualmente, in contrapposizione temporale a prima o dopo.",
      "examples": [
        "Ora devo scappare, ma ci sentiamo stasera per il progetto.",
        "Da ora in poi controllerò sempre due volte le scadenze."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In successione immediata rispetto a un evento precedente o a una premessa; quindi, dopodiché.",
      "examples": [
        "Abbiamo sistemato tutte le valigie, ora finalmente possiamo riposarci.",
        "Una volta compreso il regolamento, ora è più facile partecipare."
      ],
      "nota": null
    },
    {
      "pos": "avverbio",
      "definition": "In alternanza ricorrente, impiegata per segnalare mutamenti successivi e ripetuti di stati, azioni o situazioni.",
      "examples": [
        "Il tempo in montagna è imprevedibile: ora c'è il sole, ora cade la neve.",
        "Durante il lungo viaggio in treno ora leggeva un romanzo, ora osservava il paesaggio."
      ],
      "nota": "Frequente nella struttura correlativa raddoppiata 'ora... ora...' con valore alternativo o iterativo."
    }
  ]
