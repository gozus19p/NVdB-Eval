  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Tornare in possesso di un oggetto, di una somma di denaro o di un dato precedentemente smarrito, sottratto o ceduto.",
      "examples": [
        "Dopo aver perso il portafoglio in metropolitana, è riuscito a recuperarlo grazie alle segnalazioni di un passante.",
        "L'azienda ha recuperato tutti i documenti cancellati per errore intervenendo tempestivamente sul sistema."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Colmare un ritardo o rimediare a un'omissione lavorando o agendo in misura maggiore nel tempo residuo disponibile.",
      "examples": [
        "Devo recuperare le ore di permesso accumulate durante l'anno entro la fine del mese.",
        "Grazie a un ciclo di lezioni intensive, lo studente ha recuperato rapidamente le lacune lasciate dal professore assente."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Salvare, restaurare o valorizzare qualcosa di deteriorato, dimenticato o in disuso, riportandolo a una condizione di utilità o fruibilità.",
      "examples": [
        "Il comune ha avviato un progetto per recuperare il vecchio borgo abbandonato e trasformarlo in struttura ricettiva.",
        "Con un restauro accurato è possibile recuperare mobili antichi destinati alla discarica."
      ],
      "nota": "Frequente in contesti urbanistici, culturali e legati alla sostenibilità ambientale."
    },
    {
      "pos": "verbo transitivo",
      "definition": "Riacquistare condizioni di benessere, efficienza fisica o vantaggio competitivo dopo un periodo di difficulty, malattia o svantaggio.",
      "examples": [
        "Dopo l'intervento chirurgico, ci sono volute diverse settimane per recuperare la piena mobilità dell'articolazione.",
        "La squadra ha subìto due gol nella ripresa ma è riuscita a recuperare lo svantaggio sul finire della partita."
      ],
      "nota": "Nello sport indica specificamente il colmare un distacco nel punteggio o in classifica."
    }
  ]
