  "senses": [
    {
      "pos": "sostantivo, maschile",
      "definition": "Parte superiore del corpo umano o degli animali, contenente il cervello, gli organi di senso e la bocca.",
      "examples": [
        "Il forte mal di capo le ha impedito di concentrarsi sullo studio per tutta la mattina.",
        "Ha inclinato leggermente il capo in segno di assenso prima di uscire dalla stanza."
      ],
      "nota": "Nell'uso quotidiano è spesso sostituito dal sinonimo più colloquiale 'testa', rimanendo prevalente in espressioni cristallizzate o registri formali."
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Persona che ricopre una posizione di comando, direzione o responsabilità all'interno di un'organizzazione, un'azienda o un gruppo di individui.",
      "examples": [
        "Il nuovo capo ha riorganizzato completamente i turni di lavoro per migliorare l'efficienza del reparto.",
        "Tutti i collaboratori hanno espresso la propria fiducia nel capo appena arrivato."
      ],
      "nota": null
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Estremità iniziale, finale o più elevata di un oggetto, di un luogo o di un percorso lineare.",
      "examples": [
        "La vecchia biblioteca comunale si trova proprio all'altro capo del quartiere.",
        "Ha posizionato un segnale luminoso in capo al corridoio per indicare l'uscita di sicurezza."
      ],
      "nota": "Usato frequentemente per indicare i limiti spaziali di un'area o di un itinerario."
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Singolo pezzo o articolo, specialmente di abbigliamento o merce, considerato come unità di conto o di inventario.",
      "examples": [
        "Durante il trasporto sono andati perduti almeno una decina di capi dal magazzino aziendale.",
        "Gli allevatori devono registrare ogni capo prima della spedizione al mercato regionale."
      ],
      "nota": "Impiegato quasi esclusivamente in combinazioni fisse come 'capo di abbigliamento', 'capo di bestiame' o al plurale 'capi' in contesti commerciali e amministrativi."
    },
    {
      "pos": "sostantivo, maschile",
      "definition": "Formazione rocciosa o montuosa che si estende nel mare o in un lago, segnando un'estrema propaggine di una costa.",
      "examples": [
        "La piccola imbarcazione ha superato a fatica il capo durante la mareggiata.",
        "Il sentiero turistico costeggia il capo fino a raggiungere la caletta sottostante."
      ],
      "nota": "Termine tecnico-geografico molto diffuso nella toponomastica e nelle descrizioni ambientali."
    }
  ]
