  "senses": [
    {
      "pos": "sostantivo m.",
      "definition": "Condizione meteorologica o ambientale caratterizzata da un'elevata temperatura dell'aria.",
      "examples": [
        "Dopo i primi di giugno il caldo si fa sentire e le temperature superano spesso i trenta gradi.",
        "Durante il viaggio in treno abbiamo patito il caldo per via dell'impianto di ventilazione guasto."
      ],
      "nota": "Usato prevalentemente al singolare con articolo determinativo; nel parlato corrente indica genericamente l'afa o le alte temperature stagionali."
    },
    {
      "pos": "aggettivo",
      "definition": "Che possiede una temperatura elevata, percepita come opposta a quella fredda.",
      "examples": [
        "Prima di servire il piatto, verifica che la zuppa sia ancora sufficientemente elevata di temperatura.",
        "L'acqua del rubinetto è uscita tiepida invece che bollente, dovremo aspettare qualche minuto."
      ],
      "nota": null
    },
    {
      "pos": "aggettivo",
      "definition": "Che denota forte intensità emotiva, passione, vivacità o un clima di tensione e acceso interesse.",
      "examples": [
        "La conferenza stampa è degenerata in un confronto molto acceso tra il giornalista e il portavoce.",
        "I tifosi hanno creato un'atmosfera trascinante e partecipe per tutta la durata della partita."
      ],
      "nota": "In ambito giornalistico e mediatico qualifica spesso notizie, dibattiti o temi di stretta attualità o forte rilievo emotivo; si combina frequentemente con sostantivi come 'discussione', 'accoglienza', 'sostenitore'."
    }
  ]
