  "senses": [
    {
      "pos": "verbo transitivo",
      "definition": "Far avvicinare o attirare l'attenzione di una persona o di un animale pronunciandone il nome, facendo un gesto o inviando una convocazione.",
      "examples": [
        "La mamma ha chiamato i bambini per la cena.",
        "Il direttore ha chiamato i responsabili di reparto per una riunione urgente."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Contattare qualcuno mediante telefonia fissa, mobile o altri sistemi di comunicazione a distanza.",
      "examples": [
        "Appena arrivo in albergo ti chiamo per confermare l'orario.",
        "Ho chiamato l'assistenza tecnica per segnalare un guasto alla caldaia."
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Assegnare un nome, un appellativo o una qualifica specifica a un essere vivente, un oggetto o un fenomeno.",
      "examples": [
        "Abbiamo chiamato la gatta Luna perché ha il pelo chiarissimo.",
        "Gli storici chiamano quel periodo l'età delle rivoluzioni."
      ],
      "nota": null
    },
    {
      "pos": "verbo riflessivo",
      "definition": "Avere o portare un determinato nome o denominazione.",
      "examples": [
        "Il nuovo parco naturale si chiama Valle dei Laghi.",
        "Come si chiama quell'attrezzo che serve per svitare i bulloni?"
      ],
      "nota": null
    },
    {
      "pos": "verbo transitivo",
      "definition": "Rendere necessaria, opportuna o consigliabile una determinata azione, misura o qualità in base al contesto.",
      "examples": [
        "La delicatezza della situazione chiama grande prudenza e tatto.",
        "Il recente calo delle vendite chiama una revisione immediata della strategia commerciale."
      ],
      "nota": "Uso figurato comune in contesti formali, giornalistici e professionali."
    }
  ]
